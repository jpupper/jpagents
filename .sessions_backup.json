        {
          "path": "D:/Programacion/caminosysabores/public/css/home.css",
          "name": "home.css",
          "content": "@font-face {\r\n  font-family: \"Ubuntu\";\r\n  src: url(\"../fuentes/ubunturegular.ttf\") format(\"truetype\");\r\n  font-weight: normal;\r\n  font-style: normal;\r\n}\r\n\r\n@font-face {\r\n  font-family: \"Ubuntu\";\r\n  src: url(\"../fuentes/ubuntubold.ttf\") format(\"truetype\");\r\n  font-weight: bold;\r\n  font-style: normal;\r\n}\r\n\r\n@font-face {\r\n  font-family: \"Ubuntu\";\r\n  src: url(\"../fuentes/ubuntuitalic.ttf\") format(\"truetype\");\r\n  font-weight: normal;\r\n  font-style: italic;\r\n}\r\n\r\n@font-face {\r\n  font-family: \"Ubuntu\";\r\n  src: url(\"../fuentes/ubuntubolditalic.ttf\") format(\"truetype\");\r\n  font-weight: bold;\r\n  font-style: italic;\r\n}\r\n\r\n@font-face {\r\n  font-family: \"Ubuntu\";\r\n  src: url(\"../fuentes/ubuntulight.ttf\") format(\"truetype\");\r\n  font-weight: 300;\r\n  font-style: normal;\r\n}\r\n\r\n@font-face {\r\n  font-family: \"Ubuntu\";\r\n  src: url(\"../fuentes/ubuntulightitalic.ttf\") format(\"truetype\");\r\n  font-weight: 300;\r\n  font-style: italic;\r\n}\r\n\r\n@font-face {\r\n  font-family: \"Ubuntu\";\r\n  src: url(\"../fuentes/ubuntumedium.ttf\") format(\"truetype\");\r\n  font-weight: 500;\r\n  font-style: normal;\r\n}\r\n\r\n@font-face {\r\n  font-family: \"Ubuntu\";\r\n  src: url(\"../fuentes/ubuntumediumitalic.ttf\") format(\"truetype\");\r\n  font-weight: 500;\r\n  font-style: italic;\r\n}\r\n\r\n* {\r\n  margin: 0;\r\n  padding: 0;\r\n  box-sizing: border-box;\r\n}\r\n\r\n/* Override background from style.css for home page */\r\nbody {\r\n  background-color: white;\r\n  background-image: none;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n\r\n/* Video section styles */\r\n.video-section {\r\n  width: 100%;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: flex-start;\r\n  background-color: black;\r\n  margin: 0;\r\n  padding: 0;\r\n  position: relative;\r\n  z-index: 1;\r\n  margin-top: -20px; /* Para que se posicione detrás del header */\r\n}\r\n\r\n.video-container {\r\n  width: 100%;\r\n  max-width: 100%;\r\n  position: relative;\r\n  overflow: hidden;\r\n  margin: 0;\r\n  aspect-ratio: 1/1; /* Square ratio for mobile layout */\r\n  background-color: black;\r\n}\r\n\r\n.video-container iframe {\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 50%;\r\n  width: 177.78%;\r\n  height: 135%;\r\n  border: 0;\r\n  transform: translate(-50%, -50%);\r\n  z-index: 5;\r\n}\r\n\r\n.video-cover {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n  display: block;\r\n}\r\n\r\n.play-button-overlay {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  background-color: rgba(0, 0, 0, 0.1);\r\n  cursor: pointer;\r\n  z-index: 10;\r\n  transition: background-color 0.2s ease;\r\n}\r\n\r\n.play-button-overlay:hover {\r\n  background-color: rgba(0, 0, 0, 0.2);\r\n}\r\n\r\n.play-button-overlay img {\r\n  width: 72px;\r\n  height: 72px;\r\n  transition: transform 0.2s ease;\r\n}\r\n\r\n.play-button-overlay:hover img {\r\n  transform: scale(1.1);\r\n}\r\n\r\n/* Play button container */\r\n.play-button-container {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  background: rgba(0, 0, 0, 0.3);\r\n  transition: background 0.3s ease;\r\n}\r\n\r\n.video-container:hover .play-button-container {\r\n  background: rgba(0, 0, 0, 0.4);\r\n}\r\n\r\n/* Play button */\r\n.play-button {\r\n  width: 80px;\r\n  height: 80px;\r\n  filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.3));\r\n  transition: transform 0.3s ease;\r\n}\r\n\r\n.play-button:hover {\r\n  transform: scale(1.1);\r\n}\r\n\r\n/* Aseguramos que main no tenga espacios */\r\nmain {\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n\r\n.home-promo-widget {\r\n  position: fixed;\r\n  right: calc(max((100vw - min(480px, 100vw)) / 2 + 14px, 14px));\r\n  bottom: 18px;\r\n  z-index: 60;\r\n  display: flex;\r\n  align-items: flex-end;\r\n  justify-content: flex-end;\r\n  transition: opacity 0.24s ease, transform 0.24s ease, visibility 0.24s ease;\r\n}\r\n\r\n.home-promo-widget.is-shortcut-hidden {\r\n  opacity: 0;\r\n  visibility: hidden;\r\n  pointer-events: none;\r\n  transform: translateY(12px);\r\n}\r\n\r\n.home-promo-card {\r\n  position: relative;\r\n  width: min(calc(min(480px, 100vw) - 28px), 360px);\r\n  padding: 20px 18px 18px;\r\n  border-radius: 22px;\r\n  background-image:\r\n    linear-gradient(180deg, rgba(25, 18, 14, 0.24) 0%, rgba(25, 18, 14, 0.52) 100%),\r\n    url(\"../assets/maqueta.jpeg\");\r\n  background-size: cover;\r\n  background-position: center;\r\n  border: 1px solid rgba(255, 255, 255, 0.14);\r\n  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.2);\r\n  backdrop-filter: blur(10px);\r\n  cursor: pointer;\r\n  transition: opacity 0.26s ease, transform 0.26s ease, visibility 0.26s ease, box-shadow 0.26s ease;\r\n  overflow: hidden;\r\n}\r\n\r\n.home-promo-card:hover {\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 20px 44px rgba(0, 0, 0, 0.18);\r\n}\r\n\r\n.home-promo-card:focus-visible {\r\n  outline: 2px solid #e6643c;\r\n  outline-offset: 4px;\r\n}\r\n\r\n.home-promo-close {\r\n  position: absolute;\r\n  top: 10px;\r\n  right: 10px;\r\n  width: 28px;\r\n  height: 28px;\r\n  border: 0;\r\n  border-radius: 50%;\r\n  background: rgba(255, 255, 255, 0.18);\r\n  color: #fff;\r\n  font-size: 20px;\r\n  line-height: 1;\r\n  cursor: pointer;\r\n  transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;\r\n}\r\n\r\n.home-promo-close:hover {\r\n  background: rgba(255, 255, 255, 0.3);\r\n  color: #fff;\r\n  transform: scale(1.04);\r\n}\r\n\r\n.home-promo-pill {\r\n  display: block;\r\n  margin-bottom: 6px;\r\n  padding-right: 28px;\r\n  color: #fff;\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 20px;\r\n  font-weight: 500;\r\n  line-height: 1.05;\r\n  text-align: left;\r\n  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);\r\n}\r\n\r\n.home-promo-text {\r\n  max-width: none;\r\n  margin: 0;\r\n  padding-right: 18px;\r\n  color: rgba(255, 255, 255, 0.9);\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 13px;\r\n  font-weight: 300;\r\n  line-height: 1.35;\r\n  text-align: left;\r\n  text-shadow: 0 1px 8px rgba(0, 0, 0, 0.26);\r\n}\r\n\r\n.home-promo-bubble {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 58px;\r\n  height: 58px;\r\n  border: 0;\r\n  border-radius: 50%;\r\n  background: linear-gradient(135deg, #e6643c 0%, #f08a42 100%);\r\n  color: #fff;\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 19px;\r\n  font-weight: 500;\r\n  letter-spacing: 0.02em;\r\n  box-shadow: 0 16px 34px rgba(230, 100, 60, 0.32);\r\n  cursor: pointer;\r\n  opacity: 0;\r\n  pointer-events: none;\r\n  transform: scale(0.86);\r\n  transition: opacity 0.26s ease, transform 0.26s ease;\r\n}\r\n\r\n.home-promo-widget.is-collapsed .home-promo-card {\r\n  opacity: 0;\r\n  visibility: hidden;\r\n  pointer-events: none;\r\n  transform: translateY(10px) scale(0.9);\r\n  position: absolute;\r\n  right: 0;\r\n  bottom: 0;\r\n}\r\n\r\n.home-promo-widget.is-collapsed .home-promo-bubble {\r\n  opacity: 1;\r\n  pointer-events: auto;\r\n  transform: scale(0.9);\r\n}\r\n\r\n/* Sección de contenido con grid de 6 columnas */\r\n.content-section {\r\n  margin: 40px 30px;\r\n  padding: 0;\r\n  width: calc(100% - 60px);\r\n}\r\n\r\n.content-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(6, 1fr);\r\n  grid-template-rows: auto auto auto auto;\r\n  gap: 5px;\r\n  max-width: 1200px;\r\n  margin: 0 auto;\r\n  width: 100%;\r\n}\r\n\r\n/* Enlaces que contienen los contenedores de imagen */\r\n.image-link {\r\n  text-decoration: none;\r\n  display: block;\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n\r\n/* Contenedor de imagen con texto */\r\n.image-container {\r\n  position: relative;\r\n  border-radius: 20px;\r\n  overflow: hidden;\r\n  cursor: pointer;\r\n  transition: transform 0.3s ease, box-shadow 0.3s ease;\r\n  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);\r\n  width: 100%;\r\n  min-height: 120px;\r\n}\r\n\r\n.content-grid.is-animating .image-container {\r\n  opacity: 0;\r\n  transform: translateY(18px) scale(0.985);\r\n}\r\n\r\n.content-grid.is-animating .image-container.is-visible {\r\n  opacity: 1;\r\n  transform: translateY(0) scale(1);\r\n  transition: opacity 0.92s ease, transform 0.92s ease, box-shadow 0.3s ease;\r\n}\r\n\r\n.image-container::after {\r\n  content: \"\";\r\n  position: absolute;\r\n  inset: 0;\r\n  background: linear-gradient(180deg, rgba(0, 0, 0, 0.03) 8%, rgba(0, 0, 0, 0.14) 34%, rgba(0, 0, 0, 0.34) 62%, rgba(0, 0, 0, 0.62) 100%);\r\n  pointer-events: none;\r\n}\r\n\r\n.image-container:hover {\r\n  transform: translateY(-5px);\r\n  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);\r\n}\r\n\r\n.image-container img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n  display: block;\r\n}\r\n\r\n/* Texto superpuesto */\r\n.image-text {\r\n  position: absolute;\r\n  bottom: 15px;\r\n  left: 15px;\r\n  color: white;\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-weight: bold;\r\n  font-size: 16px;\r\n  line-height: 1.2;\r\n  z-index: 10;\r\n  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.36), 0 1px 2px rgba(0, 0, 0, 0.28);\r\n}\r\n\r\n.image-subtext {\r\n  display: block;\r\n  margin-top: 6px;\r\n  max-width: 280px;\r\n  font-size: 12px;\r\n  line-height: 1.25;\r\n  font-weight: 400;\r\n}\r\n\r\n.row-1 {\r\n  grid-column: span 6;\r\n  height: 120px;\r\n}\r\n\r\n/* Fila 2 - Actividades & Recetario */\r\n.row-2-1,\r\n.row-2-2 {\r\n  grid-column: span 3;\r\n  height: 120px;\r\n}\r\n\r\n/* Fila 3 - Turismo & Produccion */\r\n.row-3-1,\r\n.row-3-2 {\r\n  grid-column: span 3;\r\n  height: 120px;\r\n}\r\n\r\n/* Fila 4 - Reuniones & Nuestros Productores */\r\n.row-4-1,\r\n.row-4-2 {\r\n  grid-column: span 3;\r\n  height: 120px;\r\n}\r\n\r\n/* Fila 5 - Comparti San Juan */\r\n.row-5 {\r\n  grid-column: span 6;\r\n  height: 120px;\r\n}\r\n\r\n.row-5 .image-text {\r\n  left: 50%;\r\n  width: calc(100% - 30px);\r\n  transform: translateX(-53%);\r\n  text-align: center;\r\n}\r\n\r\n.row-5 .image-subtext {\r\n  margin-left: auto;\r\n  margin-right: auto;\r\n  text-align: center;\r\n}\r\n\r\n@media (max-width: 520px) {\r\n  .home-promo-widget {\r\n    right: 14px;\r\n    bottom: 14px;\r\n  }\r\n\r\n  .home-promo-card {\r\n    width: calc(100vw - 28px);\r\n    padding: 16px 16px 14px;\r\n    border-radius: 20px;\r\n  }\r\n\r\n  .home-promo-pill {\r\n    font-size: 18px;\r\n  }\r\n\r\n  .home-promo-text {\r\n    max-width: none;\r\n    font-size: 13px;\r\n  }\r\n\r\n  .home-promo-bubble {\r\n    width: 54px;\r\n    height: 54px;\r\n    font-size: 18px;\r\n  }\r\n}\r\n\r\n/* Fallback para navegadores que no soportan aspect-ratio */\r\n@supports not (aspect-ratio: 16 / 9) {\r\n  .video-container {\r\n    height: 450px;\r\n  }\r\n\r\n  @container (max-width: 768px) {\r\n    .video-container {\r\n      height: 300px;\r\n    }\r\n  }\r\n\r\n  @container (max-width: 480px) {\r\n    .video-container {\r\n      height: 200px;\r\n    }\r\n  }\r\n}\r\n\r\n/* ==============================\r\n   Social Feed Section\r\n   ============================== */\r\n.social-feed-section {\r\n  width: 100%;\r\n  background: #f9f7f3;\r\n  padding: 60px 30px;\r\n}\r\n\r\n.social-feed-container {\r\n  max-width: 900px;\r\n  margin: 0 auto;\r\n  width: 100%;\r\n}\r\n\r\n.social-feed-header {\r\n  text-align: center;\r\n  margin-bottom: 24px;\r\n}\r\n\r\n.social-feed-header h2 {\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 28px;\r\n  font-weight: 700;\r\n  color: #332211;\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.social-feed-subtitle {\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 14px;\r\n  color: #666;\r\n  font-weight: 300;\r\n}\r\n\r\n/* Tabs */\r\n.social-feed-tabs {\r\n  display: flex;\r\n  justify-content: center;\r\n  gap: 8px;\r\n  margin-bottom: 28px;\r\n}\r\n\r\n.social-tab {\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 15px;\r\n  font-weight: 600;\r\n  padding: 10px 36px;\r\n  border: 2px solid #e6643c;\r\n  border-radius: 25px;\r\n  background: transparent;\r\n  color: #e6643c;\r\n  cursor: pointer;\r\n  transition: all 0.25s ease;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.05em;\r\n}\r\n\r\n.social-tab:hover {\r\n  background: rgba(230, 100, 60, 0.08);\r\n}\r\n\r\n.social-tab.active {\r\n  background: #e6643c;\r\n  color: #fff;\r\n  box-shadow: 0 4px 14px rgba(230, 100, 60, 0.3);\r\n}\r\n\r\n/* Feed Grid */\r\n.social-feed-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));\r\n  gap: 20px;\r\n  min-height: 200px;\r\n}\r\n\r\n/* Loading */\r\n.social-loading {\r\n  grid-column: 1 / -1;\r\n  text-align: center;\r\n  padding: 40px 0;\r\n  color: #999;\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 14px;\r\n}\r\n\r\n.social-spinner {\r\n  width: 32px;\r\n  height: 32px;\r\n  border: 3px solid #e8e0cc;\r\n  border-top-color: #e6643c;\r\n  border-radius: 50%;\r\n  animation: social-spin 0.7s linear infinite;\r\n  margin: 0 auto 12px;\r\n}\r\n\r\n@keyframes social-spin {\r\n  to { transform: rotate(360deg); }\r\n}\r\n\r\n/* Empty state */\r\n.social-feed-empty {\r\n  grid-column: 1 / -1;\r\n  text-align: center;\r\n  padding: 40px 0;\r\n  color: #999;\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 14px;\r\n}\r\n\r\n/* Cards */\r\n.social-card {\r\n  background: #fff;\r\n  border-radius: 16px;\r\n  overflow: hidden;\r\n  box-shadow: 0 2px 12px rgba(51, 34, 17, 0.08);\r\n  transition: transform 0.25s ease, box-shadow 0.25s ease;\r\n}\r\n\r\n.social-card:hover {\r\n  transform: translateY(-3px);\r\n  box-shadow: 0 6px 24px rgba(51, 34, 17, 0.12);\r\n}\r\n\r\n.social-card-img {\r\n  width: 100%;\r\n  height: 200px;\r\n  object-fit: cover;\r\n  display: block;\r\n}\r\n\r\n.social-card-img-placeholder {\r\n  height: 160px;\r\n  background: linear-gradient(135deg, #f5f0e1, #e8e0cc);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 48px;\r\n  color: #d4a05a;\r\n}\r\n\r\n.social-card-body {\r\n  padding: 16px 18px 18px;\r\n}\r\n\r\n.social-card-meta {\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.social-card-date {\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 12px;\r\n  color: #999;\r\n  font-weight: 300;\r\n}\r\n\r\n.social-card-title {\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 16px;\r\n  font-weight: 600;\r\n  color: #332211;\r\n  margin-bottom: 6px;\r\n  line-height: 1.3;\r\n}\r\n\r\n.social-card-content {\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 13px;\r\n  color: #555;\r\n  line-height: 1.5;\r\n  margin-bottom: 10px;\r\n  display: -webkit-box;\r\n  -webkit-line-clamp: 3;\r\n  -webkit-box-orient: vertical;\r\n  overflow: hidden;\r\n}\r\n\r\n.social-card-location {\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 12px;\r\n  color: #888;\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.social-card-hashtags {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 6px;\r\n  margin-bottom: 12px;\r\n}\r\n\r\n.social-hashtag {\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 11px;\r\n  color: #e6643c;\r\n  background: rgba(230, 100, 60, 0.08);\r\n  padding: 3px 10px;\r\n  border-radius: 12px;\r\n  font-weight: 500;\r\n}\r\n\r\n.social-card-footer {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: flex-start;\r\n}\r\n\r\n.social-card-author {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n.social-card-avatar {\r\n  width: 28px;\r\n  height: 28px;\r\n  border-radius: 50%;\r\n  background: #e6643c;\r\n  color: #fff;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-weight: 600;\r\n  font-size: 13px;\r\n}\r\n\r\n.social-card-name {\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 12px;\r\n  color: #666;\r\n  font-weight: 500;\r\n}\r\n\r\n/* VIVO specific */\r\n.social-card-vivo .social-card-img {\r\n  height: 220px;\r\n}\r\n\r\n.social-card-vivo .social-card-date {\r\n  font-size: 12px;\r\n  color: #e6643c;\r\n  font-weight: 500;\r\n}\r\n\r\n/* Footer link */\r\n.social-feed-footer {\r\n  text-align: center;\r\n  margin-top: 28px;\r\n}\r\n\r\n.social-feed-link {\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 14px;\r\n  font-weight: 500;\r\n  color: #e6643c;\r\n  text-decoration: none;\r\n  transition: opacity 0.2s ease;\r\n}\r\n\r\n.social-feed-link:hover {\r\n  opacity: 0.7;\r\n}\r\n\r\n@media (max-width: 640px) {\r\n  .social-feed-section {\r\n    padding: 40px 16px;\r\n  }\r\n\r\n  .social-feed-header h2 {\r\n    font-size: 22px;\r\n  }\r\n\r\n  .social-feed-grid {\r\n    grid-template-columns: 1fr;\r\n  }\r\n\r\n  .social-tab {\r\n    padding: 8px 24px;\r\n    font-size: 13px;\r\n  }\r\n}\r\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/public/home.html",
          "name": "home.html",
          "content": "<!DOCTYPE html>\r\n<html lang=\"es\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>San Juan a la mesa - Home</title>\r\n    <link rel=\"stylesheet\" href=\"css/style.css\">\r\n    <link rel=\"stylesheet\" href=\"css/home.css\">\r\n</head>\r\n<body>\r\n    <!-- El header se creará dinámicamente con JavaScript -->\r\n    \r\n    <main>\r\n        <section class=\"video-section\">\r\n            <div class=\"video-container\" id=\"main-video-container\">\r\n                <iframe src=\"https://www.youtube-nocookie.com/embed/Q_V9VJTROO0?autoplay=1&mute=1&loop=1&playlist=Q_V9VJTROO0&controls=0&rel=0&modestbranding=1&disablekb=1&playsinline=1&cc_load_policy=0&iv_load_policy=3\" \r\n                    title=\"San Juan a la mesa\" \r\n                    frameborder=\"0\" \r\n                    allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" \r\n                    allowfullscreen>\r\n                </iframe>\r\n            </div>\r\n        </section>\r\n        \r\n        <!-- Sección de contenido con grid -->\r\n        <section class=\"content-section\">\r\n            <div class=\"content-grid\">\r\n                <!-- Fila 1 - Showcooking (Full Width) -->\r\n                <div class=\"image-container row-1\" data-href=\"show.html\">\r\n                    <img src=\"assets/home/fila1.png\" alt=\"Showcooking sanjuanino\">\r\n                    <div class=\"image-text\">Show de cocina <br> en el Escenario</div>\r\n                </div>\r\n                \r\n                <!-- Fila 2 - Actividades & Recetario -->\r\n                <div class=\"image-container row-2-1\" data-href=\"actividades.html\">\r\n                    <img src=\"assets/home/fila2izq.png\" alt=\"Actividades\">\r\n                    <div class=\"image-text\">Actividades</div>\r\n                </div>\r\n                \r\n                <div class=\"image-container row-2-2\" data-href=\"sabores.html\">\r\n                    <img src=\"assets/home/fila2der.png\" alt=\"Recetario\">\r\n                    <div class=\"image-text\">Recetario</div>\r\n                </div>\r\n                \r\n                <!-- Fila 3 - Turismo & Producción -->\r\n                <div class=\"image-container row-3-1\" data-href=\"turismo.html\">\r\n                    <img src=\"assets/home/fila3izq.png\" alt=\"Turismo\">\r\n                    <div class=\"image-text\">Turismo</div>\r\n                </div>\r\n                \r\n                <div class=\"image-container row-3-2\" data-href=\"produccion.html\">\r\n                    <img src=\"assets/home/fila3der.png\" alt=\"Producción\">\r\n                    <div class=\"image-text\">Producción</div>\r\n                </div>\r\n                \r\n                <!-- Fila 4 - Reuniones, Comex y Prensa & Nuestros Productores -->\r\n                <div class=\"image-container row-4-1\" data-href=\"reuniones.html\">\r\n                    <img src=\"assets/home/fila4izq.png\" alt=\"Reuniones, Comex y Prensa\">\r\n                    <div class=\"image-text\">Reuniones,<br>Comex y Prensa</div>\r\n                </div>\r\n                \r\n                <div class=\"image-container row-4-2\" data-href=\"productores.html\">\r\n                    <img src=\"assets/home/fila4der.png\" alt=\"Nuestros Productores\">\r\n                    <div class=\"image-text\">Nuestros<br>Productores</div>\r\n                </div>\r\n\r\n                <!-- Fila 5 - Compartí San Juan (Full Width) -->\r\n                <div class=\"image-container row-5\" data-href=\"redsocial/index.html\">\r\n                    <img src=\"assets/home/fila4.png\" alt=\"Compartí San Juan\">\r\n                    <div class=\"image-text\">\r\n                        Compartí San Juan\r\n                        <span class=\"image-subtext\">Descubrí nuestra red social y subí tu experiencia</span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </section>\r\n\r\n        <!-- Red Social Feed Section -->\r\n        <section class=\"social-feed-section\" id=\"socialFeed\">\r\n            <div class=\"social-feed-container\">\r\n                <div class=\"social-feed-header\">\r\n                    <h2>Compartí San Juan</h2>\r\n                    <p class=\"social-feed-subtitle\">Descubrí lo que la comunidad está compartiendo</p>\r\n                </div>\r\n\r\n                <!-- Tabs -->\r\n                <div class=\"social-feed-tabs\">\r\n                    <button class=\"social-tab active\" data-tab=\"posts\">POST</button>\r\n                    <button class=\"social-tab\" data-tab=\"vivo\">VIVO</button>\r\n                </div>\r\n\r\n                <!-- Feed Grid -->\r\n                <div class=\"social-feed-grid\" id=\"socialFeedGrid\">\r\n                    <div class=\"social-loading\" id=\"socialLoading\">\r\n                        <div class=\"social-spinner\"></div>\r\n                        <p>Cargando...</p>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"social-feed-empty\" id=\"socialFeedEmpty\" style=\"display:none;\">\r\n                    <p>Todav&iacute;a no hay publicaciones</p>\r\n                </div>\r\n\r\n                <div class=\"social-feed-footer\">\r\n                    <a href=\"redsocial/index.html\" class=\"social-feed-link\">Ver todas las publicaciones &rarr;</a>\r\n                </div>\r\n            </div>\r\n        </section>\r\n    </main>\r\n\r\n    <div class=\"home-promo-widget is-shortcut-hidden\" id=\"home-promo-widget\">\r\n        <button type=\"button\" class=\"home-promo-bubble\" id=\"home-promo-bubble\" aria-label=\"Abrir mensaje de bienvenida\">\r\n            SJ\r\n        </button>\r\n        <div class=\"home-promo-card\" id=\"home-promo-card\" role=\"button\" tabindex=\"0\" aria-label=\"Explorar San Juan\">\r\n            <button type=\"button\" class=\"home-promo-close\" id=\"home-promo-close\" aria-label=\"Cerrar mensaje\">\r\n                <span aria-hidden=\"true\">&times;</span>\r\n            </button>\r\n            <div class=\"home-promo-pill\">Maqueta 3D</div>\r\n            <p class=\"home-promo-text\">Explora San Juan y descubr&iacute; todos sus encantos.</p>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Cargar el header dinámico primero -->\r\n    <script src=\"js/header.js\"></script>\r\n    <script src=\"js/footer.js\"></script>\r\n    <script src=\"js/touch.js\"></script>\r\n    \r\n    <!-- Script para manejar clics -->\r\n    <script>\r\n        document.addEventListener('DOMContentLoaded', function() {\r\n            // Manejo de redirección táctil\r\n            const contentGrid = document.querySelector('.content-grid');\r\n            const imageContainers = document.querySelectorAll('.image-container[data-href]');\r\n            const promoWidget = document.getElementById('home-promo-widget');\r\n            const promoCard = document.getElementById('home-promo-card');\r\n            const promoBubble = document.getElementById('home-promo-bubble');\r\n            const promoClose = document.getElementById('home-promo-close');\r\n            \r\n            function shouldApplyTouchRestrictions() {\r\n                const urlParams = new URLSearchParams(window.location.search);\r\n                return urlParams.get('touch') === 'true';\r\n            }\r\n\r\n            function addTouchParam(url) {\r\n                if (!shouldApplyTouchRestrictions()) return url;\r\n                const separator = url.includes('?') ? '&' : '?';\r\n                return url + separator + 'touch=true';\r\n            }\r\n            \r\n            imageContainers.forEach(container => {\r\n                container.style.cursor = 'pointer';\r\n                container.addEventListener('click', function() {\r\n                    const href = this.getAttribute('data-href');\r\n                    if (href) {\r\n                        window.location.href = addTouchParam(href);\r\n                    }\r\n                });\r\n            });\r\n\r\n            if (contentGrid && imageContainers.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\r\n                contentGrid.classList.add('is-animating');\r\n                imageContainers.forEach((container, index) => {\r\n                    window.setTimeout(() => {\r\n                        container.classList.add('is-visible');\r\n                    }, 160 + index * 110);\r\n                });\r\n            }\r\n\r\n            if (promoWidget && promoCard && promoBubble && promoClose) {\r\n                const collapsedClass = 'is-collapsed';\r\n                const shortcutHiddenClass = 'is-shortcut-hidden';\r\n                let promoBaseBottom = 18;\r\n\r\n                function updatePromoBoundary() {\r\n                    const footer = document.querySelector('.footer');\r\n                    const computedBottom = Number.parseFloat(window.getComputedStyle(promoWidget).bottom);\r\n                    const footerGap = 10;\r\n\r\n                    if (Number.isFinite(computedBottom) && !promoWidget.dataset.baseBottom) {\r\n                        promoBaseBottom = computedBottom;\r\n                        promoWidget.dataset.baseBottom = String(computedBottom);\r\n                    } else if (promoWidget.dataset.baseBottom) {\r\n                        promoBaseBottom = Number.parseFloat(promoWidget.dataset.baseBottom) || promoBaseBottom;\r\n                    }\r\n\r\n                    if (!footer) {\r\n                        promoWidget.style.bottom = `${promoBaseBottom}px`;\r\n                        return;\r\n                    }\r\n\r\n                    const footerRect = footer.getBoundingClientRect();\r\n                    const minBottom = Math.max(promoBaseBottom, window.innerHeight - footerRect.top + footerGap);\r\n                    promoWidget.style.bottom = `${minBottom}px`;\r\n                }\r\n\r\n                function navigateToLanding() {\r\n                    window.location.href = addTouchParam('maqueta/index.html');\r\n                }\r\n\r\n                promoClose.addEventListener('click', function(event) {\r\n                    event.stopPropagation();\r\n                    promoWidget.classList.add(collapsedClass);\r\n                });\r\n\r\n                promoBubble.addEventListener('click', function() {\r\n                    promoWidget.classList.remove(collapsedClass);\r\n                });\r\n\r\n                promoCard.addEventListener('click', function() {\r\n                    navigateToLanding();\r\n                });\r\n\r\n                promoCard.addEventListener('keydown', function(event) {\r\n                    if (event.key === 'Enter' || event.key === ' ') {\r\n                        event.preventDefault();\r\n                        navigateToLanding();\r\n                    }\r\n                });\r\n\r\n                document.addEventListener('keydown', function(event) {\r\n                    const target = event.target;\r\n                    const isTypingElement = target && (\r\n                        target.tagName === 'INPUT' ||\r\n                        target.tagName === 'TEXTAREA' ||\r\n                        target.isContentEditable\r\n                    );\r\n\r\n                    if (isTypingElement || event.altKey || event.ctrlKey || event.metaKey) {\r\n                        return;\r\n                    }\r\n\r\n                    if (event.key && event.key.toLowerCase() === 'p') {\r\n                        const isNowHidden = promoWidget.classList.toggle(shortcutHiddenClass);\r\n\r\n                        if (!isNowHidden) {\r\n                            promoWidget.classList.remove(collapsedClass);\r\n                        }\r\n                    }\r\n                });\r\n\r\n                updatePromoBoundary();\r\n                window.addEventListener('scroll', updatePromoBoundary, { passive: true });\r\n                window.addEventListener('resize', updatePromoBoundary);\r\n                window.setTimeout(updatePromoBoundary, 120);\r\n            }\r\n        });\r\n    </script>\r\n\r\n    <!-- Social Feed Script -->\r\n    <script>\r\n        document.addEventListener('DOMContentLoaded', function() {\r\n            const SocialFeed = (() => {\r\n                const API_POSTS = '/redsocial/api/posts';\r\n                const API_EVENTO = '/redsocial/api/evento/fotos';\r\n                let currentTab = 'posts';\r\n\r\n                const grid = document.getElementById('socialFeedGrid');\r\n                const loading = document.getElementById('socialLoading');\r\n                const empty = document.getElementById('socialFeedEmpty');\r\n\r\n                function imgUrl(path) {\r\n                    if (!path) return '';\r\n                    if (path.startsWith('http://') || path.startsWith('https://')) return path;\r\n                    return path;\r\n                }\r\n\r\n                function formatDate(dateStr) {\r\n                    const d = new Date(dateStr);\r\n                    return d.toLocaleDateString('es-AR', {\r\n                        year: 'numeric', month: 'short', day: 'numeric'\r\n                    });\r\n                }\r\n\r\n                function createPostCard(post) {\r\n                    const card = document.createElement('div');\r\n                    card.className = 'social-card';\r\n\r\n                    const avatarLetter = post.username ? post.username[0].toUpperCase() : '?';\r\n                    const imageHtml = post.image_url\r\n                        ? `<img class=\"social-card-img\" src=\"${imgUrl(post.image_url)}\" alt=\"${post.title}\" loading=\"lazy\">`\r\n                        : `<div class=\"social-card-img-placeholder\">&#9670;</div>`;\r\n\r\n                    const hashtags = post.hashtags ? post.hashtags.split(',').map(t => t.trim()).filter(t => t) : [];\r\n                    const hashtagsHtml = hashtags.length > 0\r\n                        ? `<div class=\"social-card-hashtags\">${hashtags.map(t => `<span class=\"social-hashtag\">${t}</span>`).join('')}</div>`\r\n                        : '';\r\n\r\n                    card.innerHTML = `\r\n                        ${imageHtml}\r\n                        <div class=\"social-card-body\">\r\n                            <div class=\"social-card-meta\">\r\n                                <span class=\"social-card-date\">${formatDate(post.created_at)}</span>\r\n                            </div>\r\n                            <h3 class=\"social-card-title\">${post.title}</h3>\r\n                            <p class=\"social-card-content\">${post.content}</p>\r\n                            ${post.location ? `<div class=\"social-card-location\">&#128205; ${post.location}</div>` : ''}\r\n                            ${hashtagsHtml}\r\n                            <div class=\"social-card-footer\">\r\n                                <div class=\"social-card-author\">\r\n                                    <div class=\"social-card-avatar\">${avatarLetter}</div>\r\n                                    <span class=\"social-card-name\">${post.username}</span>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    `;\r\n                    return card;\r\n                }\r\n\r\n                function createVivoCard(photo) {\r\n                    const card = document.createElement('div');\r\n                    card.className = 'social-card social-card-vivo';\r\n\r\n                    const imgPath = '/redsocial/uploads/evento/' + photo.filename;\r\n                    const ts = new Date(photo.uploaded_at);\r\n                    const formatted = ts.toLocaleDateString('es-AR', {\r\n                        day: 'numeric', month: 'short', year: 'numeric',\r\n                        hour: '2-digit', minute: '2-digit'\r\n                    });\r\n\r\n                    card.innerHTML = `\r\n                        <img class=\"social-card-img\" src=\"${imgUrl(imgPath)}\" alt=\"${photo.originalName || 'Foto en vivo'}\" loading=\"lazy\">\r\n                        <div class=\"social-card-body\">\r\n                            <div class=\"social-card-meta\">\r\n                                <span class=\"social-card-date\">&#128197; ${formatted}</span>\r\n                            </div>\r\n                            <p class=\"social-card-content\">Foto compartida en vivo</p>\r\n                        </div>\r\n                    `;\r\n                    return card;\r\n                }\r\n\r\n                function showLoading() {\r\n                    grid.innerHTML = '';\r\n                    grid.appendChild(loading);\r\n                    loading.style.display = '';\r\n                    empty.style.display = 'none';\r\n                }\r\n\r\n                async function loadPosts() {\r\n                    showLoading();\r\n                    try {\r\n                        const res = await fetch(API_POSTS);\r\n                        const posts = await res.json();\r\n                        loading.style.display = 'none';\r\n\r\n                        if (!posts || posts.length === 0) {\r\n                            empty.style.display = 'block';\r\n                            return;\r\n                        }\r\n\r\n                        posts.forEach(post => {\r\n                            grid.appendChild(createPostCard(post));\r\n                        });\r\n                    } catch (err) {\r\n                        loading.style.display = 'none';\r\n                        grid.innerHTML = '<div class=\"social-feed-empty\"><p>Error al cargar publicaciones</p></div>';\r\n                    }\r\n                }\r\n\r\n                async function loadVivo() {\r\n                    showLoading();\r\n                    try {\r\n                        const res = await fetch(API_EVENTO);\r\n                        const photos = await res.json();\r\n                        loading.style.display = 'none';\r\n\r\n                        if (!photos || photos.length === 0) {\r\n                            empty.style.display = 'block';\r\n                            return;\r\n                        }\r\n\r\n                        photos.forEach(photo => {\r\n                            grid.appendChild(createVivoCard(photo));\r\n                        });\r\n                    } catch (err) {\r\n                        loading.style.display = 'none';\r\n                        grid.innerHTML = '<div class=\"social-feed-empty\"><p>Error al cargar fotos en vivo</p></div>';\r\n                    }\r\n                }\r\n\r\n                function switchTab(tab) {\r\n                    currentTab = tab;\r\n                    document.querySelectorAll('.social-tab').forEach(b => b.classList.remove('active'));\r\n                    document.querySelector(`.social-tab[data-tab=\"${tab}\"]`).classList.add('active');\r\n                    \r\n                    grid.innerHTML = '';\r\n                    loading.style.display = '';\r\n                    empty.style.display = 'none';\r\n\r\n                    if (tab === 'posts') {\r\n                        loadPosts();\r\n                    } else {\r\n                        loadVivo();\r\n                    }\r\n                }\r\n\r\n                function init() {\r\n                    // Tab clicks\r\n                    document.querySelectorAll('.social-tab').forEach(btn => {\r\n                        btn.addEventListener('click', () => {\r\n                            switchTab(btn.dataset.tab);\r\n                        });\r\n                    });\r\n\r\n                    // Cargar por defecto POST\r\n                    loadPosts();\r\n                }\r\n\r\n                return { init };\r\n            })();\r\n\r\n            SocialFeed.init();\r\n        });\r\n    </script>\r\n</body>\r\n</html>\r\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/public/redsocial/js/feed.js",
          "name": "feed.js",
          "content": "// Feed module - renders posts on the home page\nconst Feed = (() => {\n  let currentHashtag = 'all';\n  let searchTimeout = null;\n  let allPosts = [];\n  let currentTab = 'posts';\n  const API_EVENTO = '/redsocial/api/evento/fotos';\n\n  function formatDate(dateStr) {\n    const d = new Date(dateStr);\n    return d.toLocaleDateString('es-AR', {\n      year: 'numeric', month: 'short', day: 'numeric'\n    });\n  }\n\n  function formatDateTime(dateStr) {\n    const d = new Date(dateStr);\n    return d.toLocaleDateString('es-AR', {\n      day: 'numeric', month: 'short', year: 'numeric',\n      hour: '2-digit', minute: '2-digit'\n    });\n  }\n\n  function truncateContent(text, maxLen = 150) {\n    if (text.length <= maxLen) return text;\n    return text.substring(0, maxLen).trim() + '...';\n  }\n\n  function getHashtagsArray(post) {\n    if (!post.hashtags) return [];\n    return post.hashtags.split(',').map(t => t.trim()).filter(t => t);\n  }\n\n  function createPostCard(post) {\n    const card = document.createElement('div');\n    card.className = 'post-card';\n    card.style.animationDelay = '0s';\n\n    const avatarLetter = post.username ? post.username[0].toUpperCase() : '?';\n    const profilePicHtml = post.profile_pic\n      ? `<img src=\"${imgUrl(post.profile_pic)}\" alt=\"${post.username}\">`\n      : avatarLetter;\n\n    const imageHtml = post.image_url\n      ? `<img class=\"post-card-image\" src=\"${imgUrl(post.image_url)}\" alt=\"${post.title}\" loading=\"lazy\">`\n      : `<div class=\"post-card-image-placeholder\">&#9670;</div>`;\n\n    // Render hashtags as pills\n    const hashtags = getHashtagsArray(post);\n    const hashtagsHtml = hashtags.length > 0\n      ? `<div class=\"post-hashtags\">${hashtags.map(t => `<span class=\"hashtag-tag\">${t}</span>`).join('')}</div>`\n      : '';\n\n    card.innerHTML = `\n      ${imageHtml}\n      <div class=\"post-card-body\">\n        <div class=\"post-card-meta\">\n          <span class=\"post-date\">${formatDate(post.created_at)}</span>\n        </div>\n        <h3 class=\"post-card-title\">${post.title}</h3>\n        <p class=\"post-card-content\">${truncateContent(post.content)}</p>\n        ${post.location ? `<div class=\"post-location\">&#128205; ${post.location}</div>` : ''}\n        ${hashtagsHtml}\n        <div class=\"post-card-footer\">\n          <div class=\"post-author\">\n            <div class=\"post-author-avatar\">${profilePicHtml}</div>\n            <span class=\"post-author-name\">${post.username}</span>\n          </div>\n        </div>\n      </div>\n    `;\n\n    return card;\n  }\n\n  function createVivoCard(photo) {\n    const card = document.createElement('div');\n    card.className = 'post-card';\n\n    const imgPath = '/redsocial/uploads/evento/' + photo.filename;\n\n    card.innerHTML = `\n      <img class=\"post-card-image\" src=\"${imgUrl(imgPath)}\" alt=\"${photo.originalName || 'Foto en vivo'}\" loading=\"lazy\">\n      <div class=\"post-card-body\">\n        <div class=\"post-card-meta\">\n          <span class=\"post-date\">&#128197; ${formatDateTime(photo.uploaded_at)}</span>\n        </div>\n        <p class=\"post-card-content\" style=\"color:#e6643c;font-weight:500\">&#9679; Foto compartida en vivo</p>\n      </div>\n    `;\n\n    return card;\n  }\n\n  function showLoading() {\n    const grid = document.getElementById('feedGrid');\n    const spinner = document.getElementById('loadingSpinner');\n    const empty = document.getElementById('feedEmpty');\n    grid.innerHTML = '';\n    grid.appendChild(spinner);\n    spinner.style.display = 'block';\n    empty.style.display = 'none';\n  }\n\n  async function loadPosts() {\n    const grid = document.getElementById('feedGrid');\n    const empty = document.getElementById('feedEmpty');\n    const spinner = document.getElementById('loadingSpinner');\n    const searchInput = document.getElementById('searchInput');\n\n    if (!grid) return;\n\n    showLoading();\n\n    try {\n      const params = {};\n      // Search takes priority\n      if (searchInput && searchInput.value.trim()) {\n        params.search = searchInput.value.trim();\n      } else if (currentHashtag !== 'all') {\n        params.hashtag = currentHashtag;\n      }\n\n      allPosts = await API.getPosts(params);\n\n      spinner.style.display = 'none';\n\n      if (allPosts.length === 0) {\n        empty.style.display = 'block';\n        return;\n      }\n\n      allPosts.forEach(post => {\n        grid.appendChild(createPostCard(post));\n      });\n    } catch (err) {\n      spinner.style.display = 'none';\n      grid.innerHTML = `<div class=\"feed-empty\">\n        <p>Error al cargar publicaciones: ${err.message}</p>\n        <button class=\"btn btn-primary mt-2\" onclick=\"Feed.loadPosts()\">Reintentar</button>\n      </div>`;\n    }\n  }\n\n  async function loadVivo() {\n    const grid = document.getElementById('feedGrid');\n    const empty = document.getElementById('feedEmpty');\n    const spinner = document.getElementById('loadingSpinner');\n\n    if (!grid) return;\n\n    showLoading();\n\n    try {\n      const res = await fetch(API_EVENTO);\n      const photos = await res.json();\n\n      spinner.style.display = 'none';\n\n      if (!photos || photos.length === 0) {\n        empty.style.display = 'block';\n        return;\n      }\n\n      photos.forEach(photo => {\n        grid.appendChild(createVivoCard(photo));\n      });\n    } catch (err) {\n      spinner.style.display = 'none';\n      grid.innerHTML = `<div class=\"feed-empty\">\n        <p>Error al cargar fotos en vivo</p>\n        <button class=\"btn btn-primary mt-2\" onclick=\"Feed.loadVivo()\">Reintentar</button>\n      </div>`;\n    }\n  }\n\n  function switchTab(tab) {\n    currentTab = tab;\n    document.querySelectorAll('.feed-tab').forEach(b => b.classList.remove('active'));\n    document.querySelector(`.feed-tab[data-tab=\"${tab}\"]`).classList.add('active');\n\n    // Clear search + reset hashtags when switching tabs\n    const searchInput = document.getElementById('searchInput');\n    if (searchInput) searchInput.value = '';\n    document.querySelectorAll('.hashtag-pill').forEach(b => b.classList.remove('active'));\n    document.querySelector('.hashtag-pill[data-hashtag=\"all\"]').classList.add('active');\n    currentHashtag = 'all';\n\n    if (tab === 'posts') {\n      loadPosts();\n    } else {\n      loadVivo();\n    }\n  }\n\n  function init() {\n    // Tab buttons\n    document.querySelectorAll('.feed-tab').forEach(btn => {\n      btn.addEventListener('click', () => {\n        switchTab(btn.dataset.tab);\n      });\n    });\n\n    // Hashtag filter pills\n    document.querySelectorAll('.hashtag-pill').forEach(btn => {\n      btn.addEventListener('click', () => {\n        if (currentTab !== 'posts') {\n          switchTab('posts');\n          return;\n        }\n        document.querySelectorAll('.hashtag-pill').forEach(b => b.classList.remove('active'));\n        btn.classList.add('active');\n        currentHashtag = btn.dataset.hashtag;\n        // Clear search when clicking hashtag\n        const searchInput = document.getElementById('searchInput');\n        if (searchInput) searchInput.value = '';\n        loadPosts();\n      });\n    });\n\n    // Search input with debounce\n    const searchInput = document.getElementById('searchInput');\n    if (searchInput) {\n      searchInput.addEventListener('input', () => {\n        if (currentTab !== 'posts') {\n          switchTab('posts'); // Si busca, va a POST\n          return;\n        }\n        clearTimeout(searchTimeout);\n        searchTimeout = setTimeout(() => {\n          // When typing, deselect hashtag pills\n          document.querySelectorAll('.hashtag-pill').forEach(b => b.classList.remove('active'));\n          document.querySelector('.hashtag-pill[data-hashtag=\"all\"]').classList.add('active');\n          currentHashtag = 'all';\n          loadPosts();\n        }, 400);\n      });\n\n      // Search on Enter\n      searchInput.addEventListener('keydown', (e) => {\n        if (e.key === 'Enter') {\n          if (currentTab !== 'posts') {\n            switchTab('posts');\n            return;\n          }\n          clearTimeout(searchTimeout);\n          document.querySelectorAll('.hashtag-pill').forEach(b => b.classList.remove('active'));\n          document.querySelector('.hashtag-pill[data-hashtag=\"all\"]').classList.add('active');\n          currentHashtag = 'all';\n          loadPosts();\n        }\n      });\n    }\n\n    // Load initial posts\n    loadPosts();\n  }\n\n  return { init, loadPosts, loadVivo };\n})();\n"
        },
