          "path": "D:/Programacion/caminosysabores/public/redsocial/js/api.js",
          "name": "api.js",
          "content": "// API Client for San Juan Social\n// Auto-detect API base from current path\n\nconst pathname = window.location.pathname;\nconst hostname = window.location.hostname;\nconst port = window.location.port;\nconst VPS_BASE = 'https://vps-4455523-x.dattaweb.com/caminosysabores';\nconst VPS_API = VPS_BASE + '/redsocial/api';\n\nlet API_BASE, BASE_PATH;\n\n// ─── Detect if we're on a local dev server ─────────────\n// Matches localhost, 127.0.0.1, VPS host, any local network IP on dev port, or private IP ranges\nconst isLocalDev = hostname === 'localhost'\n  || hostname === '127.0.0.1'\n  || hostname.includes('vps-')\n  || port === '2354'    // any IP hitting the dev server\n  || /^(10\\.|172\\.(1[6-9]|2\\d|3[01])\\.|192\\.168\\.)/.test(hostname);\n\n// Find the position of /redsocial/ in the path\nconst rsIndex = pathname.indexOf('/redsocial/');\n\nif (pathname.startsWith('/redsocial/')) {\n  // Direct access: http://localhost:2354/redsocial/ or https://vps/redsocial/ or https://sanjuan.gob.ar/redsocial/\n  BASE_PATH = '/redsocial';\n  // On localhost or VPS: same server, use relative path\n  // On sanjuan.gob.ar or fullscreencode: cross-origin, use VPS\n  if (isLocalDev) {\n    API_BASE = '/redsocial/api';\n  } else {\n    API_BASE = VPS_API;\n  }\n} else if (rsIndex >= 0) {\n  // Subdirectory deploy: fullscreencode.com/trabajos/.../redsocial/\n  const prefix = pathname.substring(0, rsIndex + '/redsocial'.length);\n  BASE_PATH = prefix;\n  if (isLocalDev) {\n    API_BASE = prefix + '/api';\n  } else {\n    API_BASE = VPS_API;\n  }\n} else if (isLocalDev) {\n  // Local dev but path doesn't include /redsocial/ (unusual)\n  API_BASE = '/redsocial/api';\n  BASE_PATH = '/redsocial';\n} else {\n  // Unknown deploy - fallback to VPS\n  API_BASE = VPS_API;\n  BASE_PATH = '';\n}\n\n// Try to get token from localStorage (used for cross-origin auth)\nfunction getAuthToken() {\n  return localStorage.getItem('sjs_token');\n}\n\n// Convert image URLs for cross-origin (fullscreencode -> VPS)\nfunction imgUrl(path) {\n  if (!path) return '';\n  // If already a full URL, return as-is\n  if (path.startsWith('http://') || path.startsWith('https://')) return path;\n  // On fullscreencode or cross-origin, images need VPS URL\n  if (API_BASE === VPS_API) {\n    return 'https://vps-4455523-x.dattaweb.com/caminosysabores' + path;\n  }\n  // Local or same-server: relative path works\n  return path;\n}\n\nconst API = (() => {\n  async function request(endpoint, options = {}) {\n    const config = {\n      headers: { 'Accept': 'application/json' },\n      credentials: 'include',\n      ...options,\n    };\n\n    // Don't set Content-Type for FormData (browser sets it with boundary)\n    if (!(config.body instanceof FormData)) {\n      config.headers['Content-Type'] = 'application/json';\n    }\n\n    // Add auth token from localStorage if available (for cross-origin requests)\n    const token = getAuthToken();\n    if (token) {\n      config.headers['Authorization'] = `Bearer ${token}`;\n    }\n\n    const url = `${API_BASE}${endpoint}`;\n    const response = await fetch(url, config);\n\n    if (!response.ok) {\n      let error = 'Error en la solicitud';\n      try {\n        const data = await response.json();\n        error = data.error || error;\n      } catch (e) {\n        // ignore\n      }\n      throw new Error(error);\n    }\n\n    return response.json();\n  }\n\n  return {\n    // Auth\n    login: (data) => request('/auth/login', { method: 'POST', body: JSON.stringify(data) }),\n    register: (data) => request('/auth/register', { method: 'POST', body: JSON.stringify(data) }),\n    logout: () => request('/auth/logout', { method: 'POST' }),\n    me: () => request('/auth/me'),\n\n    // Posts\n    getPosts: (params = {}) => {\n      const qs = new URLSearchParams(params).toString();\n      return request(`/posts${qs ? '?' + qs : ''}`);\n    },\n    getPost: (id) => request(`/posts/${id}`),\n    createPost: (formData) => request('/posts', { method: 'POST', body: formData }),\n    updatePost: (id, formData) => request(`/posts/${id}`, { method: 'PUT', body: formData }),\n    deletePost: (id) => request(`/posts/${id}`, { method: 'DELETE' }),\n    getUserPosts: (userId) => request(`/posts/user/${userId}`),\n\n    // Users\n    getUser: (id) => request(`/users/${id}`),\n    updateProfile: (formData) => request('/users/profile', { method: 'PUT', body: formData }),\n\n    // Admin\n    getAdminUsers: () => request('/users/admin/users'),\n    getAdminPosts: () => request('/users/admin/posts'),\n    adminDeletePost: (id) => request(`/users/admin/posts/${id}`, { method: 'DELETE' }),\n    adminUpdatePost: (id, data) => request(`/users/admin/posts/${id}`, { method: 'PUT', body: JSON.stringify(data) }),\n    adminDeleteAllPosts: () => request('/users/admin/posts/all', { method: 'DELETE' }),\n  };\n})();\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/public/exporural/astro/js/admin-sorteo.js",
          "name": "admin-sorteo.js",
          "content": "// Inicializar Firebase\r\nfirebase.initializeApp(firebaseConfig);\r\nconst db = firebase.firestore();\r\n\r\n// API base from environment config\r\nconst API_SERVER = window.ENV.API_BASE;\r\n\r\nlet adminPassword = null; // validated server-side\r\n\r\n// Referencias a elementos del DOM\r\nconst loginScreen = document.getElementById('login-screen');\r\nconst adminPanel = document.getElementById('admin-panel');\r\nconst loginBtn = document.getElementById('login-btn');\r\nconst passwordInput = document.getElementById('admin-password');\r\nconst loginError = document.getElementById('login-error');\r\nconst refreshBtn = document.getElementById('refresh-btn');\r\nconst exportCsvBtn = document.getElementById('export-csv-btn');\r\nconst deleteAllBtn = document.getElementById('delete-all-btn');\r\nconst loadingIndicator = document.getElementById('loading');\r\nconst tableContainer = document.getElementById('table-container');\r\nconst emptyMessage = document.getElementById('empty-message');\r\nconst tableBody = document.getElementById('participants-table-body');\r\nconst frecuenciaGanadorInput = document.getElementById('frecuencia-ganador');\r\nconst saveConfigBtn = document.getElementById('save-config-btn');\r\n\r\n// Variables para almacenar los datos\r\nlet participantsData = [];\r\n\r\n// Evento para el botón de login\r\nloginBtn.addEventListener('click', async () => {\r\n    const password = passwordInput.value;\r\n    loginBtn.disabled = true;\r\n    loginBtn.textContent = 'Verificando...';\r\n    try {\r\n        const res = await fetch(API_SERVER + '/api/admin/check', {\r\n            method: 'POST',\r\n            headers: { 'Content-Type': 'application/json' },\r\n            body: JSON.stringify({ password })\r\n        });\r\n        const data = await res.json();\r\n        if (data.ok) {\r\n            adminPassword = password;\r\n            loginScreen.classList.add('hidden');\r\n            adminPanel.classList.remove('hidden');\r\n            loadConfig();\r\n            loadParticipants();\r\n        } else {\r\n            loginError.classList.remove('hidden');\r\n            passwordInput.value = '';\r\n        }\r\n    } catch(e) {\r\n        loginError.textContent = 'Error de conexión al servidor';\r\n        loginError.classList.remove('hidden');\r\n    } finally {\r\n        loginBtn.disabled = false;\r\n        loginBtn.textContent = 'Ingresar';\r\n    }\r\n});\r\n\r\n// Evento para el botón de actualizar\r\nrefreshBtn.addEventListener('click', loadParticipants);\r\n\r\n// Evento para el botón de exportar CSV\r\nexportCsvBtn.addEventListener('click', exportToCSV);\r\n\r\n// Evento para el botón de eliminar todos\r\ndeleteAllBtn.addEventListener('click', deleteAllParticipants);\r\n\r\n// Evento para el botón de guardar configuración\r\nsaveConfigBtn.addEventListener('click', async () => {\r\n    const frecuencia = parseInt(frecuenciaGanadorInput.value);\r\n    if (frecuencia < 1) {\r\n        alert('La frecuencia debe ser un número positivo');\r\n        return;\r\n    }\r\n\r\n    try {\r\n        await db.collection('config').doc('sorteo').set({\r\n            frecuenciaGanador: frecuencia\r\n        }, { merge: true });\r\n        alert('Configuración guardada correctamente');\r\n    } catch (error) {\r\n        console.error('Error al guardar la configuración:', error);\r\n        alert('Error al guardar la configuración');\r\n    }\r\n});\r\n\r\n// Función para cargar la configuración\r\nasync function loadConfig() {\r\n    try {\r\n        const configDoc = await db.collection('config').doc('sorteo').get();\r\n        if (configDoc.exists) {\r\n            const config = configDoc.data();\r\n            frecuenciaGanadorInput.value = config.frecuenciaGanador || 10;\r\n        }\r\n    } catch (error) {\r\n        console.error('Error al cargar la configuración:', error);\r\n    }\r\n}\r\n\r\n// Función para cargar los participantes desde Firebase\r\nasync function loadParticipants() {\r\n    // Mostrar indicador de carga\r\n    loadingIndicator.classList.remove('hidden');\r\n    tableContainer.classList.add('hidden');\r\n    emptyMessage.classList.add('hidden');\r\n    \r\n    try {\r\n        // Obtener datos de Firebase ordenados por fecha descendente\r\n        const snapshot = await db.collection('participantes')\r\n            .orderBy('fechaRegistro', 'desc')\r\n            .get();\r\n        \r\n        // Limpiar datos anteriores\r\n        participantsData = [];\r\n        tableBody.innerHTML = '';\r\n        \r\n        // Procesar los datos\r\n        snapshot.forEach(doc => {\r\n            const data = doc.data();\r\n            const deviceId = data.deviceId || 'No disponible';\r\n            const participant = {\r\n                id: doc.id,\r\n                ...data,\r\n                // Convertir timestamp a fecha legible\r\n                fechaFormateada: data.fechaRegistro ? new Date(data.fechaRegistro.toDate()).toLocaleString() : 'N/A'\r\n            };\r\n            \r\n            participantsData.push(participant);\r\n            \r\n            // Crear fila en la tabla\r\n            const row = document.createElement('tr');\r\n            row.innerHTML = `\r\n                <td>${participant.nombre} ${participant.apellido}</td>\r\n                <td>${participant.email}</td>\r\n                <td>${participant.telefono}</td>\r\n                <td>${participant.edad || '-'}</td>\r\n                <td>${participant.localidad || '-'}</td>\r\n                <td class=\"experiencias\">${participant.experiencias ? participant.experiencias.join(', ') : '-'}</td>\r\n                <td>${participant.fechaFormateada}</td>\r\n                <td title=\"${deviceId}\">${deviceId.substring(0, 8)}...</td>\r\n                <td>${participant.gano ? 'Sí' : 'No'}</td>\r\n                <td>\r\n                    <button class=\"delete-btn\" onclick=\"deleteParticipant('${participant.id}')\">Eliminar</button>\r\n                </td>\r\n            `;\r\n            \r\n            tableBody.appendChild(row);\r\n        });\r\n        \r\n        // Configurar botones de eliminar\r\n        document.querySelectorAll('.delete-btn').forEach(button => {\r\n            button.addEventListener('click', (e) => {\r\n                const id = e.target.getAttribute('data-id');\r\n                deleteParticipant(id);\r\n            });\r\n        });\r\n        \r\n        // Mostrar tabla o mensaje de vacío según corresponda\r\n        if (participantsData.length > 0) {\r\n            tableContainer.classList.remove('hidden');\r\n            emptyMessage.classList.add('hidden');\r\n        } else {\r\n            tableContainer.classList.add('hidden');\r\n            emptyMessage.classList.remove('hidden');\r\n        }\r\n    } catch (error) {\r\n        console.error('Error al cargar participantes:', error);\r\n        alert('Hubo un error al cargar los datos. Por favor, intenta nuevamente.');\r\n    } finally {\r\n        // Ocultar indicador de carga\r\n        loadingIndicator.classList.add('hidden');\r\n    }\r\n}\r\n\r\n// Función para eliminar un participante\r\nasync function deleteParticipant(id) {\r\n    try {\r\n        await db.collection('participantes').doc(id).delete();\r\n        loadParticipants(); // Recargar la lista\r\n    } catch (error) {\r\n        console.error('Error al eliminar:', error);\r\n    }\r\n}\r\n\r\n// Función para eliminar todos los participantes\r\nasync function deleteAllParticipants() {\r\n   /* if (confirm('¿Estás seguro de que deseas eliminar TODOS los registros? Esta acción no se puede deshacer.')) {\r\n        try {\r\n            // Mostrar indicador de carga\r\n            loadingIndicator.classList.remove('hidden');\r\n            tableContainer.classList.add('hidden');\r\n            \r\n            // Obtener todos los documentos\r\n            const snapshot = await db.collection('participantes').get();\r\n            \r\n            // Eliminar cada documento\r\n            const batch = db.batch();\r\n            snapshot.forEach(doc => {\r\n                batch.delete(doc.ref);\r\n            });\r\n            \r\n            await batch.commit();\r\n            \r\n            alert('Todos los registros han sido eliminados correctamente.');\r\n            loadParticipants(); // Recargar datos\r\n        } catch (error) {\r\n            console.error('Error al eliminar todos los registros:', error);\r\n            alert('Hubo un error al eliminar los registros. Por favor, intenta nuevamente.');\r\n        }\r\n    }*/\r\n}\r\n\r\n// Función para exportar datos a CSV\r\nfunction exportToCSV() {\r\n    if (participantsData.length === 0) {\r\n        alert('No hay datos para exportar.');\r\n        return;\r\n    }\r\n    \r\n    try {\r\n        // Encabezados CSV\r\n        const headers = ['Nombre', 'Email', 'Teléfono', 'Edad', 'Localidad', 'Experiencias', 'Fecha', 'IP', 'Ganó'];\r\n        \r\n        // Crear contenido CSV\r\n        let csvContent = headers.join(',') + '\\n';\r\n        \r\n        participantsData.forEach(participant => {\r\n            const row = [\r\n                formatCSVField(`${participant.nombre} ${participant.apellido}`),\r\n                formatCSVField(participant.email),\r\n                formatCSVField(participant.telefono),\r\n                formatCSVField(participant.edad),\r\n                formatCSVField(participant.localidad),\r\n                formatCSVField(participant.experiencias ? participant.experiencias.join('; ') : ''),\r\n                formatCSVField(participant.fechaFormateada),\r\n                formatCSVField(participant.ip),\r\n                formatCSVField(participant.gano ? 'Sí' : 'No')\r\n            ];\r\n            \r\n            csvContent += row.join(',') + '\\n';\r\n        });\r\n        \r\n        // Crear blob y descargar\r\n        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });\r\n        const url = URL.createObjectURL(blob);\r\n        \r\n        const link = document.createElement('a');\r\n        link.setAttribute('href', url);\r\n        link.setAttribute('download', `participantes-sorteo-${new Date().toISOString().split('T')[0]}.csv`);\r\n        link.style.visibility = 'hidden';\r\n        \r\n        document.body.appendChild(link);\r\n        link.click();\r\n        document.body.removeChild(link);\r\n    } catch (error) {\r\n        console.error('Error al exportar a CSV:', error);\r\n        alert('Hubo un error al exportar los datos. Por favor, intenta nuevamente.');\r\n    }\r\n}\r\n\r\n// Función para formatear campos CSV (escapar comas y comillas)\r\nfunction formatCSVField(value) {\r\n    if (value === null || value === undefined) {\r\n        return '';\r\n    }\r\n    \r\n    const stringValue = String(value);\r\n    \r\n    // Si contiene comas, comillas o saltos de línea, envolver en comillas y escapar comillas internas\r\n    if (stringValue.includes(',') || stringValue.includes('\"') || stringValue.includes('\\n')) {\r\n        return '\"' + stringValue.replace(/\"/g, '\"\"') + '\"';\r\n    }\r\n    \r\n    return stringValue;\r\n}\r\n\r\n// Permitir enviar el formulario de login con Enter\r\npasswordInput.addEventListener('keypress', (e) => {\r\n    if (e.key === 'Enter') {\r\n        loginBtn.click();\r\n    }\r\n});\r\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/public/exporural/js/admin-sorteo.js",
          "name": "admin-sorteo.js",
          "content": "// Inicializar Firebase\r\nfirebase.initializeApp(firebaseConfig);\r\nconst db = firebase.firestore();\r\n\r\n// API prefix - from window.ENV\r\nconst API_SERVER = window.ENV.API_BASE;\r\n\r\nlet adminPassword = null; // validated server-side\r\n\r\n// Referencias a elementos del DOM\r\nconst loginScreen = document.getElementById('login-screen');\r\nconst adminPanel = document.getElementById('admin-panel');\r\nconst loginBtn = document.getElementById('login-btn');\r\nconst passwordInput = document.getElementById('admin-password');\r\nconst loginError = document.getElementById('login-error');\r\nconst refreshBtn = document.getElementById('refresh-btn');\r\nconst exportCsvBtn = document.getElementById('export-csv-btn');\r\nconst deleteAllBtn = document.getElementById('delete-all-btn');\r\nconst loadingIndicator = document.getElementById('loading');\r\nconst tableContainer = document.getElementById('table-container');\r\nconst emptyMessage = document.getElementById('empty-message');\r\nconst tableBody = document.getElementById('participants-table-body');\r\nconst frecuenciaGanadorInput = document.getElementById('frecuencia-ganador');\r\nconst saveConfigBtn = document.getElementById('save-config-btn');\r\n\r\n// Variables para almacenar los datos\r\nlet participantsData = [];\r\n\r\n// Evento para el botón de login\r\nloginBtn.addEventListener('click', async () => {\r\n    const password = passwordInput.value;\r\n    loginBtn.disabled = true;\r\n    loginBtn.textContent = 'Verificando...';\r\n    try {\r\n        const res = await fetch(API_SERVER + '/api/admin/check', {\r\n            method: 'POST',\r\n            headers: { 'Content-Type': 'application/json' },\r\n            body: JSON.stringify({ password })\r\n        });\r\n        const data = await res.json();\r\n        if (data.ok) {\r\n            adminPassword = password;\r\n            loginScreen.classList.add('hidden');\r\n            adminPanel.classList.remove('hidden');\r\n            loadConfig();\r\n            loadParticipants();\r\n        } else {\r\n            loginError.classList.remove('hidden');\r\n            passwordInput.value = '';\r\n        }\r\n    } catch(e) {\r\n        loginError.textContent = 'Error de conexión al servidor';\r\n        loginError.classList.remove('hidden');\r\n    } finally {\r\n        loginBtn.disabled = false;\r\n        loginBtn.textContent = 'Ingresar';\r\n    }\r\n});\r\n\r\n// Evento para el botón de actualizar\r\nrefreshBtn.addEventListener('click', loadParticipants);\r\n\r\n// Evento para el botón de exportar CSV\r\nexportCsvBtn.addEventListener('click', exportToCSV);\r\n\r\n// Evento para el botón de eliminar todos\r\ndeleteAllBtn.addEventListener('click', deleteAllParticipants);\r\n\r\n// Evento para el botón de guardar configuración\r\nsaveConfigBtn.addEventListener('click', async () => {\r\n    const frecuencia = parseInt(frecuenciaGanadorInput.value);\r\n    if (frecuencia < 1) {\r\n        alert('La frecuencia debe ser un número positivo');\r\n        return;\r\n    }\r\n\r\n    try {\r\n        await db.collection('config').doc('sorteo').set({\r\n            frecuenciaGanador: frecuencia\r\n        }, { merge: true });\r\n        alert('Configuración guardada correctamente');\r\n    } catch (error) {\r\n        console.error('Error al guardar la configuración:', error);\r\n        alert('Error al guardar la configuración');\r\n    }\r\n});\r\n\r\n// Función para cargar la configuración\r\nasync function loadConfig() {\r\n    try {\r\n        const configDoc = await db.collection('config').doc('sorteo').get();\r\n        if (configDoc.exists) {\r\n            const config = configDoc.data();\r\n            frecuenciaGanadorInput.value = config.frecuenciaGanador || 10;\r\n        }\r\n    } catch (error) {\r\n        console.error('Error al cargar la configuración:', error);\r\n    }\r\n}\r\n\r\n// Función para cargar los participantes desde Firebase\r\nasync function loadParticipants() {\r\n    // Mostrar indicador de carga\r\n    loadingIndicator.classList.remove('hidden');\r\n    tableContainer.classList.add('hidden');\r\n    emptyMessage.classList.add('hidden');\r\n    \r\n    try {\r\n        // Obtener datos de Firebase ordenados por fecha descendente\r\n        const snapshot = await db.collection('participantes')\r\n            .orderBy('fechaRegistro', 'desc')\r\n            .get();\r\n        \r\n        // Limpiar datos anteriores\r\n        participantsData = [];\r\n        tableBody.innerHTML = '';\r\n        \r\n        // Procesar los datos\r\n        snapshot.forEach(doc => {\r\n            const data = doc.data();\r\n            const deviceId = data.deviceId || 'No disponible';\r\n            const participant = {\r\n                id: doc.id,\r\n                ...data,\r\n                // Convertir timestamp a fecha legible\r\n                fechaFormateada: data.fechaRegistro ? new Date(data.fechaRegistro.toDate()).toLocaleString() : 'N/A'\r\n            };\r\n            \r\n            participantsData.push(participant);\r\n            \r\n            // Crear fila en la tabla\r\n            const row = document.createElement('tr');\r\n            row.innerHTML = `\r\n                <td>${participant.nombre} ${participant.apellido}</td>\r\n                <td>${participant.email}</td>\r\n                <td>${participant.telefono}</td>\r\n                <td>${participant.edad || '-'}</td>\r\n                <td>${participant.localidad || '-'}</td>\r\n                <td class=\"experiencias\">${participant.experiencias ? participant.experiencias.join(', ') : '-'}</td>\r\n                <td>${participant.fechaFormateada}</td>\r\n                <td title=\"${deviceId}\">${deviceId.substring(0, 8)}...</td>\r\n                <td>${participant.gano ? 'Sí' : 'No'}</td>\r\n                <td>\r\n                    <button class=\"delete-btn\" onclick=\"deleteParticipant('${participant.id}')\">Eliminar</button>\r\n                </td>\r\n            `;\r\n            \r\n            tableBody.appendChild(row);\r\n        });\r\n        \r\n        // Configurar botones de eliminar\r\n        document.querySelectorAll('.delete-btn').forEach(button => {\r\n            button.addEventListener('click', (e) => {\r\n                const id = e.target.getAttribute('data-id');\r\n                deleteParticipant(id);\r\n            });\r\n        });\r\n        \r\n        // Mostrar tabla o mensaje de vacío según corresponda\r\n        if (participantsData.length > 0) {\r\n            tableContainer.classList.remove('hidden');\r\n            emptyMessage.classList.add('hidden');\r\n        } else {\r\n            tableContainer.classList.add('hidden');\r\n            emptyMessage.classList.remove('hidden');\r\n        }\r\n    } catch (error) {\r\n        console.error('Error al cargar participantes:', error);\r\n        alert('Hubo un error al cargar los datos. Por favor, intenta nuevamente.');\r\n    } finally {\r\n        // Ocultar indicador de carga\r\n        loadingIndicator.classList.add('hidden');\r\n    }\r\n}\r\n\r\n// Función para eliminar un participante\r\nasync function deleteParticipant(id) {\r\n    try {\r\n        await db.collection('participantes').doc(id).delete();\r\n        loadParticipants(); // Recargar la lista\r\n    } catch (error) {\r\n        console.error('Error al eliminar:', error);\r\n    }\r\n}\r\n\r\n// Función para eliminar todos los participantes\r\nasync function deleteAllParticipants() {\r\n   /* if (confirm('¿Estás seguro de que deseas eliminar TODOS los registros? Esta acción no se puede deshacer.')) {\r\n        try {\r\n            // Mostrar indicador de carga\r\n            loadingIndicator.classList.remove('hidden');\r\n            tableContainer.classList.add('hidden');\r\n            \r\n            // Obtener todos los documentos\r\n            const snapshot = await db.collection('participantes').get();\r\n            \r\n            // Eliminar cada documento\r\n            const batch = db.batch();\r\n            snapshot.forEach(doc => {\r\n                batch.delete(doc.ref);\r\n            });\r\n            \r\n            await batch.commit();\r\n            \r\n            alert('Todos los registros han sido eliminados correctamente.');\r\n            loadParticipants(); // Recargar datos\r\n        } catch (error) {\r\n            console.error('Error al eliminar todos los registros:', error);\r\n            alert('Hubo un error al eliminar los registros. Por favor, intenta nuevamente.');\r\n        }\r\n    }*/\r\n}\r\n\r\n// Función para exportar datos a CSV\r\nfunction exportToCSV() {\r\n    if (participantsData.length === 0) {\r\n        alert('No hay datos para exportar.');\r\n        return;\r\n    }\r\n    \r\n    try {\r\n        // Encabezados CSV\r\n        const headers = ['Nombre', 'Email', 'Teléfono', 'Edad', 'Localidad', 'Experiencias', 'Fecha', 'IP', 'Ganó'];\r\n        \r\n        // Crear contenido CSV\r\n        let csvContent = headers.join(',') + '\\n';\r\n        \r\n        participantsData.forEach(participant => {\r\n            const row = [\r\n                formatCSVField(`${participant.nombre} ${participant.apellido}`),\r\n                formatCSVField(participant.email),\r\n                formatCSVField(participant.telefono),\r\n                formatCSVField(participant.edad),\r\n                formatCSVField(participant.localidad),\r\n                formatCSVField(participant.experiencias ? participant.experiencias.join('; ') : ''),\r\n                formatCSVField(participant.fechaFormateada),\r\n                formatCSVField(participant.ip),\r\n                formatCSVField(participant.gano ? 'Sí' : 'No')\r\n            ];\r\n            \r\n            csvContent += row.join(',') + '\\n';\r\n        });\r\n        \r\n        // Crear blob y descargar\r\n        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });\r\n        const url = URL.createObjectURL(blob);\r\n        \r\n        const link = document.createElement('a');\r\n        link.setAttribute('href', url);\r\n        link.setAttribute('download', `participantes-sorteo-${new Date().toISOString().split('T')[0]}.csv`);\r\n        link.style.visibility = 'hidden';\r\n        \r\n        document.body.appendChild(link);\r\n        link.click();\r\n        document.body.removeChild(link);\r\n    } catch (error) {\r\n        console.error('Error al exportar a CSV:', error);\r\n        alert('Hubo un error al exportar los datos. Por favor, intenta nuevamente.');\r\n    }\r\n}\r\n\r\n// Función para formatear campos CSV (escapar comas y comillas)\r\nfunction formatCSVField(value) {\r\n    if (value === null || value === undefined) {\r\n        return '';\r\n    }\r\n    \r\n    const stringValue = String(value);\r\n    \r\n    // Si contiene comas, comillas o saltos de línea, envolver en comillas y escapar comillas internas\r\n    if (stringValue.includes(',') || stringValue.includes('\"') || stringValue.includes('\\n')) {\r\n        return '\"' + stringValue.replace(/\"/g, '\"\"') + '\"';\r\n    }\r\n    \r\n    return stringValue;\r\n}\r\n\r\n// Permitir enviar el formulario de login con Enter\r\npasswordInput.addEventListener('keypress', (e) => {\r\n    if (e.key === 'Enter') {\r\n        loginBtn.click();\r\n    }\r\n});\r\n"
