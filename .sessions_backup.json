          "path": "D:/Programacion/caminosysabores/public/js/back-button.js",
          "name": "back-button.js",
          "content": "function createStandaloneBackButton() {\r\n  const button = document.createElement(\"button\")\r\n  const fallbackTarget = document.body.dataset.backFallback || \"home.html\"\r\n  const useHistory = document.body.dataset.backUseHistory !== \"false\"\r\n\r\n  button.className = \"back-floating-button is-visible\"\r\n  button.type = \"button\"\r\n  button.setAttribute(\"aria-label\", \"Volver a la pantalla anterior\")\r\n  button.innerHTML = `\r\n    <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\r\n      <path d=\"M14.5 5.5L8 12L14.5 18.5\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\r\n    </svg>\r\n  `\r\n\r\n  button.addEventListener(\"click\", () => {\r\n    const hasReferrer = document.referrer && new URL(document.referrer).origin === window.location.origin\r\n\r\n    if (useHistory && window.history.length > 1 && hasReferrer) {\r\n      window.history.back()\r\n      return\r\n    }\r\n\r\n    window.location.href = fallbackTarget\r\n  })\r\n\r\n  return button\r\n}\r\n\r\nfunction insertStandaloneBackButton() {\r\n  if (document.querySelector(\".back-floating-button\")) {\r\n    return\r\n  }\r\n\r\n  const backButtonStyles = document.createElement(\"style\")\r\n  backButtonStyles.textContent = `\r\n    .back-floating-button {\r\n      position: fixed;\r\n      top: 86px;\r\n      right: max(16px, calc((100vw - min(100vw, 480px)) / 2 + 16px));\r\n      width: 42px;\r\n      height: 42px;\r\n      display: inline-flex;\r\n      align-items: center;\r\n      justify-content: center;\r\n      border: 1.5px solid rgba(255, 255, 255, 0.42);\r\n      border-radius: 999px;\r\n      background: rgba(255, 255, 255, 0.96);\r\n      color: #e6643c;\r\n      box-shadow: 0 8px 18px rgba(0, 0, 0, 0.14);\r\n      cursor: pointer;\r\n      z-index: 220;\r\n      opacity: 0;\r\n      visibility: hidden;\r\n      transform: translateY(-8px);\r\n      transition: opacity 0.24s ease, transform 0.24s ease, box-shadow 0.24s ease, visibility 0.24s ease;\r\n      backdrop-filter: blur(6px);\r\n      -webkit-backdrop-filter: blur(6px);\r\n    }\r\n\r\n    .back-floating-button.is-visible {\r\n      opacity: 1;\r\n      visibility: visible;\r\n      transform: translateY(0);\r\n    }\r\n\r\n    .back-floating-button:hover {\r\n      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.18);\r\n      transform: translateY(-1px);\r\n    }\r\n\r\n    .back-floating-button:active {\r\n      transform: translateY(0);\r\n    }\r\n\r\n    .back-floating-button svg {\r\n      width: 16px;\r\n      height: 16px;\r\n      display: block;\r\n    }\r\n\r\n    @media (max-width: 768px) {\r\n      .back-floating-button {\r\n        top: 78px;\r\n        width: 40px;\r\n        height: 40px;\r\n      }\r\n    }\r\n\r\n    @media (prefers-reduced-motion: reduce) {\r\n      .back-floating-button {\r\n        transition: none;\r\n      }\r\n    }\r\n  `\r\n\r\n  document.head.appendChild(backButtonStyles)\r\n  document.body.appendChild(createStandaloneBackButton())\r\n}\r\n\r\ndocument.addEventListener(\"DOMContentLoaded\", insertStandaloneBackButton)\r\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/public/js/header.js",
          "name": "header.js",
          "content": "// Función para crear el header dinámicamente\r\nfunction createHeader() {\r\n    // Crear estilos CSS para el header\r\n    const headerStyles = document.createElement(\"style\")\r\n    headerStyles.textContent = `\r\n          .main-header {\r\n              background-color: #E6643C;\r\n              border-bottom-left-radius: 20px;\r\n              border-bottom-right-radius: 20px;\r\n              padding: 20px 0;\r\n              margin: 0;\r\n              padding-bottom: 10px;\r\n              position: relative;\r\n              z-index: 100;\r\n          }\r\n  \r\n          .header-container {\r\n              display: grid;\r\n              grid-template-columns: repeat(6, 1fr);\r\n              gap: 10px;\r\n              align-items: center;\r\n              padding: 0;\r\n              margin: 0 60px;\r\n          }\r\n  \r\n          .logo-header {\r\n              grid-column: 1 / 3;\r\n              display: flex;\r\n              align-items: center;\r\n          }\r\n  \r\n          .logo-header a {\r\n              display: flex;\r\n              align-items: center;\r\n              text-decoration: none;\r\n              transition: transform 0.2s ease;\r\n          }\r\n  \r\n          .logo-header a:hover {\r\n              transform: scale(1.05);\r\n          }\r\n  \r\n           .logo-header img {\r\n              height: 42px;\r\n              width: auto;\r\n              cursor: pointer;\r\n          }\r\n  \r\n          .social-icons {\r\n              grid-column: 4 / 7;\r\n              display: flex;\r\n              justify-content: flex-end;\r\n              gap: 12px;\r\n              align-items: center;\r\n          }\r\n  \r\n          .social-icon {\r\n              display: flex;\r\n              align-items: center;\r\n              justify-content: center;\r\n          }\r\n  \r\n          .social-icon.instagram {\r\n              grid-column: 5;\r\n          }\r\n  \r\n          .social-icon.youtube {\r\n              grid-column: 6;\r\n          }\r\n  \r\n          .social-icon img {\r\n              padding-top: 18px;\r\n              height: auto;\r\n              transition: transform 0.2s ease;\r\n          }\r\n\r\n          .social-icon.instagram img,\r\n          .social-icon.youtube img {\r\n              width: 22px;\r\n          }\r\n\r\n          .social-icon.youtube img {\r\n              width: 25px;\r\n          }\r\n  \r\n          .social-icon:hover img {\r\n              transform: scale(1.1);\r\n          }\r\n\r\n          .back-floating-button {\r\n              position: fixed;\r\n              top: 86px;\r\n              right: max(16px, calc((100vw - min(100vw, 480px)) / 2 + 16px));\r\n              width: 42px;\r\n              height: 42px;\r\n              display: inline-flex;\r\n              align-items: center;\r\n              justify-content: center;\r\n              border: 1.5px solid rgba(230, 100, 60, 0.38);\r\n              border-radius: 999px;\r\n              background: rgba(255, 255, 255, 0.94);\r\n              color: #e6643c;\r\n              box-shadow: 0 10px 22px rgba(0, 0, 0, 0.14);\r\n              cursor: pointer;\r\n              z-index: 220;\r\n              opacity: 0;\r\n              visibility: hidden;\r\n              transform: translateY(-8px);\r\n              transition: opacity 0.24s ease, transform 0.24s ease, box-shadow 0.24s ease, visibility 0.24s ease;\r\n              backdrop-filter: blur(6px);\r\n              -webkit-backdrop-filter: blur(6px);\r\n          }\r\n\r\n          .back-floating-button.is-visible {\r\n              opacity: 1;\r\n              visibility: visible;\r\n              transform: translateY(0);\r\n          }\r\n\r\n          .back-floating-button:hover {\r\n              box-shadow: 0 12px 24px rgba(0, 0, 0, 0.18);\r\n              transform: translateY(-1px);\r\n          }\r\n\r\n          .back-floating-button:active {\r\n              transform: translateY(0);\r\n          }\r\n\r\n          .back-floating-button svg {\r\n              width: 16px;\r\n              height: 16px;\r\n              display: block;\r\n          }\r\n  \r\n          /* Responsive adjustments */\r\n          @media (max-width: 768px) {\r\n              .header-container {\r\n                  gap: 5px;\r\n                  padding: 0 10px;\r\n                  margin: 0 30px;\r\n              }\r\n  \r\n              .social-icons {\r\n                  gap: 8px;\r\n              }\r\n  \r\n              .social-icon.instagram img,\r\n              .social-icon.youtube img {\r\n                  width: 20px;\r\n              }\r\n\r\n              .social-icon.youtube img {\r\n                  width: 23px;\r\n              }\r\n\r\n              .back-floating-button {\r\n                  top: 78px;\r\n                  width: 40px;\r\n                  height: 40px;\r\n              }\r\n          }\r\n\r\n          @media (prefers-reduced-motion: reduce) {\r\n              .back-floating-button {\r\n                  transition: none;\r\n              }\r\n          }\r\n      `\r\n  \r\n    // Crear el elemento header\r\n    const header = document.createElement(\"header\")\r\n    header.className = \"main-header\"\r\n  \r\n    header.innerHTML = `\r\n          <div class=\"header-container\">\r\n            <div class=\"logo-header\">\r\n              <a href=\"home.html\">\r\n                <img src=\"assets/landing/logocentral.svg\" alt=\"San Juan a la mesa\">\r\n              </a>\r\n            </div>\r\n          <div class=\"social-icons\">\r\n            <a href=\"https://www.instagram.com/sjturistico/\" class=\"social-icon instagram\">\r\n              <img src=\"assets/home/ig.png\" alt=\"Instagram\">\r\n            </a>\r\n            <a href=\"https://www.youtube.com/@SanjuanTur\" class=\"social-icon youtube\">\r\n              <img src=\"assets/home/youtube.svg\" alt=\"YouTube\">\r\n            </a>\r\n          </div>\r\n        </div>\r\n      `\r\n  \r\n    return { header, styles: headerStyles }\r\n  }\r\n\r\n  function createBackButton() {\r\n    const button = document.createElement(\"button\")\r\n    button.className = \"back-floating-button\"\r\n    button.type = \"button\"\r\n    button.setAttribute(\"aria-label\", \"Volver a la pantalla anterior\")\r\n    button.innerHTML = `\r\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\r\n        <path d=\"M14.5 5.5L8 12L14.5 18.5\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\r\n      </svg>\r\n    `\r\n\r\n    button.addEventListener(\"click\", () => {\r\n      const hasReferrer = document.referrer && new URL(document.referrer).origin === window.location.origin\r\n\r\n      if (window.history.length > 1 && hasReferrer) {\r\n        window.history.back()\r\n        return\r\n      }\r\n\r\n      window.location.href = \"home.html\"\r\n    })\r\n\r\n    return button\r\n  }\r\n  \r\n  // Función para insertar el header en la página\r\n  function insertHeader() {\r\n    const body = document.body\r\n    const { header, styles } = createHeader()\r\n    const currentPage = window.location.pathname.split(\"/\").pop() || \"index.html\"\r\n  \r\n    // Insertar los estilos en el head\r\n    document.head.appendChild(styles)\r\n  \r\n    // Insertar el header al inicio del body\r\n    body.insertBefore(header, body.firstChild)\r\n\r\n    if (currentPage !== \"home.html\") {\r\n      const backButton = createBackButton()\r\n      backButton.classList.add(\"is-visible\")\r\n      body.appendChild(backButton)\r\n    }\r\n  }\r\n  \r\n  // Ejecutar cuando el DOM esté listo\r\n  document.addEventListener(\"DOMContentLoaded\", insertHeader)\r\n  \r\n"
