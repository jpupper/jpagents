          "path": "D:/Programacion/caminosysabores/public/validatepass.html",
          "name": "validatepass.html",
          "content": "<!DOCTYPE html>\r\n<html lang=\"es\">\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\">\r\n<title>Validar Sello - Caminos y Sabores</title>\r\n<script src=\"https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js\"></script>\r\n<style>\r\n*{box-sizing:border-box;margin:0;padding:0}\r\nbody{\r\n  font-family:'Segoe UI',system-ui,-apple-system,sans-serif;\r\n  background:linear-gradient(135deg,#e6643c,#c24d28);\r\n  min-height:100vh;\r\n  display:flex;\r\n  align-items:center;\r\n  justify-content:center;\r\n  padding:16px;\r\n}\r\n.card{\r\n  background:white;\r\n  border-radius:24px;\r\n  padding:clamp(24px,5vw,40px);\r\n  max-width:460px;\r\n  width:100%;\r\n  text-align:center;\r\n  box-shadow:0 20px 60px rgba(0,0,0,0.25);\r\n  animation:scaleIn 0.35s cubic-bezier(0.34,1.56,0.64,1);\r\n}\r\n@keyframes scaleIn{from{transform:scale(0.5);opacity:0}to{transform:scale(1);opacity:1}}\r\n.logo{width:80px;height:auto;margin:0 auto 10px;display:block}\r\nh1{font-size:1.2rem;color:#333;margin:0 0 4px}\r\n.sub{font-size:0.85rem;color:#888;margin:0 0 20px}\r\n\r\n/* ─── INPUT ROW ─── */\r\n.input-row{display:flex;gap:8px;margin-bottom:14px}\r\n.input-row input{\r\n  flex:1;padding:12px 14px;border:2px solid #ddd;border-radius:12px;\r\n  font-family:monospace;font-size:18px;font-weight:700;\r\n  letter-spacing:3px;text-transform:uppercase;text-align:center;\r\n  outline:none;transition:border-color 0.2s;min-width:0;\r\n  color:#E6643C;\r\n}\r\n.input-row input:focus{border-color:#E6643C}\r\n.input-row input::placeholder{letter-spacing:0;font-weight:400;color:#bbb;text-transform:none}\r\n.btn-validate{\r\n  padding:12px 22px;border:none;border-radius:12px;\r\n  background:#E6643C;color:white;font-size:0.9rem;font-weight:700;\r\n  cursor:pointer;transition:all 0.2s;white-space:nowrap;\r\n  font-family:inherit;\r\n}\r\n.btn-validate:hover{background:#d45336;transform:translateY(-1px)}\r\n.btn-validate:active{transform:scale(0.97)}\r\n\r\n/* ─── SCANNER ─── */\r\n.scanner-section{display:none;margin:18px 0 0}\r\n.scanner-section.show{display:block}\r\n#scannerBox{width:100%;max-width:300px;margin:0 auto;border-radius:14px;overflow:hidden}\r\n#scannerBox video{border-radius:14px}\r\n.btn-scanner{\r\n  display:inline-flex;align-items:center;gap:6px;\r\n  padding:10px 20px;border:2px solid #E6643C;border-radius:12px;\r\n  background:white;color:#E6643C;font-size:0.85rem;font-weight:600;\r\n  cursor:pointer;transition:all 0.2s;font-family:inherit;\r\n  margin-top:4px;\r\n}\r\n.btn-scanner:hover{background:#fff8f5}\r\n.btn-scanner.active{background:#E6643C;color:white}\r\n.divider{display:flex;align-items:center;gap:10px;margin:16px 0;color:#bbb;font-size:0.8rem}\r\n.divider::before,.divider::after{content:'';flex:1;height:1px;background:#eee}\r\n\r\n/* ─── LOADING ─── */\r\n.spinner{display:inline-block;width:28px;height:28px;border:3px solid #f0ebe5;border-top-color:#E6643C;border-radius:50%;animation:spin 0.8s linear infinite;margin:12px auto}\r\n@keyframes spin{to{transform:rotate(360deg)}}\r\n\r\n/* ─── RESULT ─── */\r\n.result{display:none;margin-top:16px;padding:16px;border-radius:14px;text-align:center}\r\n.result.show{display:block}\r\n.result.success{background:#f0faf0;border:2px solid #27ae60}\r\n.result.used{background:#fef6f0;border:2px solid #e67e22}\r\n.result.error{background:#fef0f0;border:2px solid #e74c3c}\r\n.result .icon{font-size:2.5rem;margin-bottom:8px}\r\n.result h3{margin:0 0 4px;font-size:1.05rem}\r\n.result p{margin:0;font-size:0.85rem;color:#666;line-height:1.4}\r\n.result.success h3{color:#27ae60}\r\n.result.used h3{color:#e67e22}\r\n.result.error h3{color:#e74c3c}\r\n.result .info-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin:12px 0 0;text-align:left;font-size:0.82rem}\r\n.result .info-grid .label{color:#999}\r\n.result .info-grid .value{font-weight:600;color:#333;text-align:right}\r\n.sello-img{width:100px;height:auto;margin:0 auto 10px;display:block;border-radius:8px}\r\n</style>\r\n</head>\r\n<body>\r\n\r\n<div class=\"card\" id=\"mainCard\">\r\n  <img src=\"\" alt=\"Caminos y Sabores\" class=\"logo\" id=\"logoSello\"\r\n       onerror=\"this.style.display='none'\">\r\n\r\n  <h1>Validar sello</h1>\r\n  <p class=\"sub\">Ingres&aacute; el c&oacute;digo o escane&aacute; el QR</p>\r\n\r\n  <!-- Input -->\r\n  <div class=\"input-row\">\r\n    <input type=\"text\" id=\"codigoInput\" placeholder=\"SJ-ISCH-XXXXXX\" maxlength=\"18\" autocomplete=\"off\" spellcheck=\"false\">\r\n    <button class=\"btn-validate\" id=\"btnValidate\" onclick=\"validar()\">Validar</button>\r\n  </div>\r\n\r\n  <div class=\"divider\"><span>o</span></div>\r\n\r\n  <!-- Scanner toggle -->\r\n  <button class=\"btn-scanner\" id=\"btnScanner\" onclick=\"toggleScanner()\">&#128247; Escanear QR</button>\r\n\r\n  <!-- Scanner box -->\r\n  <div class=\"scanner-section\" id=\"scannerSection\">\r\n    <div id=\"scannerBox\"></div>\r\n    <button class=\"btn-scanner\" onclick=\"toggleScanner()\" style=\"margin-top:8px;\">Cancelar escaneo</button>\r\n  </div>\r\n\r\n  <!-- Loading -->\r\n  <div id=\"loadingSpinner\" class=\"spinner\" style=\"display:none;\"></div>\r\n\r\n  <!-- Result (injected by JS) -->\r\n  <div class=\"result\" id=\"resultBox\">\r\n    <div class=\"icon\" id=\"resultIcon\"></div>\r\n    <h3 id=\"resultTitle\"></h3>\r\n    <div id=\"resultBody\"></div>\r\n  </div>\r\n</div>\r\n\r\n<script>\r\n// ─── API base ──────────────────────────────────────\r\nfunction getApiBase() {\r\n  const h = window.location.hostname;\r\n  if (h === 'fullscreencode.com' || h.endsWith('.ferozo.com') || h === 'caminosysabores.sanjuan.gob.ar')\r\n    return 'https://vps-4455523-x.dattaweb.com/caminosysabores';\r\n  return window.location.origin;\r\n}\r\nconst API = getApiBase();\r\n\r\n// ─── Sello image ──────────────────────────────────\r\nfunction getSelloImg() {\r\n  const h = window.location.hostname;\r\n  if (h === 'fullscreencode.com' || h === 'caminosysabores.sanjuan.gob.ar')\r\n    return 'https://vps-4455523-x.dattaweb.com/caminosysabores/selloparqueischigualasto.png';\r\n  return '/selloparqueischigualasto.png';\r\n}\r\ndocument.getElementById('logoSello').src = getSelloImg();\r\n\r\n// ─── QR Scanner ───────────────────────────────────\r\nlet html5QrCode = null;\r\nlet scannerRunning = false;\r\n\r\nfunction toggleScanner() {\r\n  const section = document.getElementById('scannerSection');\r\n  const btn = document.getElementById('btnScanner');\r\n\r\n  if (scannerRunning) {\r\n    stopScanner();\r\n    return;\r\n  }\r\n\r\n  section.classList.add('show');\r\n  btn.classList.add('active');\r\n  btn.textContent = 'Deteniendo cámara...';\r\n\r\n  html5QrCode = new Html5Qrcode(\"scannerBox\");\r\n  html5QrCode.start(\r\n    { facingMode: \"environment\" },\r\n    { fps: 10, qrbox: { width: 250, height: 250 } },\r\n    onScanSuccess,\r\n    onScanFailure\r\n  ).then(() => {\r\n    scannerRunning = true;\r\n    btn.textContent = 'Detener cámara';\r\n    btn.classList.add('active');\r\n  }).catch(err => {\r\n    alert('No se pudo acceder a la cámara: ' + err.message);\r\n    section.classList.remove('show');\r\n    btn.classList.remove('active');\r\n    btn.textContent = 'Escanear QR';\r\n  });\r\n}\r\n\r\nfunction stopScanner() {\r\n  if (html5QrCode) {\r\n    html5QrCode.stop().then(() => {\r\n      html5QrCode.clear();\r\n      scannerRunning = false;\r\n      document.getElementById('scannerSection').classList.remove('show');\r\n      const btn = document.getElementById('btnScanner');\r\n      btn.classList.remove('active');\r\n      btn.textContent = 'Escanear QR';\r\n    }).catch(() => {});\r\n  }\r\n}\r\n\r\nfunction onScanSuccess(decodedText) {\r\n  // Extract codigo from URL\r\n  let codigo = '';\r\n  try {\r\n    const url = new URL(decodedText);\r\n    codigo = url.searchParams.get('codigo') || '';\r\n  } catch {\r\n    // Maybe the QR just contains the code directly\r\n    codigo = decodedText.trim();\r\n  }\r\n\r\n  stopScanner();\r\n\r\n  if (codigo) {\r\n    document.getElementById('codigoInput').value = codigo;\r\n    validar();\r\n  } else {\r\n    showResult('error', '&#10060;', 'C&oacute;digo no encontrado',\r\n      'El QR escaneado no contiene un c&oacute;digo v&aacute;lido.');\r\n  }\r\n}\r\n\r\nfunction onScanFailure(err) {\r\n  // Ignore - scanner keeps trying\r\n}\r\n\r\n// ─── Validation ────────────────────────────────────\r\nasync function validar() {\r\n  const codigo = document.getElementById('codigoInput').value.trim().toUpperCase();\r\n  const resultBox = document.getElementById('resultBox');\r\n  const spinner = document.getElementById('loadingSpinner');\r\n\r\n  resultBox.classList.remove('show', 'success', 'used', 'error');\r\n  spinner.style.display = 'block';\r\n\r\n  if (!codigo) {\r\n    spinner.style.display = 'none';\r\n    showResult('error', '&#10060;', 'Ingres&aacute; un c&oacute;digo',\r\n      'Escrib&iacute; el c&oacute;digo que te lleg&oacute; por mail o escane&aacute; el QR.');\r\n    return;\r\n  }\r\n\r\n  try {\r\n    // Step 1: Validate\r\n    const valRes = await fetch(API + '/api/sellos/validate/' + encodeURIComponent(codigo));\r\n    const valData = await valRes.json();\r\n\r\n    if (!valData.valido) {\r\n      spinner.style.display = 'none';\r\n      showResult('error', '&#10060;', 'C&oacute;digo no v&aacute;lido',\r\n        'Este c&oacute;digo no corresponde a ning&uacute;n sello registrado.');\r\n      return;\r\n    }\r\n\r\n    if (valData.escaneado) {\r\n      spinner.style.display = 'none';\r\n      const usedDate = valData.escaneadoAt\r\n        ? new Date(valData.escaneadoAt).toLocaleString('es-AR')\r\n        : 'desconocida';\r\n      showResult('used', '&#128274;', 'Este pase ya fue utilizado',\r\n        'Ya fue canjeado el <strong>' + usedDate + '</strong>.');\r\n      return;\r\n    }\r\n\r\n    // Step 2: Mark as scanned\r\n    const scanRes = await fetch(API + '/api/sellos/scan/' + encodeURIComponent(codigo), { method: 'POST' });\r\n    const scanData = await scanRes.json();\r\n\r\n    spinner.style.display = 'none';\r\n\r\n    if (scanData.ok) {\r\n      const juegoLabel = valData.juego === 'canasta' ? 'Canasta'\r\n        : valData.juego === 'memotest' ? 'Memotest'\r\n        : valData.juego === 'envivo' ? 'En Vivo'\r\n        : 'Red Social';\r\n      const html = `\r\n        <img src=\"${getSelloImg()}\" alt=\"Sello\" class=\"sello-img\" onerror=\"this.style.display='none'\">\r\n        <div class=\"info-grid\">\r\n          <span class=\"label\">C&oacute;digo</span><span class=\"value\" style=\"font-family:monospace;color:#E6643C\">${codigo}</span>\r\n          <span class=\"label\">Juego</span><span class=\"value\">${juegoLabel}</span>\r\n          <span class=\"label\">Correo</span><span class=\"value\">${valData.correo || '-'}</span>\r\n          <span class=\"label\">Estado</span><span class=\"value\" style=\"color:#27ae60\">Canjeado</span>\r\n        </div>\r\n        <p style=\"font-size:0.78rem;color:#999;margin-top:12px;\">El usuario puede retirar su sello f&iacute;sico en el stand.</p>\r\n      `;\r\n      showResult('success', '&#9989;', 'Sello validado correctamente', html);\r\n    } else if (scanData.yaUtilizado) {\r\n      const usedDate = scanData.escaneadoAt\r\n        ? new Date(scanData.escaneadoAt).toLocaleString('es-AR')\r\n        : 'desconocida';\r\n      showResult('used', '&#128274;', 'Este pase ya fue utilizado',\r\n        'Ya fue canjeado el <strong>' + usedDate + '</strong>.');\r\n    } else {\r\n      throw new Error(scanData.error || 'Error');\r\n    }\r\n  } catch (err) {\r\n    spinner.style.display = 'none';\r\n    showResult('error', '&#10060;', 'Error de conexi&oacute;n',\r\n      'No se pudo conectar con el servidor. Verific&aacute; tu conexi&oacute;n e intent&aacute; de nuevo.');\r\n  }\r\n}\r\n\r\nfunction showResult(type, icon, title, body) {\r\n  const box = document.getElementById('resultBox');\r\n  document.getElementById('resultIcon').innerHTML = icon;\r\n  document.getElementById('resultTitle').innerHTML = title;\r\n  document.getElementById('resultBody').innerHTML = body;\r\n  box.className = 'result show ' + type;\r\n}\r\n\r\n// Enter key\r\ndocument.getElementById('codigoInput').addEventListener('keydown', function(e) {\r\n  if (e.key === 'Enter') { e.preventDefault(); validar(); }\r\n});\r\n\r\n// Auto-uppercase\r\ndocument.getElementById('codigoInput').addEventListener('input', function(e) {\r\n  this.value = this.value.toUpperCase();\r\n});\r\n\r\n// Check URL for ?codigo= on load\r\n(function() {\r\n  const params = new URLSearchParams(window.location.search);\r\n  const codigo = params.get('codigo');\r\n  if (codigo) {\r\n    document.getElementById('codigoInput').value = codigo.toUpperCase();\r\n    setTimeout(validar, 300);\r\n  }\r\n})();\r\n</script>\r\n</body>\r\n</html>\r\n"
        },
