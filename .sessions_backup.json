          "content": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Ingresar - Comparti San Juan</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Open+Sans:wght@300;400;600&display=swap\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"../css/style.css\">\n  <link rel=\"stylesheet\" href=\"../css/auth.css\">\n</head>\n<body class=\"auth-page\">\n  <div class=\"auth-container\">\n    <div class=\"auth-card\">\n      <a href=\"..\" class=\"auth-logo\">&#9670; COMPARTI SAN JUAN</a>\n      <h1 class=\"auth-title\">Bienvenido de vuelta</h1>\n      <p class=\"auth-subtitle\">Ingresa para compartir tus experiencias sanjuaninas</p>\n      \n      <form id=\"loginForm\" class=\"auth-form\">\n        <div class=\"form-group\">\n          <label for=\"username\">Usuario o Email</label>\n          <input type=\"text\" id=\"username\" name=\"username\" placeholder=\"Tu usuario o email\" required>\n        </div>\n        <div class=\"form-group\">\n          <label for=\"password\">Contraseña</label>\n          <input type=\"password\" id=\"password\" name=\"password\" placeholder=\"Tu contraseña\" required>\n        </div>\n        <div class=\"form-error\" id=\"loginError\" style=\"display:none\"></div>\n        <button type=\"submit\" class=\"btn btn-primary btn-full\" id=\"loginBtn\">Ingresar</button>\n      </form>\n      \n      <p class=\"auth-alt\">¿No tenés cuenta? <a href=\"register.html\">Registrate</a></p>\n      \n      \n    </div>\n  </div>\n  \n  <script src=\"../js/api.js\"></script>\n  <script src=\"../js/auth.js\"></script>\n</body>\n</html>\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/public/redsocial/pages/register.html",
          "name": "register.html",
          "content": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Registrarse - Comparti San Juan</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Open+Sans:wght@300;400;600&display=swap\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"../css/style.css\">\n  <link rel=\"stylesheet\" href=\"../css/auth.css\">\n</head>\n<body class=\"auth-page\">\n  <div class=\"auth-container\">\n    <div class=\"auth-card\">\n      <a href=\"..\" class=\"auth-logo\">&#9670; COMPARTI SAN JUAN</a>\n      <h1 class=\"auth-title\">Unite a la comunidad</h1>\n      <p class=\"auth-subtitle\">Compartí tu San Juan con el mundo</p>\n      \n      <form id=\"registerForm\" class=\"auth-form\">\n        <div class=\"form-group\">\n          <label for=\"username\">Nombre de usuario</label>\n          <input type=\"text\" id=\"username\" name=\"username\" placeholder=\"Elegí un usuario\" required>\n        </div>\n        <div class=\"form-group\">\n          <label for=\"email\">Email</label>\n          <input type=\"email\" id=\"email\" name=\"email\" placeholder=\"tu@email.com\" required>\n        </div>\n        <div class=\"form-group\">\n          <label for=\"password\">Contraseña</label>\n          <input type=\"password\" id=\"password\" name=\"password\" placeholder=\"Mínimo 6 caracteres\" required minlength=\"6\">\n        </div>\n        <div class=\"form-error\" id=\"registerError\" style=\"display:none\"></div>\n        <button type=\"submit\" class=\"btn btn-primary btn-full\" id=\"registerBtn\">Crear cuenta</button>\n      </form>\n      \n      <p class=\"auth-alt\">¿Ya tenés cuenta? <a href=\"login.html\">Ingresa</a></p>\n      \n      \n    </div>\n  </div>\n  \n  <script src=\"../js/api.js\"></script>\n  <script src=\"../js/auth.js\"></script>\n</body>\n</html>\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/public/redsocial/js/admin.js",
          "name": "admin.js",
          "content": "// Admin panel logic\n(async () => {\n  await Auth.init();\n\n  if (!Auth.isLoggedIn() || !Auth.isAdmin()) {\n    window.location.href = BASE_PATH + '/';\n    return;\n  }\n\n  let pendingDeleteAll = false;\n\n  // Tab switching\n  document.querySelectorAll('.admin-tab').forEach(tab => {\n    tab.addEventListener('click', () => {\n      document.querySelectorAll('.admin-tab').forEach(t => t.classList.remove('active'));\n      tab.classList.add('active');\n      document.getElementById('postsPanel').style.display = tab.dataset.tab === 'posts' ? 'block' : 'none';\n      document.getElementById('usersPanel').style.display = tab.dataset.tab === 'users' ? 'block' : 'none';\n    });\n  });\n\n  // Load data\n  async function loadAdminData() {\n    try {\n      const [posts, users] = await Promise.all([\n        API.getAdminPosts(),\n        API.getAdminUsers()\n      ]);\n\n      // Calculate hashtag-based stats\n      let eventCount = 0, placeCount = 0;\n      posts.forEach(p => {\n        if (p.hashtags) {\n          const tags = p.hashtags.toLowerCase();\n          if (tags.includes('evento') || tags.includes('#entretenimiento')) eventCount++;\n          if (tags.includes('lugar') || tags.includes('#gastronomia') || tags.includes('#naturaleza') || tags.includes('#alojamientos')) placeCount++;\n        }\n      });\n\n      // Stats\n      document.getElementById('statPosts').textContent = posts.length;\n      document.getElementById('statUsers').textContent = users.length;\n      document.getElementById('statEvents').textContent = eventCount;\n      document.getElementById('statPlaces').textContent = placeCount;\n\n      // Posts table\n      const postsBody = document.getElementById('postsTableBody');\n      if (posts.length === 0) {\n        postsBody.innerHTML = '<tr><td colspan=\"6\" class=\"table-loading\">Sin publicaciones</td></tr>';\n      } else {\n        postsBody.innerHTML = posts.map(p => {\n          const safeTitle = (p.title || '').replace(/'/g, \"\\\\'\");\n          const safeContent = (p.content || '').replace(/'/g, \"\\\\'\");\n          return `\n          <tr>\n            <td>#${p.id}</td>\n            <td><strong>${p.title || ''}</strong></td>\n            <td>${p.username || '?'}</td>\n            <td><span class=\"post-category\">${p.hashtags || 'sin tags'}</span></td>\n            <td>${new Date(p.created_at).toLocaleDateString('es-AR')}</td>\n            <td>\n              <div class=\"admin-actions\">\n                <button class=\"admin-btn-sm admin-btn-edit\" onclick=\"editPost('${p.id}', '${safeTitle}', '${safeContent}')\">Editar</button>\n                <button class=\"admin-btn-sm admin-btn-delete\" onclick=\"deletePost('${p.id}')\">Eliminar</button>\n              </div>\n            </td>\n          </tr>`;\n        }).join('');\n      }\n\n      // Users table\n      const usersBody = document.getElementById('usersTableBody');\n      if (users.length === 0) {\n        usersBody.innerHTML = '<tr><td colspan=\"6\" class=\"table-loading\">Sin usuarios</td></tr>';\n      } else {\n        const userPostCounts = {};\n        posts.forEach(p => { userPostCounts[p.user_id] = (userPostCounts[p.user_id] || 0) + 1; });\n\n        usersBody.innerHTML = users.map(u => `\n          <tr>\n            <td>#${u.id}</td>\n            <td><strong>${u.name || '?'}</strong></td>\n            <td>${u.email}</td>\n            <td><span class=\"post-category\">${u.role}</span></td>\n            <td>${new Date(u.createdAt).toLocaleDateString('es-AR')}</td>\n            <td>${userPostCounts[u.id] || 0}</td>\n          </tr>\n        `).join('');\n      }\n    } catch (err) {\n      console.error('Admin load error:', err);\n    }\n  }\n\n  // Edit post\n  window.editPost = (id, title, content) => {\n    document.getElementById('editPostId').value = id;\n    document.getElementById('editTitle').value = title;\n    document.getElementById('editContent').value = content;\n    document.getElementById('editPostModal').style.display = 'flex';\n  };\n\n  document.getElementById('closeEditPostModal').addEventListener('click', () => {\n    document.getElementById('editPostModal').style.display = 'none';\n  });\n\n  document.getElementById('editPostForm').addEventListener('submit', async (e) => {\n    e.preventDefault();\n    const id = document.getElementById('editPostId').value;\n    try {\n      await API.adminUpdatePost(id, {\n        title: document.getElementById('editTitle').value,\n        content: document.getElementById('editContent').value\n      });\n      document.getElementById('editPostModal').style.display = 'none';\n      loadAdminData();\n    } catch (err) {\n      alert('Error: ' + err.message);\n    }\n  });\n\n  // Delete single post\n  window.deletePost = async (id) => {\n    if (!confirm('Eliminar esta publicación?')) return;\n    try {\n      await API.adminDeletePost(id);\n      loadAdminData();\n    } catch (err) {\n      alert('Error: ' + err.message);\n    }\n  };\n\n  // Delete all posts\n  document.getElementById('deleteAllBtn').addEventListener('click', () => {\n    document.getElementById('dangerText').textContent = 'Vas a eliminar TODAS las publicaciones de todos los usuarios. Esta acción es irreversible.';\n    document.getElementById('dangerModal').style.display = 'flex';\n    pendingDeleteAll = true;\n  });\n\n  document.getElementById('closeDangerModal').addEventListener('click', () => {\n    document.getElementById('dangerModal').style.display = 'none';\n    pendingDeleteAll = false;\n  });\n\n  document.getElementById('cancelDanger').addEventListener('click', () => {\n    document.getElementById('dangerModal').style.display = 'none';\n    pendingDeleteAll = false;\n  });\n\n  document.getElementById('confirmDanger').addEventListener('click', async () => {\n    if (pendingDeleteAll) {\n      try {\n        await API.adminDeleteAllPosts();\n        document.getElementById('dangerModal').style.display = 'none';\n        pendingDeleteAll = false;\n        loadAdminData();\n      } catch (err) {\n        alert('Error: ' + err.message);\n      }\n    }\n  });\n\n  loadAdminData();\n})();\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/public/redsocial/js/profile.js",
          "name": "profile.js",
          "content": "// Profile page logic\n(async () => {\n  await Auth.init();\n\n  if (!Auth.isLoggedIn()) {\n    window.location.href = BASE_PATH + '/pages/login.html';\n    return;\n  }\n\n  const user = Auth.getUser();\n  const avatarPlaceholder = document.getElementById('avatarPlaceholder');\n  const profilePic = document.getElementById('profilePic');\n  const profileUsername = document.getElementById('profileUsername');\n  const profileEmail = document.getElementById('profileEmail');\n  const profileBio = document.getElementById('profileBio');\n  const profileDate = document.getElementById('profileDate');\n  const myPostsGrid = document.getElementById('myPostsGrid');\n  const noPosts = document.getElementById('noPosts');\n\n  // Load user profile\n  async function loadProfile() {\n    try {\n      const userData = await API.getUser(user.id);\n      \n      profileUsername.textContent = userData.username;\n      profileEmail.textContent = userData.email;\n      profileBio.textContent = userData.bio || 'Sin biografía aún.';\n      profileDate.textContent = 'Miembro desde: ' + new Date(userData.created_at).toLocaleDateString('es-AR');\n\n      if (userData.profile_pic) {\n        profilePic.src = imgUrl(userData.profile_pic);\n        profilePic.style.display = 'block';\n        avatarPlaceholder.style.display = 'none';\n      } else {\n        avatarPlaceholder.textContent = userData.username[0].toUpperCase();\n      }\n\n      // Load user posts\n      if (userData.posts && userData.posts.length > 0) {\n        noPosts.style.display = 'none';\n        myPostsGrid.innerHTML = '';\n        userData.posts.forEach(post => {\n          myPostsGrid.appendChild(createPostCard(post));\n        });\n      } else {\n        myPostsGrid.innerHTML = '';\n        noPosts.style.display = 'block';\n      }\n    } catch (err) {\n      console.error('Error loading profile:', err);\n    }\n  }\n\n  function createPostCard(post) {\n    const catLabels = { 'post': 'Publicacion', 'event': 'Evento', 'place': 'Lugar', 'tourist_spot': 'Sitio Turistico' };\n    const card = document.createElement('div');\n    card.className = 'post-card';\n    const imgHtml = post.image_url\n      ? `<img class=\"post-card-image\" src=\"${imgUrl(post.image_url)}\" alt=\"${post.title}\">`\n      : `<div class=\"post-card-image-placeholder\">&#9670;</div>`;\n    card.innerHTML = `\n      ${imgHtml}\n      <div class=\"post-card-body\">\n        <div class=\"post-card-meta\">\n          <span class=\"post-category\">${catLabels[post.category] || post.category}</span>\n          <span class=\"post-date\">${new Date(post.created_at).toLocaleDateString('es-AR')}</span>\n        </div>\n        <h3 class=\"post-card-title\">${post.title}</h3>\n        <p class=\"post-card-content\">${post.content.substring(0, 150)}...</p>\n        <div class=\"post-actions\">\n          <button class=\"post-action-btn\" onclick=\"deleteMyPost(${post.id})\">&#128465; Eliminar</button>\n        </div>\n      </div>\n    `;\n    return card;\n  }\n\n  window.deleteMyPost = async (postId) => {\n    if (!confirm('Eliminar esta publicacion?')) return;\n    try {\n      await API.deletePost(postId);\n      loadProfile();\n    } catch (err) {\n      alert('Error: ' + err.message);\n    }\n  };\n\n  // Edit profile modal\n  const editBtn = document.getElementById('editProfileBtn');\n  const editModal = document.getElementById('editModal');\n  const closeEditBtn = document.getElementById('closeEditModal');\n\n  editBtn.addEventListener('click', () => editModal.style.display = 'flex');\n  closeEditBtn.addEventListener('click', () => editModal.style.display = 'none');\n  editModal.addEventListener('click', (e) => {\n    if (e.target === editModal) editModal.style.display = 'none';\n  });\n\n  document.getElementById('editProfileForm').addEventListener('submit', async (e) => {\n    e.preventDefault();\n    const formData = new FormData();\n    const fileInput = document.getElementById('profilePicInput');\n    const bio = document.getElementById('bio').value;\n    \n    if (fileInput.files[0]) formData.append('profile_pic', fileInput.files[0]);\n    if (bio) formData.append('bio', bio);\n\n    try {\n      await API.updateProfile(formData);\n      editModal.style.display = 'none';\n      loadProfile();\n      showToast('Perfil actualizado', 'success');\n    } catch (err) {\n      alert('Error: ' + err.message);\n    }\n  });\n\n  function showToast(msg, type) {\n    const toast = document.createElement('div');\n    toast.className = `toast ${type}`;\n    toast.textContent = msg;\n    document.body.appendChild(toast);\n    setTimeout(() => toast.remove(), 3000);\n  }\n\n  loadProfile();\n})();\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/server/data/posts.json",
          "name": "posts.json",
          "content": "[\n  {\n    \"id\": \"post1\",\n    \"title\": \"Fiesta del Sol 2025\",\n    \"content\": \"La fiesta más importante de San Juan se celebra en febrero. Un espectáculo único con artistas nacionales e internacionales, feria de artesanos y lo mejor de la cultura local.\",\n    \"hashtags\": \"#Entretenimiento,#Historia\",\n    \"location\": \"Estadio del Bicentenario, San Juan\",\n    \"image_url\": \"/redsocial/uploads/fiesta_sol.jpg\",\n    \"user_id\": \"admin001\",\n    \"username\": \"admin\",\n    \"created_at\": \"2026-06-01T10:00:00.000Z\",\n    \"updated_at\": \"2026-06-01T10:00:00.000Z\"\n  },\n  {\n    \"id\": \"post2\",\n    \"title\": \"Bodega Graffigna - Experiencia única\",\n    \"content\": \"Una de las bodegas más emblemáticas de San Juan. Recorrido por sus instalaciones históricas, degustación de vinos premiados y una vista espectacular de los viñedos al pie de la Cordillera.\",\n    \"hashtags\": \"#Gastronomia,#Naturaleza\",\n    \"location\": \"Calle Gral. Acha, Rawson, San Juan\",\n    \"image_url\": \"/redsocial/uploads/bodega_graffigna.jpg\",\n    \"user_id\": \"admin001\",\n    \"username\": \"admin\",\n    \"created_at\": \"2026-06-05T14:30:00.000Z\",\n    \"updated_at\": \"2026-06-05T14:30:00.000Z\"\n  },\n  {\n    \"id\": \"post3\",\n    \"title\": \"Parque Nacional Ischigualasto\",\n    \"content\": \"El Valle de la Luna, patrimonio de la humanidad. Un paisaje único en el mundo donde se pueden apreciar formaciones geológicas de millones de años. Imperdible el recorrido nocturno con luna llena.\",\n    \"hashtags\": \"#Naturaleza,#Historia\",\n    \"location\": \"Ruta 150, Valle Fértil, San Juan\",\n    \"image_url\": \"/redsocial/uploads/ischigualasto.jpg\",\n    \"user_id\": \"admin001\",\n    \"username\": \"admin\",\n    \"created_at\": \"2026-06-10T09:00:00.000Z\",\n    \"updated_at\": \"2026-06-10T09:00:00.000Z\"\n  },\n  {\n    \"id\": \"post4\",\n    \"title\": \"Cerro Mercedario - Aventura de altura\",\n    \"content\": \"El pico más alto de la provincia con 6.770 msnm. Ideal para expediciones de montañismo avanzado. Las vistas desde la cima son simplemente indescriptibles.\",\n    \"hashtags\": \"#Naturaleza\",\n    \"location\": \"Cordillera de los Andes, San Juan\",\n    \"image_url\": \"/redsocial/uploads/cerro_mercedario.jpg\",\n    \"user_id\": \"admin001\",\n    \"username\": \"admin\",\n    \"created_at\": \"2026-06-15T11:00:00.000Z\",\n    \"updated_at\": \"2026-06-15T11:00:00.000Z\"\n  },\n  {\n    \"id\": \"post5\",\n    \"title\": \"Feria de Artesanos - Plaza 25 de Mayo\",\n    \"content\": \"Todos los fines de semana los artesanos sanjuaninos muestran su talento. Alfarería, tejidos, cueros, joyería artesanal y las famosas artesanías en piedra de Ischigualasto.\",\n    \"hashtags\": \"#Historia,#Gastronomia\",\n    \"location\": \"Plaza 25 de Mayo, San Juan Capital\",\n    \"image_url\": \"/redsocial/uploads/feria_artesanos.jpg\",\n    \"user_id\": \"admin001\",\n    \"username\": \"admin\",\n    \"created_at\": \"2026-06-20T16:00:00.000Z\",\n    \"updated_at\": \"2026-06-20T16:00:00.000Z\"\n  },\n  {\n    \"id\": \"post6\",\n    \"title\": \"Chalet Cantoni - Historia viva\",\n    \"content\": \"Una joya arquitectónica en pleno centro sanjuanino. Construido a principios del siglo XX, este chalet estilo cantoni alberga el Museo Histórico Provincial con invaluables piezas de la historia local.\",\n    \"hashtags\": \"#Historia,#Alojamientos\",\n    \"location\": \"Av. Córdoba 250, San Juan Capital\",\n    \"image_url\": \"/redsocial/uploads/test_post.jpg\",\n    \"user_id\": \"admin001\",\n    \"username\": \"admin\",\n    \"created_at\": \"2026-06-25T08:30:00.000Z\",\n    \"updated_at\": \"2026-06-25T08:30:00.000Z\"\n  },\n  {\n    \"id\": \"1783026975792\",\n    \"title\": \"El puesto de panchos de Eric\",\n    \"content\": \"LOS mejores panchos\",\n    \"hashtags\": \"#Gastronomia\",\n    \"location\": \"Ciudad San Juan, centro calle Olavarría 123\",\n    \"image_url\": \"/redsocial/uploads/1783026975787_6ecxdk.png\",\n    \"user_id\": \"1783026896476\",\n    \"username\": \"pepe\",\n    \"created_at\": \"2026-07-02T21:16:15.792Z\",\n    \"updated_at\": \"2026-07-02T21:16:15.792Z\"\n  },\n  {\n    \"id\": \"1783082340370\",\n    \"title\": \"Visita el puesto de panchos de Joaquín\",\n    \"content\": \"Juego interactivo en San Juan\",\n    \"hashtags\": \"#Alojamientos\",\n    \"location\": \"San Juan\",\n    \"image_url\": \"/redsocial/uploads/1783082340368_tja79u.png\",\n    \"user_id\": \"1782923815149\",\n    \"username\": \"jpupper\",\n    \"created_at\": \"2026-07-03T12:39:00.370Z\",\n    \"updated_at\": \"2026-07-03T12:39:00.370Z\"\n  }\n]\n"
