          "path": "D:/Programacion/caminosysabores/public/reuniones.html",
          "name": "reuniones.html",
          "content": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>San Juan a la mesa - Reuniones Comex y Prensa</title>\n    <link rel=\"stylesheet\" href=\"css/style.css\">\n    <style>\n        body {\n            font-family: 'Ubuntu', sans-serif;\n            margin: 0;\n            padding: 0;\n            min-height: 100vh;\n            background: #f5f0eb;\n        }\n\n        .reuniones-botonera {\n            max-width: 500px;\n            margin: 0 auto;\n            min-height: 100vh;\n            display: flex;\n            flex-direction: column;\n        }\n\n        .reuniones-hero {\n            background: linear-gradient(135deg, #5A2828, #E6643C);\n            padding: 60px 30px 80px;\n            text-align: left;\n            color: white;\n            position: relative;\n        }\n\n        .reuniones-hero .produccion-etiqueta {\n            color: #F0E6DC;\n            margin-bottom: 10px;\n        }\n\n        .reuniones-hero h1 {\n            font-size: 3.2rem;\n            font-weight: bold;\n            line-height: 1.1;\n            margin: 0;\n        }\n\n        .reuniones-hero .hero-sub {\n            font-size: 1.1rem;\n            font-weight: 300;\n            margin-top: 15px;\n            opacity: 0.9;\n            line-height: 1.4;\n        }\n\n        .botonera-container {\n            flex: 1;\n            display: flex;\n            flex-direction: column;\n            gap: 20px;\n            padding: 40px 25px 30px;\n            margin-top: -30px;\n        }\n\n        .boton-card {\n            display: flex;\n            align-items: center;\n            gap: 20px;\n            background: white;\n            border-radius: 20px;\n            padding: 25px 20px;\n            text-decoration: none;\n            color: #333;\n            box-shadow: 0 4px 15px rgba(0,0,0,0.08);\n            transition: all 0.3s ease;\n            cursor: pointer;\n            border: 2px solid transparent;\n        }\n\n        .boton-card:hover {\n            transform: translateY(-3px);\n            box-shadow: 0 8px 25px rgba(0,0,0,0.12);\n            border-color: #E6643C;\n        }\n\n        .boton-card:active {\n            transform: translateY(0);\n        }\n\n        .boton-icon {\n            width: 70px;\n            height: 70px;\n            border-radius: 18px;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            flex-shrink: 0;\n            font-size: 2rem;\n        }\n\n        .boton-icon.conex {\n            background: linear-gradient(135deg, #E6643C, #D45336);\n        }\n\n        .boton-icon.prensa {\n            background: linear-gradient(135deg, #5078B4, #3A5F8E);\n        }\n\n        .boton-icon svg {\n            width: 36px;\n            height: 36px;\n            fill: white;\n        }\n\n        .boton-info {\n            flex: 1;\n        }\n\n        .boton-info h3 {\n            font-size: 1.4rem;\n            font-weight: bold;\n            margin: 0 0 4px;\n            color: #222;\n        }\n\n        .boton-info p {\n            font-size: 0.85rem;\n            color: #888;\n            margin: 0;\n            line-height: 1.3;\n        }\n\n        .boton-arrow {\n            font-size: 1.5rem;\n            color: #ccc;\n            transition: color 0.3s;\n        }\n\n        .boton-card:hover .boton-arrow {\n            color: #E6643C;\n        }\n\n        .reuniones-footer-info {\n            padding: 10px 25px 30px;\n            text-align: center;\n        }\n\n        .reuniones-footer-info p {\n            font-size: 0.8rem;\n            color: #999;\n            margin: 0;\n        }\n\n        @media (max-width: 500px) {\n            .reuniones-hero h1 { font-size: 2.5rem; }\n            .reuniones-hero { padding: 40px 20px 60px; }\n            .botonera-container { padding: 30px 20px 20px; }\n            .boton-card { padding: 18px 15px; }\n            .boton-icon { width: 55px; height: 55px; }\n            .boton-icon svg { width: 28px; height: 28px; }\n            .boton-info h3 { font-size: 1.15rem; }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"reuniones-botonera\">\n        <div class=\"reuniones-hero\">\n            <span class=\"produccion-etiqueta\">PRODUCCIONES</span>\n            <h1>Reuniones<br>Comex y<br>Prensa</h1>\n            <p class=\"hero-sub\">Seleccioná el tipo de reunión que querés coordinar</p>\n        </div>\n\n        <div class=\"botonera-container\">\n            <a href=\"conex.html\" class=\"boton-card\">\n                <div class=\"boton-icon conex\">\n                    <svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/>\n                    </svg>\n                </div>\n                <div class=\"boton-info\">\n                    <h3>Comex</h3>\n                    <p>Reuniones de negocios, comercio exterior y distribución</p>\n                </div>\n                <span class=\"boton-arrow\">→</span>\n            </a>\n\n            <a href=\"prensa.html\" class=\"boton-card\">\n                <div class=\"boton-icon prensa\">\n                    <svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n                        <path d=\"M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12z\"/>\n                        <path d=\"M7 9h2v2H7zm4 0h6v2h-6zm0 4h6v2h-6zm-4 0h2v2H7z\" opacity=\"0.6\"/>\n                    </svg>\n                </div>\n                <div class=\"boton-info\">\n                    <h3>Prensa</h3>\n                    <p>Entrevistas, medios y cobertura periodística</p>\n                </div>\n                <span class=\"boton-arrow\">→</span>\n            </a>\n        </div>\n\n        <div class=\"reuniones-footer-info\">\n            <p>Gobierno de San Juan · Caminos y Sabores 2026</p>\n        </div>\n    </div>\n\n    <script src=\"js/header.js\"></script>\n    <script src=\"js/footer.js\"></script>\n    <script src=\"js/touch.js\"></script>\n</body>\n</html>\n"
