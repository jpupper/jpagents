          "path": "D:/Programacion/caminosysabores/public/redsocial/index.html",
          "name": "index.html",
          "content": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Comparti San Juan</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Open+Sans:wght@300;400;600&display=swap\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"css/style.css\">\n</head>\n<body>\n  <!-- Header -->\n  <header class=\"header\">\n    <div class=\"header-inner\">\n      <a href=\".\" class=\"logo\">\n        <img src=\"imgs/logos/origensanjuan.png\" alt=\"Comparti San Juan\" class=\"logo-img\">\n        <span class=\"logo-text\">COMPARTI<span class=\"logo-highlight\"> SAN JUAN</span></span>\n      </a>\n      <nav class=\"nav\" id=\"mainNav\">\n        <a href=\".\" class=\"nav-link active\">Inicio</a>\n        <a href=\"pages/evento-galeria.html\" class=\"nav-link\" id=\"navEvento\">En Vivo</a>\n        <a href=\"pages/create-post.html\" class=\"nav-link\" id=\"navCreatePost\">Publicar</a>\n        <a href=\"pages/profile.html\" class=\"nav-link\" id=\"navProfile\">Mi Perfil</a>\n        <a href=\"pages/admin.html\" class=\"nav-link\" id=\"navAdmin\">Admin</a>\n      </nav>\n      <div class=\"header-actions\">\n        <a href=\"pages/login.html\" class=\"btn btn-outline\" id=\"btnLogin\">Ingresar</a>\n        <a href=\"pages/register.html\" class=\"btn btn-outline\" id=\"btnRegister\">Registrarse</a>\n        <button class=\"btn btn-outline\" id=\"btnLogout\">Salir</button>\n        <button class=\"hamburger\" id=\"hamburgerBtn\">&#9776;</button>\n      </div>\n    </div>\n  </header>\n\n  <!-- Hero Section -->\n  <section class=\"hero\" id=\"hero\">\n    <canvas id=\"heroCanvas\"></canvas>\n    <div class=\"hero-overlay\"></div>\n    <div class=\"hero-content\">\n      <div class=\"hero-brand\">\n        <img src=\"imgs/logos/origensanjuan.png\" alt=\"Comparti San Juan\" class=\"hero-logo\">\n        <h1 class=\"hero-title\">COMPARTI SAN JUAN</h1>\n      </div>\n      <div class=\"hero-actions\">\n        <button class=\"btn btn-primary btn-lg\" id=\"heroJoinBtn\">Comparti</button>\n        <a href=\"pages/evento-galeria.html\" class=\"btn btn-outline-light btn-lg\">En Vivo</a>\n        <a href=\"#feed\" class=\"btn btn-outline-light btn-lg\">Explorar</a>\n      </div>\n    </div>\n  </section>\n\n  <!-- Search + Hashtags Filter -->\n  <div class=\"search-section\">\n    <div class=\"container\">\n      <div class=\"search-bar-wrapper\">\n        <div class=\"search-input-group\">\n          <span class=\"search-icon\">&#128269;</span>\n          <input type=\"text\" id=\"searchInput\" class=\"search-input\" placeholder=\"Buscar lugares, eventos, experiencias...\" autocomplete=\"off\">\n        </div>\n        <div class=\"search-hashtags\" id=\"hashtagPills\">\n          <button class=\"hashtag-pill active\" data-hashtag=\"all\">Todas</button>\n          <button class=\"hashtag-pill\" data-hashtag=\"#Gastronomia\">#Gastronomia</button>\n          <button class=\"hashtag-pill\" data-hashtag=\"#Entretenimiento\">#Entretenimiento</button>\n          <button class=\"hashtag-pill\" data-hashtag=\"#Naturaleza\">#Naturaleza</button>\n          <button class=\"hashtag-pill\" data-hashtag=\"#Alojamientos\">#Alojamientos</button>\n          <button class=\"hashtag-pill\" data-hashtag=\"#Historia\">#Historia</button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- Feed Section -->\n  <section class=\"feed-section\" id=\"feed\">\n    <div class=\"container\">\n      <div class=\"feed-header\">\n        <h2>Explorar San Juan</h2>\n        <p class=\"feed-subtitle\">Descubri lo que la comunidad esta compartiendo</p>\n      </div>\n\n      <div class=\"feed-grid\" id=\"feedGrid\">\n        <div class=\"loading-spinner\" id=\"loadingSpinner\">\n          <div class=\"spinner\"></div>\n          <p>Cargando publicaciones...</p>\n        </div>\n      </div>\n\n      <div class=\"feed-empty\" id=\"feedEmpty\" style=\"display:none;\">\n        <div class=\"empty-icon\">&#9670;</div>\n        <h3>Todavia no hay publicaciones</h3>\n        <p>Se el primero en compartir algo sobre San Juan.</p>\n        <a href=\"pages/create-post.html\" class=\"btn btn-primary mt-2\">Crear publicacion</a>\n      </div>\n    </div>\n  </section>\n\n  <!-- Stats Section -->\n  <section class=\"stats-section\">\n    <div class=\"container\">\n      <div class=\"stats-grid\">\n        <div class=\"stat-item\">\n          <span class=\"stat-number\" id=\"totalPlaces\">0</span>\n          <span class=\"stat-desc\">Lugares compartidos</span>\n        </div>\n        <div class=\"stat-item\">\n          <span class=\"stat-number\" id=\"totalEvents\">0</span>\n          <span class=\"stat-desc\">Eventos registrados</span>\n        </div>\n        <div class=\"stat-item\">\n          <span class=\"stat-number\" id=\"totalUsers\">0</span>\n          <span class=\"stat-desc\">Miembros activos</span>\n        </div>\n        <div class=\"stat-item\">\n          <span class=\"stat-number\" id=\"totalPosts\">0</span>\n          <span class=\"stat-desc\">Publicaciones</span>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Footer -->\n  <!-- Login/Register Modal -->\n  <div class=\"modal-overlay\" id=\"authModal\" style=\"display:none;\">\n    <div class=\"modal-content\">\n      <button class=\"modal-close\" id=\"modalClose\">&times;</button>\n      <div class=\"modal-header\">\n        <div class=\"modal-icon\">&#9670;</div>\n        <h2>Comparti San Juan</h2>\n        <p>Ingresa o registrate para compartir</p>\n      </div>\n      <div class=\"modal-actions\">\n        <a href=\"pages/login.html\" class=\"btn btn-primary btn-lg btn-full\">Ingresar</a>\n        <a href=\"pages/register.html\" class=\"btn btn-outline btn-lg btn-full\">Registrarse</a>\n      </div>\n    </div>\n  </div>\n\n  <footer class=\"footer\">\n    <div class=\"container\">\n      <div class=\"footer-grid\">\n        <div class=\"footer-brand\">\n          <span class=\"footer-logo\">&#9670; COMPARTI SAN JUAN</span>\n          <p>Una comunidad para compartir y descubrir todo lo que la provincia de San Juan tiene para ofrecer. Lugares, eventos, bodegas, montañas y experiencias unicas.</p>\n        </div>\n        <div class=\"footer-links\">\n          <h4>Explorar</h4>\n          <a href=\".\">Inicio</a>\n          <a href=\"pages/create-post.html\">Publicar</a>\n          <a href=\"pages/profile.html\">Mi Perfil</a>\n        </div>\n        <div class=\"footer-links\">\n          <h4>San Juan</h4>\n          <a href=\"#\">Bodegas</a>\n          <a href=\"#\">Montañas</a>\n          <a href=\"#\">Eventos</a>\n          <a href=\"#\">Rutas Turisticas</a>\n        </div>\n      </div>\n      <div class=\"footer-bottom\">\n        <p>&copy; 2025 Comparti San Juan</p>\n\n      </div>\n    </div>\n  </footer>\n\n  <script src=\"js/api.js\"></script>\n  <script src=\"js/auth.js\"></script>\n  <script src=\"js/feed.js\"></script>\n  <script src=\"js/hero-canvas.js\"></script>\n  <script src=\"js/app.js\"></script>\n</body>\n</html>\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/public/maqueta/index.html",
          "name": "index.html",
          "content": "<!DOCTYPE html>\r\n<html lang=\"es\">\r\n<head>\r\n    <meta charset=\"UTF-8\" />\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no\" />\r\n    <title>San Juan · Territorio Turístico</title>\r\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\r\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\r\n    <link href=\"https://fonts.googleapis.com/css2?family=Ubuntu:wght@300;400;500;600;700&display=swap\" rel=\"stylesheet\">\r\n    <style>\r\n        * { margin:0; padding:0; box-sizing:border-box; }\r\n        body {\r\n            font-family:'Ubuntu',system-ui,-apple-system,sans-serif;\r\n            background:#1a1412; overflow:hidden; height:100vh; width:100vw;\r\n            position:fixed; touch-action:none;\r\n            -webkit-touch-callout:none; -webkit-user-select:none; user-select:none;\r\n        }\r\n        #c { width:100vw; height:100vh; display:block; }\r\n\r\n        /* INTRO OVERLAY */\r\n        #intro {\r\n            position:fixed; inset:0; z-index:200;\r\n            background:radial-gradient(ellipse at 50% 40%, #2a1f1a, #140f0c);\r\n            display:flex; flex-direction:column; align-items:center; justify-content:center;\r\n            transition:none;\r\n        }\r\n        #intro.hide {\r\n            opacity:0;\r\n            pointer-events:none;\r\n            transition:none;\r\n        }\r\n        #intro.zoom-in #intro-map {\r\n            transform-origin:25.60% 29.11%;\r\n            transform:scale(4);\r\n            opacity:0;\r\n            transition:transform 2.5s cubic-bezier(0.22,1,0.36,1), opacity 1.5s ease 0.8s;\r\n        }\r\n        #intro.zoom-in #intro-title {\r\n            opacity:0; transform:translateY(-20px);\r\n            transition:all 0.6s ease;\r\n        }\r\n        #intro.zoom-in #intro-btn {\r\n            opacity:0; transform:scale(0.8);\r\n            transition:all 0.4s ease;\r\n        }\r\n\r\n        #intro-map {\r\n            width:min(75vw, 500px); height:auto;\r\n            transition:transform 2.5s cubic-bezier(0.22,1,0.36,1), opacity 1.5s ease 0.8s;\r\n            position:relative;\r\n        }\r\n        #intro-map svg {\r\n            width:100%; height:auto;\r\n            display:block;\r\n            filter:drop-shadow(0 0 60px rgba(229,83,54,0.15));\r\n        }\r\n\r\n        #intro-title {\r\n            color:#f0e6d0;\r\n            text-align:center; margin-bottom:12px;\r\n            transition:all 0.6s ease;\r\n        }\r\n        #intro-title h1 {\r\n            font-size:clamp(20px, 4vw, 36px);\r\n            font-weight:500; letter-spacing:2px;\r\n            margin-bottom:2px;\r\n        }\r\n        #intro-title .sub {\r\n            font-size:clamp(11px, 1.5vw, 14px);\r\n            color:rgba(240,230,208,0.4);\r\n            letter-spacing:3px; text-transform:uppercase;\r\n        }\r\n\r\n        #intro-btn {\r\n            margin-top:16px;\r\n            padding:14px 52px;\r\n            border:1px solid rgba(229,83,54,0.5);\r\n            border-radius:40px;\r\n            background:rgba(229,83,54,0.12);\r\n            color:#e55336;\r\n            font-size:15px; font-weight:500;\r\n            font-family:'Ubuntu',system-ui,sans-serif;\r\n            letter-spacing:3px; text-transform:uppercase;\r\n            cursor:pointer;\r\n            transition:all 0.3s ease;\r\n            backdrop-filter:blur(4px);\r\n        }\r\n        #intro-btn:hover {\r\n            background:rgba(229,83,54,0.25);\r\n            border-color:rgba(229,83,54,0.8);\r\n            transform:scale(1.04);\r\n            box-shadow:0 0 30px rgba(229,83,54,0.15);\r\n        }\r\n        #intro-btn:active { transform:scale(0.97); }\r\n\r\n        /* Province map labels */\r\n        .prov-lbl {\r\n            font-size:4.5px; fill:rgba(240,230,208,0.22);\r\n            font-family:'Ubuntu',system-ui,sans-serif;\r\n            text-anchor:middle; letter-spacing:0.3px;\r\n        }\r\n        .prov-lbl-sj {\r\n            font-size:7px; fill:#e55336; font-weight:700;\r\n            font-family:'Ubuntu',system-ui,sans-serif;\r\n            text-anchor:middle; letter-spacing:1px;\r\n        }\r\n\r\n        /* San Juan pulse dot */\r\n        @keyframes sj-pulse {\r\n            0%, 100% { r:4; opacity:0.8; }\r\n            50% { r:7; opacity:0.3; }\r\n        }\r\n        .sj-dot { animation:sj-pulse 2s ease-in-out infinite; }\r\n\r\n        #in { z-index:10; }\r\n        #zc { z-index:10; }\r\n        #lg { z-index:10; }\r\n        #sg {\r\n            z-index:10; position:fixed; top:16px; right:16px;\r\n            width:44px; height:44px; border-radius:50%;\r\n            background:rgba(79,79,79,0.85);\r\n            border:1px solid rgba(229,83,54,0.3);\r\n            color:#e55336; font-size:22px; cursor:pointer;\r\n            display:flex; align-items:center; justify-content:center;\r\n            backdrop-filter:blur(4px);\r\n            transition:all 0.3s ease;\r\n        }\r\n        #sg:hover { background:rgba(229,83,54,0.25); border-color:#e55336; transform:scale(1.1); }\r\n        #sg.active { background:rgba(229,83,54,0.2); border-color:#e55336; }\r\n\r\n            /* Auth overlay */\r\n            #auth-overlay {\r\n                position:fixed; inset:0; z-index:2000;\r\n                background:rgba(0,0,0,0.6);\r\n                backdrop-filter:blur(4px);\r\n                display:flex; align-items:center; justify-content:center;\r\n                opacity:0; pointer-events:none;\r\n                transition:opacity 0.3s ease;\r\n            }\r\n            #auth-overlay.v { opacity:1; pointer-events:all; }\r\n            #auth-panel {\r\n                background:#3a3a3a; border:1px solid rgba(229,83,54,0.2);\r\n                border-radius:14px; padding:24px;\r\n                width:94%; max-width:360px;\r\n                position:relative;\r\n                color:#f0e6d0; font-family:'Ubuntu',system-ui,sans-serif;\r\n                transform:translateY(-20px);\r\n                transition:transform 0.3s ease;\r\n            }\r\n            #auth-overlay.v #auth-panel { transform:translateY(0); }\r\n            .auth-close {\r\n                position:absolute; top:10px; right:12px;\r\n                background:none; border:none; color:rgba(255,255,255,0.4);\r\n                font-size:22px; cursor:pointer;\r\n                font-family:'Ubuntu',system-ui,sans-serif;\r\n            }\r\n            .auth-close:hover { color:#e55336; }\r\n            .auth-title {\r\n                font-size:16px; font-weight:600; color:#e55336;\r\n                margin-bottom:14px; text-transform:uppercase; letter-spacing:1px;\r\n            }\r\n            .auth-input {\r\n                width:100%; padding:10px 12px; margin-bottom:8px;\r\n                background:rgba(0,0,0,0.3); border:1px solid rgba(229,83,54,0.15);\r\n                border-radius:8px; color:#f0e6d0; font-size:14px;\r\n                font-family:'Ubuntu',system-ui,sans-serif; outline:none;\r\n                transition:border-color 0.2s; box-sizing:border-box;\r\n            }\r\n            .auth-input:focus { border-color:rgba(229,83,54,0.5); }\r\n            .auth-input::placeholder { color:rgba(255,255,255,0.25); }\r\n            .auth-btn {\r\n                width:100%; padding:10px; margin-top:4px;\r\n                border:1px solid rgba(229,83,54,0.3);\r\n                border-radius:8px; background:rgba(229,83,54,0.15);\r\n                color:#e55336; font-size:13px; font-weight:600; cursor:pointer;\r\n                transition:all 0.2s;\r\n                font-family:'Ubuntu',system-ui,sans-serif;\r\n                text-transform:uppercase; letter-spacing:1px;\r\n            }\r\n            .auth-btn:hover { background:rgba(229,83,54,0.25); }\r\n            .auth-btn.logout { border-color:rgba(255,80,80,0.3); color:#ff6666; background:rgba(255,80,80,0.1); }\r\n            .auth-btn.logout:hover { background:rgba(255,80,80,0.2); }\r\n            .auth-switch { text-align:center; margin-top:10px; font-size:12px; color:rgba(255,255,255,0.4); }\r\n            .auth-switch a { color:#e55336; text-decoration:none; font-weight:500; }\r\n            .auth-switch a:hover { text-decoration:underline; }\r\n            .auth-error { text-align:center; margin-top:8px; font-size:12px; color:#ff6666; display:block; }\r\n            .auth-profile-name { font-size:16px; font-weight:600; color:#f0e6d0; margin-bottom:2px; }\r\n            .auth-profile-email { font-size:12px; color:rgba(255,255,255,0.4); margin-bottom:14px; }\r\n        /* Settings tabs */\r\n        #sp .sp-tabs { display:flex; gap:4px; margin-bottom:12px; border-bottom:1px solid rgba(229,83,54,0.15); padding-bottom:8px; }\r\n        #sp .sp-tab { flex:1; padding:6px 4px; border:none; border-radius:6px; background:transparent; color:rgba(255,255,255,0.35); font-size:10px; font-weight:600; cursor:pointer; transition:all 0.2s; font-family:'Ubuntu',system-ui,sans-serif; text-transform:uppercase; letter-spacing:1px; }\r\n        #sp .sp-tab:hover { color:rgba(255,255,255,0.6); background:rgba(229,83,54,0.08); }\r\n        #sp .sp-tab.active { color:#e55336; background:rgba(229,83,54,0.12); }\r\n        #sp .sp-tab-content { display:none; }\r\n        #sp .sp-tab-content.active { display:block; }\r\n        #sp { z-index:10; position:fixed; top:68px; right:16px; width:260px; background:#4f4f4f; border:1px solid rgba(229,83,54,0.2); border-radius:12px; padding:16px; opacity:0; pointer-events:none; transform:translateY(-10px); transition:all 0.3s ease; backdrop-filter:blur(8px); }\r\n        #sp.v { opacity:1; pointer-events:all; transform:translateY(0); }\r\n        #sp .sp-h { font-size:11px; font-weight:600; color:rgba(255,255,255,0.5); text-transform:uppercase; letter-spacing:2px; margin-bottom:8px; font-family:'Ubuntu',system-ui,sans-serif; }\r\n        #sp .lb { display:flex; align-items:center; gap:8px; padding:6px 8px; border-radius:6px; cursor:pointer; transition:all 0.2s; margin-bottom:2px; font-size:13px; font-family:'Ubuntu',system-ui,sans-serif; }\r\n        #sp .lb:hover { background:rgba(229,83,54,0.1); }\r\n        #sp .lb.off { opacity:0.4; }\r\n        #sp .lb-dot { width:8px; height:8px; border-radius:50%; }\r\n        #sp .lb-label { flex:1; color:rgba(255,255,255,0.8); }\r\n        #sp .lb-ind::after { content:'ON'; color:#e55336; font-weight:700; font-size:10px; }\r\n        #sp .lb.off .lb-ind::after { content:'OFF'; color:rgba(255,255,255,0.3); }\r\n        #sp .sv-row { display:flex; align-items:center; gap:8px; margin-bottom:6px; font-family:'Ubuntu',system-ui,sans-serif; }\r\n        #sp .sv-label { font-size:11px; color:rgba(255,255,255,0.6); width:40px; }\r\n        #sp .sv-slider { flex:1; -webkit-appearance:none; height:4px; background:rgba(229,83,54,0.2); border-radius:2px; outline:none; }\r\n        #sp .sv-slider::-webkit-slider-thumb { -webkit-appearance:none; width:12px; height:12px; border-radius:50%; background:#e55336; cursor:pointer; border:2px solid #4f4f4f; }\r\n        #sp .lgroup { margin-bottom:1px; }\r\n        #sp .lsub { display:flex; align-items:center; gap:6px; padding:2px 8px 6px 16px; }\r\n        #sp .lsub .li-slider { flex:1; -webkit-appearance:none; height:3px; background:rgba(229,83,54,0.15); border-radius:2px; outline:none; }\r\n        #sp .lsub .li-slider::-webkit-slider-thumb { -webkit-appearance:none; width:10px; height:10px; border-radius:50%; background:#e55336; cursor:pointer; border:2px solid #4f4f4f; }\r\n        #sp .lsub .li-color { width:24px; height:20px; padding:0; border:1px solid rgba(229,83,54,0.2); border-radius:3px; cursor:pointer; background:transparent; flex-shrink:0; }\r\n        #sp .lsub .li-color::-webkit-color-swatch-wrapper { padding:0; }\r\n        #sp .lsub .li-color::-webkit-color-swatch { border:none; border-radius:2px; }\r\n        #sp .lsub .li-val { font-size:10px; color:rgba(255,255,255,0.4); width:30px; text-align:right; font-family:'Ubuntu',system-ui,sans-serif; flex-shrink:0; }\r\n        #sp .sv-val { font-size:11px; color:rgba(255,255,255,0.5); width:38px; text-align:right; font-family:'Ubuntu',system-ui,sans-serif; }\r\n        #sp .pp-slider { flex:1; -webkit-appearance:none; height:4px; background:rgba(229,83,54,0.2); border-radius:2px; outline:none; }\r\n        #sp .pp-slider::-webkit-slider-thumb { -webkit-appearance:none; width:12px; height:12px; border-radius:50%; background:#e55336; cursor:pointer; border:2px solid #4f4f4f; }\r\n        #sv-save { width:100%; margin-top:8px; padding:8px; border:1px solid rgba(229,83,54,0.3); border-radius:6px; background:rgba(229,83,54,0.1); color:#e55336; font-size:12px; font-weight:600; cursor:pointer; transition:all 0.2s; font-family:'Ubuntu',system-ui,sans-serif; text-transform:uppercase; letter-spacing:1px; }\r\n        #sv-save:hover { background:rgba(229,83,54,0.25); }\r\n        #fps { font-size:10px; color:rgba(255,255,255,0.2); text-align:right; margin-top:6px; font-family:'Ubuntu',system-ui,sans-serif; }\r\n        #mo { z-index:100; }\r\n        #mo { position:fixed; inset:0; background:transparent; display:flex; align-items:center; justify-content:center; opacity:0; pointer-events:none; transition:opacity 0.3s ease; z-index:1000; }\r\n        #mo.a { opacity:1; pointer-events:all; }\r\n        #md { background:#4f4f4f; border:1px solid rgba(229,83,54,0.3); border-radius:16px; max-width:420px; width:90%; padding:0; box-shadow:0 20px 60px rgba(0,0,0,0.4); position:relative; }\r\n        #md .mc { position:absolute; top:-14px; right:-14px; background:#e55336; border:2px solid #4f4f4f; color:#ffffff; font-size:18px; width:32px; height:32px; border-radius:50%; cursor:pointer; z-index:20; display:flex; align-items:center; justify-content:center; transition:all 0.2s; font-family:'Ubuntu',system-ui,sans-serif; line-height:1; font-weight:700; }\r\n        #md .mc:hover { background:#ff7a5c; transform:scale(1.15); }\r\n        #md .mi { width:100%; height:100px; object-fit:cover; display:block; border-radius:16px 16px 0 0; background:rgba(229,83,54,0.08); }\r\n        #md .mb { padding:0 16px 12px; position:relative; }\r\n        #md .mb > #modal-main { padding-top:10px; }\r\n        #md .mb > #modal-sub { padding-top:10px; }\r\n        #md .md2 { width:10px; height:10px; border-radius:50%; position:absolute; top:-5px; left:20px; border:2px solid #4f4f4f; background:#e55336; }\r\n        #md .mci { font-size:10px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; margin-bottom:2px; font-family:'Ubuntu',system-ui,sans-serif; color:#ffffff; }\r\n        #md #mt { font-size:15px; font-weight:600; color:#ffffff; margin:1px 0 4px; line-height:1.3; font-family:'Ubuntu',system-ui,sans-serif; }\r\n        #md #md3 { font-size:12px; color:rgba(255,255,255,0.7); line-height:1.4; margin:0; font-family:'Ubuntu',system-ui,sans-serif; }\r\n        #ld { z-index:150; }\r\n        #lg {\r\n            position:fixed; bottom:20px; left:20px; z-index:10;\r\n            background:rgba(79,79,79,0.9); border:1px solid rgba(229,83,54,0.15);\r\n            border-radius:10px; padding:12px 16px;\r\n            backdrop-filter:blur(6px);\r\n        }\r\n        #lg .lt { font-size:10px; font-weight:600; color:rgba(255,255,255,0.4); text-transform:uppercase; letter-spacing:2px; margin-bottom:6px; font-family:'Ubuntu',system-ui,sans-serif; }\r\n        #lg .li { display:flex; align-items:center; gap:8px; font-size:12px; color:rgba(255,255,255,0.7); margin-bottom:3px; font-family:'Ubuntu',system-ui,sans-serif; }\r\n        #lg .ld { width:8px; height:8px; border-radius:50%; display:inline-block; }\r\n        #in {\r\n            position:fixed; bottom:20px; left:50%; transform:translateX(-50%); z-index:10;\r\n            color:rgba(255,255,255,0.35); font-size:12px; font-family:'Ubuntu',system-ui,sans-serif;\r\n            letter-spacing:1px; text-align:center;\r\n            transition:opacity 0.5s ease;\r\n            pointer-events:none;\r\n        }\r\n        #in.h { opacity:0; }\r\n        #zc {\r\n            position:fixed; bottom:20px; right:20px; z-index:10;\r\n            display:flex; flex-direction:column; gap:4px;\r\n        }\r\n        #zc button {\r\n            width:36px; height:36px; border-radius:50%;\r\n            background:rgba(79,79,79,0.9); border:1px solid rgba(229,83,54,0.15);\r\n            color:#e55336; font-size:18px; cursor:pointer;\r\n            display:flex; align-items:center; justify-content:center;\r\n            transition:all 0.2s;\r\n            font-family:'Ubuntu',system-ui,sans-serif;\r\n        }\r\n        #zc button:hover { background:rgba(229,83,54,0.2); border-color:#e55336; }\r\n\r\n        /* POI ADMIN PANEL */\r\n        #poi-admin-overlay {\r\n            position:fixed; inset:0; z-index:500;\r\n            background:rgba(0,0,0,0.6);\r\n            backdrop-filter:blur(4px);\r\n            display:flex; align-items:center; justify-content:center;\r\n            opacity:0; pointer-events:none;\r\n            transition:opacity 0.3s ease;\r\n        }\r\n        #poi-admin-overlay.v { opacity:1; pointer-events:all; }\r\n        #poi-admin-panel {\r\n            background:#3a3a3a; border:1px solid rgba(229,83,54,0.2);\r\n            border-radius:14px; padding:20px;\r\n            width:94%; max-width:480px; max-height:85vh;\r\n            overflow-y:auto; position:relative;\r\n            color:#f0e6d0; font-family:'Ubuntu',system-ui,sans-serif;\r\n            transform:translateY(-20px);\r\n            transition:transform 0.3s ease;\r\n        }\r\n        #poi-admin-overlay.v #poi-admin-panel { transform:translateY(0); }\r\n        #poi-admin-panel::-webkit-scrollbar { width:4px; }\r\n        #poi-admin-panel::-webkit-scrollbar-track { background:transparent; }\r\n        #poi-admin-panel::-webkit-scrollbar-thumb { background:rgba(229,83,54,0.3); border-radius:2px; }\r\n        .poi-list-item {\r\n            display:flex; align-items:center; gap:8px;\r\n            padding:6px 8px; border-radius:6px; cursor:pointer;\r\n            transition:background 0.2s; margin-bottom:2px;\r\n        }\r\n        .poi-list-item:hover { background:rgba(229,83,54,0.1); }\r\n        .poi-list-item.active { background:rgba(229,83,54,0.15); }\r\n\r\n        @media (max-width:480px) {\r\n            #intro-map { width:85vw; }\r\n            #intro-btn { padding:12px 36px; font-size:13px; }\r\n        }\r\n        /* Sub-section buttons in modal - compact 2-column grid */\r\n        .m-sub-btn {\r\n            display:flex; align-items:center; gap:4px;\r\n            width:100%; padding:5px 8px;\r\n            border:1px solid rgba(229,83,54,0.15);\r\n            border-radius:6px;\r\n            background:rgba(79,79,79,0.5);\r\n            color:rgba(240,230,208,0.85);\r\n            font-size:9.5px; font-weight:500;\r\n            font-family:'Ubuntu',system-ui,sans-serif;\r\n            cursor:pointer;\r\n            transition:all 0.15s ease;\r\n            text-align:left;\r\n            line-height:1.2;\r\n        }\r\n        .m-sub-btn:hover {\r\n            background:rgba(229,83,54,0.15);\r\n            border-color:rgba(229,83,54,0.35);\r\n        }\r\n        .m-sub-btn:active { transform:scale(0.97); }\r\n        .m-sub-dot {\r\n            width:5px; height:5px; border-radius:50%;\r\n            flex-shrink:0;\r\n        }\r\n        .m-sub-label { flex:1; line-height:1.2; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:9px; }\r\n        .m-sub-arrow { font-size:12px; color:rgba(229,83,54,0.5); flex-shrink:0; }\r\n        .m-sub-btn:hover .m-sub-arrow {\r\n            transform:translateX(3px);\r\n            color:#e55336;\r\n        }\r\n        \r\n        /* Cross-fade between main view and sub view */\r\n        #modal-main, #modal-sub {\r\