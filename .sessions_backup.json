          "content": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Admin - Comparti San Juan</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Open+Sans:wght@300;400;600&display=swap\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"../css/style.css\">\n  <link rel=\"stylesheet\" href=\"../css/admin.css\">\n</head>\n<body>\n  <!-- Header unificado -->\n  <section class=\"hero\" id=\"adminHero\" data-line-effect=\"adminHero\" style=\"min-height:64px;padding:0\">\n    <div class=\"header-inner\" style=\"position:relative;z-index:2;height:64px;padding:0 var(--space-lg);min-height:64px\">\n      <a href=\"..\" class=\"logo\">\n        <img src=\"../imgs/logos/origensanjuan.png\" alt=\"Comparti San Juan\" class=\"logo-img\">\n        <span class=\"logo-text\">COMPARTI<span class=\"logo-highlight\"> SAN JUAN</span></span>\n      </a>\n      <div class=\"header-actions-group\" style=\"display:flex;align-items:center;gap:var(--space-xl);padding-left:var(--space-3xl)\">\n        <nav class=\"nav\" style=\"display:flex;gap:var(--space-xl)\">\n          <a href=\"..\" class=\"nav-link\">Inicio</a>\n          <a href=\"create-post.html\" class=\"nav-link\">Publicar</a>\n          <a href=\"profile.html\" class=\"nav-link\">Mi Perfil</a>\n          <a href=\"admin.html\" class=\"nav-link active\">Admin</a>\n        </nav>\n        <div class=\"header-actions\">\n          <button class=\"btn btn-outline\" id=\"btnLogout\">Salir</button>\n          <button class=\"hamburger\" id=\"hamburgerBtn\">&#9776;</button>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"admin-section\">\n    <div class=\"container\">\n      <div class=\"admin-header\">\n        <div class=\"admin-badge\">ADMIN</div>\n        <h1>Panel de Administracion</h1>\n        <p>Gestiona todas las publicaciones y usuarios de San Juan Social</p>\n      </div>\n\n      <!-- Stats -->\n      <div class=\"admin-stats\">\n        <div class=\"stat-card\">\n          <span class=\"stat-number\" id=\"statUsers\">0</span>\n          <span class=\"stat-label\">Usuarios</span>\n        </div>\n        <div class=\"stat-card\">\n          <span class=\"stat-number\" id=\"statPosts\">0</span>\n          <span class=\"stat-label\">Publicaciones</span>\n        </div>\n        <div class=\"stat-card\">\n          <span class=\"stat-number\" id=\"statEvents\">0</span>\n          <span class=\"stat-label\">Eventos</span>\n        </div>\n        <div class=\"stat-card\">\n          <span class=\"stat-number\" id=\"statPlaces\">0</span>\n          <span class=\"stat-label\">Lugares</span>\n        </div>\n      </div>\n\n      <!-- Admin Tabs -->\n      <div class=\"admin-tabs\">\n        <button class=\"admin-tab active\" data-tab=\"posts\">Publicaciones</button>\n        <button class=\"admin-tab\" data-tab=\"users\">Usuarios</button>\n      </div>\n\n      <!-- Posts Management -->\n      <div class=\"admin-panel\" id=\"postsPanel\">\n        <div class=\"admin-panel-header\">\n          <h2>Todas las Publicaciones</h2>\n          <button class=\"btn btn-danger\" id=\"deleteAllBtn\">Eliminar TODAS</button>\n        </div>\n        <div class=\"admin-table-wrapper\">\n          <table class=\"admin-table\" id=\"postsTable\">\n            <thead>\n              <tr>\n                <th>ID</th>\n                <th>Titulo</th>\n                <th>Autor</th>\n                <th>Categoria</th>\n                <th>Fecha</th>\n                <th>Acciones</th>\n              </tr>\n            </thead>\n            <tbody id=\"postsTableBody\">\n              <tr><td colspan=\"6\" class=\"table-loading\">Cargando...</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      <!-- Users Management -->\n      <div class=\"admin-panel\" id=\"usersPanel\" style=\"display:none\">\n        <div class=\"admin-panel-header\">\n          <h2>Todos los Usuarios</h2>\n        </div>\n        <div class=\"admin-table-wrapper\">\n          <table class=\"admin-table\" id=\"usersTable\">\n            <thead>\n              <tr>\n                <th>ID</th>\n                <th>Usuario</th>\n                <th>Email</th>\n                <th>Rol</th>\n                <th>Registro</th>\n                <th>Publicaciones</th>\n              </tr>\n            </thead>\n            <tbody id=\"usersTableBody\">\n              <tr><td colspan=\"6\" class=\"table-loading\">Cargando...</td></tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- Edit Post Modal -->\n  <div class=\"modal\" id=\"editPostModal\" style=\"display:none\">\n    <div class=\"modal-backdrop\"></div>\n    <div class=\"modal-content\">\n      <div class=\"modal-header\">\n        <h3>Editar Publicacion</h3>\n        <button class=\"modal-close\" id=\"closeEditPostModal\">&times;</button>\n      </div>\n      <form id=\"editPostForm\">\n        <input type=\"hidden\" id=\"editPostId\">\n        <div class=\"form-group\">\n          <label for=\"editTitle\">Titulo</label>\n          <input type=\"text\" id=\"editTitle\" required>\n        </div>\n        <div class=\"form-group\">\n          <label for=\"editContent\">Contenido</label>\n          <textarea id=\"editContent\" rows=\"6\" required></textarea>\n        </div>\n        <button type=\"submit\" class=\"btn btn-primary btn-full\">Guardar cambios</button>\n      </form>\n    </div>\n  </div>\n\n  <!-- Danger Modal -->\n  <div class=\"modal\" id=\"dangerModal\" style=\"display:none\">\n    <div class=\"modal-backdrop\"></div>\n    <div class=\"modal-content modal-danger\">\n      <div class=\"modal-header\">\n        <h3>&#9888; Confirmar</h3>\n        <button class=\"modal-close\" id=\"closeDangerModal\">&times;</button>\n      </div>\n      <p id=\"dangerText\">Esta accion es irreversible. Deseas continuar?</p>\n      <div class=\"modal-actions\">\n        <button class=\"btn btn-outline\" id=\"cancelDanger\">Cancelar</button>\n        <button class=\"btn btn-danger\" id=\"confirmDanger\">Confirmar</button>\n      </div>\n    </div>\n  </div>\n\n  <script src=\"../js/api.js\"></script>\n  <script src=\"../js/auth.js\"></script>\n  <script src=\"../js/admin.js\"></script>\n</body>\n</html>\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/public/redsocial/pages/create-post.html",
          "name": "create-post.html",
          "content": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Nueva Publicacion - Comparti San Juan</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Open+Sans:wght@300;400;600&display=swap\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"../css/style.css\">\n  <link rel=\"stylesheet\" href=\"../css/create-post.css\">\n</head>\n<body>\n\n  <!-- Header unificado -->\n  <section class=\"hero\" id=\"createHero\" data-line-effect=\"createHero\" style=\"min-height:64px;padding:0\">\n    <div class=\"header-inner\" style=\"position:relative;z-index:2;height:64px;padding:0 var(--space-lg);min-height:64px\">\n      <a href=\"..\" class=\"logo\">\n        <img src=\"../imgs/logos/origensanjuan.png\" alt=\"Comparti San Juan\" class=\"logo-img\">\n        <span class=\"logo-text\">COMPARTI<span class=\"logo-highlight\"> SAN JUAN</span></span>\n      </a>\n      <div class=\"header-actions-group\" style=\"display:flex;align-items:center;gap:var(--space-xl);padding-left:var(--space-3xl)\">\n        <nav class=\"nav\" style=\"display:flex;gap:var(--space-xl)\">\n          <a href=\"..\" class=\"nav-link\">Inicio</a>\n          <a href=\"create-post.html\" class=\"nav-link active\">Publicar</a>\n          <a href=\"profile.html\" class=\"nav-link\">Mi Perfil</a>\n        </nav>\n        <div class=\"header-actions\">\n          <button class=\"btn btn-outline\" id=\"btnLogout\">Salir</button>\n          <button class=\"hamburger\" id=\"hamburgerBtn\">&#9776;</button>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"create-post-section\">\n    <div class=\"container\">\n      <div class=\"create-post-card\">\n        <div class=\"create-post-header\">\n          <div class=\"create-post-badge\">NUEVO</div>\n          <h1>Nueva Publicaci&oacute;n</h1>\n          <p>Comparti un lugar, evento o experiencia en San Juan</p>\n        </div>\n\n        <form id=\"createPostForm\" class=\"create-post-form\">\n          <div class=\"form-group\">\n            <label for=\"title\">Titulo</label>\n            <input type=\"text\" id=\"title\" name=\"title\" placeholder=\"Ej: Visita a la Bodega Graffigna\" required>\n          </div>\n\n          <div class=\"form-group\">\n            <label for=\"location\">Ubicacion (opcional)</label>\n            <input type=\"text\" id=\"location\" name=\"location\" placeholder=\"Ej: Valle Fertil, San Juan\">\n          </div>\n\n          <div class=\"form-group\">\n            <label for=\"content\">Contenido</label>\n            <textarea id=\"content\" name=\"content\" placeholder=\"Conta tu experiencia, describi el lugar, comparti datos utiles...\" rows=\"8\" required></textarea>\n          </div>\n\n          <!-- Hashtags -->\n          <div class=\"form-group\">\n            <label for=\"hashtagsInput\">Hashtags <span class=\"label-hint\">(elegi o escribi los tuyos)</span></label>\n            <div class=\"hashtag-composer\">\n              <div class=\"hashtag-field\" id=\"hashtagField\">\n                <input type=\"text\" id=\"hashtagsInput\" placeholder=\"Escribi un hashtag y presiona Enter o coma...\" autocomplete=\"off\">\n              </div>\n            </div>\n            <div class=\"hashtag-suggestions-label\">Recomendados:</div>\n            <div class=\"hashtag-suggestions\" id=\"hashtagSuggestions\">\n              <button type=\"button\" class=\"hashtag-suggestion\" data-tag=\"#Gastronomia\">#Gastronomia</button>\n              <button type=\"button\" class=\"hashtag-suggestion\" data-tag=\"#Entretenimiento\">#Entretenimiento</button>\n              <button type=\"button\" class=\"hashtag-suggestion\" data-tag=\"#Naturaleza\">#Naturaleza</button>\n              <button type=\"button\" class=\"hashtag-suggestion\" data-tag=\"#Alojamientos\">#Alojamientos</button>\n              <button type=\"button\" class=\"hashtag-suggestion\" data-tag=\"#Historia\">#Historia</button>\n            </div>\n            <input type=\"hidden\" id=\"hashtags\" name=\"hashtags\" value=\"\">\n          </div>\n\n          <div class=\"form-group\">\n            <label for=\"image\">Imagen (opcional)</label>\n            <div class=\"image-upload-area\" id=\"imageUploadArea\">\n              <input type=\"file\" id=\"image\" name=\"image\" accept=\"image/*\" style=\"display:none\">\n              <div class=\"upload-placeholder\" id=\"uploadPlaceholder\">\n                <span class=\"upload-icon\">&#128247;</span>\n                <p>Hace click para subir una imagen</p>\n                <span class=\"upload-hint\">JPG, PNG o WEBP - Max 5MB</span>\n              </div>\n              <div class=\"upload-preview\" id=\"uploadPreview\" style=\"display:none\">\n                <img id=\"previewImage\" src=\"\" alt=\"Preview\">\n                <button type=\"button\" class=\"upload-remove\" id=\"removeImage\">&times;</button>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"form-error\" id=\"postError\" style=\"display:none\"></div>\n\n          <div class=\"form-actions\">\n            <a href=\"..\" class=\"btn btn-outline\">Cancelar</a>\n            <button type=\"submit\" class=\"btn btn-primary btn-lg\" id=\"submitPostBtn\">\n              <span id=\"submitText\">Publicar</span>\n              <span id=\"submitSpinner\" class=\"spinner-sm\" style=\"display:none\"></span>\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  </section>\n\n  <footer class=\"footer\">\n    <div class=\"container\">\n      <div class=\"footer-bottom\">\n        <p>&copy; 2024 San Juan Social</p>\n        \n      </div>\n    </div>\n  </footer>\n\n  <script src=\"../js/api.js\"></script>\n  <script src=\"../js/auth.js\"></script>\n  <script src=\"../js/line-effect.js\"></script>\n  <script src=\"../js/create-post.js\"></script>\n</body>\n</html>\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/public/redsocial/pages/evento-galeria.html",
          "name": "evento-galeria.html",
          "content": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Galer&iacute;a de Evento - Comparti San Juan</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Open+Sans:wght@300;400;600&display=swap\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"../css/style.css\">\n  <style>\n    body {\n      background: var(--cream);\n      min-height: 100vh;\n    }\n\n    .page-header {\n      background: linear-gradient(135deg, var(--terracota), var(--orange-burnt));\n      color: var(--white);\n      padding: var(--space-lg) var(--space-md);\n      text-align: center;\n      box-shadow: var(--shadow-md);\n      position: sticky;\n      top: 0;\n      z-index: 100;\n    }\n\n    .page-header h1 {\n      font-family: var(--font-heading);\n      font-size: 1.6rem;\n      font-weight: 700;\n      margin-bottom: var(--space-sm);\n      letter-spacing: 0.02em;\n    }\n\n    .page-header .subtitle {\n      font-size: 0.9rem;\n      opacity: 0.85;\n      margin-bottom: var(--space-md);\n    }\n\n    .page-header .btn-upload {\n      display: inline-flex;\n      align-items: center;\n      gap: var(--space-sm);\n      background: var(--white);\n      color: var(--terracota);\n      font-family: var(--font-heading);\n      font-weight: 600;\n      font-size: 0.85rem;\n      text-transform: uppercase;\n      letter-spacing: 0.05em;\n      padding: 10px 28px;\n      border: none;\n      border-radius: var(--radius-md);\n      cursor: pointer;\n      transition: all var(--transition-base);\n      text-decoration: none;\n    }\n\n    .page-header .btn-upload:hover {\n      background: var(--cream);\n      transform: translateY(-1px);\n      box-shadow: var(--shadow-md);\n    }\n\n    .gallery-container {\n      max-width: 1200px;\n      margin: 0 auto;\n      padding: var(--space-lg) var(--space-md);\n    }\n\n    .masonry-grid {\n      column-count: 1;\n      column-gap: var(--space-md);\n    }\n\n    @media (min-width: 576px) {\n      .masonry-grid { column-count: 2; }\n    }\n    @media (min-width: 768px) {\n      .masonry-grid { column-count: 3; }\n    }\n    @media (min-width: 1024px) {\n      .masonry-grid { column-count: 4; }\n    }\n\n    .masonry-item {\n      break-inside: avoid;\n      margin-bottom: var(--space-md);\n      border-radius: var(--radius-lg);\n      overflow: hidden;\n      background: var(--white);\n      box-shadow: var(--shadow-sm);\n      transition: transform var(--transition-base), box-shadow var(--transition-base);\n    }\n\n    .masonry-item:hover {\n      transform: translateY(-2px);\n      box-shadow: var(--shadow-md);\n    }\n\n    .masonry-item img {\n      width: 100%;\n      display: block;\n      cursor: pointer;\n    }\n\n    .photo-info {\n      padding: var(--space-sm) var(--space-md) var(--space-md);\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n    }\n\n    .photo-timestamp {\n      font-size: 0.75rem;\n      color: var(--gray-medium);\n      font-family: var(--font-body);\n    }\n\n    .photo-delete-btn {\n      background: none;\n      border: none;\n      color: var(--error);\n      cursor: pointer;\n      font-size: 1.1rem;\n      padding: 4px;\n      border-radius: var(--radius-sm);\n      transition: all var(--transition-fast);\n      opacity: 0.5;\n    }\n\n    .photo-delete-btn:hover {\n      opacity: 1;\n      background: rgba(217, 78, 62, 0.1);\n    }\n\n    .empty-state {\n      text-align: center;\n      padding: var(--space-3xl) var(--space-md);\n      color: var(--gray-medium);\n    }\n\n    .empty-state .icon {\n      font-size: 4rem;\n      margin-bottom: var(--space-md);\n      opacity: 0.4;\n    }\n\n    .empty-state h2 {\n      font-family: var(--font-heading);\n      color: var(--terracota);\n      margin-bottom: var(--space-sm);\n    }\n\n    .loading {\n      text-align: center;\n      padding: var(--space-xl);\n      color: var(--gray-medium);\n    }\n\n    /* Lightbox overlay */\n    .lightbox {\n      display: none;\n      position: fixed;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 100%;\n      background: rgba(0, 0, 0, 0.9);\n      z-index: 1000;\n      justify-content: center;\n      align-items: center;\n      cursor: pointer;\n    }\n\n    .lightbox.show {\n      display: flex;\n    }\n\n    .lightbox img {\n      max-width: 90%;\n      max-height: 90%;\n      object-fit: contain;\n      border-radius: var(--radius-md);\n      box-shadow: var(--shadow-xl);\n    }\n\n    .lightbox-close {\n      position: absolute;\n      top: 20px;\n      right: 30px;\n      color: var(--white);\n      font-size: 2rem;\n      cursor: pointer;\n      background: none;\n      border: none;\n      opacity: 0.7;\n      transition: opacity var(--transition-fast);\n    }\n\n    .lightbox-close:hover {\n      opacity: 1;\n    }\n  </style>\n</head>\n<body>\n\n  <!-- Header unificado -->\n  <section class=\"hero\" id=\"eventoHero\" data-line-effect=\"eventoHero\" style=\"min-height:64px;padding:0\">\n    <div class=\"header-inner\" style=\"position:relative;z-index:2;height:64px;padding:0 var(--space-lg);min-height:64px\">\n      <a href=\"..\" class=\"logo\">\n        <img src=\"../imgs/logos/origensanjuan.png\" alt=\"Comparti San Juan\" class=\"logo-img\">\n        <span class=\"logo-text\">COMPARTI<span class=\"logo-highlight\"> SAN JUAN</span></span>\n      </a>\n      <div class=\"header-actions-group\" style=\"display:flex;align-items:center;gap:var(--space-xl);padding-left:var(--space-3xl)\">\n        <nav class=\"nav\" style=\"display:flex;gap:var(--space-xl)\">\n          <a href=\"..\" class=\"nav-link\">Inicio</a>\n          <a href=\"evento-galeria.html\" class=\"nav-link active\">En Vivo</a>\n          <a href=\"create-post.html\" class=\"nav-link\">Publicar</a>\n          <a href=\"profile.html\" class=\"nav-link\">Mi Perfil</a>\n        </nav>\n        <div class=\"header-actions\">\n          <button class=\"btn btn-outline\" id=\"btnLogout\">Salir</button>\n          <button class=\"hamburger\" id=\"hamburgerBtn\">&#9776;</button>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"gallery-container\">\n\n    <!-- Page Title -->\n    <div style=\"text-align:center;margin-bottom:var(--space-lg);padding-top:var(--space-lg)\">\n      <h1 style=\"font-family:var(--font-heading);font-size:1.8rem;font-weight:700;color:var(--white)\">&#9670; Galer&iacute;a del Evento</h1>\n      <p style=\"font-size:0.9rem;color:var(--cream);opacity:0.85\">Fotos compartidas por la comunidad</p>\n      <a href=\"evento-subir.html\" style=\"display:inline-flex;align-items:center;gap:var(--space-sm);margin-top:var(--space-md);background:var(--white);color:var(--terracota);font-family:var(--font-heading);font-weight:600;font-size:0.85rem;text-transform:uppercase;letter-spacing:0.05em;padding:10px 28px;border:none;border-radius:var(--radius-md);cursor:pointer;text-decoration:none;transition:all var(--transition-base)\">+ Subir foto</a>\n    </div>\n    <div id=\"loading\" class=\"loading\">Cargando fotos...</div>\n    <div id=\"emptyState\" class=\"empty-state\" style=\"display:none\">\n      <div class=\"icon\">&#128247;</div>\n      <h2>Todav&iacute;a no hay fotos</h2>\n      <p>S&eacute; el primero en compartir una foto del evento</p>\n    </div>\n    <div id=\"masonryGrid\" class=\"masonry-grid\" style=\"display:none\"></div>\n  </div>\n\n  <!-- Lightbox -->\n  <div id=\"lightbox\" class=\"lightbox\" onclick=\"closeLightbox()\">\n    <button class=\"lightbox-close\" onclick=\"closeLightbox()\">&times;</button>\n    <img id=\"lightboxImg\" src=\"\" alt=\"Foto ampliada\">\n  </div>\n\n  <script src=\"../js/line-effect.js\"></script>\n  <script>\n    // Detect API base: use VPS for cross-origin (fullscreencode), relative for same-server\n    const VPS_API = 'https://vps-4455523-x.dattaweb.com/redsocial/api/evento';\n    const pathname = window.location.pathname;\n    const hostname = window.location.hostname;\n    let API_BASE;\n    if (hostname === 'localhost' || hostname === '127.0.0.1' || hostname.includes('vps-')) {\n      API_BASE = '/redsocial/api/evento';\n    } else {\n      API_BASE = VPS_API;\n    }\n\n    // Helper: resolve image URL (VPS for cross-origin)\n    function imgEvUrl(path) {\n      if (!path) return '';\n      if (path.startsWith('http://') || path.startsWith('https://')) return path;\n      if (hostname !== 'localhost' && !hostname.includes('127.0.0.1') && !hostname.includes('vps-')) {\n        return 'https://vps-4455523-x.dattaweb.com' + path;\n      }\n      return path;\n    }\n\n    async function loadGallery() {\n      const loading = document.getElementById('loading');\n      const emptyState = document.getElementById('emptyState');\n      const grid = document.getElementById('masonryGrid');\n\n      try {\n        const res = await fetch(API_BASE + '/fotos');\n        const photos = await res.json();\n\n        loading.style.display = 'none';\n\n        if (!photos || photos.length === 0) {\n          emptyState.style.display = 'block';\n          return;\n        }\n\n        grid.style.display = 'block';\n        grid.innerHTML = '';\n\n        photos.forEach(photo => {\n          const item = document.createElement('div');\n          item.className = 'masonry-item';\n\n          const imgUrl = '/redsocial/uploads/evento/' + photo.filename;\n          const ts = new Date(photo.uploaded_at);\n          const formatted = ts.toLocaleDateString('es-AR', {\n            day: 'numeric',\n            month: 'short',\n            year: 'numeric',\n            hour: '2-digit',\n            minute: '2-digit'\n          });\n\n          item.innerHTML = `\n            <img src=\"${imgUrl}\" alt=\"${photo.originalName}\" loading=\"lazy\" onclick=\"openLightbox('${imgUrl}')\">\n            <div class=\"photo-info\">\n              <span class=\"photo-timestamp\">&#128197; ${formatted}</span>\n              <button class=\"photo-delete-btn\" onclick=\"deletePhoto('${photo.id}')\" title=\"Eliminar foto\">&times;</button>\n            </div>\n          `;\n\n          grid.appendChild(item);\n        });\n      } catch (err) {\n        loading.textContent = 'Error al cargar las fotos. Intenta de nuevo.';\n        console.error(err);\n      }\n    }\n\n    function openLightbox(src) {\n      document.getElementById('lightboxImg').src = src;\n      document.getElementById('lightbox').classList.add('show');\n    }\n\n    function closeLightbox() {\n      document.getElementById('lightbox').classList.remove('show');\n    }\n\n    document.addEventListener('keydown', (e) => {\n      if (e.key === 'Escape') closeLightbox();\n    });\n\n    async function deletePhoto(id) {\n      if (!confirm('¿Eliminar esta foto?')) return;\n\n      try {\n        const res = await fetch(API_BASE + '/fotos/' + id, { method: 'DELETE' });\n        const data = await res.json();\n        if (data.ok) {\n          loadGallery();\n        } else {\n          alert('Error al eliminar: ' + (data.error || 'desconocido'));\n        }\n      } catch (err) {\n        alert('Error al eliminar la foto');\n        console.error(err);\n      }\n    }\n\n    loadGallery();\n  </script>\n\n</body>\n</html>\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/public/redsocial/pages/profile.html",
          "name": "profile.html",
          "content": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Mi Perfil - Comparti San Juan</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Open+Sans:wght@300;400;600&display=swap\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"../css/style.css\">\n  <link rel=\"stylesheet\" href=\"../css/profile.css\">\n</head>\n<body>\n\n  <!-- Header unificado -->\n  <section class=\"hero\" id=\"profileHero\" data-line-effect=\"profileHero\" style=\"min-height:64px;padding:0\">\n    <div class=\"header-inner\" style=\"position:relative;z-index:2;height:64px;padding:0 var(--space-lg);min-height:64px\">\n      <a href=\"..\" class=\"logo\">\n        <img src=\"../imgs/logos/origensanjuan.png\" alt=\"Comparti San Juan\" class=\"logo-img\">\n        <span class=\"logo-text\">COMPARTI<span class=\"logo-highlight\"> SAN JUAN</span></span>\n      </a>\n      <div class=\"header-actions-group\" style=\"display:flex;align-items:center;gap:var(--space-xl);padding-left:var(--space-3xl)\">\n        <nav class=\"nav\" style=\"display:flex;gap:var(--space-xl)\">\n          <a href=\"..\" class=\"nav-link\">Inicio</a>\n          <a href=\"create-post.html\" class=\"nav-link\">Publicar</a>\n          <a href=\"profile.html\" class=\"nav-link active\">Mi Perfil</a>\n        </nav>\n        <div class=\"header-actions\">\n          <button class=\"btn btn-outline\" id=\"btnLogout\">Salir</button>\n          <button class=\"hamburger\" id=\"hamburgerBtn\">&#9776;</button>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"profile-section\">\n    <div class=\"container\">\n      <div class=\"profile-header\" style=\"margin-top:0;padding-top:var(--space-lg);flex-wrap:wrap\">\n        <div class=\"profile-avatar\" id=\"profileAvatar\">\n          <img id=\"profilePic\" src=\"\" alt=\"Foto de perfil\" style=\"display:none\">\n          <span class=\"profile-avatar-placeholder\" id=\"avatarPlaceholder\">U</span>\n        </div>\n        <div class=\"profile-info\">\n          <h1 id=\"profileUsername\" style=\"color:var(--gray-dark);text-shadow:none\">Usuario</h1>\n          <p class=\"profile-email\" id=\"profileEmail\" style=\"color:var(--gray-medium)\">email@ejemplo.com</p>\n          <p class=\"profile-bio\" id=\"profileBio\" style=\"color:var(--gray-medium)\">Sin biografia aun.</p>\n          <p class=\"profile-date\" id=\"profileDate\" style=\"color:var(--gray-light)\">Miembro desde: --</p>\n        </div>\n        <button class=\"btn btn-primary\" id=\"editProfileBtn\">Editar Perfil</button>\n      </div>\n\n      <!-- Edit Profile Modal -->\n      <div class=\"modal\" id=\"editModal\" style=\"display:none\">\n        <div class=\"modal-backdrop\"></div>\n        <div class=\"modal-content\">\n          <div class=\"modal-header\">\n            <h3>Editar Perfil</h3>\n            <button class=\"modal-close\" id=\"closeEditModal\">&times;</button>\n          </div>\n          <form id=\"editProfileForm\">\n            <div class=\"form-group\">\n              <label>Foto de perfil</label>\n              <input type=\"file\" id=\"profilePicInput\" accept=\"image/*\">\n            </div>\n            <div class=\"form-group\">\n              <label for=\"bio\">Biografia</label>\n              <textarea id=\"bio\" name=\"bio\" placeholder=\"Conta algo sobre vos...\" rows=\"4\"></textarea>\n            </div>\n            <button type=\"submit\" class=\"btn btn-primary btn-full\">Guardar cambios</button>\n          </form>\n        </div>\n      </div>\n\n      <!-- User Posts -->\n      <div class=\"profile-posts\">\n        <h2>Mis Publicaciones</h2>\n        <div class=\"feed-grid\" id=\"myPostsGrid\">\n          <div class=\"loading-spinner\">\n            <div class=\"spinner\"></div>\n          </div>\n        </div>\n        <div class=\"feed-empty\" id=\"noPosts\" style=\"display:none\">\n          <p>Aun no publicaste nada. <a href=\"create-post.html\">Crea tu primera publicacion</a></p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <footer class=\"footer\">\n    <div class=\"container\">\n      <div class=\"footer-bottom\">\n        <p>&copy; 2024 San Juan Social</p>\n        \n      </div>\n    </div>\n  </footer>\n\n  <script src=\"../js/api.js\"></script>\n  <script src=\"../js/auth.js\"></script>\n  <script src=\"../js/line-effect.js\"></script>\n  <script src=\"../js/profile.js\"></script>\n</body>\n</html>\n"
