Infusiones -->\r\n                <div class=\"gallery-item\" data-category=\"infusiones\">\r\n                    <img src=\"assets/productores/imagen15.png\" alt=\"Productor de Infusion 1\">\r\n                    <p><a href=\"https://ofertaexportable.sanjuan.gob.ar/detalle_empresa.php?empresa=50\" target=\"_blank\">Blendit ></a></p>\r\n                </div>\r\n\r\n                <!-- Destilados -->\r\n                <div class=\"gallery-item\" data-category=\"destilados\">\r\n                    <img src=\"assets/productores/imagen16.png\" alt=\"Productor de Destilado 1\">\r\n                    <p><a href=\"https://ofertaexportable.sanjuan.gob.ar/detalle_empresa.php?empresa=66\" target=\"_blank\">Leblín Cream ></a></p>\r\n                </div>\r\n                <div class=\"gallery-item\" data-category=\"destilados\">\r\n                    <img src=\"assets/productores/imagen26.png\" alt=\"Productor de Destilado 1\">\r\n                    <p><a href=\"#\">Destilería Sisterna</a></p>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </main>\r\n    \r\n    <!-- Cargar el header dinámico primero -->\r\n    <script src=\"js/header.js\"></script>\r\n    <script src=\"js/footer.js\"></script>\r\n    <script src=\"js/productores.js\"></script>\r\n    <script src=\"js/touch.js\"></script>\r\n</body>\r\n</html>"
