          "path": "D:/Programacion/caminosysabores/public/sabores.html",
          "name": "sabores.html",
          "content": "<!DOCTYPE html>\r\n<html lang=\"es\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>San Juan Invita - Sabores</title>\r\n    <link rel=\"stylesheet\" href=\"css/style.css\">\r\n    <link rel=\"stylesheet\" href=\"css/sabores.css\">\r\n</head>\r\n<body>\r\n    <!-- Contenido principal -->\r\n    <main>\r\n        <div class=\"hero-section\">\r\n            <img src=\"assets/sabores/fondo.png\" alt=\"Sabores de San Juan\" class=\"background-image\">\r\n            <div class=\"content-container\">\r\n                <h1 class=\"tagline\">Sabores <br>que cuentan <br> historias </h1>\r\n            </div>\r\n        </div>\r\n        \r\n        <!-- Sección de texto debajo de la imagen -->\r\n        <div class=\"text-section\">\r\n            <p>San Juan se cocina con memoria, con productos nobles y con el toque único de quienes transmiten recetas de generación en generación. Este recetario es una ventana a nuestra identidad gastronómica.</p>\r\n            <p>Encontrá platos típicos, secretos regionales y la pasión de nuestros cocineros en un espacio pensado para que puedas aprender, replicar y compartir los sabores de nuestra tierra.</p>\r\n        </div>\r\n\r\n        <div class=\"recetario-header\">\r\n            <h2 class=\"recetario-titulo\">Recetario</h2>\r\n        </div>\r\n\r\n        <!-- Sección de recetas -->\r\n        <div class=\"recetas-section\">\r\n            <div class=\"recetas-grid\">\r\n                <div class=\"receta-card\" data-recipe=\"recetahummus\" data-video=\"TWJJQF4EOlY\" data-mobile-video=\"_38Bp76qDwQ\">\r\n                    <div class=\"receta-imagen-container\">\r\n                        <img src=\"assets/sabores/hummus.png\" alt=\"Hummus\" class=\"receta-imagen\">\r\n                        <div class=\"receta-botones\">\r\n                            <button class=\"ver-video\"><img src=\"assets/sabores/video.png\" alt=\"Video\"> Ver video</button>\r\n                            <button class=\"ver-receta\"><img src=\"assets/sabores/ver.png\" alt=\"Ver\"> Ver receta</button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"receta-card\" data-recipe=\"recetatomatican\" data-video=\"Hy7joNR9gYQ\" data-mobile-video=\"sqNfzTzyUMg\">\r\n                    <div class=\"receta-imagen-container\">\r\n                        <img src=\"assets/sabores/tomatican.png\" alt=\"Tomatican\" class=\"receta-imagen\">\r\n                        <div class=\"receta-botones\">\r\n                            <button class=\"ver-video\"><img src=\"assets/sabores/video.png\" alt=\"Video\"> Ver video</button>\r\n                            <button class=\"ver-receta\"><img src=\"assets/sabores/ver.png\" alt=\"Ver\"> Ver receta</button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"receta-card\" data-recipe=\"recetachivito\" data-video=\"lQDDoqwfDlI\" data-mobile-video=\"rLPEC8egf-0\">\r\n                    <div class=\"receta-imagen-container\">\r\n                        <img src=\"assets/sabores/chivito.png\" alt=\"Chivito\" class=\"receta-imagen\">\r\n                        <div class=\"receta-botones\">\r\n                            <button class=\"ver-video\"><img src=\"assets/sabores/video.png\" alt=\"Video\"> Ver video</button>\r\n                            <button class=\"ver-receta\"><img src=\"assets/sabores/ver.png\" alt=\"Ver\"> Ver receta</button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"receta-card\" data-recipe=\"recetacroquetas\" data-video=\"2f-b7CG2pXE\" data-mobile-video=\"B_oa0GB3oUU\">\r\n                    <div class=\"receta-imagen-container\">\r\n                        <img src=\"assets/sabores/croquetas.png\" alt=\"Croquetas\" class=\"receta-imagen\">\r\n                        <div class=\"receta-botones\">\r\n                            <button class=\"ver-video\"><img src=\"assets/sabores/video.png\" alt=\"Video\"> Ver video</button>\r\n                            <button class=\"ver-receta\"><img src=\"assets/sabores/ver.png\" alt=\"Ver\"> Ver receta</button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"receta-card\" data-recipe=\"recetalomo\" data-video=\"TWJJQF4EOlY\" data-mobile-video=\"ycU58s2t2vA\">\r\n                    <div class=\"receta-imagen-container\">\r\n                        <img src=\"assets/sabores/lomo.png\" alt=\"Lomo\" class=\"receta-imagen\">\r\n                        <div class=\"receta-botones\">\r\n                            <button class=\"ver-video\"><img src=\"assets/sabores/video.png\" alt=\"Video\"> Ver video</button>\r\n                            <button class=\"ver-receta\"><img src=\"assets/sabores/ver.png\" alt=\"Ver\"> Ver receta</button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"receta-card\" data-recipe=\"recetamembrillos\" data-video=\"vYEvWtfwOB0\" data-mobile-video=\"_9rA-9l6YDM\">\r\n                    <div class=\"receta-imagen-container\">\r\n                        <img src=\"assets/sabores/membrillos.png\" alt=\"Membrillos\" class=\"receta-imagen\">\r\n                        <div class=\"receta-botones\">\r\n                            <button class=\"ver-video\"><img src=\"assets/sabores/video.png\" alt=\"Video\"> Ver video</button>\r\n                            <button class=\"ver-receta\"><img src=\"assets/sabores/ver.png\" alt=\"Ver\"> Ver receta</button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"receta-card\" data-recipe=\"recetasable\" data-video=\"v8yZemCRgSI\" data-mobile-video=\"0zndwh8DKW4\">\r\n                    <div class=\"receta-imagen-container\">\r\n                        <img src=\"assets/sabores/sable.png\" alt=\"Sable\" class=\"receta-imagen\">\r\n                        <div class=\"receta-botones\">\r\n                            <button class=\"ver-video\"><img src=\"assets/sabores/video.png\" alt=\"Video\"> Ver video</button>\r\n                            <button class=\"ver-receta\"><img src=\"assets/sabores/ver.png\" alt=\"Ver\"> Ver receta</button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Sección del video del tomatican -->\r\n        <!-- Sección del video del chef -->\r\n        <div class=\"recetario-header\">\r\n            <h2 class=\"recetario-titulo\">Video | Chef en acción</h2>\r\n        </div>\r\n        <div class=\"video-tomatican-section\">\r\n            <div class=\"video-tomatican-container\">\r\n                <div class=\"video-preview\" data-video=\"bL4KknDowzc\">\r\n                    <img src=\"assets/home/fuego.png\" alt=\"Video San Juan\" class=\"video-thumbnail\">\r\n                    <button class=\"play-button\">\r\n                        <img src=\"assets/sabores/play.png\" alt=\"Play\">\r\n                    </button>\r\n                </div>\r\n                <iframe id=\"tomatican-player\" \r\n                    style=\"display: none\"\r\n                    frameborder=\"0\" \r\n                    allowfullscreen \r\n                    allow=\"accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\"\r\n                    data-video=\"bL4KknDowzc\">\r\n                </iframe>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Overlays para recetas y videos -->\r\n        <div id=\"receta-overlay\" class=\"overlay\">\r\n            <div class=\"overlay-content\">\r\n                <button class=\"close-button\">\r\n                    <span class=\"close-icon\">×</span>\r\n                </button>\r\n                <img id=\"receta-imagen\" alt=\"Receta\">\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Botón de cierre para escritorio -->\r\n        <button class=\"close-overlay\" id=\"close-overlay\">\r\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                <path d=\"M15 5L5 15M5 5L15 15\" stroke=\"black\" stroke-width=\"2\" stroke-linecap=\"round\"/>\r\n            </svg>\r\n        </button>\r\n\r\n        <!-- Overlay para videos -->\r\n        <div id=\"video-overlay\" class=\"overlay\">\r\n            <div class=\"overlay-content video-content\">\r\n                <button class=\"close-button\">\r\n                    <span class=\"close-icon\">×</span>\r\n                </button>\r\n                <div class=\"video-container\">\r\n                    <iframe id=\"youtube-player\" \r\n                            frameborder=\"0\" \r\n                            allowfullscreen \r\n                            allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\"\r\n                            referrerpolicy=\"strict-origin-when-cross-origin\"\r\n                            ></iframe>\r\n                    \r\n                    <!-- Fallback cuando el iframe no funciona -->\r\n                    <div id=\"video-fallback\" class=\"video-fallback\" style=\"display: none;\">\r\n                        <div class=\"fallback-content\">\r\n                            <div class=\"fallback-icon\">📺</div>\r\n                            <h3>Video no disponible para reproducir aquí</h3>\r\n                            <p>Este video tiene restricciones de reproducción. Puedes verlo directamente en YouTube.</p>\r\n                            <button id=\"open-youtube\" class=\"youtube-button\">\r\n                                <img src=\"data:image/svg+xml;base64,\" alt=\"YouTube\">\r\n                                Ver en YouTube\r\n                            </button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </main>\r\n    \r\n    <!-- Cargar el header dinámico primero -->\r\n    <script src=\"js/header.js\"></script>\r\n    <script src=\"js/footer.js\"></script>\r\n    <script src=\"js/sabores.js\"></script>\r\n</body>\r\n</html>\r\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/public/recorrido.html",
          "name": "recorrido.html",
          "content": "<!DOCTYPE html>\r\n<html lang=\"es\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>San Juan Invita - Home</title>\r\n    <link rel=\"stylesheet\" href=\"css/style.css\">\r\n    <link rel=\"stylesheet\" href=\"css/recorrido.css\">\r\n\r\n</head>\r\n<body data-back-fallback=\"home.html\">\r\n    <!-- Contenido principal -->\r\n    <main>\r\n        <div class=\"hero-section\">\r\n            <img src=\"assets/recorrido/recorrido.png\" alt=\"Recorrido de sabores\" class=\"background-image\">\r\n            <div class=\"content-container\">\r\n                <h1 class=\"tagline\">Recorrido <br> Cata de <br> Vinos y <br> Sabores <br> de San Juan</h1>\r\n            </div>\r\n        </div>\r\n        \r\n        <!-- Sección de texto debajo de la imagen -->\r\n        <div class=\"text-section\">\r\n            <p>Un recorrido de sabores guiado por los protagonistas de San Juan que combina tradición, identidad y el sabor auténtico del terroir sanjuanino.</p>\r\n            <p>Sumate a una experiencia sensorial donde cada paso te acerca a la esencia de San Juan. Un guía especializado te llevará a recorrer el stand de la provincia para conocer de primera mano a nuestros productores, sus historias y el alma de sus productos.</p>\r\n            <p>Durante el camino vas a descubrir vinos con identidad, aceites con carácter y sabores que nacen de la tierra sanjuanina. Cada parada es una oportunidad para degustar, conversar y conectar con quienes dan vida a nuestra gastronomía.</p>\r\n        </div>\r\n\r\n        <div class=\"schedule-section\">\r\n            <h2>Horarios de jueves a domingo</h2>\r\n            <div class=\"date-boxes-container\">\r\n                <div class=\"date-box\">\r\n                    <p class=\"day-number\">15hs</p>\r\n                </div>\r\n                <div class=\"date-box\">\r\n                    <p class=\"day-number\">18hs</p>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"participants-section\">\r\n            <h2>Bodegas participantes</h2>\r\n            <div class=\"logos-container\">\r\n                <img src=\"assets/recorrido/logos1.png\" alt=\"Logos de Bodegas participantes\">\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"participants-section\">\r\n            <h2>Productores participantes</h2>\r\n            <div class=\"logos-container\">\r\n                <img src=\"assets/recorrido/logos2.png\" alt=\"Logos de Productores participantes\">\r\n            </div>\r\n        </div>\r\n    </main>\r\n    \r\n    <!-- Cargar el header dinámico primero -->\r\n    <script src=\"js/header.js\"></script>\r\n    <script src=\"js/footer.js\"></script>\r\n    <script src=\"js/touch.js\"></script>\r\n</body>\r\n</html>\r\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/public/sorteo.html",
          "name": "sorteo.html",
          "content": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>San Juan Invita - Sorteo</title>\n    <link rel=\"stylesheet\" href=\"css/style.css\">\n    <link rel=\"stylesheet\" href=\"css/sorteo.css\">\n</head>\n<body data-back-fallback=\"home.html\">\n    <!-- Contenido principal -->\n    <main>\n        <div class=\"sorteo-container\">\n            <div class=\"sorteo-header\">\n                <span class=\"produccion-etiqueta\">PRODUCCIONES</span>\n                <h1>Llevate un pedacito <br>de San Juan <span class=\"highlight\">con vos</span></h1>\n                \n                <div class=\"sorteo-description\">\n                    <p><strong>Sorteos y beneficios</strong></p>\n                    <p>Completá el formulario para participar</p>\n                </div>\n                \n                <p class=\"sorteo-footer-text\">Te gustaría conocer más de San Juan, descubrir todo lo que la provincia tiene para ofrecerte. Dejanos tus datos y participá por importantes premios.</p>\n                <img src=\"assets/sorteo/sorteo.png\" alt=\"Sorteo de Kits\" class=\"sorteo-image\">\n               \n            </div>\n            \n            <div class=\"form-container\">\n                <h2>Sorteos y beneficios</h2>\n                <p>Completá el formulario para participar</p>\n                \n                <form id=\"sorteo-form\" onsubmit=\"return enviarFormulario(event)\">\n                    <div class=\"form-row\">\n                        <div class=\"form-group half\">\n                            <input type=\"text\" id=\"nombre\" name=\"nombre\" placeholder=\"Nombre\">\n                        </div>\n                        <div class=\"form-group half\">\n                            <input type=\"text\" id=\"apellido\" name=\"apellido\" placeholder=\"Apellido\">\n                        </div>\n                    </div>\n                    <div class=\"form-group\">\n                        <input type=\"email\" id=\"email\" name=\"email\" placeholder=\"Correo electrónico\">\n                    </div>\n                    <div class=\"form-group\">\n                        <input type=\"tel\" id=\"telefono\" name=\"telefono\" placeholder=\"Teléfono\">\n                    </div>\n                    <div class=\"form-group\">\n                        <input type=\"number\" id=\"edad\" name=\"edad\" placeholder=\"Edad\">\n                    </div>\n                    <div class=\"form-group\">\n                        <input type=\"text\" id=\"localidad\" name=\"localidad\" placeholder=\"Localidad/Provincia\">\n                    </div>\n                    \n                    <div class=\"experience-section\">\n                        <p>¿Qué experiencia te gustó más del stand?</p>\n                        <div class=\"experience-options\">\n                            <div class=\"experience-option\">\n                                <input type=\"checkbox\" id=\"showcooking\" name=\"experiencia\" value=\"Showcooking\">\n                                <label for=\"showcooking\">Showcooking</label>\n                            </div>\n                            <div class=\"experience-option\">\n                                <input type=\"checkbox\" id=\"taller\" name=\"experiencia\" value=\"Taller de Cultivo\">\n                                <label for=\"taller\">Taller de Cultivo</label>\n                            </div>\n                            <div class=\"experience-option\">\n                                <input type=\"checkbox\" id=\"cata\" name=\"experiencia\" value=\"Cata de Productos\">\n                                <label for=\"cata\">Cata de Productos</label>\n                            </div>\n                            <div class=\"experience-option\">\n                                <input type=\"checkbox\" id=\"recetario\" name=\"experiencia\" value=\"Recetario\">\n                                <label for=\"recetario\">Recetario</label>\n                            </div>\n                            <div class=\"experience-option\">\n                                <input type=\"checkbox\" id=\"turismo\" name=\"experiencia\" value=\"Turismo\">\n                                <label for=\"turismo\">Turismo</label>\n                            </div>\n                            <div class=\"experience-option\">\n                                <input type=\"checkbox\" id=\"otra\" name=\"experiencia\" value=\"Otra\">\n                                <label for=\"otra\">Otra</label>\n                            </div>\n                        </div>\n                    </div>\n                    \n                    <div class=\"submit-container\">\n                        <button type=\"submit\" class=\"submit-button\">\n                            <img src=\"assets/sorteo/enviar.png\" alt=\"Quiero participar\">\n                        </button>\n                        <p id=\"confirmation-message\" style=\"display: none; color: #4CAF50; font-weight: bold; margin-top: 15px; text-align: center;\">¡Ya estás participando!</p>\n                    </div>\n                </form>\n            </div>\n        </div>\n    </main>\n    \n    <!-- Cargar el header dinámico primero -->\n    <script src=\"js/header.js\"></script>\n    <script src=\"js/footer.js\"></script>\n    \n    <!-- Firebase SDK -->\n    <script src=\"https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js\"></script>\n    <script src=\"https://www.gstatic.com/firebasejs/9.22.0/firebase-firestore-compat.js\"></script>\n    \n    <!-- Configuración de Firebase -->\n    <script src=\"js/firebase-config.js\"></script>\n    \n    <!-- Script para el formulario de sorteo -->\n    <script src=\"js/sorteo.js\"></script>\n    <script src=\"js/touch.js\"></script>\n\n    <!-- Popup de confirmación -->\n    <div id=\"popup-overlay\" class=\"popup-overlay\">\n        <div id=\"popup-content\" class=\"popup-content\">\n            <img src=\"assets/sorteo/popup.png\" alt=\"¡Gracias por participar!\" class=\"popup-image\">\n        </div>\n    </div>\n</body>\n</html>"
        },
        {
          "path": "D:/Programacion/caminosysabores/public/turismo-detalle.html",
          "name": "turismo-detalle.html",
          "content": "<!DOCTYPE html>\r\n<html lang=\"es\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>San Juan a la mesa - Turismo</title>\r\n    <link rel=\"stylesheet\" href=\"css/style.css\">\r\n    <link rel=\"stylesheet\" href=\"css/turismo-detalle.css\">\r\n</head>\r\n<body data-back-fallback=\"turismo.html\">\r\n    <main>\r\n        <section class=\"hero-section tourism-detail-hero\">\r\n            <img src=\"assets/turismo/fondo.png\" alt=\"Turismo San Juan\" class=\"background-image\">\r\n            <div class=\"content-container tourism-detail-content\">\r\n                <h1 class=\"tagline\">Turismo<br>San Juan</h1>\r\n            </div>\r\n        </section>\r\n\r\n        <section class=\"text-section tourism-detail-copy\" id=\"tourism-detail-copy\"></section>\r\n\r\n        <section class=\"tourism-destination-section\">\r\n            <h2 class=\"tourism-destination-title\" id=\"tourism-destination-title\"></h2>\r\n            <div class=\"carousel-container tourism-carousel-container\">\r\n                <div class=\"carousel tourism-carousel\" id=\"tourism-carousel\" aria-label=\"Galería de imágenes de turismo\"></div>\r\n            </div>\r\n        </section>\r\n    </main>\r\n\r\n    <script src=\"js/header.js\"></script>\r\n    <script src=\"js/footer.js\"></script>\r\n    <script src=\"js/touch.js\"></script>\r\n    <script src=\"js/turismo.js\"></script>\r\n    <script src=\"js/turismo-detalle.js\"></script>\r\n</body>\r\n</html>\r\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/public/index.html",
          "name": "index.html",
          "content": "<!DOCTYPE html>\r\n<html lang=\"es\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Expo Rural San Juan</title>\r\n    <link rel=\"stylesheet\" href=\"css/style.css\">\r\n   \r\n</head>\r\n<body class=\"landing\">\r\n    <div class=\"background-pattern\"></div>\r\n    \r\n    <div class=\"container landing-page-container\">\r\n        <div class=\"logo-superior-container\">\r\n            <img src=\"assets/landing/logosuperior.svg\" alt=\"Logo San Juan\" class=\"logo-superior\">\r\n        </div>\r\n        \r\n        <div class=\"logo-central-container\">\r\n            <img src=\"assets/landing/logocentral.svg\" alt=\"Origen San Juan Argentina\" class=\"logo-central\">\r\n        </div>\r\n        \r\n        <div class=\"landing-subtitle\">\r\n            Transformar es nuestra naturaleza\r\n        </div>\r\n        \r\n        <div class=\"button-container\">\r\n            <a href=\"home.html\" class=\"btn-ingresar\">Ingresar</a>\r\n        </div>\r\n    </div>\r\n    \r\n    <script src=\"js/footer.js\"></script>\r\n    <script src=\"js/touch.js\"></script>\r\n</body>\r\n</html>"
        },
        {
          "path": "D:/Programacion/caminosysabores/public/js/footer.js",
          "name": "footer.js",
          "content": "document.addEventListener(\"DOMContentLoaded\", () => {\r\n    function splitLandingSubtitle() {\r\n        const subtitle = document.querySelector(\".landing-subtitle\");\r\n        if (!subtitle || subtitle.dataset.animated === \"true\") {\r\n            return;\r\n        }\r\n\r\n        const words = subtitle.textContent.trim().split(/\\s+/);\r\n        subtitle.innerHTML = words\r\n            .map((word, index) => `<span class=\"word\" style=\"animation-delay:${0.72 + index * 0.16}s\">${word}</span>`)\r\n            .join(\"\");\r\n        subtitle.dataset.animated = \"true\";\r\n    }\r\n\r\n    // Crear estilos para el footer\r\n    const footerStyles = document.createElement(\"style\");\r\n    footerStyles.textContent = `\r\n        .footer {\r\n            background-color: white;\r\n            padding: 15px 0;\r\n            text-align: center;\r\n            display: flex;\r\n            justify-content: center;\r\n            align-items: center;\r\n            gap: 20px;\r\n            margin-top: auto;\r\n            position: relative; \r\n            z-index: 10;\r\n            box-shadow: 0 -6px 10px 0 rgba(0, 0, 0, .25);\r\n        }\r\n        \r\n        .footer img {\r\n            height: 40px;\r\n            width: auto;\r\n        }\r\n\r\n        .footer a:first-child img {\r\n            height: 60px;\r\n        }\r\n        \r\n        /* Responsive adjustments */\r\n        @media (max-width: 768px) {\r\n            .footer img {\r\n                height: 30px;\r\n            }\r\n\r\n            .footer a:first-child img {\r\n                height: 45px;\r\n            }\r\n        }\r\n        \r\n        /* Estilos para asegurar que el footer esté en la parte inferior */\r\n        body {\r\n            min-height: 100vh;\r\n            display: flex;\r\n            flex-direction: column;\r\n        }\r\n        \r\n        main {\r\n            flex: 1;\r\n            padding-bottom: 24px;\r\n        }\r\n        \r\n        /* Si no hay un elemento main, creamos un espaciador */\r\n        .footer-spacer {\r\n            flex: 1;\r\n        }\r\n    `;\r\n    document.head.appendChild(footerStyles);\r\n\r\n    // Verificar si existe un elemento main, si no, crear un espaciador\r\n    if (!document.querySelector('main')) {\r\n        const spacer = document.createElement(\"div\");\r\n        spacer.className = \"footer-spacer\";\r\n        document.body.appendChild(spacer);\r\n    }\r\n\r\n    // Create footer element\r\n    const footer = document.createElement(\"footer\");\r\n    footer.className = \"footer\";\r\n    \r\n    // Create and append the three logo images with links\r\n    const linksData = [\r\n        { href: \"https://sj.sanjuan.gob.ar\", src: \"assets/landing/logofoot2.svg\", alt: \"Logo San Juan Gobierno\" }\r\n    ];\r\n\r\n    linksData.forEach(data => {\r\n        const link = document.createElement(\"a\");\r\n        link.href = data.href;\r\n        link.target = \"_blank\"; // Open in a new tab\r\n\r\n        const logo = document.createElement(\"img\");\r\n        logo.src = data.src;\r\n        logo.alt = data.alt;\r\n\r\n        link.appendChild(logo);\r\n        footer.appendChild(link);\r\n    });\r\n  \r\n    // Append the footer to the body\r\n    document.body.appendChild(footer);\r\n\r\n    splitLandingSubtitle();\r\n})\r\n"
        },
