          "content": "/* Estilos para la sección de recetas */\r\n.recetas-section {\r\n  padding: 0 30px;\r\n}\r\n\r\n/* Header de recetario - Figma 2026 */\r\n.recetario-header {\r\n  padding: 20px 30px;\r\n}\r\n\r\n.recetario-titulo {\r\n  font-family: 'Ubuntu', sans-serif;\r\n  font-size: 28px;\r\n  font-weight: bold;\r\n  color: #E6643C;\r\n}\r\n\r\n.recetas-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, 1fr);\r\n  gap: 2rem;\r\n  max-width: 1200px;\r\n  margin: 0 auto;\r\n}\r\n\r\n.receta-card {\r\n  border-radius: 10px;\r\n  overflow: hidden;\r\n  transition: transform 0.3s ease;\r\n}\r\n\r\n.receta-imagen-container {\r\n  position: relative;\r\n  width: 100%;\r\n  border-radius: 10px;\r\n  overflow: hidden;\r\n}\r\n\r\n.receta-imagen {\r\n  width: 100%;\r\n  height: auto;\r\n  display: block;\r\n  border-radius: 10px;\r\n}\r\n\r\n.receta-botones {\r\n  position: absolute;\r\n  bottom: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  display: flex;\r\n}\r\n\r\n.receta-botones button {\r\n  flex: 1;\r\n  padding: 1.2rem;\r\n  border: none;\r\n  background-color: transparent;\r\n  color: white;\r\n  padding-bottom: 30px;\r\n  cursor: pointer;\r\n  font-size: 1.5rem;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  transition: background-color 0.3s ease;\r\n  -webkit-tap-highlight-color: rgba(255, 255, 255, 0.2);\r\n  touch-action: manipulation;\r\n}\r\n\r\n.receta-botones button:hover,\r\n.receta-botones button:active {\r\n  background-color: rgba(255, 255, 255, 0.2);\r\n}\r\n\r\n.receta-botones img {\r\n  width: 55px;\r\n  height: 40px;\r\n  margin-right: 0.7rem;\r\n}\r\n\r\n/* Estilos base para overlays */\r\n.overlay {\r\n  display: none;\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100vw;\r\n  height: 100%;\r\n  background-color: rgba(0, 0, 0, 0.8);\r\n  z-index: 1000;\r\n}\r\n\r\n/* Botón de cierre para escritorio - CORREGIDO */\r\n.close-overlay {\r\n  position: fixed;\r\n  top: 20px;\r\n  right: 20px;\r\n  width: 40px;\r\n  height: 40px;\r\n  background: rgba(255, 255, 255, 0.9);\r\n  border-radius: 50%;\r\n  display: none; /* Siempre oculto por defecto */\r\n  justify-content: center;\r\n  align-items: center;\r\n  cursor: pointer;\r\n  z-index: 1001;\r\n  border: none;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);\r\n  transition: transform 0.2s ease, background-color 0.2s ease;\r\n  opacity: 0;\r\n  visibility: hidden;\r\n  transition: opacity 0.3s ease, visibility 0.3s ease, transform 0.2s ease;\r\n}\r\n\r\n/* Mostrar el botón solo cuando hay un overlay activo */\r\n.close-overlay.show {\r\n  display: flex;\r\n  opacity: 1;\r\n  visibility: visible;\r\n}\r\n\r\n.close-overlay:hover {\r\n  transform: scale(1.1);\r\n  background: #ffffff;\r\n}\r\n\r\n.close-overlay svg {\r\n  width: 20px;\r\n  height: 20px;\r\n}\r\n\r\n.close-overlay path {\r\n  transition: stroke 0.2s ease;\r\n}\r\n\r\n.close-overlay:hover path {\r\n  stroke: #000;\r\n}\r\n\r\n/* Estilos específicos para el overlay de recetas */\r\n#receta-overlay.active {\r\n  display: block;\r\n  overflow-y: auto;\r\n}\r\n\r\n#receta-overlay .overlay-content {\r\n  width: 100%;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n\r\n#receta-imagen {\r\n  width: 100vw;\r\n  height: auto;\r\n  display: block;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n\r\n/* Estilos específicos para el overlay de video */\r\n#video-overlay.active {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  overflow: hidden;\r\n}\r\n\r\n#video-overlay .overlay-content {\r\n  width: min(90vh, 600px);\r\n  aspect-ratio: 1 / 1;\r\n  position: relative;\r\n}\r\n\r\n#video-overlay .close-button {\r\n  display: none;\r\n}\r\n\r\n#video-overlay .video-content {\r\n  width: 100%;\r\n  aspect-ratio: 1 / 1;\r\n  position: relative;\r\n}\r\n\r\n#video-overlay .close-icon {\r\n  font-size: 24px;\r\n  line-height: 1;\r\n  color: #000;\r\n}\r\n\r\n#video-overlay .video-container {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n\r\n#video-overlay .video-container iframe {\r\n  width: 100%;\r\n  height: 100%;\r\n  border: none;\r\n}\r\n\r\n/* Estilos para el fallback de video */\r\n.video-fallback {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  color: white;\r\n  text-align: center;\r\n}\r\n\r\n.fallback-content {\r\n  padding: 2rem;\r\n  max-width: 500px;\r\n  width: 100%;\r\n}\r\n\r\n/* Estilos para preview de Shorts */\r\n.short-preview {\r\n  margin-bottom: 2rem;\r\n}\r\n\r\n.thumbnail-container {\r\n  position: relative;\r\n  width: 100%;\r\n  max-width: 320px;\r\n  margin: 0 auto 1rem;\r\n  border-radius: 12px;\r\n  overflow: hidden;\r\n  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);\r\n}\r\n\r\n.video-thumbnail {\r\n  width: 100%;\r\n  height: auto;\r\n  display: block;\r\n  aspect-ratio: 16 / 9;\r\n  object-fit: cover;\r\n  background: #333;\r\n}\r\n\r\n.play-overlay {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  background: rgba(0, 0, 0, 0.3);\r\n  transition: background 0.3s ease;\r\n}\r\n\r\n.play-overlay:hover {\r\n  background: rgba(0, 0, 0, 0.5);\r\n}\r\n\r\n.play-button {\r\n  transform: scale(0.8);\r\n  transition: transform 0.3s ease;\r\n  filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.3));\r\n}\r\n\r\n.play-overlay:hover .play-button {\r\n  transform: scale(0.9);\r\n}\r\n\r\n.shorts-badge {\r\n  position: absolute;\r\n  bottom: 12px;\r\n  left: 12px;\r\n  background: rgba(0, 0, 0, 0.8);\r\n  color: white;\r\n  padding: 4px 8px;\r\n  border-radius: 4px;\r\n  font-size: 0.75rem;\r\n  font-weight: bold;\r\n}\r\n\r\n.ios-badge {\r\n  position: absolute;\r\n  bottom: 12px;\r\n  left: 12px;\r\n  background: rgba(0, 122, 255, 0.9);\r\n  color: white;\r\n  padding: 4px 8px;\r\n  border-radius: 4px;\r\n  font-size: 0.75rem;\r\n  font-weight: bold;\r\n}\r\n\r\n.preview-info h3 {\r\n  font-size: 1.3rem;\r\n  margin-bottom: 0.5rem;\r\n  color: #fff;\r\n}\r\n\r\n.preview-info p {\r\n  font-size: 0.9rem;\r\n  color: #ccc;\r\n  line-height: 1.4;\r\n  margin-bottom: 1.5rem;\r\n}\r\n\r\n.youtube-button {\r\n  background: #ff0000;\r\n  color: white;\r\n  border: none;\r\n  padding: 12px 24px;\r\n  border-radius: 25px;\r\n  font-size: 1rem;\r\n  font-weight: bold;\r\n  cursor: pointer;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 8px;\r\n  transition: all 0.3s ease;\r\n  margin: 0 auto;\r\n  min-width: 200px;\r\n  -webkit-tap-highlight-color: rgba(255, 0, 0, 0.3);\r\n  touch-action: manipulation;\r\n}\r\n\r\n.youtube-button:hover,\r\n.youtube-button:active {\r\n  background: #cc0000;\r\n  transform: translateY(-2px);\r\n  box-shadow: 0 4px 12px rgba(255, 0, 0, 0.3);\r\n}\r\n\r\n.youtube-button svg {\r\n  width: 20px;\r\n  height: 20px;\r\n}\r\n\r\n.close-button {\r\n  position: fixed;\r\n  top: 20px;\r\n  right: 20px;\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 50%;\r\n  background-color: white;\r\n  border: none;\r\n  cursor: pointer;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  z-index: 1001;\r\n  padding: 0;\r\n}\r\n\r\n.close-icon {\r\n  font-size: 24px;\r\n  line-height: 1;\r\n  color: #000;\r\n}\r\n\r\n/* Estilos para la sección del video del tomaticán */\r\n.video-tomatican-section {\r\n  padding: 0 30px;\r\n  margin: 30px 0;\r\n}\r\n\r\n.video-tomatican-container {\r\n  position: relative;\r\n  width: 100%;\r\n  max-width: 1000px;\r\n  margin: 0 auto;\r\n  aspect-ratio: 16 / 9;\r\n  background: black;\r\n}\r\n\r\n.video-preview {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  aspect-ratio: 16 / 9;\r\n}\r\n\r\n.video-thumbnail {\r\n  position: absolute;\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n}\r\n\r\n#tomatican-player {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  aspect-ratio: 16 / 9;\r\n}\r\n\r\n.play-button {\r\n  position: relative;\r\n  z-index: 2;\r\n  background: none;\r\n  border: none;\r\n  cursor: pointer;\r\n  transition: transform 0.2s ease;\r\n  padding: 0;\r\n  -webkit-tap-highlight-color: rgba(255, 255, 255, 0.3);\r\n  touch-action: manipulation;\r\n}\r\n\r\n.play-button img {\r\n  width: 80px;\r\n  height: 80px;\r\n}\r\n\r\n.play-button:hover,\r\n.play-button:active {\r\n  transform: scale(1.1);\r\n}\r\n\r\n/* Responsive adjustments */\r\n@media (max-width: 768px) {\r\n  .recetas-section {\r\n    padding: 0 30px;\r\n  }\r\n\r\n  .recetas-grid {\r\n    grid-template-columns: repeat(2, 1fr);\r\n    gap: 1rem;\r\n  }\r\n\r\n  .video-content {\r\n    width: 95vw;\r\n    aspect-ratio: 1 / 1;\r\n  }\r\n\r\n  .receta-botones button {\r\n    padding: 1.05rem;\r\n    font-size: 0.7rem;\r\n  }\r\n\r\n  .receta-botones img {\r\n    width: 28px;\r\n    height: 20px;\r\n    margin-right: 0.5rem;\r\n  }\r\n\r\n  .overlay-content {\r\n    width: 100%;\r\n  }\r\n\r\n  .fallback-content {\r\n    padding: 1.5rem;\r\n  }\r\n\r\n  .thumbnail-container {\r\n    max-width: 280px;\r\n  }\r\n\r\n  .preview-info h3 {\r\n    font-size: 1.1rem;\r\n  }\r\n\r\n  .preview-info p {\r\n    font-size: 0.8rem;\r\n  }\r\n\r\n  .youtube-button {\r\n    padding: 10px 20px;\r\n    font-size: 0.9rem;\r\n    min-width: 180px;\r\n  }\r\n\r\n  .video-tomatican-container {\r\n    max-width: 100%;\r\n    aspect-ratio: 16 / 9;\r\n  }\r\n}\r\n\r\n@media (max-width: 480px) {\r\n  .recetas-grid {\r\n    gap: 0.8rem;\r\n  }\r\n\r\n  .receta-botones button {\r\n    padding: 0.6rem 0.3rem;\r\n    font-size: 0.55rem;\r\n    gap: 0.2rem;\r\n  }\r\n\r\n  .receta-botones img {\r\n    width: 20px;\r\n    height: 16px;\r\n    margin-right: 0.2rem;\r\n  }\r\n\r\n  .thumbnail-container {\r\n    max-width: 240px;\r\n  }\r\n\r\n  .fallback-content {\r\n    padding: 1rem;\r\n  }\r\n\r\n  .youtube-button {\r\n    padding: 8px 16px;\r\n    font-size: 0.8rem;\r\n    min-width: 160px;\r\n  }\r\n}\r\n\r\n@media (max-width: 360px) {\r\n  .recetas-grid {\r\n    gap: 0.5rem;\r\n  }\r\n\r\n  .receta-botones button {\r\n    padding: 0.4rem 0.2rem;\r\n    font-size: 0.45rem;\r\n  }\r\n\r\n  .receta-botones img {\r\n    width: 16px;\r\n    height: 12px;\r\n    margin-right: 0.2rem;\r\n  }\r\n\r\n  .thumbnail-container {\r\n    max-width: 200px;\r\n  }\r\n}\r\n\r\n/* Optimizaciones específicas para iOS */\r\n@supports (-webkit-touch-callout: none) {\r\n  .video-container iframe {\r\n    pointer-events: auto;\r\n    -webkit-overflow-scrolling: touch;\r\n  }\r\n\r\n  .overlay {\r\n    -webkit-overflow-scrolling: touch;\r\n  }\r\n\r\n  .youtube-button {\r\n    -webkit-appearance: none;\r\n    -webkit-border-radius: 25px;\r\n  }\r\n}\r\n"
