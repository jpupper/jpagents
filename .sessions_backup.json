          "path": "D:/Programacion/caminosysabores/public/redsocial/index_redirect.html",
          "name": "index_redirect.html",
          "content": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>San Juan Social</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;800&family=Open+Sans:wght@400;600&display=swap\" rel=\"stylesheet\">\n  <meta http-equiv=\"refresh\" content=\"3;url=https://vps-4455523-x.dattaweb.com/redsocial/\">\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body {\n      font-family: 'Montserrat', sans-serif;\n      background: linear-gradient(135deg, #E6643C, #E6643C);\n      color: #F5F0E1;\n      min-height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      text-align: center;\n      padding: 2rem;\n    }\n    .card {\n      background: rgba(245, 240, 225, 0.1);\n      backdrop-filter: blur(10px);\n      border-radius: 20px;\n      padding: 3rem;\n      max-width: 500px;\n      border: 1px solid rgba(245, 240, 225, 0.2);\n    }\n    .logo { font-size: 3rem; margin-bottom: 1rem; color: #FFC72C; }\n    h1 { font-size: 1.8rem; font-weight: 800; letter-spacing: 0.1em; margin-bottom: 1rem; }\n    p { font-family: 'Open Sans', sans-serif; opacity: 0.85; line-height: 1.7; margin-bottom: 1.5rem; }\n    a {\n      display: inline-block;\n      background: #F5F0E1;\n      color: #E6643C;\n      padding: 14px 32px;\n      border-radius: 8px;\n      text-decoration: none;\n      font-weight: 700;\n      letter-spacing: 0.05em;\n      transition: all 0.3s ease;\n    }\n    a:hover { background: #FFC72C; transform: translateY(-2px); }\n    .stamp {\n      margin-top: 2rem;\n      font-size: 0.7rem;\n      letter-spacing: 0.15em;\n      opacity: 0.5;\n      padding: 6px;\n      border: 1px solid rgba(245, 240, 225, 0.3);\n      border-radius: 4px;\n    }\n    .loading { margin: 1.5rem 0; }\n    .spinner {\n      width: 30px; height: 30px;\n      border: 3px solid rgba(245, 240, 225, 0.2);\n      border-top-color: #FFC72C;\n      border-radius: 50%;\n      animation: spin 0.8s linear infinite;\n      margin: 0 auto;\n    }\n    @keyframes spin { to { transform: rotate(360deg); } }\n  </style>\n</head>\n<body>\n  <div class=\"card\">\n    <div class=\"logo\">&#9670;</div>\n    <h1>San Juan Social</h1>\n    <p>Comparti tus experiencias, descubri lugares y conectate con la comunidad sanjuanina.</p>\n    <div class=\"loading\"><div class=\"spinner\"></div></div>\n    <p style=\"font-size:0.85rem;opacity:0.6;\">Redirigiendo a la aplicacion...</p>\n    <a href=\"https://vps-4455523-x.dattaweb.com/redsocial/\">Ir a San Juan Social</a>\n\n  </div>\n</body>\n</html>\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/public/redsocial/pages/evento-subir.html",
          "name": "evento-subir.html",
          "content": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Subir Foto - Comparti San Juan</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Open+Sans:wght@300;400;600&display=swap\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"../css/style.css\">\n  <style>\n    body {\n      background: var(--cream);\n      min-height: 100vh;\n      display: flex;\n      flex-direction: column;\n    }\n\n    .page-header {\n      background: linear-gradient(135deg, var(--terracota), var(--orange-burnt));\n      color: var(--white);\n      padding: var(--space-lg) var(--space-md);\n      text-align: center;\n      box-shadow: var(--shadow-md);\n    }\n\n    .page-header h1 {\n      font-family: var(--font-heading);\n      font-size: 1.6rem;\n      font-weight: 700;\n      margin-bottom: var(--space-xs);\n      letter-spacing: 0.02em;\n    }\n\n    .page-header .subtitle {\n      font-size: 0.9rem;\n      opacity: 0.85;\n    }\n\n    .upload-container {\n      max-width: 520px;\n      margin: var(--space-2xl) auto;\n      padding: 0 var(--space-md);\n      flex: 1;\n    }\n\n    /* Drop zone */\n    .drop-zone {\n      border: 3px dashed var(--terracota-light);\n      border-radius: var(--radius-xl);\n      padding: var(--space-3xl) var(--space-lg);\n      text-align: center;\n      cursor: pointer;\n      transition: all var(--transition-base);\n      background: var(--white);\n      position: relative;\n    }\n\n    .drop-zone:hover,\n    .drop-zone.drag-over {\n      border-color: var(--terracota);\n      background: rgba(230, 100, 60, 0.05);\n    }\n\n    .drop-zone .icon {\n      font-size: 4rem;\n      margin-bottom: var(--space-md);\n      opacity: 0.6;\n    }\n\n    .drop-zone .text {\n      font-family: var(--font-heading);\n      font-size: 1.1rem;\n      color: var(--gray-dark);\n      margin-bottom: var(--space-sm);\n    }\n\n    .drop-zone .hint {\n      font-size: 0.85rem;\n      color: var(--gray-medium);\n    }\n\n    .drop-zone input[type=\"file\"] {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 100%;\n      opacity: 0;\n      cursor: pointer;\n    }\n\n    /* Preview */\n    #previewContainer {\n      display: none;\n      margin-top: var(--space-lg);\n    }\n\n    #previewContainer.show {\n      display: block;\n    }\n\n    .preview-card {\n      background: var(--white);\n      border-radius: var(--radius-lg);\n      overflow: hidden;\n      box-shadow: var(--shadow-md);\n    }\n\n    .preview-card img {\n      width: 100%;\n      max-height: 400px;\n      object-fit: contain;\n      background: #f0ebe0;\n      display: block;\n    }\n\n    .preview-info {\n      padding: var(--space-md);\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      font-size: 0.85rem;\n      color: var(--gray-medium);\n    }\n\n    .preview-info .filename {\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n      max-width: 200px;\n    }\n\n    .preview-info .change-btn {\n      background: none;\n      border: none;\n      color: var(--terracota);\n      font-family: var(--font-body);\n      font-weight: 600;\n      cursor: pointer;\n      font-size: 0.8rem;\n      text-decoration: underline;\n    }\n\n    /* Buttons */\n    .upload-actions {\n      margin-top: var(--space-lg);\n      display: flex;\n      flex-direction: column;\n      gap: var(--space-md);\n    }\n\n    .btn-subir {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: var(--space-sm);\n      background: linear-gradient(135deg, var(--terracota), var(--orange-burnt));\n      color: var(--white);\n      font-family: var(--font-heading);\n      font-weight: 600;\n      font-size: 0.95rem;\n      text-transform: uppercase;\n      letter-spacing: 0.05em;\n      padding: 14px 32px;\n      border: none;\n      border-radius: var(--radius-md);\n      cursor: pointer;\n      transition: all var(--transition-base);\n      width: 100%;\n    }\n\n    .btn-subir:hover:not(:disabled) {\n      background: linear-gradient(135deg, var(--orange-burnt), var(--terracota-dark));\n      box-shadow: var(--shadow-md);\n      transform: translateY(-1px);\n    }\n\n    .btn-subir:disabled {\n      opacity: 0.5;\n      cursor: not-allowed;\n    }\n\n    .btn-subir.loading {\n      pointer-events: none;\n      opacity: 0.7;\n    }\n\n    .btn-galeria {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      gap: var(--space-sm);\n      background: transparent;\n      color: var(--terracota);\n      font-family: var(--font-heading);\n      font-weight: 600;\n      font-size: 0.85rem;\n      text-transform: uppercase;\n      letter-spacing: 0.05em;\n      padding: 10px 24px;\n      border: 2px solid var(--terracota-light);\n      border-radius: var(--radius-md);\n      cursor: pointer;\n      transition: all var(--transition-base);\n      text-decoration: none;\n      text-align: center;\n    }\n\n    .btn-galeria:hover {\n      background: var(--terracota);\n      color: var(--white);\n      border-color: var(--terracota);\n    }\n\n    /* Success state */\n    #successContainer {\n      display: none;\n      text-align: center;\n      padding: var(--space-3xl) var(--space-md);\n    }\n\n    #successContainer.show {\n      display: block;\n    }\n\n    #successContainer .check-icon {\n      font-size: 4rem;\n      margin-bottom: var(--space-md);\n    }\n\n    #successContainer h2 {\n      font-family: var(--font-heading);\n      color: var(--terracota);\n      margin-bottom: var(--space-sm);\n    }\n\n    #successContainer p {\n      color: var(--gray-medium);\n      margin-bottom: var(--space-lg);\n    }\n\n    /* Progress bar */\n    .progress-bar {\n      display: none;\n      width: 100%;\n      height: 6px;\n      background: var(--cream-dark);\n      border-radius: 3px;\n      overflow: hidden;\n      margin-top: var(--space-md);\n    }\n\n    .progress-bar.show {\n      display: block;\n    }\n\n    .progress-bar .fill {\n      height: 100%;\n      width: 0%;\n      background: linear-gradient(90deg, var(--terracota), var(--gold-ocre));\n      border-radius: 3px;\n      transition: width 0.3s ease;\n    }\n\n    .error-msg {\n      color: var(--error);\n      font-size: 0.85rem;\n      margin-top: var(--space-sm);\n      display: none;\n    }\n\n    .error-msg.show {\n      display: block;\n    }\n  </style>\n</head>\n<body>\n\n  <div class=\"page-header\">\n    <h1>&#9670; Subir foto al evento</h1>\n    <p class=\"subtitle\">Compart&iacute; tu momento con la comunidad</p>\n  </div>\n\n  <div class=\"upload-container\">\n\n    <!-- Upload Area -->\n    <div id=\"uploadArea\">\n      <div id=\"dropZone\" class=\"drop-zone\">\n        <div class=\"icon\">&#128248;</div>\n        <div class=\"text\">Arrastr&aacute; tu foto ac&aacute;</div>\n        <div class=\"hint\">o hac&eacute; click para seleccionar</div>\n        <input type=\"file\" id=\"fileInput\" accept=\"image/*;capture=camera\">\n      </div>\n\n      <!-- Preview -->\n      <div id=\"previewContainer\">\n        <div class=\"preview-card\">\n          <img id=\"previewImg\" src=\"\" alt=\"Preview\">\n          <div class=\"preview-info\">\n            <span class=\"filename\" id=\"fileName\">archivo.jpg</span>\n            <button class=\"change-btn\" id=\"changeBtn\">Cambiar</button>\n          </div>\n        </div>\n      </div>\n\n      <!-- Progress -->\n      <div class=\"progress-bar\" id=\"progressBar\">\n        <div class=\"fill\" id=\"progressFill\"></div>\n      </div>\n\n      <div class=\"error-msg\" id=\"errorMsg\"></div>\n\n      <div class=\"upload-actions\" id=\"uploadActions\">\n        <button class=\"btn-subir\" id=\"subirBtn\" disabled>&#128228; Subir foto</button>\n        <a href=\"evento-galeria.html\" class=\"btn-galeria\">&#128065; Ver galer&iacute;a</a>\n      </div>\n    </div>\n\n    <!-- Success -->\n    <div id=\"successContainer\">\n      <div class=\"check-icon\">&#9989;</div>\n      <h2>Foto subida con &eacute;xito</h2>\n      <p>Gracias por compartir tu momento</p>\n      <a href=\"evento-galeria.html\" class=\"btn-subir\" style=\"text-decoration:none\">&#128065; Ir a la galer&iacute;a</a>\n      <br><br>\n      <button class=\"btn-galeria\" onclick=\"subirOtra()\">Subir otra foto</button>\n    </div>\n\n  </div>\n\n  <script>\n    // Detect API base: use VPS for cross-origin (fullscreencode), relative for same-server\n    const VPS_API = 'https://vps-4455523-x.dattaweb.com/redsocial/api/evento';\n    const pathname = window.location.pathname;\n    const hostname = window.location.hostname;\n    let API_BASE;\n    if (hostname === 'localhost' || hostname === '127.0.0.1' || hostname.includes('vps-')) {\n      API_BASE = '/redsocial/api/evento';\n    } else {\n      API_BASE = VPS_API;\n    }\n    const fileInput = document.getElementById('fileInput');\n    const dropZone = document.getElementById('dropZone');\n    const previewContainer = document.getElementById('previewContainer');\n    const previewImg = document.getElementById('previewImg');\n    const fileName = document.getElementById('fileName');\n    const changeBtn = document.getElementById('changeBtn');\n    const subirBtn = document.getElementById('subirBtn');\n    const progressBar = document.getElementById('progressBar');\n    const progressFill = document.getElementById('progressFill');\n    const errorMsg = document.getElementById('errorMsg');\n    const uploadArea = document.getElementById('uploadArea');\n    const successContainer = document.getElementById('successContainer');\n\n    let selectedFile = null;\n\n    // ─── Drag & Drop ────────────────────────────────────\n    dropZone.addEventListener('dragover', (e) => {\n      e.preventDefault();\n      dropZone.classList.add('drag-over');\n    });\n\n    dropZone.addEventListener('dragleave', () => {\n      dropZone.classList.remove('drag-over');\n    });\n\n    dropZone.addEventListener('drop', (e) => {\n      e.preventDefault();\n      dropZone.classList.remove('drag-over');\n      if (e.dataTransfer.files.length > 0) {\n        handleFile(e.dataTransfer.files[0]);\n      }\n    });\n\n    // ─── Click / File input ────────────────────────────\n    fileInput.addEventListener('change', () => {\n      if (fileInput.files.length > 0) {\n        handleFile(fileInput.files[0]);\n      }\n    });\n\n    changeBtn.addEventListener('click', () => {\n      fileInput.click();\n    });\n\n    // ─── Handle file selection ─────────────────────────\n    function handleFile(file) {\n      if (!file.type.startsWith('image/')) {\n        showError('Solo se aceptan im&aacute;genes.');\n        return;\n      }\n\n      if (file.size > 10 * 1024 * 1024) {\n        showError('La imagen no puede superar los 10 MB.');\n        return;\n      }\n\n      hideError();\n      selectedFile = file;\n      fileName.textContent = file.name;\n      subirBtn.disabled = false;\n\n      // Show preview\n      const reader = new FileReader();\n      reader.onload = (e) => {\n        previewImg.src = e.target.result;\n        previewContainer.classList.add('show');\n      };\n      reader.readAsDataURL(file);\n    }\n\n    // ─── Upload ─────────────────────────────────────────\n    subirBtn.addEventListener('click', async () => {\n      if (!selectedFile) return;\n\n      subirBtn.disabled = true;\n      subirBtn.textContent = 'Subiendo...';\n      subirBtn.classList.add('loading');\n      progressBar.classList.add('show');\n      errorMsg.classList.remove('show');\n      progressFill.style.width = '0%';\n\n      // Animate progress\n      let progress = 0;\n      const progressInterval = setInterval(() => {\n        progress += Math.random() * 15;\n        if (progress > 90) progress = 90;\n        progressFill.style.width = progress + '%';\n      }, 300);\n\n      try {\n        const formData = new FormData();\n        formData.append('foto', selectedFile);\n\n        const res = await fetch(API_BASE + '/subir', {\n          method: 'POST',\n          body: formData\n        });\n\n        const data = await res.json();\n\n        clearInterval(progressInterval);\n        progressFill.style.width = '100%';\n\n        if (data.ok) {\n          // Show success\n          setTimeout(() => {\n            uploadArea.style.display = 'none';\n            successContainer.classList.add('show');\n          }, 400);\n        } else {\n          showError(data.error || 'Error al subir la foto');\n          subirBtn.disabled = false;\n          subirBtn.textContent = 'Subir foto';\n          subirBtn.classList.remove('loading');\n        }\n      } catch (err) {\n        clearInterval(progressInterval);\n        showError('Error de conexi&oacute;n. Intenta de nuevo.');\n        subirBtn.disabled = false;\n        subirBtn.textContent = 'Subir foto';\n        subirBtn.classList.remove('loading');\n        progressBar.classList.remove('show');\n        console.error(err);\n      }\n    });\n\n    // ─── Helpers ────────────────────────────────────────\n    function showError(msg) {\n      errorMsg.innerHTML = msg;\n      errorMsg.classList.add('show');\n    }\n\n    function hideError() {\n      errorMsg.classList.remove('show');\n      errorMsg.innerHTML = '';\n    }\n\n    function subirOtra() {\n      successContainer.classList.remove('show');\n      uploadArea.style.display = 'block';\n      subirBtn.disabled = true;\n      subirBtn.textContent = 'Subir foto';\n      subirBtn.classList.remove('loading');\n      progressBar.classList.remove('show');\n      progressFill.style.width = '0%';\n      previewContainer.classList.remove('show');\n      previewImg.src = '';\n      selectedFile = null;\n      fileInput.value = '';\n    }\n  </script>\n\n</body>\n</html>\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/server.js",
          "name": "server.js",
          "content": "const express = require('express');\nconst fs = require('fs');\nconst path = require('path');\n\n// Load env vars from server config (JWT_SECRET, etc.)\ntry { require('dotenv').config({ path: path.join(__dirname, 'server', '.env') }); } catch(e) {}\n// Also load root .env for admin seeding vars (STARTING_ADMIN_USER, STARTING_ADMIN_PASS)\ntry { require('dotenv').config({ path: path.join(__dirname, '.env') }); } catch(e) {}\n\nconst app = express();\nconst PORT = process.env.PORT || 2354;\nconst ROOT = __dirname;\n\n// ─── ADMIN SEEDING ──────────────────────────────────────\n// On each startup, seed/update the admin user from env vars\n(async () => {\n  try {\n    const bcrypt = require('bcryptjs');\n    const USERS_FILE = path.join(ROOT, 'server', 'data', 'users.json');\n    const adminUser = process.env.STARTING_ADMIN_USER || 'admin';\n    const adminPass = process.env.STARTING_ADMIN_PASS;\n    const adminEmail = process.env.STARTING_ADMIN_EMAIL || 'admin@sanjuan.gob.ar';\n\n    if (!adminPass) {\n      console.log('  [Seed] No STARTING_ADMIN_PASS set, skipping admin seeding');\n      return;\n    }\n\n    // Ensure data dir\n    const dir = path.dirname(USERS_FILE);\n    if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true });\n\n    let users = [];\n    if (fs.existsSync(USERS_FILE)) {\n      try { users = JSON.parse(fs.readFileSync(USERS_FILE, 'utf-8')); } catch(e) { users = []; }\n    }\n\n    const existingIdx = users.findIndex(u => u.name === adminUser);\n\n    if (existingIdx >= 0) {\n      // Update existing admin password if changed\n      const currentHash = users[existingIdx].password;\n      const isMatch = await bcrypt.compare(adminPass, currentHash);\n      if (!isMatch) {\n        const newHash = await bcrypt.hash(adminPass, 12);\n        users[existingIdx].password = newHash;\n        fs.writeFileSync(USERS_FILE, JSON.stringify(users, null, 2), 'utf-8');\n        console.log(`  [Seed] Admin \"${adminUser}\" password updated from .env`);\n      } else {\n        console.log(`  [Seed] Admin \"${adminUser}\" password is up to date`);\n      }\n    } else {\n      // Create new admin user\n      const hashedPassword = await bcrypt.hash(adminPass, 12);\n      const newUser = {\n        _id: 'admin001',\n        name: adminUser,\n        email: adminEmail,\n        password: hashedPassword,\n        role: 'admin',\n        profile_pic: '/redsocial/uploads/admin_profile.jpg',\n        createdAt: new Date().toISOString()\n      };\n      users.push(newUser);\n      fs.writeFileSync(USERS_FILE, JSON.stringify(users, null, 2), 'utf-8');\n      console.log(`  [Seed] Admin \"${adminUser}\" created from .env`);\n    }\n  } catch (err) {\n    console.error('  [Seed] Error seeding admin:', err.message);\n  }\n})();\n\napp.use(express.json({ limit: '50mb' }));\napp.use(express.urlencoded({ extended: true, limit: '50mb' }));\n\n// ─── IMPORT AUTH ROUTES ──────────────────────────────\n// These handle: POST /api/auth/register, POST /api/auth/login, GET /api/auth/me\n// They store users in server/data/users.json\nconst authRoutes = require('./server/routes/auth');\napp.use('/api/auth', authRoutes);\n\n// ─── RED SOCIAL API ROUTES ────────────────────────\n// Auth, posts, and user management for the red social app\nconst rsAuthRoutes = require('./server/routes/redsocial-auth');\nconst rsPostsRoutes = require('./server/routes/posts');\nconst rsUsersRoutes = require('./server/routes/redsocial-users');\nconst rsEventoRoutes = require('./server/routes/evento');\nconst RS_UPLOADS = path.join(ROOT, 'public', 'redsocial', 'uploads');\n\napp.use('/redsocial/api/auth', rsAuthRoutes);\napp.use('/redsocial/api/posts', rsPostsRoutes);\napp.use('/redsocial/api/users', rsUsersRoutes);\napp.use('/redsocial/api/evento', rsEventoRoutes);\n\n// Also mount evento routes directly at /api/evento for direct upload\napp.use('/api/evento', rsEventoRoutes);\n\n// Serve redsocial uploads\nif (fs.existsSync(RS_UPLOADS)) {\n  app.use('/redsocial/uploads', express.static(RS_UPLOADS));\n}\n\n// ─── CONFIG API ───────────────────────────────────────\n// Generic config save/load per app (maqueta, canasta, memotest)\n// Config files are stored at <app>/<app>_config.json in the app's root folder\n\nfunction getConfigPath(appName) {\n  const dir = path.join(ROOT, appName);\n  if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true });\n  return path.join(dir, `${appName}_config.json`);\n}\n\nfunction getConfig(appName) {\n  const configPath = getConfigPath(appName);\n  try {\n    if (fs.existsSync(configPath)) {\n      return JSON.parse(fs.readFileSync(configPath, 'utf8'));\n    }\n  } catch(e) {\n    console.error(`Error reading ${appName} config:`, e.message);\n  }\n  return null;\n}\n\nfunction saveConfig(appName, data) {\n  const configPath = getConfigPath(appName);\n  fs.writeFileSync(configPath, JSON.stringify(data, null, 2), 'utf8');\n}\n\napp.get('/api/:app/config', (req, res) => {\n  const { app: appName } = req.params;\n  const allowed = ['maqueta', 'canasta', 'memotest'];\n  if (!allowed.includes(appName)) {\n    return res.status(400).json({ error: `Invalid app: ${appName}` });\n  }\n  const data = getConfig(appName);\n  if (data) {\n    res.json(data);\n  } else {\n    res.json({});\n  }\n});\n\napp.post('/api/:app/config', (req, res) => {\n  const { app: appName } = req.params;\n  const allowed = ['maqueta', 'canasta', 'memotest'];\n  if (!allowed.includes(appName)) {\n    return res.status(400).json({ error: `Invalid app: ${appName}` });\n  }\n  try {\n    saveConfig(appName, req.body);\n    res.json({ ok: true });\n  } catch(e) {\n    console.error(`Error saving ${appName} config:`, e.message);\n    res.status(500).json({ ok: false, error: e.message });\n  }\n});\n\n// ─── MAQUETA POI API ─────────────────────────────────\n// POI data is stored inside public/maqueta/ so the frontend\n// can load it via fetch('./pois.json') from the static file\nconst POIS_PATH = path.join(ROOT, 'public', 'maqueta', 'pois.json');\nconst IMGS_DIR = path.join(ROOT, 'public', 'maqueta', 'poi_images');\n\nfunction loadPois() {\n  try {\n    if (fs.existsSync(POIS_PATH)) {\n      return JSON.parse(fs.readFileSync(POIS_PATH, 'utf8'));\n    }\n  } catch(e) {\n    console.error('Error reading pois:', e.message);\n  }\n  return [];\n}\n\nfunction savePois(data) {\n  const dir = path.dirname(POIS_PATH);\n  if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true });\n  fs.writeFileSync(POIS_PATH, JSON.stringify(data, null, 2), 'utf8');\n}\n\napp.get('/api/maqueta/pois', (req, res) => {\n  res.json(loadPois());\n});\n\napp.post('/api/maqueta/pois', (req, res) => {\n  const data = req.body;\n  if (!Array.isArray(data)) {\n    return res.status(400).json({ error: 'Expected array' });\n  }\n  savePois(data);\n  res.json({ ok: true, count: data.length });\n});\n\n// ─── MAQUETA IMAGE UPLOAD ─────────────────────────────\n// The maqueta frontend uploads images via POST /api/upload\napp.post('/api/upload', (req, res) => {\n  try {\n    if (!fs.existsSync(IMGS_DIR)) fs.mkdirSync(IMGS_DIR, { recursive: true });\n\n    // Accept both base64 (json body) and multipart/form-data\n    if (req.is('multipart/form-data')) {\n      // For file upload via FormData (from frontend)\n      const busboy = require('busboy');\n      const bb = busboy({ headers: req.headers });\n      let savedFile = null;\n\n      bb.on('file', (fieldname, file, info) => {\n        const ext = path.extname(info.filename) || '.png';\n        const existing = fs.readdirSync(IMGS_DIR).filter(f => f.match(/\\.(png|jpg|jpeg)$/));\n        const saveName = `${existing.length}${ext}`;\n        const savePath = path.join(IMGS_DIR, saveName);\n        const ws = fs.createWriteStream(savePath);\n        file.pipe(ws);\n        savedFile = { filename: saveName, path: `poi_images/${saveName}` };\n      });\n\n      bb.on('finish', () => {\n        if (savedFile) {\n          res.json({ ok: true, ...savedFile });\n        } else {\n          res.status(400).json({ error: 'No se recibió archivo' });\n        }\n      });\n\n      req.pipe(bb);\n    } else {\n      // Base64 upload from JSON body\n      const { filename, data: base64Data } = req.body;\n      if (!base64Data) {\n        return res.status(400).json({ error: 'No se recibió imagen' });\n      }\n\n      const ext = filename ? path.extname(filename) : '.png';\n      const existing = fs.readdirSync(IMGS_DIR).filter(f => f.match(/\\.(png|jpg|jpeg)$/));\n      const saveName = `${existing.length}${ext}`;\n      const savePath = path.join(IMGS_DIR, saveName);\n\n      const buffer = Buffer.from(base64Data, 'base64');\n      fs.writeFileSync(savePath, buffer);\n\n      res.json({ ok: true, filename: saveName, path: `poi_images/${saveName}` });\n    }\n  } catch (err) {\n    console.error('Upload error:', err);\n    res.status(500).json({ error: 'Error al subir imagen' });\n  }\n});\n\n// ─── REUNIONES FORM API ──────────────────────────────\n// Form submissions for CONEX and PRENSA\nconst REUNIONES_PATH = path.join(ROOT, 'server', 'data', 'reuniones.json');\n\nfunction loadReuniones() {\n  try {\n    if (fs.existsSync(REUNIONES_PATH)) {\n      return JSON.parse(fs.readFileSync(REUNIONES_PATH, 'utf8'));\n    }\n  } catch(e) {\n    console.error('Error reading reuniones:', e.message);\n  }\n  return [];\n}\n\nfunction saveReuniones(data) {\n  const dir = path.dirname(REUNIONES_PATH);\n  if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true });\n  fs.writeFileSync(REUNIONES_PATH, JSON.stringify(data, null, 2), 'utf8');\n}\n\n// POST /api/reuniones - Save a form submission (CONEX or PRENSA)\napp.post('/api/reuniones', (req, res) => {\n  try {\n    const { tipo, nombre, apellido, correo, empresa, medio, cargo, motivo, tematica, horario, createdAt } = req.body;\n    \n    if (!tipo || !nombre || !apellido || !correo) {\n      return res.status(400).json({ error: 'Faltan campos obligatorios (tipo, nombre, apellido, correo)' });\n    }\n\n    if (tipo !== 'conex' && tipo !== 'prensa') {\n      return res.status(400).json({ error: 'Tipo debe ser \"conex\" o \"prensa\"' });\n    }\n\n    const reuniones = loadReuniones();\n    const entry = {\n      id: Date.now().toString(36) + Math.random().toString(36).slice(2, 6),\n      tipo,\n      nombre,\n      apellido,\n      correo,\n      empresa: empresa || '',\n      medio: medio || '',\n      cargo: cargo || '',\n      motivo: motivo || '',\n      tematica: tematica || '',\n      horario: horario || '',\n      createdAt: createdAt || new Date().toISOString()\n    };\n    reuniones.push(entry);\n    saveReuniones(reuniones);\n    res.json({ ok: true, id: entry.id });\n  } catch (err) {\n    console.error('Error saving reunion:', err);\n    res.status(500).json({ error: 'Error al guardar' });\n  }\n});\n\n// GET /api/reuniones - List all form submissions\napp.get('/api/reuniones', (req, res) => {\n  try {\n    const reuniones = loadReuniones();\n    // Sort by newest first\n    reuniones.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));\n    res.json(reuniones);\n  } catch (err) {\n    console.error('Error loading reuniones:', err);\n    res.status(500).json({ error: 'Error al cargar' });\n  }\n});\n\n// DELETE /api/reuniones/:id - Delete a submission\napp.delete('/api/reuniones/:id', (req, res) => {\n  try {\n    let reuniones = loadReuniones();\n    const before = reuniones.length;\n    reuniones = reuniones.filter(r => r.id !== req.params.id);\n    if (reuniones.length === before) {\n      return res.status(404).json({ error: 'No encontrado' });\n    }\n    saveReuniones(reuniones);\n    res.json({ ok: true });\n  } catch (err) {\n    console.error('Error deleting reunion:', err);\n    res.status(500).json({ error: 'Error al eliminar' });\n  }\n});\n\n// ─── ROOT: SITIO MICROSITE ──────────────────────────────\n// By default, http://localhost:2354/ serves the sitio microsite\n// Files are directly in public/ so static middleware handles it\napp.get('/', (req, res) => {\n  const indexPath = path.join(ROOT, 'public', 'index.html');\n  if (fs.existsSync(indexPath)) {\n    res.sendFile(indexPath);\n  } else {\n    res.sendFile(path.join(ROOT, 'public', 'sitio', 'index.html'));\n  }\n});\n\n// ─── PAGINA ACCESO ─────────────────────────────────────\n// The access page (formerly index.html) with links to all apps\napp.get('/paginaacceso', (req, res) => {\n  res.sendFile(path.join(ROOT, 'public', 'paginaacceso.html'));\n});\n\n// ─── STATIC FILES ─────────────────────────────────────\n// Serve all frontend applications from the public/ directory\n// Each app is at /<app>/, e.g. /maqueta/, /memotest/, /redsocial/, /canasta/, /botonera/\napp.use(express.static(path.join(ROOT, 'public'), {\n  setHeaders: (res, filePath) => {\n    const ext = path.extname(filePath).toLowerCase();\n    const mimeTypes = {\n      '.glb': 'model/gltf-binary',\n      '.npy': 'application/octet-stream',\n      '.map': 'application/json'\n    };\n    if (mimeTypes[ext]) {\n      res.setHeader('Content-Type', mimeTypes[ext]);\n    }\n  }\n}));\n\n// ─── RED SOCIAL SPA FALLBACK ──────────────────────────\n// Serve redsocial pages for direct URL access (login, register, etc.)\napp.get('/redsocial/pages/:page', (req, res) => {\n  const page = req.params.page;\n  const pagePath = path.join(ROOT, 'public', 'redsocial', 'pages', page);\n  if (fs.existsSync(pagePath)) {\n    res.sendFile(pagePath);\n  } else {\n    res.sendFile(path.join(ROOT, 'public', 'redsocial', 'index.html'));\n  }\n});\n\n// ─── START ────────────────────────────────────────────\napp.listen(PORT, '0.0.0.0', () => {\n  console.log(`============================================`);\n  console.log(`  Caminos y Sabores - Servidor Express`);\n  console.log(`  Puerto: ${PORT}`);\n  console.log(`  http://localhost:${PORT}`);\n  console.log(`============================================`);\n  console.log(`  Apps:`);\n  console.log(`  http://localhost:${PORT}           - Sitio Web (default)`);\n  console.log(`  http://localhost:${PORT}/paginaacceso  - Acceso a todas las apps`);\n  console.log(`  http://localhost:${PORT}/maqueta/      - Maqueta San Juan`);\n  console.log(`  http://localhost:${PORT}/memotest/     - Memotest`);\n  console.log(`  http://localhost:${PORT}/redsocial/    - Red Social`);\n  console.log(`  http://localhost:${PORT}/canasta/      - Canasta`);\n  console.log(`  http://localhost:${PORT}/botonera/     - Botonera 3D`);\n  console.log(`============================================`);\n  console.log(`  API Endpoints:`);\n  console.log(`  POST /api/auth/register   - Registrar usuario`);\n  console.log(`  POST /api/auth/login      - Iniciar sesión`);\n  console.log(`  GET  /api/auth/me         - Obtener usuario actual`);\n  console.log(`  GET  /api/:app/config     - Cargar config (maqueta, canasta, memotest)`);\n  console.log(`  POST /api/:app/config     - Guardar config`);\n  console.log(`  GET  /api/maqueta/pois    - Cargar POIs`);\n  console.log(`  POST /api/maqueta/pois   - Guardar POIs`);\n  console.log(`  POST /api/upload         - Subir imagen (maqueta)`);\n  console.log(`============================================`);\n});\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/public/adminsitio.html",
          "name": "adminsitio.html",
          "content": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Admin - Formularios Caminos y Sabores</title>\n    <link rel=\"stylesheet\" href=\"css/style.css\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Ubuntu:wght@300;400;500;700&display=swap\" rel=\"stylesheet\">\n    <style>\n        body {\n            font-family: 'Ubuntu', sans-serif;\n            margin: 0;\n            padding: 0;\n            background: #f0ebe5;\n            min-height: 100vh;\n        }\n\n        .admin-header {\n            background: linear-gradient(135deg, #2d1818, #5A2828);\n            color: white;\n            padding: 30px 25px;\n            text-align: center;\n        }\n\n        .admin-header h1 {\n            margin: 0;\n            font-size: 1.8rem;\n            font-weight: 700;\n        }\n\n        .admin-header p {\n            margin: 8px 0 0;\n            opacity: 0.8;\n            font-size: 0.9rem;\n        }\n\n        .admin-controls {\n            max-width: 1000px;\n            margin: 20px auto;\n            padding: 0 20px;\n            display: flex;\n            gap: 12px;\n            flex-wrap: wrap;\n            align-items: center;\n        }\n\n        .filter-group {\n            display: flex;\n            gap: 8px;\n            flex-wrap: wrap;\n        }\n\n        .filter-btn {\n            padding: 8px 18px;\n            border-radius: 20px;\n            border: 2px solid #ddd;\n            background: white;\n            font-family: 'Ubuntu', sans-serif;\n            font-size: 0.85rem;\n            cursor: pointer;\n            transition: all 0.3s;\n            font-weight: 500;\n        }\n\n        .filter-btn:hover {\n            border-color: #E6643C;\n        }\n\n        .filter-btn.active {\n            background: #E6643C;\n            color: white;\n            border-color: #E6643C;\n        }\n\n        .admin-stats {\n            max-width: 1000px;\n            margin: 0 auto;\n            padding: 0 20px;\n            display: flex;\n            gap: 15px;\n            flex-wrap: wrap;\n        }\n\n        .stat-card {\n            flex: 1;\n            min-width: 120px;\n            background: white;\n            border-radius: 12px;\n            padding: 18px 20px;\n            text-align: center;\n            box-shadow: 0 2px 8px rgba(0,0,0,0.05);\n        }\n\n        .stat-card .stat-number {\n            font-size: 1.6rem;\n            font-weight: 700;\n            color: #E6643C;\n        }\n\n        .stat-card .stat-label {\n            font-size: 0.75rem;\n            color: #888;\n            text-transform: uppercase;\n            letter-spacing: 1px;\n            margin-top: 4px;\n        }\n\n        .admin-table-container {\n            max-width: 1000px;\n            margin: 20px auto;\n            padding: 0 20px 50px;\n        }\n\n        .admin-table {\n            width: 100%;\n            background: white;\n            border-radius: 15px;\n            overflow: hidden;\n            box-shadow: 0 2px 12px rgba(0,0,0,0.06);\n        }\n\n        .admin-table table {\n            width: 100%;\n            border-collapse: collapse;\n        }\n\n        .admin-table th {\n            background: #5A2828;\n            color: white;\n            padding: 12px 15px;\n            text-align: left;\n            font-size: 0.8rem;\n            text-transform: uppercase;\n            letter-spacing: 1px;\n            font-weight: 600;\n        }\n\n        .admin-table td {\n            padding: 12px 15px;\n            font-size: 0.85rem;\n            color: #333;\n            border-bottom: 1px solid #f0f0f0;\n        }\n\n        .admin-table tr:hover td {\n            background: #fff8f3;\n        }\n\n        .admin-table tr:last-child td {\n            border-bottom: none;\n        }\n\n        .tipo-badge {\n            display: inline-block;\n            padding: 3px 10px;\n            border-radius: 12px;\n            font-size: 0.75rem;\n            font-weight: 600;\n            text-transform: uppercase;\n        }\n\n        .tipo-badge.conex {\n            background: #fde8e0;\n            color: #E6643C;\n        }\n\n        .tipo-badge.prensa {\n            background: #e0e8f5;\n            color: #5078B4;\n        }\n\n        .delete-btn {\n            background: none;\n            border: none;\n            cursor: pointer;\n            color: #D45336;\n            font-size: 1.1rem;\n            padding: 4px 8px;\n            border-radius: 5px;\n            transition: all 0.3s;\n        }\n\n        .delete-btn:hover {\n            background: #fee;\n        }\n\n        .empty-state {\n            text-align: center;\n            padding: 60px 20px;\n            color: #aaa;\n        }\n\n        .empty-state svg {\n            width: 60px;\n            height: 60px;\n            fill: #ddd;\n            margin-bottom: 15px;\n        }\n\n        .empty-state p {\n            font-size: 1rem;\n        }\n\n        .loading-state {\n            text-align: center;\n            padding: 40px;\n            color: #888;\n        }\n\n        .date-col {\n            white-space: nowrap;\n            font-size: 0.8rem;\n            color: #999;\n        }\n\n        .export-btn {\n            padding: 8px 18px;\n            background: #5A2828;\n            color: white;\n            border: none;\n            border-radius: 20px;\n            font-family: 'Ubuntu', sans-serif;\n            font-size: 0.85rem;\n            cursor: pointer;\n            font-weight: 500;\n            transition: background 0.3s;\n        }\n\n        .export-btn:hover {\n            background: #3a1a1a;\n        }\n\n        @media (max-width: 700px) {\n            .admin-table th, \n            .admin-table td {\n                padding: 8px 10px;\n                font-size: 0.75rem;\n            }\n            .admin-table .hide-mobile {\n                display: none;\n            }\n        }\n\n        .admin-table td.desc-cell {\n            max-width: 150px;\n            overflow: hidden;\n            text-overflow: ellipsis;\n            white-space: nowrap;\n        }\n    </style>\n</head>\n<body>\n    <div class=\"admin-header\">\n        <h1>Administración de Formularios</h1>\n        <p>Gestioná las solicitudes de Comex y Prensa</p>\n    </div>\n\n    <div class=\"admin-stats\">\n        <div class=\"stat-card\">\n            <div class=\"stat-number\" id=\"total-count\">0</div>\n            <div class=\"stat-label\">Total</div>\n        </div>\n        <div class=\"stat-card\">\n            <div class=\"stat-number\" id=\"conex-count\" style=\"color:#E6643C\">0</div>\n            <div class=\"stat-label\">Comex</div>\n        </div>\n        <div class=\"stat-card\">\n            <div class=\"stat-number\" id=\"prensa-count\" style=\"color:#5078B4\">0</div>\n            <div class=\"stat-label\">Prensa</div>\n        </div>\n    </div>\n\n    <div class=\"admin-controls\">\n        <div class=\"filter-group\">\n            <button class=\"filter-btn active\" onclick=\"filtrar('todas')\" data-filter=\"todas\">Todas</button>\n            <button class=\"filter-btn\" onclick=\"filtrar('conex')\" data-filter=\"conex\">Comex</button>\n            <button class=\"filter-btn\" onclick=\"filtrar('prensa')\" data-filter=\"prensa\">Prensa</button>\n        </div>\n        <button class=\"export-btn\" onclick=\"exportarCSV()\">Exportar CSV</button>\n        <span style=\"margin-left:auto;font-size:0.8rem;color:#999;\" id=\"refresh-info\">Última actualización: --</span>\n    </div>\n\n    <div class=\"admin-table-container\">\n        <div class=\"admin-table\" id=\"table-container\">\n            <div class=\"loading-state\" id=\"loading-state\">Cargando datos...</div>\n            <div id=\"empty-state\" class=\"empty-state\" style=\"display:none;\">\n                <svg viewBox=\"0 0 24 24\"><path d=\"M20 2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14l4 4V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z\"/></svg>\n                <p>No hay formularios cargados todavía</p>\n            </div>\n        </div>\n    </div>\n\n    <script src=\"js/header.js\"></script>\n    <script src=\"js/footer.js\"></script>\n    <script>\n        let todosLosDatos = [];\n        let filtroActual = 'todas';\n\n        async function cargarDatos() {\n            const container = document.getElementById('table-container');\n            const loading = document.getElementById('loading-state');\n            const empty = document.getElementById('empty-state');\n\n            loading.style.display = 'block';\n            \n            // Hide existing table if any\n            const existingTable = container.querySelector('table');\n            if (existingTable) existingTable.style.display = 'none';\n\n            try {\n                const res = await fetch('/api/reuniones');\n                const data = await res.json();\n                todosLosDatos = data;\n                \n                loading.style.display = 'none';\n\n                if (data.length === 0) {\n                    empty.style.display = 'block';\n                    document.getElementById('refresh-info').textContent = 'Última actualización: ' + new Date().toLocaleTimeString();\n                    actualizarStats(data);\n                    return;\n                }\n\n                empty.style.display = 'none';\n                renderizarTabla(data);\n                actualizarStats(data);\n                document.getElementById('refresh-info').textContent = 'Última actualización: ' + new Date().toLocaleTimeString();\n            } catch (err) {\n                loading.style.display = 'none';\n                empty.style.display = 'block';\n                empty.innerHTML = '<svg viewBox=\"0 0 24 24\" width=\"50\" height=\"50\" fill=\"#ddd\"><path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z\"/></svg><p>Error al cargar. Verificá que el servidor esté corriendo.</p>';\n            }\n        }\n\n        function renderizarTabla(data) {\n            const container = document.getElementById('table-container');\n            const loading = document.getElementById('loading-state');\n            const empty = document.getElementById('empty-state');\n\n            loading.style.display = 'none';\n            empty.style.display = 'none';\n\n            let html = `<table>\n                <thead>\n                    <tr>\n                        <th>Tipo</th>\n                        <th>Nombre</th>\n                        <th>Apellido</th>\n                        <th>Correo</th>\n                        <th class=\"hide-mobile\">Empresa / Medio</th>\n                        <th class=\"hide-mobile\">Cargo / Temática</th>\n                        <th>Fecha</th>\n                        <th></th>\n                    </tr>\n                </thead>\n                <tbody>`;\n\n            data.forEach(item => {\n                const fecha = new Date(item.createdAt).toLocaleDateString('es-AR', {\n                    day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit'\n                });\n                const tipoClass = item.tipo === 'conex' ? 'conex' : 'prensa';\n                const tipoLabel = item.tipo === 'conex' ? 'Comex' : 'Prensa';\n                const empresaMedio = item.tipo === 'conex' ? (item.empresa || '-') : (item.medio || '-');\n                const cargoTematica = item.tipo === 'conex' ? (item.cargo || '-') : (item.tematica || '-');\n\n                html += `<tr>\n                    <td><span class=\"tipo-badge ${tipoClass}\">${tipoLabel}</span></td>\n                    <td>${escHTML(item.nombre)}</td>\n                    <td>${escHTML(item.apellido)}</td>\n                    <td>${escHTML(item.correo)}</td>\n                    <td class=\"hide-mobile desc-cell\" title=\"${escHTML(empresaMedio)}\">${escHTML(empresaMedio)}</td>\n                    <td class=\"hide-mobile desc-cell\" title=\"${escHTML(cargoTematica)}\">${escHTML(cargoTematica)}</td>\n                    <td class=\"date-col\">${fecha}</td>\n                    <td><button class=\"delete-btn\" onclick=\"eliminar('${item.id}')\" title=\"Eliminar\">✕</button></td>\n                </tr>`;\n            });\n\n            html += `</tbody></table>`;\n\n            // Remove old table, keep loading/empty\n            const oldTable = container.querySelector('table');\n            if (oldTable) oldTable.remove();\n\n            container.insertAdjacentHTML('beforeend', html);\n        }\n\n        function actualizarStats(data) {\n            document.getElementById('total-count').textContent = data.length;\n            document.getElementById('conex-count').textContent = data.filter(d => d.tipo === 'conex').length;\n            document.getElementById('prensa-count').textContent = data.filter(d => d.tipo === 'prensa').length;\n        }\n\n        function filtrar(tipo) {\n            filtroActual = tipo;\n            document.querySelectorAll('.filter-btn').forEach(btn => {\n                btn.classList.toggle('active', btn.dataset.filter === tipo);\n            });\n\n            if (tipo === 'todas') {\n                renderizarTabla(todosLosDatos);\n            } else {\n                renderizarTabla(todosLosDatos.filter(d => d.tipo === tipo));\n            }\n        }\n\n        async function eliminar(id) {\n            if (!confirm('¿Eliminar este registro?')) return;\n\n            try {\n                const res = await fetch('/api/reuniones/' + id, { method: 'DELETE' });\n                const result = await res.json();\n                if (result.ok) {\n                    cargarDatos();\n                } else {\n                    alert('Error al eliminar');\n                }\n            } catch (err) {\n                alert('Error de conexión');\n            }\n        }\n\n        function exportarCSV() {\n            if (todosLosDatos.length === 0) {\n                alert('No hay datos para exportar');\n                return;\n            }\n\n            let csv = 'Tipo,Nombre,Apellido,Correo,Empresa,Medio,Cargo,Motivo,Tematica,Fecha\\n';\n            todosLosDatos.forEach(item => {\n                const row = [\n                    item.tipo === 'conex' ? 'Comex' : 'Prensa',\n                    item.nombre,\n                    item.apellido,\n                    item.correo,\n                    item.empresa || '',\n                    item.medio || '',\n                    item.cargo || '',\n                    (item.motivo || '').replace(/,/g, ';'),\n                    (item.tematica || '').replace(/,/g, ';'),\n                    new Date(item.createdAt).toLocaleString('es-AR')\n                ];\n                csv += row.join(',') + '\\n';\n            });\n\n            const blob = new Blob(['\\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });\n            const link = document.createElement('a');\n            link.href = URL.createObjectURL(blob);\n            link.download = 'formularios_caminosysabores_' + new Date().toISOString().slice(0,10) + '.csv';\n            link.click();\n            URL.revokeObjectURL(link.href);\n        }\n\n        function escHTML(str) {\n            const div = document.createElement('div');\n            div.textContent = str;\n            return div.innerHTML;\n        }\n\n        // Auto-refresh each 30 seconds\n        document.addEventListener('DOMContentLoaded', () => {\n            cargarDatos();\n            setInterval(cargarDatos, 30000);\n        });\n    </script>\n</body>\n</html>\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/public/conex.html",
          "name": "conex.html",
          "content": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>San Juan a la mesa - Formulario Comex</title>\n    <link rel=\"stylesheet\" href=\"css/style.css\">\n    <link rel=\"stylesheet\" href=\"css/sorteo.css\">\n    <style>\n        body {\n            font-family: 'Ubuntu', sans-serif;\n            margin: 0;\n            padding: 0;\n            background: #f5f0eb;\n            min-height: 100vh;\n        }\n\n        .form-page {\n            max-width: 500px;\n            margin: 0 auto;\n        }\n\n        .form-hero {\n            background: linear-gradient(135deg, #5A2828, #E6643C);\n            padding: 50px 30px 60px;\n            text-align: left;\n            color: white;\n        }\n\n        .form-hero .produccion-etiqueta {\n            color: #F0E6DC;\n            margin-bottom: 10px;\n        }\n\n        .form-hero h1 {\n            font-size: 2.8rem;\n            font-weight: bold;\n            line-height: 1.1;\n            margin: 0;\n        }\n\n        .form-hero .back-link {\n            display: inline-flex;\n            align-items: center;\n            gap: 8px;\n            color: rgba(255,255,255,0.8);\n            text-decoration: none;\n            font-size: 0.9rem;\n            margin-bottom: 20px;\n            transition: color 0.3s;\n        }\n\n        .form-hero .back-link:hover {\n            color: white;\n        }\n\n        .form-content {\n            padding: 30px 25px 50px;\n            margin-top: -20px;\n        }\n\n        .form-card {\n            background: white;\n            border-radius: 20px;\n            padding: 30px 25px;\n            box-shadow: 0 4px 20px rgba(0,0,0,0.06);\n        }\n\n        .form-card h2 {\n            font-size: 1.5rem;\n            font-weight: bold;\n            margin: 0 0 5px;\n        }\n\n        .form-card .form-subtitle {\n            font-size: 0.9rem;\n            color: #888;\n            margin: 0 0 25px;\n        }\n\n        .form-group {\n            margin-bottom: 15px;\n        }\n\n        .form-group input,\n        .form-group textarea {\n            width: 100%;\n            padding: 14px 16px;\n            border: 1px solid #ddd;\n            border-radius: 21px;\n            font-family: 'Ubuntu', sans-serif;\n            font-size: 15px;\n            box-sizing: border-box;\n            transition: border-color 0.3s;\n            background: #fafafa;\n        }\n\n        .form-group input:focus,\n        .form-group textarea:focus {\n            outline: none;\n            border-color: #E6643C;\n            background: white;\n        }\n\n        .form-group textarea {\n            min-height: 80px;\n            resize: vertical;\n            border-radius: 15px;\n        }\n\n        .form-group input::placeholder,\n        .form-group textarea::placeholder {\n            color: #aaa;\n        }\n\n        .form-row {\n            display: flex;\n            gap: 10px;\n            margin-bottom: 0;\n        }\n\n        .form-row .form-group {\n            flex: 1;\n        }\n\n        .submit-btn {\n            width: 100%;\n            padding: 16px;\n            background: #E6643C;\n            color: white;\n            border: none;\n            border-radius: 25px;\n            font-family: 'Ubuntu', sans-serif;\n            font-size: 1.3rem;\n            font-weight: bold;\n            cursor: pointer;\n            transition: all 0.3s;\n            margin-top: 5px;\n        }\n\n        .submit-btn:hover {\n            background: #D45336;\n            transform: translateY(-1px);\n        }\n\n        .submit-btn:active {\n            transform: translateY(0);\n        }\n\n        .submit-btn:disabled {\n            opacity: 0.6;\n            cursor: not-allowed;\n            transform: none;\n        }\n\n        .success-message {\n            display: none;\n            text-align: center;\n            padding: 40px 20px;\n        }\n\n        .success-message.show {\n            display: block;\n        }\n\n        .success-message .check-icon {\n            width: 70px;\n            height: 70px;\n            background: #4CAF50;\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin: 0 auto 20px;\n            font-size: 2rem;\n            color: white;\n        }\n\n        .success-message h3 {\n            font-size: 1.6rem;\n            font-weight: bold;\n            margin: 0 0 10px;\n            color: #333;\n        }\n\n        .success-message p {\n            font-size: 0.95rem;\n            color: #888;\n            margin: 0 0 25px;\n            line-height: 1.4;\n        }\n\n        .success-message .back-btn {\n            display: inline-block;\n            padding: 12px 35px;\n            background: #E6643C;\n            color: white;\n            border: none;\n            border-radius: 25px;\n            font-family: 'Ubuntu', sans-serif;\n            font-size: 1rem;\n            font-weight: bold;\n            text-decoration: none;\n            cursor: pointer;\n        }\n\n        .error-msg {\n            color: #D45336;\n            font-size: 0.85rem;\n            text-align: center;\n            margin-top: 10px;\n            display: none;\n        }\n\n        .error-msg.show {\n            display: block;\n        }\n\n        @media (max-width: 500px) {\n            .form-hero { padding: 35px 20px 50px; }\n            .form-hero h1 { font-size: 2rem; }\n            .form-content { padding: 25px 18px 40px; }\n            .form-card { padding: 22px 18px; }\n            .form-row { flex-direction: column; gap: 0; }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"form-page\">\n        <div class=\"form-hero\">\n            <a href=\"reuniones.html\" class=\"back-link\">← Volver</a>\n            <span class=\"produccion-etiqueta\">PRODUCCIONES</span>\n            <h1>Reuniones<br>Comex</h1>\n        </div>\n\n        <div class=\"form-content\">\n            <div class=\"form-card\" id=\"form-card\">\n                <h2>Formulario de reserva</h2>\n                <p class=\"form-subtitle\">Completá tus datos y te contactamos</p>\n\n                <form id=\"form-conex\" onsubmit=\"return enviarFormulario(event)\">\n                    <div class=\"form-row\">\n                        <div class=\"form-group\">\n                            <input type=\"text\" id=\"nombre\" placeholder=\"Nombre\" required>\n                        </div>\n                        <div class=\"form-group\">\n                            <input type=\"text\" id=\"apellido\" placeholder=\"Apellido\" required>\n                        </div>\n                    </div>\n                    <div class=\"form-group\">\n                        <input type=\"email\" id=\"correo\" placeholder=\"Correo electrónico\" required>\n                    </div>\n                    <div class=\"form-group\">\n                        <input type=\"text\" id=\"empresa\" placeholder=\"Empresa\" required>\n                    </div>\n                    <div class=\"form-group\">\n                        <input type=\"text\" id=\"cargo\" placeholder=\"Cargo / Rol\" required>\n                    </div>\n                    <div class=\"form-group\">\n                        <textarea id=\"motivo\" placeholder=\"Motivo de la reunión\" required></textarea>\n                    </div>\n                    <div class=\"error-msg\" id=\"error-msg\">Error al enviar el formulario. Intentalo de nuevo.</div>\n                    <button type=\"submit\" class=\"submit-btn\" id=\"submit-btn\">Enviar</button>\n                </form>\n            </div>\n\n            <div class=\"success-message\" id=\"success-msg\">\n                <div class=\"check-icon\">✓</div>\n                <h3>¡Formulario enviado!</h3>\n                <p>Tu solicitud de reunión fue recibida correctamente. Nos pondremos en contacto a la brevedad.</p>\n                <a href=\"reuniones.html\" class=\"back-btn\">Volver</a>\n            </div>\n        </div>\n    </div>\n\n    <script src=\"js/header.js\"></script>\n    <script src=\"js/footer.js\"></script>\n    <script src=\"js/touch.js\"></script>\n    <script>\n        async function enviarFormulario(event) {\n            event.preventDefault();\n            const btn = document.getElementById('submit-btn');\n            const errorEl = document.getElementById('error-msg');\n            \n            btn.disabled = true;\n            btn.textContent = 'Enviando...';\n            errorEl.classList.remove('show');\n\n            const data = {\n                tipo: 'conex',\n                nombre: document.getElementById('nombre').value.trim(),\n                apellido: document.getElementById('apellido').value.trim(),\n                correo: document.getElementById('correo').value.trim(),\n                empresa: document.getElementById('empresa').value.trim(),\n                cargo: document.getElementById('cargo').value.trim(),\n                motivo: document.getElementById('motivo').value.trim()\n            };\n\n            try {\n                const res = await fetch('/api/reuniones', {\n                    method: 'POST',\n                    headers: { 'Content-Type': 'application/json' },\n                    body: JSON.stringify(data)\n                });\n                const result = await res.json();\n                if (result.ok) {\n                    document.getElementById('form-card').style.display = 'none';\n                    document.getElementById('success-msg').classList.add('show');\n                } else {\n                    errorEl.textContent = result.error || 'Error al enviar';\n                    errorEl.classList.add('show');\n                    btn.disabled = false;\n                    btn.textContent = 'Enviar';\n                }\n            } catch (err) {\n                errorEl.textContent = 'Error de conexión. Verificá que el servidor esté funcionando.';\n                errorEl.classList.add('show');\n                btn.disabled = false;\n                btn.textContent = 'Enviar';\n            }\n        }\n    </script>\n</body>\n</html>\n"
        },
