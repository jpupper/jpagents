 ''}> seguir el pad XY</label>\r\n    <label class=\"gprow\">P1 velocidad<input type=\"range\" id=\"gpp1\" min=\"0\" max=\"1\" step=\"0.01\" value=\"${gp.p1 ?? .5}\"></label>\r\n    <label class=\"gprow\">P2 tono<input type=\"range\" id=\"gpp2\" min=\"0\" max=\"1\" step=\"0.01\" value=\"${gp.p2 ?? .5}\"></label>`;\r\n  genpop.style.display = 'block';\r\n  genpop.style.left = Math.min(x, innerWidth - 250) + 'px';\r\n  genpop.style.top = Math.min(y, innerHeight - 170) + 'px';\r\n  const upd = () => {\r\n    const sigue = $('#gpxy').checked;\r\n    $('#gpp1').disabled = sigue; $('#gpp2').disabled = sigue;\r\n  };\r\n  $('#gpxy').onchange = e => { gp.xy = e.target.checked; cell._pv = false; upd(); markDirty(); };\r\n  $('#gpp1').oninput = e => { gp.p1 = +e.target.value; cell._pv = false; markDirty(); };\r\n  $('#gpp2').oninput = e => { gp.p2 = +e.target.value; cell._pv = false; markDirty(); };\r\n  $('#gpx').onclick = () => genpop.style.display = 'none';\r\n  upd();\r\n  setPreview(cell); // lo ves en vivo en el monitor PREVIA\r\n}\r\n\r\n/* ---------------- constructor de generadores por bloques ---------------- */\r\nconst genwin = el('div'); genwin.id = 'genwin';\r\ngenwin.innerHTML = `\r\n  <div id=\"genwinbar\"><b>🧪 CREAR GENERADOR</b><span>vista en vivo en el monitor PREVIA ↘</span>\r\n    <button class=\"mini\" id=\"genwinclose\">✕</button></div>\r\n  <div id=\"genrows\"></div>`;\r\ndocument.body.appendChild(genwin);\r\n$('#genwinclose').onclick = () => genwin.classList.remove('open');\r\n{ // arrastrable por la barra\r\n  const bar = $('#genwinbar');\r\n  bar.addEventListener('pointerdown', e => {\r\n    if (e.target.tagName === 'BUTTON') return;\r\n    bar.setPointerCapture(e.pointerId);\r\n    const r = genwin.getBoundingClientRect();\r\n    const ox = e.clientX - r.left, oy = e.clientY - r.top;\r\n    const mv = ev => {\r\n      genwin.style.left = Math.max(0, Math.min(innerWidth - 140, ev.clientX - ox)) + 'px';\r\n      genwin.style.top = Math.max(0, Math.min(innerHeight - 60, ev.clientY - oy)) + 'px';\r\n    };\r\n    bar.onpointermove = mv;\r\n    bar.onpointerup = () => bar.onpointermove = null;\r\n  });\r\n}\r\nlet genEditIdx = -1; // -1 = nuevo; >=0 edita un custom existente\r\nfunction bumpGenLive() {\r\n  const old = 'cgenlive_v' + (genKey._lv || 0);\r\n  genKey._lv = (genKey._lv || 0) + 1;\r\n  prev.progs.delete(old); main.progs.delete(old);\r\n}\r\nfunction openGenBuilder(cfg, editIdx) {\r\n  genEditIdx = editIdx === undefined ? -1 : editIdx;\r\n  genLiveCfg = Object.assign(\r\n    { name: 'Mi generador', base: 'plasma', det: .5, warp: 'none', wAmt: .5, color: 'ciclo', hue: 0, react: 'bass', rAmt: .6 },\r\n    cfg ? JSON.parse(JSON.stringify(cfg)) : {});\r\n  const rows = $('#genrows');\r\n  const sel = (id, opts) => `<select id=\"${id}\">${opts.map(o =>\r\n    `<option value=\"${o[0]}\"${genLiveCfg[id.slice(2)] === o[0] ? ' selected' : ''}>${o[1]}</option>`).join('')}</select>`;\r\n  const rng = (id, v) => `<input type=\"range\" id=\"${id}\" min=\"0\" max=\"1\" step=\"0.01\" value=\"${v}\">`;\r\n  rows.innerHTML = `\r\n    <div class=\"genrow\"><input type=\"text\" id=\"ggname\" value=\"${genLiveCfg.name}\" maxlength=\"18\"></div>\r\n    <div class=\"genrow\"><b>BASE</b>${sel('ggbase', [['plasma', 'Plasma'], ['anillos', 'Anillos'], ['rayas', 'Rayas'], ['ruido', 'Ruido/humo'], ['voronoi', 'Voronoi'], ['tunel', 'Túnel']])}${rng('ggdet', genLiveCfg.det)}</div>\r\n    <div class=\"genrow\"><b>DEFORMACIÓN</b>${sel('ggwarp', [['none', 'Ninguna'], ['kaleido', 'Kaleido'], ['espejo', 'Espejo'], ['giro', 'Giro'], ['onda', 'Onda'], ['zoombeat', 'Zoom al beat']])}${rng('ggwAmt', genLiveCfg.wAmt)}</div>\r\n    <div class=\"genrow\"><b>COLOR</b>${sel('ggcolor', [['ciclo', 'Ciclo arcoíris'], ['duotono', 'Duotono'], ['fuego', 'Fuego 🔥'], ['uv', 'UV neón']])}${rng('gghue', genLiveCfg.hue)}</div>\r\n    <div class=\"genrow\"><b>REACCIÓN</b>${sel('ggreact', [['none', 'Ninguna'], ['bass', 'Late con el bajo'], ['beat', 'Golpea co