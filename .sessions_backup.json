          "name": "turismo-detalle.css",
          "content": "body {\r\n  background-color: white;\r\n  background-image: none;\r\n}\r\n\r\n.tourism-detail-hero {\r\n  position: relative;\r\n  min-height: 58vh;\r\n  margin-top: -20px;\r\n  padding-top: 20px;\r\n  align-items: flex-end;\r\n  overflow: hidden;\r\n  isolation: isolate;\r\n}\r\n\r\n.tourism-detail-hero .background-image {\r\n  z-index: 0;\r\n}\r\n\r\n.tourism-detail-hero::after {\r\n  content: \"\";\r\n  position: absolute;\r\n  inset: 0;\r\n  z-index: 1;\r\n  background: linear-gradient(180deg, rgba(0, 0, 0, 0.06) 18%, rgba(0, 0, 0, 0.18) 48%, rgba(0, 0, 0, 0.52) 100%);\r\n  pointer-events: none;\r\n}\r\n\r\n.tourism-detail-content {\r\n  margin-left: 12px;\r\n  margin-bottom: 18px;\r\n  z-index: 2;\r\n}\r\n\r\n.tourism-detail-content .tagline {\r\n  font-size: 1.8rem;\r\n  line-height: 1.04;\r\n  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.34), 0 1px 2px rgba(0, 0, 0, 0.24);\r\n}\r\n\r\n.tourism-detail-copy {\r\n  margin: 18px 10px 0;\r\n  padding: 0;\r\n}\r\n\r\n.tourism-detail-copy p {\r\n  margin: 0 0 18px;\r\n  color: #333;\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 15px;\r\n  font-weight: 300;\r\n  line-height: 1.15;\r\n}\r\n\r\n.tourism-detail-copy p:first-child {\r\n  font-size: 15px !important;\r\n  line-height: 1.15;\r\n  margin-bottom: 18px;\r\n}\r\n\r\n.tourism-destination-section {\r\n  margin: 0 0 22px;\r\n}\r\n\r\n.tourism-destination-title {\r\n  margin: 0 20px 12px;\r\n  color: #181818;\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 1.05rem;\r\n  font-weight: 700;\r\n  line-height: 1.1;\r\n}\r\n\r\n.tourism-destination-title a {\r\n  color: inherit;\r\n  text-decoration: none;\r\n}\r\n\r\n.tourism-carousel-container {\r\n  padding: 0 10px;\r\n}\r\n\r\n.tourism-carousel {\r\n  display: flex;\r\n  gap: 14px;\r\n  overflow-x: auto;\r\n  cursor: grab;\r\n  user-select: none;\r\n  scroll-snap-type: x proximity;\r\n  -ms-overflow-style: none;\r\n  scrollbar-width: none;\r\n}\r\n\r\n.tourism-carousel.active {\r\n  cursor: grabbing;\r\n}\r\n\r\n.tourism-carousel::-webkit-scrollbar {\r\n  display: none;\r\n}\r\n\r\n.carousel-item.tourism-carousel-item {\r\n  min-width: 78%;\r\n  max-width: 78%;\r\n  margin: 0;\r\n  border-radius: 16px;\r\n  overflow: hidden;\r\n  flex-shrink: 0;\r\n  scroll-snap-align: start;\r\n}\r\n\r\n.carousel-item.tourism-carousel-item img {\r\n  display: block;\r\n  width: 100%;\r\n  height: auto;\r\n  border-radius: 16px;\r\n}\r\n"
