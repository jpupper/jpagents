x;color:var(--dim)\">colores: <b style=\"color:#2fd8ff\">espacio</b> ·\r\n      <b style=\"color:#ffb03f\">número</b> · <b style=\"color:#ff3fd4\">color</b> · vista en PREVIA ↘</span>\r\n  </div>\r\n  <div id=\"nodestage\"><svg id=\"nodesvg\"></svg></div>`;\r\ndocument.body.appendChild(nodewin);\r\n$('#nodeclose').onclick = () => nodewin.classList.remove('open');\r\n{\r\n  const bar = $('#nodebar');\r\n  bar.addEventListener('pointerdown', e => {\r\n    if (e.target.tagName === 'BUTTON') return;\r\n    const r = nodewin.getBoundingClientRect();\r\n    const ox = e.clientX - r.left, oy = e.clientY - r.top;\r\n    const mv = ev => {\r\n      nodewin.style.left = Math.max(0, Math.min(innerWidth - 160, ev.clientX - ox)) + 'px';\r\n      nodewin.style.top = Math.max(0, Math.min(innerHeight - 60, ev.clientY - oy)) + 'px';\r\n    };\r\n    const up = () => { removeEventListener('pointermove', mv); removeEventListener('pointerup', up); };\r\n    addEventListener('pointermove', mv);\r\n    addEventListener('pointerup', up);\r\n  });\r\n}\r\n{\r\n  const grouped = {};\r\n  Object.entries(NODE_DEFS).forEach(([k, d]) => {\r\n    if (k === 'salida') return;\r\n    (grouped[d.cat] = grouped[d.cat] || []).push([k, d]);\r\n  });\r\n  const sel = $('#ndadd');\r\n  Object.entries(grouped).forEach(([cat, arr]) => {\r\n    const og = el('optgroup'); og.label = cat;\r\n    arr.forEach(([k, d]) => { const o = el('option'); o.value = k; o.textContent = d.name; og.appendChild(o); });\r\n    sel.appendChild(og);\r\n  });\r\n  sel.onchange = () => {\r\n    if (!sel.value || !genLiveCfg) return;\r\n    genLiveCfg.nodes.push({\r\n      id: ++genLiveCfg._nid, kind: sel.value,\r\n      x: 260 + Math.random() * 140, y: 130 + Math.random() * 120, p: {},\r\n    });\r\n    sel.value = '';\r\n    nodeRebuild();\r\n  };\r\n}\r\nlet nodeEditIdx = -1, ndDrag = null;\r\nfunction defaultGraph() {\r\n  return {\r\n    type: 'nodes', name: 'Mi patch', _nid: 8, _v: 0,\r\n    nodes: [\r\n      { id: 1, kind: 'uv', x: 12, y: 60, p: {} },\r\n      { id: 2, kind: 'kaleido', x: 178, y: 45, p: { segs: .5 } },\r\n      { id: 3, kind: 'anillos', x: 350, y: 60, p: { frec: .5 } },\r\n      { id: 4, kind: 'rampa', x: 520, y: 40, p: { tono: 0, sat: .85 } },\r\n      { id: 6, kind: 'bass', x: 290, y: 270, p: {} },\r\n      { id: 7, kind: 'brillo', x: 520, y: 220, p: {} },\r\n      { id: 5, kind: 'salida', x: 640, y: 350, p: {} },\r\n    ],\r\n    links: [\r\n      { from: [1, 0], to: [2, 0] }, { from: [2, 0], to: [3, 0] },\r\n      { from: [3, 0], to: [4, 0] }, { from: [4, 0], to: [7, 0] },\r\n      { from: [6, 0], to: [7, 1] }, { from: [7, 0], to: [5, 0] },\r\n    ],\r\n  };\r\n}\r\nfunction openNodeEditor(cfg, editIdx) {\r\n  nodeEditIdx = editIdx === undefined ? -1 : editIdx;\r\n  genLiveCfg = cfg ? JSON.parse(JSON.stringify(cfg)) : defaultGraph();\r\n  genLiveCfg._nid = genLiveCfg._nid || Math.max(0, ...genLiveCfg.nodes.map(n => n.id));\r\n  $('#ndname').value = genLiveCfg.name || 'Mi patch';\r\n  nodewin.classList.add('open');\r\n  nodeRebuild();\r\n  setPreview({ kind: 'gen', presetIdx: -2, l: -1, c: -1, name: genLiveCfg.name });\r\n}\r\n$('#ndname').oninput = e => { if (genLiveCfg) genLiveCfg.name = e.target.value; };\r\n$('#ndsave').onclick = () => {\r\n  if (!genLiveCfg) return;\r\n  const cfg = JSON.parse(JSON.stringify(genLiveCfg));\r\n  cfg.name = (cfg.name || 'patch').trim().slice(0, 18) || 'patch';\r\n  if (nodeEditIdx >= 0) {\r\n    cfg._v = (state.customGens[nodeEditIdx]._v || 0) + 1;\r\n    state.customGens[nodeEditIdx] = cfg;\r\n  } else {\r\n    cfg._v = 0;\r\n    state.customGens.push(cfg);\r\n  }\r\n  buildShelf(); markDirty();\r\n  toast('🕸 \"' + cfg.name + '\" en el estante');\r\n  nodewin.classList.remove('open');\r\n};\r\nfunction ndChanged() { bumpGenLive(); drawCables(); }\r\nfunction nodeRebuild() {\r\n  const stage = $('#nodestage');\r\n  stage.querySelectorAll('.node').forEach(n => n.remove());\r\n  for (const n of genLiveCfg.nodes) {\r\n    const def = NODE_DEFS[n.kind]; if (!def) continue;\r\n    const d = el('div', 'node');\r\n    d.dataset.nid = n.id;\r\n    d.style.left = n.x + 'px'; d.style.top = n.y + 'px';\r\n    const hd = el('header'); hd.textContent = def.name;\r\n    d.appendChild(hd);\r\n    hd.addEventListener('pointerdown', e => {\r\n      e.stopPropagation();\r\n      const sx = e.clientX - n.x, sy = e.clientY - n.y;\r\n      const mv = ev => {\r\n        const st2 = document.getElementById('nodestage');\r\n        n.x = Math.max(0, Math.min(st2.clientWidth - 150, ev.clientX - sx));\r\n        n.y = Math.max(0, Math.min(st2.clientHeight - 50, ev.clientY - sy));\r\n        d.style.left = n.x + 'px'; d.style.top = n.y + 'px';\r\n        drawCables();\r\n      };\r\n      const up = () => { removeEventListener('pointermove', mv); removeEventListener('pointerup', up); };\r\n      addEventListener('pointermove', mv);\r\n      addEventListener('pointerup', up);\r\n    });\r\n    hd.oncontextmenu = e => {\r\n      e.preventDefault(); e.stopPropagation();\r\n      if (n.kind === 'salida') return;\r\n      showMenu(e.clientX, e.clientY, def.name, [{\r\n        label: '🧹 Eliminar nodo', fn: () => {\r\n          genLiveCfg.nodes = genLiveCfg.nodes.filter(x => x !== n);\r\n          genLiveCfg.links = genLiveCfg.links.filter(L => L.from[0] !== n.id && L.to[0] !== n.id);\r\n          nodeRebuild();\r\n        }\r\n      }]);\r\n    };\r\n    if (n.kind === 'salida') d.classList.add('nsalida');\r\n    const TYPE_NAME = { f: 'número', v2: 'espacio', c: 'color' };\r\n    const rows = Math.max(def.ins.length, def.outs.length);\r\n    for (let r = 0; r < rows; r++) {\r\n      const row = el('div', 'nrow');\r\n      if (def.ins[r]) {\r\n        const li = el('span', 'plbl-in');\r\n        li.textContent = '◂ ' + TYPE_NAME[def.ins[r]];\r\n        li.style.color = NTYPE_COL[def.ins[r]];\r\n        row.appendChild(li);\r\n        const pin = el('div', 'nport pin');\r\n        pin.style.background = NTYPE_COL[def.ins[r]];\r\n        pin.style.color = NTYPE_COL[def.ins[r]];\r\n        pin.dataset.nid = n.id; pin.dataset.pi = r; pin.dataset.ty = def.ins[r];\r\n        row.appendChild(pin);\r\n      }\r\n      if (def.outs[r]) {\r\n        const lo = el('span', 'plbl-out');\r\n        lo.textContent = TYPE_NAME[def.outs[r]] + ' ▸';\r\n        lo.style.color = NTYPE_COL[def.outs[r]];\r\n        row.appendChild(lo);\r\n        const po = el('div', 'nport pout');\r\n        po.style.background = NTYPE_COL[def.outs[r]];\r\n        po.style.color = NTYPE_COL[def.outs[r]];\r\n        po.dataset.ty = def.outs[r];\r\n        row.appendChild(po);\r\n        po.addEventListener('pointerdown', e => {\r\n          e.stopPropagation(); e.preventDefault();\r\n          ndDrag = { from: [n.id, r], ty: def.outs[r] };\r\n          const mv = ev => drawCables([ev.clientX, ev.clientY]);\r\n          const up = ev => {\r\n            removeEventListener('pointermove', mv);\r\n            removeEventListener('pointerup', up);\r\n            const t2 = document.elementFromPoint(ev.clientX, ev.clientY);\r\n            if (t2 && t2.classList.contains('pin') && t2.dataset.ty === ndDrag.ty) {\r\n              const key = t2.dataset.nid + ':' + t2.dataset.pi;\r\n              genLiveCfg.links = genLiveCfg.links.filter(L => L.to[0] + ':' + L.to[1] !== key);\r\n              genLiveCfg.links.push({ from: ndDrag.from, to: [+t2.dataset.nid, +t2.dataset.pi] });\r\n              ndChanged();\r\n            }\r\n            ndDrag = null;\r\n            drawCables();\r\n          };\r\n          addEventListener('pointermove', mv);\r\n          addEventListener('pointerup', up);\r\n        });\r\n      }\r\n      d.appendChild(row);\r\n    }\r\n    for (const pd of def.params || []) {\r\n      const pr = el('div', 'nprm');\r\n      const lb = el('span'); lb.textContent = pd.k;\r\n      const sl = el('input'); sl.type = 'range'; sl.min = 0; sl.max = 1; sl.step = .01;\r\n      sl.value = n.p[pd.k] != null ? n.p[pd.k] : pd.d;\r\n      sl.oninput = () => { n.p[pd.k] = +sl.value; ndChanged(); };\r\n      pr.append(lb, sl);\r\n      d.appendChild(pr);\r\n    }\r\n    stage.appendChild(d);\r\n  }\r\n  ndChanged();\r\n}\r\nfunction portPos(nid, idx, isOut) {\r\n  const nd = document.querySelector(`.node[data-nid=\"${nid}\"]`);\r\n  const stage = $('#nodestage');\r\n  if (!nd) return [0, 0];\r\n  const ports = nd.querySelectorAll(isOut ? '.pout' : '.pin');\r\n  const p = ports[idx];\r\n  if (!p) return [0, 0];\r\n  const pr = p.getBoundingClientRect(), sr = stage.getBoundingClientRect();\r\n  return [pr.left - sr.left + pr.width / 2, pr.top - sr.top + pr.height / 2];\r\n}\r\nfunction drawCables(tempEnd) {\r\n  const svg = $('#nodesvg');\r\n  if (!genLiveCfg || !nodewin.classList.contains('open')) return;\r\n  let html = '';\r\n  const cable = (a, b, col, idx) => {\r\n    const dx = Math.max(40, Math.abs(b[0] - a[0]) * .5);\r\n    const dpath = `M${a[0]},${a[1]} C${a[0] + dx},${a[1]} ${b[0] - dx},${b[1]} ${b[0]},${b[1]}`;\r\n    return `<path d=\"${dpath}\" stroke=\"${col}\" stroke-width=\"7\" fill=\"none\" opacity=\".18\"/>` +\r\n      `<path d=\"${dpath}\" stroke=\"${col}\" stroke-width=\"2.6\" fill=\"none\" stroke-linecap=\"round\"\r\n      ${idx !== undefined ? `data-li=\"${idx}\"` : ''}/>`;\r\n  };\r\n  genLiveCfg.links.forEach((L, i) => {\r\n    const src = genLiveCfg.nodes.find(n => n.id === L.from[0]);\r\n    const ty = src && NODE_DEFS[src.kind] ? NODE_DEFS[src.kind].outs[L.from[1]] : 'f';\r\n    html += cable(portPos(L.from[0], L.from[1], true), portPos(L.to[0], L.to[1], false), NTYPE_COL[ty] || '#fff', i);\r\n  });\r\n  if (ndDrag && tempEnd) {\r\n    const sr = $('#nodestage').getBoundingClientRect();\r\n    html += cable(portPos(ndDrag.from[0], ndDrag.from[1], true),\r\n      [tempEnd[0] - sr.left, tempEnd[1] - sr.top], NTYPE_COL[ndDrag.ty], undefined);\r\n  }\r\n  svg.innerHTML = html;\r\n  svg.querySelectorAll('path[data-li]').forEach(pth => {\r\n    pth.onclick = () => {\r\n      genLiveCfg.links.splice(+pth.dataset.li, 1);\r\n      ndChanged();\r\n    };\r\n  });\r\n}\r\n\r\n/* ---------------- editor GLSL / Shadertoy ---------------- */\r\nconst glslwin = el('div'); glslwin.id = 'glslwin';\r\nglslwin.innerHTML = `\r\n  <div id=\"glslbar\"><b>📜 GLSL / SHADERTOY</b>\r\n    <span>pegá el código de shadertoy.com (mainImage) o un .frag</span>\r\n    <button class=\"mini\" id=\"glslclose\">✕</button></div>\r\n  <div id=\"glslbody\">\r\n    <div style=\"display:flex;gap:6px;margin-bottom:6px\">\r\n      <input type=\"text\" id=\"glname\" placeholder=\"nombre\" maxlength=\"18\" style=\"flex:1\">\r\n      <select id=\"glex\"><option value=\"\">ejemplos…</option>\r\n        <option value=\"arcoiris\">arcoíris (default Shadertoy)</option>\r\n        <option value=\"tunel3d\">túnel 3D raymarch</option>\r\n        <option value=\"plasma\">plasma audio-reactivo</option></select>\r\n      <button class=\"mini\" id=\"glload\">📂 .frag</button>\r\n      <button class=\"mini\" id=\"gltest\">▶ PROBAR</button>\r\n      <button class=\"mini on\" id=\"glsave\">💾 GUARDAR</button>\r\n    </div>\r\n    <textarea id=\"glcode\" spellcheck=\"false\" placeholder=\"void mainImage( out vec4 fragColor, in vec2 fragCoord ) {&#10;  vec2 uv = fragCoord/iResolution.xy;&#10;  fragColor = vec4(0.5+0.5*cos(iTime+uv.xyx+vec3(0,2,4)), 1.0);&#10;}&#10;&#10;// tenés: iTime iResolution iMouse (=pad XY) · y nuestros: u_bass u_mid u_high u_beat u_fft[16]\"></textarea>\r\n    <pre id=\"glerr\"></pre>\r\n  </div>`;\r\ndocument.body.appendChild(glslwin);\r\n$('#glslclose').onclick = () => glslwin.classList.remove('open');\r\n{\r\n  const bar = $('#glslbar');\r\n  bar.addEventListener('pointerdown', e => {\r\n    if (e.target.tagName === 'BUTTON') return;\r\n    const r = glslwin.getBoundingClientRect();\r\n    const ox = e.clientX - r.left, oy = e.clientY - r.top;\r\n    const mv = ev => {\r\n      glslwin.style.left = Math.max(0, Math.min(innerWidth - 140, ev.clientX - ox)) + 'px';\r\n      glslwin.style.top = Math.max(0, Math.min(innerHeight - 60, ev.clientY - oy)) + 'px';\r\n    };\r\n    const up = () => { removeEventListener('pointermove', mv); removeEventListener('pointerup', up); };\r\n    addEventListener('pointermove', mv);\r\n    addEventListener('pointerup', up);\r\n  });\r\n}\r\nlet glslEditIdx = -1;\r\nfunction tryCompileGen(fullSrc) {\r\n  const gl = prev.gl;\r\n  const sh = gl.createShader(gl.FRAGMENT_SHADER);\r\n  gl.shaderSource(sh, fullSrc);\r\n  gl.compileShader(sh);\r\n  const ok = gl.getShaderParameter(sh, gl.COMPILE_STATUS);\r\n  const log = ok ? null : gl.getShaderInfoLog(sh);\r\n  gl.deleteShader(sh);\r\n  return log;\r\n}\r\nfunction glslTest() {\r\n  const code = $('#glcode').value;\r\n  const err = tryCompileGen(GEN_PRE_RAW + wrapGLSL(code));\r\n  const box = $('#glerr');\r\n  if (err) {\r\n    box.textContent = '✗ ' + err.trim();\r\n    box.style.display = 'block';\r\n    return false;\r\n  }\r\n  box.style.display = 'none';\r\n  genLiveCfg = { type: 'glsl', code, name: $('#glname').value || 'GLSL' };\r\n  bumpGenLive();\r\n  setPreview({ kind: 'gen', presetIdx: -2, l: -1, c: -1, name: genLiveCfg.name });\r\n  toast('✓ Compila — miralo en el monitor PREVIA');\r\n  return true;\r\n}\r\nfunction openGlslEditor(cg, editIdx) {\r\n  glslEditIdx = editIdx === undefined ? -1 : editIdx;\r\n  $('#glname').value = cg ? cg.name : '';\r\n  $('#glcode').value = cg ? cg.code : '';\r\n  $('#glerr').style.display = 'none';\r\n  glslwin.classList.add('open');\r\n  if (cg) glslTest();\r\n}\r\n$('#gltest').onclick = glslTest;\r\n$('#glsave').onclick = () => {\r\n  if (!glslTest()) { toast('Arreglá el error del shader antes de guardar'); return; }\r\n  const cfg = {\r\n    type: 'glsl',\r\n    name: ($('#glname').value || 'GLSL').trim().slice(0, 18) || 'GLSL',\r\n    code: $('#glcode').value,\r\n    _v: 0,\r\n  };\r\n  if (glslEditIdx >= 0) {\r\n    cfg._v = (state.customGens[glslEditIdx]._v || 0) + 1;\r\n    state.customGens[glslEditIdx] = cfg;\r\n  } else {\r\n    state.customGens.push(cfg);\r\n  }\r\n  buildShelf(); markDirty();\r\n  toast('📜 \"' + cfg.name + '\" en el estante — arrastralo a una celda');\r\n  glslwin.classList.remove('open');\r\n};\r\nconst GLSL_EXAMPLES = {\r\n  arcoiris: `void mainImage( out vec4 fragColor, in vec2 fragCoord )\r\n{\r\n    vec2 uv = fragCoord/iResolution.xy;\r\n    vec3 col = 0.5 + 0.5*cos(iTime+uv.xyx+vec3(0,2,4));\r\n    fragColor = vec4(col,1.0);\r\n}`,\r\n  tunel3d: `// túnel raymarcheado simple\r\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\r\n{\r\n    vec2 uv = (fragCoord - .5*iResolution.xy)/iResolution.y;\r\n    vec3 ro = vec3(0., 0., iTime*2.);\r\n    vec3 rd = normalize(vec3(uv, 1.));\r\n    float d = 0., glow = 0.;\r\n    for (int i = 0; i < 48; i++) {\r\n        vec3 pos = ro + rd*d;\r\n        float r = 1.2 + .3*sin(pos.z*.5) - length(pos.xy + vec2(sin(pos.z*.3), cos(pos.z*.4))*.4);\r\n        r = abs(r) + .02;\r\n        glow += .015/(r*r + .01);\r\n        d += r*.7;\r\n        if (d > 30.) break;\r\n    }\r\n    vec3 col = vec3(glow*.6, glow*.3, glow) * (0.6 + u_bass);\r\n    fragColor = vec4(col, 1.0);\r\n}`,\r\n  plasma: `// plasma que respira con tu música (u_bass / u_mid / u_high / u_beat)\r\nvoid mainImage( out vec4 fragColor, in vec2 fragCoord )\r\n{\r\n    vec2 uv = fragCoord/iResolution.xy*6.;\r\n    float t = iTime;\r\n    float v = sin(uv.x+t) + sin(uv.y+t*1.3) + sin(uv.x+uv.y+t*.7)\r\n            + sin(length(uv-3.)*(2.+u_bass*3.)-t*2.);\r\n    vec3 col = 0.5 + 0.5*cos(v + vec3(0,2,4) + iMouse.x/iResolution.x*6.28);\r\n    fragColor = vec4(col*(0.5+u_bass+u_beat*.5), 1.0);\r\n}`,\r\n};\r\n$('#glex').onchange = e => {\r\n  if (!e.target.value) return;\r\n  $('#glcode').value = GLSL_EXAMPLES[e.target.value];\r\n  if (!$('#glname').value) $('#glname').value = e.target.value;\r\n  e.target.value = '';\r\n  glslTest();\r\n};\r\n$('#glload').onclick = () => {\r\n  const inp = document.createElement('input');\r\n  inp.type = 'file';\r\n  inp.accept = '.frag,.glsl,.fs,.txt';\r\n  inp.onchange = async () => {\r\n    const f = inp.files[0];\r\n    if (!f) return;\r\n    $('#glcode').value = await f.text();\r\n    if (!$('#glname').value) $('#glname').value = f.name.replace(/\\.[^.]+$/, '').slice(0, 18);\r\n    glslTest();\r\n  };\r\n  inp.click();\r\n};\r\n\r\n/* ---------------- propiedades: CLIP / CAPA / COMPOSICIÓN ---------------- */\r\nconst propwin = el('div'); propwin.id = 'propwin';\r\npropwin.innerHTML = `\r\n  <div id=\"propbar\"><b>⚙ PROPIEDADES</b>\r\n    <button class=\"mini\" id=\"propdock\" title=\"acoplar al panel de abajo / volver a flotante\">⇱ acoplar</button>\r\n    <button class=\"mini\" id=\"propclose\">✕</button></div>\r\n  <div id=\"proptabs\">\r\n    <button data-pt=\"clip\">CLIP</button>\r\n    <button data-pt=\"capa\">CAPA</button>\r\n    <button data-pt=\"comp\">COMPOSICIÓN</button>\r\n  </div>\r\n  <div id=\"propbody\"></div>`;\r\ndocument.body.appendChild(propwin);\r\nlet propTab = 'clip', propCell = null, propLayer = 0, propOpen = false;\r\n/* acoplar/separar: la ventana puede vivir dentro del panel inferior (layouts a gusto) */\r\nfunction setPropDock(d) {\r\n  uiPrefs.propDock = d;\r\n  saveUI();\r\n  propwin.classList.toggle('docked', d);\r\n  $('#propdock').textContent = d ? '⇲ flotar' : '⇱ acoplar';\r\n  if (d) {\r\n    $('#bottom').insertBefore(propwin, $('#splitM'));\r\n    propOpen = true;\r\n    propwin.classList.add('open');\r\n    buildProps();\r\n  } else {\r\n    document.body.appendChild(propwin);\r\n  }\r\n}\r\n$('#propdock').onclick = () => setPropDock(!uiPrefs.propDock);\r\n$('#propclose').onclick = () => {\r\n  if (uiPrefs.propDock) { setPropDock(false); }\r\n  propOpen = false;\r\n  propwin.classList.remove('open');\r\n};\r\ndocument.querySelectorAll('#proptabs button').forEach(bt => {\r\n  bt.onclick = () => { propTab = bt.dataset.pt; buildProps(); };\r\n});\r\n{ // arrastrable (solo cuando flota)\r\n  const bar = $('#propbar');\r\n  bar.addEventListener('pointerdown', e => {\r\n    if (e.target.tagName === 'BUTTON' || uiPrefs.propDock) return;\r\n    const r = propwin.getBoundingClientRect();\r\n    const ox = e.clientX - r.left, oy = e.clientY - r.top;\r\n    const mv = ev => {\r\n      propwin.style.left = Math.max(0, Math.min(innerWidth - 140, ev.clientX - ox)) + 'px';\r\n      propwin.style.right = 'auto';\r\n      propwin.style.top = Math.max(0, Math.min(innerHeight - 60, ev.clientY - oy)) + 'px';\r\n    };\r\n    const up = () => { removeEventListener('pointermove', mv); removeEventListener('pointerup', up); };\r\n    addEventListener('pointermove', mv);\r\n    addEventListener('pointerup', up);\r\n  });\r\n}\r\nfunction openProps(tab, cell, layer) {\r\n  if (tab) propTab = tab;\r\n  if (cell !== undefined) propCell = cell;\r\n  if (layer !== undefined) propLayer = layer;\r\n  propOpen = true;\r\n  propwin.classList.add('open');\r\n  buildProps();\r\n}\r\nconst pRow = (label, inner) => `<div class=\"prow2\"><b>${label}</b><span>${inner}</span></div>`;\r\nfunction buildProps() {\r\n  document.querySelectorAll('#proptabs button').forEach(bt =>\r\n    bt.classList.toggle('on', bt.dataset.pt === propTab));\r\n  const b = $('#propbody');\r\n  if (propTab === 'clip') buildPropClip(b);\r\n  else if (propTab === 'capa') buildPropLayer(b);\r\n  else buildPropComp(b);\r\n}\r\n/* --- animación de parámetros: UI dentro de Propiedades CLIP --- */\r\nconst ANIM_LABELS = { sc: 'Escala', x: 'Posición X', y: 'Posición Y', rot: 'Rotación', p1: 'P1 velocidad', p2: 'P2 tono' };\r\nconst ANIM_MODES = [['off', 'apagada'], ['lfo', '〰 loop (sync BPM)'], ['bass', '🔊 graves'], ['mid', '🔊 medios'],\r\n  ['high', '🔊 agudos'], ['beat', '💥 beat'], ['rnd', '🎲 azar por ciclo']];\r\nlet propAnimSel = 'sc';\r\nfunction animKeysFor(cell) { return cell.kind === 'gen' ? ['sc', 'x', 'y', 'rot', 'p1', 'p2'] : ['sc', 'x', 'y', 'rot']; }\r\nfunction buildAnimHTML(cell) {\r\n  const keys = animKeysFor(cell);\r\n  if (!keys.includes(propAnimSel)) propAnimSel = keys[0];\r\n  const a = (cell.anim && cell.anim[propAnimSel]) || { m: 'off', w: 'sin', b: 4, a: .5 };\r\n  const act = k => cell.anim && cell.anim[k] && cell.anim[k].m !== 'off' && cell.anim[k].a > 0;\r\n  return `<div class=\"cph\">ANIMACIÓN <span style=\"color:var(--dim);font-size:9px;letter-spacing:0\">· loops por parámetro al tempo</span></div>\r\n    ${pRow('Parámetro', `<select id=\"ppap\">${keys.map(k =>\r\n      `<option value=\"${k}\"${k === propAnimSel ? ' selected' : ''}>${(act(k) ? '● ' : '') + ANIM_LABELS[k]}</option>`).join('')}</select>`)}\r\n    ${pRow('Modo', `<select id=\"ppam\">${ANIM_MODES.map(([v, lb]) =>\r\n      `<option value=\"${v}\"${v === a.m ? ' selected' : ''}>${lb}</option>`).join('')}</select>`)}\r\n    ${pRow('Forma', `<select id=\"ppaw\"${a.m !== 'lfo' ? ' disabled' : ''}>${['sin', 'tri', 'saw', 'sqr'].map(w =>\r\n      `<option${w === (a.w || 'sin') ? ' selected' : ''}>${w}</option>`).join('')}</select>`)}\r\n    ${pRow('Ciclo (beats)', `<select id=\"ppab\"${a.m !== 'lfo' && a.m !== 'rnd' ? ' disabled' : ''}>${[.5, 1, 2, 4, 8, 16].map(n =>\r\n      `<option value=\"${n}\"${n === (a.b || 4) ? ' selected' : ''}>${n}</option>`).join('')}</select>`)}\r\n    ${pRow('Cantidad', `<input type=\"range\" id=\"ppaa\" min=\"0\" max=\"1\" step=\"0.01\" value=\"${a.a ?? .5}\">`)}`;\r\n}\r\nfunction wireAnimUI(cell) {\r\n  const getA = () => {\r\n    cell.anim = cell.anim || {};\r\n    return cell.anim[propAnimSel] = cell.anim[propAnimSel] || { m: 'off', w: 'sin', b: 4, a: .5 };\r\n  };\r\n  $('#ppap').onchange = e => { propAnimSel = e.target.value; buildProps(); };\r\n  $('#ppam').onchange = e => { getA().m = e.target.value; markDirty(); buildProps(); };\r\n  $('#ppaw').onchange = e => { getA().w = e.target.value; markDirty(); };\r\n  $('#ppab').onchange = e => { getA().b = +e.target.value; markDirty(); };\r\n  $('#ppaa').oninput = e => { getA().a = +e.target.value; markDirty(); };\r\n}\r\nfunction buildPropClip(b) {\r\n  const cell = propCell;\r\n  if (!cell || cell.kind === 'empty') {\r\n    b.innerHTML = '<div class=\"pnote\">Elegí un clip: doble click en una celda de la grilla,<br>o click derecho → ⚙ Propiedades del clip.</div>';\r\n    return;\r\n  }\r\n  cell.tr = cell.tr || { sc: 1, x: 0, y: 0, rot: 0 };\r\n  const t = cell.tr;\r\n  const tipo = { video: '🎬 video', gen: '✨ generativo', text: '💬 texto', gif: '🎞 gif', cam: '📷 cámara' }[cell.kind] || cell.kind;\r\n  let extra = '';\r\n  if (cell.kind === 'video') {\r\n    extra = `<div class=\"cph\">RECORTE (loop)</div>\r\n      <div id=\"pptl\" style=\"position:relative;height:16px;background:#0a0a0d;border:1px solid var(--line);border-radius:4px;margin:2px 0 6px;overflow:hidden\">\r\n        <div id=\"pptlio\" style=\"position:absolute;top:0;bottom:0;background:#ffffff1c\"></div>\r\n        <div id=\"pptlph\" style=\"position:absolute;top:0;bottom:0;width:2px;background:var(--acc)\"></div>\r\n      </div>\r\n      ${pRow('Inicio (seg)', `<input type=\"number\" id=\"ppin\" min=\"0\" step=\"0.1\" value=\"${cell.inT || 0}\">`)}\r\n      ${pRow('Fin (seg)', `<input type=\"number\" id=\"ppout\" min=\"0\" step=\"0.1\" value=\"${cell.outT || 0}\">`)}`;\r\n  } else if (cell.kind === 'gen') {\r\n    const gp = cell.gp = cell.gp || { xy: true, p1: .5, p2: .5 };\r\n    extra = `<div class=\"cph\">GENERADOR</div>\r\n      ${pRow('Seguir pad XY', `<input type=\"checkbox\" id=\"ppxy\" ${gp.xy !== false ? 'checked' : ''}>`)}\r\n      ${pRow('P1 velocidad', `<input type=\"range\" id=\"ppp1\" min=\"0\" max=\"1\" step=\"0.01\" value=\"${gp.p1 ?? .5}\">`)}\r\n      ${pRow('P2 tono', `<input type=\"range\" id=\"ppp2\" min=\"0\" max=\"1\" step=\"0.01\" value=\"${gp.p2 ?? .5}\">`)}`;\r\n  } else if (cell.kind === 'text') {\r\n    extra = `<div class=\"cph\">TEXTO</div>\r\n      ${pRow('Texto', `<input type=\"text\" id=\"pptxt\" value=\"${cell.name.replace(/\"/g, '&quot;')}\" maxlength=\"40\">`)}\r\n      ${pRow('Animación', `<select id=\"ppstyle\">${TEXT_STYLES.map(s =>\r\n        `<option${(cell.textStyle || 'pulso') === s ? ' selected' : ''}>${s}</option>`).join('')}</select>`)}`;\r\n  } else if (cell.kind === 'cam') {\r\n    extra = `<div class=\"cph\">CÁMARA</div>\r\n      ${pRow('Dispositivo', `<button class=\"mini\" id=\"ppcam\">📷 cambiar…</button>`)}`;\r\n  }\r\n  b.innerHTML = `\r\n    ${pRow('Nombre', `<input type=\"text\" id=\"ppname\" value=\"${cell.name.replace(/\"/g, '&quot;')}\" maxlength=\"24\">`)}\r\n    ${pRow('Tipo', `<span class=\"v\">${tipo} · CAPA ${cell.l + 1} · col ${cell.c + 1}</span>`)}\r\n    <div class=\"cph\">TRANSFORM</div>\r\n    ${pRow('Escala', `<input type=\"range\" id=\"ppsc\" min=\"0.2\" max=\"3\" step=\"0.02\" value=\"${t.sc}\">`)}\r\n    ${pRow('Posición X', `<input type=\"range\" id=\"ppx\" min=\"-1\" max=\"1\" step=\"0.01\" value=\"${t.x}\">`)}\r\n    ${pRow('Posición Y', `<input type=\"range\" id=\"ppy\" min=\"-1\" max=\"1\" step=\"0.01\" value=\"${t.y}\">`)}\r\n    ${pRow('Rotación', `<input type=\"range\" id=\"pprot\" min=\"-180\" max=\"180\" step=\"1\" value=\"${t.rot}\">`)}\r\n    ${pRow('Velocidad clip', `<input type=\"range\" id=\"ppspd\" min=\"0\" max=\"3\" step=\"0.05\" value=\"${cell.spd != null ? cell.spd : 1}\">`)}\r\n    ${pRow('', `<button class=\"mini\" id=\"pptr0\">↺ reset transform</button>`)}\r\n    ${buildAnimHTML(cell)}\r\n    ${extra}\r\n    <div class=\"cph\">ACCIONES</div>\r\n    ${pRow('', `<button class=\"mini\" id=\"ppfire\">▶ disparar</button>\r\n      <button class=\"mini\" id=\"ppprev\">👁 previa</button>\r\n      <button class=\"mini\" id=\"ppempty\">🧹 vaciar</button>`)}`;\r\n  $('#ppname').onchange = e => { cell.name = e.target.value; refreshCell(cell.l, cell.c); markDirty(); };\r\n  $('#ppsc').oninput = e => { t.sc = +e.target.value; markDirty(); };\r\n  $('#ppx').oninput = e => { t.x = +e.target.value; markDirty(); };\r\n  $('#ppy').oninput = e => { t.y = +e.target.value; markDirty(); };\r\n  $('#pprot').oninput = e => { t.rot = +e.target.value; markDirty(); };\r\n  $('#ppspd').oninput = e => { cell.spd = +e.target.value; applyAllSpeeds(); markDirty(); };\r\n  $('#pptr0').onclick = () => { cell.tr = { sc: 1, x: 0, y: 0, rot: 0 }; cell.spd = 1; applyAllSpeeds(); markDirty(); buildProps(); };\r\n  wireAnimUI(cell);\r\n  if (cell.kind === 'video') {\r\n    const upd = () => {\r\n      const i = Math.max(0, +$('#ppin').value || 0);\r\n      const o2 = Math.max(0, +$('#ppout').value || 0);\r\n      cell.inT = i; cell.outT = o2 > i ? o2 : 0;\r\n      markDirty();\r\n    };\r\n    $('#ppin').onchange = upd; $('#ppout').onchange = upd;\r\n    // timeline en vivo: región del loop + cabezal de reproducción\r\n    clearInterval(buildPropClip._t);\r\n    buildPropClip._t = setInterval(() => {\r\n      const io = document.getElementById('pptlio'), ph = document.getElementById('pptlph');\r\n      if (!io || !propOpen || propCell !== cell || !cell.video || !cell.video.duration) {\r\n        if (!io) clearInterval(buildPropClip._t);\r\n        return;\r\n      }\r\n      const d2 = cell.video.duration;\r\n      const a = (cell.inT || 0) / d2 * 100;\r\n      const b2 = ((cell.outT || d2)) / d2 * 100;\r\n      io.style.left = a + '%';\r\n      io.style.width = Math.max(0, b2 - a) + '%';\r\n      ph.style.left = Math.min(100, cell.video.currentTime / d2 * 100) + '%';\r\n    }, 100);\r\n  } else if (cell.kind === 'gen') {\r\n    const gp = cell.gp;\r\n    $('#ppxy').onchange = e => { gp.xy = e.target.checked; cell._pv = false; markDirty(); };\r\n    $('#ppp1').oninput = e => { gp.p1 = +e.target.value; cell._pv = false; markDirty(); };\r\n    $('#ppp2').oninput = e => { gp.p2 = +e.target.value; cell._pv = false; markDirty(); };\r\n  } else if (cell.kind === 'text') {\r\n    $('#pptxt').onchange = e => { cell.name = e.target.value || cell.name; refreshCell(cell.l, cell.c); markDirty(); buildProps(); };\r\n    $('#ppstyle').onchange = e => { cell.textStyle = e.target.value; markDirty(); };\r\n  } else if (cell.kind === 'cam') {\r\n    $('#ppcam').onclick = e => camPicker(cell, e.clientX, e.clientY);\r\n  }\r\n  $('#ppfire').onclick = () => triggerCell(cell.l, cell.c);\r\n  $('#ppprev').onclick = () => setPreview(cell);\r\n  $('#ppempty').onclick = () => { emptyCell(cell); buildProps(); };\r\n}\r\nfunction buildPropLayer(b) {\r\n  const l = propLayer, L = state.layers[l];\r\n  const chips = state.layers.map((_, i) =>\r\n    `<button class=\"mini${i === l ? ' on' : ''}\" data-pl=\"${i}\">CAPA ${i + 1}</button>`).join('');\r\n  const autoVal = L.auto.mode === 'off' ? 'off' : L.auto.mode === 'end' ? 'end' :\r\n    (L.auto.mode === 'beats' ? 'b' : 's') + L.auto.n;\r\n  b.innerHTML = `\r\n    <div class=\"pchips\">${chips}</div>\r\n    ${pRow('Blend', `<select id=\"plblend\">${BLENDS.map((bm, i) =>\r\n      `<option value=\"${i}\"${L.mode === i ? ' selected' : ''}>${bm}</option>`).join('')}</select>`)}\r\n    ${pRow('Opacidad', `<input type=\"range\" id=\"plop\" min=\"0\" max=\"1\" step=\"0.01\" value=\"${L.opacity}\">`)}\r\n    ${pRow('Velocidad', `<input type=\"range\" id=\"plspd\" min=\"0\" max=\"3\" step=\"0.05\" value=\"${L.speed}\">`)}\r\n    ${pRow('Modulador', `<select id=\"plmod\">${OPMODS.map(m =>\r\n      `<option${L.opMod === m ? ' selected' : ''}>${m}</option>`).join('')}</select>`)}\r\n    <div class=\"cph\">AUTO-TRANSICIÓN</div>\r\n    ${pRow('Avanzar', `<select id=\"plauto\">${[['off', 'off'], ['b2', 'c/2♪'], ['b4', 'c/4♪'], ['b8', 'c/8♪'], ['b16', 'c/16♪'], ['b32', 'c/32♪'],\r\n      ['s2', 'c/2s'], ['s5', 'c/5s'], ['s10', 'c/10s'], ['s30', 'c/30s'], ['end', 'fin clip']].map(([v, txt]) =>\r\n      `<option value=\"${v}\"${autoVal === v ? ' selected' : ''}>${txt}</option>`).join('')}</select>`)}\r\n    ${pRow('Orden', `<button class=\"mini\" id=\"plrand\">${L.auto.rand ? '🎲 azar' : '▸ secuencial'}</button>\r\n      <button class=\"mini${L.auto.dip ? ' on' : ''}\" id=\"pldip\">⤓0 dip a negro</button>`)}\r\n    <div class=\"cph\">EFECTO DE CAPA</div>\r\n    ${pRow('Efecto', `<select id=\"plfx\"><option value=\"none\">FX off</option>${FXDEFS.map(d =>\r\n      `<option value=\"${d.id}\"${L.fx.id === d.id ? ' selected' : ''}>${d.name}</option>`).join('')}</select>`)}\r\n    ${pRow('Parámetro 1', `<input type=\"range\" id=\"plfx1\" min=\"0\" max=\"1\" step=\"0.01\" value=\"${L.fx.p1}\">`)}\r\n    ${pRow('Parámetro 2', `<input type=\"range\" id=\"plfx2\" min=\"0\" max=\"1\" step=\"0.01\" value=\"${L.fx.p2}\">`)}\r\n    <div class=\"cph\">ACCIONES</div>\r\n    ${pRow('', `<button class=\"mini${L.solo ? ' on' : ''}\" id=\"plsolo\">S solo</button>\r\n      <button class=\"mini${L.byp ? ' danger on' : ''}\" id=\"plbyp\">B bypass</button>\r\n      <button class=\"mini\" id=\"ploff\">✕ apagar</button>`)}`;\r\n  b.querySelectorAll('[data-pl]').forEach(ch =>\r\n    ch.onclick = () => { propLayer = +ch.dataset.pl; buildProps(); });\r\n  $('#plblend').onchange = e => { L.mode = +e.target.value; buildGrid(); markDirty(); };\r\n  $('#plop').oninput = e => {\r\n    L.opacity = +e.target.value;\r\n    if (midiRefs['lop:' + l]) midiRefs['lop:' + l].value = L.opacity;\r\n    markDirty();\r\n  };\r\n  $('#plspd').oninput = e => {\r\n    L.speed = +e.target.value; applySpeed(L);\r\n    if (midiRefs['lspd:' + l]) midiRefs['lspd:' + l].value = L.speed;\r\n    markDirty();\r\n  };\r\n  $('#plmod').onchange = e => { L.opMod = e.target.value; buildGrid(); markDirty(); };\r\n  $('#plauto').onchange = e => {\r\n    const v = e.target.value;\r\n    if (v === 'off') L.auto.mode = 'off';\r\n    else if (v === 'end') { L.auto.mode = 'end'; L.auto._lastVT = 0; }\r\n    else { L.auto.mode = v[0] === 'b' ? 'beats' : 'secs'; L.auto.n = +v.slice(1); }\r\n    L.auto._count = 0; L.auto._t = 0;\r\n    buildGrid(); markDirty();\r\n  };\r\n  $('#plrand').onclick = () => { L.auto.rand = !L.auto.rand; buildGrid(); markDirty(); buildProps(); };\r\n  $('#pldip').onclick = () => { L.auto.dip = !L.auto.dip; buildGrid(); markDirty(); buildProps(); };\r\n  $('#plfx').onchange = e => { L.fx.id = e.target.value; buildGrid(); markDirty(); };\r\n  $('#plfx1').oninput = e => {\r\n    L.fx.p1 = +e.target.value;\r\n    if (midiRefs[`lfx:${l}:p1`]) midiRefs[`lfx:${l}:p1`].value = L.fx.p1;\r\n    markDirty();\r\n  };\r\n  $('#plfx2').oninput = e => {\r\n    L.fx.p2 = +e.target.value;\r\n    if (midiRefs[`lfx:${l}:p2`]) midiRefs[`lfx:${l}:p2`].value = L.fx.p2;\r\n    markDirty();\r\n  };\r\n  $('#plsolo').onclick = () => { L.solo = !L.solo; buildGrid(); markDirty(); buildProps(); };\r\n  $('#plbyp').onclick = () => { L.byp = !L.byp; buildGrid(); markDirty(); buildProps(); };\r\n  $('#ploff').onclick = () => clearLayer(l);\r\n}\r\nfunction buildPropComp(b) {\r\n  b.innerHTML = `\r\n    ${pRow('BPM', `<input type=\"number\" id=\"pgbpm\" min=\"40\" max=\"240\" value=\"${state.bpm}\">`)}\r\n    ${pRow('Fade (seg)', `<input type=\"range\" id=\"pgfade\" min=\"0\" max=\"5\" step=\"0.05\" value=\"${state.fade}\">`)}\r\n    ${pRow('Crossfader A⇄B', `<input type=\"range\" id=\"pgxf\" min=\"0\" max=\"1\" step=\"0.01\" value=\"${state.xfade}\">`)}\r\n    ${pRow('Master', `<input type=\"range\" id=\"pgmaster\" min=\"0\" max=\"1\" step=\"0.01\" value=\"${state.master}\">`)}\r\n    ${pRow('Velocidad global', `<input type=\"range\" id=\"pgspeed\" min=\"0\" max=\"2\" step=\"0.05\" value=\"${state.gSpeed}\">`)}\r\n    ${pRow('Resolución', `<select id=\"pgres\">${resOptionsHTML(state.res)}</select>`)}\r\n    ${pRow('Modo 1×', `<button class=\"mini${state.mono ? ' on' : ''}\" id=\"pgmono\">${state.mono ? 'un clip a la vez' : 'capas libres'}</button>`)}\r\n    ${pRow('Tema', `<select id=\"pgtheme\">${Object.entries(THEMES).map(([k, th]) =>\r\n      `<option value=\"${k}\"${state.theme === k ? ' selected' : ''}>${th.label}</option>`).join('')}</select>`)}\r\n    <div class=\"cph\">ACCIONES</div>\r\n    ${pRow('', `<button class=\"mini${state.blackout ? ' danger on' : ''}\" id=\"pgblack\">⬛ blackout</button>\r\n      <button class=\"mini\" id=\"pgrec\">${rec ? '⏹ parar rec' : '⏺ grabar'}</button>\r\n      <button class=\"mini\" id=\"pgpanic\">🚨 pánico</button>`)}`;\r\n  $('#pgbpm').onchange = e => {\r\n    state.bpm = Math.min(240, Math.max(40, +e.target.value || 120));\r\n    $('#bpmIn').value = state.bpm; markDirty();\r\n  };\r\n  $('#pgfade').oninput = e => {\r\n    state.fade = +e.target.value;\r\n    $('#fadeIn').value = state.fade;\r\n    $('#fadeLbl').textContent = state.fade.toFixed(1) + 's';\r\n    markDirty();\r\n  };\r\n  $('#pgxf').oninput = e => { state.xfade = +e.target.value; $('#xfadeIn').value = state.xfade; markDirty(); };\r\n  $('#pgmaster').oninput = e => { state.master = +e.target.value; $('#masterIn').value = state.master; };\r\n  $('#pgspeed').oninput = e => { state.gSpeed = +e.target.value; applyAllSpeeds(); markDirty(); };\r\n  $('#pgres').onchange = e => onResSelChange(e.target.value);\r\n  $('#pgmono').onclick = () => { monoToggle(); buildProps(); };\r\n  $('#pgtheme').onchange = e => { applyTheme(e.target.value); markDirty(); };\r\n  $('#pgblack').onclick = () => { toggleBlackout(); buildProps(); };\r\n  $('#pgrec').onclick = () => { toggleRec(); setTimeout(buildProps, 100); };\r\n  $('#pgpanic').onclick = panic;\r\n}\r\n\r\n/* ---------------- set nuevo (empezar de cero) ---------------- */\r\nfunction newSet() {\r\n  if (!confirm('¿Empezar un set NUEVO desde cero?\\n\\nSe limpia todo: grilla (los 4 decks), escenas, efectos, mapping y ajustes.\\nTus mapeos MIDI y generadores custom SE CONSERVAN.\\n\\nTip: guardá el actual con 💾 antes, si lo querés conservar.')) return;\r\n  deserialize({\r\n    app: 'raven-vj', version: 1,\r\n    bpm: 120, fade: 1, master: 1, cols: 8,\r\n    auto: { mode: 'off', beats: 4 },\r\n    lfo: [{ wave: 'sine', rate: 1 }, { wave: 'tri', rate: .25 }],\r\n    scenes: new Array(8).fill(null), rndBeats: 0, xfade: .5,\r\n    beatSens: state.beatSens, fpsCap: state.fpsCap, mono: true, monoV: 2,\r\n    outScreen: state.outScreen, theme: state.theme, gSpeed: 1,\r\n    setlistSteps: [], nanoDefaults: state.nanoDefaults,\r\n    map: null, fxPresets: state.fxPresets,\r\n    customGens: state.customGens.map(({ _v, ...cg }) => cg),\r\n    deckIdx: 0,\r\n    layers: [0, 1, 2, 3].map(() => ({\r\n      opacity: 1, mode: 0, opMod: 'off', speed: 1, solo: false, byp: false,\r\n      auto: { mode: 'off', n: 8, rand: false, dip: false },\r\n      fx: { id: 'none', p1: .5, p2: .5 },\r\n    })),\r\n    cells: [], effects: [], mappings: state.mappings, actives: [],\r\n  });\r\n  markDirty();\r\n  toast('🆕 Set nuevo — grilla limpia, a crear');\r\n}\r\n\r\n/* ---------------- plantillas de uso ---------------- */\r\nfunction tplScene(layers) {\r\n  return {\r\n    layers: layers.map(sl => ({\r\n      opacity: sl.op ?? 1, mode: sl.mode ?? 0, opMod: sl.opMod ?? 'off', speed: 1,\r\n      auto: sl.auto ?? { mode: 'off', n: 8, rand: false, dip: false },\r\n      fx: sl.fx ?? { id: 'none', p1: .5, p2: .5 },\r\n      cell: sl.cell ?? null,\r\n    })),\r\n    effects: [], xy: { x: .5, y: .5 }, master: 1, xfade: .5,\r\n  };\r\n}\r\nconst TEMPLATES = {\r\n  psy: {\r\n    label: '🍄 Fiesta Psytrance',\r\n    desc: 'pack psy completo, UV+zoom al bombo, escenas armadas, 145 BPM',\r\n    make: () => ({\r\n      bpm: 145, fade: 1.2, mono: false, theme: 'fenix', rndBeats: 16,\r\n      auto: { mode: 'off', beats: 8 },\r\n      layers: [\r\n        { opacity: 1, mode: 0, opMod: 'off', speed: 1, auto: { mode: 'beats', n: 16, rand: true, dip: false }, fx: { id: 'none', p1: .5, p2: .5 } },\r\n        { opacity: .7, mode: 1, opMod: 'bass', speed: 1, auto: { mode: 'off', n: 8, rand: false, dip: false }, fx: { id: 'none', p1: .5, p2: .5 } },\r\n        { opacity: 1, mode: 2, opMod: 'off', speed: 1, auto: { mode: 'off', n: 8, rand: false, dip: false }, fx: { id: 'none', p1: .5, p2: .5 } },\r\n        { opacity: 1, mode: 1, opMod: 'beat', speed: 1, auto: { mode: 'off', n: 8, rand: false, dip: false }, fx: { id: 'none', p1: .5, p2: .5 } },\r\n      ],\r\n      cells: [\r\n        ...[16, 17, 18, 19, 20, 21, 4, 10].map((pi, c) => ({ l: 0, c, kind: 'gen', presetIdx: pi })),\r\n        ...[8, 13, 2, 5, 11, 7, 14, 12].map((pi, c) => ({ l: 1, c, kind: 'gen', presetIdx: pi })),\r\n        { l: 2, c: 0, kind: 'text', name: 'ॐ', textStyle: 'pulso' },\r\n        { l: 2, c: 1, kind: 'text', name: 'PSY', textStyle: '3d' },\r\n        ...[11, 3].map((pi, c) => ({ l: 3, c, kind: 'gen', presetIdx: pi })),\r\n      ],\r\n      effects: [\r\n        { id: 'uv', uid: 900, enabled: true, params: [{ value: .35, mod: 'none', amt: .5 }, { value: .1, mod: 'lfo2', amt: .3 }] },\r\n        { id: 'zom', uid: 901, enabled: true, params: [{ value: .7, mod: 'none', amt: .5 }, { value: .5, mod: 'none', amt: .5 }] },\r\n      ],\r\n      scenes: [\r\n        tplScene([{ cell: { l: 0, c: 0 } }, { cell: null }, { cell: null }, { cell: null }]),\r\n        tplScene([{ cell: { l: 0, c: 1 } }, { cell: { l: 1, c: 0 }, op: .6, mode: 1, opMod: 'bass' }, { cell: null }, { cell: null }]),\r\n        tplScene([{ cell: { l: 0, c: 5 } }, { cell: { l: 1, c: 3 }, op: .5, mode: 1 }, { cell: { l: 2, c: 0 }, op: .9, mode: 1, opMod: 'beat' }, { cell: null }]),\r\n      ],\r\n    }),\r\n  },\r\n  club: {\r\n    label: '🖤 Club / Techno oscuro',\r\n    desc: 'hipnosis, strobes y alto contraste en modo 1×',\r\n    make: () => ({\r\n      bpm: 132, fade: .4, mono: true, theme: 'cyber', rndBeats: 32,\r\n      layers: [\r\n        { opacity: 1, mode: 0, opMod: 'off', speed: 1, auto: { mode: 'beats', n: 32, rand: true, dip: true }, fx: { id: 'none', p1: .5, p2: .5 } },\r\n        {}, {}, {},\r\n      ].map(L => Object.assign({ opacity: 1, mode: 0, opMod: 'off', speed: 1, auto: { mode: 'off', n: 8, rand: false, dip: false }, fx: { id: 'none', p1: .5, p2: .5 } }, L)),\r\n      cells: [21, 15, 12, 11, 6, 13, 1, 3].map((pi, c) => ({ l: 0, c, kind: 'gen', presetIdx: pi })),\r\n      effects: [\r\n        { id: 'vig', uid: 902, enabled: true, params: [{ value: .5, mod: 'none', amt: .5 }, { value: .6, mod: 'none', amt: .5 }] },\r\n        { id: 'str', uid: 903, enabled: false, params: [{ value: .25, mod: 'none', amt: .5 }, { value: .3, mod: 'none', amt: .5 }] },\r\n      ],\r\n      scenes: [],\r\n    }),\r\n  },\r\n  banda: {\r\n    label: '🎸 Banda / cámara en vivo',\r\n    desc: 'cámara al frente + texto + fondos suaves',\r\n    make: () => ({\r\n      bpm: 120, fade: 2, mono: false, theme: 'violeta', rndBeats: 0,\r\n      layers: [\r\n        { opacity: .5, mode: 0, opMod: 'off', speed: .6, auto: { mode: 'secs', n: 30, rand: true, dip: false }, fx: { id: 'none', p1: .5, p2: .5 } },\r\n        { opacity: 1, mode: 0, opMod: 'off', speed: 1, auto: { mode: 'off', n: 8, rand: false, dip: false }, fx: { id: 'none', p1: .5, p2: .5 } },\r\n        { opacity: .9, mode: 1, opMod: 'off', speed: 1, auto: { mode: 'off', n: 8, rand: false, dip: false }, fx: { id: 'none', p1: .5, p2: .5 } },\r\n        {},\r\n      ].map(L => Object.assign({ opacity: 1, mode: 0, opMod: 'off', speed: 1, auto: { mode: 'off', n: 8, rand: false, dip: false }, fx: { id: 'none', p1: .5, p2: .5 } }, L)),\r\n      cells: [\r\n        ...[14, 8, 19, 5].map((pi, c) => ({ l: 0, c, kind: 'gen', presetIdx: pi })),\r\n        { l: 1, c: 0, kind: 'cam', name: 'cámara', camId: '' },\r\n        { l: 2, c: 0, kind: 'text', name: 'LA BANDA', textStyle: 'scroll' },\r\n      ],\r\n      effects: [{ id: 'vig', uid: 904, enabled: true, params: [{ value: .35, mod: 'none', amt: .5 }, { value: .5, mod: 'none', amt: .5 }] }],\r\n      scenes: [],\r\n    }),\r\n  },\r\n  mapping: {\r\n    label: '🏛 Mapping 2 superficies',\r\n    desc: 'dos superficies listas para calzar en paredes/cajas, gens geométricos',\r\n    make: () => ({\r\n      bpm: 125, fade: 1, mono: false, theme: 'fenix', rndBeats: 0,\r\n      map: {\r\n        on: true, sel: 0,\r\n        surfaces: [\r\n          { pts: [[.02, .1], [.47, .12], [.46, .9], [.03, .86]], src: [0, 0, .5, 1], on: true },\r\n          { pts: [[.53, .12], [.98, .1], [.97, .88], [.54, .9]], src: [.5, 0, .5, 1], on: true },\r\n        ],\r\n      },\r\n      layers: [{}, {}, {}, {}].map(() => ({ opacity: 1, mode: 0, opMod: 'off', speed: 1, auto: { mode: 'off', n: 8, rand: false, dip: false }, fx: { id: 'none', p1: .5, p2: .5 } })),\r\n      cells: [6, 19, 16, 13, 2, 15].map((pi, c) => ({ l: 0, c, kind: 'gen', presetIdx: pi })),\r\n      effects: [],\r\n      scenes: [],\r\n    }),\r\n  },\r\n  chill: {\r\n    label: '🧘 Chill / Ambient',\r\n    desc: 'fundidos largos, nubes y degradés que respiran solos',\r\n    make: () => ({\r\n      bpm: 90, fade: 4, mono: false, theme: 'violeta', rndBeats: 0,\r\n      layers: [\r\n        { opacity: 1, mode: 0, opMod: 'off', speed: .5, auto: { mode: 'secs', n: 30, rand: true, dip: false }, fx: { id: 'none', p1: .5, p2: .5 } },\r\n        { opacity: .5, mode: 1, opMod: 'lfo1', speed: .4, auto: { mode: 'secs', n: 45, rand: true, dip: false }, fx: { id: 'none', p1: .5, p2: .5 } },\r\n        {}, {},\r\n      ].map(L => Object.assign({ opacity: 1, mode: 0, opMod: 'off', speed: 1, auto: { mode: 'off', n: 8, rand: false, dip: false }, fx: { id: 'none', p1: .5, p2: .5 } }, L)),\r\n      cells: [\r\n        ...[8, 14, 19, 0, 15].map((pi, c) => ({ l: 0, c, kind: 'gen', presetIdx: pi })),\r\n        ...[3, 5].map((pi, c) => ({ l: 1, c, kind: 'gen', presetIdx: pi })),\r\n      ],\r\n      effects: [{ id: 'hue', uid: 905, enabled: true, params: [{ value: .1, mod: 'lfo1', amt: .4 }, { value: .55, mod: 'none', amt: .5 }] }],\r\n      scenes: [],\r\n    }),\r\n  },\r\n};\r\nfunction applyTemplate(key) {\r\n  const tpl = TEMPLATES[key];\r\n  if (!tpl) return;\r\n  if (!confirm(`¿Cargar la plantilla \"${tpl.label}\"?\\nReemplaza la grilla y los efectos actuales (tus mapeos MIDI y generadores custom se conservan).`)) return;\r\n  const t = tpl.make();\r\n  const d = {\r\n    app: 'raven-vj', version: 1,\r\n    bpm: t.bpm, fade: t.fade, master: 1, cols: Math.max(8, COLS),\r\n    auto: t.auto || { mode: 'off', beats: 4 },\r\n    lfo: [{ wave: 'sine', rate: 1 }, { wave: 'tri', rate: .25 }],\r\n    scenes: (t.scenes || []).concat(new Array(8).fill(null)).slice(0, 8),\r\n    rndBeats: t.rndBeats || 0, xfade: .5,\r\n    beatSens: state.beatSens, fpsCap: state.fpsCap,\r\n    mono: !!t.mono, monoV: 2,\r\n    outScreen: state.outScreen, theme: t.theme || state.theme,\r\n    setlistSteps: [], nanoDefaults: state.nanoDefaults,\r\n    map: t.map || null,\r\n    fxPresets: state.fxPresets,\r\n    customGens: state.customGens.map(({ _v, ...cg }) => cg),\r\n    layers: t.layers,\r\n    cells: t.cells.map(c => ({\r\n      name: c.kind === 'gen' ? genName(c.presetIdx) : (c.name || ''),\r\n      presetIdx: -1, gp: null, tr: null, textStyle: null, inT: 0, outT: 0, camId: '',\r\n      fileName: null, thumb: '', ...c,\r\n    })),\r\n    effects: t.effects || [],\r\n    mappings: state.mappings,\r\n    actives: [t.cells && t.cells.length ? { l: t.cells[0].l, c: t.cells[0].c } : null],\r\n  };\r\n  deserialize(d);\r\n  markDirty();\r\n  toast(tpl.label + ' cargada — F1-F3 si tiene escenas');\r\n}\r\n\r\n/* ---------------- barra de menús ---------------- */\r\nconst MENUS = {\r\n  archivo: () => [\r\n    { label: '🆕 Nuevo set (empezar de cero)', fn: newSet },\r\n    '-',\r\n    { label: '💾 Guardar set (JSON)', fn: () => $('#saveBtn').click() },\r\n    { label: '📂 Abrir set…', fn: () => $('#setIn').click() },\r\n    { label: '🔗 Relink de videos…', fn: () => $('#relinkIn').click() },\r\n    '-',\r\n    {\r\n      label: '📦 Plantillas de uso…', fn: () => setTimeout(() =>\r\n        showMenu(innerWidth / 2 - 130, 90, 'PLANTILLAS — sets armados para arrancar',\r\n          Object.entries(TEMPLATES).map(([k, tp]) => ({\r\n            label: tp.label + ' — ' + tp.desc, fn: () => applyTemplate(k),\r\n          }))), 30)\r\n    },\r\n    '-',\r\n    { label: '＋ Cargar videos / GIFs…', fn: () => $('#fileIn').click() },\r\n    '-',\r\n    {\r\n      label: '🧨 Borrar sesión y reiniciar', fn: () => {\r\n        if (confirm('¿Borrar la sesión autoguardada y arrancar de cero?')) {\r\n          localStorage.removeItem('ravenvj_autosave');\r\n          location.reload();\r\n        }\r\n      }\r\n    },\r\n  ],\r\n  comp: () => [\r\n    { label: '⚙ Propiedades de la composición…', fn: () => openProps('comp') },\r\n    '-',\r\n    { label: '⚡ BUILD (mantener) / DROP (soltar)', key: 'ESPACIO', fn: () => toast('Mantené la barra espaciadora y soltala en el drop 🍄') },\r\n    { label: 'FLASH', key: 'F', fn: () => { state.flash = 1; setTimeout(() => state.flash = 0, 150); } },\r\n    { label: state.blackout ? '💡 Sacar blackout' : '⬛ Blackout', key: 'B', fn: toggleBlackout },\r\n    { label: '🚨 Pánico', key: 'P', fn: panic },\r\n    '-',\r\n    { label: '🎲 Randomizar efectos', fn: () => randomizeFx() },\r\n    { label: 'Tap tempo', key: 'T', fn: tap },\r\n    { label: 'Detectar BPM del audio (SYNC)', fn: syncBpm },\r\n    '-',\r\n    { label: (state.mono ? '✓ ' : '') + 'Modo 1× — un clip a la vez', fn: monoToggle },\r\n  ],\r\n  capas: () => state.layers.map((L, l) => ({\r\n    label: `✕ Apagar CAPA ${l + 1} (fade)`, fn: () => clearLayer(l),\r\n  })).concat(['-', {\r\n    label: '↺ Reset de todas las capas',\r\n    fn: () => {\r\n      state.layers.forEach(L => {\r\n        L.opacity = 1; L.speed = 1; L.opMod = 'off';\r\n        L.solo = false; L.byp = false; L.fx = { id: 'none', p1: .5, p2: .5 };\r\n        L.auto.mode = 'off';\r\n      });\r\n      buildGrid(); markDirty(); toast('Capas reseteadas');\r\n    }\r\n  }]),\r\n  entrada: () => [\r\n    { label: '＋ Videos / GIFs…', fn: () => $('#fileIn').click() },\r\n    { label: '🧪 Crear generador propio…', fn: () => openGenBuilder() },\r\n    { label: '📜 Importar GLSL / Shadertoy…', fn: () => openGlslEditor() },\r\n    { label: '🕸 Editor de nodos…', fn: () => openNodeEditor() },\r\n    {\r\n      label: '⬆ Importar generador (.json)…', fn: () => {\r\n        const inp = document.createElement('input');\r\n        inp.type = 'file'; inp.accept = '.json';\r\n        inp.onchange = async () => {\r\n          try {\r\n            const d = JSON.parse(await inp.files[0].text());\r\n            if (!d || d.ravenGen !== 1 || !d.gen || !d.gen.name) throw new Error('formato');\r\n            state.customGens.push({ ...d.gen, _v: 0 });\r\n            buildShelf(); markDirty();\r\n            toast('🤝 \"' + d.gen.name + '\" importado al estante');\r\n          } catch (e) { toast('Ese .json no es un generador de RAVEN VJ'); }\r\n        };\r\n        inp.click();\r\n      }\r\n    },\r\n    { label: '📷 Cámara / capturadora HDMI', fn: () => toast('Arrastrá el tile 📷 Cámara a una celda, o click derecho en una celda → Cámara') },\r\n    '-',\r\n    { label: '🎤 Audio: ' + (audio.on ? 'apagar' : 'activar'), fn: audioToggle },\r\n    { label: '🎹 MIDI: reintentar conexión', fn: midiInit },\r\n    { label: '🎹 MIDI learn on/off', fn: () => { midiOk ? $('#midiBtn').click() : midiInit(); } },\r\n  ],\r\n  salida: () => [\r\n    { label: '🖥 Abrir ventana de salida', fn: () => openOutput() },\r\n    { label: '🖥 ＋ otra ventana de salida', fn: () => openOutput('ravenvj_out' + Math.floor(Math.random() * 1e4)) },\r\n    { label: '🔍 Elegir pantalla / identificar…', fn: () => { togglePanel(true); buildCpTab('render'); } },\r\n    '-',\r\n    { label: (state.map.on ? '✓ ' : '') + 'Mapping (superficies)', fn: mapToggle },\r\n    { label: '🗺 Editor de mapping…', fn: () => toggleMapWin(true) },\r\n    '-',\r\n    { label: rec ? '⏹ Parar grabación' : '⏺ Grabar la salida (webm)', fn: toggleRec },\r\n  ],\r\n  ver: () => [\r\n    { label: '⚙ Propiedades (clip/capa/composición)', fn: () => openProps() },\r\n    { label: '🛠 Panel de control', key: 'Ctrl+Alt+T', fn: () => togglePanel(true) },\r\n    { label: '🔍 Celdas más grandes', key: 'Ctrl+rueda', fn: () => zoomCells(12) },\r\n    { label: '🔍 Celdas más chicas', fn: () => zoomCells(-12) },\r\n    {\r\n      label: '🎨 Tema: ' + THEMES[state.theme].label + ' → cambiar',\r\n      fn: () => {\r\n        const keys = Object.keys(THEMES);\r\n        applyTheme(keys[(keys.indexOf(state.theme) + 1) % keys.length]);\r\n        markDirty();\r\n        toast('Tema: ' + THEMES[state.theme].label);\r\n      }\r\n    },\r\n    '-',\r\n    { label: '📊 Telemetría', fn: () => { togglePanel(true); buildCpTab('tele'); } },\r\n    { label: '⚙ Render / pantallas / mapping', fn: () => { togglePanel(true); buildCpTab('render'); } },\r\n    { label: '🎹 MIDI y mapeos', fn: () => { togglePanel(true); buildCpTab('midi'); } },\r\n    { label: '🔊 Audio y beat', fn: () => { togglePanel(true); buildCpTab('audio'); } },\r\n    { label: '📋 Setlist', fn: () => { togglePanel(true); buildCpTab('setl'); } },\r\n    { label: '📱 Remoto (celular)', fn: () => { togglePanel(true); buildCpTab('remote'); } },\r\n    { label: '💾 Sesión', fn: () => { togglePanel(true); buildCpTab('ses'); } },\r\n  ],\r\n  ayuda: () => [\r\n    { label: '⌨ Atajos de teclado', key: 'H', fn: () => { togglePanel(true); buildCpTab('keys'); } },\r\n    { label: '📖 Manual (LEEME)', fn: () => window.open('LEEME.txt', '_blank') },\r\n    '-',\r\n    { label: '☕ Invitame un cafecito (donar)', fn: () => window.open('https://cafecito.app/vjravenlight', '_blank') },\r\n    { label: 'RAVEN VJ · ravenlight.net/ravenvj', fn: () => toast('Hecho para la pista 🍄⚡') },\r\n  ],\r\n};\r\ndocument.querySelectorAll('#menubar button[data-menu]').forEach(bt => {\r\n  bt.onclick = e => {\r\n    e.stopPropagation();\r\n    const r = bt.getBoundingClientRect();\r\n    showMenu(r.left, r.bottom + 2, null, MENUS[bt.dataset.menu]());\r\n  };\r\n});\r\n\r\n/* ---------------- tamaños customizables (persisten entre sesiones) ---------------- */\r\nconst uiPrefs = Object.assign(\r\n  { bottomH: 250, genW: 220, monW: 330, cellW: 96 },\r\n  JSON.parse(localStorage.getItem('ravenvj_ui') || '{}'));\r\nfunction saveUI() { try { localStorage.setItem('ravenvj_ui', JSON.stringify(uiPrefs)); } catch (e) { } }\r\nfunction applyUI() {\r\n  const rs = document.documentElement.style;\r\n  rs.setProperty('--cellw', uiPrefs.cellW + 'px');\r\n  rs.setProperty('--cellh', Math.round(uiPrefs.cellW * 1.125) + 'px');\r\n  $('#bottom').style.height = uiPrefs.bottomH + 'px';\r\n  $('#bottom').style.minHeight = uiPrefs.bottomH + 'px';\r\n  $('#genPanel').style.width = uiPrefs.genW + 'px';\r\n  $('#monPanel').style.width = uiPrefs.monW + 'px';\r\n}\r\n/* ---------------- reloj ---------------- */\r\nlet clockDate = false;\r\nfunction tickClock() {\r\n  const d = new Date();\r\n  const p = n => String(n).padStart(2, '0');\r\n  const hm = `<b>${p(d.getHours())}:${p(d.getMinutes())}</b>:${p(d.getSeconds())}`;\r\n  const cl = $('#clock');\r\n  if (cl) cl.innerHTML = clockDate\r\n    ? `${p(d.getDate())}/${p(d.getMonth() + 1)} · ${hm}` : hm;\r\n}\r\n(() => {\r\n  const cl = $('#clock');\r\n  if (cl) cl.onclick = () => { clockDate = !clockDate; tickClock(); };\r\n  tickClock();\r\n  setInterval(tickClock, 1000);\r\n})();\r\n\r\n/* ---------------- multi-idioma (traductor de interfaz por diccionario) ---------------- */\r\nconst LANGS = {\r\n  es: 'Español', en: 'English', pt: 'Português', fr: 'Français', de: 'Deutsch', it: 'Italiano',\r\n  ja: '日本語', zh: '中文', ko: '한국어', ru: 'Русский', he: 'עברית', ar: 'العربية',\r\n};\r\nconst RTL = new Set(['he', 'ar']); // idiomas de derecha a izquierda\r\nconst I18N = {\r\n  en: {\r\n    'Archivo': 'File', 'Composición': 'Composition', 'Capas': 'Layers', 'Entrada': 'Input',\r\n    'Salida': 'Output', 'Ver': 'View', 'Ayuda': 'Help', '☕ Donar': '☕ Donate',\r\n    'SECUENCIA': 'SEQUENCE', 'COLUMNA AZAR': 'RANDOM COLUMN', 'CAOS': 'CHAOS', 'ESCENAS': 'SCENES',\r\n    'beats': 'beats', 'manual': 'manual', 'PÁNICO': 'PANIC', '＋ VIDEOS': '＋ VIDEOS',\r\n    'EFECTOS MASTER': 'MASTER EFFECTS', 'GENERADORES': 'GENERATORS', 'arrastrá a una celda': 'drag onto a cell',\r\n    '＋ agregar efecto…': '＋ add effect…', 'videos sin enlazar': 'unlinked videos', '🔗 RELINK': '🔗 RELINK',\r\n    'APARIENCIA': 'APPEARANCE', 'Tema de colores': 'Colo