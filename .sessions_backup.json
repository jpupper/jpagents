        {
          "path": "D:/Programacion/caminosysabores/public/maqueta/js/config.js",
          "name": "config.js",
          "content": "/**\n * Maqueta San Juan - Global Configuration\n * Fullscreen Ecosystem (FSC) Standard\n * \n * window.CONFIG is the single source of truth for all app configuration.\n * Must be loaded BEFORE auth.js and app.js\n */\n\nwindow.CONFIG = {\n  // Base path for this application\n  BASE: '',\n  \n  // API base URL (auto-detected based on environment)\n  get API_BASE() {\n    const host = window.location.hostname;\n    const isFTP = host === 'fullscreencode.com';\n    const isLocal = host === 'localhost' || host === '127.0.0.1';\n    \n    if (isFTP) {\n      return 'https://vps-4455523-x.dattaweb.com/caminosysabores';\n    } else if (isLocal) {\n      return window.location.origin;\n    } else {\n      return window.location.origin + '/fullscreencode';\n    }\n  },\n  \n  // fscauth URL (for SSO - not used in standalone mode)\n  FSCAUTH_URL: 'https://vps-4455523-x.dattaweb.com/fscauth',\n  \n  // App metadata\n  APP_NAME: 'Maqueta San Juan',\n  APP_VERSION: '1.0.0',\n};\n\n// Backward compatibility alias\nwindow.MAQUETA_CONFIG = window.CONFIG;\n\n// Export for module use\nconst CONFIG = window.CONFIG;\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/server/routes/talleres.js",
          "name": "talleres.js",
          "content": "const express = require('express');\nconst fs = require('fs');\nconst path = require('path');\nconst crypto = require('crypto');\nconst QRCode = require('qrcode');\nconst nodemailer = require('nodemailer');\n\nconst router = express.Router();\nconst TALLERES_FILE = path.join(__dirname, '..', 'data', 'talleres.json');\nconst CONFIG_FILE = path.join(__dirname, '..', 'data', 'talleres_config.json');\n\n// ─── CONFIGURACION MAIL ──────────────────────────────\nconst MAIL_HOST = process.env.SMTP_HOST || '';\nconst MAIL_PORT = parseInt(process.env.SMTP_PORT || '587');\nconst MAIL_USER = process.env.SMTP_USER || '';\nconst MAIL_PASS = process.env.SMTP_PASS || '';\nconst MAIL_FROM = process.env.SMTP_FROM || 'info@fullscreencode.com';\n\nfunction createTransport() {\n  if (!MAIL_HOST || !MAIL_USER) return null;\n  return nodemailer.createTransport({\n    host: MAIL_HOST, port: MAIL_PORT,\n    secure: MAIL_PORT === 465,\n    auth: { user: MAIL_USER, pass: MAIL_PASS }\n  });\n}\n\n// ─── DEFINICION DE TALLERES ─────────────────────────\nconst TALLERES = [\n  {\n    id: 'taller-de-siembra', nombre: 'Taller de Siembra',\n    pagina: 'taller.html',\n    horarios: {\n      jueves: ['14hs', '16hs'], viernes: ['14hs', '16hs'],\n      sabado: ['14hs', '16hs'], domingo: ['13hs', '17hs']\n    }\n  },\n  {\n    id: 'aceite-de-oliva', nombre: 'De San Juan a la Mesa - Aceite de Oliva',\n    pagina: 'de_san_juan_a_la_mesa.html',\n    horarios: {\n      jueves: ['15hs'], viernes: ['15hs'],\n      sabado: ['15hs'], domingo: ['14hs']\n    }\n  },\n  {\n    id: 'vino', nombre: 'De San Juan a la Mesa - Vino',\n    pagina: 'de_san_juan_a_la_mesa.html',\n    horarios: {\n      jueves: ['17hs'], viernes: ['17hs'],\n      sabado: ['17hs'], domingo: ['18hs']\n    }\n  },\n  {\n    id: 'maridaje', nombre: 'Maridaje con Mauricio Savoca',\n    pagina: 'maridaje_mauricio_savoca.html',\n    horarios: {\n      jueves: ['13hs', '18hs'], viernes: ['13hs', '18hs'],\n      sabado: ['13hs', '18hs'], domingo: ['16hs', '19hs']\n    }\n  },\n  {\n    id: 'senti-san-juan', nombre: 'Sentí San Juan',\n    pagina: 'senti_san_juan.html',\n    horarios: {\n      jueves: ['12hs', '19hs'], viernes: ['12hs', '19hs'],\n      sabado: ['12hs', '19hs'], domingo: ['12hs', '15hs']\n    }\n  }\n];\n\n// ─── QR ───────────────────────────────────────────────\nconst QR_DIR = path.join(__dirname, '..', '..', 'public', 'qr');\nconst QR_BASE_URL = 'https://vps-4455523-x.dattaweb.com/caminosysabores/qr';\n\nfunction generarQRFileSync(codigo) {\n  const validateUrl = `https://vps-4455523-x.dattaweb.com/caminosysabores/validate-taller.html?codigo=${codigo}`;\n  try {\n    if (!fs.existsSync(QR_DIR)) fs.mkdirSync(QR_DIR, { recursive: true });\n    const filePath = path.join(QR_DIR, `${codigo}.png`);\n    QRCode.toDataURL(validateUrl, {\n      width: 160, margin: 2, color: { dark: '#000000', light: '#ffffff' }\n    }).then(dataUrl => {\n      const base64Data = dataUrl.replace(/^data:image\\/png;base64,/, '');\n      fs.writeFileSync(filePath, Buffer.from(base64Data, 'base64'));\n    }).catch(err => {\n      console.error('Error generando QR taller:', err.message);\n    });\n    return `${QR_BASE_URL}/${codigo}.png`;\n  } catch (err) {\n    console.error('Error generando QR taller:', err.message);\n    return '';\n  }\n}\n\n// ─── HELPERS ───────────────────────────────────────────\nfunction ensureDir() {\n  const dir = path.dirname(TALLERES_FILE);\n  if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true });\n}\n\nfunction loadRegistros() {\n  ensureDir();\n  if (!fs.existsSync(TALLERES_FILE)) return [];\n  try { return JSON.parse(fs.readFileSync(TALLERES_FILE, 'utf-8')); }\n  catch { return []; }\n}\n\nfunction saveRegistros(data) {\n  ensureDir();\n  fs.writeFileSync(TALLERES_FILE, JSON.stringify(data, null, 2), 'utf-8');\n}\n\nfunction loadConfig() {\n  if (!fs.existsSync(CONFIG_FILE)) return {};\n  try { return JSON.parse(fs.readFileSync(CONFIG_FILE, 'utf-8')); }\n  catch { return {}; }\n}\n\nfunction saveConfig(data) {\n  const dir = path.dirname(CONFIG_FILE);\n  if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true });\n  fs.writeFileSync(CONFIG_FILE, JSON.stringify(data, null, 2), 'utf-8');\n}\n\nfunction generarCodigo() {\n  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';\n  let code = 'TAL-';\n  for (let i = 0; i < 6; i++) code += chars[crypto.randomInt(chars.length)];\n  const registros = loadRegistros();\n  if (registros.some(r => r.codigo === code)) return generarCodigo();\n  return code;\n}\n\nfunction getCapacidad(tallerId, dia, horario) {\n  const config = loadConfig();\n  const key = `${tallerId}|${dia}|${horario}`;\n  return config[key] || config.default || 15;\n}\n\nasync function sendConfirmacionMail(correo, nombre, tallerId, dia, horario, codigo, cuposLlenos) {\n  const transport = createTransport();\n  if (!transport) {\n    console.log(`  [Talleres] Mail NO enviado (sin SMTP). Para: ${correo}`);\n    return false;\n  }\n\n  const taller = TALLERES.find(t => t.id === tallerId);\n  const tallerNombre = taller ? taller.nombre : tallerId;\n  const diaMap = { jueves: 'Jueves', viernes: 'Viernes', sabado: 'Sábado', domingo: 'Domingo' };\n  const diaLabel = diaMap[dia] || dia;\n  const qrUrl = generarQRFileSync(codigo);\n  const selloImgUrl = 'https://vps-4455523-x.dattaweb.com/caminosysabores/selloparqueischigualasto.png';\n\n  const estadoHTML = cuposLlenos\n    ? `<div style=\"background:rgba(255,165,0,0.15);border:1px solid #ffa500;border-radius:10px;padding:12px;margin:12px 0;text-align:center;\">\n        <p style=\"color:#ffa500;font-weight:700;font-size:16px;margin:0 0 4px;\">CUPOS COMPLETOS</p>\n        <p style=\"color:rgba(240,235,216,0.7);font-size:13px;margin:0;\">Te inscribimos en lista de espera. Si se libera un lugar, te notificaremos a este correo.</p>\n       </div>`\n    : '';\n\n  try {\n    await transport.sendMail({\n      from: MAIL_FROM, to: correo,\n      subject: `Confirmación - ${tallerNombre} - Caminos y Sabores`,\n      html: `<!DOCTYPE html>\n<html>\n<head><meta charset=\"UTF-8\"></head>\n<body style=\"margin:0;padding:0;background:#f5f0eb;\">\n<div style=\"max-width:460px;margin:20px auto;font-family:'Segoe UI',Arial,sans-serif;background:linear-gradient(160deg,#2d1f14,#1a0f0a);border-radius:20px;padding:30px 24px;text-align:center;border:1px solid rgba(227,101,59,0.3);\">\n  <img src=\"${selloImgUrl}\" alt=\"Sello Ischigualasto\" style=\"width:180px;height:auto;margin:0 auto 14px;display:block;border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,0.4);max-width:100%;\">\n  <h2 style=\"color:#ea8b34;font-size:20px;margin:0 0 6px;font-weight:400;line-height:1.3;\">¡Gracias por inscribirte, ${nombre}!</h2>\n  <p style=\"color:rgba(240,235,216,0.65);font-size:14px;margin:4px 0 2px;line-height:1.5;\">${tallerNombre}</p>\n  <p style=\"color:#ea8b34;font-size:16px;margin:2px 0 10px;font-weight:600;\">${diaLabel} - ${horario}</p>\n  ${estadoHTML}\n  <div style=\"margin:14px 0 0;padding-top:14px;border-top:1px solid rgba(227,101,59,0.2);text-align:center;\">\n    <p style=\"color:rgba(240,235,216,0.6);font-size:13px;margin:0 0 6px;\">Tu código de reserva</p>\n    <div style=\"display:inline-block;background:white;border-radius:10px;padding:6px;border:3px solid #c24d28;\">\n      ${qrUrl ? `<img src=\"${qrUrl}\" alt=\"QR Codigo\" style=\"display:block;width:160px;height:160px;\">` : '<div style=\"width:160px;height:160px;background:#eee;border-radius:6px;\"></div>'}\n    </div>\n    <p style=\"font-family:monospace;font-size:26px;font-weight:800;color:#ea8b34;letter-spacing:4px;margin:6px 0 2px;\">${codigo}</p>\n    <p style=\"font-size:13px;color:rgba(240,235,216,0.5);margin:0;\">Código único de reserva</p>\n  </div>\n  <p style=\"font-size:12px;color:rgba(240,235,216,0.3);margin:20px 0 0;padding:10px 0 0;border-top:1px solid rgba(227,101,59,0.15);\">Caminos y Sabores &ndash; San Juan, Argentina</p>\n</div>\n</body>\n</html>`\n    });\n    console.log(`  [Talleres] Mail enviado a ${correo} - ${tallerNombre} - Codigo: ${codigo}`);\n    return true;\n  } catch (err) {\n    console.error(`  [Talleres] Error enviando mail a ${correo}:`, err.message);\n    return false;\n  }\n}\n\n// ─── API ENDPOINTS ────────────────────────────────────\n\n// GET /api/talleres - list all registrations\nrouter.get('/', (req, res) => {\n  try {\n    const registros = loadRegistros();\n    registros.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));\n    res.json(registros);\n  } catch (err) {\n    res.status(500).json({ error: 'Error al cargar inscripciones' });\n  }\n});\n\n// GET /api/talleres/talleres - lista de talleres disponibles\nrouter.get('/talleres', (req, res) => {\n  res.json(TALLERES);\n});\n\n// POST /api/talleres/inscribir\nrouter.post('/inscribir', async (req, res) => {\n  try {\n    const { taller_id, dia, horario, nombre, email } = req.body;\n    if (!taller_id || !dia || !horario || !nombre || !email) {\n      return res.status(400).json({ error: 'Faltan campos obligatorios (taller_id, dia, horario, nombre, email)' });\n    }\n\n    // Validate taller exists\n    const taller = TALLERES.find(t => t.id === taller_id);\n    if (!taller) return res.status(400).json({ error: 'Taller no encontrado' });\n\n    // Validate day\n    const diaMap = { jueves: 'jueves', viernes: 'viernes', sabado: 'sabado', domingo: 'domingo' };\n    if (!diaMap[dia]) return res.status(400).json({ error: 'Dia invalido' });\n\n    // Validate horario\n    const horariosValidos = taller.horarios[dia] || [];\n    if (!horariosValidos.includes(horario)) {\n      return res.status(400).json({ error: `Horario no valido para este taller. Disponibles: ${horariosValidos.join(', ')}` });\n    }\n\n    const registros = loadRegistros();\n    const codigo = generarCodigo();\n\n    // Check capacity\n    const capacidadMax = getCapacidad(taller_id, dia, horario);\n    const inscritos = registros.filter(r =>\n      r.taller_id === taller_id && r.dia === dia && r.horario === horario\n    ).length;\n    const cuposLlenos = inscritos >= capacidadMax;\n\n    const entry = {\n      id: Date.now().toString(36) + Math.random().toString(36).slice(2, 6),\n      taller_id, dia, horario, nombre, email,\n      codigo, cuposLlenos, escaneado: false, escaneadoAt: null,\n      createdAt: new Date().toISOString()\n    };\n\n    registros.push(entry);\n    saveRegistros(registros);\n\n    // Send email (non-blocking)\n    sendConfirmacionMail(email, nombre, taller_id, dia, horario, codigo, cuposLlenos);\n\n    res.status(201).json({\n      ok: true,\n      registro: entry,\n      codigo,\n      cuposLlenos,\n      mensaje: cuposLlenos\n        ? 'Te inscribimos en lista de espera (cupos completos)'\n        : 'Inscripción confirmada'\n    });\n  } catch (err) {\n    console.error('Error al inscribir:', err);\n    res.status(500).json({ error: 'Error al inscribir' });\n  }\n});\n\n// DELETE /api/talleres/:id\nrouter.delete('/:id', (req, res) => {\n  try {\n    let registros = loadRegistros();\n    const antes = registros.length;\n    registros = registros.filter(r => r.id !== req.params.id);\n    if (registros.length === antes) return res.status(404).json({ error: 'Inscripcion no encontrada' });\n    saveRegistros(registros);\n    res.json({ ok: true });\n  } catch (err) {\n    res.status(500).json({ error: 'Error al eliminar' });\n  }\n});\n\n// GET /api/talleres/config\nrouter.get('/config', (req, res) => {\n  res.json(loadConfig());\n});\n\n// POST /api/talleres/config\nrouter.post('/config', (req, res) => {\n  try {\n    const { key, value, default: defValue } = req.body;\n    const config = loadConfig();\n    if (key) {\n      config[key] = parseInt(value) || 15;\n    }\n    if (defValue !== undefined) {\n      config.default = parseInt(defValue) || 15;\n    }\n    saveConfig(config);\n    res.json({ ok: true, config });\n  } catch (err) {\n    res.status(500).json({ error: 'Error al guardar config' });\n  }\n});\n\n// GET /api/talleres/validate/:codigo\nrouter.get('/validate/:codigo', (req, res) => {\n  try {\n    const registros = loadRegistros();\n    const reg = registros.find(r => r.codigo === req.params.codigo);\n    if (!reg) return res.status(404).json({ error: 'Codigo no encontrado', valido: false });\n    const taller = TALLERES.find(t => t.id === reg.taller_id);\n    const diaMap = { jueves: 'Jueves', viernes: 'Viernes', sabado: 'Sábado', domingo: 'Domingo' };\n    res.json({\n      valido: true, escaneado: reg.escaneado, escaneadoAt: reg.escaneadoAt,\n      nombre: reg.nombre, email: reg.email,\n      taller: taller ? taller.nombre : reg.taller_id,\n      dia: diaMap[reg.dia] || reg.dia, horario: reg.horario,\n      cuposLlenos: reg.cuposLlenos, codigo: reg.codigo, createdAt: reg.createdAt\n    });\n  } catch (err) {\n    res.status(500).json({ error: 'Error al validar' });\n  }\n});\n\n// POST /api/talleres/scan/:codigo\nrouter.post('/scan/:codigo', (req, res) => {\n  try {\n    const registros = loadRegistros();\n    const idx = registros.findIndex(r => r.codigo === req.params.codigo);\n    if (idx === -1) return res.status(404).json({ error: 'Codigo no encontrado' });\n    if (registros[idx].escaneado) {\n      return res.json({\n        ok: false, yaUtilizado: true,\n        mensaje: 'Este codigo ya fue utilizado',\n        escaneadoAt: registros[idx].escaneadoAt\n      });\n    }\n    registros[idx].escaneado = true;\n    registros[idx].escaneadoAt = new Date().toISOString();\n    saveRegistros(registros);\n    res.json({ ok: true, mensaje: 'Reserva validada correctamente' });\n  } catch (err) {\n    res.status(500).json({ error: 'Error al escanear' });\n  }\n});\n\nmodule.exports = router;\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/public/js/actividad-detalle.js",
          "name": "actividad-detalle.js",
          "content": "// ============================================================\r\n// ACTIVIDAD DETALLE - Schedule + Taller Registration\r\n// ============================================================\r\n\r\n(function() {\r\n  // Detect API base\r\n  function getApiBase() {\r\n    const hostname = window.location.hostname;\r\n    if (hostname === 'fullscreencode.com' || hostname.endsWith('.ferozo.com'))\r\n      return 'https://vps-4455523-x.dattaweb.com/caminosysabores';\r\n    return window.location.origin;\r\n  }\r\n  const API_BASE = getApiBase();\r\n\r\n  // ─── Animations ──────────────────────────────────────\r\n  const prefersReducedMotion = window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\r\n  if (!prefersReducedMotion) {\r\n    const animatedText = document.querySelectorAll(\r\n      '.activity-copy > p, .detail-title, .detail-subtitle, .limited-cupos > *'\r\n    );\r\n    if (animatedText.length) {\r\n      const textObserver = new IntersectionObserver(\r\n        (entries) => {\r\n          entries.forEach((entry) => {\r\n            if (entry.isIntersecting) {\r\n              entry.target.classList.add('is-visible');\r\n              textObserver.unobserve(entry.target);\r\n            }\r\n          });\r\n        },\r\n        { threshold: 0.2, rootMargin: '0px 0px -30px 0px' }\r\n      );\r\n      animatedText.forEach((element, index) => {\r\n        element.style.transitionDelay = `${Math.min(index * 0.06, 0.24)}s`;\r\n        textObserver.observe(element);\r\n      });\r\n    }\r\n  }\r\n\r\n  // ─── Taller Registration System ──────────────────────\r\n  // Inject talleres style\r\n  const style = document.createElement('style');\r\n  style.textContent = `\r\n.taller-form-overlay {\r\n  display:none; position:fixed; inset:0;\r\n  background:rgba(0,0,0,0.55); backdrop-filter:blur(4px);\r\n  z-index:9998; align-items:center; justify-content:center;\r\n}\r\n.taller-form-overlay.show{display:flex}\r\n.taller-form-modal {\r\n  background:#fff; border-radius:16px; padding:28px 24px 20px;\r\n  max-width:400px; width:90%; text-align:center;\r\n  animation:tallerFadeIn 0.3s ease;\r\n  box-shadow:0 8px 40px rgba(0,0,0,0.2);\r\n}\r\n@keyframes tallerFadeIn{from{opacity:0;transform:scale(0.92)}to{opacity:1;transform:scale(1)}}\r\n.taller-form-modal h3{\r\n  margin:0 0 4px; font-family:\"Ubuntu\",sans-serif;\r\n  font-size:1.1rem; font-weight:700; color:#222;\r\n}\r\n.taller-form-modal .taller-info{\r\n  font-size:0.85rem; color:#666; margin:0 0 16px;\r\n}\r\n.taller-form-modal .taller-info strong{color:#e6643c;}\r\n.taller-form-group{margin-bottom:12px;text-align:left;}\r\n.taller-form-group input{\r\n  width:100%; padding:11px 14px; border:1px solid #ddd;\r\n  border-radius:10px; font-size:0.9rem; font-family:inherit;\r\n  outline:none; box-sizing:border-box; transition:border-color 0.2s;\r\n}\r\n.taller-form-group input:focus{border-color:#e6643c;}\r\n.taller-form-group input::placeholder{color:#aaa;}\r\n.taller-btn{\r\n  width:100%; padding:12px 22px; border:none; border-radius:10px;\r\n  background:linear-gradient(135deg,#e6643c,#c24d28); color:white;\r\n  font-size:0.95rem; font-weight:700; font-family:inherit;\r\n  cursor:pointer; transition:all 0.2s; margin-top:4px;\r\n}\r\n.taller-btn:hover{transform:translateY(-1px);box-shadow:0 5px 20px rgba(230,100,60,0.4);}\r\n.taller-btn:disabled{opacity:0.5;cursor:default;transform:none;box-shadow:none;}\r\n.taller-error{color:#e74c3c;font-size:0.8rem;margin-top:6px;display:none;}\r\n.taller-error.show{display:block;}\r\n.taller-success{display:none; text-align:center; padding:10px 0;}\r\n.taller-success.show{display:block;}\r\n.taller-success .check{font-size:3rem;margin-bottom:8px;}\r\n.taller-success h4{color:#27ae60;margin:0 0 6px;font-size:1.1rem;}\r\n.taller-success p{color:#555;font-size:0.85rem;margin:2px 0;line-height:1.4;}\r\n.taller-success .codigo{\r\n  font-family:monospace; font-size:1.5rem; font-weight:800;\r\n  color:#e6643c; letter-spacing:3px; margin:8px 0 4px;\r\n}\r\n.taller-success .codigo-label{font-size:0.75rem;color:#999;}\r\n.taller-success .advertencia{\r\n  background:#fff3cd; border:1px solid #ffc107; border-radius:8px;\r\n  padding:8px 12px; margin:10px 0; font-size:0.8rem; color:#856404;\r\n}\r\n.taller-close-btn{\r\n  margin-top:12px; padding:6px 24px; border:1px solid #ddd;\r\n  border-radius:50px; background:transparent; color:#666;\r\n  font-size:0.85rem; font-family:inherit; cursor:pointer; transition:all 0.2s;\r\n}\r\n.taller-close-btn:hover{background:#f5f5f5;}\r\n\r\n/* Schedule-box clickable (opens registration form) */\r\n.schedule-box.has-form{cursor:pointer;}\r\n.schedule-box.has-form:hover{\r\n  transform:scale(1.05);\r\n  box-shadow:0 3px 12px rgba(0,0,0,0.12);\r\n}\r\n`;\r\n  document.head.appendChild(style);\r\n\r\n  // ─── HTML overlay for registration form ──────────────\r\n  const overlayHTML = `\r\n<div class=\"taller-form-overlay\" id=\"tallerFormOverlay\">\r\n  <div class=\"taller-form-modal\">\r\n    <div id=\"tallerFormContent\">\r\n      <h3 id=\"tallerFormTitle\">Inscripción</h3>\r\n      <p class=\"taller-info\" id=\"tallerFormInfo\">Completá tus datos para reservar tu lugar</p>\r\n      <div class=\"taller-form-group\">\r\n        <input type=\"text\" id=\"tallerNombreInput\" placeholder=\"Nombre\" autocomplete=\"name\">\r\n      </div>\r\n      <div class=\"taller-form-group\">\r\n        <input type=\"email\" id=\"tallerEmailInput\" placeholder=\"tu@correo.com\" autocomplete=\"email\">\r\n      </div>\r\n      <button class=\"taller-btn\" id=\"tallerSubmitBtn\">Reservar lugar</button>\r\n      <div class=\"taller-error\" id=\"tallerError\"></div>\r\n    </div>\r\n    <div class=\"taller-success\" id=\"tallerSuccess\">\r\n      <div class=\"check\">✅</div>\r\n      <h4>¡Reserva confirmada!</h4>\r\n      <p id=\"tallerSuccessInfo\"></p>\r\n      <div class=\"codigo\" id=\"tallerSuccessCodigo\">TAL-XXXXXX</div>\r\n      <p class=\"codigo-label\">Tu código único de reserva</p>\r\n      <div class=\"advertencia\" id=\"tallerAdvertencia\" style=\"display:none;\">\r\n        ⚠️ Los cupos para este horario están completos. Te inscribimos en lista de espera.\r\n        Si se libera un lugar, te notificaremos a tu correo.\r\n      </div>\r\n      <p style=\"font-size:0.8rem;color:#999;margin-top:6px;\">También te enviamos los detalles por mail.</p>\r\n      <button class=\"taller-close-btn\" onclick=\"document.getElementById('tallerFormOverlay').classList.remove('show')\">Cerrar</button>\r\n    </div>\r\n  </div>\r\n</div>`;\r\n\r\n  document.body.insertAdjacentHTML('beforeend', overlayHTML);\r\n\r\n  // ─── State ───────────────────────────────────────────\r\n  let currentTallerId = '';\r\n  let currentDia = '';\r\n  let currentHorario = '';\r\n  let submitting = false;\r\n\r\n  // ─── Open form ───────────────────────────────────────\r\n  window.inscribirTaller = function(tallerId, dia, horario) {\r\n    currentTallerId = tallerId;\r\n    currentDia = dia;\r\n    currentHorario = horario;\r\n\r\n    const overlay = document.getElementById('tallerFormOverlay');\r\n    document.getElementById('tallerFormContent').style.display = '';\r\n    document.getElementById('tallerSuccess').classList.remove('show');\r\n    document.getElementById('tallerError').classList.remove('show');\r\n    document.getElementById('tallerError').textContent = '';\r\n    document.getElementById('tallerNombreInput').value = '';\r\n    document.getElementById('tallerEmailInput').value = '';\r\n    document.getElementById('tallerSubmitBtn').disabled = false;\r\n    document.getElementById('tallerSubmitBtn').textContent = 'Reservar lugar';\r\n\r\n    const tallerNames = {\r\n      'taller-de-siembra': 'Taller de Siembra',\r\n      'aceite-de-oliva': 'De San Juan a la Mesa - Aceite de Oliva',\r\n      'vino': 'De San Juan a la Mesa - Vino',\r\n      'maridaje': 'Maridaje con Mauricio Savoca',\r\n      'senti-san-juan': 'Sentí San Juan'\r\n    };\r\n    const diaMap = { jueves: 'Jueves', viernes: 'Viernes', sabado: 'Sábado', domingo: 'Domingo' };\r\n    document.getElementById('tallerFormTitle').textContent = (tallerNames[tallerId] || tallerId);\r\n    document.getElementById('tallerFormInfo').innerHTML = `${diaMap[dia] || dia} - <strong>${horario}</strong>`;\r\n    overlay.classList.add('show');\r\n  };\r\n\r\n  // ─── Submit ──────────────────────────────────────────\r\n  document.getElementById('tallerSubmitBtn').addEventListener('click', async function() {\r\n    if (submitting) return;\r\n    const nombre = document.getElementById('tallerNombreInput').value.trim();\r\n    const email = document.getElementById('tallerEmailInput').value.trim();\r\n    const error = document.getElementById('tallerError');\r\n    const btn = this;\r\n\r\n    if (!nombre) { error.textContent = 'Ingresa tu nombre'; error.classList.add('show'); return; }\r\n    if (!email) { error.textContent = 'Ingresa tu correo electrónico'; error.classList.add('show'); return; }\r\n    if (!email.includes('@')) { error.textContent = 'Correo inválido'; error.classList.add('show'); return; }\r\n\r\n    error.classList.remove('show');\r\n    submitting = true;\r\n    btn.disabled = true;\r\n    btn.textContent = 'Enviando...';\r\n\r\n    try {\r\n      const res = await fetch(API_BASE + '/api/talleres/inscribir', {\r\n        method: 'POST',\r\n        headers: { 'Content-Type': 'application/json' },\r\n        body: JSON.stringify({\r\n          taller_id: currentTallerId,\r\n          dia: currentDia,\r\n          horario: currentHorario,\r\n          nombre, email\r\n        })\r\n      });\r\n      const data = await res.json();\r\n      if (data.ok) {\r\n        document.getElementById('tallerFormContent').style.display = 'none';\r\n        document.getElementById('tallerSuccessCodigo').textContent = data.codigo || 'TAL-ERR';\r\n\r\n        const tallerNames = {\r\n          'taller-de-siembra': 'Taller de Siembra',\r\n          'aceite-de-oliva': 'Aceite de Oliva',\r\n          'vino': 'Vino',\r\n          'maridaje': 'Maridaje',\r\n          'senti-san-juan': 'Sentí San Juan'\r\n        };\r\n        const diaMap = { jueves: 'Jueves', viernes: 'Viernes', sabado: 'Sábado', domingo: 'Domingo' };\r\n        document.getElementById('tallerSuccessInfo').textContent =\r\n          `${tallerNames[currentTallerId] || currentTallerId} - ${diaMap[currentDia] || currentDia} ${currentHorario}`;\r\n\r\n        const adv = document.getElementById('tallerAdvertencia');\r\n        if (data.cuposLlenos) {\r\n          adv.style.display = 'block';\r\n        } else {\r\n          adv.style.display = 'none';\r\n        }\r\n\r\n        document.getElementById('tallerSuccess').classList.add('show');\r\n      } else {\r\n        throw new Error(data.error || 'Error al inscribir');\r\n      }\r\n    } catch (err) {\r\n      error.textContent = err.message || 'Error de conexión. Intenta de nuevo.';\r\n      error.classList.add('show');\r\n      btn.disabled = false;\r\n      btn.textContent = 'Reservar lugar';\r\n    } finally {\r\n      submitting = false;\r\n    }\r\n  });\r\n\r\n  // ─── Close on backdrop click ─────────────────────────\r\n  document.getElementById('tallerFormOverlay').addEventListener('click', function(e) {\r\n    if (e.target === this) this.classList.remove('show');\r\n  });\r\n\r\n  // ─── Enter key handlers ─────────────────────────────\r\n  document.getElementById('tallerEmailInput').addEventListener('keydown', function(e) {\r\n    if (e.key === 'Enter') { e.preventDefault(); document.getElementById('tallerSubmitBtn').click(); }\r\n  });\r\n  document.getElementById('tallerNombreInput').addEventListener('keydown', function(e) {\r\n    if (e.key === 'Enter') { e.preventDefault(); document.getElementById('tallerEmailInput').focus(); }\r\n  });\r\n\r\n  // ─── Schedule Grid - Inject forms ──────────────────\r\n  document.querySelectorAll('.event-invite').forEach((invite) => {\r\n    const tabs = Array.from(invite.querySelectorAll('.day-tab'));\r\n    const scheduleGrid = invite.querySelector('.schedule-grid');\r\n    if (!tabs.length || !scheduleGrid) return;\r\n\r\n    const tallerId = invite.dataset.tallerId;\r\n    const isFilled = invite.dataset.variant === 'filled';\r\n    const defaultDay = invite.dataset.defaultDay || tabs[0].dataset.day;\r\n\r\n    const getTimesForDay = (dayKey) => {\r\n      const rawValue = scheduleGrid.getAttribute(`data-schedule-${dayKey}`) || '';\r\n      return rawValue.split('|').map(v => v.trim()).filter(Boolean);\r\n    };\r\n\r\n    const renderTimes = (dayKey) => {\r\n      const times = getTimesForDay(dayKey);\r\n      scheduleGrid.innerHTML = times.map((time) => `\r\n        <div class=\"schedule-box${isFilled ? ' filled' : ''}${tallerId ? ' has-form' : ''}\"\r\n             onclick=\"${tallerId ? `inscribirTaller('${tallerId}','${dayKey}','${time}')` : ''}\">${time}</div>\r\n      `).join('');\r\n    };\r\n\r\n    const setActiveDay = (dayKey) => {\r\n      tabs.forEach((tab) => tab.classList.toggle('active', tab.dataset.day === dayKey));\r\n      scheduleGrid.classList.add('is-changing');\r\n      window.setTimeout(() => {\r\n        renderTimes(dayKey);\r\n        window.requestAnimationFrame(() => scheduleGrid.classList.remove('is-changing'));\r\n      }, 220);\r\n    };\r\n\r\n    tabs.forEach((tab) => tab.addEventListener('click', () => setActiveDay(tab.dataset.day)));\r\n    setActiveDay(defaultDay);\r\n  });\r\n\r\n  console.log('Actividad-detalle + Talleres registration loaded.');\r\n})();\r\n"
        },
