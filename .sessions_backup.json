        {
          "path": "D:/Programacion/caminosysabores/public/maqueta/app.js",
          "name": "app.js",
          "content": "\r\n        import * as THREE from 'three';\r\n        import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';\r\n        import { TransformControls } from 'three/addons/controls/TransformControls.js';\r\n        import { EffectComposer } from 'three/addons/postprocessing/EffectComposer.js';\r\n        import { RenderPass } from 'three/addons/postprocessing/RenderPass.js';\r\n        import { UnrealBloomPass } from 'three/addons/postprocessing/UnrealBloomPass.js';\r\n        import { SMAAPass } from 'three/addons/postprocessing/SMAAPass.js';\r\n        import { OutputPass } from 'three/addons/postprocessing/OutputPass.js';\r\n\r\n        const CFG = {\r\n            friction:0.92, minPitch:0.1, maxPitch:Math.PI/2.2,\r\n            minDist:2, maxDist:1000, defaultDist:16.4,\r\n            defaultYaw:-0.4, defaultPitch:0.83,\r\n            modelScale:1,\r\n            defaultModelScale:1,\r\n        };\r\n\r\n        const container = document.getElementById('c');\r\n        const scene = new THREE.Scene();\r\n        scene.background = new THREE.Color(0x5A2828);\r\n        const camera = new THREE.PerspectiveCamera(45, window.innerWidth/window.innerHeight, 0.1, 2000);\r\n        const renderer = new THREE.WebGLRenderer({ antialias:true, alpha:false });\r\n        renderer.setSize(window.innerWidth, window.innerHeight);\r\n        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\r\n        renderer.toneMapping = THREE.ACESFilmicToneMapping;\r\n        renderer.toneMappingExposure = 1.1;\r\n        container.appendChild(renderer.domElement);\r\n\r\n        // EffectComposer for post-processing\r\n        const composer = new EffectComposer(renderer);\r\n        const renderPass = new RenderPass(scene, camera);\r\n        composer.addPass(renderPass);\r\n\r\n        // SMAA Anti-Aliasing - suaviza bordes cerruchados\r\n        const smaaPass = new SMAAPass(window.innerWidth, window.innerHeight);\r\n        composer.addPass(smaaPass);\r\n\r\n        // Subtle Bloom for professional cinematic glow\r\n        const bloomPass = new UnrealBloomPass(\r\n            new THREE.Vector2(window.innerWidth, window.innerHeight),\r\n            0.25,   // strength - subtle\r\n            0.4,    // radius\r\n            0.85    // threshold - only bloom bright areas\r\n        );\r\n        composer.addPass(bloomPass);\r\n\r\n        // Output pass for proper color space handling\r\n        const outputPass = new OutputPass();\r\n        composer.addPass(outputPass);\r\n\r\n        // Transform Controls for edit mode\r\n        const transformControls = new TransformControls(camera, renderer.domElement);\r\n        transformControls.setSize(0.45);\r\n        transformControls.setSpace('world');\r\n        transformControls.enabled = false;\r\n        transformControls.setTranslationSnap(null);\r\n        scene.add(transformControls._root);\r\n        let editMode = false;\r\n        let editAttachedIdx = -1;\r\n        // Temporary elevated target for the gizmo (offset Y so it floats above terrain)\r\n        const gizmoTarget = new THREE.Object3D();\r\n        scene.add(gizmoTarget);\r\n        // Debug cube to verify position\r\n        const debugGeo = new THREE.SphereGeometry(0.2, 16, 16);\r\n        const debugMat = new THREE.MeshBasicMaterial({color: 0xff0000});\r\n        const debugMarker = new THREE.Mesh(debugGeo, debugMat);\r\n        debugMarker.visible = false;\r\n        scene.add(debugMarker);\r\n        // Expose for debugging\r\n        window.__tc = transformControls;\r\n        window.__gt = gizmoTarget;\r\n        window.__dm = debugMarker;\r\n        window.__tcDebug = function(idx) {\r\n            if (idx === undefined) idx = 0;\r\n            const mesh = S.poiMeshes[idx];\r\n            if (!mesh) { console.log('no mesh at', idx); return; }\r\n            console.log('POI mesh pos:', mesh.position.toArray());\r\n            gizmoTarget.position.copy(mesh.position);\r\n            gizmoTarget.position.y += 0.6;\r\n            transformControls.attach(gizmoTarget);\r\n            debugMarker.position.copy(gizmoTarget.position);\r\n            debugMarker.visible = true;\r\n            console.log('gizmoTarget pos:', gizmoTarget.position.toArray(), 'attached:', transformControls.object ? 'yes' : 'no');\r\n        };\r\n        transformControls.addEventListener('dragging-changed', (ev) => {\r\n            S.isDrag = ev.value; // block orbit while dragging gizmo\r\n        });\r\n        transformControls.addEventListener('change', () => {\r\n            if (editAttachedIdx >= 0 && S.poiMeshes[editAttachedIdx]) {\r\n                const gtPos = gizmoTarget.position;\r\n                const idx = editAttachedIdx;\r\n                // Write position to POI mesh (remove gizmo Y offset)\r\n                const px = gtPos.x, py = gtPos.y - 0.6, pz = gtPos.z;\r\n                const mesh = S.poiMeshes[idx];\r\n                if (mesh) {\r\n                    mesh.position.set(px, py, pz);\r\n                }\r\n                if (S.poiData[idx]) {\r\n                    S.poiData[idx].position = [px, py, pz];\r\n                }\r\n                // Update the sprite (cartelito) position\r\n                const SIGN_HEIGHT = 1.8;\r\n                const sprite = S.poiConeMeshes[idx];\r\n                if (sprite) {\r\n                    sprite.position.set(px, py + SIGN_HEIGHT, pz);\r\n                }\r\n                if (S.poiFloatBase[idx] !== undefined) {\r\n                    S.poiFloatBase[idx] = py + SIGN_HEIGHT;\r\n                }\r\n                // Update the white thread (vertical line)\r\n                const thread = S.poiThreads[idx];\r\n                if (thread) {\r\n                    const lineHeight = SIGN_HEIGHT - 0.15;\r\n                    thread.position.set(px, py + lineHeight / 2, pz);\r\n                }\r\n                // Update the energy dot (used for hover animation on thread)\r\n                const energyDot = S.poiEnergyDots[idx];\r\n                if (energyDot) {\r\n                    energyDot.position.set(px, py, pz);\r\n                }\r\n                // Update the base dot (small white glow at terrain level)\r\n                // (poiBaseDots reference — find by proximity to mesh)\r\n                scene.children.forEach(child => {\r\n                    if (child.userData && child.userData.poiIndex === idx && child.geometry && child.geometry.type === 'SphereGeometry' && child !== mesh && child !== energyDot) {\r\n                        child.position.set(px, py + 0.05, pz);\r\n                    }\r\n                });\r\n                // Update the decorative ring around the sphere\r\n                scene.children.forEach(child => {\r\n                    if (child.userData && child.userData.poiIndex === idx && child.geometry && child.geometry.type === 'TorusGeometry') {\r\n                        child.position.set(px, py, pz);\r\n                    }\r\n                });\r\n            }\r\n        });\r\n\r\n        const S = {\r\n            yaw:CFG.defaultYaw, pitch:CFG.defaultPitch, dist:CFG.defaultDist,\r\n            tYaw:CFG.defaultYaw, tPitch:CFG.defaultPitch, tDist:CFG.defaultDist,\r\n            vY:0, vP:0, vD:0, isDrag:false, lX:0, lY:0,\r\n            isDown:false, moved:false, pX:0, pY:0, lights:{},\r\n            poiData:[], poiMeshes:[], poiConeMeshes:[], poiThreads:[], poiEnergyDots:[], poiFloatBase:[],\r\n            poiScaleTarget:[], poiScaleCurrent:[],\r\n            poiSpriteScaleTarget:[], poiSpriteScaleCurrent:[],\r\n            ray:new THREE.Raycaster(), ptr:new THREE.Vector2(),\r\n            mouse:new THREE.Vector2(), hoveredPOI:null,\r\n            frameCount:0, lastFpsTime:0,\r\n            autoRotate:true, autoRotateSpeed:0.15, idleTimer:0, idleTimeout:5,\r\n            camTarget:new THREE.Vector3(0,0.2,0), camTargetCurrent:new THREE.Vector3(0,0.2,0),\r\n            camAnimating:false,\r\n            lastClickedPoiIdx:-1,\r\n            introActive:true,\r\n            prevCamState:{dist:0, pitch:0, yaw:0, target:new THREE.Vector3(0,0.2,0)},\r\n        };\r\n\r\n        // LIGHTS - warm terracota palette\r\n        const LIGHT_DEFAULTS = {\r\n            ambient: { color: 0xcc8877, intensity: 0.6, maxIntensity: 5 },\r\n            main:    { color: 0xffcc99, intensity: 2.0, maxIntensity: 5 },\r\n            fill:    { color: 0xcc9988, intensity: 0.4, maxIntensity: 3 },\r\n            rim:     { color: 0xffb088, intensity: 0.3, maxIntensity: 3 },\r\n        };\r\n        const LIGHT_STATE = {};\r\n        function createLight(key, def) {\r\n            const isAmbient = key === 'ambient';\r\n            const light = isAmbient\r\n                ? new THREE.AmbientLight(def.color, def.intensity)\r\n                : new THREE.DirectionalLight(def.color, def.intensity);\r\n            scene.add(light);\r\n            S.lights[key] = light;\r\n            LIGHT_STATE[key] = { on: true, intensity: def.intensity, color: '#' + def.color.toString(16).padStart(6, '0') };\r\n            if (!isAmbient) {\r\n                const positions = {\r\n                    main:  new THREE.Vector3(12, 20, 8),\r\n                    fill:  new THREE.Vector3(-8, 5, -12),\r\n                    rim:   new THREE.Vector3(0, -10, 15),\r\n                };\r\n                light.position.copy(positions[key] || new THREE.Vector3(5, 10, 5));\r\n            }\r\n            return light;\r\n        }\r\n        Object.keys(LIGHT_DEFAULTS).forEach(k => createLight(k, LIGHT_DEFAULTS[k]));\r\n\r\n        // POST-PROCESSING state\r\n        const POSTPO_STATE = {\r\n            bloomStrength: 0.25,\r\n            bloomRadius: 0.4,\r\n            bloomThreshold: 0.85,\r\n            exposure: 1.1,\r\n            smaaEnabled: true,\r\n        };\r\n        function applyPostpoState() {\r\n            bloomPass.strength = POSTPO_STATE.bloomStrength;\r\n            bloomPass.radius = POSTPO_STATE.bloomRadius;\r\n            bloomPass.threshold = POSTPO_STATE.bloomThreshold;\r\n            renderer.toneMappingExposure = POSTPO_STATE.exposure;\r\n            smaaPass.enabled = POSTPO_STATE.smaaEnabled;\r\n        }\r\n\r\n        // STARS\r\n        const starGeo = new THREE.BufferGeometry();\r\n        const sc2 = 3000; const sa = new Float32Array(sc2*3);\r\n        for(let i=0;i<sc2*3;i++) sa[i]=(Math.random()-0.5)*200;\r\n        starGeo.setAttribute('position', new THREE.BufferAttribute(sa,3));\r\n        const sm = new THREE.PointsMaterial({color:0xffffff,size:0.15,transparent:true,opacity:0.6,sizeAttenuation:true});\r\n        const stars = new THREE.Points(starGeo, sm);\r\n        stars.position.y = 20; scene.add(stars);\r\n        scene.fog = new THREE.FogExp2(0x5A2828, 0.005);\r\n\r\n        // Hemisphere light for natural sky/ground variation\r\n        const hemiLight = new THREE.HemisphereLight(0xcc8866, 0x5A2828, 0.5);\r\n        scene.add(hemiLight);\r\n        LIGHT_STATE.hemi = { on: true, intensity: 0.5, color: '#cc8866', groundColor: '#5A2828' };\r\n\r\n        function updateCam() {\r\n            const th = S.yaw;\r\n            const ph = Math.PI/2 - S.pitch;\r\n            camera.position.x = S.dist * Math.sin(ph) * Math.sin(th) + S.camTargetCurrent.x;\r\n            camera.position.y = S.dist * Math.cos(ph) + S.camTargetCurrent.y;\r\n            camera.position.z = S.dist * Math.sin(ph) * Math.cos(th) + S.camTargetCurrent.z;\r\n            camera.lookAt(S.camTargetCurrent);\r\n        }\r\n\r\n        // === NOISE TEXTURE GENERATOR ===\r\n        function createNoiseTexture(w, h, scale) {\r\n            const canvas = document.createElement('canvas');\r\n            canvas.width = w; canvas.height = h;\r\n            const ctx = canvas.getContext('2d');\r\n            const imgData = ctx.createImageData(w, h);\r\n            for (let y = 0; y < h; y++) {\r\n                for (let x = 0; x < w; x++) {\r\n                    const i = (y * w + x) * 4;\r\n                    // Value noise\r\n                    const sx = x / scale, sy = y / scale;\r\n                    const v = (Math.sin(sx * 12.9898 + sy * 78.233) * 43758.5453) % 1;\r\n                    const noise = Math.abs(v) * 0.5 + 0.3;\r\n                    const val = Math.min(255, Math.max(0, noise * 255));\r\n                    imgData.data[i] = val;\r\n                    imgData.data[i+1] = val * 0.85;\r\n                    imgData.data[i+2] = val * 0.6;\r\n                    imgData.data[i+3] = 255;\r\n                }\r\n            }\r\n            ctx.putImageData(imgData, 0, 0);\r\n            const tex = new THREE.CanvasTexture(canvas);\r\n            tex.wrapS = tex.wrapT = THREE.RepeatWrapping;\r\n            tex.repeat.set(15, 15);\r\n            tex.anisotropy = 4;\r\n            return tex;\r\n        }\r\n\r\n        // === LOADING ===\r\n        const ld = document.createElement('div');\r\n        ld.style.cssText = 'position:fixed;inset:0;z-index:50;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#5A2828;color:#F0E6DC;font-family:\"Segoe UI\",sans-serif;';\r\n        ld.innerHTML = '<div style=\"font-size:14px;letter-spacing:1px;text-transform:uppercase;opacity:0.6;margin-bottom:16px;\">Cargando San Juan</div><div style=\"width:200px;height:2px;background:rgba(255,255,255,0.1);border-radius:2px;overflow:hidden;\"><div id=\"lb2\" style=\"width:0%;height:100%;background:linear-gradient(90deg,#E6643C,#C8A064,#5078B4);transition:width 0.3s;\"></div></div><div style=\"font-size:12px;margin-top:12px;opacity:0.4;\" id=\"lt2\">Preparando...</div>';\r\n        document.body.appendChild(ld);\r\n\r\n        // === LOAD MODEL ===\r\n        const loader = new GLTFLoader();\r\n        const noiseTex = createNoiseTexture(512, 512, 8);\r\n        \r\n        loader.load('./san_juan_territorio.glb',\r\n            (gltf) => {\r\n                S.model = gltf.scene;\r\n                S.model.scale.set(CFG.modelScale,CFG.modelScale,CFG.modelScale);\r\n                S.model.traverse(n => {\r\n                    if (n.isMesh) {\r\n                        n.castShadow = false; n.receiveShadow = false;\r\n                        if (n.material) {\r\n                            const ms = Array.isArray(n.material) ? n.material : [n.material];\r\n                            ms.forEach(m => {\r\n                                    m.roughness = Math.min(m.roughness||0.8, 0.95);\r\n                                    m.vertexColors = true;\r\n                                    m.needsUpdate = true;\r\n                            });\r\n                        }\r\n                    }\r\n                });\r\n                scene.add(S.model);\r\n                \r\n                // Load config from maqueta_config.json\r\n                loadConfig();\r\n                \r\n                // Load POI data\r\n                fetch('./pois.json').then(r=>r.json()).then(d => {\r\n                    S.poiData = d;\r\n                    createPoiSpheres(d);\r\n                    addPoiMarkers();\r\n                    // If edit mode is active, auto-attach to first POI\r\n                    if (editMode && S.poiMeshes.length > 0 && editAttachedIdx < 0) {\r\n                        attachControlsToPoi(0);\r\n                    }\r\n                }).catch(() => {\r\n                    console.error('Failed to load pois.json');\r\n                });\r\n                \r\n                setTimeout(()=>{\r\n                    ld.style.opacity='0';\r\n                    ld.style.transition='opacity 0.5s';\r\n                    setTimeout(()=>ld.remove(),500);\r\n                },300);\r\n                updateCam();\r\n            },\r\n            (xhr) => {\r\n                const pct = Math.round((xhr.loaded/xhr.total)*100);\r\n                const bar = document.getElementById('lb2');\r\n                const txt = document.getElementById('lt2');\r\n                if (bar) bar.style.width = pct+'%';\r\n                if (txt) {\r\n                    const msgs = ['Preparando...','Cargando relieve...','Aplicando texturas...','Ubicando puntos...','Casi listo...'];\r\n                    txt.textContent = msgs[Math.min(Math.floor(pct/20),4)];\r\n                }\r\n            },\r\n            (err) => {\r\n                console.error('Error:', err);\r\n                ld.innerHTML = '<div style=\"color:#E6643C;font-size:16px;\">Error al cargar</div><button onclick=\"location.reload()\" style=\"margin-top:20px;padding:10px 24px;border:1px solid rgba(240,230,208,0.3);background:transparent;color:#F0E6DC;border-radius:8px;cursor:pointer;\">Reintentar</button>';\r\n            }\r\n        );\r\n\r\n        // === CREATE POI SPHERE MESHES from pois.json positions ===\r\n        function createPoiSpheres(poiData) {\r\n            poiData.forEach((poi, idx) => {\r\n                const pos = new THREE.Vector3(poi.position[0], poi.position[1], poi.position[2]);\r\n                const pc = poi.color || [0.9, 0.33, 0.21];\r\n                // Circuit color\r\n                const circuitRGB = new THREE.Color(pc[0], pc[1], pc[2]);\r\n                const sphereGeo = new THREE.SphereGeometry(0.15, 32, 24);\r\n                const sphereMat = new THREE.MeshStandardMaterial({\r\n                    color: circuitRGB,\r\n                    emissive: circuitRGB,\r\n                    emissiveIntensity: 0.8,\r\n                    roughness: 0.3,\r\n                    metalness: 0.1\r\n                });\r\n                const sphere = new THREE.Mesh(sphereGeo, sphereMat);\r\n                sphere.position.copy(pos);\r\n                sphere.userData = {poiIndex: idx};\r\n                sphere.castShadow = false;\r\n                sphere.receiveShadow = false;\r\n                scene.add(sphere);\r\n                S.poiMeshes.push(sphere);\r\n                S.poiScaleTarget.push(1);\r\n                S.poiScaleCurrent.push(1);\r\n                \r\n                // Ring decorativo del color del circuito\r\n                const ringGeo = new THREE.TorusGeometry(0.15 * 1.6, 0.015, 8, 24);\r\n                const ringMat = new THREE.MeshBasicMaterial({\r\n                    color: circuitRGB, transparent: true, opacity: 0.4\r\n                });\r\n                const ring = new THREE.Mesh(ringGeo, ringMat);\r\n                ring.position.copy(pos);\r\n                ring.rotation.x = Math.PI / 2;\r\n                ring.userData = {poiIndex: idx};\r\n                scene.add(ring);\r\n            });\r\n        }\r\n\r\n        // === ADD POI MARKERS (white line + green cartelito) ===\r\n        function addPoiMarkers() {\r\n            const sphereMeshes = S.poiMeshes;\r\n            S.poiConeMeshes = [];\r\n            S.poiThreads = [];\r\n            \r\n            const SIGN_HEIGHT = 1.8;\r\n            \r\n            sphereMeshes.forEach((sphere, idx) => {\r\n                const wp = sphere.position.clone();\r\n                const poiName = S.poiData[idx] ? S.poiData[idx].name : '';\r\n                \r\n                // White vertical line (thread) from terrain to sign\r\n                const lineHeight = SIGN_HEIGHT - 0.15;\r\n                const threadGeo = new THREE.CylinderGeometry(0.04, 0.04, lineHeight, 4);\r\n                const threadMat = new THREE.MeshBasicMaterial({\r\n                    color: 0xffffff, transparent: true, opacity: 0.5,\r\n                    depthWrite: false\r\n                });\r\n                const thread = new THREE.Mesh(threadGeo, threadMat);\r\n                thread.position.set(wp.x, wp.y + lineHeight / 2, wp.z);\r\n                thread.userData = {poiIndex: idx};\r\n                scene.add(thread);\r\n                S.poiThreads.push(thread);\r\n                \r\n                // Cartelito con imagen transparente + texto (Sprite with CanvasTexture)\r\n                const canvas = document.createElement('canvas');\r\n                canvas.width = 360;\r\n                canvas.height = 420;\r\n                const ctx = canvas.getContext('2d');\r\n                const CANVAS_W = 360, CANVAS_H = 420;\r\n                \r\n                // Limpiar a transparente\r\n                ctx.clearRect(0, 0, CANVAS_W, CANVAS_H);\r\n                \r\n                // Badge semitransparente solo para el texto (tipo tag flotante arriba)\r\n                let fSize = 34;\r\n                if (poiName.length > 18) fSize = 24;\r\n                else if (poiName.length > 12) fSize = 28;\r\n                ctx.font = `700 ${fSize}px 'Ubuntu', 'Segoe UI', system-ui, sans-serif`;\r\n                const textW = ctx.measureText(poiName).width;\r\n                const badgePadX = 18, badgePadY = 8;\r\n                const badgeW = textW + badgePadX * 2;\r\n                const badgeH = fSize + badgePadY * 2;\r\n                const badgeX = (CANVAS_W - badgeW) / 2;\r\n                const badgeY = 10;\r\n                \r\n                // Sombra suave del badge\r\n                ctx.shadowColor = 'rgba(0,0,0,0.6)';\r\n                ctx.shadowBlur = 20;\r\n                ctx.shadowOffsetY = 4;\r\n                ctx.fillStyle = 'rgba(20,16,14,0.75)';\r\n                ctx.beginPath();\r\n                ctx.roundRect(badgeX, badgeY, badgeW, badgeH, 8);\r\n                ctx.fill();\r\n                \r\n                // Texto blanco con sombra para mejor legibilidad\r\n                ctx.shadowColor = 'rgba(0,0,0,0.8)';\r\n                ctx.shadowBlur = 12;\r\n                ctx.shadowOffsetX = 0;\r\n                ctx.shadowOffsetY = 2;\r\n                ctx.textAlign = 'center';\r\n                ctx.textBaseline = 'middle';\r\n                ctx.fillStyle = '#f0e6d0';\r\n                ctx.fillText(poiName, CANVAS_W / 2, badgeY + badgeH / 2);\r\n                // Reset shadow\r\n                ctx.shadowColor = 'transparent'; ctx.shadowBlur = 0; ctx.shadowOffsetX = 0; ctx.shadowOffsetY = 0;\r\n                \r\n                // Cargar imagen del POI desde iconosmaqueta/ o poi_images/\r\n                const imgSrc = S.poiData[idx] && S.poiData[idx].image\r\n                    ? `./iconosmaqueta/${S.poiData[idx].image}`\r\n                    : `./poi_images/0.png`;\r\n                \r\n                // La imagen se dibuja directo, sin fondo, respetando su transparencia\r\n                const imgY = badgeY + badgeH + 10;\r\n                const imgAreaH = CANVAS_H - imgY - 12;\r\n                const imgAreaW = CANVAS_W - 24;\r\n                \r\n                // Cargar imagen y redibujar cuando esté lista\r\n                const img = new Image();\r\n                img.crossOrigin = 'anonymous';\r\n                img.onload = function() {\r\n                    const iw = img.width, ih = img.height;\r\n                    const imgRatio = iw / ih;\r\n                    const areaRatio = imgAreaW / imgAreaH;\r\n                    let dx, dy, dw, dh;\r\n                    if (imgRatio > areaRatio) {\r\n                        // Imagen mas ancha que el area: ajustar por ancho, centrar vertical\r\n                        dw = imgAreaW;\r\n                        dh = imgAreaW / imgRatio;\r\n                        dx = 12;\r\n                        dy = imgY + (imgAreaH - dh) / 2;\r\n                    } else {\r\n                        // Imagen mas alta que el area: ajustar por alto, centrar horizontal\r\n                        dh = imgAreaH;\r\n                        dw = imgAreaH * imgRatio;\r\n                        dx = 12 + (imgAreaW - dw) / 2;\r\n                        dy = imgY;\r\n                    }\r\n                    // Limpiar SOLO el area de imagen (para no borrar el badge)\r\n                    ctx.clearRect(12, imgY - 2, imgAreaW + 4, imgAreaH + 4);\r\n                    // Dibujar imagen COMPLETA sin recortar, centrada, respetando su transparencia\r\n                    ctx.drawImage(img, 0, 0, iw, ih, dx, dy, dw, dh);\r\n                    texture.needsUpdate = true;\r\n                };\r\n                img.onerror = function() {\r\n                    // Placeholder minimo: solo un punto si no carga\r\n                    ctx.clearRect(12, imgY - 2, imgAreaW + 4, imgAreaH + 4);\r\n                    ctx.fillStyle = 'rgba(229,83,54,0.15)';\r\n                    ctx.beginPath();\r\n                    ctx.arc(CANVAS_W/2, imgY + imgAreaH/2, 20, 0, Math.PI * 2);\r\n                    ctx.fill();\r\n                    texture.needsUpdate = true;\r\n                };\r\n                img.src = imgSrc;\r\n                \r\n                // Create sprite from canvas\r\n                const texture = new THREE.CanvasTexture(canvas);\r\n                texture.needsUpdate = true;\r\n                const spriteMat = new THREE.SpriteMaterial({\r\n                    map: texture, transparent: true, depthWrite: false,\r\n                    sizeAttenuation: true,\r\n                    toneMapped: false\r\n                });\r\n                const sprite = new THREE.Sprite(spriteMat);\r\n                const baseW = 0.85, baseH = 1.0;\r\n                sprite.scale.set(baseW, baseH, 1);\r\n                sprite.position.set(wp.x, wp.y + SIGN_HEIGHT, wp.z);\r\n                sprite.userData = {isPOI: true, poiIndex: idx, baseScaleW: baseW, baseScaleH: baseH};\r\n                scene.add(sprite);\r\n                S.poiConeMeshes.push(sprite);\r\n                S.poiFloatBase.push(wp.y + SIGN_HEIGHT);\r\n                \r\n                // Small white glow dot at base\r\n                const dotGeo = new THREE.SphereGeometry(0.07, 8, 8);\r\n                const dotMat = new THREE.MeshBasicMaterial({\r\n                    color: 0xffffff, transparent: true, opacity: 0.4\r\n                });\r\n                const dot = new THREE.Mesh(dotGeo, dotMat);\r\n                dot.position.set(wp.x, wp.y + 0.05, wp.z);\r\n                dot.userData = {poiIndex: idx};\r\n                scene.add(dot);\r\n                \r\n                // Energy orb that travels up the thread on hover\r\n                const energyGeo = new THREE.SphereGeometry(0.06, 12, 8);\r\n                const energyMat = new THREE.MeshBasicMaterial({\r\n                    color: 0xffffff, transparent: true, opacity: 0\r\n                });\r\n                const energyDot = new THREE.Mesh(energyGeo, energyMat);\r\n                energyDot.position.set(wp.x, wp.y, wp.z);\r\n                energyDot.userData = {poiIndex: idx, phase: Math.random() * Math.PI * 2};\r\n                scene.add(energyDot);\r\n                S.poiEnergyDots.push(energyDot);\r\n                \r\n                // Init sprite smooth scale arrays\r\n                S.poiSpriteScaleTarget.push(1);\r\n                S.poiSpriteScaleCurrent.push(1);\r\n            });\r\n        }\r\n\r\n        // === USER INTERACTION (resets auto-rotation idle timer) ===\r\n        function onUserInteraction() {\r\n            S.autoRotate = false;\r\n            S.idleTimer = 0;\r\n        }\r\n        renderer.domElement.addEventListener('pointerdown', onUserInteraction);\r\n        renderer.domElement.addEventListener('wheel', onUserInteraction);\r\n        renderer.domElement.addEventListener('touchstart', onUserInteraction);\r\n\r\n        // === POINTER ===\r\n        function gPos(e) {\r\n            const cx = e.touches ? e.touches[0].clientX : e.clientX;\r\n            const cy = e.touches ? e.touches[0].clientY : e.clientY;\r\n            return {x:cx, y:cy};\r\n        }\r\n        function onDown(e) {\r\n            const p = gPos(e);\r\n            S.isDrag=true; S.isDown=true; S.lX=p.x; S.lY=p.y; S.pX=p.x; S.pY=p.y;\r\n            S.moved=false; S.vY=0; S.vP=0; S.vD=0;\r\n        }\r\n        function onMove(e) {\r\n            e.preventDefault();\r\n            const p = gPos(e);\r\n            S.mouse.x = (p.x / window.innerWidth) * 2 - 1;\r\n            S.mouse.y = -(p.y / window.innerHeight) * 2 + 1;\r\n            if (S.isDrag) {\r\n                // Block orbit while transform controls gizmo is being dragged\r\n                if (transformControls.dragging) return;\r\n                const dx=p.x-S.lX, dy=p.y-S.lY;\r\n                if (Math.abs(p.x-S.pX)>5||Math.abs(p.y-S.pY)>5) S.moved=true;\r\n                S.vY=-dx*0.005; S.vP=-dy*0.005;\r\n                S.tYaw+=S.vY; S.tPitch+=S.vP;\r\n                S.tPitch=Math.max(CFG.minPitch,Math.min(CFG.maxPitch,S.tPitch));\r\n                S.lX=p.x; S.lY=p.y; updateCam();\r\n            }\r\n        }\r\n        function onUp(e) {\r\n            S.isDrag=false;\r\n            if (!S.moved) {\r\n                S.ptr.copy(S.mouse);\r\n                checkClick();\r\n            }\r\n            S.isDown=false;\r\n        }\r\n        renderer.domElement.addEventListener('mousedown', onDown);\r\n        window.addEventListener('mousemove', onMove);\r\n        window.addEventListener('mouseup', onUp);\r\n        renderer.domElement.addEventListener('touchstart', e=>{if(e.touches.length===1)onDown(e);},{passive:true});\r\n        window.addEventListener('touchmove', e=>{if(e.touches.length===1)onMove(e);},{passive:false});\r\n        window.addEventListener('touchend', e=>{onUp(e);},{passive:true});\r\n\r\n        let lPinch=0;\r\n        renderer.domElement.addEventListener('touchstart', e=>{\r\n            if(e.touches.length===2){const dx=e.touches[0].clientX-e.touches[1].clientX,dy=e.touches[0].clientY-e.touches[1].clientY;lPinch=Math.sqrt(dx*dx+dy*dy);}\r\n        },{passive:true});\r\n        window.addEventListener('touchmove', e=>{\r\n            if(e.touches.length===2){e.preventDefault();const dx=e.touches[0].clientX-e.touches[1].clientX,dy=e.touches[0].clientY-e.touches[1].clientY,d=Math.sqrt(dx*dx+dy*dy);S.vD=(lPinch-d)*0.05;S.tDist+=S.vD;S.tDist=Math.max(CFG.minDist,Math.min(CFG.maxDist,S.tDist));lPinch=d;}\r\n        },{passive:false});\r\n        renderer.domElement.addEventListener('wheel', e=>{e.preventDefault();S.vD=e.deltaY*0.01;S.tDist+=S.vD;S.tDist=Math.max(CFG.minDist,Math.min(CFG.maxDist,S.tDist));},{passive:false});\r\n        document.getElementById('zi').addEventListener('click',()=>{S.tDist=Math.max(CFG.minDist,S.tDist-2);});\r\n        document.getElementById('zo').addEventListener('click',()=>{S.tDist=Math.min(CFG.maxDist,S.tDist+2);});\r\n\r\n        // === POI CLICK ===\r\n        function checkClick() {\r\n            if (!S.poiMeshes.length || !S.poiData.length || S.introActive) return;\r\n            const targets = [...S.poiMeshes, ...S.poiConeMeshes];\r\n            S.ray.setFromCamera(S.ptr, camera);\r\n            const hits = S.ray.intersectObjects(targets, false);\r\n            if (hits.length > 0) {\r\n                const obj = hits[0].object;\r\n                let idx = -1;\r\n                if (obj.userData.poiIndex !== undefined) {\r\n                    idx = obj.userData.poiIndex;\r\n                } else {\r\n                    idx = S.poiMeshes.indexOf(obj);\r\n                }\r\n                if (idx >= 0 && idx < S.poiData.length) {\r\n                    if (S.poiData[idx].disabled) return; // skip disabled POIs\r\n                    if (editMode) {\r\n                        // In edit mode: attach transform controls instead of opening modal\r\n                        attachControlsToPoi(idx);\r\n                    } else if (!mo.classList.contains('a')) {\r\n                        S.lastClickedPoiIdx = idx;\r\n                        openModal(S.poiData[idx]);\r\n                    }\r\n                }\r\n            }\r\n        }\r\n\r\n        // === HOVER EFFECT ===\r\n        function updateHover() {\r\n            if (!S.poiMeshes.length || S.isDrag) {\r\n                clearHover();\r\n                return;\r\n            }\r\n            const targets = [...S.poiMeshes, ...S.poiConeMeshes];\r\n            S.ray.setFromCamera(S.mouse, camera);\r\n            const hits = S.ray.intersectObjects(targets, false);\r\n            if (hits.length > 0) {\r\n                const obj = hits[0].object;\r\n                let idx = -1;\r\n                if (obj.userData.poiIndex !== undefined) {\r\n                    idx = obj.userData.poiIndex;\r\n                } else {\r\n                    idx = S.poiMeshes.indexOf(obj);\r\n                }\r\n                if (idx >= 0 && idx < S.poiMeshes.length) {\r\n                    // Clear previous hover first (fix: multiple POIs staying lit)\r\n                    if (idx !== S.hoveredPOI) clearHover();\r\n                    \r\n                    // Set smooth target scale for sphere\r\n                    S.poiScaleTarget[idx] = 1.4;\r\n                    \r\n                    // Set smooth target scale for sprite (cartelito)\r\n                    S.poiSpriteScaleTarget[idx] = 1.4;\r\n                    \r\n                    S.hoveredPOI = idx;\r\n                    container.style.cursor = 'pointer';\r\n                    return;\r\n                }\r\n            }\r\n            clearHover();\r\n        }\r\n        \r\n        function clearHover() {\r\n            if (S.hoveredPOI !== null) {\r\n                const prev = S.hoveredPOI;\r\n                // Reset smooth target scales\r\n                S.poiScaleTarget[prev] = 1;\r\n                S.poiSpriteScaleTarget[prev] = 1;\r\n                if (S.poiMeshes[prev] && S.poiMeshes[prev].material) {\r\n                const ms = Array.isArray(S.poiMeshes[prev].material) ? S.poiMeshes[prev].material : [S.poiMeshes[prev].material];\r\n                ms.forEach(m => { m.emissiveIntensity = 0.8; });\r\n                }\r\n                const sprite = S.poiConeMeshes[prev];\r\n                if (sprite) {\r\n                    // No longer set scale immediately - handled by lerp loop\r\n                }\r\n                S.hoveredPOI = null;\r\n                container.style.cursor = 'default';\r\n            }\r\n        }\r\n\r\n        // === MODAL ===\r\n        const mo=document.getElementById('mo'), mt=document.getElementById('mt'),\r\n              md3=document.getElementById('md3'), mci=document.getElementById('mci'),\r\n              mc=document.getElementById('mc'),\r\n              pimg=document.getElementById('pimg');\r\n        \r\n        function getCircuitInfo(color) {\r\n            const c=color.map(v=>Math.round(v*255));\r\n            const circuits = {\r\n                '255,217,51': {name:'Circuito Cultural', color:'#ffd933'},\r\n                '77,77,230': {name:'Calingasta', color:'#4d4de6'},\r\n                '230,128,26': {name:'Jáchal', color:'#e6801a'},\r\n                '204,51,77': {name:'Iglesia', color:'#cc334d'},\r\n                '51,179,77': {name:'Valle Fértil', color:'#33b34d'},\r\n                '51,153,204': {name:'Ruta Interlagos', color:'#3399cc'},\r\n            };\r\n            const key = c.join(',');\r\n            return circuits[key] || {name:'Circuito', color:'#e55336'};\r\n        }\r\n        \r\n        function openModal(poi) {\r\n            const c=poi.color||[1,1,1];\r\n            const crgb='rgb('+c.map(v=>Math.round(v*255)).join(',')+')';\r\n            const ci=getCircuitInfo(poi.color);\r\n            mci.textContent=ci.name; mci.style.color=ci.color;\r\n            mt.textContent=poi.name;\r\n            \r\n            // Show subtitle if available\r\n            const sub = document.getElementById('m-sub');\r\n            if (sub) sub.textContent = poi.subtitle || '';\r\n            \r\n            // Set main image\r\n            const mainImg = poi.image ? `./iconosmaqueta/${poi.image}` : './poi_images/0.png';\r\n            pimg.src = mainImg;\r\n            pimg.onerror = () => { pimg.style.display='none'; };\r\n            pimg.style.display = 'block';\r\n            \r\n            // Build sub-section buttons\r\n            const subList = document.getElementById('m-sub-list');\r\n            subList.innerHTML = '';\r\n            const modalMain = document.getElementById('modal-main');\r\n            const modalSub = document.getElementById('modal-sub');\r\n            const subBack = document.getElementById('m-sub-back');\r\n            subBack.style.display = 'none';\r\n            \r\n            // Reset wraps: show main, hide sub\r\n            modalMain.style.display = 'block';\r\n            modalMain.classList.remove('fade-out', 'fade-in');\r\n            modalSub.style.display = 'none';\r\n            modalSub.classList.remove('fade-out', 'fade-in');\r\n            \r\n            if (poi.subsections && poi.subsections.length > 0) {\r\n                // Hide main description, show sub-section buttons\r\n                md3.style.display = 'none';\r\n                subList.style.display = 'grid';\r\n                \r\n                poi.subsections.forEach((sub, si) => {\r\n                    const btn = document.createElement('button');\r\n                    btn.className = 'm-sub-btn';\r\n                    // Use first letter of circuit as small dot\r\n                    btn.innerHTML = `<span class=\"m-sub-dot\" style=\"background:${crgb};\"></span><span class=\"m-sub-label\">${sub.title}</span><span class=\"m-sub-arrow\">›</span>`;\r\n                    btn.addEventListener('click', () => showSubsection(poi, si));\r\n                    subList.appendChild(btn);\r\n                });\r\n            } else {\r\n                md3.style.display = 'block';\r\n                md3.textContent = poi.description;\r\n                subList.style.display = 'none';\r\n            }\r\n            \r\n            mo.classList.add('a');\r\n        }\r\n        \r\n        function showSubsection(poi, si) {\r\n            const sub = poi.subsections[si];\r\n            if (!sub) return;\r\n            const modalMain = document.getElementById('modal-main');\r\n            const modalSub = document.getElementById('modal-sub');\r\n            const subBack = document.getElementById('m-sub-back');\r\n            const subImg = document.getElementById('m-sub-img');\r\n            const subTitle = document.getElementById('m-sub-title');\r\n            const subDesc = document.getElementById('m-sub-desc');\r\n            \r\n            // Fade out main view\r\n            modalMain.classList.remove('fade-in');\r\n            modalMain.classList.add('fade-out');\r\n            \r\n            setTimeout(() => {\r\n                modalMain.style.display = 'none';\r\n                \r\n                // Prepare sub detail content\r\n                subTitle.textContent = sub.title;\r\n                subDesc.textContent = sub.description;\r\n                \r\n                // Sub-section image opcional (si no tiene, se oculta)\r\n                if (sub.image) {\r\n                    subImg.src = `./${sub.image}`;\r\n                    subImg.onerror = () => { subImg.style.display='none'; };\r\n                    subImg.style.display = 'block';\r\n                } else {\r\n                    subImg.style.display = 'none';\r\n                }\r\n                \r\n                // Show sub view with fade-in\r\n                modalSub.style.display = 'block';\r\n                modalSub.classList.remove('fade-out');\r\n                modalSub.classList.add('fade-in');\r\n                subBack.style.display = 'flex';\r\n            }, 220);\r\n        }\r\n        \r\n        function showSubList(poi) {\r\n            const modalMain = document.getElementById('modal-main');\r\n            const modalSub = document.getElementById('modal-sub');\r\n            const subBack = document.getElementById('m-sub-back');\r\n            \r\n            // Fade out sub view\r\n            modalSub.classList.remove('fade-in');\r\n            modalSub.classList.add('fade-out');\r\n            \r\n            setTimeout(() => {\r\n                modalSub.style.display = 'none';\r\n                subBack.style.display = 'none';\r\n                \r\n                // Show main view with fade-in\r\n                modalMain.style.display = 'block';\r\n                modalMain.classList.remove('fade-out');\r\n                modalMain.classList.add('fade-in');\r\n            }, 220);\r\n        }\r\n        function closeModal(){\r\n            mo.classList.remove('a');\r\n            // Restore modal state\r\n            const modalMain = document.getElementById('modal-main');\r\n            const modalSub = document.getElementById('modal-sub');\r\n            const subBack = document.getElementById('m-sub-back');\r\n            modalMain.style.display = 'block';\r\n            modalMain.classList.remove('fade-out', 'fade-in');\r\n            modalSub.style.display = 'none';\r\n            modalSub.classList.remove('fade-out', 'fade-in');\r\n            subBack.style.display = 'none';\r\n            // Reset to ideal view\r\n            S.tDist = CFG.defaultDist;\r\n            S.tPitch = CFG.defaultPitch;\r\n            S.tYaw = CFG.defaultYaw;\r\n            S.camTarget.set(0, 0.2, 0);\r\n            // Restore saved scale\r\n            CFG.modelScale = CFG.defaultModelScale;\r\n            svScale.value = CFG.defaultModelScale;\r\n            svScaleVal.textContent = CFG.defaultModelScale.toFixed(5);\r\n            if (S.model) S.model.scale.set(CFG.defaultModelScale, CFG.defaultModelScale, CFG.defaultModelScale);\r\n            // Trigger auto-rotation\r\n            S.idleTimer = S.idleTimeout;\r\n        }\r\n        mc.addEventListener('click',closeModal);\r\n        mo.addEventListener('click',e=>{if(e.target===mo)closeModal();});\r\n        document.getElementById('m-sub-back').addEventListener('click', () => {\r\n            const poi = S.poiData[S.lastClickedPoiIdx];\r\n            if (poi) showSubList(poi);\r\n        });\r\n\r\n        // === SETTINGS PANEL ===\r\n        const sg=document.getElementById('sg'), sp=document.getElementById('sp');\r\n        // Only show gear button if URL contains ?config=true\r\n        if (window.location.search.includes('config=true')) {\r\n            sg.style.display = '';\r\n        } else {\r\n            sg.style.display = 'none';\r\n        }\r\n        let spOpen = false;\r\n        sg.addEventListener('click', () => {\r\n            spOpen = !spOpen;\r\n            sp.classList.toggle('v', spOpen);\r\n            sg.classList.toggle('active', spOpen);\r\n        });\r\n\r\n        // Tab switching\r\n        document.querySelectorAll('#sp .sp-tab').forEach(btn => {\r\n            btn.addEventListener('click', () => {\r\n                document.querySelectorAll('#sp .sp-tab').forEach(b => b.classList.remove('active'));\r\n                document.querySelectorAll('#sp .sp-tab-content').forEach(c => c.classList.remove('active'));\r\n                btn.classList.add('active');\r\n                const tab = document.getElementById('sp-' + btn.dataset.tab);\r\n                if (tab) tab.classList.add('active');\r\n            });\r\n        });\r\n\r\n        // Edit mode toggle in POIS tab\r\n        document.getElementById('edit-toggle').addEventListener('click', () => {\r\n            if (editMode) {\r\n                exitEditMode();\r\n            } else {\r\n                enterEditMode();\r\n            }\r\n        });\r\n\r\n        // POST-PROCESSING sliders\r\n        document.querySelectorAll('#sp .pp-slider').forEach(el => {\r\n            el.addEventListener('input', () => {\r\n                const id = el.id;\r\n                const val = parseFloat(el.value);\r\n                const valEl = document.getElementById(id + '-val');\r\n                if (valEl) valEl.textContent = val.toFixed(2);\r\n                if (id === 'pp-bloom-strength') { POSTPO_STATE.bloomStrength = val; bloomPass.strength = val; }\r\n                else if (id === 'pp-bloom-radius') { POSTPO_STATE.bloomRadius = val; bloomPass.radius = val; }\r\n                else if (id === 'pp-bloom-threshold') { POSTPO_STATE.bloomThreshold = val; bloomPass.threshold = val; }\r\n                else if (id === 'pp-exposure') { POSTPO_STATE.exposure = val; renderer.toneMappingExposure = val; }\r\n            });\r\n        });\r\n\r\n        // SMAA toggle\r\n        document.getElementById('pp-smaa-toggle').addEventListener('click', () => {\r\n            POSTPO_STATE.smaaEnabled = !POSTPO_STATE.smaaEnabled;\r\n            smaaPass.enabled = POSTPO_STATE.smaaEnabled;\r\n            const btn = document.getElementById('pp-smaa-toggle');\r\n            btn.textContent = POSTPO_STATE.smaaEnabled ? 'ON' : 'OFF';\r\n            btn.style.color = POSTPO_STATE.smaaEnabled ? '#e55336' : 'rgba(255,255,255,0.4)';\r\n            btn.style.background = POSTPO_STATE.smaaEnabled ? 'rgba(229,83,54,0.15)' : 'transparent';\r\n        });\r\n\r\n        function enterEditMode() {\r\n            editMode = true;\r\n            transformControls.enabled = true;\r\n            // Attach to first POI if none selected\r\n            if (editAttachedIdx < 0 && S.poiMeshes.length > 0) {\r\n                attachControlsToPoi(0);\r\n            }\r\n            const toggle = document.getElementById('edit-toggle');\r\n            if (toggle) { toggle.textContent = 'ON'; toggle.style.color = '#e55336'; toggle.style.borderColor = 'rgba(229,83,54,0.6)'; toggle.style.background = 'rgba(229,83,54,0.15)'; }\r\n            const hint = document.getElementById('edit-hint');\r\n            if (hint) hint.style.display = 'block';\r\n        }\r\n        function exitEditMode() {\r\n            editMode = false;\r\n            transformControls.enabled = false;\r\n            transformControls.detach();\r\n            editAttachedIdx = -1;\r\n            const toggle = document.getElementById('edit-toggle');\r\n            if (toggle) { toggle.textContent = 'OFF'; toggle.style.color = 'rgba(255,255,255,0.4)'; toggle.style.borderColor = 'rgba(229,83,54,0.3)'; toggle.style.background = 'transparent'; }\r\n            const hint = document.getElementById('edit-hint');\r\n            if (hint) hint.style.display = 'none';\r\n        }\r\n\r\n        function attachControlsToPoi(idx) {\r\n            if (idx < 0 || idx >= S.poiMeshes.length) return;\r\n            // Reset previous selection highlight\r\n            if (editAttachedIdx >= 0 && S.poiMeshes[editAttachedIdx]) {\r\n                const prevMat = S.poiMeshes[editAttachedIdx].material;\r\n                if (prevMat) prevMat.emissiveIntensity = 0.8;\r\n            }\r\n            editAttachedIdx = idx;\r\n            // Position the gizmo target above the POI mesh\r\n            const mesh = S.poiMeshes[idx];\r\n            gizmoTarget.position.copy(mesh.position);\r\n            gizmoTarget.position.y += 0.6;\r\n            transformControls.attach(gizmoTarget);\r\n            // Highlight selected POI\r\n            const mat = mesh.material;\r\n            if (mat) mat.emissiveIntensity = 1.8;\r\n            // Set space to local for intuitive movement\r\n            transformControls.setSpace('local');\r\n        }\r\n\r\n        // Light controls inside settings panel\r\n        function updateLightFromState(key) {\r\n            const st = LIGHT_STATE[key];\r\n            const light = S.lights[key];\r\n            if (!light) return;\r\n            light.intensity = st.on ? st.intensity : 0;\r\n            if (key === 'hemi') {\r\n                // HemisphereLight has sky color + ground color\r\n                light.color.set(st.color);\r\n                if (st.groundColor) light.groundColor.set(st.groundColor);\r\n            } else {\r\n                light.color.set(st.color);\r\n            }\r\n            // Update UI\r\n            const group = document.querySelector(`.lgroup[data-light=\"${key}\"]`);\r\n            if (group) {\r\n                const lb = group.querySelector('.lb');\r\n                const slider = group.querySelector('.li-slider');\r\n                const colorInput = group.querySelector('.li-color');\r\n                const val = group.querySelector('.li-val');\r\n                lb.classList.toggle('on', st.on);\r\n                lb.classList.toggle('off', !st.on);\r\n                if (slider) slider.value = st.intensity;\r\n                if (colorInput) colorInput.value = st.color;\r\n                if (val) val.textContent = st.intensity.toFixed(2);\r\n            }\r\n        }\r\n        document.querySelectorAll('#sp .lb').forEach(el => {\r\n            el.addEventListener('click', () => {\r\n                const key = el.dataset.light;\r\n                LIGHT_STATE[key].on = !LIGHT_STATE[key].on;\r\n                updateLightFromState(key);\r\n            });\r\n        });\r\n        document.querySelectorAll('#sp .li-slider').forEach(el => {\r\n            el.addEventListener('input', () => {\r\n                const key = el.dataset.light;\r\n                LIGHT_STATE[key].intensity = parseFloat(el.value);\r\n                updateLightFromState(key);\r\n            });\r\n        });\r\n        document.querySelectorAll('#sp .li-color').forEach(el => {\r\n            el.addEventListener('input', () => {\r\n                const key = el.dataset.light;\r\n                LIGHT_STATE[key].color = el.value;\r\n                updateLightFromState(key);\r\n            });\r\n        });\r\n\r\n        // === VIEW IDEAL SLIDERS ===\r\n        const svZoom = document.getElementById('sv-zoom');\r\n        const svPitch = document.getElementById('sv-pitch');\r\n        const svYaw = document.getElementById('sv-yaw');\r\n        const svZoomVal = document.getElementById('sv-zoom-val');\r\n        const svPitchVal = document.getElementById('sv-pitch-val');\r\n        const svYawVal = document.getElementById('sv-yaw-val');\r\n\r\n        function updateSlidersFromCamera() {\r\n            svZoom.value = S.dist;\r\n            svZoomVal.textContent = S.dist.toFixed(2);\r\n            svPitch.value = S.pitch;\r\n            svPitchVal.textContent = S.pitch.toFixed(2);\r\n            svYaw.value = S.yaw;\r\n            svYawVal.textContent = S.yaw.toFixed(2);\r\n        }\r\n\r\n        svZoom.addEventListener('input', () => {\r\n            const v = parseFloat(svZoom.value);\r\n            svZoomVal.textContent = v.toFixed(2);\r\n            S.tDist = v;\r\n        });\r\n        svPitch.addEventListener('input', () => {\r\n            const v = parseFloat(svPitch.value);\r\n            svPitchVal.textContent = v.toFixed(2);\r\n            S.tPitch = v;\r\n        });\r\n        svYaw.addEventListener('input', () => {\r\n            const v = parseFloat(svYaw.value);\r\n            svYawVal.textContent = v.toFixed(2);\r\n            S.tYaw = v;\r\n        });\r\n\r\n        // === SCALE SLIDER ===\r\n        const svScale = document.getElementById('sv-scale');\r\n        const svScaleVal = document.getElementById('sv-scale-val');\r\n        svScale.addEventListener('input', () => {\r\n            const v = parseFloat(svScale.value);\r\n            svScaleVal.textContent = v.toFixed(5);\r\n            CFG.modelScale = v;\r\n            if (S.model) S.model.scale.set(v, v, v);\r\n        });\r\n\r\n        // ─── API BASE URL ───────────────────────────────\r\n        const API_BASE = CONFIG.API_BASE;\r\n\r\n        function getConfigData() {\r\n            return {\r\n                dist: S.dist,\r\n                pitch: S.pitch,\r\n                yaw: S.yaw,\r\n                modelScale: parseFloat(svScale.value),\r\n                lights: JSON.parse(JSON.stringify(LIGHT_STATE)),\r\n                postpo: JSON.parse(JSON.stringify(POSTPO_STATE)),\r\n            };\r\n        }\r\n\r\n        function loadConfig() {\r\n            // Load config from API\r\n            fetch(API_BASE + '/api/maqueta/config')\r\n                .then(r => { if (!r.ok) throw new Error('No config'); return r.json(); })\r\n                .then(fileData => {\r\n                    if (fileData && Object.keys(fileData).length > 0) {\r\n                        applyConfigData(fileData);\r\n                    }\r\n                })\r\n                .catch(() => {\r\n                    console.warn('No saved config found, using defaults');\r\n                });\r\n        }\r\n\r\n        function applyConfigData(data) {\r\n            // Camera\r\n            if (data.dist != null) {\r\n                CFG.defaultDist = data.dist;\r\n                CFG.defaultPitch = data.pitch || data.pitch === 0 ? data.pitch : CFG.defaultPitch;\r\n                CFG.defaultYaw = data.yaw || data.yaw === 0 ? data.yaw : CFG.defaultYaw;\r\n                S.tDist = data.dist;\r\n                S.tPitch = data.pitch;\r\n                S.tYaw = data.yaw;\r\n                S.dist = data.dist;\r\n                S.pitch = data.pitch;\r\n                S.yaw = data.yaw;\r\n                if (svZoom) { svZoom.value = data.dist; svZoomVal.textContent = data.dist.toFixed(2); }\r\n                if (svPitch) { svPitch.value = data.pitch; svPitchVal.textContent = data.pitch.toFixed(2); }\r\n                if (svYaw) { svYaw.value = data.yaw; svYawVal.textContent = data.yaw.toFixed(2); }\r\n            }\r\n            // Scale\r\n            if (data.modelScale != null) {\r\n                CFG.defaultModelScale = data.modelScale;\r\n                CFG.modelScale = data.modelScale;\r\n                if (svScale) { svScale.value = data.modelScale; svScaleVal.textContent = data.modelScale.toFixed(5); }\r\n                if (S.model) S.model.scale.set(data.modelScale, data.modelScale, data.modelScale);\r\n            }\r\n            // Lights\r\n            if (data.lights) {\r\n                Object.keys(data.lights).forEach(k => {\r\n                    if (LIGHT_STATE[k]) {\r\n                        LIGHT_STATE[k].on = data.lights[k].on;\r\n                        LIGHT_STATE[k].intensity = data.lights[k].intensity;\r\n                        LIGHT_STATE[k].color = data.lights[k].color;\r\n                    }\r\n                });\r\n                Object.keys(LIGHT_STATE).forEach(k => updateLightFromState(k));\r\n            }\r\n            // Post-processing\r\n            if (data.postpo) {\r\n                Object.keys(data.postpo).forEach(k => {\r\n                    if (POSTPO_STATE[k] !== undefined) {\r\n                        POSTPO_STATE[k] = data.postpo[k];\r\n                    }\r\n                });\r\n                if (document.getElementById('pp-bloom-strength')) {\r\n                    document.getElementById('pp-bloom-strength').value = POSTPO_STATE.bloomStrength;\r\n                    document.getElementById('pp-bloom-strength-val').textContent = POSTPO_STATE.bloomStrength.toFixed(2);\r\n                    document.getElementById('pp-bloom-radius').value = POSTPO_STATE.bloomRadius;\r\n                    document.getElementById('pp-bloom-radius-val').textContent = POSTPO_STATE.bloomRadius.toFixed(2);\r\n                    document.getElementById('pp-bloom-threshold').value = POSTPO_STATE.bloomThreshold;\r\n                    document.getElementById('pp-bloom-threshold-val').textContent = POSTPO_STATE.bloomThreshold.toFixed(2);\r\n                    document.getElementById('pp-exposure').value = POSTPO_STATE.exposure;\r\n                    document.getElementById('pp-exposure-val').textContent = POSTPO_STATE.exposure.toFixed(2);\r\n                    const smaaBtn = document.getElementById('pp-smaa-toggle');\r\n                    if (smaaBtn) {\r\n                        smaaBtn.textContent = POSTPO_STATE.smaaEnabled ? 'ON' : 'OFF';\r\n                        smaaBtn.style.color = POSTPO_STATE.smaaEnabled ? '#e55336' : 'rgba(255,255,255,0.4)';\r\n                        smaaBtn.style.background = POSTPO_STATE.smaaEnabled ? 'rgba(229,83,54,0.15)' : 'transparent';\r\n                    }\r\n                }\r\n                applyPostpoState();\r\n            }\r\n        }\r\n\r\n        function saveConfig() {\r\n            const data = getConfigData();\r\n            svScaleVal.textContent = data.modelScale.toFixed(5);\r\n            svZoomVal.textContent = data.dist.toFixed(2);\r\n            svPitchVal.textContent = data.pitch.toFixed(2);\r\n            svYawVal.textContent = data.yaw.toFixed(2);\r\n            // Show saving feedback\r\n            const btn = document.getElementById('sv-save');\r\n            btn.textContent = 'Guardando...';\r\n            // Save config to API\r\n            fetch(API_BASE + '/api/maqueta/config', {\r\n                method: 'POST',\r\n                headers: { 'Content-Type': 'application/json' },\r\n                body: JSON.stringify(data),\r\n            })\r\n            .then(r => r.json())\r\n            .then(result => {\r\n                btn.textContent = 'Guardado';\r\n                setTimeout(() => { btn.textContent = 'Guardar'; }, 1500);\r\n            })\r\n            .catch(() => {\r\n                btn.textContent = 'Error';\r\n                setTimeout(() => { btn.textContent = 'Guardar'; }, 2000);\r\n            });\r\n            // Save POI positions to server\r\n            if (S.poiData && S.poiData.length > 0) {\r\n                fetch(API_BASE + '/api/maqueta/pois', {\r\n                    method: 'POST',\r\n                    headers: { 'Content-Type': 'application/json' },\r\n                    body: JSON.stringify(S.poiData),\r\n                }).catch(() => {});\r\n            }\r\n        }\r\n\r\n        document.getElementById('sv-save').addEventListener('click', saveConfig);\r\n\r\n        // Update sliders when user interacts with camera\r\n        setInterval(() => {\r\n            svZoomVal.textContent = S.dist.toFixed(2);\r\n            svPitchVal.textContent = S.pitch.toFixed(2);\r\n            svYawVal.textContent = S.yaw.toFixed(2);\r\n            // Keep slider thumbs in sync with current camera\r\n            svZoom.value = S.dist;\r\n            svPitch.value = S.pitch;\r\n            svYaw.value = S.yaw;\r\n        }, 200);\r\n\r\n        // === POI CLICK → CAMERA TRANSITION ===\r\n        const origOpenModal = openModal;\r\n        function flyToPOI(poi) {\r\n            if (!poi || !poi.position) return;\r\n            // Store previous camera state for restore on close\r\n            S.prevCamState.dist = S.dist;\r\n            S.prevCamState.pitch = S.pitch;\r\n            S.prevCamState.yaw = S.yaw;\r\n            S.prevCamState.target.copy(S.camTargetCurrent);\r\n            \r\n            // Use the actual mesh position, not pois.json data (which may be different)\r\n            const mesh = S.lastClickedPoiIdx >= 0 ? S.poiMeshes[S.lastClickedPoiIdx] : null;\r\n            const wp = mesh ? mesh.position.clone() : new THREE.Vector3(poi.position[0], poi.position[1], poi.position[2]);\r\n            // Set camera target to POI position\r\n            S.camTarget.copy(wp);\r\n            S.camAnimating = true;\r\n            // Disable auto-rotation during animation\r\n            S.autoRotate = false;\r\n            S.idleTimer = 0;\r\n            // Compute a reasonable dist for the POI\r\n            const flyDist = Math.min(8, Math.max(3, S.dist * 0.7));\r\n            S.tDist = flyDist;\r\n        }\r\n\r\n        // Override openModal to also fly camera\r\n        openModal = function(poi) {\r\n            flyToPOI(poi);\r\n            origOpenModal(poi);\r\n        };\r\n        // === POI ADMIN ===\r\n        let poiEditingIndex = -1;\r\n        let poiAdminPois = [];\r\n\r\n        function loadPoiList() {\r\n            fetch('./pois.json')\r\n                .then(r => r.json())\r\n                .then(data => {\r\n                    poiAdminPois = data;\r\n                    renderPoiList(data);\r\n                })\r\n                .catch(() => {\r\n                    document.getElementById('poi-list').innerHTML = '<div style=\"color:rgba(255,255,255,0.3);font-size:12px;padding:8px;text-align:center;\">Error al cargar POIs</div>';\r\n                });\r\n        }\r\n\r\n        function renderPoiList(pois) {\r\n            const list = document.getElementById('poi-list');\r\n            if (!pois.length) {\r\n                list.innerHTML = '<div style=\"color:rgba(255,255,255,0.3);font-size:12px;padding:8px;text-align:center;\">No hay POIs</div>';\r\n                return;\r\n            }\r\n            list.innerHTML = pois.map((p, i) => `\r\n                <div class=\"poi-list-item${poiEditingIndex === i ? ' active' : ''}\" data-idx=\"${i}\">\r\n                    <span style=\"width:8px;height:8px;border-radius:50%;background:rgb(${p.color.map(v=>Math.round(v*255)).join(',')});flex-shrink:0;\"></span>\r\n                    <span style=\"flex:1;font-size:13px;color:rgba(255,255,255,0.8);\">${p.name}</span>\r\n                    <span style=\"font-size:10px;color:rgba(255,255,255,0.3);\">X:${p.position[0].toFixed(2)} Y:${p.position[1].toFixed(2)} Z:${p.position[2].toFixed(2)}</span>\r\n                </div>\r\n            `).join('');\r\n            list.querySelectorAll('.poi-list-item').forEach(el => {\r\n                el.addEventListener('click', () => {\r\n                    const idx = parseInt(el.dataset.idx);\r\n                    editPoi(idx);\r\n                });\r\n            });\r\n        }\r\n\r\n        function editPoi(idx) {\r\n            poiEditingIndex = idx;\r\n            const poi = poiAdminPois[idx];\r\n            document.getElementById('poi-x').value = poi.position[0];\r\n            document.getElementById('poi-y').value = poi.position[1];\r\n            document.getElementById('poi-z').value = poi.position[2];\r\n            document.getElementById('poi-name').value = poi.name;\r\n            document.getElementById('poi-desc').value = poi.description || '';\r\n            const c = poi.color || [0.9, 0.33, 0.21];\r\n            document.getElementById('poi-color').value = '#' + c.map(v => Math.round(v * 255).toString(16).padStart(2, '0')).join('');\r\n            document.getElementById('poi-form').style.display = 'block';\r\n            document.getElementById('poi-delete-btn').style.display = 'block';\r\n            document.getElementById('poi-status').textContent = 'Editando: ' + poi.name;\r\n            renderPoiList(poiAdminPois);\r\n        }\r\n\r\n        function resetPoiForm() {\r\n            poiEditingIndex = -1;\r\n            document.getElementById('poi-x').value = '';\r\n            document.getElementById('poi-y').value = '';\r\n            document.getElementById('poi-z').value = '';\r\n            document.getElementById('poi-name').value = '';\r\n            document.getElementById('poi-desc').value = '';\r\n            document.getElementById('poi-color').value = '#e55336';\r\n            document.getElementById('poi-image').value = '';\r\n            document.getElementById('poi-form').style.display = 'none';\r\n            document.getElementById('poi-delete-btn').style.display = 'none';\r\n            document.getElementById('poi-status').textContent = '';\r\n            renderPoiList(poiAdminPois);\r\n        }\r\n\r\n        function showPoiStatus(msg, isError) {\r\n            const el = document.getElementById('poi-status');\r\n            el.textContent = msg;\r\n            el.style.color = isError ? '#e55336' : 'rgba(255,255,255,0.4)';\r\n        }\r\n\r\n        async function savePoiFromForm() {\r\n            const x = parseFloat(document.getElementById('poi-x').value);\r\n            const y = parseFloat(document.getElementById('poi-y').value);\r\n            const z = parseFloat(document.getElementById('poi-z').value);\r\n            const name = document.getElementById('poi-name').value.trim();\r\n            const desc = document.getElementById('poi-desc').value.trim();\r\n            const colorHex = document.getElementById('poi-color').value;\r\n            const fileInput = document.getElementById('poi-image');\r\n\r\n            if (!name || isNaN(x) || isNaN(y) || isNaN(z)) {\r\n                showPoiStatus('Completá todos los campos (X, Y, Z, Nombre)', true);\r\n                return;\r\n            }\r\n\r\n            const c = [\r\n                parseInt(colorHex.slice(1,3),16) / 255,\r\n                parseInt(colorHex.slice(3,5),16) / 255,\r\n                parseInt(colorHex.slice(5,7),16) / 255,\r\n            ];\r\n\r\n            let imgIdx = -1;\r\n\r\n            // Upload image if selected\r\n            if (fileInput.files && fileInput.files[0]) {\r\n                showPoiStatus('Subiendo imagen...');\r\n                const formData = new FormData();\r\n                formData.append('file', fileInput.files[0]);\r\n                formData.append('filename', fileInput.files[0].name);\r\n                try {\r\n                    const resp = await fetch('/api/upload', { method: 'POST', body: formData });\r\n                    const result = await resp.json();\r\n                    if (result.ok) {\r\n                        // Extract index from filename\r\n                        const match = result.filename.match(/(\\d+)\\./);\r\n                        imgIdx = match ? parseInt(match[1]) : -1;\r\n                    } else {\r\n                        showPoiStatus('Error al subir imagen', true);\r\n                        return;\r\n                    }\r\n                } catch(e) {\r\n                    showPoiStatus('Error de conexión al subir imagen', true);\r\n                    return;\r\n                }\r\n            }\r\n\r\n            const poi = { name, description: desc, position: [x, y, z], color: c };\r\n\r\n            if (imgIdx >= 0) poi.imgIdx = imgIdx;\r\n\r\n            if (poiEditingIndex >= 0) {\r\n                // Keep existing imgIdx if no new image\r\n                if (imgIdx < 0 && poiAdminPois[poiEditingIndex].imgIdx !== undefined) {\r\n                    poi.imgIdx = poiAdminPois[poiEditingIndex].imgIdx;\r\n                }\r\n                poiAdminPois[poiEditingIndex] = poi;\r\n            } else {\r\n                poiAdminPois.push(poi);\r\n            }\r\n\r\n            // Save to server\r\n            try {\r\n                const resp = await fetch(API_BASE + '/api/maqueta/pois', {\r\n                    method: 'POST',\r\n                    headers: { 'Content-Type': 'application/json' },\r\n                    body: JSON.stringify(poiAdminPois),\r\n                });\r\n                const result = await resp.json();\r\n                if (result.ok) {\r\n                    showPoiStatus('POI guardado correctamente');\r\n                    // Reload 3D markers\r\n                    S.poiData = poiAdminPois;\r\n                    // Remove old markers\r\n                    S.poiMeshes.forEach(m => scene.remove(m));\r\n                    S.poiConeMeshes.forEach(m => scene.remove(m));\r\n                    S.poiThreads.forEach(m => scene.remove(m));\r\n                    S.poiEnergyDots.forEach(m => scene.remove(m));\r\n                    // Also need to clear stored dots\r\n                    S.poiMeshes = [];\r\n                    S.poiConeMeshes = [];\r\n                    S.poiThreads = [];\r\n                    S.poiEnergyDots = [];\r\n                    S.poiFloatBase = [];\r\n                    S.poiScaleTarget = [];\r\n                    S.poiScaleCurrent = [];\r\n                    S.poiSpriteScaleTarget = [];\r\n                    S.poiSpriteScaleCurrent = [];\r\n                    createPoiSpheres(poiAdminPois);\r\n                    addPoiMarkers();\r\n                    renderPoiList(poiAdminPois);\r\n                    resetPoiForm();\r\n                } else {\r\n                    showPoiStatus('Error al guardar', true);\r\n                }\r\n            } catch(e) {\r\n                showPoiStatus('Error de conexión al guardar', true);\r\n            }\r\n        }\r\n\r\n        async function deletePoi() {\r\n            if (poiEditingIndex < 0) return;\r\n            if (!confirm(`Eliminar \"${poiAdminPois[poiEditingIndex].name}\"?`)) return;\r\n\r\n            poiAdminPois.splice(poiEditingIndex, 1);\r\n            try {\r\n                const resp = await fetch(API_BASE + '/api/maqueta/pois', {\r\n                    method: 'POST',\r\n                    headers: { 'Content-Type': 'application/json' },\r\n                    body: JSON.stringify(poiAdminPois),\r\n                });\r\n                const result = await resp.json();\r\n                if (result.ok) {\r\n                    // Reload 3D markers\r\n                    S.poiData = poiAdminPois;\r\n                    S.poiMeshes.forEach(m => scene.remove(m));\r\n                    S.poiConeMeshes.forEach(m => scene.remove(m));\r\n                    S.poiThreads.forEach(m => scene.remove(m));\r\n                    S.poiEnergyDots.forEach(m => scene.remove(m));\r\n                    S.poiMeshes = [];\r\n                    S.poiConeMeshes = [];\r\n                    S.poiThreads = [];\r\n                    S.poiEnergyDots = [];\r\n                    S.poiFloatBase = [];\r\n                    S.poiScaleTarget = [];\r\n                    S.poiScaleCurrent = [];\r\n                    S.poiSpriteScaleTarget = [];\r\n                    S.poiSpriteScaleCurrent = [];\r\n                    createPoiSpheres(poiAdminPois);\r\n                    addPoiMarkers();\r\n                    resetPoiForm();\r\n                    showPoiStatus('POI eliminado');\r\n                } else {\r\n                    showPoiStatus('Error al eliminar', true);\r\n                }\r\n            } catch(e) {\r\n                showPoiStatus('Error de conexión', true);\r\n            }\r\n        }\r\n\r\n        // Wire up POI admin UI\r\n        document.getElementById('sv-admin').addEventListener('click', () => {\r\n            document.getElementById('poi-admin-overlay').classList.add('v');\r\n            loadPoiList();\r\n        });\r\n        document.getElementById('poi-admin-close').addEventListener('click', () => {\r\n            document.getElementById('poi-admin-overlay').classList.remove('v');\r\n            resetPoiForm();\r\n        });\r\n        document.getElementById('poi-admin-overlay').addEventListener('click', (e) => {\r\n            if (e.target === e.currentTarget) {\r\n                document.getElementById('poi-admin-overlay').classList.remove('v');\r\n                resetPoiForm();\r\n            }\r\n        });\r\n        document.getElementById('poi-add-btn').addEventListener('click', () => {\r\n            poiEditingIndex = -1;\r\n            document.getElementById('poi-x').value = '0';\r\n            document.getElementById('poi-y').value = '0.7';\r\n            document.getElementById('poi-z').value = '0';\r\n            document.getElementById('poi-name').value = '';\r\n            document.getElementById('poi-desc').value = '';\r\n            document.getElementById('poi-color').value = '#e55336';\r\n            document.getElementById('poi-image').value = '';\r\n            document.getElementById('poi-form').style.display = 'block';\r\n            document.getElementById('poi-delete-btn').style.display = 'none';\r\n            document.getElementById('poi-status').textContent = 'Nuevo POI';\r\n            renderPoiList(poiAdminPois);\r\n        });\r\n        document.getElementById('poi-save-btn').addEventListener('click', savePoiFromForm);\r\n        document.getElementById('poi-delete-btn').addEventListener('click', deletePoi);\r\n\r\n        function animate(time) {\r\n            requestAnimationFrame(animate);\r\n            \r\n            // Inertial damping\r\n            S.yaw += S.vY; S.vY *= CFG.friction;\r\n            S.pitch += S.vP; S.vP *= CFG.friction;\r\n            S.pitch = Math.max(CFG.minPitch, Math.min(CFG.maxPitch, S.pitch));\r\n            S.dist += S.vD; S.vD *= CFG.friction;\r\n            S.dist = Math.max(CFG.minDist, Math.min(CFG.maxDist, S.dist));\r\n            \r\n            // Auto-rotation: idle timer counts up when user is not touching\r\n            if (!S.isDrag && !S.isDown) {\r\n                S.idleTimer += 1/60;\r\n                if (S.idleTimer >= S.idleTimeout && !S.autoRotate) {\r\n                    S.autoRotate = true;\r\n                    // Reset to ideal view\r\n                    S.tDist = CFG.defaultDist;\r\n                    S.tPitch = CFG.defaultPitch;\r\n                    S.tYaw = CFG.defaultYaw;\r\n                    S.camTarget.set(0, 0.2, 0);\r\n                    // Restore saved scale\r\n                    CFG.modelScale = CFG.defaultModelScale;\r\n                    svScale.value = CFG.defaultModelScale;\r\n                    svScaleVal.textContent = CFG.defaultModelScale.toFixed(5);\r\n                    if (S.model) S.model.scale.set(CFG.defaultModelScale, CFG.defaultModelScale, CFG.defaultModelScale);\r\n                }\r\n            }\r\n            if (S.autoRotate) {\r\n                S.tYaw += S.autoRotateSpeed * 0.016;\r\n            }\r\n            \r\n            S.yaw += (S.tYaw - S.yaw) * 0.1;\r\n            S.pitch += (S.tPitch - S.pitch) * 0.1;\r\n            S.dist += (S.tDist - S.dist) * 0.1;\r\n            \r\n            // Smooth camera target lerp (for POI fly-to)\r\n            S.camTargetCurrent.lerp(S.camTarget, 0.06);\r\n            if (S.camTargetCurrent.distanceTo(S.camTarget) < 0.01) {\r\n                S.camTargetCurrent.copy(S.camTarget);\r\n                S.camAnimating = false;\r\n            }\r\n            \r\n            updateCam();\r\n\r\n            const t = time / 1000;\r\n\r\n            // Smooth hover scale animation (lerp)\r\n            const LERP_SPEED = 0.12;\r\n            S.poiScaleCurrent.forEach((cur, idx) => {\r\n                const target = S.poiScaleTarget[idx] || 1;\r\n                const newCur = cur + (target - cur) * LERP_SPEED;\r\n                S.poiScaleCurrent[idx] = newCur;\r\n                const mesh = S.poiMeshes[idx];\r\n                if (mesh) mesh.scale.set(newCur, newCur, newCur);\r\n            });\r\n            \r\n            // Smooth sprite (cartelito) scale animation (lerp)\r\n            S.poiSpriteScaleCurrent.forEach((cur, idx) => {\r\n                const target = S.poiSpriteScaleTarget[idx] || 1;\r\n                const newCur = cur + (target - cur) * LERP_SPEED;\r\n                S.poiSpriteScaleCurrent[idx] = newCur;\r\n                const sprite = S.poiConeMeshes[idx];\r\n                if (sprite) {\r\n                    const bW = sprite.userData.baseScaleW || 1.3;\r\n                    const bH = sprite.userData.baseScaleH || 0.45;\r\n                    sprite.scale.set(bW * newCur, bH * newCur, 1);\r\n                    // Floating animation on hover: cloud bobs up and down\r\n                    const isHovered = idx === S.hoveredPOI;\r\n                    const baseY = S.poiFloatBase[idx] || sprite.position.y;\r\n                    if (isHovered) {\r\n                        const floatOffset = Math.sin(t * 2.5 + idx * 1.2) * 0.08;\r\n                        sprite.position.y = baseY + floatOffset;\r\n                    } else {\r\n                        sprite.position.y += (baseY - sprite.position.y) * 0.05;\r\n                    }\r\n                }\r\n            });\r\n            \r\n            // Animate base dots breathing\r\n            const SIGN_HEIGHT = 1.8;\r\n            if (S.poiThreads) {\r\n                S.poiThreads.forEach((th, idx) => {\r\n                    const isHovered = idx === S.hoveredPOI;\r\n                    // When hovered: brighter, faster pulse + energy orb travels the thread\r\n                    if (isHovered) {\r\n                        const brightPulse = 0.6 + 0.4 * Math.sin(t * 3 + idx * 0.5);\r\n                        th.material.opacity = brightPulse;\r\n                        \r\n                        // Energy orb traveling up/down the thread\r\n                        const energyDot = S.poiEnergyDots[idx];\r\n                        if (energyDot) {\r\n                            const wp = S.poiMeshes[idx].position;\r\n                            const travel = 0.5 + 0.5 * Math.sin(t * 2.5 + (energyDot.userData.phase || 0));\r\n                            const h = SIGN_HEIGHT - 0.15;\r\n                            energyDot.position.set(wp.x, wp.y + travel * h, wp.z);\r\n                            energyDot.material.opacity = travel * 0.8;\r\n                            const s = 0.8 + 1.2 * travel;\r\n                            energyDot.scale.set(s, s, s);\r\n                        }\r\n                    } else {\r\n                        // Subtle opacity pulse on white line (idle)\r\n                        const breathe = 0.4 + 0.15 * Math.sin(t * 0.8 + idx * 0.5);\r\n                        th.material.opacity = breathe;\r\n                        \r\n                        // Hide energy orb when not hovered\r\n                        const energyDot = S.poiEnergyDots[idx];\r\n                        if (energyDot) {\r\n                            energyDot.material.opacity = 0;\r\n                        }\r\n                    }\r\n                });\r\n            }\r\n            \r\n            // Hover check every frame\r\n            updateHover();\r\n\r\n            // Auto-attach if edit mode is active but no POI is selected yet\r\n            if (editMode && editAttachedIdx < 0 && S.poiMeshes.length > 0) {\r\n                attachControlsToPoi(0);\r\n            }\r\n            \r\n            // FPS counter\r\n            S.frameCount++;\r\n            if (time - S.lastFpsTime >= 1000) {\r\n                document.getElementById('fps').textContent = `${S.frameCount} FPS`;\r\n                S.frameCount = 0;\r\n                S.lastFpsTime = time;\r\n            }\r\n            \r\n            composer.render();\r\n        }\r\n        animate(0);\r\n\r\n        window.addEventListener('resize', () => {\r\n            const w=window.innerWidth, h=window.innerHeight;\r\n            camera.aspect=w/h; camera.updateProjectionMatrix(); renderer.setSize(w,h);\r\n            composer.setSize(w, h);\r\n            bloomPass.resolution.set(w, h);\r\n        });\r\n\r\n        setTimeout(() => {\r\n            // Only hide intro hint after intro is dismissed\r\n            const checkIntro = setInterval(() => {\r\n                if (document.getElementById('intro').classList.contains('hide')) {\r\n                    document.getElementById('in').classList.add('h');\r\n                    clearInterval(checkIntro);\r\n                }\r\n            }, 500);\r\n        }, 6000);\r\n\r\n        // === INTRO: MAP OF ARGENTINA → ZOOM TO SAN JUAN → FADE TO MAQUETA ===\r\n        document.getElementById('intro-btn').addEventListener('click', () => {\r\n            const intro = document.getElementById('intro');\r\n            // Start zoom animation on the map\r\n            intro.classList.add('zoom-in');\r\n            // After zoom completes, hide intro + start auto-rotation\r\n            setTimeout(() => {\r\n                intro.classList.add('hide');\r\n                S.introActive = false;\r\n                S.autoRotate = true;\r\n                S.idleTimer = S.idleTimeout; // trigger auto-rotate immediately\r\n            }, 2800);\r\n        });\r\n    "
        },
        {
          "path": "D:/Programacion/caminosysabores/public/maqueta/pois.json",
          "name": "pois.json",
          "content": "[\n  {\n    \"name\": \"Circuito Cultural\",\n    \"subtitle\": \"Valle de Tulum\",\n    \"circuit\": \"Circuito Cultural\",\n    \"color\": [\n      1,\n      0.85,\n      0.2\n    ],\n    \"position\": [\n      0.2930851033056974,\n      -0.01375137078469002,\n      3.2765443584008738\n    ],\n    \"image\": \"CASA NATAL DE SARMIENTO VALLE DE TULUM  MAQUETA.png\",\n    \"subsections\": [\n      {\n        \"title\": \"Museo Provincial de Bellas Artes Franklin Rawson\",\n        \"description\": \"El Museo Provincial de Bellas Artes Franklin Rawson alberga una de las colecciones de arte más importantes del interior del país. Con más de 5.000 m², cuenta con salas de exhibición permanente y temporaria, auditorio, biblioteca especializada, talleres, unidad de restauración, tienda y restaurante. Su moderna infraestructura y programación de alcance provincial, nacional e internacional lo posicionan como un referente cultural y artístico de vanguardia en San Juan.\",\n        \"image\": \"sub_poi_images/museo_rawson.jpg\"\n      },\n      {\n        \"title\": \"Teatro del Bicentenario\",\n        \"description\": \"El centro cultural más importante y vanguardista de San Juan. Este imponente espacio teatral permite la producción integral de espectáculos artísticos de gran envergadura.\",\n        \"image\": \"sub_poi_images/teatro_bicentenario.jpg\"\n      },\n      {\n        \"title\": \"Mercado Artesanal Tradicional Luisa Escudero\",\n        \"description\": \"El 25 de mayo de 1985, fue inaugurado en el edificio del Auditorio Ing. Juan Victoria para rescatar, promover y fomentar las artesanías tradicionales de San Juan. En octubre de 1993, fue trasladado a los antiguos galpones del Ferrocarril Belgrano. Sus acciones están orientadas al servicio de consolidación, fortalecimiento y desarrollo del sector artesanal desde la interacción sensible, respetuosa, solidaria y colaborativa.\",\n        \"image\": \"sub_poi_images/mercado_artesanal.jpg\"\n      },\n      {\n        \"title\": \"Centro Cultural Conte Grand\",\n        \"description\": \"Espacio diverso e inclusivo de cultura urbana y emergente de la provincia de San Juan. El Centro Cultural Conte Grand es un referente dinámico para toda la comunidad sanjuanina. Desde su inauguración en 2007, este espacio público alberga artes visuales, música, teatro, cine, cultura urbana y tecnología.\",\n        \"image\": \"sub_poi_images/conte_grand.jpg\"\n      },\n      {\n        \"title\": \"Bandera del Ejército de los Andes (Cabot)\",\n        \"description\": \"La Bandera Ciudadana es la que confeccionaron en 1817 los ciudadanos y que fue llevada por la Cuarta Columna comandada por el teniente coronel Juan Manuel Cabot, en ocasión de la Gesta Libertadora. Fue destinada para ser el emblema de la Provincia de San Juan.\",\n        \"image\": \"sub_poi_images/bandera_cabot.jpg\"\n      },\n      {\n        \"title\": \"Museo Histórico Prov. Agustín V. Gnecco\",\n        \"description\": \"Institución dedicada a preservar, investigar y difundir el patrimonio histórico sanjuanino. Fue fundado por el coleccionista Agustín Gnecco en 1886, quien reunió una vasta colección que hoy supera las 160.000 piezas, incluyendo objetos arqueológicos, documentos coloniales, numismática, filatelia y elementos de la vida cotidiana.\",\n        \"image\": \"sub_poi_images/museo_gnecco.jpg\"\n      },\n      {\n        \"title\": \"Museo y Biblioteca Casa Natal de Sarmiento\",\n        \"description\": \"Institución dedicada a preservar, investigar y difundir el patrimonio histórico sanjuanino. Fue fundado por el coleccionista Agustín Gnecco en 1886, quien reunió una vasta colección que hoy supera las 160.000 piezas, incluyendo objetos arqueológicos, documentos coloniales, numismática, filatelia y elementos de la vida cotidiana.\",\n        \"image\": \"sub_poi_images/casa_sarmiento.jpg\"\n      },\n      {\n        \"title\": \"Dirección de Bibliotecas Populares y Actividades Literarias\",\n        \"description\": \"Se rige por tres pilares fundamentales: fomentar la lectura en la ciudadanía sanjuanina, promocionar la literatura de autores locales y apoyar a las bibliotecas populares de la provincia. En su edificio se ofrece servicio de bibliotecas, incluyendo la Biblioteca de Autores Sanjuaninos, que cuenta con un importante patrimonio bibliográfico de escritores locales, y la Biblioteca de Literatura Gráfica, que posee el acervo de manga, cómics e historietas más grande de San Juan.\",\n        \"image\": \"sub_poi_images/bibliotecas_populares.jpg\"\n      },\n      {\n        \"title\": \"Biblioteca Infantil Juan Pablo Echagüe\",\n        \"description\": \"La Biblioteca Infantil Provincial Juan Pablo Echagüe, ubicada en una histórica casona de la ciudad de San Juan, promueve la lectura, la creatividad y la inclusión cultural de niños y niñas. Además de resguardar el legado literario de la familia Echagüe, ofrece talleres gratuitos, visitas guiadas y actividades recreativas que fortalecen el acceso a la cultura en la comunidad sanjuanina.\",\n        \"image\": \"sub_poi_images/biblioteca_echague.jpg\"\n      },\n      {\n        \"title\": \"Chalet Cantoni Casa Cultural\",\n        \"description\": \"El Chalet Cantoni – Casa Cultural es un espacio que reúne a trabajadores de la cultura sanjuanina y promueve la formación, el desarrollo y la difusión de proyectos culturales. Además, impulsa propuestas artísticas abiertas a la comunidad, abarcando disciplinas como música, teatro, literatura, fotografía, artes visuales, danza y gastronomía.\",\n        \"image\": \"sub_poi_images/chalet_cantoni.jpg\"\n      },\n      {\n        \"title\": \"Teatro Sarmiento\",\n        \"description\": \"El Teatro Sarmiento, uno de los principales espacios culturales de San Juan, fue reinaugurado en 2025 tras una importante remodelación que modernizó sus instalaciones y equipamiento. Con capacidad para 850 espectadores, combina su valor histórico con nuevas condiciones de confort, accesibilidad y tecnología, consolidándose como un escenario clave para espectáculos de teatro, música, danza y humor en la provincia.\",\n        \"image\": \"sub_poi_images/teatro_sarmiento.jpg\"\n      }\n    ]\n  },\n  {\n    \"name\": \"Calingasta\",\n    \"subtitle\": \"El Leoncito · Barreal\",\n    \"circuit\": \"Calingasta\",\n    \"color\": [\n      0.3,\n      0.3,\n      0.9\n    ],\n    \"position\": [\n      -2.356321603335825,\n      0.23997626009813933,\n      1.9669206499264322\n    ],\n    \"image\": \"OBSERVATORIO CALINGASTA MAQUETA.png\",\n    \"subsections\": [\n      {\n        \"title\": \"Parque Nacional El Leoncito\",\n        \"description\": \"Observación astronómica en uno de los cielos más limpios de Sudamérica, visitas a los Observatorios CASLEO y Carlos U. Cesco, senderos naturales, la Cascada El Rincón y paisajes únicos de montaña, desierto y biodiversidad. El parque cuenta con más de 300 noches despejadas al año, lo que reafirma que San Juan es la capital nacional del turismo astronómico.\",\n        \"image\": \"sub_poi_images/parque_leoncito.jpg\"\n      },\n      {\n        \"title\": \"Pampa del Leoncito (Barreal Blanco)\",\n        \"description\": \"La Pampa del Leoncito, también conocida como Barreal Blanco, es una inmensa planicie natural ubicada en la localidad de Barreal. Con aproximadamente 12 km de largo, este paisaje único se destaca por su superficie lisa, los vientos constantes y el imponente marco de la Cordillera de los Andes. Es el escenario ideal para practicar carrovelismo.\",\n        \"image\": \"sub_poi_images/pampa_leoncito.jpg\"\n      },\n      {\n        \"title\": \"Carrovelismo en Barreal\",\n        \"description\": \"Viví una experiencia única deslizándote sobre la inmensa Pampa del Leoncito a bordo de un carro impulsado únicamente por el viento. Esta actividad combina adrenalina, naturaleza y paisajes extraordinarios, aprovechando las ráfagas del característico viento \\\"Conchabado\\\", que puede alcanzar velocidades cercanas a los 80 km/h.\",\n        \"image\": \"sub_poi_images/carrovelismo.jpg\"\n      }\n    ]\n  },\n  {\n    \"name\": \"Jáchal\",\n    \"subtitle\": \"Aventura en el Norte Sanjuanino\",\n    \"circuit\": \"Jáchal\",\n    \"color\": [\n      0.9,\n      0.5,\n      0.1\n    ],\n    \"position\": [\n      0.3172505097512671,\n      0.14322989109754736,\n      -0.7870174256257787\n    ],\n    \"image\": \"ACEITUNAS RUTA DEL OLIVO.png\",\n    \"subsections\": [\n      {\n        \"title\": \"Garganta del Río Jáchal: Rafting\",\n        \"description\": \"Viví la emoción del rafting en la Garganta del Río Jáchal, un imponente cañón natural rodeado de paisajes montañosos y formaciones rocosas únicas. Sus rápidos ofrecen una experiencia ideal para quienes buscan aventura y contacto con la naturaleza, combinando adrenalina, diversión y vistas espectaculares del norte sanjuanino en un entorno de gran belleza escénica.\",\n        \"image\": \"sub_poi_images/garganta_jachal.jpg\"\n      },\n      {\n        \"title\": \"RN 150 | Huaco e Ischigualasto\",\n        \"description\": \"La Ruta Nacional 150 es uno de los corredores turísticos más emblemáticos de San Juan. Su tramo escénico conecta los paisajes y atractivos de Huaco, en el departamento Jáchal, con Ischigualasto, en el departamento Valle Fértil, atravesando imponentes formaciones geológicas, túneles y miradores naturales. Este recorrido permite disfrutar de la riqueza histórica, cultural y paleontológica de la provincia, enmarcada por algunos de los paisajes más sorprendentes del oeste argentino.\",\n        \"image\": \"sub_poi_images/rn150_ischigualasto.jpg\"\n      }\n    ]\n  },\n  {\n    \"name\": \"Iglesia\",\n    \"subtitle\": \"Alta Montaña y Naturaleza\",\n    \"circuit\": \"Iglesia\",\n    \"color\": [\n      0.8,\n      0.2,\n      0.3\n    ],\n    \"position\": [\n      -1.4292941282903286,\n      -0.460466695399253,\n      -2.023470907863878\n    ],\n    \"image\": \"PARQUE NACIONAL SAN GUILLERMO IGLESIA MAQUETA.png\",\n    \"subsections\": [\n      {\n        \"title\": \"Parque Nacional San Guillermo y Reserva de la Biósfera\",\n        \"description\": \"Descubrí uno de los santuarios naturales más importantes de Argentina. El Parque Nacional San Guillermo y la Reserva de la Biosfera protegen extensos paisajes de alta montaña y una extraordinaria biodiversidad, destacándose por albergar la mayor población de vicuñas del país. Entre cordones montañosos, vegas y planicies andinas, este espacio único invita a la observación de fauna silvestre, el turismo de naturaleza y la contemplación de uno de los ambientes más prístinos de la cordillera sanjuanina.\",\n        \"image\": \"sub_poi_images/parque_san_guillermo.jpg\"\n      },\n      {\n        \"title\": \"Turismo de Fe | Capilla de Achango y Cristo de Tocota\",\n        \"description\": \"La Capilla de Achango, construida por los jesuitas en el siglo XVII, es uno de los templos más antiguos de San Juan. Ubicada en el departamento de Iglesia, conserva su arquitectura original y resguarda la histórica imagen de la Virgen del Carmen, convirtiéndose en un destacado sitio de fe y patrimonio cultural. El Cristo de Tocota, emplazado en plena cordillera sanjuanina, es un símbolo de fe y contemplación. Rodeado por imponentes paisajes de montaña, este atractivo combina espiritualidad, naturaleza y vistas panorámicas únicas en el departamento de Iglesia.\",\n        \"image\": \"sub_poi_images/capilla_achango.jpg\"\n      },\n      {\n        \"title\": \"Paso Internacional de Agua Negra\",\n        \"description\": \"El Paso Internacional de Agua Negra es uno de los principales atractivos de alta montaña de San Juan. Desde la localidad de Las Flores, en el departamento de Iglesia, este camino conecta Argentina con Chile a través de un recorrido que supera los 4.700 metros sobre el nivel del mar, ofreciendo paisajes cordilleranos, miradores naturales y vistas panorámicas únicas de los Andes.\",\n        \"image\": \"sub_poi_images/paso_agua_negra.jpg\"\n      },\n      {\n        \"title\": \"Dique Cuesta del Viento | Windsurf y Kitesurf\",\n        \"description\": \"El Dique Cuesta del Viento, ubicado en Rodeo, departamento de Iglesia, es reconocido internacionalmente por sus condiciones ideales para la práctica de windsurf y kitesurf. Rodeado por imponentes paisajes cordilleranos, combina deporte, naturaleza y aventura, convirtiéndose en uno de los destinos más visitados de San Juan.\",\n        \"image\": \"sub_poi_images/dique_cuesta_viento.jpg\"\n      }\n    ]\n  },\n  {\n    \"name\": \"Valle Fértil\",\n    \"subtitle\": \"Valle de la Luna y Naturaleza Serena\",\n    \"circuit\": \"Valle Fértil\",\n    \"color\": [\n      0.2,\n      0.7,\n      0.3\n    ],\n    \"position\": [\n      3.1265539658613397,\n      0.023829998478390846,\n      0.5058307214355072\n    ],\n    \"image\": \"ISCHIGUALASTO MAQUETA.png\",\n    \"subsections\": [\n      {\n        \"title\": \"Parque Provincial Ischigualasto | Valle de la Luna\",\n        \"description\": \"El Parque Provincial Ischigualasto, conocido mundialmente como Valle de la Luna, es el principal atractivo turístico de Valle Fértil y uno de los sitios paleontológicos más importantes del mundo. Declarado Patrimonio Mundial por la UNESCO, resguarda formaciones geológicas de millones de años y fósiles que permiten conocer los orígenes de los dinosaurios. Sus paisajes únicos y sus geoformas naturales lo convierten en un destino imperdible de San Juan.\",\n        \"image\": \"sub_poi_images/ischigualasto_valle_luna.jpg\"\n      },\n      {\n        \"title\": \"Dique San Agustín\",\n        \"description\": \"El Dique San Agustín es uno de los principales atractivos de Valle Fértil. Ubicado junto a la villa cabecera de San Agustín, ofrece un entorno ideal para disfrutar de la naturaleza, realizar actividades recreativas, pesca deportiva y contemplar hermosos paisajes serranos, convirtiéndose en un lugar de descanso y esparcimiento para visitantes y residentes.\",\n        \"image\": \"sub_poi_images/dique_san_agustin.jpg\"\n      },\n      {\n        \"title\": \"Las Tumanas y Astica\",\n        \"description\": \"Las Tumanas es una pintoresca localidad de Valle Fértil rodeada de sierras, vegetación autóctona y arroyos temporarios. Su entorno natural la convierte en un destino ideal para quienes buscan tranquilidad, turismo rural y contacto con la naturaleza. Astica es una de las localidades más tradicionales de Valle Fértil, reconocida por sus paisajes serranos, su riqueza cultural y sus espacios naturales. Es un punto de partida para recorrer diversos atractivos de la región y disfrutar de la vida rural característica del departamento.\",\n        \"image\": \"sub_poi_images/las_tumanas.jpg\"\n      }\n    ]\n  },\n  {\n    \"name\": \"Ruta Interlagos\",\n    \"subtitle\": \"Diques y Aventura sobre el Agua\",\n    \"circuit\": \"Ruta Interlagos\",\n    \"color\": [\n      0.2,\n      0.6,\n      0.8\n    ],\n    \"position\": [\n      -1.0289532092453793,\n      0.29999999999999993,\n      2.3904685959404475\n    ],\n    \"image\": \"DIQUE PUNTA NEGRA MAQUETA.png\",\n    \"subsections\": [\n      {\n        \"title\": \"Recorrido y Actividades\",\n        \"description\": \"Presenta un recorrido de más de 100 km entre montañas que envuelven los espejos de agua para disfrutar con amigos y en familia. En el recorrido se encuentran atractivos de interés cultural, balnearios, camping, alojamientos y servicios gastronómicos que invitan a vivir una experiencia a pleno en contacto con la naturaleza. Podés realizar actividades de esparcimiento en familia o con amigos en balnearios y camping del Dique de Ullum y en Paradores del Dique Punta Negra. Actividades náuticas: navegación a vela, paseos en lanchas, kayak, kitesurf, windsurf, stand up paddle, wakeboard, esquí acuático, pesca y buceo. Actividades de montaña: senderismo, trekking, mountain bike, escalada deportiva o en muro, cabalgatas entre viñedos. Actividades aéreas: tirolesa cruzando el Río San Juan y parapente desde el Cerro Tres Marías o las Sierras Azules.\",\n        \"image\": \"sub_poi_images/ruta_interlagos.jpg\"\n      }\n    ]\n  },\n  {\n    \"name\": \"Gobierno de San Juan\",\n    \"subtitle\": \"\",\n    \"circuit\": \"\",\n    \"color\": [0.9, 0.39, 0.24],\n    \"position\": [-0.5, 0.1, 0.5],\n    \"image\": \"GOBIERNO DE SAN JUAN.png\",\n    \"disabled\": true,\n    \"subsections\": []\n  }\n]"
        },
