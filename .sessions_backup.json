deo = null; cell.url = null; cell.presetIdx = -1; cell.thumb = ''; cell.gframes = null;\r\n  refreshCell(cell.l, cell.c); markDirty();\r\n  try {\r\n    if (!('ImageDecoder' in window)) throw new Error('este navegador no decodifica GIFs (usá Chrome)');\r\n    const dec = new ImageDecoder({ data: await file.arrayBuffer(), type: 'image/gif' });\r\n    await dec.tracks.ready;\r\n    const n = Math.min(dec.tracks.selectedTrack.frameCount || 1, 240);\r\n    const frames = [];\r\n    for (let i = 0; i < n; i++) {\r\n      const r = await dec.decode({ frameIndex: i });\r\n      frames.push({ bmp: await createImageBitmap(r.image), dur: Math.max(.02, (r.image.duration || 8e4) / 1e6) });\r\n      r.image.close();\r\n    }\r\n    dec.close();\r\n    cell.gframes = frames;\r\n    cell.gtotal = frames.reduce((a, f) => a + f.dur, 0);\r\n    const cv = document.createElement('canvas'); cv.width = 160; cv.height = 90;\r\n    const x = cv.getContext('2d');\r\n    const b0 = frames[0].bmp, vAR = b0.width / b0.height, cAR = 160 / 90;\r\n    let sw = b0.width, sh = b0.height, sx = 0, sy = 0;\r\n    if (vAR > cAR) { sw = sh * cAR; sx = (b0.width - sw) / 2; } else { sh = sw / cAR; sy = (b0.height - sh) / 2; }\r\n    x.drawImage(b0, sx, sy, sw, sh, 0, 0, 160, 90);\r\n    cell.thumb = cv.toDataURL('image/jpeg', .6);\r\n  } catch (err) {\r\n    console.error(err);\r\n    toast('GIF: ' + (err.message || 'no se pudo decodificar'));\r\n    cell.kind = 'empty';\r\n  }\r\n  refreshCell(cell.l, cell.c); markDirty(); updateRelinkBar();\r\n}\r\nfunction assignVideo(cell, file) {\r\n  if (cell.url) URL.revokeObjectURL(cell.url);\r\n  cell.kind = 'video'; cell.file = file; cell.name = file.name.replace(/\\.[^.]+$/, '');\r\n  cell.url = URL.createObjectURL(file);\r\n  cell.video = makeVideoEl(cell.url);\r\n  cell.presetIdx = -1; cell.thumb = '';\r\n  genThumb(cell);\r\n  refreshCell(cell.l, cell.c); markDirty(); updateRelinkBar();\r\n}\r\nfunction assignVideosFrom(l, c, files) {\r\n  let ci = c;\r\n  for (const f of files) {\r\n    if (ci >= COLS) addColumns(files.length - (ci - c));\r\n    assignMedia(state.grid[l][ci], f); ci++;\r\n  }\r\n  toast(`${files.length} clip(s) en CAPA ${l + 1}`);\r\n}\r\nfunction fillEmpty(files) {\r\n  let i = 0;\r\n  for (let l = 0; l < LAYERS && i < files.length; l++)\r\n    for (let c = 0; c < COLS && i < files.length; c++)\r\n      if (state.grid[l][c].kind === 'empty') assignMedia(state.grid[l][c], files[i++]);\r\n  while (i < files.length) { // no quedaban celdas: agregar columnas\r\n    addColumns(1);\r\n    for (let l = 0; l < LAYERS && i < files.length; l++) assignMedia(state.grid[l][COLS - 1], files[i++]);\r\n  }\r\n  toast(`${files.length} clip(s) cargados`);\r\n}\r\nfunction assignPreset(cell, pi) {\r\n  cell.kind = 'gen'; cell.presetIdx = pi; cell.name = genName(pi);\r\n  cell.file = null; cell.video = null; cell.thumb = '';\r\n  refreshCell(cell.l, cell.c); markDirty();\r\n}\r\nfunction assignText(cell, str) {\r\n  cell.kind = 'text'; cell.name = str; cell.presetIdx = -1;\r\n  cell.file = null; cell.video = null; cell.thumb = ''; cell.tcanvas = null;\r\n  refreshCell(cell.l, cell.c); markDirty();\r\n}\r\n$('#addVidBtn').onclick = () => $('#fileIn').click();\r\n$('#newBtn').onclick = () => newSet();\r\n$('#fileIn').onchange = e => { const f = [...e.target.files]; if (f.length) fillEmpty(f); e.target.value = ''; };\r\n/* drop global (fuera de una celda): rellenar vacías */\r\ndocument.addEventListener('dragover', e => {\r\n  e.preventDefault();\r\n  // el velo solo para archivos externos; mover clips/presets adentro no lo necesita\r\n  if ([...e.dataTransfer.types].includes('Files')) $('#dropveil').style.display = 'block';\r\n});\r\ndocument.addEventListener('dragleave', e => { if (!e.relatedTarget) $('#dropveil').style.display = 'none'; });\r\ndocument.addEventListener('drop', e => {\r\n  e.preventDefault(); $('#dropveil').style.display = 'none';\r\n  const files = [...e.dataTransfer.files].filter(isMediaFile);\r\n  if (files.length) fillEmpty(files);\r\n});\r\ndocument.addEventListener('dragend', () => { // limpia restos si el drag se suelta o cancela en cualquier lado\r\n  $('#dropveil').style.display = 'none';\r\n  document.querySelectorAll('.cell.dragover').forEach(x => x.classList.remove('dragover'));\r\n});\r\n\r\n/* ---------------- shelf de generadores ---------------- */\r\nfunction buildShelf() {\r\n  const sh = $('#genShelf');\r\n  sh.innerHTML = '';\r\n  // los customs pueden haber cambiado → regenerar snapshots de celdas gen\r\n  (state.decks || [state.grid]).forEach(g =>\r\n    g.flat().forEach(c => { if (c.kind === 'gen') c._pv = false; }));\r\n  // creador de generadores por bloques\r\n  const mk = el('div', 'gtile');\r\n  mk.innerHTML = '<span>🧪</span>CREAR…';\r\n  mk.title = 'armá tu propio generador con bloques: base + deformación + color + reacción';\r\n  mk.style.borderColor = 'var(--acc)';\r\n  mk.onclick = () => openGenBuilder();\r\n  sh.appendChild(mk);\r\n  const gt = el('div', 'gtile');\r\n  gt.innerHTML = '<span>📜</span>GLSL…';\r\n  gt.title = 'pegá shaders de Shadertoy o cargá un .frag — poder ilimitado';\r\n  gt.style.borderColor = 'var(--acc2)';\r\n  gt.onclick = () => openGlslEditor();\r\n  sh.appendChild(gt);\r\n  const nt = el('div', 'gtile');\r\n  nt.innerHTML = '<span>🕸</span>NODOS…';\r\n  nt.title = 'editor de nodos con cables: conectá bloques y armá tu visual';\r\n  nt.style.borderColor = '#2fd8ff';\r\n  nt.onclick = () => openNodeEditor();\r\n  sh.appendChild(nt);\r\n  // customs del usuario\r\n  state.customGens.forEach((cg, i) => {\r\n    const t = el('div', 'gtile');\r\n    t.innerHTML = `<span>${cg.type === 'glsl' ? '📜' : cg.type === 'nodes' ? '🕸' : '🧪'}</span>${cg.name}`;\r\n    t.style.color = 'var(--warn)';\r\n    t.draggable = true;\r\n    t.ondragstart = e => e.dataTransfer.setData('text/preset', 1000 + i);\r\n    t.oncontextmenu = e => {\r\n      e.preventDefault();\r\n      showMenu(e.clientX, e.clientY, (cg.type === 'glsl' ? '📜 ' : '🧪 ') + cg.name, [\r\n        { label: '👁 Ver en previa', fn: () => setPreview({ kind: 'gen', presetIdx: 1000 + i, l: -1, c: -1, name: cg.name }) },\r\n        { label: '✏ Editar…', fn: () => cg.type === 'glsl' ? openGlslEditor(cg, i) : cg.type === 'nodes' ? openNodeEditor(cg, i) : openGenBuilder(cg, i) },\r\n        {\r\n          label: '⬇ Exportar .json (compartir)', fn: () => {\r\n            const { _v, ...clean } = cg;\r\n            const a = document.createElement('a');\r\n            a.href = URL.createObjectURL(new Blob(\r\n              [JSON.stringify({ ravenGen: 1, gen: clean }, null, 1)], { type: 'application/json' }));\r\n            a.download = 'ravenvj-gen-' + cg.name.replace(/\\W+/g, '_') + '.json';\r\n            a.click();\r\n            toast('Generador exportado — pasáselo a otro VJ 🤝');\r\n          }\r\n        },\r\n        { label: '🧹 Eliminar', fn: () => { state.customGens.splice(i, 1); buildShelf(); markDirty(); } },\r\n      ]);\r\n    };\r\n    sh.appendChild(t);\r\n  });\r\n  PRESETS.forEach((p, i) => {\r\n    const t = el('div', 'gtile');\r\n    t.innerHTML = `<span>${p.icon}</span>${p.name}`;\r\n    t.draggable = true;\r\n    t.ondragstart = e => e.dataTransfer.setData('text/preset', i);\r\n    t.oncontextmenu = e => { e.preventDefault(); setPreview({ kind: 'gen', presetIdx: i, l: -1, c: -1, name: p.name }); };\r\n    sh.appendChild(t);\r\n  });\r\n  const tt = el('div', 'gtile');\r\n  tt.innerHTML = '<span>💬</span>Texto';\r\n  tt.title = 'arrastrá a una celda y escribí tu texto (nombre de la fiesta, etc.)';\r\n  tt.style.color = 'var(--acc2)';\r\n  tt.draggable = true;\r\n  tt.ondragstart = e => e.dataTransfer.setData('text/texto', '1');\r\n  sh.appendChild(tt);\r\n  const cam = el('div', 'gtile');\r\n  cam.innerHTML = '<span>📷</span>Cámara';\r\n  cam.title = 'webcam o capturadora HDMI en vivo: arrastrá a una celda y elegí el dispositivo';\r\n  cam.style.color = '#7fc4ff';\r\n  cam.draggable = true;\r\n  cam.ondragstart = e => e.dataTransfer.setData('text/cam', '1');\r\n  sh.appendChild(cam);\r\n}\r\n\r\n/* ---------------- rack de efectos ---------------- */\r\nconst MODS = ['none', 'lfo1', 'lfo2', 'bass', 'mid', 'high', 'beat', 'x', 'y'];\r\nfunction addEffect(id) {\r\n  const def = FXDEFS.find(d => d.id === id);\r\n  if (!def) return;\r\n  state.effects.push({\r\n    id, uid: fxUid++, enabled: true,\r\n    params: def.p.map(() => ({ value: .3, mod: 'none', amt: .5 })),\r\n  });\r\n  buildFx(); markDirty();\r\n}\r\nfunction buildFx() {\r\n  const list = $('#fxList');\r\n  list.innerHTML = '';\r\n  for (const fx of state.effects) {\r\n    const def = FXDEFS.find(d => d.id === fx.id);\r\n    const d = el('div', 'fx');\r\n    const bar = el('div', 'fxbar');\r\n    const on = el('button', 'mini' + (fx.enabled ? ' on' : ''));\r\n    on.textContent = fx.enabled ? 'ON' : 'off';\r\n    on.dataset.map = `fx:${fx.uid}:on`;\r\n    on.onclick = () => { fx.enabled = !fx.enabled; buildFx(); markDirty(); };\r\n    const nm = el('span', 'fxname'); nm.textContent = def.name;\r\n    const up = el('button', 'mini'); up.textContent = '↑';\r\n    up.onclick = () => { const i = state.effects.indexOf(fx); if (i > 0) { state.effects.splice(i, 1); state.effects.splice(i - 1, 0, fx); buildFx(); markDirty(); } };\r\n    const del = el('button', 'mini'); del.textContent = '✕';\r\n    del.onclick = () => { state.effects = state.effects.filter(f => f !== fx); buildFx(); markDirty(); };\r\n    bar.append(on, nm, up, del);\r\n    d.appendChild(bar);\r\n    fx.params.forEach((pp, pi) => {\r\n      const r = el('div', 'prow');\r\n      const pn = el('span', 'pn'); pn.textContent = def.p[pi];\r\n      const sl = el('input'); sl.type = 'range'; sl.min = 0; sl.max = 1; sl.step = .01; sl.value = pp.value;\r\n      sl.dataset.map = `fx:${fx.uid}:p${pi + 1}`;\r\n      sl.oninput = () => { pp.value = +sl.value; markDirty(); };\r\n      midiRefs[`fx:${fx.uid}:p${pi + 1}`] = sl;\r\n      const md = el('select');\r\n      MODS.forEach(m => { const o = el('option'); o.value = m; o.textContent = m; md.appendChild(o); });\r\n      md.value = pp.mod;\r\n      md.onchange = () => { pp.mod = md.value; markDirty(); };\r\n      const amt = el('input'); amt.type = 'range'; amt.min = -1; amt.max = 1; amt.step = .01; amt.value = pp.amt;\r\n      amt.title = 'cantidad de modulación';\r\n      amt.oninput = () => { pp.amt = +amt.value; markDirty(); };\r\n      r.append(pn, sl, md, amt);\r\n      d.appendChild(r);\r\n    });\r\n    list.appendChild(d);\r\n  }\r\n}\r\nFXDEFS.forEach(d => { const o = el('option'); o.value = d.id; o.textContent = d.name; $('#fxAdd').appendChild(o); });\r\n$('#fxAdd').onchange = e => { if (e.target.value) addEffect(e.target.value); e.target.value = ''; };\r\n/* presets del rack de efectos */\r\nfunction rebuildFxPre() {\r\n  const sel = $('#fxPre');\r\n  sel.innerHTML = '<option value=\"\">presets…</option>';\r\n  for (const nm of Object.keys(state.fxPresets)) {\r\n    const o = el('option'); o.value = nm; o.textContent = nm; sel.appendChild(o);\r\n    const o2 = el('option'); o2.value = '✕' + nm; o2.textContent = '  ✕ borrar ' + nm; sel.appendChild(o2);\r\n  }\r\n}\r\n$('#fxSave').onclick = () => {\r\n  if (!state.effects.length) { toast('El rack está vacío'); return; }\r\n  const nm = prompt('Nombre del preset de efectos:', 'psy 1');\r\n  if (!nm) return;\r\n  state.fxPresets[nm] = JSON.parse(JSON.stringify(state.effects));\r\n  rebuildFxPre(); markDirty();\r\n  toast('Preset \"' + nm + '\" guardado 💾');\r\n};\r\n$('#fxPre').onchange = e => {\r\n  const v = e.target.value;\r\n  e.target.value = '';\r\n  if (!v) return;\r\n  if (v[0] === '✕') {\r\n    delete state.fxPresets[v.slice(1)];\r\n    rebuildFxPre(); markDirty();\r\n    toast('Preset borrado');\r\n    return;\r\n  }\r\n  state.effects = JSON.parse(JSON.stringify(state.fxPresets[v] || []));\r\n  state.effects.forEach(f => f.uid = fxUid++);\r\n  buildFx(); markDirty();\r\n  toast('Preset \"' + v + '\" cargado');\r\n};\r\nfor (const i of [0, 1]) {\r\n  $('#lfo' + i + 'w').onchange = e => { state.lfo[i].wave = e.target.value; markDirty(); };\r\n  $('#lfo' + i + 'r').onchange = e => { state.lfo[i].rate = +e.target.value; markDirty(); };\r\n}\r\n\r\n/* ---------------- XY pad ---------------- */\r\nconst xypad = $('#xypad');\r\nfunction setXY(x, y) {\r\n  state.xy.x = clamp01(x); state.xy.y = clamp01(y);\r\n  $('#xydot').style.left = (state.xy.x * 100) + '%';\r\n  $('#xydot').style.top = ((1 - state.xy.y) * 100) + '%';\r\n}\r\nxypad.addEventListener('pointerdown', e => {\r\n  xypad.setPointerCapture(e.pointerId);\r\n  const mv = ev => {\r\n    const r = xypad.getBoundingClientRect();\r\n    setXY((ev.clientX - r.left) / r.width, 1 - (ev.clientY - r.top) / r.height);\r\n  };\r\n  mv(e);\r\n  xypad.onpointermove = mv;\r\n  xypad.onpointerup = () => { xypad.onpointermove = null; };\r\n});\r\n\r\n/* ---------------- MIDI ---------------- */\r\nconst midiRefs = {};\r\nlet midiLearn = false, midiPending = null, midiOk = false;\r\nfunction midiInit() {\r\n  if (!navigator.requestMIDIAccess) { $('#midiSt').textContent = 'no soportado'; return; }\r\n  $('#midiSt').textContent = 'pidiendo permiso…';\r\n  navigator.requestMIDIAccess().then(acc => {\r\n    midiOk = true;\r\n    const bind = () => {\r\n      let names = [];\r\n      for (const inp of acc.inputs.values()) { inp.onmidimessage = onMIDI; names.push(inp.name); }\r\n      $('#midiSt').textContent = names.length ? names.join(', ').slice(0, 28) : 'sin dispositivo';\r\n    };\r\n    bind(); acc.onstatechange = bind;\r\n  }).catch(() => {\r\n    midiOk = false;\r\n    $('#midiSt').textContent = 'denegado — click 🎹 para reintentar';\r\n  });\r\n}\r\nfunction onMIDI(e) {\r\n  const [st, d1, d2] = e.data;\r\n  const type = st & 0xf0, ch = st & 0x0f;\r\n  let kind = null, on = 0, val = 0;\r\n  if (type === 0x90 && d2 > 0) { kind = 'note'; on = 1; val = d2 / 127; }\r\n  else if (type === 0x80 || (type === 0x90 && d2 === 0)) { kind = 'note'; on = 0; }\r\n  else if (type === 0xb0) { kind = 'cc'; val = d2 / 127; on = d2 > 63 ? 1 : 0; }\r\n  else return;\r\n  const key = `${kind}:${ch}:${d1}`;\r\n  if (midiLearn && midiPending) {\r\n    if (kind === 'note' && !on) return;\r\n    state.mappings[key] = midiPending.dataset.map;\r\n    midiPending.classList.remove('mappend');\r\n    toast(`MIDI ${kind} ${d1} → ${midiPending.dataset.map}`);\r\n    midiPending = null; markDirty();\r\n    return;\r\n  }\r\n  if (midiWiz) { midiWizFeed(kind, ch, d1, on); return; }\r\n  const mapped = state.mappings[key];\r\n  const desc = mapped ? mapTargetName(mapped)\r\n    : kind === 'note' ? nanoDescribe(d1)\r\n    : d1 === 1 ? 'Pad X' : d1 === 2 ? 'Pad Y' : '';\r\n  midiMonitor(kind, d1, kind === 'note' ? (on ? d2 : 0) : d2, desc);\r\n  telemetry.midiCount++;\r\n  telemetry.midiLog.unshift(`${kind === 'note' ? '♪' : 'CC'}${String(d1).padStart(3)} ` +\r\n    `${kind === 'note' ? (on ? 'on ' : 'off') : String(d2).padStart(3)} ch${ch + 1}` +\r\n    (desc ? ' → ' + desc : ''));\r\n  if (telemetry.midiLog.length > 8) telemetry.midiLog.pop();\r\n  const target = mapped;\r\n  if (target) { applyTarget(target, val, kind, on); return; }\r\n  // defaults de fábrica del nanoPAD2: XY = CC1/CC2, pads = notas 36-99\r\n  if (!state.nanoDefaults) return;\r\n  if (kind === 'cc' && d1 === 1) { setXY(val, state.xy.y); return; }\r\n  if (kind === 'cc' && d1 === 2) { setXY(state.xy.x, val); return; }\r\n  if (kind === 'note') nanoDefault(d1, on);\r\n}\r\n/* Layout de fábrica del nanoPAD2: cada escena manda 16 notas intercaladas\r\n   (fila de abajo = pares, fila de arriba = impares). Escena 1: 36-51,\r\n   escenas 2-4: 52-67, 68-83, 84-99.\r\n   ESC1: abajo→CAPA1 col 1-8, arriba→CAPA2 · ESC2: CAPA3/CAPA4\r\n   ESC3: columnas 1-8 (abajo) y 9-16 (arriba) · ESC4: macros + efectos */\r\nfunction padHit(l, c) {\r\n  const cell = state.grid[l] && state.grid[l][c];\r\n  if (!cell || cell.kind === 'empty' || (cell.kind === 'video' && !cell.video) ||\r\n      (cell.kind === 'gif' && !cell.gframes)) {\r\n    const d = cellEl(l, c);\r\n    if (d) { d.classList.add('padmiss'); setTimeout(() => d.classList.remove('padmiss'), 350); }\r\n    if (performance.now() - (padHit._t || 0) > 2500) {\r\n      padHit._t = performance.now();\r\n      toast(`Ese pad apunta a una celda vacía (CAPA ${l + 1}, col ${c + 1}) — cargale un clip`);\r\n    }\r\n    return;\r\n  }\r\n  triggerCell(l, c);\r\n}\r\nfunction nanoDefault(note, on) {\r\n  if (note < 36 || note > 99) return;\r\n  const idx = note - 36, block = Math.floor(idx / 16), i = idx % 16;\r\n  const col = Math.floor(i / 2), top = i % 2 === 1;\r\n  if (block === 0) { if (on) padHit(top ? 1 : 0, col); }\r\n  else if (block === 1) { if (on) padHit(top ? 3 : 2, col); }\r\n  else if (block === 2) { const c = col + (top ? 8 : 0); if (on && c < COLS) triggerColumn(c); }\r\n  else {\r\n    if (top) { const fx = state.effects[col]; if (on && fx) { fx.enabled = !fx.enabled; buildFx(); } }\r\n    else if (col === 0) { if (on) toggleBlackout(); }\r\n    else if (col === 1) { state.flash = on ? 1 : 0; }\r\n    else if (col === 2) { if (on) tap(); }\r\n    else if (col === 3) { if (on) cycleAuto(); }\r\n    else if (on) clearLayer(col - 4);\r\n  }\r\n}\r\nfunction cycleAuto() {\r\n  const modes = ['off', 'seq', 'rand', 'chaos'];\r\n  state.auto.mode = modes[(modes.indexOf(state.auto.mode) + 1) % modes.length];\r\n  state.auto.count = 0;\r\n  $('#autoMode').value = state.auto.mode;\r\n  toast('Autopilot: ' + state.auto.mode.toUpperCase());\r\n}\r\nfunction midiMonitor(kind, num, val, desc) {\r\n  const m = $('#midiMon');\r\n  if (m) m.textContent = (kind === 'note' ? '♪' + num : 'CC' + num) + ':' + val +\r\n    (desc ? ' ' + desc : '');\r\n}\r\n/* qué hace cada nota del nanoPAD2 con el mapeo de fábrica */\r\nfunction nanoDescribe(note) {\r\n  if (note < 36 || note > 99) return '';\r\n  const idx = note - 36, block = Math.floor(idx / 16), i = idx % 16;\r\n  const col = Math.floor(i / 2) + 1, top = i % 2 === 1;\r\n  if (block === 0) return (top ? 'C2' : 'C1') + '·c' + col;\r\n  if (block === 1) return (top ? 'C4' : 'C3') + '·c' + col;\r\n  if (block === 2) return 'columna ' + (col + (top ? 8 : 0));\r\n  return top ? 'FX ' + col : ['blackout', 'flash', 'tap', 'autopilot', '✕C1', '✕C2', '✕C3', '✕C4'][col - 1];\r\n}\r\n/* ---------------- asistente de mapeo: sirve para CUALQUIER controlador ---------------- */\r\nlet midiWiz = null;\r\nfunction wizardSteps() {\r\n  const s = [];\r\n  for (let l = 0; l < 4; l++) for (let c = 0; c < 8; c++)\r\n    s.push({ id: `cell:${l}:${c}`, lbl: `pad para CAPA ${l + 1} · clip ${c + 1}`, sec: 'PADS — CAPA ' + (l + 1) });\r\n  for (let c = 0; c < 8; c++) s.push({ id: 'col:' + c, lbl: 'botón para COLUMNA ' + (c + 1), sec: 'COLUMNAS' });\r\n  for (let i = 0; i < 8; i++) s.push({ id: 'scene:' + i, lbl: 'botón para ESCENA ' + (i + 1), sec: 'ESCENAS' });\r\n  [['lop:0', 'fader OPACIDAD CAPA 1'], ['lop:1', 'fader OPACIDAD CAPA 2'], ['lop:2', 'fader OPACIDAD CAPA 3'],\r\n    ['lop:3', 'fader OPACIDAD CAPA 4'], ['master', 'fader MASTER'], ['xfade', 'fader CROSSFADER A⇄B'],\r\n    ['fade', 'perilla del tiempo de FADE'], ['gspeed', 'perilla VELOCIDAD global'],\r\n    ['x', 'perilla / eje X'], ['y', 'perilla / eje Y']]\r\n    .forEach(([id, lbl]) => s.push({ id, lbl, sec: 'FADERS Y PERILLAS' }));\r\n  [['flash', 'FLASH'], ['build', 'BUILD'], ['blackout', 'BLACKOUT'], ['tap', 'TAP'], ['dice', '🎲 FX'],\r\n    ['resync', '↻ RESYNC'], ['mono', 'modo 1×'], ['panic', '🚨 PÁNICO']]\r\n    .forEach(([id, lbl]) => s.push({ id, lbl, sec: 'MACROS' }));\r\n  return s;\r\n}\r\nfunction startMidiWizard() {\r\n  if (!midiOk) { toast('Conectá un controlador MIDI primero (botón 🎹)'); return; }\r\n  midiWiz = { steps: wizardSteps(), i: 0, done: 0, lastKey: '', lastT: 0 };\r\n  drawWiz();\r\n}\r\nfunction midiWizFeed(kind, ch, d1, on) {\r\n  if (kind === 'note' && !on) return;\r\n  const key = `${kind}:${ch}:${d1}`;\r\n  const now = performance.now();\r\n  if (key === midiWiz.lastKey) { midiWiz.lastT = now; return; } // el mismo fader sigue mandando su stream\r\n  if (now - midiWiz.lastT < 400) return; // respiro entre pasos\r\n  state.mappings[key] = midiWiz.steps[midiWiz.i].id;\r\n  midiWiz.lastKey = key; midiWiz.lastT = now; midiWiz.done++;\r\n  markDirty();\r\n  wizAdvance(1);\r\n}\r\nfunction wizAdvance(n) {\r\n  midiWiz.i += n;\r\n  if (midiWiz.i >= midiWiz.steps.length) endMidiWizard(); else drawWiz();\r\n}\r\nfunction wizSkipSection() {\r\n  const sec = midiWiz.steps[midiWiz.i].sec;\r\n  while (midiWiz.i < midiWiz.steps.length && midiWiz.steps[midiWiz.i].sec === sec) midiWiz.i++;\r\n  if (midiWiz.i >= midiWiz.steps.length) endMidiWizard(); else drawWiz();\r\n}\r\nfunction endMidiWizard() {\r\n  const n = midiWiz ? midiWiz.done : 0;\r\n  midiWiz = null;\r\n  const w = document.getElementById('wizbox');\r\n  if (w) w.remove();\r\n  toast(n ? `🧭 Mapeo listo: ${n} controles asignados a tu controlador` : 'Asistente cerrado');\r\n  if (document.getElementById('cpmaps')) buildCpMaps();\r\n}\r\nfunction drawWiz() {\r\n  let w = document.getElementById('wizbox');\r\n  if (!w) { w = el('div', ''); w.id = 'wizbox'; document.body.appendChild(w); }\r\n  const st = midiWiz.steps[midiWiz.i];\r\n  w.innerHTML = `\r\n    <h4>🧭 ASISTENTE DE MAPEO <span>${midiWiz.i + 1} / ${midiWiz.steps.length}</span></h4>\r\n    <div class=\"wsec\">${st.sec}</div>\r\n    <div class=\"wlbl\">Tocá / mové en tu controlador el<br><b>${st.lbl}</b></div>\r\n    <div class=\"wbtns\">\r\n      <button id=\"wskip\" class=\"mini\">saltar control</button>\r\n      <button id=\"wskipsec\" class=\"mini\">saltar sección ▸</button>\r\n      <button id=\"wend\" class=\"mini\">✔ terminar</button>\r\n    </div>\r\n    <div class=\"wnote\">sirve para cualquier controlador MIDI — salteá lo que el tuyo no tenga · ESC sale</div>`;\r\n  $('#wskip').onclick = () => wizAdvance(1);\r\n  $('#wskipsec').onclick = wizSkipSection;\r\n  $('#wend').onclick = endMidiWizard;\r\n}\r\n/* perfiles de fábrica de controladores comunes (editables después con learn) */\r\nconst MIDI_PROFILES = {\r\n  nanokontrol2: {\r\n    name: 'Korg nanoKONTROL2', build() {\r\n      const m = {};\r\n      ['lop:0', 'lop:1', 'lop:2', 'lop:3', 'master', 'xfade', 'fade', 'gspeed'].forEach((t, i) => m['cc:0:' + i] = t);\r\n      ['lspd:0', 'lspd:1', 'lspd:2', 'lspd:3', 'x', 'y'].forEach((t, i) => m['cc:0:' + (16 + i)] = t);\r\n      for (let i = 0; i < 8; i++) m['cc:0:' + (32 + i)] = 'col:' + i;      // fila S\r\n      for (let i = 0; i < 8; i++) m['cc:0:' + (48 + i)] = 'scene:' + i;    // fila M\r\n      ['flash', 'build', 'blackout', 'tap', 'dice', 'resync', 'mono', 'panic']\r\n        .forEach((t, i) => m['cc:0:' + (64 + i)] = t);                     // fila R\r\n      return m;\r\n    },\r\n  },\r\n  apcmini: {\r\n    name: 'Akai APC Mini', build() {\r\n      const m = {};\r\n      for (let l = 0; l < 4; l++) for (let c = 0; c < 8; c++) m['note:0:' + (56 - l * 8 + c)] = `cell:${l}:${c}`;\r\n      for (let c = 0; c < 8; c++) m['note:0:' + (24 + c)] = 'col:' + c;\r\n      for (let i = 0; i < 8; i++) m['note:0:' + (16 + i)] = 'scene:' + i;\r\n      ['flash', 'build', 'blackout', 'tap', 'dice', 'resync', 'mono', 'panic']\r\n        .forEach((t, i) => m['note:0:' + (8 + i)] = t);\r\n      for (let i = 0; i < 4; i++) m['note:0:' + i] = 'deck:' + i;\r\n      for (let i = 0; i < 4; i++) m['note:0:' + (4 + i)] = 'lclear:' + i;\r\n      ['lop:0', 'lop:1', 'lop:2', 'lop:3', 'master', 'xfade', 'fade', 'gspeed', 'x']\r\n        .forEach((t, i) => m['cc:0:' + (48 + i)] = t);\r\n      for (let i = 0; i < 8; i++) m['note:0:' + (82 + i)] = 'scene:' + i;  // botones laterales\r\n      return m;\r\n    },\r\n  },\r\n  launchpad: {\r\n    name: 'Novation Launchpad Mini/MK1', build() {\r\n      const m = {};\r\n      for (let l = 0; l < 4; l++) for (let c = 0; c < 8; c++) m['note:0:' + (l * 16 + c)] = `cell:${l}:${c}`;\r\n      for (let c = 0; c < 8; c++) m['note:0:' + (64 + c)] = 'col:' + c;\r\n      for (let i = 0; i < 8; i++) m['note:0:' + (80 + i)] = 'scene:' + i;\r\n      ['flash', 'build', 'blackout', 'tap', 'dice', 'resync', 'mono', 'panic']\r\n        .forEach((t, i) => m['note:0:' + (96 + i)] = t);\r\n      for (let i = 0; i < 4; i++) m['note:0:' + (112 + i)] = 'deck:' + i;\r\n      for (let i = 0; i < 4; i++) m['note:0:' + (116 + i)] = 'lclear:' + i;\r\n      [8, 24, 40, 56, 72, 88, 104, 120].forEach((n, i) => m['note:0:' + n] =\r\n        ['flash', 'build', 'blackout', 'tap', 'dice', 'resync', 'mono', 'panic'][i]); // columna derecha\r\n      return m;\r\n    },\r\n  },\r\n};\r\nfunction loadMidiProfile(key) {\r\n  const p = MIDI_PROFILES[key];\r\n  if (!p) return;\r\n  Object.assign(state.mappings, p.build());\r\n  markDirty();\r\n  toast('🎹 Perfil ' + p.name + ' cargado — editalo en la lista o pisalo con MIDI learn');\r\n}\r\nfunction exportMidiMaps() {\r\n  const data = { app: 'ravenvj-midimap', v: 1, mappings: state.mappings, nanoDefaults: state.nanoDefaults };\r\n  const a = document.createElement('a');\r\n  a.href = URL.createObjectURL(new Blob([JSON.stringify(data, null, 1)], { type: 'application/json' }));\r\n  a.download = 'ravenvj-mapeo-midi.json';\r\n  a.click();\r\n  URL.revokeObjectURL(a.href);\r\n  toast('💾 Mapeos exportados — compartilos con quien quieras');\r\n}\r\nfunction importMidiMaps() {\r\n  const inp = document.createElement('input');\r\n  inp.type = 'file';\r\n  inp.accept = '.json,application/json';\r\n  inp.onchange = () => {\r\n    const f = inp.files[0];\r\n    if (!f) return;\r\n    f.text().then(tx => {\r\n      const d = JSON.parse(tx);\r\n      const maps = d.app === 'ravenvj-midimap' ? d.mappings : (d.mappings || d);\r\n      if (!maps || typeof maps !== 'object' || Array.isArray(maps)) throw 0;\r\n      const n = Object.keys(maps).length;\r\n      Object.assign(state.mappings, maps);\r\n      if (typeof d.nanoDefaults === 'boolean') state.nanoDefaults = d.nanoDefaults;\r\n      markDirty();\r\n      if (document.getElementById('cpmaps')) buildCpTab('midi');\r\n      toast(`📂 ${n} mapeos importados`);\r\n    }).catch(() => toast('Ese archivo no parece un mapeo MIDI de RAVEN VJ'));\r\n  };\r\n  inp.click();\r\n}\r\nfunction applyTarget(id, val, kind, on) {\r\n  const [t, a, b] = id.split(':');\r\n  switch (t) {\r\n    case 'cell': if (on) triggerCell(+a, +b); break;\r\n    case 'col': if (on) triggerColumn(+a); break;\r\n    case 'lclear': if (on) clearLayer(+a); break;\r\n    case 'lop': {\r\n      state.layers[+a].opacity = val;\r\n      if (midiRefs[id]) midiRefs[id].value = val;\r\n      break;\r\n    }\r\n    case 'master': state.master = val; $('#masterIn').value = val; break;\r\n    case 'fade': state.fade = val * 5; $('#fadeIn').value = state.fade; $('#fadeLbl').textContent = state.fade.toFixed(1) + 's'; break;\r\n    case 'tap': if (on) tap(); break;\r\n    case 'blackout': if (on) toggleBlackout(); break;\r\n    case 'flash': state.flash = kind === 'note' ? on : val; break;\r\n    case 'x': setXY(val, state.xy.y); break;\r\n    case 'y': setXY(state.xy.x, val); break;\r\n    case 'scene': if (on) recallScene(+a); break;\r\n    case 'dice': if (on) randomizeFx(); break;\r\n    case 'sync': if (on) syncBpm(); break;\r\n    case 'resync': if (on) resync(); break;\r\n    case 'deck': if (on) switchDeck(+a); break;\r\n    case 'panic': if (on) panic(); break;\r\n    case 'mono': if (on) monoToggle(); break;\r\n    case 'build': if (kind === 'note') { on ? buildStart() : buildDrop(); } else { val > .5 ? buildStart() : buildDrop(); } break;\r\n    case 'xfade': state.xfade = val; $('#xfadeIn').value = val; break;\r\n    case 'gspeed': state.gSpeed = val * 2; applyAllSpeeds(); break;\r\n    case 'lspd': {\r\n      const L = state.layers[+a];\r\n      L.speed = val * 3;\r\n      applySpeed(L);\r\n      if (midiRefs[id]) midiRefs[id].value = L.speed;\r\n      break;\r\n    }\r\n    case 'lfx': {\r\n      const L = state.layers[+a];\r\n      if (b === 'p1') L.fx.p1 = val; else L.fx.p2 = val;\r\n      if (midiRefs[id]) midiRefs[id].value = val;\r\n      break;\r\n    }\r\n    case 'lsolo': if (on) {\r\n      const L = state.layers[+a]; L.solo = !L.solo;\r\n      if (midiRefs[id]) midiRefs[id].classList.toggle('on', L.solo);\r\n    } break;\r\n    case 'lbyp': if (on) {\r\n      const L = state.layers[+a]; L.byp = !L.byp;\r\n      if (midiRefs[id]) midiRefs[id].className = 'mini' + (L.byp ? ' danger on' : '');\r\n    } break;\r\n    case 'fx': {\r\n      const fx = state.effects.find(f => f.uid === +a);\r\n      if (!fx) break;\r\n      if (b === 'on') { if (on) { fx.enabled = !fx.enabled; buildFx(); } }\r\n      else {\r\n        const pi = b === 'p1' ? 0 : 1;\r\n        fx.params[pi].value = val;\r\n        if (midiRefs[id]) midiRefs[id].value = val;\r\n      }\r\n      break;\r\n    }\r\n  }\r\n}\r\n$('#midiBtn').onclick = () => {\r\n  if (!midiOk) { midiInit(); toast('Reintentando conexión MIDI — aceptá el permiso si aparece'); return; }\r\n  midiLearn = !midiLearn;\r\n  $('#midiBtn').classList.toggle('learn', midiLearn);\r\n  document.body.classList.toggle('midilearn', midiLearn);\r\n  document.querySelectorAll('[data-map]').forEach(e => e.classList.toggle('maplearn', midiLearn));\r\n  if (!midiLearn && midiPending) { midiPending.classList.remove('mappend'); midiPending = null; }\r\n  toast(midiLearn ? 'MIDI LEARN: tocá un control de la UI y mové el pad' : 'MIDI learn apagado');\r\n};\r\ndocument.addEventListener('pointerdown', e => {\r\n  if (!midiLearn) return;\r\n  const t = e.target.closest('[data-map]');\r\n  if (!t) return;\r\n  e.preventDefault(); e.stopPropagation();\r\n  if (midiPending) midiPending.classList.remove('mappend');\r\n  midiPending = t; t.classList.add('mappend');\r\n}, true);\r\ndocument.addEventListener('click', e => {\r\n  if (midiLearn && e.target.closest('[data-map]')) { e.preventDefault(); e.stopPropagation(); }\r\n}, true);\r\n\r\n/* ---------------- output window ---------------- */\r\n/*