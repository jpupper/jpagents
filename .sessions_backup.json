);\r\n  if (cd) {\r\n    const l = +cd.dataset.l, c = +cd.dataset.c, cell = state.grid[l][c];\r\n    const items = [];\r\n    if (cell.kind !== 'empty') {\r\n      items.push({ label: '▶ Disparar', fn: () => triggerCell(l, c) });\r\n      items.push({ label: '⚙ Propiedades del clip…', fn: () => openProps('clip', cell, l) });\r\n      items.push({ label: '👁 Ver en previa', fn: () => setPreview(cell) });\r\n      if (cell.kind === 'gen') {\r\n        items.push({ label: '🎛 Parámetros rápidos…', fn: () => genParamPopup(cell, e.clientX, e.clientY) });\r\n      }\r\n      items.push('-');\r\n    }\r\n    items.push({ label: '🎬 Cargar video acá…', fn: () => pickVideoFor(cell) });\r\n    items.push({ label: '📷 Cámara / capturadora…', fn: () => camPicker(cell, e.clientX, e.clientY) });\r\n    items.push({\r\n      label: cell.kind === 'text' ? '✏ Editar texto…' : '💬 Poner texto…',\r\n      fn: () => { const s = prompt('Texto a mostrar:', cell.kind === 'text' ? cell.name : 'RAVEN'); if (s) assignText(cell, s); }\r\n    });\r\n    if (cell.kind === 'video' && cell.video) {\r\n      items.push({\r\n        label: '⏱ Recorte in/out…',\r\n        fn: () => {\r\n          const cur = (cell.inT || 0) + (cell.outT ? ',' + cell.outT : '');\r\n          const s = prompt('Inicio y fin en segundos (ej: 3,12 — vacío = clip completo):', cur);\r\n          if (s === null) return;\r\n          const mm = s.split(',').map(parseFloat);\r\n          cell.inT = isFinite(mm[0]) && mm[0] > 0 ? mm[0] : 0;\r\n          cell.outT = isFinite(mm[1]) && mm[1] > cell.inT ? mm[1] : 0;\r\n          markDirty();\r\n          toast(cell.outT ? `Loop ${cell.inT}s → ${cell.outT}s` :\r\n            cell.inT ? `Arranca en ${cell.inT}s` : 'Clip completo');\r\n        }\r\n      });\r\n    }\r\n    if (cell.kind === 'text') {\r\n      items.push({\r\n        label: '🎞 Animación: ' + (cell.textStyle || 'pulso') + ' → cambiar',\r\n        fn: () => {\r\n          cell.textStyle = TEXT_STYLES[(TEXT_STYLES.indexOf(cell.textStyle || 'pulso') + 1) % TEXT_STYLES.length];\r\n          markDirty();\r\n          toast('Animación de texto: ' + cell.textStyle.toUpperCase());\r\n        }\r\n      });\r\n    }\r\n    if (cell.kind !== 'empty') {\r\n      items.push('-');\r\n      items.push({\r\n        label: '⧉ Duplicar a la derecha',\r\n        fn: () => {\r\n          let tc = -1;\r\n          for (let cc = c + 1; cc < COLS; cc++) if (state.grid[l][cc].kind === 'empty') { tc = cc; break; }\r\n          if (tc < 0) { addColumns(1); tc = COLS - 1; }\r\n          const dst = state.grid[l][tc];\r\n          if (cell.kind === 'video' && cell.file) assignVideo(dst, cell.file);\r\n          else if (cell.kind === 'gif' && cell.file) assignGif(dst, cell.file);\r\n          else {\r\n            emptyCell(dst);\r\n            Object.assign(dst, {\r\n              kind: cell.kind, name: cell.name, presetIdx: cell.presetIdx,\r\n              textStyle: cell.textStyle, camId: cell.camId,\r\n              gframes: cell.gframes, gtotal: cell.gtotal, thumb: cell.thumb,\r\n            });\r\n            if (cell.kind === 'cam') startCam(dst);\r\n          }\r\n          dst.gp = cell.gp ? { ...cell.gp } : undefined;\r\n          dst.tr = cell.tr ? { ...cell.tr } : undefined;\r\n          dst.anim = cell.anim ? JSON.parse(JSON.stringify(cell.anim)) : undefined;\r\n          dst.spd = cell.spd; dst.inT = cell.inT || 0; dst.outT = cell.outT || 0;\r\n          refreshCell(l, tc); markDirty();\r\n          toast('Clip duplicado en la columna ' + (tc + 1));\r\n        }\r\n      });\r\n      items.push({ label: '🧹 Vaciar celda', fn: () => emptyCell(cell) });\r\n    }\r\n    showMenu(e.clientX, e.clientY, `CAPA ${l + 1} · COLUMNA ${c + 1}`, items);\r\n  } else if (sb) {\r\n    const i = +sb.dataset.scene;\r\n    const items = [{ label: '📸 Guardar estado acá', fn: () => captureScene(i) }];\r\n    if (state.scenes[i]) {\r\n      items.push({ label: '▶ Disparar escena', fn: () => recallScene(i) });\r\n     