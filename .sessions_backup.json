'INPUT' || e.target.tagName === 'SELECT') return;\r\n  if (e.altKey && !e.ctrlKey && e.key >= '1' && e.key <= '4') { // Alt+1..4 = decks A-D\r\n    e.preventDefault();\r\n    switchDeck(+e.key - 1);\r\n    return;\r\n  }\r\n  // teclas asignadas por el usuario (prioridad sobre los atajos de fábrica)\r\n  const kt = state.mappings['key:0:' + e.code];\r\n  if (kt) { if (!e.repeat) { e.preventDefault(); applyTarget(kt, 1, 'note', 1); } return; }\r\n  if (/^F[1-8]$/.test(e.key)) {\r\n    e.preventDefault();\r\n    const i = +e.key.slice(1) - 1;\r\n    if (e.shiftKey) captureScene(i); else recallScene(i);\r\n    return;\r\n  }\r\n  if (e.key >= '1' && e.key <= '9') triggerColumn(+e.key - 1);\r\n  else if (e.key === '0') triggerColumn(9);\r\n  else if (e.key === 't' || e.key === 'T') tap();\r\n  else if (e.key === 'h' || e.key === 'H') { togglePanel(true); buildCpTab('keys'); }\r\n  else if (e.key === 'p' || e.key === 'P') panic();\r\n  else if (e.key === 'b' || e.key === 'B') toggleBlackout();\r\n  else if ((e.key === 'f' || e.key === 'F') && !e.repeat) state.flash = 1;\r\n  else if (e.key === ' ' && !e.repeat) { e.preventDefault(); buildStart(); }\r\n  else if (e.key === ' ') e.preventDefault();\r\n});\r\ndocument.addEventListener('keyup', e => {\r\n  const kt = state.mappings['key:0:' + e.code];\r\n  if (kt) {\r\n    // al soltar la tecla solo reaccionan los targets momentáneos\r\n    if (kt === 'flash' || kt === 'build') applyTarget(kt, 0, 'note', 0);\r\n    return;\r\n  }\r\n  if (e.key === 'f' || e.key === 'F') state.flash = 0;\r\n  if (e.key === ' ') buildDrop();\r\n});\r\n\r\n/* ---------------- panel de control (Ctrl+Alt+T) ---------------- */\r\nlet gpuName = 'n/d';\r\ntry {\r\n  const dbg = main.gl.getExtension('WEBGL_debug_renderer_info');\r\n  if (dbg) gpuName = String(main.gl.getParameter(dbg.UNMASKED_RENDERER_WEBGL)).slice(0, 48);\r\n} catch (e) { }\r\nconst cpanel = el('div'); cpanel.id = 'cpanel';\r\ncpanel.innerHTML = '<div id=\"cpbox\"><div id=\"cptabs\"></div><div id=\"cpbody\"></div></div>';\r\ndocument.body.appendChild(cpanel);\r\ncpanel.addEventListener('pointerdown', e => { if (e.target === cpanel) togglePanel(false); });\r\nconst CPTABS = [\r\n  { id: 'tele', label: '📊 Telemetría' }, { id: 'render', label: '⚙ Render' },\r\n  { id: 'midi', label: '🎹 MIDI' }, { id: 'audio', label: '🔊 Audio' },\r\n  { id: 'setl', label: '📋 Setlist' }, { id: 'remote', label: '📱 Remoto' },\r\n  { id: 'ses', label: '💾 Sesión' }, { id: 'keys', label: '⌨ Atajos' },\r\n];\r\nlet cpTab = 'tele', cpTimer = 0;\r\nfor (const td of CPTABS) {\r\n  const bt = el('button'); bt.dataset.tab = td.id; bt.textContent = td.label;\r\n  bt.onclick = () => buildCpTab(td.id);\r\n  $('#cptabs').appendChild(bt);\r\n}\r\nconst cpCls = el('button', 'cpclose'); cpCls.textContent = '✕';\r\ncpCls.onclick = () => togglePanel(false);\r\n$('#cptabs').appendChild(cpCls);\r\n\r\nfunction togglePanel(open) {\r\n  const o = open === undefined ? !cpanel.classList.contains('open') : open;\r\n  cpanel.classList.toggle('open', o);\r\n  clearInterval(cpTimer);\r\n  if (o) { buildCpTab(cpTab); cpTimer = setInterval(cpTick, 400); cpTick(); }\r\n}\r\nfunction cpRow(label, tv, val) {\r\n  return `<div class=\"cprow\"><b>${label}</b><span class=\"v\"${tv ? ` data-tv=\"${tv}\"` : ''}>${val || '–'}</span></div>`;\r\n}\r\nfunction buildCpTab(id) {\r\n  cpTab = id;\r\n  document.querySelectorAll('#cptabs button[data-tab]').forEach(bt => bt.classList.toggle('on', bt.dataset.tab === id));\r\n  const b = $('#cpbody');\r\n  if (id === 'tele') {\r\n    b.innerHTML = `<canvas id=\"cpfps\" width=\"710\" height=\"64\"></canvas>\r\n      <div class=\"cph\">RENDIMIENTO</div><div class=\"cpgrid\">\r\n      ${cpRow('FPS', 'fps')}${cpRow('Frame prom / máx', 'ft')}\r\n      ${cpRow('Frames lentos (&gt;50ms)', 'drop')}${cpRow('Resolución de render', 'res')}\r\n      ${cpRow('Memoria JS', 'mem')}${cpRow('Uptime de la sesión', 'up')}</div>\r\n      <div class=\"cph\">MOTOR</div><div class=\"cpgrid\">\r\n      ${cpRow('GPU', '', gpuName)}${cpRow('Capas activas', 'lay')}\r\n      ${cpRow('Videos reproduciéndose', 'vid')}${cpRow('Efectos activos', 'fx')}\r\n      ${cpRow('Clips en la grilla', 'clips')}${cpRow('Escenas guardadas', 'scn')}</div>\r\n      <div class=\"cph\">AUDIO / MIDI</div><div class=\"cpgrid\">\r\n      ${cpRow('BPM', 'bpm')}${cpRow('Beats detectados', 'beats')}\r\n      ${cpRow('Niveles B / M / H', 'lvl')}${cpRow('Dispositivo MIDI', 'mdev')}\r\n      ${cpRow('Mensajes MIDI', 'mcount')}${cpRow('Último MIDI', 'mlast')}</div>`;\r\n  } else if (id === 'render') {\r\n    b.innerHTML = `<div class=\"cph\">APARIENCIA</div>\r\n      <div class=\"cprow\"><b>Idioma</b><span><select id=\"cplang\">\r\n        ${Object.entries(LANGS).map(([k, nm]) =>\r\n          `<option value=\"${k}\"${curLang() === k ? ' selected' : ''}>${nm}</option>`).join('')}\r\n      </select></span></div>\r\n      <div class=\"cprow\"><b>Tema de colores</b><span><select id=\"cptheme\">\r\n        ${Object.entries(THEMES).map(([k, t]) =>\r\n          `<option value=\"${k}\"${state.theme === k ? ' selected' : ''}>${t.label}</option>`).join('')}\r\n      </select></span></div>\r\n      <div class=\"cph\">RENDER</div>\r\n      <div class=\"cprow\"><b>Resolución</b><span><select id=\"cpres\">${resOptionsHTML(state.res)}</select></span></div>\r\n      <div class=\"cprow\"><b>Límite de FPS</b><span><select id=\"cpfpscap\">\r\n        <option value=\"0\">60 (sin límite)</option><option value=\"30\">30 (ahorro / PC lenta)</option></select></span></div>\r\n      <div class=\"cprow\"><b>PC floja de papeles 🐢</b><span>\r\n        <button id=\"cplite\" class=\"mini${state.res[0] === 960 && state.res[1] === 540 && state.fpsCap === 30 ? ' on' : ''}\">${state.res[0] === 960 && state.res[1] === 540 && state.fpsCap === 30 ? 'modo liviano ON' : 'activar modo liviano'}</button></span></div>\r\n      <div class=\"cprow\"><b>Motor gráfico</b><span><button id=\"cpglreset\" class=\"mini\">↻ Reiniciar (si se ve raro)</button></span></div>\r\n      <div class=\"cph\">MONITOR DE SALIDA</div>\r\n      <div class=\"cprow\"><b>Pantallas conectadas</b><span>\r\n        <button id=\"cpscr\" class=\"mini\">🔍 detectar</button></span></div>\r\n      <div id=\"cpscrlist\"></div>\r\n      <div class=\"cph\">MAPPING (multi-superficie)</div>\r\n      <div class=\"cprow\"><b>Mapping</b><span style=\"display:flex;gap:6px\">\r\n        <button id=\"cpwarp\" class=\"mini${state.map.on ? ' on' : ''}\">${state.map.on ? 'ON' : 'off'}</button>\r\n        <button id=\"cpmapedit\" class=\"mini\">🗺 abrir editor</button>\r\n        <button id=\"cpout2\" class=\"mini\">＋ ventana de salida</button></span></div>\r\n      <div id=\"cpsurfs\"></div>\r\n      <div class=\"cprow\"><span class=\"v\">El editor flotante 🗺 muestra la salida en grande: ahí agregás\r\n        superficies, las movés y les arrastrás las esquinas con la vista en vivo.</span></div>\r\n      <div class=\"cph\">INFO</div>\r\n      ${cpRow('GPU', '', gpuName)}\r\n      ${cpRow('Contexto', '', 'WebGL2 · 8 texturas de capa · ping-pong FX')}`;\r\n    $('#cplang').onchange = e => { setLang(e.target.value); toast('Idioma: ' + LANGS[curLang()]); };\r\n    $('#cptheme').onchange = e => {\r\n      applyTheme(e.target.value);\r\n      markDirty();\r\n      toast('Tema: ' + THEMES[state.theme].label);\r\n    };\r\n    $('#cpres').onchange = e => onResSelChange(e.target.value);\r\n    $('#cpfpscap').value = state.fpsCap || 0;\r\n    $('#cpfpscap').onchange = e => { state.fpsCap = +e.target.value; markDirty(); };\r\n    $('#cplite').onclick = () => {\r\n      const lite = !(state.res[0] === 960 && state.res[1] === 540 && state.fpsCap === 30);\r\n      if (lite) { // recordar la resolución del usuario para restaurarla al salir\r\n        window._preLite = state.res.slice();\r\n        setRes(960, 540); state.fpsCap = 30;\r\n      } else {\r\n        const p = window._preLite || [1280, 720];\r\n        setRes(p[0], p[1]); state.fpsCap = 0;\r\n      }\r\n      markDirty(); buildCpTab('render');\r\n      toast(lite ? '🐢 Modo liviano: 960×540 @ 30fps — ideal PC floja' : '🚀 Modo completo: ' + state.res.join('×') + ' @ 60fps');\r\n    };\r\n    $('#cpglreset').onclick = () => {\r\n      const ext = main.gl.getExtension('WEBGL_lose_context');\r\n      if (ext) { ext.loseContext(); setTimeout(() => ext.restoreContext(), 150); }\r\n    };\r\n    $('#cpwarp').onclick = () => { mapToggle(); buildCpTab('render'); };\r\n    $('#cpmapedit').onclick = () => toggleMapWin(true);\r\n    $('#cpout2').onclick = () => openOutput('ravenvj_out' + Math.floor(Math.random() * 1e4));\r\n    buildSurfList();\r\n    $('#cpscr').onclick = async () => { await detectScreens(); buildScrList(); };\r\n    buildScrList();\r\n  } else if (id === 'midi') {\r\n    b.innerHTML = `<div class=\"cph\">ESTADO</div>\r\n      ${cpRow('Dispositivo', 'mdev')}${cpRow('Mensajes recibidos', 'mcount')}\r\n      <div class=\"cprow\"><b>Conexión</b><span><button id=\"cpmidiretry\" class=\"mini\">↻ Reintentar</button></span></div>\r\n      <div class=\"cph\">MONITOR EN VIVO (últimos 8)</div>\r\n      <div id=\"cpmidilog\" style=\"font-family:Consolas,monospace;font-size:11px;color:var(--acc);\r\n        padding:7px 10px;background:#0a0a0d;border-radius:6px;min-height:76px;white-space:pre\">(sin actividad)</div>\r\n      <div class=\"cph\">CUALQUIER CONTROLADOR</div>\r\n      <div class=\"cprow\"><b>Asistente de mapeo</b><span>\r\n        <button id=\"cpwiz\" class=\"mini\">🧭 mapear mi controlador…</button></span></div>\r\n      <div class=\"cprow\"><b>Perfiles de fábrica</b><span>\r\n        <select id=\"cpprof\"><option value=\"\">elegir controlador…</option>${Object.entries(MIDI_PROFILES).map(([k, p]) =>\r\n          `<option value=\"${k}\">${p.name}</option>`).join('')}</select></span></div>\r\n      <div class=\"cprow\"><b>Compartir mapeos</b><span style=\"display:flex;gap:6px\">\r\n        <button id=\"cpmexp\" class=\"mini\">💾 exportar</button>\r\n        <button id=\"cpmimp\" class=\"mini\">📂 importar</button></span></div>\r\n      <div class=\"cph\">MAPEOS DE MIDI LEARN\r\n        <button id=\"cpmapsclear\" class=\"mini\" style=\"margin-left:8px\">borrar todos</button></div>\r\n      <div id=\"cpmaps\"></div>\r\n      ${nanoMapHTML()}`;\r\n    $('#cpmidiretry').onclick = midiInit;\r\n    $('#cpwiz').onclick = () => { togglePanel(false); startMidiWizard(); };\r\n    $('#cpprof').onchange = e => { if (e.target.value) { loadMidiProfile(e.target.value); buildCpTab('midi'); } };\r\n    $('#cpmexp').onclick = exportMidiMaps;\r\n    $('#cpmimp').onclick = importMidiMaps;\r\n    $('#cpmapsclear').onclick = () => { state.mappings = {}; markDirty(); buildCpMaps(); };\r\n    const nd = el('div', 'cprow');\r\n    nd.innerHTML = `<b>Mapa de fábrica nanoPAD2</b><span><button id=\"cpnanodef\" class=\"mini${state.nanoDefaults ? ' on' : ''}\">${state.nanoDefaults ? 'ON' : 'off'}</button></span>`;\r\n    $('#cpmaps').before(nd);\r\n    $('#cpnanodef').onclick = () => {\r\n      state.nanoDefaults = !state.nanoDefaults;\r\n      markDirty(); buildCpTab('midi');\r\n      toast(state.nanoDefaults ? 'Mapa de fábrica activo (lo aprendido tiene prioridad)' : 'Solo mapeos aprendidos con MIDI learn');\r\n    };\r\n    buildCpMaps();\r\n  } else if (id === 'setl') {\r\n    b.innerHTML = `<div class=\"cph\">SETLIST — encadená escenas con tiempos y dejá la noche programada</div>\r\n      <div id=\"slList\"></div>\r\n      <div class=\"cprow\"><b>Agregar paso</b><span style=\"display:flex;gap:6px;align-items:center\">\r\n        <select id=\"slScene\">${Array.from({ length: 8 }, (_, i) =>\r\n          `<option value=\"${i}\">Escena ${i + 1}${state.scenes[i] ? '' : ' (vacía)'}</option>`).join('')}</select>\r\n        <input id=\"slMin\" type=\"number\" min=\"0.1\" step=\"0.5\" value=\"10\" style=\"width:64px\"> min\r\n        <button id=\"slAdd\" class=\"mini\">＋ agregar</button></span></div>\r\n      <div class=\"cprow\"><b>Control</b><span style=\"display:flex;gap:8px;align-items:center\">\r\n        <button id=\"slStart\" class=\"mini${state.setlist.running ? ' on' : ''}\">${state.setlist.running ? '⏹ STOP' : '▶ START'}</button>\r\n        <span class=\"v\" data-tv=\"slstat\">–</span></span></div>`;\r\n    buildSlList();\r\n    $('#slAdd').onclick = () => {\r\n      state.setlist.steps.push({ scene: +$('#slScene').value, min: Math.max(.1, +$('#slMin').value || 10) });\r\n      markDirty(); buildSlList();\r\n    };\r\n    $('#slStart').onclick = () => {\r\n      const SL = state.setlist;\r\n      if (SL.running) { SL.running = false; toast('Setlist detenido'); }\r\n      else {\r\n        if (!SL.steps.length) { toast('Agregá pasos primero (y guardá escenas)'); return; }\r\n        SL.running = true; SL.idx = 0; SL.t0 = performance.now();\r\n        recallScene(SL.steps[0].scene);\r\n        toast('📋 Setlist en marcha — paso 1');\r\n      }\r\n      buildCpTab('setl');\r\n    };\r\n  } else if (id === 'remote') {\r\n    const on = remote.on;\r\n    const url = 'https://www.ravenlight.net/ravenvj/remote.html?r=' + remote.code;\r\n    b.innerHTML = `<div class=\"cph\">CONTROL REMOTO DESDE EL CELULAR</div>\r\n      <div class=\"cprow\"><b>Estado</b><span class=\"v\">${on ? 'ACTIVO — código ' + remote.code : 'inactivo'}</span></div>\r\n      <div class=\"cprow\"><b>Remoto</b><span><button id=\"cpremote\" class=\"mini${on ? ' on' : ''}\">${on ? 'desactivar' : '📱 ACTIVAR'}</button></span></div>` +\r\n      (on ? `\r\n      <div class=\"cprow\"><b>URL para el celu</b><span class=\"v\" style=\"user-select:text\">${url.replace('https://www.', '')}</span></div>\r\n      <div class=\"cprow\"><b>Conectados</b><span class=\"v\">${remote.conns.length}</span></div>\r\n      <div style=\"text-align:center;padding:12px\">\r\n        <img src=\"https://api.qrserver.com/v1/create-qr-code/?size=170x170&bgcolor=0c0c0e&color=8dff3f&data=${encodeURIComponent(url)}\"\r\n          width=\"170\" height=\"170\" style=\"border-radius:8px\" alt=\"QR\"></div>\r\n      <div class=\"cprow\"><span class=\"v\">Escaneá el QR con el celu. La conexión inicial necesita internet\r\n        (sirve el hotspot del propio celu); después el control va directo por WiFi.</span></div>`\r\n        : `<div class=\"cprow\"><span class=\"v\">Activalo: aparece un código + QR. Desde el celu manejás la grilla,\r\n        escenas, columnas, XY, master, crossfader y macros (FLASH, BUILD, BLACKOUT, PÁNICO) en tiempo real.</span></div>`);\r\n    $('#cpremote').onclick = remoteToggle;\r\n  } else if (id === 'audio') {\r\n    b.innerHTML = `<div class=\"cph\">ENTRADA</div>\r\n      <div class=\"cprow\"><b>Audio</b><span><button id=\"cpaudio\" class=\"mini${audio.on ? ' on' : ''}\">${audio.on ? 'ON — click para apagar' : 'activar 🎤'}</button></span></div>\r\n      ${cpRow('BPM', 'bpm')}${cpRow('Beats detectados', 'beats')}\r\n      <div class=\"cph\">NIVELES</div>\r\n      <div class=\"cpbarw\"><b>BASS</b><div class=\"cpbar\"><i id=\"cpbB\"></i></div></div>\r\n      <div class=\"cpbarw\"><b>MID</b><div class=\"cpbar\"><i id=\"cpbM\"></i></div></div>\r\n      <div class=\"cpbarw\"><b>HIGH</b><div class=\"cpbar\"><i id=\"cpbH\"></i></div></div>\r\n      <div class=\"cph\">DETECCIÓN DE BEAT</div>\r\n      <div class=\"cprow\"><b>Sensibilidad</b><span style=\"display:flex;gap:8px;align-items:center\">\r\n        <input id=\"cpsens\" type=\"range\" min=\"1.1\" max=\"1.8\" step=\"0.02\" style=\"width:130px\">\r\n        <span class=\"v\" data-tv=\"sens\"></span></span></div>\r\n      <div class=\"cprow\"><b>Detectar BPM del audio</b><span><button id=\"cpsync\" class=\"mini\">SYNC</button></span></div>`;\r\n    $('#cpaudio').onclick = async () => { await audioToggle(); buildCpTab('audio'); };\r\n    $('#cpsens').value = state.beatSens || 1.32;\r\n    $('#cpsens').oninput = e => { state.beatSens = +e.target.value; markDirty(); };\r\n    $('#cpsync').onclick = syncBpm;\r\n  } else if (id === 'ses') {\r\n    b.innerHTML = `<div class=\"cph\">ESTADO DEL SET</div>\r\n      ${cpRow('Clips en la grilla', 'clips')}${cpRow('Videos sin enlazar', 'unlink')}\r\n      ${cpRow('Escenas guardadas', 'scn')}${cpRow('Autosave (local)', 'asize')}\r\n      <div class=\"cph\">ACCIONES</div>\r\n      <div class=\"cprow\"><b>Set</b><span style=\"display:flex;gap:6px\">\r\n        <button id=\"cpsave\" class=\"mini\">💾 Guardar JSON</button>\r\n        <button id=\"cpload\" class=\"mini\">📂 Abrir</button>\r\n        <button id=\"cprelink\" class=\"mini\">🔗 Relink videos</button></span></div>\r\n      <div class=\"cprow\"><b>Sesión local</b><span>\r\n        <button id=\"cpwipe\" class=\"mini\">🧨 Borrar autosave y reiniciar</button></span></div>\r\n      <div class=\"cph\">CHEQUEO PRE-SHOW</div>\r\n      <div class=\"cprow\"><b>Antes de la fiesta</b><span>\r\n        <button id=\"pfrun\" class=\"mini on\">🧪 chequear todo</button></span></div>\r\n      <div id=\"pfout\"></div>`;\r\n    $('#cpsave').onclick = () => $('#saveBtn').click();\r\n    $('#cpload').onclick = () => $('#setIn').click();\r\n    $('#cprelink').onclick = () => $('#relinkIn').click();\r\n    $('#cpwipe').onclick = () => {\r\n      if (confirm('¿Borrar la sesión autoguardada y reiniciar la app?')) {\r\n        localStorage.removeItem('ravenvj_autosave');\r\n        location.reload();\r\n      }\r\n    };\r\n    $('#pfrun').onclick = runPreflight;\r\n  } else if (id === 'keys') {\r\n    const K = [['click', 'disparar celda / columna'], ['click derecho', 'menú de opciones'],\r\n    ['arrastrar MP4/WebM', 'cargar videos en la grilla'], ['1-9, 0', 'disparar columnas'],\r\n    ['F1-F8', 'disparar escena (Shift = guardar)'], ['T', 'tap tempo'], ['B', 'blackout'],\r\n    ['F (mantener)', 'flash blanco'], ['P', 'pánico'], ['Ctrl+Alt+T', 'este panel'],\r\n    ['Esc', 'cerrar panel / menú'], ['🎹 MIDI learn', 'click en un control + mover el pad'],\r\n    ['en OUTPUT: F o doble click', 'pantalla completa']];\r\n    b.innerHTML = '<div class=\"cph\">ATAJOS</div>' +\r\n      K.map(k => `<div class=\"cprow\"><b>${k[0]}</b><span class=\"v\">${k[1]}</span></div>`).join('');\r\n  }\r\n}\r\nfunction nanoMapHTML() {\r\n  const cellHtml = t => `<span style=\"flex:1;text-align:center;background:#0a0a0d;border:1px solid var(--line);\r\n    border-radius:3px;padding:3px 0;font-size:9px;color:var(--acc);white-space:nowrap;overflow:hidden\">${t}</span>`;\r\n  const row = arr => `<div style=\"display:flex;gap:2px;margin:1px 0\">${arr.map(cellHtml).join('')}</div>`;\r\n  const cols = f => Array.from({ length: 8 }, (_, i) => f(i + 1));\r\n  return `<div class=\"cph\">MAPA NANOPAD2 DE FÁBRICA — el botón SCENE del aparato cambia el banco · el pad X-Y siempre es X/Y</div>\r\n    <div class=\"cph\" style=\"margin-top:6px\">SCENE 1 · capas 1-2</div>\r\n    ${row(cols(i => 'C2·' + i))}${row(cols(i => 'C1·' + i))}\r\n    <div class=\"cph\">SCENE 2 · capas 3-4</div>\r\n    ${row(cols(i => 'C4·' + i))}${row(cols(i => 'C3·' + i))}\r\n    <div class=\"cph\">SCENE 3 · columnas completas</div>\r\n    ${row(cols(i => 'col ' + (i + 8)))}${row(cols(i => 'col ' + i))}\r\n    <div class=\"cph\">SCENE 4 · efectos y macros</div>\r\n    ${row(cols(i => 'FX ' + i))}${row(['BLKOUT', 'FLASH', 'TAP', 'AUTO', '✕C1', '✕C2', '✕C3', '✕C4'])}`;\r\n}\r\nfunction mapTargetName(t) {\r\n  const [k, a, b] = t.split(':');\r\n  const flat = {\r\n    master: 'Master', fade: 'Fade', tap: 'Tap tempo', sync: 'Sync BPM', blackout: 'Blackout',\r\n    flash: 'Flash', panic: 'Pánico', dice: 'Randomizar FX', x: 'Pad X', y: 'Pad Y',\r\n    xfade: 'Crossfader A/B', auto: 'Autopilot',\r\n  };\r\n  if (flat[k]) return flat[k];\r\n  if (k === 'cell') return `Celda CAPA ${+a + 1} · col ${+b + 1}`;\r\n  if (k === 'col') return `Columna ${+a + 1}`;\r\n  if (k === 'lop') return `Opacidad CAPA ${+a + 1}`;\r\n  if (k === 'lspd') return `Velocidad CAPA ${+a + 1}`;\r\n  if (k === 'lclear') return `Apagar CAPA ${+a + 1}`;\r\n  if (k === 'scene') return `Escena ${+a + 1}`;\r\n  if (k === 'fx') return `Efecto #${a} · ${b}`;\r\n  return t;\r\n}\r\nfunction buildSurfList() {\r\n  const box = $('#cpsurfs'); if (!box) return;\r\n  box.innerHTML = '';\r\n  state.map.surfaces.forEach((sf, i) => {\r\n    const r = el('div', 'cpmap');\r\n    if (i === state.map.sel) r.style.borderLeft = '3px solid var(--acc2)';\r\n    const nm = el('span');\r\n    nm.innerHTML = `<b>Superficie ${i + 1}</b>${i === state.map.sel ? ' ← editando' : ''}`;\r\n    nm.style.cursor = 'pointer';\r\n    nm.onclick = () => { state.map.sel = i; positionWarpDots(); buildSurfList(); };\r\n    const src = el('select');\r\n    SRC_PRESETS.forEach(([lbl, rect], pi) => {\r\n      const o = el('option'); o.value = pi; o.textContent = 'fuente: ' + lbl; src.appendChild(o);\r\n    });\r\n    const cur = SRC_PRESETS.findIndex(([, rect]) => JSON.stringify(rect) === JSON.stringify(sf.src));\r\n    src.value = cur >= 0 ? cur : 0;\r\n    src.onchange = () => { sf.src = [...SRC_PRESETS[+src.value][1]]; markDirty(); };\r\n    const onb = el('button', 'mini' + (sf.on ? ' on' : ''));\r\n    onb.textContent = sf.on ? 'ON' : 'off';\r\n    onb.onclick = () => { sf.on = !sf.on; markDirty(); buildSurfList(); };\r\n    const del = el('button', 'mini'); del.textContent = '✕';\r\n    del.onclick = () => {\r\n      if (state.map.surfaces.length <= 1) { toast('Tiene que quedar al menos una superficie'); return; }\r\n      state.map.surfaces.splice(i, 1);\r\n      state.map.sel = Math.min(state.map.sel, state.map.surfaces.length - 1);\r\n      positionWarpDots(); markDirty(); buildSurfList();\r\n    };\r\n    const btns = el('span'); btns.style.display = 'flex'; btns.style.gap = '4px';\r\n    btns.append(src, onb, del);\r\n    r.append(nm, btns);\r\n    box.appendChild(r);\r\n  });\r\n}\r\nfunction buildScrList() {\r\n  const box = $('#cpscrlist'); if (!box) return;\r\n  if (!screenDet) {\r\n    box.innerHTML = '<div class=\"cprow\"><span class=\"v\">tocá 🔍 detectar y aceptá el permiso — te digo cuántas pantallas hay y cuál es cuál</span></div>';\r\n    return;\r\n  }\r\n  box.innerHTML = '';\r\n  screenDet.screens.forEach((s, i) => {\r\n    const auto = state.outScreen < 0 && !s.isPrimary &&\r\n      screenDet.screens.find(x => !x.isPrimary) === s;\r\n    const r = el('div', 'cpmap');\r\n    const nm = el('span');\r\n    nm.innerHTML = `<b>${screenName(s, i)}</b>${state.outScreen === i ? ' ← salida' : auto ? ' ← salida (auto)' : ''}`;\r\n    const use = el('button', 'mini' + (state.outScreen === i ? ' on' : ''));\r\n    use.textContent = 'usar';\r\n    use.title = 'abrir el OUTPUT en esta pantalla';\r\n    use.onclick = () => { state.outScreen = i; markDirty(); buildScrList(); toast('OUTPUT irá a ' + screenName(s, i)); };\r\n    const ver = el('button', 'mini');\r\n    ver.textContent = '👁 ver';\r\n    ver.title = 'mostrar un número gigante en esa pantalla para identificarla';\r\n    ver.onclick = () => identifyScreen(i);\r\n    const abrir = el('button', 'mini');\r\n    abrir.textContent = '🖥 salida acá';\r\n    abrir.title = 'abrir una ventana de salida en ESTA pantalla (multi-proyector: una por pantalla + mapping para repartir regiones)';\r\n    abrir.onclick = () => openOutput('ravenvj_out_s' + i, i);\r\n    const btns = el('span'); btns.style.display = 'flex'; btns.style.gap = '4px';\r\n    btns.append(use, ver, abrir);\r\n    r.append(nm, btns);\r\n    box.appendChild(r);\r\n  });\r\n  if (screenDet.screens.length === 1) {\r\n    const r = el('div', 'cprow');\r\n    r.innerHTML = '<span class=\"v\">hay UNA sola pantalla conectada — enchufá el proyector/HDMI y tocá 🔍 de nuevo</span>';\r\n    box.appendChild(r);\r\n  }\r\n}\r\n/* chequeo pre-show: todo lo que puede fallar en la fiesta, en una lista */\r\nfunction runPreflight() {\r\n  const out = [];\r\n  const chk = (n, v, extra) => out.push({ ok: !!v, txt: n + (extra ? ' — ' + extra : '') });\r\n  chk('Motor gráfico WebGL2', main.gl && !main.gl.isContextLost());\r\n  chk('Render fluido', fps > 20, fps + ' fps @ ' + state.res.join('×'));\r\n  const clips = state.decks.reduce((a, g) => a + g.flat().filter(c => c.kind !== 'empty').length, 0);\r\n  chk('Clips cargados', clips > 0, clips + ' en los 4 decks');\r\n  const unl = unlinkedCells().length;\r\n  chk('Videos enlazados', unl === 0, unl ? unl + ' sin enlazar → 🔗 RELINK' : 'todos ok');\r\n  chk('Escenas armadas', state.scenes.some(Boolean), state.scenes.filter(Boolean).length + '/8 (F1-F8)');\r\n  const mid = $('#midiSt').textContent;\r\n  chk('nanoPAD2 / MIDI', midiOk && !/sin dispositivo|denegado|pidiendo/.test(mid), mid.slice(0, 30));\r\n  chk('Audio-reactivo', audio.on, audio.on ? 'micrófono activo' : 'apagado — activá 🎤 si lo querés');\r\n  chk('Ventana de salida', outWin && !outWin.closed, outWin && !outWin.closed ? 'abierta' : 'abrila con 🖥 OUTPUT');\r\n  chk('Pantallas detectadas', !!screenDet, screenDet ? screenDet.screens.length + ' pantalla(s)' : 'Render → 🔍 detectar');\r\n  let store = false;\r\n  try { localStorage.setItem('__pf', '1'); localStorage.removeItem('__pf'); store = true; } catch (e) { }\r\n  chk('Autosave (almacenamiento)', store);\r\n  chk('Set de respaldo', true, '💾 guardá un JSON en un pendrive, por las dudas');\r\n  const box = $('#pfout');\r\n  if (box) box.innerHTML = out.map(o =>\r\n    `<div class=\"cprow\"><span class=\"v\" style=\"color:${o.ok ? 'var(--acc)' : 'var(--warn)'}\">${o.ok ? '✅' : '⚠️'} ${o.txt}</span></div>`).join('');\r\n  const bad = out.filter(o => !o.ok).length;\r\n  toast(bad ? `🧪 Chequeo: ${bad} cosa(s) para mirar` : '🧪 Todo listo para la fiesta 🍄');\r\n  return out;\r\n}\r\nfunction buildSlList() {\r\n  const box = $('#slList'); if (!box) return;\r\n  const SL = state.setlist;\r\n  box.innerHTML = SL.steps.length ? '' : '<div class=\"cprow\"><span class=\"v\">sin pasos — guardá escenas y agregalas acá</span></div>';\r\n  SL.steps.forEach((st, i) => {\r\n    const r = el('div', 'cpmap');\r\n    if (SL.running && i === SL.idx) r.style.borderLeft = '3px solid var(--acc)';\r\n    const s = el('span');\r\n    s.innerHTML = `${i + 1}. <b>Escena ${st.scene + 1}</b> — ${st.min} min${state.scenes[st.scene] ? '' : ' ⚠ vacía'}`;\r\n    const up = el('button', 'mini'); up.textContent = '↑';\r\n    up.onclick = () => { if (i > 0) { SL.steps.splice(i - 1, 0, SL.steps.splice(i, 1)[0]); markDirty(); buildSlList(); } };\r\n    const del = el('button', 'mini'); del.textContent = '✕';\r\n    del.onclick = () => { SL.steps.splice(i, 1); if (SL.idx >= SL.steps.length) SL.idx = 0; markDirty(); buildSlList(); };\r\n    const btns = el('span'); btns.style.display = 'flex'; btns.style.gap = '4px';\r\n    btns.append(up, del);\r\n    r.append(s, btns);\r\n    box.appendChild(r);\r\n  });\r\n}\r\nfunction buildCpMaps() {\r\n  const box = $('#cpmaps'); if (!box) return;\r\n  const ent = Object.entries(state.mappings);\r\n  box.innerHTML = ent.length ? '' : '<div class=\"cprow\"><span class=\"v\">sin mapeos — usá 🎹 MIDI learn</span></div>';\r\n  for (const [k, t] of ent) {\r\n    const r = el('div', 'cpmap');\r\n    const [kind, ch, num] = k.split(':');\r\n    const s = el('span');\r\n    s.innerHTML = (kind === 'key' ? `⌨ ${num}` : `${kind === 'note' ? '♪' : 'CC'}${num} ch${+ch + 1}`) +\r\n      ` → <b>${mapTargetName(t)}</b>`;\r\n    const del = el('button', 'mini'); del.textContent = '✕'; del.title = 'borrar mapeo';\r\n    del.onclick = () => { delete state.mappings[k]; markDirty(); buildCpMaps(); };\r\n    r.append(s, del);\r\n    box.appendChild(r);\r\n  }\r\n}\r\nfunction drawFpsGraph() {\r\n  const cv = $('#cpfps'); if (!cv) return;\r\n  const x = cv.getContext('2d');\r\n  x.fillStyle = '#0a0a0d'; x.fillRect(0, 0, cv.width, cv.height);\r\n  const n = Math.min(120, telemetry.fi);\r\n  const bw = cv.width / 120;\r\n  for (let i = 0; i < n; i++) {\r\n    const ms = telemetry.frames[(telemetry.fi - n + i + 120) % 120];\r\n    const h = Math.min(cv.height, ms / 50 * cv.height);\r\n    x.fillStyle = ms > 33 ? '#ff4444' : ms > 20 ? '#ffb03f' : '#8dff3f';\r\n    x.fillRect(i * bw, cv.height - h, bw - .5, h);\r\n  }\r\n  x.fillStyle = '#ffffff30';\r\n  x.fillRect(0, cv.height - (16.7 / 50 * cv.height), cv.width, 1);\r\n}\r\nfunction cpTick() {\r\n  if (!cpanel.classList.contains('open')) return;\r\n  const n = Math.min(120, telemetry.fi);\r\n  let sum = 0, mx = 0;\r\n  for (let i = 0; i < n; i++) { const v = telemetry.frames[i]; sum += v; mx = Math.max(mx, v); }\r\n  const vids = state.layers.reduce((a, L) =>\r\n    a + L.slots.filter(s => s.kind === 'video' && s.video && !s.video.paused).length, 0);\r\n  const up = Math.floor((performance.now() - telemetry.startT) / 1000);\r\n  const vals = {\r\n    fps, ft: n ? (sum / n).toFixed(1) + ' / ' + mx.toFixed(0) + ' ms' : '–',\r\n    drop: telemetry.dropped, res: state.res[0] + '×' + state.res[1],\r\n    mem: performance.memory ? (performance.memory.usedJSHeapSize / 1048576).toFixed(0) + ' MB' : 'n/d',\r\n    up: Math.floor(up / 60) + ':' + String(up % 60).padStart(2, '0'),\r\n    lay: state.layers.filter(L => L.slots[L.target].kind !== 'empty').length + ' / 4',\r\n    vid: vids,\r\n    fx: state.effects.filter(f => f.enabled).length + ' / ' + state.effects.length,\r\n    clips: state.grid.flat().filter(c => c.kind !== 'empty').length,\r\n    scn: state.scenes.filter(Boolean).length + ' / 8',\r\n    bpm: state.bpm, beats: telemetry.beats,\r\n    lvl: [audio.bass, audio.mid, audio.high].map(v => (v * 100).toFixed(0) + '%').join(' '),\r\n    mdev: $('#midiSt').textContent, mcount: telemetry.midiCount,\r\n    mlast: telemetry.midiLog[0] || '–',\r\n    unlink: unlinkedCells().length,\r\n    asize: ((localStorage.getItem('ravenvj_autosave') || '').length / 1024).toFixed(1) + ' KB',\r\n    sens: (state.beatSens || 1.32).toFixed(2),\r\n    slstat: state.setlist.running && state.setlist.steps[state.setlist.idx]\r\n      ? `paso ${state.setlist.idx + 1}/${state.setlist.steps.length} · faltan ` +\r\n        Math.max(0, state.setlist.steps[state.setlist.idx].min -\r\n          (performance.now() - state.setlist.t0) / 60000).toFixed(1) + ' min'\r\n      : 'detenido',\r\n  };\r\n  cpanel.querySelectorAll('[data-tv]').forEach(s => {\r\n    const k = s.dataset.tv; if (k in vals) s.textContent = vals[k];\r\n  });\r\n  if (cpTab === 'tele') drawFpsGraph();\r\n  if (cpTab === 'midi') {\r\n    const lg = $('#cpmidilog');\r\n    if (lg) lg.textContent = telemetry.midiLog.join('\\n') || '(sin actividad — tocá el nanoPAD2)';\r\n    const h = JSON.stringify(state.mappings);\r\n    if (h !== cpTick._mh) { cpTick._mh = h; buildCpMaps(); }\r\n  }\r\n  if (cpTab === 'audio') {\r\n    const set = (id, v) => { const e2 = $(id); if (e2) e2.style.width = (v * 100) + '%'; };\r\n    set('#cpbB', audio.bass); set('#cpbM', audio.mid); set('#cpbH', audio.high);\r\n  }\r\n  if (cpTab === 'setl' && state.setlist.running) {\r\n    if (cpTick._sli !== state.setlist.idx) { cpTick._sli = state.setlist.idx; buildSlList(); }\r\n  }\r\n}\r\n\r\n/* ---------------- warp de salida: esquinas arrastrables en el monitor ---------------- */\r\nconst warpDots = [];\r\n{\r\n  const monEl = $('#outCanvas').parentElement;\r\n  for (let i = 0; i < 4; i++) {\r\n    const wd = el('div', 'warpdot');\r\n    wd.style.display = 'none';\r\n    monEl.appendChild(wd);\r\n    warpDots.push(wd);\r\n    wd.addEventListener('pointerdown', e => {\r\n      e.preventDefault(); e.stopPropagation();\r\n      wd.setPointerCapture(e.pointerId);\r\n      const mv = ev => {\r\n        const r = monEl.getBoundingClientRect();\r\n        const sf = state.map.surfaces[state.map.sel];\r\n        if (!sf) return;\r\n        sf.pts[i] = [\r\n          clamp01((ev.clientX - r.left) / r.width),\r\n          clamp01(1 - (ev.clientY - r.top) / r.height),\r\n        ];\r\n        computeWarp(sf); positionWarpDots(); markDirty();\r\n      };\r\n      wd.onpointermove = mv;\r\n      wd.onpointerup = () => wd.onpointermove = null;\r\n    });\r\n  }\r\n}\r\nfunction positionWarpDots() {\r\n  const sf = state.map.surfaces[state.map.sel];\r\n  warpDots.forEach((wd, i) => {\r\n    wd.style.display = state.map.on && sf ? '' : 'none';\r\n    if (sf) {\r\n      wd.style.left = sf.pts[i][0] * 100 + '%';\r\n      wd.style.top = (1 - sf.pts[i][1]) * 100 + '%';\r\n    }\r\n  });\r\n}\r\nfunction mapToggle() {\r\n  state.map.on = !state.map.on;\r\n  if (state.map.on) {\r\n    computeAllWarps();\r\n    if (typeof toggleMapWin === 'function' && !mapWinOn) toggleMapWin(true);\r\n  }\r\n  positionWarpDots(); markDirty();\r\n  toast(state.map.on ? 'MAPPING ON — editá las superficies en la ventana flotante' : 'Mapping off');\r\n}\r\nfunction warpReset() {\r\n  const sf = state.map.surfaces[state.map.sel];\r\n  if (!sf) return;\r\n  sf.pts = [[0, 0], [1, 0], [1, 1], [0, 1]];\r\n  computeWarp(sf); positionWarpDots(); markDirty();\r\n}\r\nconst SRC_PRESETS = [\r\n  ['completa', [0, 0, 1, 1]], ['mitad izq', [0, 0, .5, 1]], ['mitad der', [.5, 0, .5, 1]],\r\n  ['mitad sup', [0, .5, 1, .5]], ['mitad inf', [0, 0, 1, .5]],\r\n  ['cuarto ↖', [0, .5, .5, .5]], ['cuarto ↗', [.5, .5, .5, .5]],\r\n  ['cuarto ↙', [0, 0, .5, .5]], ['cuarto ↘', [.5, 0, .5, .5]],\r\n];\r\n\r\n/* ---------------- editor flotante de mapping ---------------- */\r\nconst mapwin = el('div'); mapwin.id = 'mapwin';\r\nmapwin.innerHTML = `\r\n  <div id=\"mapwinbar\"><b>🗺 MAPPING</b>\r\n    <span>esquinas = deformar · arrastrá adentro = mover · click = elegir superficie</span>\r\n    <button class=\"mini\" id=\"mapwinclose\">✕</button></div>\r\n  <div id=\"maptools\"></div>\r\n  <div id=\"mapstage\"><canvas id=\"mapprev\" width=\"698\" height=\"393\"></canvas></div>`;\r\ndocument.body.appendChild(mapwin);\r\nconst mapPrev = $('#mapprev'), mapCtx = mapPrev.getContext('2d');\r\nlet mapWinOn = false;\r\n$('#mapwinclose').onclick = () => toggleMapWin(false);\r\nfunction toggleMapWin(open) {\r\n  mapWinOn = open === undefined ? !mapWinOn : open;\r\n  mapwin.classList.toggle('open', mapWinOn);\r\n  if (mapWinOn) {\r\n    if (!state.map.on) mapToggle();\r\n    mapEditorSync();\r\n  }\r\n}\r\n{ // mover la ventana por la barra de título\r\n  const bar = $('#mapwinbar');\r\n  bar.addEventListener('pointerdown', e => {\r\n    if (e.target.tagName === 'BUTTON') return;\r\n    bar.setPointerCapture(e.pointerId);\r\n    const r = mapwin.getBoundingClientRect();\r\n    const ox = e.clientX - r.left, oy = e.clientY - r.top;\r\n    const mv = ev => {\r\n      mapwin.style.left = Math.max(0, Math.min(innerWidth - 140, ev.clientX - ox)) + 'px';\r\n      mapwin.style.top = Math.max(0, Math.min(innerHeight - 60, ev.clientY - oy)) + 'px';\r\n    };\r\n    bar.onpointermove = mv;\r\n    bar.onpointerup = () => bar.onpointermove = null;\r\n  });\r\n}\r\nfunction mapEditorSync() {\r\n  if (!mapWinOn) return;\r\n  const tb = $('#maptools');\r\n  tb.innerHTML = '';\r\n  const onBtn = el('button', 'mini' + (state.map.on ? ' on' : ''));\r\n  onBtn.textContent = state.map.on ? 'MAPPING ON' : 'mapping off';\r\n  onBtn.onclick = () => { state.map.on = !state.map.on; computeAllWarps(); markDirty(); mapEditorSync(); };\r\n  tb.appendChild(onBtn);\r\n  state.map.surfaces.forEach((sf, i) => {\r\n    const ch = el('button', 'mini chip' + (i === state.map.sel ? ' on' : ''));\r\n    ch.textContent = 'S' + (i + 1) + (sf.on ? '' : ' ⊘');\r\n    ch.onclick = () => { state.map.sel = i; mapEditorSync(); };\r\n    tb.appendChild(ch);\r\n  });\r\n  const add = el('button', 'mini'); add.textContent = '＋';\r\n  add.title = 'agregar superficie';\r\n  add.onclick = () => {\r\n    if (state.map.surfaces.length >= 8) { toast('Máximo 8 superficies'); return; }\r\n    state.map.surfaces.push(newSurface());\r\n    state.map.sel = state.map.surfaces.length - 1;\r\n    computeAllWarps(); markDirty(); mapEditorSync(); buildSurfList();\r\n  };\r\n  tb.appendChild(add);\r\n  const sf = state.map.surfaces[state.map.sel];\r\n  if (!sf) return;\r\n  const src = el('select');\r\n  SRC_PRESETS.forEach(([lbl], pi) => {\r\n    const o = el('option'); o.value = pi; o.textContent = 'fuente: ' + lbl; src.appendChild(o);\r\n  });\r\n  const cur = SRC_PRESETS.findIndex(([, rc]) => JSON.stringify(rc) === JSON.stringify(sf.src));\r\n  src.value = cur >= 0 ? cur : 0;\r\n  src.onchange = () => { sf.src = [...SRC_PRESETS[+src.value][1]]; markDirty(); };\r\n  tb.appendChild(src);\r\n  const onS = el('button', 'mini' + (sf.on ? ' on' : ''));\r\n  onS.textContent = sf.on ? 'visible' : 'oculta';\r\n  onS.onclick = () => { sf.on = !sf.on; markDirty(); mapEditorSync(); buildSurfList(); };\r\n  tb.appendChild(onS);\r\n  const rst = el('button', 'mini'); rst.textContent = 'reset';\r\n  rst.onclick = () => { warpReset(); mapEditorSync(); };\r\n  tb.appendChild(rst);\r\n  const del = el('button', 'mini'); del.textContent = '✕ superficie';\r\n  del.onclick = () => {\r\n    if (state.map.surfaces.length <= 1) { toast('Tiene que quedar al menos una'); return; }\r\n    state.map.surfaces.splice(state.map.sel, 1);\r\n    state.map.sel = Math.min(state.map.sel, state.map.surfaces.length - 1);\r\n    markDirty(); mapEditorSync(); buildSurfList();\r\n  };\r\n  tb.appendChild(del);\r\n  // fila 2: máscara de forma + soft edge + contorno animado\r\n  const row2 = el('span');\r\n  row2.style.cssText = 'display:flex;gap:6px;align-items:center;width:100%;font-size:10px;color:var(--dim)';\r\n  const msel = el('select');\r\n  [['0', 'máscara: sin'], ['1', 'máscara: círculo'], ['2', 'máscara: rombo'], ['3', 'máscara: triángulo'], ['4', 'máscara: hexágono']]\r\n    .forEach(([v, txt]) => { const o = el('option'); o.value = v; o.textContent = txt; msel.appendChild(o); });\r\n  msel.value = sf.mask || 0;\r\n  msel.onchange = () => { sf.mask = +msel.value; markDirty(); };\r\n  const softL = el('span'); softL.textContent = 'borde suave';\r\n  const soft = el('input'); soft.type = 'range'; soft.min = 0; soft.max = .25; soft.step = .005;\r\n  soft.value = sf.soft || 0; soft.style.width = '80px';\r\n  soft.title = 'soft edge / edge blending: funde los bordes (para solapar proyectores)';\r\n  soft.oninput = () => { sf.soft = +soft.value; markDirty(); };\r\n  const lineL = el('span'); lineL.textContent = 'contorno';\r\n  const line = el('input'); line.type = 'range'; line.min = 0; line.max = .15; line.step = .005;\r\n  line.value = sf.line || 0; line.style.width = '80px';\r\n  line.title = 'contorno animado de la superficie: color ciclando que late con el beat';\r\n  line.oninput = () => { sf.line = +line.value; markDirty(); };\r\n  row2.append(msel, softL, soft, lineL, line);\r\n  tb.appendChild(row2);\r\n  syncMapHandles();\r\n}\r\nfunction pointInQuad(p, pts) {\r\n  let inside = false;\r\n  for (let i = 0, j = 3; i < 4; j = i++) {\r\n    const a = pts[i], b = pts[j];\r\n    if ((a[1] > p[1]) !== (b[1] > p[1]) &&\r\n      p[0] < (b[0] - a[0]) * (p[1] - a[1]) / (b[1] - a[1]) + a[0]) inside = !inside;\r\n  }\r\n  return inside;\r\n}\r\nconst mapHandles = [];\r\n{\r\n  const stage = $('#mapstage');\r\n  for (let i = 0; i < 4; i++) {\r\n    const h = el('div', 'maph');\r\n    h.style.display = 'none';\r\n    stage.appendChild(h);\r\n    mapHandles.push(h);\r\n    h.addEventListener('pointerdown', e => {\r\n      e.stopPropagation(); e.preventDefault();\r\n      const mv = ev => {\r\n        const r = stage.getBoundingClientRect();\r\n        const sf = state.map.surfaces[state.map.sel]; if (!sf) return;\r\n        sf.pts[i] = [\r\n          clamp01((ev.clientX - r.left) / r.width),\r\n          clamp01(1 - (ev.clientY - r.top) / r.height),\r\n        ];\r\n        computeWarp(sf); syncMapHandles(); markDirty();\r\n      };\r\n      const up = () => { removeEventListener('pointermove', mv); removeEventListener('pointerup', up); };\r\n      addEventListener('pointermove', mv);\r\n      addEventListener('pointerup', up);\r\n    });\r\n  }\r\n  stage.addEventListener('pointerdown', e => {\r\n    if (e.target !== stage && e.target !== mapPrev) return;\r\n    const r = stage.getBoundingClientRect();\r\n    const uv = [clamp01((e.clientX - r.left) / r.width), clamp01(1 - (e.clientY - r.top) / r.height)];\r\n    const hit = state.map.surfaces.findIndex(sf => pointInQuad(uv, sf.pts));\r\n    if (hit >= 0 && hit !== state.map.sel) { state.map.sel = hit; mapEditorSync(); }\r\n    const sf = state.map.surfaces[state.map.sel];\r\n    if (!sf || !pointInQuad(uv, sf.pts)) return;\r\n    let last = uv;\r\n    const mv = ev => {\r\n      const nu = [(ev.clientX - r.left) / r.width, 1 - (ev.clientY - r.top) / r.height];\r\n      let dx = nu[0] - last[0], dy = nu[1] - last[1];\r\n      for (const p of sf.pts) { // que ninguna esquina se escape\r\n        dx = Math.max(-p[0], Math.min(1 - p[0], dx));\r\n        dy = Math.max(-p[1], Math.min(1 - p[1], dy));\r\n      }\r\n      sf.pts = sf.pts.map(p => [p[0] + dx, p[1] + dy]);\r\n      last = [last[0] + dx, last[1] + dy];\r\n      computeWarp(sf); syncMapHandles(); markDirty();\r\n    };\r\n    const up = () => { removeEventListener('pointermove', mv); removeEventListener('pointerup', up); };\r\n    addEventListener('pointermove', mv);\r\n    addEventListener('pointerup', up);\r\n  });\r\n}\r\nfunction syncMapHandles() {\r\n  const sf = state.map.surfaces[state.map.sel];\r\n  mapHandles.forEach((h, i) => {\r\n    h.style.display = mapWinOn && sf ? '' : 'none';\r\n    if (sf) {\r\n      h.style.left = sf.pts[i][0] * 100 + '%';\r\n      h.style.top = (1 - sf.pts[i][1]) * 100 + '%';\r\n    }\r\n  });\r\n}\r\nfunction drawMapPrev() {\r\n  mapCtx.drawImage(main.canvas, 0, 0, mapPrev.width, mapPrev.height);\r\n  state.map.surfaces.forEach((sf, i) => {\r\n    mapCtx.beginPath();\r\n    sf.pts.forEach((p, pi) => {\r\n      const x = p[0] * mapPrev.width, y = (1 - p[1]) * mapPrev.height;\r\n      pi ? mapCtx.lineTo(x, y) : mapCtx.moveTo(x, y);\r\n    });\r\n    mapCtx.closePath();\r\n    mapCtx.lineWidth = i === state.map.sel ? 2.5 : 1.2;\r\n    mapCtx.strokeStyle = i === state.map.sel ? '#ff3d54' : '#ffffff66';\r\n    mapCtx.stroke();\r\n    const cx = sf.pts.reduce((a, p) => a + p[0] / 4, 0), cy = sf.pts.reduce((a, p) => a + p[1] / 4, 0);\r\n    mapCtx.fillStyle = i === state.map.sel ? '#ff3d54' : '#ffffffaa';\r\n    mapCtx.font = 'bold 14px sans-serif';\r\n    mapCtx.fillText('S' + (i + 1), cx * mapPrev.width - 9, (1 - cy) * mapPrev.height + 5);\r\n  });\r\n}\r\n\r\n/* ---------------- control remoto (celular, WebRTC vía PeerJS) ---------------- */\r\nconst remote = { peer: null, code: '', conns: [], on: false };\r\nfunction remoteToggle() {\r\n  if (remote.on || remote.peer) {\r\n    remote.conns.forEach(c => { try { c.close(); } catch (e) { } });\r\n    if (remote.peer) { try { remote.peer.destroy(); } catch (e) { } }\r\n    remote.peer = null; remote.code = ''; remote.conns = []; remote.on = false;\r\n    buildCpTab('remote');\r\n    toast('Remoto desactivado');\r\n    return;\r\n  }\r\n  const boot = () => {\r\n    remote.code = Math.random().toString(36).replace(/[^a-z0-9]/g, '').slice(0, 4).toUpperCase() || 'RAVN';\r\n    remote.peer = new Peer('ravenvj-' + remote.code.toLowerCase());\r\n    remote.peer.on('open', () => { remote.on = true; buildCpTab('remote'); toast('📱 Remoto ACTIVO — código ' + remote.code); });\r\n    remote.peer.on('error', err => { toast('⚠ Remoto: ' + (err.type || err.message) + ' — reintentá'); buildCpTab('remote'); });\r\n    setTimeout(() => {\r\n      if (!remote.on && remote.peer) toast('⚠ El remoto no conectó (¿hay internet?) — desactivalo y reintentá');\r\n    }, 10000);\r\n    remote.peer.on('connection', conn => {\r\n      remote.conns.push(conn);\r\n      conn.on('open', () => { sendLayout(conn); toast('📱 Celular conectado'); buildCpTab('remote'); });\r\n      conn.on('data', d => { try { remoteMsg(d); } catch (e) { console.error(e); } });\r\n      conn.on('close', () => { remote.conns = remote.conns.filter(c => c !== conn); buildCpTab('remote'); });\r\n    });\r\n  };\r\n  if (window.Peer) { boot(); return; }\r\n  toast('📱 Conectando el remoto…');\r\n  const s = document.createElement('script');\r\n  s.src = 'peerjs.min.js'; // alojado con la app: sin dependencia de CDN\r\n  s.onload = boot;\r\n  s.onerror = () => {\r\n    // portable file:// sin el archivo al lado → intento por CDN\r\n    const s2 = document.createElement('script');\r\n    s2.src = 'https://cdn.jsdelivr.net/npm/peerjs@1.5.5/dist/peerjs.min.js';\r\n    s2.onload = boot;\r\n    s2.onerror = () => toast('El remoto necesita internet para conectar (sirve el hotspot del celu)');\r\n    document.head.appendChild(s2);\r\n  };\r\n  document.head.appendChild(s);\r\n}\r\nfunction layoutMsg() {\r\n  return {\r\n    t: 'layout', cols: COLS, bpm: state.bpm, deck: state.deckIdx,\r\n    theme: { vars: (THEMES[state.theme] || THEMES.fenix).vars, grad: (THEMES[state.theme] || THEMES.fenix).grad },\r\n    grid: state.grid.map(row => row.map(c => ({\r\n      k: c.kind,\r\n      n: c.kind === 'empty' ? '' :\r\n        ((c.kind === 'gen' ? genIcon(c.presetIdx) + ' ' : c.kind === 'text' ? '💬' : c.kind === 'gif' ? '🎞' : c.kind === 'cam' ? '📷' : '') +\r\n          c.name).slice(0, 12),\r\n    }))),\r\n    scenes: state.scenes.map(s => !!s),\r\n  };\r\n}\r\nfunction sendLayout(conn) { try { conn.send(layoutMsg()); } catch (e) { } }\r\nfunction remoteBroadcastLayout() { if (remote.on) remote.conns.forEach(sendLayout); }\r\nfunction remoteMsg(d) {\r\n  if (!d || !d.t) return;\r\n  if (d.t === 'cell') triggerCell(+d.l, +d.c);\r\n  else if (d.t === 'col') triggerColumn(+d.c);\r\n  else if (d.t === 'scene') recallScene(+d.i);\r\n  else if (d.t === 'tgt') applyTarget(String(d.id), +d.val || 0, d.kind || 'cc', d.on ? 1 : 0);\r\n}\r\n\r\n/* ---------------- menú contextual del programa ---------------- */\r\nconst ctxm = el('div'); ctxm.id = 'ctxmenu'; document.body.appendChild(ctxm);\r\nfunction showMenu(x, y, title, items) {\r\n  ctxm.innerHTML = '';\r\n  if (title) { const h = el('div', 'hdr'); h.textContent = title; ctxm.appendChild(h); }\r\n  for (const it of items) {\r\n    if (it === '-') { ctxm.appendChild(el('div', 'sep')); continue