          "name": "turismo.css",
          "content": "body {\r\n  background-color: white;\r\n  background-image: none;\r\n}\r\n\r\n.turismo-video-section {\r\n  width: 100%;\r\n  margin-top: -20px;\r\n  background: transparent;\r\n}\r\n\r\n.turismo-video-container {\r\n  position: relative;\r\n  width: 100%;\r\n  aspect-ratio: 1 / 1;\r\n  overflow: hidden;\r\n  background: transparent;\r\n}\r\n\r\n.turismo-video-container iframe {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 50%;\r\n  width: 177.78%;\r\n  height: 100%;\r\n  border: 0;\r\n  transform: translateX(-50%);\r\n}\r\n\r\n.turismo-copy {\r\n  margin: 18px 10px 0;\r\n  padding: 0;\r\n}\r\n\r\n.turismo-copy p {\r\n  margin-bottom: 12px;\r\n  color: #333;\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 12px;\r\n  line-height: 1.18;\r\n}\r\n\r\n.turismo-copy .intro-text {\r\n  font-size: 19px;\r\n  font-weight: 300;\r\n  line-height: 1.16;\r\n}\r\n\r\n.tourism-banner-section {\r\n  margin: 14px 10px 0;\r\n}\r\n\r\n.tourism-banner-link {\r\n  display: block;\r\n}\r\n\r\n.tourism-banner {\r\n  margin: 33px 0;\r\n  display: block;\r\n  width: 100%;\r\n  height: auto;\r\n  border-radius: 16px;\r\n  opacity: 0;\r\n  transform: translateY(18px) scale(0.985);\r\n  animation: tourismFadeUp 0.92s ease forwards;\r\n  animation-delay: 0.4s;\r\n}\r\n\r\n.tourism-cards-section {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n  margin: 10px 10px 0;\r\n}\r\n\r\n.tourism-card-row {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  gap: 10px;\r\n}\r\n\r\n.tourism-card {\r\n  position: relative;\r\n  display: block;\r\n  overflow: hidden;\r\n  border-radius: 14px;\r\n  box-shadow: 0 8px 18px rgba(0, 0, 0, 0.12);\r\n  opacity: 0;\r\n  transform: translateY(18px) scale(0.985);\r\n  animation: tourismFadeUp 0.92s ease forwards;\r\n}\r\n\r\n.tourism-cards-section > .tourism-card:nth-child(1) {\r\n  animation-delay: 0.16s;\r\n}\r\n\r\n.tourism-cards-section > .tourism-card-row:nth-child(2) .tourism-card:first-child {\r\n  animation-delay: 0.28s;\r\n}\r\n\r\n.tourism-cards-section > .tourism-card-row:nth-child(2) .tourism-card:last-child {\r\n  animation-delay: 0.4s;\r\n}\r\n\r\n.tourism-cards-section > .tourism-card:nth-child(3) {\r\n  animation-delay: 0.52s;\r\n}\r\n\r\n.tourism-cards-section > .tourism-card-row:nth-child(4) .tourism-card:first-child {\r\n  animation-delay: 0.64s;\r\n}\r\n\r\n.tourism-cards-section > .tourism-card-row:nth-child(4) .tourism-card:last-child {\r\n  animation-delay: 0.76s;\r\n}\r\n\r\n.tourism-card-link {\r\n  text-decoration: none;\r\n  color: inherit;\r\n}\r\n\r\n.tourism-card img {\r\n  display: block;\r\n  width: 100%;\r\n  height: auto;\r\n}\r\n\r\n.tourism-card::after {\r\n  content: \"\";\r\n  position: absolute;\r\n  inset: 0;\r\n  background: linear-gradient(180deg, rgba(0, 0, 0, 0.03) 8%, rgba(0, 0, 0, 0.14) 34%, rgba(0, 0, 0, 0.34) 62%, rgba(0, 0, 0, 0.62) 100%);\r\n}\r\n\r\n.tourism-card-label {\r\n  position: absolute;\r\n  left: 12px;\r\n  right: 12px;\r\n  bottom: 10px;\r\n  z-index: 1;\r\n  color: #fff;\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 0.88rem;\r\n  font-weight: 700;\r\n  line-height: 1.04;\r\n  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.36), 0 1px 2px rgba(0, 0, 0, 0.28);\r\n}\r\n\r\n.tourism-links-section {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  gap: 10px;\r\n  margin: 30px 10px 20px;\r\n}\r\n\r\n.tourism-link-card {\r\n  display: flex;\r\n  min-height: 88px;\r\n  flex-direction: column;\r\n  justify-content: space-between;\r\n  padding: 12px 12px 10px;\r\n  border-radius: 16px;\r\n  background: #e6643c;\r\n  color: #fff;\r\n  text-decoration: none;\r\n  box-shadow: 0 8px 18px rgba(230, 100, 60, 0.2);\r\n  transition: transform 0.18s ease, box-shadow 0.18s ease;\r\n  opacity: 0;\r\n  transform: translateY(18px) scale(0.985);\r\n  animation: tourismFadeUp 0.92s ease forwards;\r\n}\r\n\r\n.tourism-links-section .tourism-link-card:nth-child(1) {\r\n  animation-delay: 0.88s;\r\n}\r\n\r\n.tourism-links-section .tourism-link-card:nth-child(2) {\r\n  animation-delay: 1s;\r\n}\r\n\r\n.tourism-link-card:hover {\r\n  transform: translateY(-1px);\r\n  box-shadow: 0 10px 22px rgba(230, 100, 60, 0.26);\r\n}\r\n\r\n.tourism-link-card h2 {\r\n  margin: 0;\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 0.85rem;\r\n  font-weight: 700;\r\n  padding-top: 10px;\r\n  line-height: 1.12;\r\n}\r\n\r\n.tourism-link-card span {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 0.63rem;\r\n  line-height: 1;\r\n}\r\n\r\n.tourism-link-card span img {\r\n  width: 11px;\r\n  height: 11px;\r\n  display: block;\r\n}\r\n\r\n.tourism-game-section {\r\n  margin: 14px 8px 0;\r\n  padding: 10px 0 0;\r\n  margin-bottom: 22px;\r\n  text-align: center;\r\n}\r\n\r\n.tourism-game-section p {\r\n  margin: 0 12px 10px;\r\n  color: #333;\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 12px;\r\n  line-height: 1.2;\r\n}\r\n\r\n.game-button {\r\n  display: inline-flex;\r\n  width: 100%;\r\n  min-height: 38px;\r\n  align-items: center;\r\n  justify-content: center;\r\n  border-radius: 999px;\r\n  background-color: #e6643c;\r\n  color: white;\r\n  text-decoration: none;\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 0.98rem;\r\n  font-weight: 700;\r\n  transition: transform 0.2s ease, box-shadow 0.2s ease;\r\n}\r\n\r\n.game-button:hover {\r\n  transform: translateY(-1px);\r\n  box-shadow: 0 6px 18px rgba(230, 100, 60, 0.22);\r\n}\r\n\r\n@keyframes tourismFadeUp {\r\n  from {\r\n    opacity: 0;\r\n    transform: translateY(18px) scale(0.985);\r\n  }\r\n  to {\r\n    opacity: 1;\r\n    transform: translateY(0) scale(1);\r\n  }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  .tourism-banner,\r\n  .tourism-card,\r\n  .tourism-link-card {\r\n    animation: none !important;\r\n    opacity: 1 !important;\r\n    transform: none !important;\r\n  }\r\n}\r\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/public/de_san_juan_a_la_mesa.html",
          "name": "de_san_juan_a_la_mesa.html",
          "content": "<!DOCTYPE html>\r\n<html lang=\"es\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>San Juan a la mesa - De San Juan a la mesa</title>\r\n    <link rel=\"stylesheet\" href=\"css/style.css\">\r\n    <link rel=\"stylesheet\" href=\"css/actividad-detalle.css\">\r\n</head>\r\n<body>\r\n    <main class=\"activity-detail-page\" style=\"--accent: #b2ab4b; --accent-soft: rgba(178, 171, 75, 0.18);\">\r\n        <section class=\"hero-section activity-detail-hero\">\r\n            <img src=\"assets/Actividades/a_la_mesa/fondo.png\" alt=\"De San Juan a la mesa\" class=\"background-image\">\r\n            <div class=\"content-container\">\r\n                <h1 class=\"tagline\">De San Juan<br>a la Mesa</h1>\r\n            </div>\r\n        </section>\r\n\r\n        <section class=\"detail-section\">\r\n            <h2 class=\"detail-title\">Aceite de oliva Virgen Extra</h2>\r\n            <p class=\"detail-subtitle\">Conocé el recorrido del aceite de oliva sanjuanino, sus características y el valor de uno de los productos más representativos de la provincia.</p>\r\n            <div class=\"activity-copy\">\r\n                <p>En esta experiencia <strong>vas a descubrir el universo del aceite de oliva que llega a tu mesa</strong>: su origen, su proceso y las particularidades que lo hacen parte de la identidad productiva de San Juan.</p>\r\n                <p>Una actividad para <strong>aprender a mirar, reconocer, probar y valorar un producto que nace del territorio y llega a tu hogar</strong> con historia propia.</p>\r\n                <p>Cata post taller.</p>\r\n            </div>\r\n        </section>\r\n\r\n        <section class=\"event-invite\" data-default-day=\"jueves\">\r\n            <h2>Te invitamos a participar del evento</h2>\r\n            <div class=\"days-line\">\r\n                <button type=\"button\" class=\"day-tab active\" data-day=\"jueves\">Jueves</button>\r\n                <span class=\"days-separator\">·</span>\r\n                <button type=\"button\" class=\"day-tab\" data-day=\"viernes\">Viernes</button>\r\n                <span class=\"days-separator\">·</span>\r\n                <button type=\"button\" class=\"day-tab\" data-day=\"sabado\">Sábado</button>\r\n                <span class=\"days-separator\">·</span>\r\n                <button type=\"button\" class=\"day-tab\" data-day=\"domingo\">Domingo</button>\r\n            </div>\r\n            <div class=\"schedule-grid\" data-schedule-jueves=\"15hs\" data-schedule-viernes=\"15hs\" data-schedule-sabado=\"15hs\" data-schedule-domingo=\"14hs\"></div>\r\n        </section>\r\n\r\n        <section class=\"detail-section\">\r\n            <h2 class=\"detail-title\">Vino</h2>\r\n            <p class=\"detail-subtitle\">Un momento para conocer el vínculo entre San Juan, la vid y los sabores que expresan su territorio.</p>\r\n            <div class=\"activity-copy\">\r\n                <p>San Juan también se disfruta a través de sus vinos. En esta actividad <strong>vas a conocer más sobre la producción vitivinícola de la provincia</strong>, sus características y la forma en que cada copa puede expresar paisaje, clima y origen.</p>\r\n                <p>Un encuentro breve para acercarse al vino desde una mirada simple, sensorial y vinculada al territorio.</p>\r\n                <p>Cata post taller <span style=\"color:#555;\">(la degustación es solo para mayores de 18 años).</span></p>\r\n            </div>\r\n        </section>\r\n\r\n        <section class=\"event-invite\" data-default-day=\"jueves\" style=\"--invite-accent: #7d4f57;\">\r\n            <h2>Te invitamos a participar del evento</h2>\r\n            <div class=\"days-line\">\r\n                <button type=\"button\" class=\"day-tab active\" data-day=\"jueves\">Jueves</button>\r\n                <span class=\"days-separator\">·</span>\r\n                <button type=\"button\" class=\"day-tab\" data-day=\"viernes\">Viernes</button>\r\n                <span class=\"days-separator\">·</span>\r\n                <button type=\"button\" class=\"day-tab\" data-day=\"sabado\">Sábado</button>\r\n                <span class=\"days-separator\">·</span>\r\n                <button type=\"button\" class=\"day-tab\" data-day=\"domingo\">Domingo</button>\r\n            </div>\r\n            <div class=\"schedule-grid\" data-schedule-jueves=\"17hs\" data-schedule-viernes=\"17hs\" data-schedule-sabado=\"17hs\" data-schedule-domingo=\"18hs\"></div>\r\n        </section>\r\n    </main>\r\n\r\n    <script src=\"js/header.js\"></script>\r\n    <script src=\"js/footer.js\"></script>\r\n    <script src=\"js/actividad-detalle.js\"></script>\r\n    <script src=\"js/touch.js\"></script>\r\n</body>\r\n</html>\r\n"
        },
