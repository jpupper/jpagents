          "path": "D:/Programacion/caminosysabores/deploy_scripts/test_batch.js",
          "name": "test_batch.js",
          "content": "require('dotenv').config({ path: require('path').join(__dirname, '..', 'server', '.env') });\nconst ftp = require('basic-ftp');\nconst path = require('path');\nconst fs = require('fs');\n\nasync function test() {\n  const client = new ftp.Client();\n  \n  try {\n    await client.access({\n      host: process.env.FTP_HOST,\n      user: process.env.FTP_USER,\n      password: process.env.FTP_PASS,\n      secure: true,\n      secureOptions: { rejectUnauthorized: false }\n    });\n\n    const remoteDir = '/trabajos/caminosysabores/test_batch';\n    await client.ensureDir(remoteDir);\n\n    // Subir 80 archivos chicos para ver cuando corta\n    for (let i = 1; i <= 80; i++) {\n      const tmpPath = path.join(__dirname, `batch_${i}.txt`);\n      try {\n        fs.writeFileSync(tmpPath, `file ${i}`);\n        await client.ensureDir(remoteDir);\n        await client.uploadFrom(tmpPath, `batch_${i}.txt`);\n        if (i % 10 === 0) process.stdout.write(`OK(${i}) `);\n      } catch (e) {\n        console.log(`\\nFALLO en archivo ${i}: ${e.code} - ${e.message}`);\n        // Probar si el control socket sigue vivo con un PWD\n        try {\n          const pwd = await client.pwd();\n          console.log(`Control socket vivo, PWD: ${pwd}`);\n        } catch(e2) {\n          console.log(`Control socket MUERTO: ${e2.message}`);\n        }\n        break;\n      } finally {\n        try { fs.unlinkSync(tmpPath); } catch {}\n      }\n    }\n\n    // Limpiar\n    console.log('\\nLimpiando archivos de test...');\n    const items = await client.list();\n    for (const item of items) {\n      if (item.name.startsWith('batch_')) {\n        await client.remove(item.name);\n      }\n    }\n    await client.removeDir(remoteDir);\n\n  } catch (e) {\n    console.log('ERROR GENERAL:', e.message);\n  }\n  client.close();\n}\n\ntest();\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/deploy_scripts/test_upload.js",
          "name": "test_upload.js",
          "content": "require('dotenv').config({ path: require('path').join(__dirname, '..', 'server', '.env') });\nconst ftp = require('basic-ftp');\nconst path = require('path');\nconst fs = require('fs');\n\nasync function testUpload() {\n  const client = new ftp.Client();\n  client.ftp.verbose = true;\n  \n  try {\n    const ftpHost = process.env.FTP_HOST;\n    const ftpUser = process.env.FTP_USER;\n    const ftpPassword = process.env.FTP_PASS;\n\n    console.log('=== CONECTANDO A ' + ftpHost + ' ===');\n    \n    await client.access({\n      host: ftpHost,\n      user: ftpUser,\n      password: ftpPassword,\n      secure: true,\n      secureOptions: { rejectUnauthorized: false }\n    });\n    \n    console.log('\\n=== CONECTADO - Probando uploads repetidos ===\\n');\n\n    const remoteDir = '/trabajos/caminosysabores';\n    await client.ensureDir(remoteDir);\n\n    // Hacer uploads de archivos chicos repetidamente para ver cuando falla\n    let count = 1;\n    const testFiles = [\n      'test1.txt', 'test2.txt', 'test3.txt', 'test4.txt', 'test5.txt'\n    ];\n    \n    for (const f of testFiles) {\n      try {\n        console.log(`\\n--- Intento ${count}: upload ${f} ---`);\n        const tmpPath = path.join(__dirname, f);\n        fs.writeFileSync(tmpPath, `test content ${count}`);\n        await client.ensureDir(remoteDir + '/testdir');\n        await client.uploadFrom(tmpPath, f);\n        console.log(`OK ${f}`);\n        fs.unlinkSync(tmpPath);\n        count++;\n      } catch (e) {\n        console.log(`FALLO en ${f}: ${e.code} - ${e.message}`);\n        break;\n      }\n    }\n\n    // Ahora probar LIST repetido\n    console.log('\\n--- Probando LIST repetido ---');\n    for (let i = 0; i < 10; i++) {\n      try {\n        console.log(`LIST intento ${i+1}...`);\n        const items = await client.list();\n        console.log(`OK - ${items.length} items`);\n      } catch (e) {\n        console.log(`FALLO LIST ${i+1}: ${e.code} - ${e.message}`);\n        break;\n      }\n    }\n\n  } catch (e) {\n    console.log('ERROR GENERAL:', e.message);\n  }\n  \n  client.close();\n}\n\ntestUpload();\n"
        },
