        {
          "path": "D:/Programacion/caminosysabores/public/sitio/home.html",
          "name": "home.html",
          "content": "<!DOCTYPE html>\r\n<html lang=\"es\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>San Juan a la mesa - Home</title>\r\n    <link rel=\"stylesheet\" href=\"css/style.css\">\r\n    <link rel=\"stylesheet\" href=\"css/home.css\">\r\n</head>\r\n<body>\r\n    <!-- El header se creará dinámicamente con JavaScript -->\r\n    \r\n    <main>\r\n        <section class=\"video-section\">\r\n            <div class=\"video-container\">\r\n                <!-- Video para PC -->\r\n                <iframe class=\"desktop-video\"\r\n                    src=\"https://www.youtube.com/embed/eMFpOmKHVX8?autoplay=1&mute=1&loop=1&controls=0&playlist=eMFpOmKHVX8&showinfo=0&rel=0&modestbranding=1&disablekb=1\" \r\n                    title=\"San Juan a la mesa\" \r\n                    frameborder=\"0\" \r\n                    allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" \r\n                    allowfullscreen>\r\n                </iframe>\r\n                <!-- Video para móvil -->\r\n                <iframe class=\"mobile-video\"\r\n                    src=\"https://www.youtube.com/embed/Q_V9VJTROO0?autoplay=1&mute=1&loop=1&controls=0&playlist=Q_V9VJTROO0&showinfo=0&rel=0&modestbranding=1&disablekb=1\" \r\n                    title=\"San Juan a la mesa\" \r\n                    frameborder=\"0\" \r\n                    allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" \r\n                    allowfullscreen>\r\n                </iframe>\r\n            </div>\r\n        </section>\r\n        \r\n        <!-- Sección de contenido con grid -->\r\n        <section class=\"content-section\">\r\n            <div class=\"content-grid\">\r\n                <!-- Fila 1 - Imagen completa: Showcooking -->\r\n                <div class=\"image-container row-1\" data-href=\"show.html\">\r\n                    <img src=\"assets/home/fila1.png\" alt=\"Showcooking sanjuanino\">\r\n                    <div class=\"image-text\">Showcooking<br>sanjuanino</div>\r\n                </div>\r\n                \r\n                <!-- Fila 2 - 3 imágenes -->\r\n                <div class=\"image-container row-2-1\" data-href=\"actividades.html\">\r\n                    <img src=\"assets/home/fila21.png\" alt=\"Actividades\">\r\n                    <div class=\"image-text\">Actividades</div>\r\n                </div>\r\n                \r\n                <div class=\"image-container row-2-2\" data-href=\"produccion.html\">\r\n                    <img src=\"assets/home/fila22.png\" alt=\"Producción\">\r\n                    <div class=\"image-text\">Producción</div>\r\n                </div>\r\n                \r\n                <div class=\"image-container row-2-3\" data-href=\"productores.html\">\r\n                    <img src=\"assets/home/fila23.png\" alt=\"Nuestros productores\">\r\n                    <div class=\"image-text\">Nuestros<br>productores</div>\r\n                </div>\r\n                \r\n                <!-- Fila 3 - 2 imágenes -->\r\n                <div class=\"image-container row-3-1\" data-href=\"reuniones.html\">\r\n                    <img src=\"assets/home/fila31.png\" alt=\"Reuniones Comex y prensa\">\r\n                    <div class=\"image-text\">Reuniones<br>Comex y prensa</div>\r\n                </div>\r\n                \r\n                <div class=\"image-container row-3-2\" data-href=\"sabores.html\">\r\n                    <img src=\"assets/home/fila32.png\" alt=\"Recetario\">\r\n                    <div class=\"image-text\">Recetario</div>\r\n                </div>\r\n                \r\n                <!-- Fila 4 - 2 imágenes -->\r\n                <div class=\"image-container row-3-1\" data-href=\"turismo.html\">\r\n                    <img src=\"assets/home/fila31.png\" alt=\"Turismo en San Juan\">\r\n                    <div class=\"image-text\">Turismo<br>en San Juan</div>\r\n                </div>\r\n                \r\n                <div class=\"image-container row-3-2\" data-href=\"sorteo.html\">\r\n                    <img src=\"assets/home/fila32.png\" alt=\"Sorteos y beneficios\">\r\n                    <div class=\"image-text\">Sorteos<br>y beneficios</div>\r\n                </div>\r\n            </div>\r\n        </section>\r\n    </main>\r\n\r\n    <!-- Cargar el header dinámico primero -->\r\n    <script src=\"js/header.js\"></script>\r\n    <script src=\"js/footer.js\"></script>\r\n    <script src=\"js/touch.js\"></script>\r\n    \r\n    <!-- Script para manejar los clics en los contenedores de imagen -->\r\n    <script>\r\n        document.addEventListener('DOMContentLoaded', function() {\r\n            const imageContainers = document.querySelectorAll('.image-container[data-href]');\r\n            \r\n            // Función para verificar si debemos aplicar las restricciones táctiles\r\n            function shouldApplyTouchRestrictions() {\r\n                const urlParams = new URLSearchParams(window.location.search);\r\n                return urlParams.get('touch') === 'true';\r\n            }\r\n\r\n            // Función para agregar touch=true a una URL\r\n            function addTouchParam(url) {\r\n                if (!shouldApplyTouchRestrictions()) return url;\r\n                const separator = url.includes('?') ? '&' : '?';\r\n                return url + separator + 'touch=true';\r\n            }\r\n            \r\n            imageContainers.forEach(container => {\r\n                container.style.cursor = 'pointer';\r\n                container.addEventListener('click', function() {\r\n                    const href = this.getAttribute('data-href');\r\n                    if (href) {\r\n                        window.location.href = addTouchParam(href);\r\n                    }\r\n                });\r\n            });\r\n        });\r\n    </script>\r\n</body>\r\n</html>\r\n"
