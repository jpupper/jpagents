          "path": "D:/Programacion/caminosysabores/public/sitio/css/show.css",
          "name": "show.css",
          "content": "/* Main layout for the show grid */\r\n.show-grid {\r\n  display: flex;\r\n  flex-direction: row;\r\n  align-items: stretch; /* Make columns equal height */\r\n  gap: 15px;\r\n  margin: 30px auto;\r\n  padding: 0 20px;\r\n  width: 100%;\r\n  max-width: 600px;\r\n  box-sizing: border-box;\r\n}\r\n\r\n.horario-container {\r\n  flex: 0 0 35%;\r\n  display: flex; /* Allow child to fill height */\r\n}\r\n\r\n.right-column {\r\n  flex: 1 1 auto;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 15px;\r\n}\r\n\r\n.horario-img {\r\n  width: 100%;\r\n  height: 68%;\r\n  object-fit: cover; /* Cover the container space */\r\n  border-radius: 12px;\r\n}\r\n\r\n/* Nuevo horario con texto - Figma 2026 */\r\n.horario-nuevo {\r\n  width: 100%;\r\n  height: 68%;\r\n  background: linear-gradient(135deg, #E6643C, #5A2828);\r\n  border-radius: 12px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: center;\r\n  align-items: center;\r\n  padding: 20px;\r\n  color: white;\r\n  font-family: 'Ubuntu', sans-serif;\r\n  text-align: center;\r\n}\r\n\r\n.horario-dia {\r\n  font-size: 1.8rem;\r\n  font-weight: bold;\r\n  margin-bottom: 5px;\r\n}\r\n\r\n.horario-hora {\r\n  font-size: 2.5rem;\r\n  font-weight: bold;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.horario-receta {\r\n  font-size: 1.2rem;\r\n  font-weight: 500;\r\n  line-height: 1.3;\r\n}\r\n\r\n.receta-img {\r\n  width: 100%;\r\n  height: auto;\r\n  border-radius: 12px;\r\n  display: block;\r\n}\r\n\r\n.receta-container {\r\n  position: relative;\r\n}\r\n\r\n.receta-text {\r\n  position: absolute;\r\n  bottom: 10px;\r\n  left: 10px;\r\n  color: white;\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 0.8rem;\r\n  line-height: 1.2;\r\n}\r\n\r\n.receta-text strong {\r\n  font-size: 1.1rem;\r\n  font-weight: 700;\r\n  display: block;\r\n}\r\n\r\n.acciones-container {\r\n  background-color: #a8a7a7;\r\n  border-radius: 8px;\r\n  padding: 10px;\r\n  display: grid; /* Use Grid for robust columns */\r\n  grid-template-columns: 1fr 1fr; /* Two equal columns */\r\n  gap: 10px;\r\n  align-items: center;\r\n}\r\n\r\n.accion-link {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center; /* Center content within the link */\r\n  text-decoration: none;\r\n  color: white;\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-weight: 400;\r\n  font-size: 0.8rem;\r\n  gap: 8px;\r\n  transition: opacity 0.3s ease;\r\n  white-space: nowrap; /* Prevent text wrapping */\r\n}\r\n\r\n.accion-link:hover {\r\n  opacity: 0.8;\r\n}\r\n\r\n#ver {\r\n  width: 30px;\r\n  height: 20px;\r\n  flex-shrink: 0;\r\n}\r\n\r\n#descargar {\r\n  width: 20px;\r\n  height: 20px;\r\n  flex-shrink: 0;\r\n}\r\n\r\n/* Larger screens */\r\n@media (min-width: 480px) {\r\n  .receta-text {\r\n    font-size: 1.1rem;\r\n  }\r\n  .receta-text strong {\r\n    font-size: 1.6rem;\r\n  }\r\n  .acciones-container {\r\n    padding: 12px 20px;\r\n  }\r\n  .accion-link {\r\n    font-size: 1rem;\r\n    gap: 10px;\r\n  }\r\n  .accion-icon {\r\n    width: 24px;\r\n    height: 24px;\r\n  }\r\n}\r\n\r\n/* Estilos para la sección de Chefs Invitados */\r\n.chefs-section {\r\n  background-color: #eaeaea;\r\n  padding: 20px 30px;\r\n  margin: 0;\r\n}\r\n\r\n.chefs-title {\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-weight: 700; /* Bold */\r\n  font-size: 1.5rem;\r\n  color: white;\r\n  text-align: left;\r\n  margin-bottom: 20px;\r\n  background-color: #b2b2b2;\r\n  padding: 5px 10px;\r\n  display: inline-block;\r\n  width: 100%;\r\n  margin: 0px;\r\n}\r\n\r\n.chefs-container {\r\n  display: flex;\r\n  flex-direction: row; /* Horizontal por defecto */\r\n  gap: 30px;\r\n  flex-wrap: wrap; /* Permitir que los elementos se envuelvan */\r\n}\r\n\r\n.chef-card {\r\n  background-color: #eaeaea; /* Mismo fondo que la sección */\r\n  border-radius: 15px;\r\n  text-align: left;\r\n  flex: 1 1 calc(50% - 15px); /* Dos columnas con espacio */\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.chef-image {\r\n  width: 100%;\r\n  border-radius: 15px;\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.chef-name {\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-weight: 700; /* Bold */\r\n  font-size: 20px;\r\n  color: #333;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.chef-description {\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 12px;\r\n  line-height: 1.5;\r\n  color: #333;\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.chef-social {\r\n  display: inline-block;\r\n}\r\n\r\n.chef-social img {\r\n  width: 30px;\r\n  height: 30px;\r\n  opacity: 0.6;\r\n}\r\n\r\n/* Layout responsivo para la sección de chefs */\r\n@media (min-width: 768px) {\r\n  .chefs-container {\r\n    align-items: stretch;\r\n  }\r\n\r\n  .chef-card {\r\n    flex: 1; /* Cada tarjeta ocupa el mismo espacio */\r\n  }\r\n\r\n  .chef-description {\r\n    flex-grow: 1; /* Asegura que la descripción ocupe el espacio disponible */\r\n  }\r\n}\r\n\r\n/* Estilos para el overlay de video */\r\n.overlay {\r\n  display: none;\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background-color: rgba(0, 0, 0, 0.8);\r\n  z-index: 1000;\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n\r\n.overlay.active {\r\n  display: flex;\r\n}\r\n\r\n.overlay-content {\r\n  position: relative;\r\n  background: black;\r\n}\r\n\r\n.overlay-content.video-content {\r\n  width: 100%;\r\n  aspect-ratio: 16 / 9;\r\n  position: relative;\r\n}\r\n\r\n/* Mobile: usar formato 1:1 */\r\n@media (max-width: 768px) {\r\n  .overlay-content.video-content {\r\n    max-width: 90%;\r\n    aspect-ratio: 1 / 1;\r\n    width: min(90vh, 400px);\r\n  }\r\n\r\n  #youtube-player {\r\n    aspect-ratio: 1 / 1;\r\n  }\r\n}\r\n\r\n/* Desktop: usar formato 16:9 */\r\n@media (min-width: 769px) {\r\n  .overlay-content.video-content {\r\n    max-width: 95%;\r\n    width: 95vw;\r\n    max-height: 90vh;\r\n  }\r\n\r\n  #youtube-player {\r\n    aspect-ratio: 16 / 9;\r\n  }\r\n}\r\n\r\n.video-content {\r\n  overflow: hidden;\r\n}\r\n\r\n.video-content iframe {\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n\r\n.close-button {\r\n  position: absolute;\r\n  top: -40px;\r\n  right: 0;\r\n  background: none;\r\n  border: none;\r\n  color: white;\r\n  font-size: 30px;\r\n  cursor: pointer;\r\n  padding: 5px;\r\n  z-index: 1001;\r\n}\r\n\r\n.close-icon {\r\n  display: block;\r\n  line-height: 1;\r\n}\r\n\r\n/* Estilos para el fallback del video */\r\n.video-fallback {\r\n  display: none;\r\n  width: 100%;\r\n  height: 100%;\r\n  background: #000;\r\n}\r\n\r\n.fallback-content {\r\n  height: 100%;\r\n  display: flex;\r\n  flex-direction: column;\r\n  justify-content: center;\r\n  align-items: center;\r\n  color: white;\r\n  text-align: center;\r\n  padding: 20px;\r\n}\r\n\r\n.short-preview {\r\n  width: 100%;\r\n  max-width: 400px;\r\n}\r\n\r\n.thumbnail-container {\r\n  position: relative;\r\n  width: 100%;\r\n  aspect-ratio: 16 / 9;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.video-thumbnail {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n}\r\n\r\n.play-overlay {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n\r\n.play-button svg {\r\n  width: 68px;\r\n  height: 48px;\r\n}\r\n\r\n.shorts-badge {\r\n  position: absolute;\r\n  bottom: 8px;\r\n  right: 8px;\r\n  background: red;\r\n  color: white;\r\n  padding: 2px 6px;\r\n  border-radius: 4px;\r\n  font-size: 12px;\r\n}\r\n\r\n.preview-info {\r\n  margin-top: 20px;\r\n}\r\n\r\n.preview-info h3 {\r\n  font-size: 18px;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.preview-info p {\r\n  font-size: 14px;\r\n  opacity: 0.8;\r\n}\r\n\r\n.youtube-button {\r\n  margin-top: 20px;\r\n  background: red;\r\n  color: white;\r\n  border: none;\r\n  padding: 10px 20px;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  font-size: 16px;\r\n}\r\n\r\n.youtube-button:hover {\r\n  background: #cc0000;\r\n}\r\n\r\n#youtube-player {\r\n  width: 100%;\r\n  height: 100%;\r\n  aspect-ratio: 16 / 9;\r\n}\r\n\r\n.video-preview {\r\n  text-align: center;\r\n  margin: 2rem 0;\r\n}\r\n\r\n.video-preview .accion-link {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 0.5rem;\r\n  padding: 0.5rem 1rem;\r\n  background-color: #fff;\r\n  border-radius: 8px;\r\n  text-decoration: none;\r\n  color: #000;\r\n  transition: transform 0.2s ease;\r\n}\r\n\r\n.video-preview .accion-link:hover {\r\n  transform: scale(1.05);\r\n}\r\n\r\n.video-preview .accion-icon {\r\n  width: 24px;\r\n  height: 24px;\r\n}\r\n"
