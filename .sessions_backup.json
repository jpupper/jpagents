          "name": "index.html",
          "content": "<meta charset=\"utf-8\">\r\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\r\n<title>RAVEN VJ</title>\r\n<link rel=\"manifest\" href=\"manifest.webmanifest\">\r\n<style>\r\n:root{\r\n  --bg:#0d0705; --panel:#160e08; --panel2:#1e130b; --line:#3a2416;\r\n  --txt:#f0e4d8; --dim:#9a7d64; --acc:#ff7a1a; --acc2:#ff3d54; --warn:#ffd23f;\r\n  --grad:linear-gradient(135deg,#ff2d00,#ff8a00 55%,#ffd000);\r\n}\r\n*{box-sizing:border-box; user-select:none; -webkit-user-select:none}\r\n/* barras de desplazamiento con los colores del tema */\r\nhtml{scrollbar-color:var(--line) var(--bg)}\r\n*{scrollbar-width:thin;scrollbar-color:var(--line) transparent}\r\n::-webkit-scrollbar{width:10px;height:10px}\r\n::-webkit-scrollbar-track{background:transparent}\r\n::-webkit-scrollbar-thumb{background:var(--line);border-radius:5px;border:2px solid var(--bg)}\r\n::-webkit-scrollbar-thumb:hover{background:var(--acc)}\r\n::-webkit-scrollbar-corner{background:var(--bg)}\r\nhtml,body{margin:0;height:100%;background:var(--bg);color:var(--txt);\r\n  font:12px/1.35 \"Segoe UI\",system-ui,sans-serif; overflow:hidden;\r\n  color-scheme:dark; accent-color:var(--acc)}\r\nbutton,select,input{font:inherit;color:var(--txt);background:var(--panel2);\r\n  border:1px solid var(--line);border-radius:4px;padding:3px 8px;outline:none}\r\nbutton{cursor:pointer} button:hover{border-color:var(--acc);color:#fff}\r\nbutton.on{background:var(--grad);color:#000;border-color:var(--acc);font-weight:600}\r\nbutton.danger.on{background:#f33;border-color:#f33;color:#fff}\r\ninput[type=range]{-webkit-appearance:none;height:18px;background:transparent;padding:0}\r\ninput[type=range]::-webkit-slider-runnable-track{height:4px;background:var(--line);border-radius:2px}\r\ninput[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:12px;height:12px;margin-top:-4px;\r\n  border-radius:50%;background:var(--acc);cursor:pointer}\r\n#app{display:flex;flex-direction:column;height:100%}\r\n\r\n/* ---- menubar ---- */\r\n#menubar{display:flex;align-items:center;gap:2px;padding:2px 8px;background:#0a0a0d;\r\n  border-bottom:1px solid var(--line);font-size:12px}\r\n#mblogo{font-weight:800;letter-spacing:1px;color:#fff;margin-right:10px;font-size:12px}\r\n#menubar button{background:none;border:none;border-radius:4px;padding:3px 10px;color:var(--txt)}\r\n#menubar button:hover,#menubar button.open{background:var(--panel2);color:var(--acc)}\r\n#donateBtn{margin-left:auto;text-decoration:none;color:#000;background:var(--grad);\r\n  border-radius:12px;padding:2px 12px;font-weight:700;font-size:11px}\r\n#donateBtn:hover{filter:brightness(1.15)}\r\n#ctxmenu .ci{display:flex;justify-content:space-between;gap:18px;align-items:center}\r\n#ctxmenu .ci .kbd{color:var(--dim);font-size:10px;font-family:Consolas,monospace}\r\n\r\n/* ---- top bar ---- */\r\n#topbar{display:flex;flex-wrap:wrap;gap:6px;align-items:center;padding:6px 8px;\r\n  background:var(--panel);border-bottom:1px solid var(--line)}\r\n.grp{display:flex;gap:4px;align-items:center;background:var(--panel2);\r\n  border:1px solid var(--line);border-radius:6px;padding:3px 6px}\r\n.grp label{color:var(--dim);font-size:10px;letter-spacing:.5px}\r\n#logo{font-weight:800;letter-spacing:1px;color:#fff;padding:0 4px}\r\n#logo b,#mblogo b{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}\r\n#beatdot{display:inline-block;width:8px;height:8px;border-radius:50%;background:#333;margin-left:4px}\r\n#bpmIn{width:48px;text-align:center}\r\n/* fuera las flechitas nativas del navegador — desentonan con el tema; rueda del mouse ajusta */\r\ninput[type=number]::-webkit-inner-spin-button,input[type=number]::-webkit-outer-spin-button{\r\n  -webkit-appearance:none;margin:0}\r\n#wizbox{position:fixed;left:50%;top:16%;transform:translateX(-50%);z-index:5000;width:350px;\r\n  background:var(--panel);border:1px solid var(--acc);border-radius:12px;padding:14px 16px;\r\n  box-shadow:0 12px 50px #000c;text-align:center}\r\n#wizbox h4{margin:0 0 8px;font-size:11px;color:var(--acc);letter-spacing:1px;display:flex;justify-content:space-between}\r\n#wizbox .wsec{font-size:10px;color:var(--dim);letter-spacing:1px}\r\n#wizbox .wlbl{font-size:13px;margin:10px 0 14px;line-height:1.5}\r\n#wizbox .wlbl b{color:var(--acc);font-size:16px}\r\n#wizbox .wbtns{display:flex;gap:6px;justify-content:center}\r\n#wizbox .wnote{margin-top:10px;font-size:9px;color:var(--dim)}\r\n#clock{position:fixed;right:8px;bottom:6px;z-index:60;font:600 12px/1 Consolas,monospace;\r\n  color:var(--dim);background:color-mix(in srgb,var(--bg) 72%,transparent);border:1px solid var(--line);\r\n  border-radius:6px;padding:4px 8px;cursor:pointer;user-select:none;backdrop-filter:blur(3px)}\r\n#clock:hover{color:var(--acc);border-color:var(--acc)}\r\n#clock b{color:var(--acc);font-weight:700}\r\n.meters{display:flex;gap:2px;align-items:flex-end;height:18px}\r\n.meters i{display:block;width:5px;height:2px;background:var(--acc);border-radius:1px}\r\n#midiBtn.learn{background:var(--acc2);border-color:var(--acc2);color:#000;font-weight:700}\r\n#sceneBtns{display:flex;gap:2px}\r\n#sceneBtns button{width:22px;padding:1px 0;font-size:10px;color:var(--dim)}\r\n#sceneBtns button.has{color:var(--acc);border-color:var(--acc)}\r\n#sceneBtns button.cur{background:var(--grad);color:#000}\r\n#recBtn.on{background:#f33;border-color:#f33;color:#fff;min-width:64px}\r\n.maplearn{outline:2px dashed var(--acc2)!important;outline-offset:1px}\r\n.mappend{outline:2px solid var(--acc2)!important;outline-offset:1px}\r\n\r\n/* ---- grid ---- */\r\n#gridwrap{flex:1;overflow:auto;padding:8px;min-height:120px}\r\n#grid{display:grid;gap:4px;width:max-content}\r\n.colhead{height:22px;display:flex;align-items:center;justify-content:center;\r\n  position:sticky;top:0;z-index:5;background:var(--bg)}\r\n.colhead.corner{left:0;z-index:8}\r\n.deckbtn{flex:1;height:100%;padding:0;font-size:10px;font-weight:800;color:var(--dim)}\r\n.deckbtn.has{color:var(--acc)}\r\n.deckbtn.on{background:var(--grad);color:#000}\r\n.colhead button{width:100%;height:100%;padding:0;color:var(--dim);font-weight:600}\r\n.colhead button:hover{color:#000;background:var(--grad)}\r\n.lctrl{background:var(--panel);border:1px solid var(--line);border-radius:6px;\r\n  padding:5px 7px;display:flex;flex-direction:column;gap:3px;justify-content:center;\r\n  position:sticky;left:0;z-index:6;box-shadow:6px 0 10px -4px #000c}\r\n.lctrl .lrow{display:flex;gap:4px;align-items:center}\r\n.lctrl .lname{font-weight:700;color:#fff;font-size:11px;flex:1}\r\n.lctrl select{padding:1px 2px;font-size:10px;max-width:78px}\r\n.lctrl input[type=range]{width:100%}\r\n.lctrl .mini{padding:1px 6px;font-size:10px}\r\n.cell{position:relative;width:var(--cellw,96px);height:var(--cellh,108px);background:#101014;\r\n  border:1px solid var(--line);border-radius:5px;overflow:hidden;cursor:pointer}\r\n.split{flex:none;background:transparent;transition:background .15s;z-index:9}\r\n.split:hover{background:var(--acc)}\r\n#splitH{height:6px;cursor:ns-resize;margin:-2px 0}\r\n.splitv{width:6px;cursor:ew-resize;margin:0 -3px}\r\n.lctrl select{max-width:86px}\r\n.cell:hover{border-color:#555}\r\n.cell .thumb{position:absolute;inset:0;background-size:cover;background-position:center}\r\n.cell .cname{position:absolute;left:0;right:0;bottom:0;padding:2px 4px;font-size:10px;font-weight:600;\r\n  background:rgba(0,0,0,.78);color:#eee;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\r\n.cell .colbadge{position:absolute;top:2px;left:3px;font-size:9px;color:#fff9;\r\n  background:#0009;border-radius:3px;padding:0 3px;pointer-events:none;z-index:2}\r\n.cell .genprev{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}\r\n.cell .prog{position:absolute;left:0;top:0;height:2px;width:0;background:var(--acc)}\r\n.cell.active{border-color:var(--acc);box-shadow:0 0 8px #8dff3f66}\r\n.cell.fading{border-color:#5a8f3f}\r\n.cell.selprev{border-color:var(--acc2)}\r\n.cell.unlinked .thumb{filter:grayscale(1) brightness(.4)}\r\n.cell.unlinked::after{content:\"⚠\";position:absolute;top:2px;right:4px;color:var(--warn)}\r\n.cell.gen .cname{color:var(--acc)}\r\n.cell.text .cname{color:var(--acc2)}\r\n.cell.dragover{border-color:var(--acc2);box-shadow:0 0 10px #ff3fd466}\r\n.cell .kind{position:absolute;top:2px;left:4px;font-size:9px;color:#0009;\r\n  text-shadow:0 0 2px #000}\r\n\r\n/* ---- bottom ---- */\r\n#bottom{display:flex;gap:8px;padding:8px;background:var(--panel);\r\n  border-top:1px solid var(--line);height:250px;min-height:250px}\r\n.panel{background:var(--panel2);border:1px solid var(--line);border-radius:8px;\r\n  display:flex;flex-direction:column;overflow:hidden}\r\n.panel h3{margin:0;padding:5px 9px;font-size:10px;letter-spacing:1px;color:var(--dim);\r\n  border-bottom:1px solid var(--line);display:flex;gap:8px;align-items:center}\r\n#genPanel{width:220px}\r\n#genShelf{flex:1;overflow-y:auto;padding:6px;display:grid;grid-template-columns:1fr 1fr;gap:5px;align-content:start}\r\n.gtile{background:#101014;border:1px solid var(--line);border-radius:5px;padding:6px 4px;\r\n  text-align:center;cursor:grab;font-size:10px;color:var(--acc)}\r\n.gtile:hover{border-color:var(--acc)}\r\n.gtile span{display:block;font-size:16px;margin-bottom:2px}\r\n#fxPanel{flex:1;min-width:320px}\r\n#fxHead{display:flex;gap:6px;align-items:center;flex-wrap:wrap;font-size:10px}\r\n#fxList{flex:1;overflow-y:auto;padding:5px}\r\n.fx{background:#101014;border:1px solid var(--line);border-radius:6px;padding:4px 7px;margin-bottom:5px}\r\n.fx .fxbar{display:flex;gap:6px;align-items:center;margin-bottom:2px}\r\n.fx .fxname{font-weight:700;color:#fff;flex:1}\r\n.fx .prow{display:grid;grid-template-columns:52px 1fr 58px 52px;gap:5px;align-items:center;margin:1px 0}\r\n.fx .prow .pn{color:var(--dim);font-size:10px}\r\n.fx select{padding:0 2px;font-size:10px}\r\n.fx .mini{padding:0 6px;font-size:10px;line-height:16px}\r\n#monPanel{width:330px}\r\n#mons{flex:1;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:auto 1fr;gap:6px;padding:6px}\r\n.mon{position:relative;background:#000;border:1px solid var(--line);border-radius:5px;\r\n  aspect-ratio:16/9;overflow:hidden}\r\n.mon canvas{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}\r\n.mon .mlabel{position:absolute;top:2px;left:5px;font-size:9px;color:var(--dim);z-index:3;\r\n  text-shadow:0 0 3px #000}\r\n#xyWrap{grid-column:1/3;display:flex;gap:6px;min-height:0}\r\n#xypad{position:relative;flex:1;background:#101014;border:1px solid var(--line);border-radius:5px;\r\n  cursor:crosshair;touch-action:none}\r\n#xydot{position:absolute;width:10px;height:10px;border-radius:50%;background:var(--acc2);\r\n  transform:translate(-50%,-50%);pointer-events:none;box-shadow:0 0 8px var(--acc2)}\r\n#xyside{display:flex;flex-direction:column;gap:4px;justify-content:center}\r\n#xyside button{font-size:9px;padding:2px 6px}\r\n#hint{padding:2px 10px;font-size:10px;color:var(--dim);background:var(--panel);\r\n  border-top:1px solid var(--line);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\r\n#cpanel{position:fixed;inset:0;background:#000b;z-index:95;display:none;align-items:center;justify-content:center}\r\n#cpanel.open{display:flex}\r\n#cpbox{width:min(780px,94vw);height:min(540px,90vh);background:var(--panel);border:1px solid var(--line);\r\n  border-radius:12px;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 24px 80px #000}\r\n#cptabs{display:flex;gap:2px;padding:8px 10px 0;border-bottom:1px solid var(--line);background:var(--panel2);align-items:flex-end}\r\n#cptabs button{border-radius:6px 6px 0 0;border-bottom:none;padding:6px 12px;color:var(--dim);font-size:11px}\r\n#cptabs button.on{background:var(--panel);color:var(--acc);font-weight:600}\r\n#cptabs .cpclose{margin-left:auto;border-radius:6px;margin-bottom:4px}\r\n#cpbody{flex:1;overflow-y:auto;padding:12px 16px}\r\n.cprow{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:5px 8px;\r\n  border-bottom:1px solid #1d1d24;font-size:12px}\r\n.cprow b{color:#fff;font-weight:600}\r\n.cprow .v{color:var(--acc)}\r\n.cpgrid{display:grid;grid-template-columns:1fr 1fr;gap:2px 20px}\r\n.cph{margin:12px 0 5px;color:var(--dim);font-size:10px;letter-spacing:1px}\r\n#cpfps{width:100%;height:64px;background:#0a0a0d;border:1px solid var(--line);border-radius:6px}\r\n.cpmap{display:flex;justify-content:space-between;align-items:center;padding:3px 8px;\r\n  border-bottom:1px solid #1d1d24;font-size:11px}\r\n.cpbarw{display:flex;gap:8px;align-items:center;padding:4px 8px;font-size:11px}\r\n.cpbarw b{width:40px;color:var(--dim)}\r\n.cpbar{flex:1;height:10px;background:#0a0a0d;border-radius:5px;overflow:hidden}\r\n.cpbar i{display:block;height:100%;background:var(--acc);width:0;transition:width .15s}\r\n#ctxmenu{position:fixed;z-index:100;background:#17171c;border:1px solid var(--line);border-radius:8px;\r\n  padding:4px;min-width:180px;display:none;box-shadow:0 10px 34px #000d}\r\n#ctxmenu .ci{padding:6px 12px;border-radius:5px;cursor:pointer;white-space:nowrap;font-size:12px}\r\n#ctxmenu .ci:hover{background:var(--grad);color:#000}\r\n#ctxmenu .ci:hover .kbd{color:#0008}\r\n#ctxmenu .sep{height:1px;background:var(--line);margin:3px 6px}\r\n#ctxmenu .hdr{padding:3px 12px 5px;color:var(--dim);font-size:10px;letter-spacing:.5px}\r\n.cell.padmiss{border-color:#f33!important;box-shadow:0 0 8px #f339}\r\n.warpdot{display:none!important}\r\n#mapwin{position:fixed;top:64px;left:calc(50% - 350px);width:700px;background:var(--panel);\r\n  border:1px solid var(--line);border-radius:10px;z-index:60;display:none;\r\n  flex-direction:column;overflow:hidden;box-shadow:0 18px 60px #000d;\r\n  resize:both;min-width:460px;min-height:320px}\r\n#mapwin,#nodewin,#glslwin,#propwin{resize:both}\r\n#nodewin{min-width:520px;min-height:360px}\r\n#glslwin{min-width:420px;min-height:300px}\r\n#propwin{min-width:300px;min-height:260px}\r\n#mapwin.open{display:flex}\r\n#mapwinbar{display:flex;align-items:center;gap:8px;padding:6px 10px;background:var(--panel2);\r\n  cursor:move;border-bottom:1px solid var(--line);font-size:10px;letter-spacing:.5px;color:var(--dim);\r\n  user-select:none}\r\n#mapwinbar b{color:var(--txt);font-size:12px}\r\n#mapwinbar button{margin-left:auto}\r\n#maptools{display:flex;gap:5px;align-items:center;padding:6px 10px;flex-wrap:wrap;\r\n  border-bottom:1px solid var(--line)}\r\n#maptools .chip{border-radius:12px}\r\n#mapstage{position:relative;background:#000;cursor:crosshair;touch-action:none;\r\n  margin:4px 12px 12px;border:1px solid var(--line)}\r\n#mapprev{display:block;width:100%}\r\n.maph{position:absolute;width:16px;height:16px;border-radius:4px;background:var(--acc2);\r\n  transform:translate(-50%,-50%);cursor:move;box-shadow:0 0 10px var(--acc2);touch-action:none;z-index:3}\r\n#genwin{position:fixed;top:90px;left:calc(50% - 190px);width:380px;background:var(--panel);\r\n  border:1px solid var(--line);border-radius:10px;z-index:62;display:none;flex-direction:column;\r\n  overflow:hidden;box-shadow:0 18px 60px #000d}\r\n#genwin.open{display:flex}\r\n#genwinbar{display:flex;align-items:center;gap:8px;padding:6px 10px;background:var(--panel2);\r\n  cursor:move;border-bottom:1px solid var(--line);font-size:10px;color:var(--dim);user-select:none}\r\n#genwinbar b{color:var(--txt);font-size:12px}\r\n#genwinbar button{margin-left:auto}\r\n#genrows{padding:10px 12px;display:flex;flex-direction:column;gap:7px}\r\n.genrow{display:grid;grid-template-columns:86px 1fr 90px;gap:8px;align-items:center;font-size:11px}\r\n.genrow b{color:var(--dim);font-weight:600;font-size:10px}\r\n.genrow input[type=text]{grid-column:2/4;background:var(--panel2);border:1px solid var(--line);\r\n  border-radius:4px;color:#fff;padding:4px 8px}\r\n#gensave{margin-top:4px;padding:8px;background:var(--grad);color:#000;font-weight:800;\r\n  border:none;border-radius:6px}\r\n#nodewin{position:fixed;top:56px;left:calc(50% - 400px);width:800px;height:540px;background:var(--panel);\r\n  border:1px solid var(--line);border-radius:10px;z-index:64;display:none;\r\n  flex-direction:column;overflow:hidden;box-shadow:0 18px 60px #000d}\r\n#nodewin.open{display:flex}\r\n#nodebar{display:flex;align-items:center;gap:8px;padding:6px 10px;background:var(--panel2);\r\n  cursor:move;border-bottom:1px solid var(--line);font-size:10px;color:var(--dim);user-select:none}\r\n#nodebar b{color:var(--txt);font-size:12px}\r\n#nodebar button{margin-left:auto}\r\n#nodetools{display:flex;gap:6px;align-items:center;padding:6px 10px;border-bottom:1px solid var(--line);flex-wrap:wrap}\r\n#nodetools input[type=text]{background:var(--panel2);border:1px solid var(--line);border-radius:4px;color:#fff;padding:3px 8px;width:130px}\r\n#nodestage{position:relative;flex:1;min-height:300px;background:\r\n  linear-gradient(#ffffff06 1px,transparent 1px),linear-gradient(90deg,#ffffff06 1px,transparent 1px);\r\n  background-size:24px 24px;background-color:#0a0a0d;overflow:hidden}\r\n#nodesvg{position:absolute;inset:0;pointer-events:none}\r\n#nodesvg path{pointer-events:none}\r\n#nodesvg path[data-li]{pointer-events:visibleStroke;cursor:pointer}\r\n.node{position:absolute;width:150px;background:var(--panel2);border:1px solid var(--line);\r\n  border-radius:8px;font-size:10px;z-index:2;user-select:none;\r\n  box-shadow:0 4px 14px #0009;padding-bottom:4px}\r\n.node header{padding:4px 9px;background:#000a;cursor:move;border-radius:8px 8px 0 0;\r\n  color:var(--txt);font-weight:700;margin-bottom:3px;letter-spacing:.3px}\r\n.node.nsalida header{background:var(--grad);color:#000}\r\n.nrow{display:flex;justify-content:space-between;align-items:center;height:18px;\r\n  padding:0 12px;position:relative;font-size:9px}\r\n.nrow .plbl-in{color:var(--dim)}\r\n.nrow .plbl-out{color:var(--dim);margin-left:auto}\r\n.nport{width:14px;height:14px;border-radius:50%;position:absolute;top:50%;\r\n  transform:translateY(-50%);cursor:crosshair;border:2px solid #0a0a0d;\r\n  transition:transform .1s;z-index:3}\r\n.nport:hover{transform:translateY(-50%) scale(1.35);box-shadow:0 0 8px currentColor}\r\n.nport.pin{left:-8px}\r\n.nport.pout{right:-8px}\r\n.nprm{display:grid;grid-template-columns:42px 1fr;gap:5px;align-items:center;\r\n  padding:1px 9px;height:16px}\r\n.nprm span{color:var(--dim);font-size:9px}\r\n.nprm input{width:100%;height:12px}\r\n.nprm input::-webkit-slider-thumb{width:9px;height:9px;margin-top:-3px}\r\n#glslwin{position:fixed;top:70px;left:calc(50% - 290px);width:580px;background:var(--panel);\r\n  border:1px solid var(--line);border-radius:10px;z-index:63;display:none;\r\n  flex-direction:column;overflow:hidden;box-shadow:0 18px 60px #000d}\r\n#glslwin.open{display:flex}\r\n#glslbar{display:flex;align-items:center;gap:8px;padding:6px 10px;background:var(--panel2);\r\n  cursor:move;border-bottom:1px solid var(--line);font-size:10px;color:var(--dim);user-select:none}\r\n#glslbar b{color:var(--txt);font-size:12px}\r\n#glslbar button{margin-left:auto}\r\n#glslbody{padding:10px 12px}\r\n#glslbody input[type=text]{background:var(--panel2);border:1px solid var(--line);border-radius:4px;\r\n  color:#fff;padding:4px 8px}\r\n#glcode{width:100%;height:300px;background:#0a0a0d;color:#cfe8cf;border:1px solid var(--line);\r\n  border-radius:6px;font:12px/1.45 Consolas,monospace;padding:8px;resize:vertical;\r\n  white-space:pre;overflow:auto}\r\n#glerr{display:none;background:#2a0d0d;color:#ff9a9a;border:1px solid #5a2020;border-radius:6px;\r\n  padding:6px 10px;font:11px/1.4 Consolas,monospace;margin-top:6px;max-height:90px;overflow:auto;\r\n  white-space:pre-wrap}\r\n#propwin.docked{position:static;resize:none;flex:none;width:340px;max-height:none;\r\n  box-shadow:none;border-radius:8px;min-height:0}\r\n#propwin.docked #propbar{cursor:default}\r\n#propwin{position:fixed;top:80px;right:16px;width:360px;background:var(--panel);\r\n  border:1px solid var(--line);border-radius:10px;z-index:61;display:none;\r\n  flex-direction:column;overflow:hidden;box-shadow:0 18px 60px #000d;max-height:82vh}\r\n#propwin.open{display:flex}\r\n#propbar{display:flex;align-items:center;gap:8px;padding:6px 10px;background:var(--panel2);\r\n  cursor:move;border-bottom:1px solid var(--line);font-size:10px;color:var(--dim);user-select:none}\r\n#propbar b{color:var(--txt);font-size:12px}\r\n#propbar button{margin-left:auto}\r\n#proptabs{display:flex;gap:2px;padding:6px 10px 0;border-bottom:1px solid var(--line);background:var(--panel2)}\r\n#proptabs button{border-radius:6px 6px 0 0;border-bottom:none;padding:5px 12px;color:var(--dim);font-size:10px;font-weight:700}\r\n#proptabs button.on{background:var(--panel);color:var(--acc)}\r\n#propbody{padding:8px 14px 12px;overflow-y:auto}\r\n.prow2{display:grid;grid-template-columns:92px 1fr;gap:8px;align-items:center;margin:5px 0;font-size:11px}\r\n.prow2 b{color:var(--dim);font-weight:600;font-size:10px}\r\n.prow2 input[type=range]{width:100%}\r\n.prow2 input[type=text],.prow2 input[type=number]{background:var(--panel2);border:1px solid var(--line);\r\n  border-radius:4px;color:#fff;padding:3px 7px;width:100%}\r\n.prow2 select{max-width:100%}\r\n.pnote{color:var(--dim);font-size:11px;padding:14px 4px;line-height:1.5}\r\n.pchips{display:flex;gap:4px;margin:4px 0 8px}\r\n#genpop{position:fixed;z-index:70;background:var(--panel);border:1px solid var(--line);\r\n  border-radius:10px;padding:8px 12px;display:none;box-shadow:0 12px 40px #000d;width:230px}\r\n#genpop .gph{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}\r\n#genpop .gprow{display:flex;gap:8px;align-items:center;font-size:11px;color:var(--dim);margin:6px 0}\r\n#genpop .gprow input[type=range]{flex:1}\r\n#toast{position:fixed;bottom:265px;left:50%;transform:translateX(-50%);background:#000d;\r\n  border:1px solid var(--acc);color:#fff;padding:6px 16px;border-radius:20px;\r\n  opacity:0;transition:opacity .25s;pointer-events:none;z-index:99;font-size:12px}\r\n#dropveil{position:fixed;inset:0;background:#8dff3f14;border:3px dashed var(--acc);\r\n  border-radius:12px;display:none;pointer-events:none;z-index:98}\r\n#relinkBar{display:none;gap:8px;align-items:center;background:#3a2a10;border:1px solid var(--warn);\r\n  color:var(--warn);border-radius:6px;padding:3px 8px}\r\n@media (max-width:1100px){ #genPanel{width:150px} #genShelf{grid-template-columns:1fr} #monPanel{width:250px} }\r\n</style>\r\n\r\n<div id=\"app\">\r\n  <div id=\"menubar\">\r\n    <span id=\"mblogo\">RAVEN<b>VJ</b><span id=\"beatdot\"></span></span>\r\n    <button data-menu=\"archivo\">Archivo</button>\r\n    <button data-menu=\"comp\">Composición</button>\r\n    <button data-menu=\"capas\">Capas</button>\r\n    <button data-menu=\"entrada\">Entrada</button>\r\n    <button data-menu=\"salida\">Salida</button>\r\n    <button data-menu=\"ver\">Ver</button>\r\n    <button data-menu=\"ayuda\">Ayuda</button>\r\n    <a id=\"donateBtn\" href=\"https://cafecito.app/vjravenlight\" target=\"_blank\" rel=\"noopener\"\r\n      title=\"si RAVEN VJ te sirvió, invitame un cafecito ☕\">☕ Donar</a>\r\n  </div>\r\n  <div id=\"topbar\">\r\n    <span class=\"grp\"><label>BPM</label>\r\n      <input id=\"bpmIn\" type=\"number\" min=\"40\" max=\"240\" value=\"120\">\r\n      <button id=\"tapBtn\" data-map=\"tap\">TAP</button>\r\n      <button id=\"halfBtn\" title=\"mitad de tempo\">÷2</button>\r\n      <button id=\"dblBtn\" title=\"doble tempo\">×2</button>\r\n      <button id=\"resyncBtn\" data-map=\"resync\" title=\"re-anclar el compás al golpe (sin cambiar el BPM)\">↻</button>\r\n      <button id=\"syncBtn\" data-map=\"sync\" title=\"detectar BPM automáticamente desde el audio\">SYNC</button></span>\r\n    <span class=\"grp\"><label>AUTO</label>\r\n      <select id=\"autoMode\"><option value=\"off\">OFF</option><option value=\"seq\">SECUENCIA</option>\r\n        <option value=\"rand\">COLUMNA AZAR</option><option value=\"chaos\">CAOS</option>\r\n        <option value=\"scenes\">ESCENAS</option></select>\r\n      <select id=\"autoBeats\"><option>1</option><option>2</option><option selected>4</option>\r\n        <option>8</option><option>16</option><option>32</option></select>\r\n      <label>beats</label></span>\r\n    <span class=\"grp\"><label>FADE</label>\r\n      <input id=\"fadeIn\" type=\"range\" min=\"0\" max=\"5\" step=\"0.05\" value=\"1\" style=\"width:70px\" data-map=\"fade\">\r\n      <label id=\"fadeLbl\">1.0s</label>\r\n      <button id=\"monoBtn\" data-map=\"mono\" title=\"MONO: un solo clip a la vez — cada disparo reemplaza al anterior con transición (liviano para la PC)\">1×</button></span>\r\n    <span class=\"grp\" title=\"escenas: click = disparar · click derecho = guardar snapshot · F1-F8\">\r\n      <label>ESC</label><span id=\"sceneBtns\"></span></span>\r\n    <span class=\"grp\"><button id=\"diceBtn\" data-map=\"dice\" title=\"randomizar parámetros de los efectos\">🎲</button>\r\n      <select id=\"rndSel\" title=\"randomizar FX automáticamente cada N beats\">\r\n        <option value=\"0\">manual</option><option value=\"4\">c/4</option><option value=\"8\">c/8</option>\r\n        <option value=\"16\">c/16</option><option value=\"32\">c/32</option></select></span>\r\n    <span class=\"grp\"><button id=\"recBtn\" title=\"grabar la salida a un video webm\">⏺ REC</button></span>\r\n    <span class=\"grp\"><button id=\"audioBtn\">🎤 AUDIO</button>\r\n      <select id=\"audioDev\" style=\"display:none;max-width:110px\" title=\"entrada de audio\"></select>\r\n      <span class=\"meters\"><i id=\"mB\"></i><i id=\"mM\"></i><i id=\"mH\"></i></span></span>\r\n    <span class=\"grp\"><button id=\"midiBtn\">🎹 MIDI</button><label id=\"midiSt\">–</label><label id=\"midiMon\" style=\"color:var(--acc);min-width:52px\"></label></span>\r\n    <span class=\"grp\"><label>RES</label>\r\n      <select id=\"resSel\"><option value=\"960\">960×540</option>\r\n        <option value=\"1280\" selected>1280×720</option><option value=\"1920\">1920×1080</option></select></span>\r\n    <span class=\"grp\"><button id=\"newBtn\" title=\"set nuevo: empezar de cero (conserva MIDI y tus generadores)\">🆕</button>\r\n      <button id=\"addVidBtn\">＋ VIDEOS</button>\r\n      <button id=\"saveBtn\">💾</button><button id=\"loadBtn\">📂</button></span>\r\n    <span id=\"relinkBar\">⚠ <span id=\"relinkN\"></span> videos sin enlazar\r\n      <button id=\"relinkBtn\">🔗 RELINK</button></span>\r\n    <span class=\"grp\"><button id=\"outBtn\">🖥 OUTPUT</button>\r\n      <button id=\"propsBtn\" title=\"propiedades por clip / capa / composición (o doble click en una celda)\">⚙</button></span>\r\n    <span class=\"grp\"><button id=\"buildBtn\" data-map=\"build\" title=\"MANTENER: sube la intensidad (zoom+strobe+brillo) · SOLTAR: drop con flash · barra espaciadora\">⚡ BUILD</button>\r\n      <button id=\"flashBtn\" data-map=\"flash\">FLASH</button>\r\n      <button id=\"blackBtn\" class=\"danger\" data-map=\"blackout\">BLACKOUT</button>\r\n      <button id=\"panicBtn\" class=\"danger\" data-map=\"panic\" title=\"apagar todo: capas, efectos, autopilot (tecla P)\">PÁNICO</button></span>\r\n    <span class=\"grp\" title=\"crossfader: A = capas 1-2 · B = capas 3-4\"><label>A</label>\r\n      <input id=\"xfadeIn\" type=\"range\" min=\"0\" max=\"1\" step=\"0.01\" value=\"0.5\" style=\"width:86px\" data-map=\"xfade\">\r\n      <label>B</label></span>\r\n    <span class=\"grp\" style=\"flex:1;min-width:120px\"><label>MASTER</label>\r\n      <input id=\"masterIn\" type=\"range\" min=\"0\" max=\"1\" step=\"0.01\" value=\"1\" style=\"flex:1\" data-map=\"master\"></span>\r\n  </div>\r\n\r\n  <div id=\"gridwrap\"><div id=\"grid\"></div></div>\r\n  <div id=\"splitH\" class=\"split\" title=\"arrastrá para cambiar la altura del panel inferior\"></div>\r\n  <div id=\"bottom\">\r\n    <div class=\"panel\" id=\"genPanel\">\r\n      <h3>GENERADORES <small style=\"color:var(--dim)\">arrastrá a una celda</small></h3>\r\n      <div id=\"genShelf\"></div>\r\n    </div>\r\n    <div id=\"splitG\" class=\"split splitv\" title=\"arrastrá para cambiar el ancho\"></div>\r\n    <div class=\"panel\" id=\"fxPanel\">\r\n      <h3>EFECTOS MASTER\r\n        <span id=\"fxHead\">\r\n          <select id=\"fxAdd\"><option value=\"\">＋ agregar efecto…</option></select>\r\n          <button id=\"fxSave\" class=\"mini\" title=\"guardar la cadena actual como preset\">💾</button>\r\n          <select id=\"fxPre\" title=\"cargar preset de efectos\"><option value=\"\">presets…</option></select>\r\n          <label>LFO1</label>\r\n          <select id=\"lfo0w\"><option>sine</option><option>tri</option><option>sqr</option><option>rnd</option></select>\r\n          <select id=\"lfo0r\"><option value=\"0.25\">¼</option><option value=\"0.5\">½</option>\r\n            <option value=\"1\" selected>1</option><option value=\"2\">2</option><option value=\"4\">4</option></select>\r\n          <label>LFO2</label>\r\n          <select id=\"lfo1w\"><option>sine</option><option selected>tri</option><option>sqr</option><option>rnd</option></select>\r\n          <select id=\"lfo1r\"><option value=\"0.25\" selected>¼</option><option value=\"0.5\">½</option>\r\n            <option value=\"1\">1</option><option value=\"2\">2</option><option value=\"4\">4</option></select>\r\n        </span></h3>\r\n      <div id=\"fxList\"></div>\r\n    </div>\r\n    <div id=\"splitM\" class=\"split splitv\" title=\"arrastrá para cambiar el ancho\"></div>\r\n    <div class=\"panel\" id=\"monPanel\">\r\n      <h3>MONITORES <span id=\"fpsLbl\" style=\"margin-left:auto;color:var(--dim)\"></span></h3>\r\n      <div id=\"mons\">\r\n        <div class=\"mon\"><span class=\"mlabel\">PREVIA (click der.)</span>\r\n          <canvas id=\"prev2d\" width=\"320\" height=\"180\"></canvas>\r\n          <canvas id=\"prevgl\" width=\"320\" height=\"180\" style=\"display:none\"></canvas></div>\r\n        <div class=\"mon\"><span class=\"mlabel\">SALIDA · <span id=\"nowName\" style=\"color:var(--acc)\"></span></span>\r\n          <canvas id=\"outCanvas\" width=\"1280\" height=\"720\"></canvas></div>\r\n        <div id=\"xyWrap\">\r\n          <div id=\"xypad\"><div id=\"xydot\" style=\"left:50%;top:50%\"></div></div>\r\n          <div id=\"xyside\">\r\n            <button data-map=\"x\">MIDI X</button>\r\n            <button data-map=\"y\">MIDI Y</button>\r\n            <label style=\"font-size:9px;color:var(--dim)\">PAD XY<br>→ mod X/Y</label>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n  <div id=\"hint\">click = disparar · <b>click derecho = menú</b> · <b>ESPACIO = BUILD/DROP</b> · Ctrl+Alt+T = panel · arrastrá MP4s · 1-9,0 = columnas · F1-F8 = escenas · T = tap · B = blackout · F = flash · P = pánico · MIDI learn: 🎹 + control + pad</div>\r\n</div>\r\n<div id=\"toast\"></div>\r\n<div id=\"dropveil\"></div>\r\n<div id=\"clock\" title=\"hora local — click: mostrar/ocultar fecha\" data-noi18n>--:--</div>\r\n<input type=\"file\" id=\"fileIn\" accept=\"video/*,image/gif\" multiple style=\"display:none\">\r\n<input type=\"file\" id=\"setIn\" accept=\".json,application/json\" style=\"display:none\">\r\n<input type=\"file\" id=\"relinkIn\" accept=\"video/*,image/gif\" multiple style=\"display:none\">\r\n\r\n<script>\r\n'use strict';\r\n/* ================================================================\r\n   RAVEN VJ — mixer de video para VJing en vivo, portable, en un HTML.\r\n   4 capas × N columnas · MP4 + generadores GLSL · efectos master ·\r\n   audio-reactivo · LFO/autopilot · MIDI learn (nanoPAD2) · output\r\n   fullscreen en monitor extendido · set en JSON.\r\n   ================================================================ */\r\n\r\nconst $ = s => document.querySelector(s);\r\nconst clamp01 = v => Math.min(1, Math.max(0, v));\r\n/* errores visibles: que nada falle en silencio durante un set */\r\nwindow.addEventListener('error', e => {\r\n  console.error(e.error || e.message);\r\n  try { toast('⚠ Error: ' + (e.message || '').slice(0, 80)); } catch (x) { }\r\n});\r\nwindow.addEventListener('unhandledrejection', e => {\r\n  console.error(e.reason);\r\n  try { toast('⚠ Error: ' + String(e.reason && e.reason.message || e.reason).slice(0, 80)); } catch (x) { }\r\n});\r\nconst LAYERS = 4;\r\nlet COLS = 8;\r\n\r\n/* ---------------- estado global ---------------- */\r\nconst state = {\r\n  bpm: 120, fade: 1.0, master: 1, blackout: false, flash: 0,\r\n  auto: { mode: 'off', beats: 4, count: 0, lastCol: -1, lastScene: -1 },\r\n  lfo: [{ wave: 'sine', rate: 1, _v: 0 }, { wave: 'tri', rate: 0.25, _v: 0 }],\r\n  xy: { x: .5, y: .5 },\r\n  layers: [], grid: [], effects: [], mappings: {},\r\n  preview: null, res: [1280, 720],\r\n  scenes: new Array(8).fill(null), rndBeats: 0, xfade: .5,\r\n  beatSens: 1.32, fpsCap: 0, build: 0, building: false,\r\n  setlist: { steps: [], running: false, idx: 0, t0: 0 },\r\n  nanoDefaults: true,\r\n  map: {\r\n    on: false, sel: 0,\r\n    surfaces: [{ pts: [[0, 0], [1, 0], [1, 1], [0, 1]], src: [0, 0, 1, 1], on: true, _m: null }],\r\n  },\r\n  fxPresets: {}, mono: true, outScreen: -1, theme: 'fenix',\r\n  customGens: [], gSpeed: 1,\r\n  decks: null, deckIdx: 0,\r\n};\r\nconst DECK_NAMES = ['A', 'B', 'C', 'D'];\r\n/* temas de interfaz — Fénix por defecto, cambiable en panel → Render → Apariencia */\r\nconst THEMES = {\r\n  fenix: {\r\n    label: '🔥 Fénix',\r\n    vars: { bg: '#0d0705', panel: '#160e08', panel2: '#1e130b', line: '#3a2416', txt: '#f0e4d8', dim: '#9a7d64', acc: '#ff7a1a', acc2: '#ff3d54', warn: '#ffd23f' },\r\n    grad: 'linear-gradient(135deg,#ff2d00,#ff8a00 55%,#ffd000)',\r\n  },\r\n  resolume: {\r\n    label: '🟢 Clásico (verde)',\r\n    vars: { bg: '#0c0c0e', panel: '#141418', panel2: '#1b1b21', line: '#26262e', txt: '#d8d8de', dim: '#77777f', acc: '#8dff3f', acc2: '#ff3fd4', warn: '#ffb03f' },\r\n    grad: 'linear-gradient(135deg,#8dff3f,#3fffc4)',\r\n  },\r\n  violeta: {\r\n    label: '🔮 Violeta psy',\r\n    vars: { bg: '#0a0712', panel: '#120c1e', panel2: '#181028', line: '#2c2044', txt: '#e6def2', dim: '#8a7ba6', acc: '#b46bff', acc2: '#ff3fd4', warn: '#ffd23f' },\r\n    grad: 'linear-gradient(135deg,#7b2dff,#ff3fd4)',\r\n  },\r\n  cyber: {\r\n    label: '⚡ Cian cyber',\r\n    vars: { bg: '#050b0e', panel: '#0b1418', panel2: '#102028', line: '#1c3340', txt: '#d8ecf2', dim: '#6f95a6', acc: '#2fd8ff', acc2: '#ff3fd4', warn: '#ffd23f' },\r\n    grad: 'linear-gradient(135deg,#00c2ff,#00ffb3)',\r\n  },\r\n};\r\nfunction applyTheme(name) {\r\n  const th = THEMES[name] || THEMES.fenix;\r\n  state.theme = THEMES[name] ? name : 'fenix';\r\n  const rs = document.documentElement.style;\r\n  for (const [k, v] of Object.entries(th.vars)) rs.setProperty('--' + k, v);\r\n  rs.setProperty('--grad', th.grad);\r\n}\r\nconst WARP_ID = new Float32Array([1, 0, 0, 0, 1, 0, 0, 0, 1]);\r\nfunction newSurface() {\r\n  return { pts: [[0, 0], [1, 0], [1, 1], [0, 1]], src: [0, 0, 1, 1], on: true, _m: null };\r\n}\r\n/* homografía: cuadrado unitario → 4 esquinas, invertida para el shader */\r\nfunction computeWarp(sf) {\r\n  const [p0, p1, p2, p3] = sf.pts;\r\n  const px = p0[0] - p1[0] + p2[0] - p3[0];\r\n  const py = p0[1] - p1[1] + p2[1] - p3[1];\r\n  let a, b, c, d, e, f, g, h, i;\r\n  if (Math.abs(px) < 1e-9 && Math.abs(py) < 1e-9) {\r\n    a = p1[0] - p0[0]; b = p3[0] - p0[0]; c = p0[0];\r\n    d = p1[1] - p0[1]; e = p3[1] - p0[1]; f = p0[1];\r\n    g = 0; h = 0; i = 1;\r\n  } else {\r\n    const dx1 = p1[0] - p2[0], dx2 = p3[0] - p2[0];\r\n    const dy1 = p1[1] - p2[1], dy2 = p3[1] - p2[1];\r\n    const det = dx1 * dy2 - dx2 * dy1;\r\n    g = (px * dy2 - py * dx2) / det;\r\n    h = (dx1 * py - dy1 * px) / det;\r\n    a = p1[0] - p0[0] + g * p1[0]; b = p3[0] - p0[0] + h * p3[0]; c = p0[0];\r\n    d = p1[1] - p0[1] + g * p1[1]; e = p3[1] - p0[1] + h * p3[1]; f = p0[1];\r\n    i = 1;\r\n  }\r\n  // adjugada (inversa homogénea), column-major para GL\r\n  const A = e * i - f * h, B = c * h - b * i, C = b * f - c * e;\r\n  const D = f * g - d * i, E = a * i - c * g, F = c * d - a * f;\r\n  const G = d * h - e * g, H2 = b * g - a * h, I = a * e - b * d;\r\n  sf._m = new Float32Array([A, D, G, B, E, H2, C, F, I]);\r\n}\r\nfunction computeAllWarps() { state.map.surfaces.forEach(computeWarp); }\r\nconst telemetry = {\r\n  frames: new Float32Array(120), fi: 0, dropped: 0,\r\n  startT: performance.now(), beats: 0, midiCount: 0, midiLog: [],\r\n};\r\nlet fxUid = 1;\r\nfor (let l = 0; l < LAYERS; l++) {\r\n  state.layers.push({\r\n    opacity: 1, mode: 0, opMod: 'off', target: 0, pos: 0, speed: 1, genT: 0,\r\n    auto: { mode: 'off', n: 8, rand: false, dip: false, _count: 0, _t: 0, _lastVT: 0 },\r\n    fx: { id: 'none', p1: .5, p2: .5 },\r\n    slots: [newSlot(), newSlot()],\r\n  });\r\n  state.grid.push([]);\r\n  for (let c = 0; c < COLS; c++) state.grid[l].push(newCell(l, c, 0));\r\n}\r\nstate.decks = [state.grid, mkDeck(1), mkDeck(2), mkDeck(3)];\r\nfunction newSlot() { return { kind: 'empty', cell: null, video: null, tex: null, tgt: null, fit: [1, 1] }; }\r\nfunction newCell(l, c, dk) {\r\n  return { l, c, dk: dk || 0, kind: 'empty', name: '', presetIdx: -1, file: null, url: null, video: null, thumb: '' };\r\n}\r\nfunction mkDeck(dk) {\r\n  const g = [];\r\n  for (let l = 0; l < LAYERS; l++) {\r\n    g.push([]);\r\n    for (let c = 0; c < COLS; c++) g[l].push(newCell(l, c, dk));\r\n  }\r\n  return g;\r\n}\r\nfunction ensureDeckSize(g, dk) {\r\n  for (let l = 0; l < LAYERS; l++)\r\n    while (g[l].length < COLS) g[l].push(newCell(l, g[l].length, dk));\r\n}\r\nfunction switchDeck(i) {\r\n  if (!state.decks || !state.decks[i]) return;\r\n  state.deckIdx = i;\r\n  state.grid = state.decks[i];\r\n  ensureDeckSize(state.grid, i);\r\n  buildGrid();\r\n  updateDeckBtns();\r\n  markDirty();\r\n}\r\nfunction updateDeckBtns() {\r\n  document.querySelectorAll('.deckbtn').forEach((b, i) => {\r\n    const has = state.decks && state.decks[i] &&\r\n      state.decks[i].some(row => row.some(c => c.kind !== 'empty'));\r\n    b.classList.toggle('on', i === state.deckIdx);\r\n    b.classList.toggle('has', !!has);\r\n  });\r\n}\r\n\r\n/* ---------------- shaders: preludios ---------------- */\r\nconst VS = `#version 300 es\r\nout vec2 v_uv;\r\nvoid main(){vec2 p=vec2(float((gl_VertexID<<1)&2),float(gl_VertexID&2));\r\nv_uv=p;gl_Position=vec4(p*2.-1.,0.,1.);}`;\r\n\r\nconst HELP = `\r\nfloat hash(vec2 p){p=fract(p*vec2(123.34,456.21));p+=dot(p,p+45.32);return fract(p.x*p.y);}\r\nfloat noise(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);\r\n return mix(mix(hash(i),hash(i+vec2(1.,0.)),f.x),mix(hash(i+vec2(0.,1.)),hash(i+vec2(1.,1.)),f.x),f.y);}\r\nfloat fbm(vec2 p){float v=0.,a=.5;for(int i=0;i<5;i++){v+=a*noise(p);p*=2.03;a*=.5;}return v;}\r\nvec3 hsv2rgb(vec3 c){vec4 K=vec4(1.,2./3.,1./3.,3.);\r\n vec3 p=abs(fract(c.xxx+K.xyz)*6.-K.www);return c.z*mix(K.xxx,clamp(p-K.xxx,0.,1.),c.y);}\r\nmat2 rot2(float a){float c=cos(a),s=sin(a);return mat2(c,-s,s,c);}\r\n#define AR (u_res.x/u_res.y)\r\n`;\r\n\r\nconst GEN_PRE_RAW = `#version 300 es\r\nprecision highp float;\r\nin vec2 v_uv; out vec4 o;\r\nuniform vec2 u_res; uniform float u_time,u_bass,u_mid,u_high,u_beat,u_p1,u_p2;\r\nuniform float u_fft[16];\r\n`;\r\nconst GEN_PRE = GEN_PRE_RAW + HELP;\r\n/* compatibilidad Shadertoy: iTime/iResolution/iMouse/mainImage, canales en negro */\r\nconst SHADERTOY_PRE = `\r\n#define iTime u_time\r\n#define iTimeDelta (1./60.)\r\n#define iFrame int(u_time*60.)\r\n#define iResolution vec3(u_res,1.)\r\n#define iMouse vec4(u_p1*u_res.x,u_p2*u_res.y,0.,0.)\r\n#define iDate vec4(2026.,7.,11.,u_time)\r\n#define iSampleRate 44100.\r\nuniform sampler2D iChannel0; uniform sampler2D iChannel1;\r\nuniform sampler2D iChannel2; uniform sampler2D iChannel3;\r\n`;\r\nfunction wrapGLSL(code) {\r\n  let body = String(code || '')\r\n    .replace(/^\\s*#version[^\\n]*\\n/m, '')\r\n    .replace(/precision\\s+(high|medium|low)p\\s+float\\s*;/g, '');\r\n  if (/mainImage\\s*\\(/.test(body)) {\r\n    return SHADERTOY_PRE + body +\r\n      '\\nvoid main(){ vec4 _c=vec4(0.,0.,0.,1.); mainImage(_c, v_uv*u_res); o=vec4(_c.rgb,1.); }';\r\n  }\r\n  if (/gl_FragColor/.test(body)) body = '#define gl_FragColor o\\n' + body;\r\n  return body;\r\n}\r\n\r\nconst FX_PRE = `#version 300 es\r\nprecision highp float;\r\nin vec2 v_uv; out vec4 o;\r\nuniform sampler2D u_tex; uniform sampler2D u_prev;\r\nuniform vec2 u_res; uniform float u_time,u_bass,u_mid,u_high,u_beat,u_bpm,u_p1,u_p2;\r\n` + HELP;\r\n\r\n/* ---------------- presets generativos ---------------- */\r\nconst PRESETS = [\r\n{ name: 'Plasma', icon: '🌈', fs: `void main(){\r\n vec2 p=v_uv*vec2(AR,1.)*3.; float t=u_time*.6;\r\n float v=sin(p.x+t)+sin(p.y+t*1.3)+sin(p.x+p.y+t)+sin(length(p-1.5)*1.5-t*2.);\r\n o=vec4(hsv2rgb(vec3(v*.12+t*.05+u_p1,.85,.5+u_bass*.5)),1.);}` },\r\n{ name: 'Túnel', icon: '🕳️', fs: `void main(){\r\n vec2 p=(v_uv-.5)*vec2(AR,1.); float r=length(p)+1e-3; float a=atan(p.y,p.x);\r\n float z=u_time*(1.+u_p1*3.)*.8+1./r;\r\n float v=smoothstep(-.2,.8,sin(z*6.)*sin(a*8.+u_time))*min(r*2.5,1.)+u_beat*.5*(1.-min(r,1.));\r\n o=vec4(hsv2rgb(vec3(z*.05+u_p2,.75,clamp(v,0.,1.)))*smoothstep(0.,.12,r),1.);}` },\r\n{ name: 'Anillos', icon: '🎯', fs: `void main(){\r\n vec2 p=(v_uv-.5)*vec2(AR,1.); float r=length(p);\r\n float w=fract(r*mix(3.,12.,u_p1)-u_time*(1.+u_bass*2.));\r\n float ring=smoothstep(.5,.42,abs(w-.5));\r\n o=vec4(hsv2rgb(vec3(r-u_time*.1+u_p2,.85,ring*(.35+u_bass*.9))),1.);}` },\r\n{ name: 'Estrellas', icon: '✨', fs: `void main(){\r\n vec3 col=vec3(0.); vec2 p=(v_uv-.5)*vec2(AR,1.); float t=u_time*(.5+u_p1*2.);\r\n for(int i=0;i<3;i++){ float fi=float(i); float z=fract(t*.3+fi*.333);\r\n  vec2 q=p*mix(5.,.3,z); vec2 g=floor(q*8.),f=fract(q*8.)-.5; float h=hash(g+fi*13.);\r\n  vec2 off=(vec2(hash(g+1.7),hash(g+2.3))-.5)*.6;\r\n  col+=smoothstep(.18*h+.02,0.,length(f-off))*z*(.5+u_high)*hsv2rgb(vec3(h+u_p2,.4,1.)); }\r\n o=vec4(col,1.);}` },\r\n{ name: 'Fractal', icon: '❄️', fs: `void main(){\r\n vec2 p=(v_uv-.5)*vec2(AR,1.)*1.6; p*=rot2(u_time*.1); float acc=0.;\r\n for(int i=0;i<8;i++){ p=abs(p)/max(dot(p,p),1e-4)-vec2(.8+u_p1*.6,.6+u_p2*.4);\r\n  acc+=length(p)*exp(-float(i)*.3); }\r\n o=vec4(hsv2rgb(vec3(acc*.1+u_time*.03,.7,clamp(acc*.18*(.5+u_bass),0.,1.))),1.);}` },\r\n{ name: 'Ondas', icon: '🌊', fs: `void main(){\r\n vec3 col=vec3(0.);\r\n for(int i=0;i<5;i++){ float fi=float(i);\r\n  float y=.5+.28*sin(v_uv.x*(3.+fi*2.+u_p1*6.)+u_time*(1.+fi*.3))*(.35+u_bass);\r\n  col+=hsv2rgb(vec3(fi*.15+u_p2+u_time*.02,.85,1.))*smoothstep(.025+u_mid*.03,0.,abs(v_uv.y-y)); }\r\n o=vec4(col,1.);}` },\r\n{ name: 'Retro Grid', icon: '🌇', fs: `void main(){\r\n vec2 p=v_uv-.5; vec3 col=vec3(.02,0.,.05);\r\n if(p.y<-.02){ float z=1./(-p.y); vec2 g=vec2(p.x*z*2.,z*1.5-u_time*(2.+u_p1*6.));\r\n  vec2 f=abs(fract(g)-.5); float line=smoothstep(.44,.5,max(f.x,f.y));\r\n  col=mix(col,hsv2rgb(vec3(.83+u_p2*.3,.9,1.)),line*(.4+u_bass))*clamp(-p.y*4.,0.,1.); }\r\n else { float d=length((p-vec2(0.,.16))*vec2(1.,1.2));\r\n  float sun=smoothstep(.23,.22,d)*step(.3,fract((p.y-.16)*24.+u_time));\r\n  col+=hsv2rgb(vec3(.05+u_p2*.1,.95,1.))*sun*(1.+u_beat); }\r\n o=vec4(col,1.);}` },\r\n{ name: 'Partículas', icon: '🎆', fs: `void main(){\r\n vec3 col=vec3(0.);\r\n for(int i=0;i<28;i++){ float fi=float(i);\r\n  float x=hash(vec2(fi,1.)); float sp=.06+hash(vec2(fi,2.))*.3*(1.+u_p1*3.);\r\n  vec2 pp=vec2(fract(x+sin(u_time*.4+fi)*.04),1.-fract(hash(vec2(fi,3.))+u_time*sp));\r\n  float d=length((v_uv-pp)*vec2(AR,1.));\r\n  col+=hsv2rgb(vec3(hash(vec2(fi,4.))*.4+u_p2,.75,1.))*smoothstep(.028*(1.+u_bass),0.,d)*(.5+u_bass); }\r\n o=vec4(col,1.);}` },\r\n{ name: 'Humo', icon: '💨', fs: `void main(){\r\n vec2 p=v_uv*vec2(AR,1.)*3.;\r\n float n=fbm(p+vec2(0.,-u_time*(.4+u_p1)));\r\n n=fbm(p*1.5+n*2.+vec2(u_time*.2,0.));\r\n o=vec4(hsv2rgb(vec3(u_p2+n*.25+u_time*.02,.55,n*(.6+u_mid*.8))),1.);}` },\r\n{ name: 'Espectro', icon: '📊', fs: `void main(){\r\n float bi=floor(v_uv.x*16.); float v=u_fft[int(bi)];\r\n float y=abs(v_uv.y-.5)*2.;\r\n float bar=step(y,v)*step(.08,fract(v_uv.x*16.))*step(fract(v_uv.x*16.),.92);\r\n vec3 c=hsv2rgb(vec3(bi/16.*.7+u_p2,.85,1.))*bar;\r\n c+=hsv2rgb(vec3(bi/16.*.7+u_p2,.9,.35))*smoothstep(v+.15,v,y)*(1.-bar)*u_p1;\r\n o=vec4(c*(.6+u_bass*.6),1.);}` },\r\n{ name: 'Espiral', icon: '🌀', fs: `void main(){\r\n vec2 p=(v_uv-.5)*vec2(AR,1.); float r=length(p),a=atan(p.y,p.x);\r\n float v=sin(log(r+1e-3)*(6.+u_p1*10.)+a*floor(1.+u_p2*5.)-u_time*3.);\r\n o=vec4(hsv2rgb(vec3(u_time*.05+r*.5,.75,smoothstep(0.,.8,v)*(.45+u_bass))),1.);}` },\r\n{ name: 'Láser', icon: '🔦', fs: `void main(){\r\n vec3 col=vec3(0.); vec2 p=(v_uv-.5)*vec2(AR,1.);\r\n for(int i=0;i<6;i++){ float fi=float(i);\r\n  float a=sin(u_time*(.7+fi*.13)+fi*2.1)*1.1+(u_p1-.5)*2.+1.5708;\r\n  vec2 dir=vec2(cos(a),sin(a));\r\n  float d=abs(dot(p-vec2(0.,-.45),vec2(-dir.y,dir.x)));\r\n  col+=hsv2rgb(vec3(fi*.17+u_p2,.95,1.))*(.0025+u_beat*.004)/max(d,1e-4)*.45; }\r\n o=vec4(clamp(col*(.5+u_high),0.,1.5),1.);}` },\r\n{ name: 'VHS Noise', icon: '📼', fs: `void main(){\r\n float n=hash(floor(v_uv*vec2(300.,220.))+floor(u_time*60.)*.37);\r\n float sl=step(.5,fract(v_uv.y*110.+u_time*8.))*.18;\r\n float band=smoothstep(.08,0.,abs(fract(v_uv.y+u_time*.13)-.5))*.4;\r\n vec3 c=mix(vec3(n),hsv2rgb(vec3(u_p2,.6,n)),.5)*(.25+u_p1*.75)+band;\r\n o=vec4(c-sl,1.);}` },\r\n{ name: 'Voronoi', icon: '🔮', fs: `void main(){\r\n vec2 p=v_uv*vec2(AR,1.)*mix(4.,10.,u_p1);\r\n vec2 g=floor(p),f=fract(p);\r\n float md=8.; vec2 mo=vec2(0.);\r\n for(int y=-1;y<=1;y++)for(int x=-1;x<=1;x++){\r\n  vec2 ofs=vec2(float(x),float(y));\r\n  vec2 r=ofs+vec2(hash(g+ofs),hash(g+ofs+7.))*.7+.15*sin(u_time+6.28*hash(g+ofs))-f;\r\n  float d=dot(r,r); if(d<md){md=d;mo=g+ofs;} }\r\n vec3 c=hsv2rgb(vec3(hash(mo)*.5+u_p2+u_time*.02,.7,(.3+u_bass)*smoothstep(1.,0.,md*1.6)));\r\n c+=vec3(1.)*smoothstep(.02,.0,md)*(.3+u_high);\r\n o=vec4(c,1.);}` },\r\n{ name: 'Degradé', icon: '🌅', fs: `void main(){\r\n float t=u_time*.1;\r\n vec3 c1=hsv2rgb(vec3(t+u_p1,.85,.55+u_bass*.45));\r\n vec3 c2=hsv2rgb(vec3(t+u_p1+.35+u_p2*.3,.8,.45+u_mid*.4));\r\n float m=(v_uv.x-.5)*cos(t*2.)+(v_uv.y-.5)*sin(t*1.7)+.5;\r\n o=vec4(mix(c1,c2,smoothstep(.15,.85,m)),1.);}` },\r\n{ name: 'Moiré', icon: '🫧', fs: `void main(){\r\n vec2 p=(v_uv-.5)*vec2(AR,1.);\r\n float d1=length(p-vec2(sin(u_time*.7)*.3,0.));\r\n float d2=length(p+vec2(sin(u_time*.9+1.)*.3,0.));\r\n float v=sin(d1*mix(40.,140.,u_p1))*sin(d2*mix(40.,140.,u_p1));\r\n o=vec4(hsv2rgb(vec3(u_p2+v*.1+u_time*.03,.7,smoothstep(-.2,1.,v)*(.35+u_mid))),1.);}` },\r\n{ name: 'Mandala', icon: '🕉️', fs: `void main(){\r\n vec2 p=(v_uv-.5)*vec2(AR,1.)*2.4; p*=rot2(u_time*.06);\r\n float r=length(p), a=atan(p.y,p.x);\r\n float n=floor(6.+u_p1*10.);\r\n a=mod(a,6.2832/n); a=abs(a-3.1416/n);\r\n vec2 q=vec2(cos(a),sin(a))*r;\r\n float v=smoothstep(.02,.0,abs(sin(r*12.-u_time*2.)*.08-q.y));\r\n v+=smoothstep(.25,.0,abs(fract(r*4.-u_time*.3)-.5))*.35;\r\n v+=smoothstep(.05,.0,abs(q.y-sin(q.x*8.+u_time)*.12*(1.-r*.4)))*(.5+u_bass);\r\n vec3 c=hsv2rgb(vec3(r*.4-u_time*.04+u_p2,.85,clamp(v,0.,1.)*(.5+u_beat*.6)));\r\n o=vec4(c*smoothstep(1.5,.9,r),1.);}` },\r\n{ name: 'Zoom Fractal', icon: '🌀', fs: `void main(){\r\n vec2 p=(v_uv-.5)*vec2(AR,1.);\r\n float z=pow(2.,fract(u_time*(.08+u_p1*.15))*3.);\r\n p*=z*.8; p*=rot2(u_time*.13);\r\n float acc=0.; vec2 q=p;\r\n for(int i=0;i<9;i++){ q=abs(q)/clamp(dot(q,q),.15,1.)-vec2(1.1,.9+u_p2*.3);\r\n  acc+=exp(-length(q)*2.); }\r\n o=vec4(hsv2rgb(vec3(acc*.13+u_time*.05,.9,clamp(acc*.35*(.5+u_bass),0.,1.))),1.);}` },\r\n{ name: 'Psy Túnel', icon: '🔯', fs: `void main(){\r\n vec2 p=(v_uv-.5)*vec2(AR,1.); float r=length(p)+1e-3; float a=atan(p.y,p.x);\r\n float am=mod(a+u_time*.25,1.0472)-.5236;\r\n float hex=cos(am)*r;\r\n float z=1./hex+u_time*(2.+u_p1*7.);\r\n float ring=step(.5,fract(z*.5));\r\n float spokes=step(.5,fract((a+u_time*.1)*1.9099));\r\n float v=abs(ring-spokes*.55);\r\n vec3 c=hsv2rgb(vec3(fract(z*.03+u_p2),1.,v*(.35+u_bass*.9)));\r\n o=vec4(c*smoothstep(0.,.2,r),1.);}` },\r\n{ name: 'Flor de Vida', icon: '🌸', fs: `\r\nfloat ringf(vec2 p, vec2 c){ return smoothstep(.022,.008,abs(length(p-c)-.5)); }\r\nvoid main(){\r\n vec2 p=(v_uv-.5)*vec2(AR,1.)*mix(1.6,3.2,u_p1); p*=rot2(u_time*.04);\r\n float v=ringf(p,vec2(0.));\r\n for(int i=0;i<6;i++){ float a=float(i)*1.0472+u_time*.02;\r\n  v+=ringf(p,.5*vec2(cos(a),sin(a))); }\r\n for(int i=0;i<6;i++){ float a=float(i)*1.0472+.5236+u_time*.02;\r\n  v+=ringf(p,.866*vec2(cos(a),sin(a))); }\r\n for(int i=0;i<6;i++){ float a=float(i)*1.0472+u_time*.02;\r\n  v+=ringf(p,vec2(cos(a),sin(a))); }\r\n vec3 c=hsv2rgb(vec3(length(p)*.25-u_time*.05+u_p2,.8,clamp(v,0.,1.2)*(.45+u_bass*.8)));\r\n o=vec4(c,1.);}` },\r\n{ name: 'Partículas 3D', icon: '🌌', fs: `void main(){\r\n vec3 col=vec3(0.); vec2 uv=(v_uv-.5)*vec2(AR,1.);\r\n float t=u_time*(.3+u_p1*1.4);\r\n for(int i=0;i<54;i++){ float fi=float(i);\r\n  float zf=fract(hash(vec2(fi,3.))+t*(.12+hash(vec2(fi,4.))*.18));\r\n  vec3 pp=vec3((hash(vec2(fi,1.))*2.-1.)*1.2,(hash(vec2(fi,2.))*2.-1.)*.8,zf);\r\n  vec2 sp=(pp.xy*rot2(u_time*.15))/(pp.z*2.2+.12)*.5;\r\n  float d=length(uv-sp);\r\n  float r=mix(.09,.008,zf);\r\n  vec3 pc=hsv2rgb(vec3(hash(vec2(fi,5.))*.4+u_p2+zf*.3,.85,1.));\r\n  col+=pc*smoothstep(r,0.,d)*(1.-zf*.8)*(.9+u_bass);\r\n  col+=pc*exp(-d*24.)*.12*(1.-zf); }\r\n o=vec4(clamp(col,0.,1.4),1.);}` },\r\n{ name: 'Hipnosis', icon: '😵‍💫', fs: `void main(){\r\n vec2 p=(v_uv-.5)*vec2(AR,1.);\r\n float r=length(p);\r\n float w=sin(atan(p.y,p.x)*floor(3.+u_p2*9.)+u_time*2.)*.06*(1.+u_bass);\r\n float v=step(.5,fract((r+w)*mix(6.,18.,u_p1)-u_time*1.2));\r\n vec3 c1=hsv2rgb(vec3(fract(u_time*.03),1.,1.));\r\n o=vec4(mix(vec3(0.),c1,v)*(.55+u_beat*.6),1.);}` },\r\n{ name: 'Metaballs', icon: '🫠', fs: `void main(){\r\n vec2 p=(v_uv-.5)*vec2(AR,1.)*2.;\r\n float f=0.;\r\n for(int i=0;i<6;i++){ float fi=float(i);\r\n  vec2 c=vec2(sin(u_time*(.5+fi*.13)+fi*2.1),cos(u_time*(.4+fi*.11)+fi*1.7))*.7;\r\n  f+=.05/max(dot(p-c,p-c),1e-4); }\r\n float th=mix(1.5,.6,u_p1);\r\n float m=smoothstep(th,th+.12,f);\r\n o=vec4(hsv2rgb(vec3(fract(f*.06+u_time*.04+u_p2),.85,m*(.55+u_bass*.6))),1.);}` },\r\n{ name: 'Aurora', icon: '🌌', fs: `void main(){\r\n vec2 p=v_uv*vec2(AR,1.);\r\n float n=fbm(vec2(p.x*2.5,u_time*.15))*1.2;\r\n float b1=smoothstep(.45,.0,abs(p.y-.35-n*.4));\r\n float n2=fbm(vec2(p.x*4.+7.,u_time*.2));\r\n float b2=smoothstep(.35,.0,abs(p.y-.62-n2*.3));\r\n vec3 c=hsv2rgb(vec3(fract(.35+u_p2*.3+n*.15),.8,b1*(.7+u_bass*.6)))\r\n      +hsv2rgb(vec3(fract(.55+u_p2*.3),.7,b2*.55));\r\n o=vec4(c,1.);}` },\r\n{ name: 'Fuego vivo', icon: '🔥', fs: `void main(){\r\n vec2 p=v_uv*vec2(AR*2.5,2.5);\r\n float n=fbm(p+vec2(0.,-u_time*(1.2+u_p1*2.)));\r\n float f=clamp(n*1.6-v_uv.y*1.4+.35+u_bass*.35+u_p2*.2,0.,1.);\r\n o=vec4(pow(f,.6),pow(f,1.8)*.8,pow(f,5.),1.);}` },\r\n{ name: 'Matrix', icon: '🟩', fs: `void main(){\r\n vec2 g=vec2(floor(v_uv.x*40.*AR),0.);\r\n float sp=.2+hash(g)*1.2*(1.+u_p1*2.);\r\n float y=fract(v_uv.y+u_time*sp*.3+hash(g+5.));\r\n float ch=step(.4,hash(vec2(g.x,floor(v_uv.y*32.)+floor(u_time*(6.+hash(g)*8.)))));\r\n float trail=pow(y,3.);\r\n vec3 base=hsv2rgb(vec3(fract(.33+u_p2),.9,1.));\r\n o=vec4(base*ch*trail*(.6+u_high*.6)+vec3(1.)*step(.97,y)*ch*.9,1.);}` },\r\n{ name: 'Rayos', icon: '⚡', fs: `void main(){\r\n vec2 p=(v_uv-.5)*vec2(AR,1.);\r\n vec3 col=vec3(0.);\r\n for(int i=0;i<3;i++){ float fi=float(i);\r\n  float x=p.x+(fbm(vec2(p.y*3.+fi*7.,u_time*(2.+fi)))-.5)*.8*(.4+u_p1);\r\n  float d=abs(x-(fi-1.)*.4);\r\n  col+=hsv2rgb(vec3(fract(.6+u_p2*.3+fi*.05),.6,1.))*(.004+u_beat*.012)/max(d,1e-3); }\r\n o=vec4(clamp(col*(.5+u_bass),0.,1.5),1.);}` },\r\n{ name: 'Sonar', icon: '🛰️', fs: `void main(){\r\n vec2 p=(v_uv-.5)*vec2(AR,1.);\r\n vec3 col=vec3(0.);\r\n for(int i=0;i<4;i++){ float fi=float(i);\r\n  float ph=u_time*(.25+u_p1*.4)+fi*.25;\r\n  float t=fract(ph);\r\n  vec2 c=(vec2(hash(vec2(fi,floor(ph))),hash(vec2(fi+9.,floor(ph))))-.5)*1.2;\r\n  float d=abs(length(p-c)-t*1.2);\r\n  col+=hsv2rgb(vec3(fract(fi*.2+u_p2),.8,1.))*smoothstep(.05,.005,d)*(1.-t); }\r\n o=vec4(col*(.6+u_beat*.6),1.);}` },\r\n{ name: 'Damero', icon: '🏁', fs: `void main(){\r\n vec2 p=(v_uv-.5)*vec2(AR,1.)*mix(3.,9.,u_p1);\r\n p*=rot2(u_time*.15+length(p)*.3*sin(u_time*.3));\r\n float ch=mod(floor(p.x)+floor(p.y),2.);\r\n vec3 a=hsv2rgb(vec3(fract(u_p2+u_time*.03),.85,.9));\r\n o=vec4(mix(vec3(.02),a,ch)*(.5+u_bass*.7),1.);}` },\r\n{ name: 'Cintas', icon: '🎗️', fs: `void main(){\r\n vec3 col=vec3(0.);\r\n for(int i=0;i<4;i++){ float fi=float(i);\r\n  float ph=v_uv.x*(2.+u_p1*4.)+u_time*(.8+fi*.2);\r\n  float y=.5+sin(ph+fi*1.7)*.25+sin(ph*2.3)*.08;\r\n  float w=.05+.03*sin(ph*1.3);\r\n  float m=smoothstep(w,w*.2,abs(v_uv.y-y));\r\n  col=mix(col,hsv2rgb(vec3(fract(fi*.22+u_p2+u_time*.02),.8,.55+.45*sin(ph))),m); }\r\n o=vec4(col*(.6+u_bass*.5),1.);}` },\r\n{ name: 'Starburst', icon: '☀️', fs: `void main(){\r\n vec2 p=(v_uv-.5)*vec2(AR,1.);\r\n float r=length(p),a=atan(p.y,p.x);\r\n float rays=pow(abs(sin(a*floor(6.+u_p1*18.)*.5+u_time)),8.);\r\n float core=smoothstep(.25,.0,r);\r\n vec3 c=hsv2rgb(vec3(fract(u_p2+u_time*.05),.7,1.))\r\n   *(rays*smoothstep(1.,.1,r)+core*2.)*(.4+u_beat*.9+u_bass*.4);\r\n o=vec4(clamp(c,0.,1.5),1.);}` },\r\n{ name: 'Plexo', icon: '🕸️', fs: `void main(){\r\n vec2 p=(v_uv-.5)*vec2(AR,1.)*mix(3.,7.,u_p1);\r\n vec2 g=floor(p),f=fract(p);\r\n float d1=8.,d2=8.;\r\n for(int y=-1;y<=1;y++)for(int x=-1;x<=1;x++){\r\n  vec2 ofs=vec2(float(x),float(y));\r\n  vec2 r=ofs+vec2(hash(g+ofs),hash(g+ofs+7.))*.8+.15*sin(u_time+6.28*hash(g+ofs+3.))-f;\r\n  float d=dot(r,r);\r\n  if(d<d1){d2=d1;d1=d;}else if(d<d2){d2=d;} }\r\n float edge=smoothstep(.06,.0,d2-d1);\r\n float pt=smoothstep(.03,.0,d1);\r\n o=vec4(hsv2rgb(vec3(fract(u_p2+u_time*.03),.6,1.))*(edge*.7+pt)*(.5+u_high*.8),1.);}` },\r\n{ name: 'Túnel²', icon: '🔲', fs: `void main(){\r\n vec2 p=(v_uv-.5)*vec2(AR,1.);\r\n float r=max(abs(p.x),abs(p.y))+1e-3;\r\n float z=1./r+u_time*(2.+u_p1*6.);\r\n float v=step(.5,fract(z*.4))*.8+.2;\r\n float ang=step(.5,fract((atan(p.y,p.x)/6.2832+.125)*4.))*.3;\r\n o=vec4(hsv2rgb(vec3(fract(z*.02+u_p2),.85,max(v-ang,0.)))*smoothstep(0.,.15,r)*(.5+u_bass*.6),1.);}` },\r\n{ name: 'Rombos 3D', icon: '💠', fs: `void main(){\r\n vec2 p=(v_uv-.5)*vec2(AR,1.)*mix(4.,10.,u_p1);\r\n vec2 q=vec2(p.x+p.y*1.732,p.x-p.y*1.732)*.5;\r\n vec2 g=floor(q),f=fract(q);\r\n float h=hash(g)+.3*sin(u_time*1.5+hash(g)*6.28)+u_bass*.4;\r\n float face=step(f.x,.93)*step(f.y,.93);\r\n o=vec4(hsv2rgb(vec3(fract(hash(g+3.)*.3+u_p2+u_time*.02),.7,clamp(h,0.,1.)))*face,1.);}` },\r\n];\r\n\r\n/* ---------------- efectos master ---------------- */\r\nconst FXDEFS = [\r\n{ id: 'rgb', name: 'RGB Shift', p: ['cantidad', 'ángulo'], fs: `void main(){\r\n float a=u_p2*6.2832; vec2 d=vec2(cos(a),sin(a))*u_p1*.05;\r\n o=vec4(texture(u_tex,clamp(v_uv+d,0.,1.)).r,texture(u_tex,v_uv).g,\r\n        texture(u_tex,clamp(v_uv-d,0.,1.)).b,1.);}` },\r\n{ id: 'kal', name: 'Kaleido', p: ['segmentos', 'rotación'], fs: `void main(){\r\n float seg=floor(2.+u_p1*14.); vec2 p=v_uv-.5; p.x*=AR;\r\n float an=atan(p.y,p.x)+u_p2*6.2832; float r=length(p);\r\n float m=6.2832/seg; an=mod(an,m); an=abs(an-m*.5);\r\n p=vec2(cos(an),sin(an))*r; p.x/=AR;\r\n o=texture(u_tex,clamp(p+.5,0.,1.));}` },\r\n{ id: 'mir', name: 'Espejo', p: ['modo', 'offset'], fs: `void main(){\r\n vec2 uv=fract(v_uv+vec2(u_p2-.5,0.)); int m=int(floor(u_p1*3.999));\r\n if(m==1||m==3) uv.x=uv.x<.5?uv.x:1.-uv.x;\r\n if(m==2||m==3) uv.y=uv.y<.5?uv.y:1.-uv.y;\r\n o=texture(u_tex,uv);}` },\r\n{ id: 'pix', name: 'Pixelate', p: ['tamaño', 'posterizar'], fs: `void main(){\r\n float n=mix(240.,10.,u_p1); vec2 uv=floor(v_uv*vec2(n*AR,n))/vec2(n*AR,n)+.5/vec2(n*AR,n);\r\n vec3 c=texture(u_tex,uv).rgb;\r\n if(u_p2>.02){ float l=mix(12.,2.,u_p2); c=floor(c*l)/l; }\r\n o=vec4(c,1.);}` },\r\n{ id: 'fb', name: 'Feedback', p: ['cantidad', 'zoom'], fs: `void main(){\r\n vec2 p=(v_uv-.5)*(1.-u_p2*.08)+.5; p=(p-.5)*rot2(u_p2*.02)+.5;\r\n vec3 cur=texture(u_tex,v_uv).rgb;\r\n vec3 fb=texture(u_prev,clamp(p,0.,1.)).rgb*(.7+u_p1*.29);\r\n o=vec4(max(cur,fb),1.);}` },\r\n{ id: 'hue', name: 'Hue/Sat', p: ['tono', 'saturación'], fs: `\r\nvec3 hueRot(vec3 c,float a){ const mat3 toYIQ=mat3(.299,.587,.114,.596,-.274,-.322,.211,-.523,.312);\r\n const mat3 toRGB=mat3(1.,.956,.621,1.,-.272,-.647,1.,-1.106,1.703);\r\n vec3 yiq=c*toYIQ; float h=atan(yiq.z,yiq.y)+a; float ch=length(yiq.yz);\r\n return vec3(yiq.x,ch*cos(h),ch*sin(h))*toRGB; }\r\nvoid main(){ vec3 c=texture(u_tex,v_uv).rgb;\r\n c=clamp(hueRot(c,u_p1*6.2832),0.,1.);\r\n float g=dot(c,vec3(.299,.587,.114));\r\n o=vec4(mix(vec3(g),c,u_p2*2.),1.);}` },\r\n{ id: 'str', name: 'Strobe', p: ['velocidad', 'duty'], fs: `void main(){\r\n float rate=max(1.,floor(u_p1*15.+1.)); float beats=u_time*u_bpm/60.;\r\n float on=step(fract(beats*rate),clamp(1.-u_p2,.06,.94));\r\n o=vec4(texture(u_tex,v_uv).rgb*on,1.);}` },\r\n{ id: 'gli', name: 'Glitch', p: ['cantidad', 'bloques'], fs: `void main(){\r\n float t=floor(u_time*12.); float ln=floor(v_uv.y*mix(8.,64.,u_p2));\r\n float h=hash(vec2(ln,t)); vec2 uv=v_uv;\r\n if(h<u_p1*.5) uv.x=fract(uv.x+(h-.25)*.7);\r\n vec3 c=texture(u_tex,uv).rgb;\r\n if(hash(vec2(t,ln*7.))<u_p1*.3) c=c.brg;\r\n o=vec4(c,1.);}` },\r\n{ id: 'zom', name: 'Zoom Pulso', p: ['cantidad', 'giro'], fs: `void main(){\r\n float z=1.-u_p1*(u_bass*.3+u_beat*.15);\r\n vec2 p=(v_uv-.5)*rot2((u_p2-.5)*u_beat*.7)*z+.5;\r\n o=texture(u_tex,clamp(p,0.,1.));}` },\r\n{ id: 'inv', name: 'Invertir/Solar', p: ['cantidad', 'umbral'], fs: `void main(){\r\n vec3 c=texture(u_tex,v_uv).rgb;\r\n vec3 s=mix(c,1.-c,step(vec3(1.-u_p2),c));\r\n o=vec4(mix(c, u_p2>.02 ? s : 1.-c, u_p1),1.);}` },\r\n{ id: 'vig', name: 'Contraste/Viñeta', p: ['contraste', 'viñeta'], fs: `void main(){\r\n vec3 c=texture(u_tex,v_uv).rgb; c=(c-.5)*(1.+u_p1*2.5)+.5;\r\n vec2 q=v_uv-.5; c*=1.-dot(q,q)*u_p2*2.8;\r\n o=vec4(clamp(c,0.,1.),1.);}` },\r\n{ id: 'uv', name: 'UV Neón', p: ['fluor', 'tono'], fs: `void main(){\r\n vec3 c=texture(u_tex,v_uv).rgb;\r\n float lum=dot(c,vec3(.299,.587,.114));\r\n vec3 neon=hsv2rgb(vec3(fract(u_p2+lum*.6),1.,pow(lum,.7)*1.35));\r\n o=vec4(clamp(mix(c,neon,u_p1),0.,1.),1.);}` },\r\n];\r\n\r\nconst COMP_FS = `#version 300 es\r\nprecision highp float;\r\nin vec2 v_uv; out vec4 o;\r\nuniform sampler2D u_t0a,u_t0b,u_t1a,u_t1b,u_t2a,u_t2b,u_t3a,u_t3b;\r\nuniform vec4 u_pos,u_op,u_hasA,u_hasB; uniform ivec4 u_mode;\r\nuniform vec2 u_f0a,u_f0b,u_f1a,u_f1b,u_f2a,u_f2b,u_f3a,u_f3b;\r\nvec2 fit(vec2 uv,vec2 f){return (uv-.5)*f+.5;}\r\nvec3 blendm(vec3 b,vec3 s,int m){\r\n if(m==1)return b+s; if(m==2)return 1.-(1.-b)*(1.-s);\r\n if(m==3)return b*s; if(m==4)return abs(b-s); if(m==5)return max(b,s);\r\n return s;}\r\nvoid lay(inout vec3 col,sampler2D ta,sampler2D tb,vec2 fa,vec2 fb,\r\n         float pos,float ha,float hb,float op,int mode){\r\n vec3 ca=texture(ta,fit(v_uv,fa)).rgb*ha;\r\n vec3 cb=texture(tb,fit(v_uv,fb)).rgb*hb;\r\n vec3 s=mix(ca,cb,pos); float a=mix(ha,hb,pos)*op;\r\n col=mix(col,blendm(col,s,mode),a);}\r\nvoid main(){\r\n vec3 col=vec3(0.);\r\n lay(col,u_t0a,u_t0b,u_f0a,u_f0b,u_pos.x,u_hasA.x,u_hasB.x,u_op.x,u_mode.x);\r\n lay(col,u_t1a,u_t1b,u_f1a,u_f1b,u_pos.y,u_hasA.y,u_hasB.y,u_op.y,u_mode.y);\r\n lay(col,u_t2a,u_t2b,u_f2a,u_f2b,u_pos.z,u_hasA.z,u_hasB.z,u_op.z,u_mode.z);\r\n lay(col,u_t3a,u_t3b,u_f3a,u_f3b,u_pos.w,u_hasA.w,u_hasB.w,u_op.w,u_mode.w);\r\n o=vec4(col,1.);}`;\r\n\r\nconst FINAL_FS = `#version 300 es\r\nprecision highp float;\r\nin vec2 v_uv; out vec4 o;\r\nuniform sampler2D u_tex; uniform float u_master,u_flash,u_build,u_time,u_warpOn;\r\nuniform mat3 u_warp; uniform vec4 u_srcRect;\r\nuniform float u_mask,u_soft,u_line,u_beat;\r\nvoid main(){\r\n vec2 base=v_uv; float inQ=1.; float eb=1.; float m=1.;\r\n if(u_warpOn>.5){\r\n   vec3 hh=u_warp*vec3(v_uv,1.);\r\n   base=hh.xy/hh.z;\r\n   inQ=step(0.,base.x)*step(base.x,1.)*step(0.,base.y)*step(base.y,1.);\r\n   eb=min(min(base.x,1.-base.x),min(base.y,1.-base.y));\r\n   if(u_soft>0.001) inQ*=smoothstep(0.,u_soft,eb); // soft edge / edge blending\r\n   if(u_mask>.5){ // máscara de forma (estilo Advanced Output)\r\n     vec2 mp=base-.5;\r\n     float sft=max(u_soft,.012);\r\n     if(u_mask<1.5) m=smoothstep(.5,.5-sft,length(mp));\r\n     else if(u_mask<2.5) m=smoothstep(.48,.48-sft,abs(mp.x)+abs(mp.y));\r\n     else if(u_mask<3.5){ float d=max(abs(mp.x)*1.15+mp.y*.58,-mp.y)-.44; m=smoothstep(0.,sft,-d); }\r\n     else { vec2 a2=abs(mp); float d=max(a2.x*.866+a2.y*.5,a2.y)-.46; m=smoothstep(0.,sft,-d); }\r\n     inQ*=m;\r\n   }\r\n }\r\n float b=u_build;\r\n vec2 uv=(base-.5)*(1.-b*.22)+.5;\r\n uv+=b*.006*vec2(sin(u_time*47.),cos(u_time*61.));\r\n vec2 suv=u_srcRect.xy+uv*u_srcRect.zw;\r\n vec3 c=texture(u_tex,clamp(suv,u_srcRect.xy,u_srcRect.xy+u_srcRect.zw)).rgb;\r\n c*=1.+b*.7;\r\n c*=mix(1.,.55+.6*step(.45,fract(u_time*(4.+b*22.))),b);\r\n if(u_line>0.001){ // contorno animado: late con el beat\r\n   float band=1.-smoothstep(u_line*.5,u_line,eb);\r\n   vec3 lc=.5+.5*cos(6.2832*(u_time*.12+vec3(0.,.33,.66)));\r\n   c=mix(c,lc*(1.2+u_beat*1.3),band*m*step(0.,eb));\r\n }\r\n c*=inQ;\r\n o=vec4(mix(c*u_master,vec3(1.),u_flash*inQ),1.); }`;\r\n\r\nconst BLIT_FS = `#version 300 es\r\nprecision highp float;\r\nin vec2 v_uv; out vec4 o; uniform sampler2D u_tex;\r\nvoid main(){ o=texture(u_tex,v_uv); }`;\r\n\r\nconst FITBLIT_FS = `#version 300 es\r\nprecision highp float;\r\nin vec2 v_uv; out vec4 o; uniform sampler2D u_tex; uniform vec2 u_fit;\r\nuniform vec4 u_tr; // escala, rotación, posX, posY\r\nvoid main(){\r\n vec2 uv=v_uv-.5;\r\n float cs=cos(u_tr.y), sn=sin(u_tr.y);\r\n uv=vec2(cs*uv.x-sn*uv.y, sn*uv.x+cs*uv.y)/max(u_tr.x,.05);\r\n uv-=vec2(u_tr.z,u_tr.w);\r\n vec2 suv=uv*u_fit+.5;\r\n float in1=step(0.,suv.x)*step(suv.x,1.)*step(0.,suv.y)*step(suv.y,1.);\r\n o=texture(u_tex,clamp(suv,0.,1.))*in1; }`;\r\n\r\n/* ---------------- núcleo WebGL ---------------- */\r\nfunction makeCtx(canvas) {\r\n  const gl = canvas.getContext('webgl2', { antialias: false, alpha: false, preserveDrawingBuffer: true });\r\n  if (!gl) { alert('Este navegador no soporta WebGL2. Usá Chrome o Edge.'); throw new Error('no webgl2'); }\r\n  return { gl, canvas, progs: new Map() };\r\n}\r\nfunction compile(gl, type, src) {\r\n  const s = gl.createShader(type); gl.shaderSource(s, src); gl.compileShader(s);\r\n  if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) {\r\n    console.error(gl.getShaderInfoLog(s), src); throw new Error('shader');\r\n  }\r\n  return s;\r\n}\r\nfunction program(ctx, key, fsSrc) {\r\n  if (ctx.progs.has(key)) return ctx.progs.get(key);\r\n  const gl = ctx.gl;\r\n  const p = gl.createProgram();\r\n  gl.attachShader(p, compile(gl, gl.VERTEX_SHADER, VS));\r\n  gl.attachShader(p, compile(gl, gl.FRAGMENT_SHADER, fsSrc));\r\n  gl.linkProgram(p);\r\n  if (!gl.getProgramParameter(p, gl.LINK_STATUS)) {\r\n    console.error(gl.getProgramInfoLog(p)); throw new Error('link');\r\n  }\r\n  p._u = {};\r\n  ctx.progs.set(key, p);\r\n  return p;\r\n}\r\nfunction U(gl, p, n) { if (!(n in p._u)) p._u[n] = gl.getUniformLocation(p, n); return p._u[n]; }\r\nfunction makeTex(gl, w, h) {\r\n  const t = gl.createTexture();\r\n  gl.bindTexture(gl.TEXTURE_2D, t);\r\n  gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, w, h, 0, gl.RGBA, gl.UNSIGNED_BYTE, null);\r\n  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);\r\n  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);\r\n  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);\r\n  gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);\r\n  return t;\r\n}\r\nfunction makeTarget(gl, w, h) {\r\n  const tex = makeTex(gl, w, h);\r\n  const fbo = gl.createFramebuffer();\r\n  gl.bindFramebuffer(gl.FRAMEBUFFER, fbo);\r\n  gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, tex, 0);\r\n  gl.bindFramebuffer(gl.FRAMEBUFFER, null);\r\n  return { fbo, tex, w, h };\r\n}\r\nfunction draw(gl) { gl.drawArrays(gl.TRIANGLES, 0, 3); }\r\n\r\nconst main = makeCtx($('#outCanvas'));\r\nconst prev = makeCtx($('#prevgl'));\r\nconst prev2dCtx = $('#prev2d').getContext('2d');\r\nlet ping = [], fbTgt = null, blackTex = null;\r\n\r\nfunction allocTargets() {\r\n  const gl = main.gl, [w, h] = state.res;\r\n  main.canvas.width = w; main.canvas.height = h;\r\n  ping = [makeTarget(gl, w, h), makeTarget(gl, w, h)];\r\n  fbTgt = makeTarget(gl, w, h);\r\n  if (!blackTex) blackTex = makeTex(gl, 2, 2);\r\n  for (const L of state.layers) for (const s of L.slots) {\r\n    if (s.tgt) s.tgt = makeTarget(gl, w, h);\r\n    s.nT = null; s.fxT = null;\r\n  }\r\n}\r\nallocTargets();\r\n\r\nfunction slotTexture(s) {\r\n  const gl = main.gl;\r\n  if (s.kind === 'video' || s.kind === 'text' || s.kind === 'gif') { if (!s.tex) s.tex = makeTex(gl, 2, 2); return s.tex; }\r\n  if (s.kind === 'gen') { if (!s.tgt) s.tgt = makeTarget(gl, state.res[0], state.res[1]); return s.tgt.tex; }\r\n  return blackTex;\r\n}\r\n\r\nfunction setAudioUniforms(gl, p) {\r\n  gl.uniform1f(U(gl, p, 'u_time'), nowSec);\r\n  gl.uniform1f(U(gl, p, 'u_bass'), audio.bass);\r\n  gl.uniform1f(U(gl, p, 'u_mid'), audio.mid);\r\n  gl.uniform1f(U(gl, p, 'u_high'), audio.high);\r\n  gl.uniform1f(U(gl, p, 'u_beat'), beatEnv);\r\n  gl.uniform1f(U(gl, p, 'u_bpm'), state.bpm);\r\n}\r\n/* generadores custom (creados con el constructor por bloques) */\r\nfunction buildGenFS(cfg) {\r\n  const A = x => (+x).toFixed(3);\r\n  const K = A(2 + (cfg.det ?? .5) * 12);\r\n  let warp = '';\r\n  if (cfg.warp === 'kaleido') {\r\n    const seg = Math.round(3 + (cfg.wAmt ?? .5) * 9);\r\n    warp = `float _an=atan(p.y,p.x);float _m=6.2832/${A(seg)};_an=mod(_an,_m);_an=abs(_an-_m*.5);p=vec2(cos(_an),sin(_an))*length(p);`;\r\n  } else if (cfg.warp === 'espejo') warp = 'p=abs(p);';\r\n  else if (cfg.warp === 'giro') warp = `p*=rot2(t*${A(.2 + (cfg.wAmt ?? .5))}+length(p)*${A((cfg.wAmt ?? .5) * 2)});`;\r\n  else if (cfg.warp === 'onda') warp = `p+=sin(p.yx*${A(2 + (cfg.wAmt ?? .5) * 8)}+t)*${A((cfg.wAmt ?? .5) * .4)};`;\r\n  else if (cfg.warp === 'zoombeat') warp = `p*=1.-u_beat*${A((cfg.wAmt ?? .5) * .5)};`;\r\n  let base;\r\n  switch (cfg.base) {\r\n    case 'anillos': base = `float v=.5+.5*sin(length(p)*${K}*2.-t*2.);`; break;\r\n    case 'rayas': base = `float v=.5+.5*sin((p.x+p.y)*${K}+t*2.);`; break;\r\n    case 'ruido': base = `float v=fbm(p*${K}*.6+vec2(t*.4,0.));`; break;\r\n    case 'voronoi': base = `vec2 _g=floor(p*${K}*.7),_f=fract(p*${K}*.7);float v=1.;\r\nfor(int _y=-1;_y<=1;_y++)for(int _x=-1;_x<=1;_x++){vec2 _o=vec2(float(_x),float(_y));\r\nv=min(v,length(_o+vec2(hash(_g+_o),hash(_g+_o+7.))*.8-_f));}v=1.-v;`; break;\r\n    case 'tunel': base = `float _r=length(p)+.06;float v=.5+.5*sin(${K}/_r+t*3.);`; break;\r\n    default: base = `float v=(sin(p.x*${K}+t)+sin(p.y*${K}*.8+t*1.3)+sin((p.x+p.y)*${K}*.5+t*.7))/6.+.5;`;\r\n  }\r\n  let col;\r\n  switch (cfg.color) {\r\n    case 'duotono': col = `vec3 c=mix(hsv2rgb(vec3(fract(${A(cfg.hue ?? 0)}+u_p2),.9,.22)),hsv2rgb(vec3(fract(${A(cfg.hue ?? 0)}+u_p2+.18),.85,1.)),v);`; break;\r\n    case 'fuego': col = `vec3 c=vec3(pow(v,.65),pow(v,2.1)*.85,pow(v,6.));`; break;\r\n    case 'uv': col = `vec3 c=hsv2rgb(vec3(fract(${A(cfg.hue ?? 0)}+u_p2+v*.2),1.,pow(v,1.4)*1.3));`; break;\r\n    default: col = `vec3 c=hsv2rgb(vec3(fract(v*.4+t*.05+${A(cfg.hue ?? 0)}+u_p2),.85,v));`;\r\n  }\r\n  let rea = '';\r\n  const rA = cfg.rAmt ?? .5;\r\n  if (cfg.react === 'bass') rea = `c*=${A(1 - rA)}+${A(rA * 1.7)}*u_bass;`;\r\n  else if (cfg.react === 'beat') rea = `c*=${A(1 - rA)}+${A(rA * 1.4)}*u_beat;`;\r\n  else if (cfg.react === 'high') rea = `c*=${A(1 - rA)}+${A(rA * 1.7)}*u_high;`;\r\n  return `void main(){\r\n vec2 p=(v_uv-.5)*vec2(AR,1.)*2.;\r\n float t=u_time*(.4+u_p1*1.6);\r\n ${warp}\r\n ${base}\r\n ${col}\r\n ${rea}\r\n o=vec4(clamp(c,0.,1.5),1.);}`;\r\n}\r\n/* ---- editor de nodos: el grafo compila a GLSL ---- */\r\nconst fA = x => (+x).toFixed(3);\r\nconst NTYPE_COL = { f: '#ffb03f', v2: '#2fd8ff', c: '#ff3fd4' };\r\nconst NODE_DEFS = {\r\n  uv: { name: 'UV espacio', cat: 'ENTRADA', ins: [], outs: ['v2'], params: [], glsl: o => [`vec2 ${o[0]}=p;`] },\r\n  tiempo: { name: 'Tiempo', cat: 'ENTRADA', ins: [], outs: ['f'], params: [{ k: 'vel', d: .5 }], glsl: (o, i, P) => [`float ${o[0]}=t*${fA(P.vel * 2)};`] },\r\n  bass: { name: 'Bajo', cat: 'ENTRADA', ins: [], outs: ['f'], params: [], glsl: o => [`float ${o[0]}=u_bass;`] },\r\n  beat: { name: 'Beat', cat: 'ENTRADA', ins: [], outs: ['f'], params: [], glsl: o => [`float ${o[0]}=u_beat;`] },\r\n  agudos: { name: 'Agudos', cat: 'ENTRADA', ins: [], outs: ['f'], params: [], glsl: o => [`float ${o[0]}=u_high;`] },\r\n  padx: { name: 'Pad X / P1', cat: 'ENTRADA', ins: [], outs: ['f'], params: [], glsl: o => [`float ${o[0]}=u_p1;`] },\r\n  pady: { name: 'Pad Y / P2', cat: 'ENTRADA', ins: [], outs: ['f'], params: [], glsl: o => [`float ${o[0]}=u_p2;`] },\r\n  num: { name: 'Número', cat: 'ENTRADA', ins: [], outs: ['f'], params: [{ k: 'v', d: .5 }], glsl: (o, i, P) => [`float ${o[0]}=${fA(P.v)};`] },\r\n  rotar: { name: 'Rotar', cat: 'ESPACIO', ins: ['v2', 'f'], outs: ['v2'], params: [], glsl: (o, i) => [`vec2 ${o[0]}=rot2(${i[1]}*6.2832)*${i[0]};`] },\r\n  escalar: { name: 'Zoom', cat: 'ESPACIO', ins: ['v2', 'f'], outs: ['v2'], params: [], glsl: (o, i) => [`vec2 ${o[0]}=${i[0]}/max(${i[1]}*2.,.05);`] },\r\n  kaleido: { name: 'Kaleido', cat: 'ESPACIO', ins: ['v2'], outs: ['v2'], params: [{ k: 'segs', d: .5 }], glsl: (o, i, P, id) => [\r\n    `float _a${id}=atan(${i[0]}.y,${i[0]}.x);`,\r\n    `float _m${id}=6.2832/${fA(Math.round(3 + P.segs * 9))};`,\r\n    `_a${id}=abs(mod(_a${id},_m${id})-_m${id}*.5);`,\r\n    `vec2 ${o[0]}=vec2(cos(_a${id}),sin(_a${id}))*length(${i[0]});`,\r\n  ] },\r\n  espejo: { name: 'Espejo', cat: 'ESPACIO', ins: ['v2'], outs: ['v2'], params: [], glsl: (o, i) => [`vec2 ${o[0]}=abs(${i[0]});`] },\r\n  onda: { name: 'Onda', cat: 'ESPACIO', ins: ['v2', 'f'], outs: ['v2'], params: [{ k: 'frec', d: .5 }], glsl: (o, i, P) => [`vec2 ${o[0]}=${i[0]}+sin(${i[0]}.yx*${fA(2 + P.frec * 8)}+t)*${i[1]}*.6;`] },\r\n  anillos: { name: 'Anillos', cat: 'CAMPO', ins: ['v2'], outs: ['f'], params: [{ k: 'frec', d: .5 }], glsl: (o, i, P) => [`float ${o[0]}=.5+.5*sin(length(${i[0]})*${fA(3 + P.frec * 20)}-t*2.);`] },\r\n  ondas: { name: 'Ondas', cat: 'CAMPO', ins: ['v2'], outs: ['f'], params: [{ k: 'frec', d: .5 }], glsl: (o, i, P) => [`float ${o[0]}=.5+.5*sin((${i[0]}.x+${i[0]}.y)*${fA(2 + P.frec * 14)}+t*2.);`] },\r\n  ruido: { name: 'Ruido FBM', cat: 'CAMPO', ins: ['v2'], outs: ['f'], params: [{ k: 'esc', d: .5 }], glsl: (o, i, P) => [`float ${o[0]}=fbm(${i[0]}*${fA(1 + P.esc * 8)}+vec2(t*.3,0.));`] },\r\n  mult: { name: 'Multiplicar', cat: 'MATE', ins: ['f', 'f'], outs: ['f'], params: [], glsl: (o, i) => [`float ${o[0]}=${i[0]}*${i[1]};`] },\r\n  suma: { name: 'Sumar', cat: 'MATE', ins: ['f', 'f'], outs: ['f'], params: [], glsl: (o, i) => [`float ${o[0]}=${i[0]}+${i[1]};`] },\r\n  seno: { name: 'Seno', cat: 'MATE', ins: ['f'], outs: ['f'], params: [], glsl: (o, i) => [`float ${o[0]}=.5+.5*sin(${i[0]}*6.2832);`] },\r\n  mezcla: { name: 'Mezclar', cat: 'MATE', ins: ['f', 'f', 'f'], outs: ['f'], params: [], glsl: (o, i) => [`float ${o[0]}=mix(${i[0]},${i[1]},clamp(${i[2]},0.,1.));`] },\r\n  rampa: { name: 'Rampa color', cat: 'COLOR', ins: ['f'], outs: ['c'], params: [{ k: 'tono', d: 0 }, { k: 'sat', d: .85 }], glsl: (o, i, P) => [`vec3 ${o[0]}=hsv2rgb(vec3(fract(${i[0]}*.4+${fA(P.tono)}+t*.03),${fA(P.sat)},clamp(${i[0]},0.,1.)));`] },\r\n  fuego: { name: 'Fuego', cat: 'COLOR', ins: ['f'], outs: ['c'], params: [], glsl: (o, i) => [`vec3 ${o[0]}=vec3(pow(clamp(${i[0]},0.,1.),.65),pow(clamp(${i[0]},0.,1.),2.1)*.85,pow(clamp(${i[0]},0.,1.),6.));`] },\r\n  duo: { name: 'Duotono', cat: 'COLOR', ins: ['f'], outs: ['c'], params: [{ k: 'tono', d: .5 }], glsl: (o, i, P) => [`vec3 ${o[0]}=mix(hsv2rgb(vec3(${fA(P.tono)},.9,.2)),hsv2rgb(vec3(fract(${fA(P.tono)}+.2),.8,1.)),clamp(${i[0]},0.,1.));`] },\r\n  brillo: { name: 'Brillo ×', cat: 'COLOR', ins: ['c', 'f'], outs: ['c'], params: [], glsl: (o, i) => [`vec3 ${o[0]}=${i[0]}*(0.35+1.5*${i[1]});`] },\r\n  mixc: { name: 'Mezclar color', cat: 'COLOR', ins: ['c', 'c', 'f'], outs: ['c'], params: [], glsl: (o, i) => [`vec3 ${o[0]}=mix(${i[0]},${i[1]},clamp(${i[2]},0.,1.));`] },\r\n  salida: { name: 'SALIDA', cat: 'SALIDA', ins: ['c'], outs: [], params: [], glsl: (o, i) => [`vec3 _final=${i[0]};`] },\r\n};\r\nfunction buildNodeFS(cfg) {\r\n  const stmts = [];\r\n  const nodeById = {};\r\n  (cfg.nodes || []).forEach(n => nodeById[n.id] = n);\r\n  const linkTo = {};\r\n  (cfg.links || []).forEach(L => linkTo[L.to[0] + ':' + L.to[1]] = L);\r\n  const done = {}, pending = {};\r\n  const outVar = (id, oi) => 'n' + id + '_' + oi;\r\n  function resolve(n) {\r\n    if (done[n.id]) return true;\r\n    if (pending[n.id]) return false; // ciclo → cortar\r\n    pending[n.id] = true;\r\n    const def = NODE_DEFS[n.kind];\r\n    if (!def) { done[n.id] = true; pending[n.id] = false; return true; }\r\n    const ins = def.ins.map((ty, ii) => {\r\n      const L = linkTo[n.id + ':' + ii];\r\n      if (L) {\r\n        const src = nodeById[L.from[0]];\r\n        const sdef = src && NODE_DEFS[src.kind];\r\n        if (src && sdef && sdef.outs[L.from[1]] === ty && resolve(src)) {\r\n          return outVar(L.from[0], L.from[1]);\r\n        }\r\n      }\r\n      return ty === 'v2' ? 'p' : ty === 'f' ? '.5' : 'vec3(0.)';\r\n    });\r\n    const P = {};\r\n    (def.params || []).forEach(pd => P[pd.k] = n.p && n.p[pd.k] != null ? n.p[pd.k] : pd.d);\r\n    stmts.push(...def.glsl(def.outs.map((_, oi) => outVar(n.id, oi)), ins, P, n.id));\r\n    done[n.id] = true; pending[n.id] = false;\r\n    return true;\r\n  }\r\n  (cfg.nodes || []).forEach(resolve);\r\n  const hasFinal = stmts.some(s => s.includes('_final'));\r\n  return `void main(){\r\n vec2 p=(v_u