          "name": "taller.css",
          "content": ".horarios-container {\r\n    font-family: sans-serif;\r\n    padding: 50px 30px;\r\n}\r\n\r\n.horarios-container h2 {\r\n    font-size: 24px;\r\n    font-weight: bold;\r\n    margin-bottom: 20px;\r\n    color: #000;\r\n}\r\n\r\n.horarios-grid {\r\n    display: flex;\r\n    gap: 10px;\r\n    margin-bottom: 30px;\r\n}\r\n\r\n.horario-box {\r\n    background-color: #0f8a5f;\r\n    color: white;\r\n    padding: 20px;\r\n    border-radius: 20px;\r\n    font-size: 30px;\r\n    font-weight: bold;\r\n    width: 80px;\r\n    height: 80px;\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n}\r\n\r\n.cupos-limitados h3 {\r\n    font-size: 20px;\r\n    font-weight: bold;\r\n    margin-bottom: 10px;\r\n    color: #000;\r\n}\r\n\r\n.cupos-limitados p {\r\n    font-size: 16px;\r\n    color: #333;\r\n    line-height: 1.6;\r\n    max-width: 550px;\r\n}\r\n\r\n/* Nuevas subsecciones - Figma 2026 */\r\n.subseccion {\r\n    padding: 30px;\r\n    border-top: 2px solid #E6643C;\r\n    margin-top: 20px;\r\n}\r\n\r\n.subseccion-titulo {\r\n    font-size: 32px;\r\n    font-weight: bold;\r\n    color: #E6643C;\r\n    margin-bottom: 20px;\r\n}\r\n\r\n.subseccion-titulo-xl {\r\n    font-size: 42px;\r\n    font-weight: bold;\r\n    color: #E6643C;\r\n    margin-bottom: 20px;\r\n    line-height: 1.2;\r\n}\r\n\r\n.cata-label {\r\n    font-weight: bold;\r\n    font-style: italic;\r\n    color: #5A2828;\r\n    font-size: 1.2rem;\r\n}\r\n\r\n.invitacion-semanal {\r\n    text-align: center;\r\n    font-size: 28px;\r\n    font-weight: bold;\r\n    color: #E6643C;\r\n    padding: 40px;\r\n    margin: 20px 0;\r\n}\r\n"
