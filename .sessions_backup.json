          "content": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>San Juan a la mesa - Formulario Prensa</title>\n    <link rel=\"stylesheet\" href=\"css/style.css\">\n    <link rel=\"stylesheet\" href=\"css/sorteo.css\">\n    <style>\n        body {\n            font-family: 'Ubuntu', sans-serif;\n            margin: 0;\n            padding: 0;\n            background: #f5f0eb;\n            min-height: 100vh;\n        }\n\n        .form-page {\n            max-width: 500px;\n            margin: 0 auto;\n        }\n\n        .form-hero {\n            background: linear-gradient(135deg, #1a3a5c, #5078B4);\n            padding: 50px 30px 60px;\n            text-align: left;\n            color: white;\n        }\n\n        .form-hero .produccion-etiqueta {\n            color: #C8DCD2;\n            margin-bottom: 10px;\n        }\n\n        .form-hero h1 {\n            font-size: 2.8rem;\n            font-weight: bold;\n            line-height: 1.1;\n            margin: 0;\n        }\n\n        .form-hero .back-link {\n            display: inline-flex;\n            align-items: center;\n            gap: 8px;\n            color: rgba(255,255,255,0.8);\n            text-decoration: none;\n            font-size: 0.9rem;\n            margin-bottom: 20px;\n            transition: color 0.3s;\n        }\n\n        .form-hero .back-link:hover {\n            color: white;\n        }\n\n        .form-content {\n            padding: 30px 25px 50px;\n            margin-top: -20px;\n        }\n\n        .form-card {\n            background: white;\n            border-radius: 20px;\n            padding: 30px 25px;\n            box-shadow: 0 4px 20px rgba(0,0,0,0.06);\n        }\n\n        .form-card h2 {\n            font-size: 1.5rem;\n            font-weight: bold;\n            margin: 0 0 5px;\n        }\n\n        .form-card .form-subtitle {\n            font-size: 0.9rem;\n            color: #888;\n            margin: 0 0 25px;\n        }\n\n        .form-group {\n            margin-bottom: 15px;\n        }\n\n        .form-group input,\n        .form-group textarea {\n            width: 100%;\n            padding: 14px 16px;\n            border: 1px solid #ddd;\n            border-radius: 21px;\n            font-family: 'Ubuntu', sans-serif;\n            font-size: 15px;\n            box-sizing: border-box;\n            transition: border-color 0.3s;\n            background: #fafafa;\n        }\n\n        .form-group input:focus,\n        .form-group textarea:focus {\n            outline: none;\n            border-color: #5078B4;\n            background: white;\n        }\n\n        .form-group textarea {\n            min-height: 80px;\n            resize: vertical;\n            border-radius: 15px;\n        }\n\n        .form-group input::placeholder,\n        .form-group textarea::placeholder {\n            color: #aaa;\n        }\n\n        .form-row {\n            display: flex;\n            gap: 10px;\n            margin-bottom: 0;\n        }\n\n        .form-row .form-group {\n            flex: 1;\n        }\n\n        .submit-btn {\n            width: 100%;\n            padding: 16px;\n            background: #5078B4;\n            color: white;\n            border: none;\n            border-radius: 25px;\n            font-family: 'Ubuntu', sans-serif;\n            font-size: 1.3rem;\n            font-weight: bold;\n            cursor: pointer;\n            transition: all 0.3s;\n            margin-top: 5px;\n        }\n\n        .submit-btn:hover {\n            background: #3A5F8E;\n            transform: translateY(-1px);\n        }\n\n        .submit-btn:active {\n            transform: translateY(0);\n        }\n\n        .submit-btn:disabled {\n            opacity: 0.6;\n            cursor: not-allowed;\n            transform: none;\n        }\n\n        .success-message {\n            display: none;\n            text-align: center;\n            padding: 40px 20px;\n        }\n\n        .success-message.show {\n            display: block;\n        }\n\n        .success-message .check-icon {\n            width: 70px;\n            height: 70px;\n            background: #4CAF50;\n            border-radius: 50%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            margin: 0 auto 20px;\n            font-size: 2rem;\n            color: white;\n        }\n\n        .success-message h3 {\n            font-size: 1.6rem;\n            font-weight: bold;\n            margin: 0 0 10px;\n            color: #333;\n        }\n\n        .success-message p {\n            font-size: 0.95rem;\n            color: #888;\n            margin: 0 0 25px;\n            line-height: 1.4;\n        }\n\n        .success-message .back-btn {\n            display: inline-block;\n            padding: 12px 35px;\n            background: #5078B4;\n            color: white;\n            border: none;\n            border-radius: 25px;\n            font-family: 'Ubuntu', sans-serif;\n            font-size: 1rem;\n            font-weight: bold;\n            text-decoration: none;\n            cursor: pointer;\n        }\n\n        .error-msg {\n            color: #D45336;\n            font-size: 0.85rem;\n            text-align: center;\n            margin-top: 10px;\n            display: none;\n        }\n\n        .error-msg.show {\n            display: block;\n        }\n\n        @media (max-width: 500px) {\n            .form-hero { padding: 35px 20px 50px; }\n            .form-hero h1 { font-size: 2rem; }\n            .form-content { padding: 25px 18px 40px; }\n            .form-card { padding: 22px 18px; }\n            .form-row { flex-direction: column; gap: 0; }\n        }\n    </style>\n</head>\n<body>\n    <div class=\"form-page\">\n        <div class=\"form-hero\">\n            <a href=\"reuniones.html\" class=\"back-link\">← Volver</a>\n            <span class=\"produccion-etiqueta\">PRODUCCIONES</span>\n            <h1>Prensa</h1>\n        </div>\n\n        <div class=\"form-content\">\n            <div class=\"form-card\" id=\"form-card\">\n                <h2>Formulario de prensa</h2>\n                <p class=\"form-subtitle\">Completá tus datos y te contactamos</p>\n\n                <form id=\"form-prensa\" onsubmit=\"return enviarFormulario(event)\">\n                    <div class=\"form-row\">\n                        <div class=\"form-group\">\n                            <input type=\"text\" id=\"nombre\" placeholder=\"Nombre\" required>\n                        </div>\n                        <div class=\"form-group\">\n                            <input type=\"text\" id=\"apellido\" placeholder=\"Apellido\" required>\n                        </div>\n                    </div>\n                    <div class=\"form-group\">\n                        <input type=\"email\" id=\"correo\" placeholder=\"Correo electrónico\" required>\n                    </div>\n                    <div class=\"form-group\">\n                        <input type=\"text\" id=\"medio\" placeholder=\"Medio\" required>\n                    </div>\n                    <div class=\"form-group\">\n                        <textarea id=\"tematica\" placeholder=\"Temática de la entrevista\" required></textarea>\n                    </div>\n                    <div class=\"error-msg\" id=\"error-msg\">Error al enviar el formulario. Intentalo de nuevo.</div>\n                    <button type=\"submit\" class=\"submit-btn\" id=\"submit-btn\">Enviar</button>\n                </form>\n            </div>\n\n            <div class=\"success-message\" id=\"success-msg\">\n                <div class=\"check-icon\">✓</div>\n                <h3>¡Formulario enviado!</h3>\n                <p>Tu solicitud de prensa fue recibida correctamente. Nos pondremos en contacto a la brevedad.</p>\n                <a href=\"reuniones.html\" class=\"back-btn\">Volver</a>\n            </div>\n        </div>\n    </div>\n\n    <script src=\"js/header.js\"></script>\n    <script src=\"js/footer.js\"></script>\n    <script src=\"js/touch.js\"></script>\n    <script>\n        async function enviarFormulario(event) {\n            event.preventDefault();\n            const btn = document.getElementById('submit-btn');\n            const errorEl = document.getElementById('error-msg');\n            \n            btn.disabled = true;\n            btn.textContent = 'Enviando...';\n            errorEl.classList.remove('show');\n\n            const data = {\n                tipo: 'prensa',\n                nombre: document.getElementById('nombre').value.trim(),\n                apellido: document.getElementById('apellido').value.trim(),\n                correo: document.getElementById('correo').value.trim(),\n                medio: document.getElementById('medio').value.trim(),\n                tematica: document.getElementById('tematica').value.trim()\n            };\n\n            try {\n                const res = await fetch('/api/reuniones', {\n                    method: 'POST',\n                    headers: { 'Content-Type': 'application/json' },\n                    body: JSON.stringify(data)\n                });\n                const result = await res.json();\n                if (result.ok) {\n                    document.getElementById('form-card').style.display = 'none';\n                    document.getElementById('success-msg').classList.add('show');\n                } else {\n                    errorEl.textContent = result.error || 'Error al enviar';\n                    errorEl.classList.add('show');\n                    btn.disabled = false;\n                    btn.textContent = 'Enviar';\n                }\n            } catch (err) {\n                errorEl.textContent = 'Error de conexión. Verificá que el servidor esté funcionando.';\n                errorEl.classList.add('show');\n                btn.disabled = false;\n                btn.textContent = 'Enviar';\n            }\n        }\n    </script>\n</body>\n</html>\n"
        },
