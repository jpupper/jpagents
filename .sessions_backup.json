          "path": "D:/Programacion/caminosysabores/public/js/env.js",
          "name": "env.js",
          "content": "/**\n * CAMINOS Y SABORES — Central Environment Configuration\n * Single source of truth for ALL route/API detection.\n * Must be loaded FIRST in every HTML page (before any other script).\n *\n * Exposes window.ENV with all base URLs, API paths, and helpers.\n */\n(function() {\n  'use strict';\n\n  const host = window.location.hostname;\n  const port = window.location.port;\n\n  // ─── Environment detection ─────────────────────────\n  const isLocal = host === 'localhost'\n    || host === '127.0.0.1'\n    || port === '2354'                 // dev port → any IP\n    || /^(10\\.|172\\.(1[6-9]|2\\d|3[01])\\.|192\\.168\\.)/.test(host);  // private IPs\n\n  const isFTP = host === 'fullscreencode.com'\n    || host === 'www.fullscreencode.com'\n    || host === 'caminosysabores.sanjuan.gob.ar'\n    || host === 'www.caminosysabores.sanjuan.gob.ar';\n\n  const isVPS = host.includes('vps-') || host.includes('dattaweb');\n\n  const isLocalDev = isLocal || isVPS;\n\n  // ─── Base URLs ─────────────────────────────────────\n  const VPS_BASE = 'https://vps-4455523-x.dattaweb.com/caminosysabores';\n\n  // API_BASE: empty string on local dev (same-origin), VPS on FTP/prod\n  const API_BASE = isLocalDev ? '' : VPS_BASE;\n\n  // ─── Redsocial paths ───────────────────────────────\n  const REDSOCIAL_API = isLocalDev ? '/redsocial/api' : VPS_BASE + '/redsocial/api';\n  const REDSOCIAL_EVENTO = isLocalDev ? '/redsocial/api/evento' : VPS_BASE + '/redsocial/api/evento';\n  const REDSOCIAL_EVENTO_FOTOS = isLocalDev ? '/redsocial/api/evento/fotos' : VPS_BASE + '/redsocial/api/evento/fotos';\n\n  // ─── App-specific API bases ────────────────────────\n  const CANASTA_API = isLocalDev ? window.location.origin : VPS_BASE;\n  const MEMOTEST_API = isLocalDev ? window.location.origin : VPS_BASE;\n\n  // ─── Image URL helpers ─────────────────────────────\n  function imgUrl(path) {\n    if (!path) return '';\n    if (path.startsWith('http://') || path.startsWith('https://')) return path;\n    if (isFTP) return VPS_BASE + path;\n    return path;\n  }\n\n  function imgEvUrl(path) {\n    if (!path) return '';\n    if (path.startsWith('http://') || path.startsWith('https://')) return path;\n    if (isFTP) return VPS_BASE + '/redsocial' + path;\n    return path;\n  }\n\n  // ─── Sello ─────────────────────────────────────────\n  const SELLO_IMG = isLocalDev\n    ? '/selloparqueischigualasto.png'\n    : VPS_BASE + '/selloparqueischigualasto.png';\n\n  // ─── EXPORT ────────────────────────────────────────\n  window.ENV = {\n    // Flags\n    isLocalDev: isLocalDev,\n    isFTP: isFTP,\n    isLocal: isLocal,\n    isVPS: isVPS,\n\n    // Raw VPS URL\n    VPS_BASE: VPS_BASE,\n\n    // Generic API base ('' on local, VPS on FTP)\n    API_BASE: API_BASE,\n\n    // Redsocial\n    REDSOCIAL_API: REDSOCIAL_API,\n    REDSOCIAL_EVENTO: REDSOCIAL_EVENTO,\n    REDSOCIAL_EVENTO_FOTOS: REDSOCIAL_EVENTO_FOTOS,\n\n    // App bases (origin on local, VPS on FTP)\n    CANASTA_API: CANASTA_API,\n    MEMOTEST_API: MEMOTEST_API,\n\n    // Sello\n    SELLO_IMG: SELLO_IMG,\n\n    // Auth\n    FSCAUTH_URL: 'https://vps-4455523-x.dattaweb.com/fscauth',\n\n    // Helpers\n    imgUrl: imgUrl,\n    imgEvUrl: imgEvUrl,\n  };\n})();\n"
