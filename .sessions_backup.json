          "path": "D:/Programacion/caminosysabores/server/lib/mailer.js",
          "name": "mailer.js",
          "content": "const nodemailer = require('nodemailer');\n\n// ─── CONFIG ────────────────────────────────────────────\nconst MAIL_HOST  = process.env.SMTP_HOST  || '';\nconst MAIL_PORT  = parseInt(process.env.SMTP_PORT || '587');\nconst MAIL_USER  = process.env.SMTP_USER  || '';\nconst MAIL_PASS  = process.env.SMTP_PASS  || '';\nconst MAIL_FROM  = process.env.SMTP_FROM  || 'info@fullscreencode.com';\n\n// ─── TRANSPORTE REUTILIZABLE ───────────────────────────\nlet transport = null;\n\nfunction getTransport() {\n  if (transport) return transport;\n\n  if (MAIL_HOST && MAIL_USER) {\n    transport = nodemailer.createTransport({\n      host: MAIL_HOST, port: MAIL_PORT,\n      secure: MAIL_PORT === 465,\n      auth: { user: MAIL_USER, pass: MAIL_PASS },\n      // Keep connection alive for faster subsequent sends\n      pool: true,\n      maxConnections: 1,\n      maxMessages: 100\n    });\n  } else {\n    // Fallback: Gmail SMTP or sendmail\n    const GMAIL_USER = process.env.GMAIL_SMTP_USER || process.env.SMTP_USER || '';\n    const GMAIL_PASS = process.env.GMAIL_SMTP_PASS || process.env.SMTP_PASS || '';\n    if (GMAIL_USER && GMAIL_PASS && GMAIL_PASS !== 'PONER_APP_PASSWORD_AQUI') {\n      transport = nodemailer.createTransport({\n        host: 'smtp.gmail.com', port: 587, secure: false,\n        auth: { user: GMAIL_USER, pass: GMAIL_PASS },\n        pool: true, maxConnections: 1, maxMessages: 100\n      });\n    } else {\n      try {\n        transport = nodemailer.createTransport({\n          sendmail: true, newline: 'unix',\n          path: '/usr/sbin/sendmail',\n          args: ['-f', MAIL_FROM]\n        });\n      } catch(e) {\n        transport = null;\n      }\n    }\n  }\n\n  return transport;\n}\n\n// ─── ENVIAR MAIL ───────────────────────────────────────\n// Retorna true si se envió, false si no.\nasync function enviarMail({ to, subject, html }) {\n  const t = getTransport();\n  if (!t) {\n    console.log(`  [Mailer] Sin transporte SMTP. No se pudo enviar a ${to}`);\n    return false;\n  }\n\n  try {\n    const info = await t.sendMail({ from: MAIL_FROM, to, subject, html });\n    console.log(`  [Mailer] OK -> ${to} | id=${info.messageId} | asunto=\"${subject.substring(0, 50)}\"`);\n    return true;\n  } catch (err) {\n    console.error(`  [Mailer] ERROR -> ${to} | asunto=\"${subject.substring(0, 50)}\" | ${err.message}`);\n    if (err.response) {\n      console.error(`  [Mailer] Respuesta SMTP: ${err.response.substring(0, 200)}`);\n    }\n    return false;\n  }\n}\n\nmodule.exports = { enviarMail, getTransport };\n"
