\" r=\"2.5\" fill=\"#ff7a5c\"/>\r\n            <line x1=\"40\" y1=\"232.9\" x2=\"127.7\" y2=\"232.9\" stroke=\"rgba(229,83,54,0.15)\" stroke-width=\"0.5\" stroke-dasharray=\"2,3\"/>\r\n            <line x1=\"135.7\" y1=\"40\" x2=\"135.7\" y2=\"224.9\" stroke=\"rgba(229,83,54,0.15)\" stroke-width=\"0.5\" stroke-dasharray=\"2,3\"/>\r\n        </svg>\r\n        </div>\r\n        <div id=\"intro-title\" style=\"margin-bottom:0;\">\r\n            <button id=\"intro-btn\">Ingresar</button>\r\n        </div>\r\n    </div>\r\n\r\n    <div id=\"c\"></div>\r\n    <div id=\"in\">Arrastrá para explorar · Tocá un punto para conocerlo</div>\r\n\r\n    <div id=\"lg\">\r\n        <div class=\"lt\">Circuitos</div>\r\n        <div class=\"li\"><span class=\"ld\" style=\"background:rgb(255,217,51);\"></span>Circuito Cultural</div>\r\n        <div class=\"li\"><span class=\"ld\" style=\"background:rgb(77,77,230);\"></span>Calingasta</div>\r\n        <div class=\"li\"><span class=\"ld\" style=\"background:rgb(230,128,26);\"></span>Jáchal</div>\r\n        <div class=\"li\"><span class=\"ld\" style=\"background:rgb(204,51,77);\"></span>Iglesia</div>\r\n        <div class=\"li\"><span class=\"ld\" style=\"background:rgb(51,179,77);\"></span>Valle Fértil</div>\r\n        <div class=\"li\"><span class=\"ld\" style=\"background:rgb(51,153,204);\"></span>Ruta Interlagos</div>\r\n    </div>\r\n\r\n    <div id=\"zc\">\r\n        <button id=\"zi\">+</button>\r\n        <button id=\"zo\">&minus;</button>\r\n    </div>\r\n\r\n\r\n\r\n    <!-- SETTINGS GEAR -->\r\n    <button id=\"sg\" title=\"Configuración\">&#9881;</button>\r\n\r\n    <!-- SETTINGS PANEL -->\r\n    <div id=\"sp\">\r\n        <!-- Tab buttons -->\r\n        <div class=\"sp-tabs\">\r\n            <button class=\"sp-tab active\" data-tab=\"pois\">POIS</button>\r\n            <button class=\"sp-tab\" data-tab=\"cam\">CAM</button>\r\n            <button class=\"sp-tab\" data-tab=\"postpo\">POSTPO</button>\r\n        </div>\r\n\r\n        <!-- POIS TAB -->\r\n        <div class=\"sp-tab-content active\" id=\"sp-pois\">\r\n            <div style=\"display:flex;align-items:center;gap:8px;margin-bottom:8px;\">\r\n                <span style=\"font-size:11px;color:rgba(255,255,255,0.5);flex:1;\">Editar POIs</span>\r\n                <button id=\"edit-toggle\" style=\"padding:4px 10px;border:1px solid rgba(229,83,54,0.3);border-radius:4px;background:transparent;color:rgba(255,255,255,0.4);font-size:10px;font-weight:600;cursor:pointer;transition:all 0.2s;font-family:'Ubuntu',system-ui,sans-serif;letter-spacing:1px;text-transform:uppercase;\">OFF</button>\r\n            </div>\r\n            <div id=\"edit-hint\" style=\"font-size:10px;color:rgba(229,83,54,0.6);margin-bottom:8px;padding:4px 8px;background:rgba(229,83,54,0.08);border-radius:4px;display:none;\">Click en un POI para moverlo con las flechas</div>\r\n            <button id=\"sv-admin\" style=\"width:100%;padding:8px;border:1px solid rgba(229,83,54,0.3);border-radius:6px;background:rgba(229,83,54,0.1);color:#e55336;font-size:12px;font-weight:600;cursor:pointer;transition:all 0.2s;font-family:'Ubuntu',system-ui,sans-serif;text-transform:uppercase;letter-spacing:1px;\">Admin POIs</button>\r\n        </div>\r\n\r\n        <!-- CAM TAB -->\r\n        <div class=\"sp-tab-content\" id=\"sp-cam\">\r\n            <div class=\"sp-h\">Iluminación</div>\r\n            <div class=\"lgroup\" data-light=\"ambient\">\r\n                <div class=\"lb on\" data-light=\"ambient\" style=\"color:#887766;\">\r\n                    <div class=\"lb-dot\" style=\"background:#887766;\"></div>\r\n                    <span class=\"lb-label\">Ambiente</span>\r\n                    <span class=\"lb-ind\"></span>\r\n                </div>\r\n                <div class=\"lsub\">\r\n                    <input type=\"range\" class=\"li-slider\" data-light=\"ambient\" min=\"0\" max=\"5\" step=\"0.01\" value=\"0.6\">\r\n                    <input type=\"color\" class=\"li-color\" data-light=\"ambient\" value=\"#cc8877\">\r\n                    <span class=\"li-val\" data-light=\"ambient\">0.60</span>\r\n                </div>\r\n            </div>\r\n            <div class=\"lgroup\" data-light=\"main\">\r\n                <div class=\"lb on\" data-light=\"main\" style=\"color:#ffddaa;\">\r\n                    <div class=\"lb-dot\" style=\"background:#ffe0b0;\"></div>\r\n                    <span class=\"lb-label\">Principal</span>\r\n                    <span class=\"lb-ind\"></span>\r\n                </div>\r\n                <div class=\"lsub\">\r\n                    <input type=\"range\" class=\"li-slider\" data-light=\"main\" min=\"0\" max=\"5\" step=\"0.01\" value=\"2.0\">\r\n                    <input type=\"color\" class=\"li-color\" data-light=\"main\" value=\"#ffcc99\">\r\n                    <span class=\"li-val\" data-light=\"main\">2.00</span>\r\n                </div>\r\n            </div>\r\n            <div class=\"lgroup\" data-light=\"fill\">\r\n                <div class=\"lb on\" data-light=\"fill\" style=\"color:#ccbbaa;\">\r\n                    <div class=\"lb-dot\" style=\"background:#ccbbaa;\"></div>\r\n                    <span class=\"lb-label\">Relleno</span>\r\n                    <span class=\"lb-ind\"></span>\r\n                </div>\r\n                <div class=\"lsub\">\r\n                    <input type=\"range\" class=\"li-slider\" data-light=\"fill\" min=\"0\" max=\"3\" step=\"0.01\" value=\"0.4\">\r\n                    <input type=\"color\" class=\"li-color\" data-light=\"fill\" value=\"#cc9988\">\r\n                    <span class=\"li-val\" data-light=\"fill\">0.40</span>\r\n                </div>\r\n            </div>\r\n            <div class=\"lgroup\" data-light=\"rim\">\r\n                <div class=\"lb on\" data-light=\"rim\" style=\"color:#aaccff;\">\r\n                    <div class=\"lb-dot\" style=\"background:#aaccff;\"></div>\r\n                    <span class=\"lb-label\">Borde</span>\r\n                    <span class=\"lb-ind\"></span>\r\n                </div>\r\n                <div class=\"lsub\">\r\n                    <input type=\"range\" class=\"li-slider\" data-light=\"rim\" min=\"0\" max=\"3\" step=\"0.01\" value=\"0.3\">\r\n                    <input type=\"color\" class=\"li-color\" data-light=\"rim\" value=\"#ffb088\">\r\n                    <span class=\"li-val\" data-light=\"rim\">0.30</span>\r\n                </div>\r\n            </div>\r\n            <div class=\"sp-h\" style=\"margin-top:10px;border-top:1px solid rgba(240,230,208,0.08);padding-top:10px;\">Cámara</div>\r\n            <div class=\"sv-row\">\r\n                <span class=\"sv-label\">Zoom</span>\r\n                <input type=\"range\" class=\"sv-slider\" id=\"sv-zoom\" min=\"0\" max=\"20\" step=\"0.01\" value=\"16.4\">\r\n                <span class=\"sv-val\" id=\"sv-zoom-val\">16.4</span>\r\n            </div>\r\n            <div class=\"sv-row\">\r\n                <span class=\"sv-label\">Pitch</span>\r\n                <input type=\"range\" class=\"sv-slider\" id=\"sv-pitch\" min=\"-1.57\" max=\"1.57\" step=\"0.01\" value=\"0.83\">\r\n                <span class=\"sv-val\" id=\"sv-pitch-val\">0.83</span>\r\n            </div>\r\n            <div class=\"sv-row\">\r\n                <span class=\"sv-label\">Yaw</span>\r\n                <input type=\"range\" class=\"sv-slider\" id=\"sv-yaw\" min=\"-3.14\" max=\"3.14\" step=\"0.01\" value=\"-0.4\">\r\n                <span class=\"sv-val\" id=\"sv-yaw-val\">-0.40</span>\r\n            </div>\r\n            <div class=\"sv-row\">\r\n                <span class=\"sv-label\">Escala</span>\r\n                <input type=\"range\" class=\"sv-slider\" id=\"sv-scale\" min=\"0\" max=\"1\" step=\"0.00001\" value=\"1\">\r\n                <span class=\"sv-val\" id=\"sv-scale-val\">1.00</span>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- POSTPO TAB -->\r\n        <div class=\"sp-tab-content\" id=\"sp-postpo\">\r\n            <div class=\"sp-h\">Bloom</div>\r\n            <div class=\"sv-row\">\r\n                <span class=\"sv-label\">Brillo</span>\r\n                <input type=\"range\" class=\"pp-slider\" id=\"pp-bloom-strength\" min=\"0\" max=\"2\" step=\"0.01\" value=\"0.25\">\r\n                <span class=\"sv-val\" id=\"pp-bloom-strength-val\">0.25</span>\r\n            </div>\r\n            <div class=\"sv-row\">\r\n                <span class=\"sv-label\">Radio</span>\r\n                <input type=\"range\" class=\"pp-slider\" id=\"pp-bloom-radius\" min=\"0\" max=\"1\" step=\"0.01\" value=\"0.4\">\r\n                <span class=\"sv-val\" id=\"pp-bloom-radius-val\">0.40</span>\r\n            </div>\r\n            <div class=\"sv-row\">\r\n                <span class=\"sv-label\">Umbral</span>\r\n                <input type=\"range\" class=\"pp-slider\" id=\"pp-bloom-threshold\" min=\"0\" max=\"1\" step=\"0.01\" value=\"0.85\">\r\n                <span class=\"sv-val\" id=\"pp-bloom-threshold-val\">0.85</span>\r\n            </div>\r\n            <div class=\"sp-h\" style=\"margin-top:10px;border-top:1px solid rgba(240,230,208,0.08);padding-top:10px;\">Exposición</div>\r\n            <div class=\"sv-row\">\r\n                <span class=\"sv-label\">Exposure</span>\r\n                <input type=\"range\" class=\"pp-slider\" id=\"pp-exposure\" min=\"0.1\" max=\"3\" step=\"0.01\" value=\"1.1\">\r\n                <span class=\"sv-val\" id=\"pp-exposure-val\">1.10</span>\r\n            </div>\r\n            <div class=\"sp-h\" style=\"margin-top:10px;border-top:1px solid rgba(240,230,208,0.08);padding-top:10px;\">Anti-Aliasing</div>\r\n            <div style=\"display:flex;align-items:center;gap:8px;padding:4px 0;\">\r\n                <span style=\"font-size:11px;color:rgba(255,255,255,0.6);flex:1;\">SMAA</span>\r\n                <button class=\"pp-toggle\" id=\"pp-smaa-toggle\" style=\"padding:2px 8px;border:1px solid rgba(229,83,54,0.3);border-radius:3px;background:rgba(229,83,54,0.15);color:#e55336;font-size:9px;font-weight:700;cursor:pointer;font-family:'Ubuntu',system-ui,sans-serif;letter-spacing:1px;text-transform:uppercase;\">ON</button>\r\n            </div>\r\n        </div>\r\n\r\n        <button id=\"sv-save\" title=\"Guardar configuración actual\">Guardar</button>\r\n        <div id=\"fps\">-- FPS</div>\r\n    </div>\r\n\r\n    <!-- POI ADMIN PANEL -->\r\n    <div id=\"poi-admin-overlay\">\r\n        <div id=\"poi-admin-panel\">\r\n            <button id=\"poi-admin-close\" style=\"position:absolute;top:10px;right:12px;background:none;border:none;color:#f0e6d0;font-size:20px;cursor:pointer;font-family:'Ubuntu',system-ui,sans-serif;\">&times;</button>\r\n            <div style=\"font-size:14px;font-weight:600;color:#e55336;margin-bottom:12px;text-transform:uppercase;letter-spacing:1px;\">Admin POIs</div>\r\n            \r\n            <!-- Lista de POIs -->\r\n            <div id=\"poi-list\" style=\"max-height:200px;overflow-y:auto;margin-bottom:12px;border:1px solid rgba(229,83,54,0.15);border-radius:8px;padding:8px;background:rgba(0,0,0,0.2);\"></div>\r\n            \r\n            <button id=\"poi-add-btn\" style=\"width:100%;padding:8px;border:1px dashed rgba(229,83,54,0.4);border-radius:6px;background:rgba(229,83,54,0.05);color:#e55336;font-size:12px;cursor:pointer;margin-bottom:12px;font-family:'Ubuntu',system-ui,sans-serif;\">+ Nuevo POI</button>\r\n            \r\n            <!-- Formulario POI -->\r\n            <div id=\"poi-form\" style=\"display:none;border-top:1px solid rgba(240,230,208,0.1);padding-top:12px;\">\r\n                <div style=\"display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;margin-bottom:8px;\">\r\n                    <div>\r\n                        <label style=\"font-size:10px;color:rgba(255,255,255,0.4);display:block;margin-bottom:2px;\">X</label>\r\n                        <input type=\"number\" id=\"poi-x\" step=\"0.001\" style=\"width:100%;padding:6px;background:rgba(0,0,0,0.3);border:1px solid rgba(229,83,54,0.2);border-radius:4px;color:#f0e6d0;font-size:12px;\">\r\n                    </div>\r\n                    <div>\r\n                        <label style=\"font-size:10px;color:rgba(255,255,255,0.4);display:block;margin-bottom:2px;\">Y</label>\r\n                        <input type=\"number\" id=\"poi-y\" step=\"0.001\" style=\"width:100%;padding:6px;background:rgba(0,0,0,0.3);border:1px solid rgba(229,83,54,0.2);border-radius:4px;color:#f0e6d0;font-size:12px;\">\r\n                    </div>\r\n                    <div>\r\n                        <label style=\"font-size:10px;color:rgba(255,255,255,0.4);display:block;margin-bottom:2px;\">Z</label>\r\n                        <input type=\"number\" id=\"poi-z\" step=\"0.001\" style=\"width:100%;padding:6px;background:rgba(0,0,0,0.3);border:1px solid rgba(229,83,54,0.2);border-radius:4px;color:#f0e6d0;font-size:12px;\">\r\n                    </div>\r\n                </div>\r\n                <div style=\"margin-bottom:8px;\">\r\n                    <label style=\"font-size:10px;color:rgba(255,255,255,0.4);display:block;margin-bottom:2px;\">Nombre</label>\r\n                    <input type=\"text\" id=\"poi-name\" style=\"width:100%;padding:6px;background:rgba(0,0,0,0.3);border:1px solid rgba(229,83,54,0.2);border-radius:4px;color:#f0e6d0;font-size:12px;\">\r\n                </div>\r\n                <div style=\"margin-bottom:8px;\">\r\n                    <label style=\"font-size:10px;color:rgba(255,255,255,0.4);display:block;margin-bottom:2px;\">Descripción</label>\r\n                    <textarea id=\"poi-desc\" rows=\"2\" style=\"width:100%;padding:6px;background:rgba(0,0,0,0.3);border:1px solid rgba(229,83,54,0.2);border-radius:4px;color:#f0e6d0;font-size:12px;resize:vertical;font-family:'Ubuntu',system-ui,sans-serif;\"></textarea>\r\n                </div>\r\n                <div style=\"margin-bottom:8px;\">\r\n                    <label style=\"font-size:10px;color:rgba(255,255,255,0.4);display:block;margin-bottom:2px;\">Color del circuito</label>\r\n                    <input type=\"color\" id=\"poi-color\" value=\"#e55336\" style=\"width:100%;height:30px;padding:2px;background:rgba(0,0,0,0.3);border:1px solid rgba(229,83,54,0.2);border-radius:4px;cursor:pointer;\">\r\n                </div>\r\n                <div style=\"margin-bottom:12px;\">\r\n                    <label style=\"font-size:10px;color:rgba(255,255,255,0.4);display:block;margin-bottom:2px;\">Imagen</label>\r\n                    <input type=\"file\" id=\"poi-image\" accept=\"image/*\" style=\"width:100%;padding:6px;background:rgba(0,0,0,0.3);border:1px solid rgba(229,83,54,0.2);border-radius:4px;color:#f0e6d0;font-size:12px;\">\r\n                </div>\r\n                <div style=\"display:flex;gap:6px;\">\r\n                    <button id=\"poi-save-btn\" style=\"flex:1;padding:8px;border:none;border-radius:6px;background:rgba(229,83,54,0.6);color:#fff;font-size:12px;font-weight:600;cursor:pointer;font-family:'Ubuntu',system-ui,sans-serif;\">Guardar POI</button>\r\n                    <button id=\"poi-delete-btn\" style=\"padding:8px 12px;border:1px solid rgba(229,83,54,0.3);border-radius:6px;background:rgba(229,83,54,0.05);color:#e55336;font-size:12px;cursor:pointer;font-family:'Ubuntu',system-ui,sans-serif;display:none;\">Eliminar</button>\r\n                </div>\r\n                <div id=\"poi-status\" style=\"margin-top:6px;font-size:11px;color:rgba(255,255,255,0.4);\"></div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- MODAL -->\r\n    <div id=\"mo\">\r\n        <div id=\"md\">\r\n            <button class=\"mc\" id=\"mc\">&times;</button>\r\n            <div class=\"mb\">\r\n                <div class=\"md2\" id=\"mdd\"></div>\r\n                \r\n                <!-- Main view wrapper (cross-fades with sub view) -->\r\n                <div id=\"modal-main\">\r\n                    <img class=\"mi\" id=\"pimg\" src=\"\" alt=\"Imagen del punto\" />\r\n                    <div class=\"mci\" id=\"mci\"></div>\r\n                    <div id=\"m-sub\" style=\"font-size:10px;color:rgba(255,255,255,0.35);margin:0 0 4px;font-family:'Ubuntu',system-ui,sans-serif;\"></div>\r\n                    <h2 id=\"mt\"></h2>\r\n                    <p id=\"md3\"></p>\r\n                    \r\n                    <!-- Sub-section list (buttons in 1-column) -->\r\n                    <div id=\"m-sub-list\" style=\"display:none;grid-template-columns:1fr;gap:3px;margin-top:6px;\"></div>\r\n                </div>\r\n                \r\n                <!-- Sub-section detail view wrapper (cross-fades with main) -->\r\n                <div id=\"modal-sub\" style=\"display:none;\">\r\n                    <img id=\"m-sub-img\" style=\"width:100%;height:90px;object-fit:cover;border-radius:8px;margin:2px 0;background:rgba(229,83,54,0.08);\" alt=\"Sub-sección\"/>\r\n                    <h3 id=\"m-sub-title\" style=\"font-size:13px;font-weight:600;color:#f0e6d0;margin:2px 0 4px;font-family:'Ubuntu',system-ui,sans-serif;\"></h3>\r\n                    <p id=\"m-sub-desc\" style=\"font-size:11px;color:rgba(255,255,255,0.7);line-height:1.4;font-family:'Ubuntu',system-ui,sans-serif;\"></p>\r\n                    <!-- Back button inside sub view -->\r\n                    <button id=\"m-sub-back\" style=\"display:flex;align-items:center;gap:4px;margin-top:4px;padding:4px 10px;border:1px solid rgba(229,83,54,0.25);border-radius:5px;background:rgba(229,83,54,0.06);color:#e55336;font-size:9px;font-weight:600;cursor:pointer;font-family:'Ubuntu',system-ui,sans-serif;transition:all 0.15s;\">\r\n                        ← Volver\r\n                    </button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div id=\"ld\"><div><div id=\"lb\"><div id=\"lbf\"></div></div><div id=\"lt2\">Preparando...</div></div></div>\r\n\r\n        <!-- FSC config FIRST, then auth -->\r\n        <script src=\"js/config.js\"></script>\r\n        <script src=\"js/auth.js\"></script>\r\n\r\n        <script type=\"importmap\">\r\n    {\r\n        \"imports\": {\r\n            \"three\": \"https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js\",\r\n            \"three/addons/\": \"https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/\"\r\n        }\r\n    }\r\n    </script>\r\n\r\n    <script type=\"module\" src=\"app.js\"></script>\r\n</body>\r\n</html>\r\n"
