          "path": "D:/Programacion/caminosysabores/public/sitio/sabores.html",
          "name": "sabores.html",
          "content": "<!DOCTYPE html>\r\n<html lang=\"es\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>San Juan Invita - Sabores</title>\r\n    <link rel=\"stylesheet\" href=\"css/style.css\">\r\n    <link rel=\"stylesheet\" href=\"css/sabores.css\">\r\n</head>\r\n<body>\r\n    <!-- Contenido principal -->\r\n    <main>\r\n        <div class=\"hero-section\">\r\n            <img src=\"assets/sabores/fondo.png\" alt=\"Sabores de San Juan\" class=\"background-image\">\r\n            <div class=\"content-container\">\r\n                <h1 class=\"tagline\">Sabores <br>que cuentan <br> historias </h1>\r\n            </div>\r\n        </div>\r\n        \r\n        <!-- Sección de texto debajo de la imagen -->\r\n        <div class=\"text-section\">\r\n            <p>San Juan se cocina con memoria, con productos nobles y con el toque único de quienes transmiten recetas de generación en generación. Este recetario es una ventana a nuestra identidad gastronómica.</p>\r\n            <p>Encontrá platos típicos, secretos regionales y la pasión de nuestros cocineros en un espacio pensado para que puedas aprender, replicar y compartir los sabores de nuestra tierra.</p>\r\n        </div>\r\n\r\n        <div class=\"recetario-header\">\r\n            <h2 class=\"recetario-titulo\">Recetario | Seleccioná cada receta</h2>\r\n        </div>\r\n\r\n        <!-- Sección de recetas -->\r\n        <div class=\"recetas-section\">\r\n            <div class=\"recetas-grid\">\r\n                <div class=\"receta-card\" data-recipe=\"recetahummus\" data-video=\"TWJJQF4EOlY\" data-mobile-video=\"_38Bp76qDwQ\">\r\n                    <div class=\"receta-imagen-container\">\r\n                        <img src=\"assets/sabores/hummus.png\" alt=\"Hummus\" class=\"receta-imagen\">\r\n                        <div class=\"receta-botones\">\r\n                            <button class=\"ver-video\"><img src=\"assets/sabores/video.png\" alt=\"Video\"> Ver video</button>\r\n                            <button class=\"ver-receta\"><img src=\"assets/sabores/ver.png\" alt=\"Ver\"> Ver receta</button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"receta-card\" data-recipe=\"recetatomatican\" data-video=\"Hy7joNR9gYQ\" data-mobile-video=\"sqNfzTzyUMg\">\r\n                    <div class=\"receta-imagen-container\">\r\n                        <img src=\"assets/sabores/tomatican.png\" alt=\"Tomatican\" class=\"receta-imagen\">\r\n                        <div class=\"receta-botones\">\r\n                            <button class=\"ver-video\"><img src=\"assets/sabores/video.png\" alt=\"Video\"> Ver video</button>\r\n                            <button class=\"ver-receta\"><img src=\"assets/sabores/ver.png\" alt=\"Ver\"> Ver receta</button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"receta-card\" data-recipe=\"recetachivito\" data-video=\"lQDDoqwfDlI\" data-mobile-video=\"rLPEC8egf-0\">\r\n                    <div class=\"receta-imagen-container\">\r\n                        <img src=\"assets/sabores/chivito.png\" alt=\"Chivito\" class=\"receta-imagen\">\r\n                        <div class=\"receta-botones\">\r\n                            <button class=\"ver-video\"><img src=\"assets/sabores/video.png\" alt=\"Video\"> Ver video</button>\r\n                            <button class=\"ver-receta\"><img src=\"assets/sabores/ver.png\" alt=\"Ver\"> Ver receta</button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"receta-card\" data-recipe=\"recetacroquetas\" data-video=\"2f-b7CG2pXE\" data-mobile-video=\"B_oa0GB3oUU\">\r\n                    <div class=\"receta-imagen-container\">\r\n                        <img src=\"assets/sabores/croquetas.png\" alt=\"Croquetas\" class=\"receta-imagen\">\r\n                        <div class=\"receta-botones\">\r\n                            <button class=\"ver-video\"><img src=\"assets/sabores/video.png\" alt=\"Video\"> Ver video</button>\r\n                            <button class=\"ver-receta\"><img src=\"assets/sabores/ver.png\" alt=\"Ver\"> Ver receta</button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"receta-card\" data-recipe=\"recetalomo\" data-video=\"TWJJQF4EOlY\" data-mobile-video=\"ycU58s2t2vA\">\r\n                    <div class=\"receta-imagen-container\">\r\n                        <img src=\"assets/sabores/lomo.png\" alt=\"Lomo\" class=\"receta-imagen\">\r\n                        <div class=\"receta-botones\">\r\n                            <button class=\"ver-video\"><img src=\"assets/sabores/video.png\" alt=\"Video\"> Ver video</button>\r\n                            <button class=\"ver-receta\"><img src=\"assets/sabores/ver.png\" alt=\"Ver\"> Ver receta</button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"receta-card\" data-recipe=\"recetamembrillos\" data-video=\"vYEvWtfwOB0\" data-mobile-video=\"_9rA-9l6YDM\">\r\n                    <div class=\"receta-imagen-container\">\r\n                        <img src=\"assets/sabores/membrillos.png\" alt=\"Membrillos\" class=\"receta-imagen\">\r\n                        <div class=\"receta-botones\">\r\n                            <button class=\"ver-video\"><img src=\"assets/sabores/video.png\" alt=\"Video\"> Ver video</button>\r\n                            <button class=\"ver-receta\"><img src=\"assets/sabores/ver.png\" alt=\"Ver\"> Ver receta</button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"receta-card\" data-recipe=\"recetasable\" data-video=\"v8yZemCRgSI\" data-mobile-video=\"0zndwh8DKW4\">\r\n                    <div class=\"receta-imagen-container\">\r\n                        <img src=\"assets/sabores/sable.png\" alt=\"Sable\" class=\"receta-imagen\">\r\n                        <div class=\"receta-botones\">\r\n                            <button class=\"ver-video\"><img src=\"assets/sabores/video.png\" alt=\"Video\"> Ver video</button>\r\n                            <button class=\"ver-receta\"><img src=\"assets/sabores/ver.png\" alt=\"Ver\"> Ver receta</button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Sección del video del tomatican -->\r\n        <!-- Sección del video del chef -->\r\n        <div class=\"recetario-header\">\r\n            <h2 class=\"recetario-titulo\">Video | Chef en acción</h2>\r\n        </div>\r\n        <div class=\"video-tomatican-section\">\r\n            <div class=\"video-tomatican-container\">\r\n                <div class=\"video-preview\" data-video=\"eMFpOmKHVX8\">\r\n                    <img src=\"assets/home/fuego.png\" alt=\"Video Tomaticán\" class=\"video-thumbnail\">\r\n                    <button class=\"play-button\">\r\n                        <img src=\"assets/sabores/play.png\" alt=\"Play\">\r\n                    </button>\r\n                </div>\r\n                <iframe id=\"tomatican-player\" \r\n                    style=\"display: none\"\r\n                    frameborder=\"0\" \r\n                    allowfullscreen \r\n                    allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\"\r\n                    data-video=\"eMFpOmKHVX8\">\r\n                </iframe>\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Overlays para recetas y videos -->\r\n        <div id=\"receta-overlay\" class=\"overlay\">\r\n            <div class=\"overlay-content\">\r\n                <button class=\"close-button\">\r\n                    <span class=\"close-icon\">×</span>\r\n                </button>\r\n                <img id=\"receta-imagen\" alt=\"Receta\">\r\n            </div>\r\n        </div>\r\n\r\n        <!-- Botón de cierre para escritorio -->\r\n        <button class=\"close-overlay\" id=\"close-overlay\">\r\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\r\n                <path d=\"M15 5L5 15M5 5L15 15\" stroke=\"black\" stroke-width=\"2\" stroke-linecap=\"round\"/>\r\n            </svg>\r\n        </button>\r\n\r\n        <!-- Overlay para videos -->\r\n        <div id=\"video-overlay\" class=\"overlay\">\r\n            <div class=\"overlay-content video-content\">\r\n                <button class=\"close-button\">\r\n                    <span class=\"close-icon\">×</span>\r\n                </button>\r\n                <div class=\"video-container\">\r\n                    <iframe id=\"youtube-player\" \r\n                            frameborder=\"0\" \r\n                            allowfullscreen \r\n                            allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\"\r\n                            referrerpolicy=\"strict-origin-when-cross-origin\"\r\n                            ></iframe>\r\n                    \r\n                    <!-- Fallback cuando el iframe no funciona -->\r\n                    <div id=\"video-fallback\" class=\"video-fallback\" style=\"display: none;\">\r\n                        <div class=\"fallback-content\">\r\n                            <div class=\"fallback-icon\">📺</div>\r\n                            <h3>Video no disponible para reproducir aquí</h3>\r\n                            <p>Este video tiene restricciones de reproducción. Puedes verlo directamente en YouTube.</p>\r\n                            <button id=\"open-youtube\" class=\"youtube-button\">\r\n                                <img src=\"data:image/svg+xml;base64,\" alt=\"YouTube\">\r\n                                Ver en YouTube\r\n                            </button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </main>\r\n    \r\n    <!-- Cargar el header dinámico primero -->\r\n    <script src=\"js/header.js\"></script>\r\n    <script src=\"js/footer.js\"></script>\r\n    <script src=\"js/sabores.js\"></script>\r\n</body>\r\n</html>\r\n"
