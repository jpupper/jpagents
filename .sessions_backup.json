          "name": "sellos.js",
          "content": "const express = require('express');\nconst fs = require('fs');\nconst path = require('path');\nconst nodemailer = require('nodemailer');\n\nconst router = express.Router();\nconst SELLOS_FILE = path.join(__dirname, '..', 'data', 'sellos.json');\n\n// ─── CONFIGURACION MAIL ──────────────────────────────\n// Si no hay SMTP configurado, imprime a consola y guarda\nconst MAIL_HOST = process.env.SMTP_HOST || '';\nconst MAIL_PORT = parseInt(process.env.SMTP_PORT || '587');\nconst MAIL_USER = process.env.SMTP_USER || '';\nconst MAIL_PASS = process.env.SMTP_PASS || '';\nconst MAIL_FROM = process.env.SMTP_FROM || 'noreply@caminosysabores.com';\n\nfunction createTransport() {\n  if (!MAIL_HOST || !MAIL_USER) {\n    return null; // Sin config SMTP, solo guarda los datos\n  }\n  return nodemailer.createTransport({\n    host: MAIL_HOST,\n    port: MAIL_PORT,\n    secure: MAIL_PORT === 465,\n    auth: { user: MAIL_USER, pass: MAIL_PASS }\n  });\n}\n\nasync function sendStampMail(correo, juego) {\n  const transport = createTransport();\n  if (!transport) {\n    console.log(`  [Sellos] Mail NO enviado (sin SMTP). Para: ${correo}, Juego: ${juego}`);\n    return false;\n  }\n\n  const juegoLabel = juego === 'canasta' ? 'Canasta' : 'Memotest';\n\n  try {\n    await transport.sendMail({\n      from: MAIL_FROM,\n      to: correo,\n      subject: `Sello Pasaporte - Caminos y Sabores - Has ganado en ${juegoLabel}!`,\n      html: `\n        <div style=\"font-family: 'Segoe UI', Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 30px; background: #f9f5f0; border-radius: 16px;\">\n          <div style=\"text-align: center; margin-bottom: 25px;\">\n            <h1 style=\"color: #E6643C; margin: 0; font-size: 28px;\">Caminos y Sabores</h1>\n            <p style=\"color: #888; margin: 5px 0 0; font-size: 14px;\">San Juan - Argentina</p>\n          </div>\n          \n          <div style=\"background: white; border-radius: 12px; padding: 25px; box-shadow: 0 2px 12px rgba(0,0,0,0.06);\">\n            <h2 style=\"color: #333; margin: 0 0 15px; font-size: 20px;\">Felicitaciones!</h2>\n            \n            <p style=\"color: #555; font-size: 15px; line-height: 1.6;\">\n              Has completado exitosamente el juego <strong style=\"color: #E6643C;\">${juegoLabel}</strong> \n              y has ganado un sello para tu <strong>Pasaporte Caminos y Sabores</strong>.\n            </p>\n            \n            <div style=\"background: #fef6f0; border-left: 4px solid #E6643C; padding: 15px 18px; margin: 20px 0; border-radius: 0 8px 8px 0;\">\n              <p style=\"color: #E6643C; font-size: 16px; font-weight: 700; margin: 0 0 5px;\">\n                Presentando este mail podes retirar tu premio!\n              </p>\n              <p style=\"color: #666; font-size: 13px; margin: 0;\">\n                Acercate al stand de Caminos y Sabores en la feria y mostra este correo \n                para recibir tu sello fisico para el pasaporte.\n              </p>\n            </div>\n            \n            <div style=\"margin: 20px 0; padding: 12px; background: #f5f5f5; border-radius: 8px; font-size: 13px; color: #888;\">\n              <p style=\"margin: 0 0 4px;\"><strong>Juego:</strong> ${juegoLabel}</p>\n              <p style=\"margin: 0;\"><strong>Fecha:</strong> ${new Date().toLocaleDateString('es-AR', { day: '2-digit', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' })}</p>\n            </div>\n          </div>\n          \n          <div style=\"text-align: center; margin-top: 20px; color: #aaa; font-size: 12px;\">\n            <p>Caminos y Sabores - San Juan, Argentina</p>\n          </div>\n        </div>\n      `\n    });\n    console.log(`  [Sellos] Mail enviado a ${correo} (${juegoLabel})`);\n    return true;\n  } catch (err) {\n    console.error(`  [Sellos] Error enviando mail a ${correo}:`, err.message);\n    return false;\n  }\n}\n\n// ─── DATA HELPERS ────────────────────────────────────\n\nfunction ensureDir() {\n  const dir = path.dirname(SELLOS_FILE);\n  if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true });\n}\n\nfunction loadSellos() {\n  ensureDir();\n  if (!fs.existsSync(SELLOS_FILE)) return [];\n  try {\n    return JSON.parse(fs.readFileSync(SELLOS_FILE, 'utf-8'));\n  } catch { return []; }\n}\n\nfunction saveSellos(data) {\n  ensureDir();\n  fs.writeFileSync(SELLOS_FILE, JSON.stringify(data, null, 2), 'utf-8');\n}\n\n// ─── API ENDPOINTS ────────────────────────────────────\n\n// POST /api/sellos - Registrar un nuevo sello (desde los juegos)\nrouter.post('/', async (req, res) => {\n  try {\n    const { juego, correo, nombre, apellido } = req.body;\n\n    if (!juego || !correo) {\n      return res.status(400).json({ error: 'Faltan campos obligatorios (juego, correo)' });\n    }\n\n    if (!['canasta', 'memotest'].includes(juego)) {\n      return res.status(400).json({ error: 'Juego invalido. Debe ser canasta o memotest' });\n    }\n\n    const sellos = loadSellos();\n    const entry = {\n      id: Date.now().toString(36) + Math.random().toString(36).slice(2, 6),\n      juego,\n      nombre: nombre || '',\n      apellido: apellido || '',\n      correo,\n      createdAt: new Date().toISOString()\n    };\n\n    sellos.push(entry);\n    saveSellos(sellos);\n\n    // Enviar mail (no bloquea la respuesta)\n    sendStampMail(correo, juego);\n\n    res.status(201).json({ ok: true, sello: entry });\n  } catch (err) {\n    console.error('Error al registrar sello:', err);\n    res.status(500).json({ error: 'Error al registrar sello' });\n  }\n});\n\n// GET /api/sellos - Listar todos los sellos\nrouter.get('/', (req, res) => {\n  try {\n    const sellos = loadSellos();\n    // Sort newest first\n    sellos.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));\n    res.json(sellos);\n  } catch (err) {\n    res.status(500).json({ error: 'Error al cargar sellos' });\n  }\n});\n\n// DELETE /api/sellos/:id - Eliminar un sello\nrouter.delete('/:id', (req, res) => {\n  try {\n    let sellos = loadSellos();\n    const antes = sellos.length;\n    sellos = sellos.filter(s => s.id !== req.params.id);\n    if (sellos.length === antes) {\n      return res.status(404).json({ error: 'Sello no encontrado' });\n    }\n    saveSellos(sellos);\n    res.json({ ok: true });\n  } catch (err) {\n    res.status(500).json({ error: 'Error al eliminar sello' });\n  }\n});\n\nmodule.exports = router;\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/public/js/sellos-modal.js",
          "name": "sellos-modal.js",
          "content": "// ============================================================\n// SELLO MODAL UNIFICADO - Caminos y Sabores\n// Modal de sello de Ischigualasto, usado por:\n//   - Memotest, Canasta (al ganar)\n//   - Red social (al publicar / subir foto en vivo)\n// ============================================================\n\n(function(){\n  // ─── Inject modal HTML into page ───────────────────────\n  const modalHTML = `\n<div class=\"sello-unificado-overlay\" id=\"selloUnificadoOverlay\">\n  <div class=\"sello-unificado-modal\">\n    <img src=\"/selloparqueischigualasto.png\" alt=\"Sello Ischigualasto\" class=\"sello-unificado-img\"\n         onerror=\"this.style.display='none'\">\n    <h2 class=\"sello-unificado-title\" id=\"selloUnificadoTitle\">Felicitaciones, ganaste el sello de Ischigualasto</h2>\n    <p class=\"sello-unificado-desc\" id=\"selloUnificadoDesc\">Presenta este sello para canjearlo por premios.</p>\n\n    <div class=\"sello-unificado-email-box\" id=\"selloEmailBox\">\n      <label class=\"sello-unificado-email-label\">Recibilo por mail</label>\n      <div class=\"sello-unificado-email-row\">\n        <input type=\"email\" id=\"selloUnificadoEmail\" class=\"sello-unificado-email-input\"\n               placeholder=\"tu@correo.com\" autocomplete=\"email\">\n        <button class=\"sello-unificado-btn\" id=\"selloUnificadoBtn\" onclick=\"window._selloReclamar()\">Enviar</button>\n      </div>\n      <div class=\"sello-unificado-msg success\" id=\"selloUnificadoSuccess\">Sello reclamado con exito! Revisa tu correo.</div>\n      <div class=\"sello-unificado-msg error\" id=\"selloUnificadoError\"></div>\n    </div>\n\n    <!-- QR + Codigo (hidden until claimed) -->\n    <div class=\"sello-unificado-qr-box\" id=\"selloQrBox\" style=\"display:none;\">\n      <div class=\"sello-unificado-qr-container\">\n        <div id=\"selloQrCode\"></div>\n      </div>\n      <div class=\"sello-unificado-codigo\" id=\"selloCodigoDisplay\">SJ-ISCH-XXXXXX</div>\n      <p class=\"sello-unificado-codigo-label\">C&oacute;digo &uacute;nico del sello</p>\n    </div>\n\n    <button class=\"sello-unificado-cerrar\" onclick=\"window._selloCerrar()\">Cerrar</button>\n  </div>\n</div>`;\n\n  // Insert modal CSS\n  const style = document.createElement('style');\n  style.textContent = `\n/* ===== SELLO UNIFICADO MODAL ===== */\n.sello-unificado-overlay{\n  display:none;\n  position:fixed;\n  inset:0;\n  background:rgba(0,0,0,0.75);\n  backdrop-filter:blur(8px);\n  z-index:9999;\n  align-items:center;\n  justify-content:center;\n  animation:selloFadeIn 0.4s ease;\n}\n.sello-unificado-overlay.show{display:flex}\n@keyframes selloFadeIn{from{opacity:0}to{opacity:1}}\n.sello-unificado-modal{\n  background:linear-gradient(160deg,rgba(45,31,20,0.97),rgba(26,15,10,0.97));\n  border:1px solid rgba(227,101,59,0.3);\n  border-radius:20px;\n  padding:clamp(20px,5vw,45px);\n  text-align:center;\n  max-width:420px;\n  width:90%;\n  animation:selloScaleIn 0.4s cubic-bezier(0.34,1.56,0.64,1);\n  max-height:90vh;\n  overflow-y:auto;\n}\n@keyframes selloScaleIn{from{transform:scale(0.5);opacity:0}to{transform:scale(1);opacity:1}}\n.sello-unificado-img{\n  width:clamp(120px,30vw,220px);\n  height:auto;\n  margin:0 auto 12px;\n  display:block;\n  border-radius:12px;\n  box-shadow:0 4px 20px rgba(0,0,0,0.4);\n}\n.sello-unificado-title{\n  font-size:clamp(1rem,3.5vw,1.3rem);\n  color:#ea8b34;\n  margin:0 0 6px;\n  line-height:1.3;\n}\n.sello-unificado-desc{\n  font-size:clamp(0.78rem,2.5vw,0.9rem);\n  color:rgba(240,235,216,0.65);\n  margin:0 0 18px;\n}\n.sello-unificado-email-box{\n  border-top:1px solid rgba(227,101,59,0.2);\n  padding-top:14px;\n  margin-top:4px;\n}\n.sello-unificado-email-label{\n  display:block;\n  font-size:clamp(0.75rem,2.3vw,0.85rem);\n  color:#ea8b34;\n  font-weight:600;\n  margin-bottom:8px;\n}\n.sello-unificado-email-row{\n  display:flex;\n  gap:6px;\n}\n.sello-unificado-email-input{\n  flex:1;\n  padding:10px 14px;\n  border:1px solid rgba(255,255,255,0.15);\n  border-radius:10px;\n  background:rgba(255,255,255,0.08);\n  color:#F0EBD8;\n  font-size:clamp(0.8rem,2.5vw,0.9rem);\n  font-family:inherit;\n  outline:none;\n  transition:border-color 0.2s;\n}\n.sello-unificado-email-input::placeholder{color:rgba(255,255,255,0.3);}\n.sello-unificado-email-input:focus{border-color:#e3653b;}\n.sello-unificado-btn{\n  padding:10px 22px;\n  border:none;\n  border-radius:10px;\n  background:linear-gradient(135deg,#e3653b,#c24d28);\n  color:white;\n  font-size:clamp(0.8rem,2.5vw,0.9rem);\n  font-weight:600;\n  font-family:inherit;\n  cursor:pointer;\n  transition:all 0.2s;\n  white-space:nowrap;\n}\n.sello-unificado-btn:hover{transform:translateY(-1px);box-shadow:0 4px 15px rgba(227,101,59,0.4);}\n.sello-unificado-btn:disabled{opacity:0.5;cursor:default;transform:none;box-shadow:none;}\n.sello-unificado-msg{\n  font-size:clamp(0.75rem,2.3vw,0.85rem);\n  margin-top:8px;\n  display:none;\n}\n.sello-unificado-msg.show{display:block;}\n.sello-unificado-msg.success{color:#4ADE80;}\n.sello-unificado-msg.error{color:#ff6b6b;}\n.sello-unificado-cerrar{\n  margin-top:16px;\n  padding:8px 28px;\n  border:1px solid rgba(255,255,255,0.15);\n  border-radius:50px;\n  background:transparent;\n  color:rgba(255,255,255,0.6);\n  font-size:clamp(0.75rem,2.3vw,0.85rem);\n  font-family:inherit;\n  cursor:pointer;\n  transition:all 0.2s;\n}\n.sello-unificado-cerrar:hover{background:rgba(255,255,255,0.08);color:#F0EBD8;}\n/* QR Box */\n.sello-unificado-qr-box{\n  margin-top:14px;\n  padding-top:14px;\n  border-top:1px solid rgba(227,101,59,0.2);\n  animation:selloFadeIn 0.5s ease;\n}\n.sello-unificado-qr-container{\n  display:flex;\n  justify-content:center;\n  margin:0 auto 10px;\n}\n.sello-unificado-qr-container canvas{\n  display:block;\n  border-radius:10px;\n  border:3px solid white;\n  background:white;\n  padding:6px;\n}\n.sello-unificado-codigo{\n  font-family:monospace;\n  font-size:clamp(1.2rem,4vw,1.6rem);\n  font-weight:800;\n  color:#ea8b34;\n  letter-spacing:3px;\n  margin:4px 0 2px;\n}\n.sello-unificado-codigo-label{\n  font-size:clamp(0.65rem,2vw,0.75rem);\n  color:rgba(240,235,216,0.5);\n  margin:0;\n}\n`;\n\n  // Prevent duplicate injection\n  if(document.getElementById('selloUnificadoOverlay')) return;\n\n  document.head.appendChild(style);\n\n  // Insert HTML at end of body\n  const div = document.createElement('div');\n  div.innerHTML = modalHTML;\n  document.body.appendChild(div.firstElementChild);\n\n  // Load QRCode.js from CDN\n  function loadQRCodeLib(callback) {\n    if (window.QRCode) { callback(); return; }\n    const script = document.createElement('script');\n    script.src = 'https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';\n    script.onload = callback;\n    script.onerror = function() {\n      // Fallback: try another CDN\n      const s2 = document.createElement('script');\n      s2.src = 'https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js';\n      s2.onload = callback;\n      document.head.appendChild(s2);\n    };\n    document.head.appendChild(script);\n  }\n\n  let qrInitialized = false;\n  let currentCodigo = '';\n\n  function generateQR(codigo) {\n    currentCodigo = codigo;\n    const container = document.getElementById('selloQrCode');\n    container.innerHTML = '';\n    const validateUrl = getApiBase() + '/validatepass.html?codigo=' + codigo;\n    try {\n      new QRCode(container, {\n        text: validateUrl,\n        width: 160,\n        height: 160,\n        colorDark: '#E6643C',\n        colorLight: '#ffffff',\n        correctLevel: QRCode.CorrectLevel.H\n      });\n    } catch(e) {\n      container.innerHTML = '<div style=\"color:#ea8b34;font-size:0.85rem;\">Error al generar QR</div>';\n    }\n  }\n\n  // ─── Global API ──────────────────────────────────────\n  function getApiBase() {\n    const hostname = window.location.hostname;\n    if (hostname === 'fullscreencode.com') {\n      return 'https://vps-4455523-x.dattaweb.com/caminosysabores';\n    }\n    return window.location.origin;\n  }\n\n  const API_BASE = getApiBase();\n  let currentJuego = '';\n\n  window._selloAbrir = function(juego) {\n    currentJuego = juego;\n    const overlay = document.getElementById('selloUnificadoOverlay');\n    const emailInput = document.getElementById('selloUnificadoEmail');\n    const success = document.getElementById('selloUnificadoSuccess');\n    const error = document.getElementById('selloUnificadoError');\n    const btn = document.getElementById('selloUnificadoBtn');\n    const title = document.getElementById('selloUnificadoTitle');\n    const desc = document.getElementById('selloUnificadoDesc');\n    const emailBox = document.getElementById('selloEmailBox');\n    const qrBox = document.getElementById('selloQrBox');\n\n    // Reset state\n    emailBox.style.display = '';\n    qrBox.style.display = 'none';\n    currentCodigo = '';\n\n    // Mensaje según contexto\n    if (juego === 'envivo' || juego === 'redsocial') {\n      title.textContent = 'Has completado exitosamente el juego En Vivo y has ganado un sello para tu Pasaporte Caminos y Sabores';\n      desc.textContent = '!Felicitaciones! Ganaste el sello Parque Provincial Ischigualasto. Presenta este codigo a uno de nuestros promotores y obtene tu sello fisico para el pasaporte.';\n    } else {\n      title.textContent = '!Felicitaciones! Ganaste el sello Parque Provincial Ischigualasto.';\n      desc.textContent = 'Presenta este codigo a uno de nuestros promotores y obtene tu sello fisico para el pasaporte.';\n    }\n\n    emailInput.value = '';\n    success.classList.remove('show');\n    error.classList.remove('show');\n    btn.disabled = false;\n    btn.textContent = 'Enviar';\n    overlay.classList.add('show');\n  };\n\n  window._selloCerrar = function() {\n    document.getElementById('selloUnificadoOverlay').classList.remove('show');\n    currentJuego = '';\n    currentCodigo = '';\n  };\n\n  window._selloReclamar = function() {\n    const correo = document.getElementById('selloUnificadoEmail').value.trim();\n    const btn = document.getElementById('selloUnificadoBtn');\n    const success = document.getElementById('selloUnificadoSuccess');\n    const error = document.getElementById('selloUnificadoError');\n    const emailBox = document.getElementById('selloEmailBox');\n    const qrBox = document.getElementById('selloQrBox');\n    const codigoDisplay = document.getElementById('selloCodigoDisplay');\n\n    if (!correo) {\n      error.textContent = 'Ingresa tu correo electronico';\n      error.classList.add('show');\n      return;\n    }\n    if (!correo.includes('@')) {\n      error.textContent = 'Correo invalido';\n      error.classList.add('show');\n      return;\n    }\n\n    error.classList.remove('show');\n    btn.disabled = true;\n    btn.textContent = 'Enviando...';\n\n    fetch(API_BASE + '/api/sellos', {\n      method: 'POST',\n      headers: {'Content-Type': 'application/json'},\n      body: JSON.stringify({ juego: currentJuego || 'generico', correo })\n    })\n    .then(r => r.json())\n    .then(data => {\n      if (data.ok) {\n        success.classList.add('show');\n        btn.textContent = 'Enviado!';\n\n        // Show QR + codigo\n        const codigo = data.codigo || data.sello?.codigo || 'ERROR';\n        codigoDisplay.textContent = codigo;\n\n        // Load QR library and generate\n        if (!qrInitialized) {\n          loadQRCodeLib(function() {\n            qrInitialized = true;\n            generateQR(codigo);\n            qrBox.style.display = '';\n          });\n        } else {\n          generateQR(codigo);\n          qrBox.style.display = '';\n        }\n      } else {\n        throw new Error(data.error || 'Error');\n      }\n    })\n    .catch(err => {\n      error.textContent = 'Error. Intentalo de nuevo.';\n      error.classList.add('show');\n      btn.disabled = false;\n      btn.textContent = 'Enviar';\n    });\n  };\n\n  // Close on backdrop click\n  document.getElementById('selloUnificadoOverlay').addEventListener('click', function(e) {\n    if (e.target === this) window._selloCerrar();\n  });\n\n  // Enter key on email input\n  document.getElementById('selloUnificadoEmail').addEventListener('keydown', function(e) {\n    if (e.key === 'Enter') {\n      e.preventDefault();\n      window._selloReclamar();\n    }\n  });\n\n  console.log('Sello Modal Unificado cargado.');\n})();\n"
        },
