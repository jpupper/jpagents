          "path": "D:/Programacion/caminosysabores/public/css/produccion.css",
          "name": "produccion.css",
          "content": "/* Produccion page */\r\n.produccion-hero {\r\n  min-height: 340px;\r\n  height: 340px;\r\n  margin-top: -50px;\r\n  padding-top: 50px;\r\n  display: flex;\r\n  align-items: flex-end;\r\n  position: relative;\r\n  overflow: hidden;\r\n  isolation: isolate;\r\n}\r\n\r\n.produccion-hero::after {\r\n  content: \"\";\r\n  position: absolute;\r\n  inset: 0;\r\n  z-index: 0;\r\n  background: linear-gradient(180deg, rgba(0, 0, 0, 0.06) 18%, rgba(0, 0, 0, 0.18) 48%, rgba(0, 0, 0, 0.52) 100%);\r\n  pointer-events: none;\r\n}\r\n\r\n/* Video de fondo tipo cover */\r\n.hero-video-container {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  z-index: -1;\r\n  overflow: hidden;\r\n  background: #000;\r\n}\r\n\r\n.hero-video-container iframe {\r\n  position: absolute;\r\n  top: 50%;\r\n  left: 50%;\r\n  width: 177.78%;\r\n  height: 177.78%;\r\n  transform: translate(-50%, -50%);\r\n  border: 0;\r\n}\r\n\r\n.produccion-hero .content-container {\r\n  margin: 0 20px 22px;\r\n  position: relative;\r\n  z-index: 1;\r\n}\r\n\r\n.produccion-hero .tagline {\r\n  font-size: 1.8rem;\r\n  line-height: 1.1;\r\n  color: white;\r\n  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.34), 0 1px 2px rgba(0, 0, 0, 0.24);\r\n}\r\n\r\n.produccion-copy {\r\n  margin: 18px 20px 0;\r\n  padding: 0;\r\n}\r\n\r\n.produccion-copy p {\r\n  font-size: 13px;\r\n  line-height: 1.25;\r\n  margin-bottom: 12px;\r\n}\r\n\r\n.produccion-copy .intro-text {\r\n  font-size: 18px;\r\n  font-weight: 400;\r\n  line-height: 1.16;\r\n  margin-bottom: 12px;\r\n}\r\n\r\n.catalog-section {\r\n  margin: 18px 20px 14px;\r\n}\r\n\r\n.cta-button,\r\n.game-button {\r\n  display: inline-flex;\r\n  width: 100%;\r\n  min-height: 38px;\r\n  align-items: center;\r\n  justify-content: center;\r\n  border-radius: 999px;\r\n  background-color: #e6643c;\r\n  color: white;\r\n  text-decoration: none;\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 0.98rem;\r\n  font-weight: 700;\r\n  transition: transform 0.2s ease, box-shadow 0.2s ease;\r\n}\r\n\r\n.cta-button:hover,\r\n.game-button:hover {\r\n  transform: translateY(-1px);\r\n  box-shadow: 0 6px 18px rgba(230, 100, 60, 0.22);\r\n}\r\n\r\n.categories-section {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n  margin: 0 10px;\r\n}\r\n\r\n.category-row {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  gap: 10px;\r\n}\r\n\r\n.category-card {\r\n  position: relative;\r\n  display: block;\r\n  overflow: hidden;\r\n  border-radius: 14px;\r\n  text-decoration: none;\r\n  color: white;\r\n  box-shadow: 0 8px 18px rgba(0, 0, 0, 0.12);\r\n  opacity: 0;\r\n  transform: translateY(18px) scale(0.985);\r\n  animation: mosaicFadeUp 0.92s ease forwards;\r\n}\r\n\r\n.categories-section > .category-card:nth-child(1) {\r\n  animation-delay: 0.16s;\r\n}\r\n\r\n.categories-section > .category-row:nth-child(2) .category-card:first-child {\r\n  animation-delay: 0.28s;\r\n}\r\n\r\n.categories-section > .category-row:nth-child(2) .category-card:last-child {\r\n  animation-delay: 0.4s;\r\n}\r\n\r\n.categories-section > .category-card:nth-child(3) {\r\n  animation-delay: 0.52s;\r\n}\r\n\r\n.categories-section > .category-row:nth-child(4) .category-card:first-child {\r\n  animation-delay: 0.64s;\r\n}\r\n\r\n.categories-section > .category-row:nth-child(4) .category-card:last-child {\r\n  animation-delay: 0.76s;\r\n}\r\n\r\n.categories-section > .category-card:nth-child(5) {\r\n  animation-delay: 0.88s;\r\n}\r\n\r\n.category-card img {\r\n  display: block;\r\n  width: 100%;\r\n  height: auto;\r\n}\r\n\r\n.category-card::after {\r\n  content: \"\";\r\n  position: absolute;\r\n  inset: 0;\r\n  background: linear-gradient(180deg, rgba(0, 0, 0, 0.03) 8%, rgba(0, 0, 0, 0.14) 34%, rgba(0, 0, 0, 0.34) 62%, rgba(0, 0, 0, 0.62) 100%);\r\n}\r\n\r\n.category-label {\r\n  position: absolute;\r\n  left: 12px;\r\n  right: 12px;\r\n  bottom: 10px;\r\n  z-index: 1;\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 0.88rem;\r\n  font-weight: 700;\r\n  line-height: 1.05;\r\n  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.36), 0 1px 2px rgba(0, 0, 0, 0.28);\r\n}\r\n\r\n.game-section {\r\n  margin: 14px 8px 0;\r\n  padding: 10px 0 0;\r\n  margin-bottom: 22px;\r\n  text-align: center;\r\n}\r\n\r\n.game-button {\r\n  margin-bottom: 8px;\r\n}\r\n\r\n.produccion-game-cta {\r\n  flex-direction: column;\r\n  gap: 6px;\r\n  min-height: 108px;\r\n  padding: 16px 18px;\r\n  border-radius: 24px;\r\n  text-align: center;\r\n  box-sizing: border-box;\r\n}\r\n\r\n.produccion-game-title {\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 1.18rem;\r\n  font-weight: 700;\r\n  line-height: 1.05;\r\n  letter-spacing: 0.01em;\r\n}\r\n\r\n.produccion-game-title-highlight {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  white-space: nowrap;\r\n}\r\n\r\n.produccion-game-title-highlight img {\r\n  width: 24px;\r\n  height: auto;\r\n  display: block;\r\n}\r\n\r\n.produccion-game-copy {\r\n  max-width: 290px;\r\n  font-family: \"Ubuntu\", sans-serif;\r\n  font-size: 0.84rem;\r\n  font-weight: 300;\r\n  line-height: 1.2;\r\n}\r\n\r\n@keyframes mosaicFadeUp {\r\n  from {\r\n    opacity: 0;\r\n    transform: translateY(18px) scale(0.985);\r\n  }\r\n  to {\r\n    opacity: 1;\r\n    transform: translateY(0) scale(1);\r\n  }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  .category-card {\r\n    animation: none !important;\r\n    opacity: 1 !important;\r\n    transform: none !important;\r\n  }\r\n}\r\n"
