          "path": "D:/Programacion/caminosysabores/server/routes/admin.js",
          "name": "admin.js",
          "content": "const express = require('express');\nconst fs = require('fs');\nconst path = require('path');\n\nconst router = express.Router();\n\nconst ADMIN_PASS = 'adminsanjuan2026';\n\n// Data files\nconst POSTS_FILE = path.join(__dirname, '..', 'data', 'posts.json');\nconst EVENTO_FILE = path.join(__dirname, '..', 'data', 'evento_fotos.json');\nconst SELLOS_FILE = path.join(__dirname, '..', 'data', 'sellos.json');\nconst USERS_FILE = path.join(__dirname, '..', 'data', 'users.json');\nconst REUNIONES_FILE = path.join(__dirname, '..', 'data', 'reuniones.json');\nconst RS_UPLOADS_DIR = path.join(__dirname, '..', '..', 'public', 'redsocial', 'uploads');\nconst EVENTO_UPLOADS_DIR = path.join(__dirname, '..', '..', 'public', 'redsocial', 'uploads', 'evento');\n\n// ─── AUTH CHECK ──────────────────────────────────────\nfunction checkPass(req, res, next) {\n  const pwd = req.headers['x-admin-password'];\n  if (pwd !== ADMIN_PASS) {\n    return res.status(403).json({ error: 'Acceso denegado' });\n  }\n  next();\n}\n\nrouter.use(checkPass);\n\n// ─── HELPERS ──────────────────────────────────────────\nfunction loadJSON(file) {\n  if (!fs.existsSync(file)) return [];\n  try { return JSON.parse(fs.readFileSync(file, 'utf-8')); } catch { return []; }\n}\n\nfunction saveJSON(file, data) {\n  const dir = path.dirname(file);\n  if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true });\n  fs.writeFileSync(file, JSON.stringify(data, null, 2), 'utf-8');\n}\n\n// ─── POSTS ────────────────────────────────────────────\n\n// GET /api/admin/posts - list all posts\nrouter.get('/posts', (req, res) => {\n  const posts = loadJSON(POSTS_FILE);\n  posts.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));\n  res.json(posts);\n});\n\n// POST /api/admin/posts - create a new post (admin)\nrouter.post('/posts', (req, res) => {\n  try {\n    const { title, content, hashtags, location, image_url, username } = req.body;\n    if (!title || !content) {\n      return res.status(400).json({ error: 'Titulo y contenido son requeridos' });\n    }\n\n    const posts = loadJSON(POSTS_FILE);\n    const newPost = {\n      id: Date.now().toString(),\n      title,\n      content,\n      hashtags: hashtags || '',\n      location: location || '',\n      image_url: image_url || '',\n      user_id: 'admin001',\n      username: username || 'Admin',\n      created_at: new Date().toISOString(),\n      updated_at: new Date().toISOString()\n    };\n\n    posts.push(newPost);\n    saveJSON(POSTS_FILE, posts);\n    res.status(201).json(newPost);\n  } catch (err) {\n    res.status(500).json({ error: 'Error al crear publicacion' });\n  }\n});\n\n// PUT /api/admin/posts/:id - update post\nrouter.put('/posts/:id', (req, res) => {\n  try {\n    const posts = loadJSON(POSTS_FILE);\n    const idx = posts.findIndex(p => p.id === req.params.id);\n    if (idx === -1) return res.status(404).json({ error: 'Publicacion no encontrada' });\n\n    const { title, content, hashtags, location, image_url, username } = req.body;\n    if (title) posts[idx].title = title;\n    if (content) posts[idx].content = content;\n    if (hashtags !== undefined) posts[idx].hashtags = hashtags;\n    if (location !== undefined) posts[idx].location = location;\n    if (image_url !== undefined) posts[idx].image_url = image_url;\n    if (username) posts[idx].username = username;\n    posts[idx].updated_at = new Date().toISOString();\n\n    saveJSON(POSTS_FILE, posts);\n    res.json(posts[idx]);\n  } catch (err) {\n    res.status(500).json({ error: 'Error al actualizar publicacion' });\n  }\n});\n\n// DELETE /api/admin/posts/:id - delete post\nrouter.delete('/posts/:id', (req, res) => {\n  try {\n    let posts = loadJSON(POSTS_FILE);\n    const idx = posts.findIndex(p => p.id === req.params.id);\n    if (idx === -1) return res.status(404).json({ error: 'Publicacion no encontrada' });\n\n    // Delete image file if exists\n    if (posts[idx].image_url) {\n      const imgPath = path.join(RS_UPLOADS_DIR, path.basename(posts[idx].image_url));\n      if (fs.existsSync(imgPath)) fs.unlinkSync(imgPath);\n    }\n\n    posts.splice(idx, 1);\n    saveJSON(POSTS_FILE, posts);\n    res.json({ ok: true });\n  } catch (err) {\n    res.status(500).json({ error: 'Error al eliminar publicacion' });\n  }\n});\n\n// ─── EVENTO FOTOS ─────────────────────────────────────\n\n// GET /api/admin/evento-fotos - list all evento photos\nrouter.get('/evento-fotos', (req, res) => {\n  const fotos = loadJSON(EVENTO_FILE);\n  fotos.sort((a, b) => new Date(b.uploaded_at) - new Date(a.uploaded_at));\n  res.json(fotos);\n});\n\n// DELETE /api/admin/evento-fotos/:id - delete a photo\nrouter.delete('/evento-fotos/:id', (req, res) => {\n  try {\n    let fotos = loadJSON(EVENTO_FILE);\n    const idx = fotos.findIndex(f => f.id === req.params.id);\n    if (idx === -1) return res.status(404).json({ error: 'Foto no encontrada' });\n\n    // Delete file\n    const filePath = path.join(EVENTO_UPLOADS_DIR, fotos[idx].filename);\n    if (fs.existsSync(filePath)) fs.unlinkSync(filePath);\n\n    fotos.splice(idx, 1);\n    saveJSON(EVENTO_FILE, fotos);\n    res.json({ ok: true });\n  } catch (err) {\n    res.status(500).json({ error: 'Error al eliminar foto' });\n  }\n});\n\n// ─── SELLOS ───────────────────────────────────────────\n\n// GET /api/admin/sellos - list all stamps\nrouter.get('/sellos', (req, res) => {\n  const sellos = loadJSON(SELLOS_FILE);\n  sellos.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));\n  res.json(sellos);\n});\n\n// POST /api/admin/sellos - create a stamp manually\nrouter.post('/sellos', (req, res) => {\n  try {\n    const { juego, correo, nombre, apellido } = req.body;\n    if (!juego || !correo) {\n      return res.status(400).json({ error: 'Faltan campos obligatorios (juego, correo)' });\n    }\n\n    const sellos = loadJSON(SELLOS_FILE);\n    const entry = {\n      id: Date.now().toString(36) + Math.random().toString(36).slice(2, 6),\n      juego,\n      nombre: nombre || '',\n      apellido: apellido || '',\n      correo,\n      createdAt: new Date().toISOString()\n    };\n    sellos.push(entry);\n    saveJSON(SELLOS_FILE, sellos);\n    res.status(201).json({ ok: true, sello: entry });\n  } catch (err) {\n    res.status(500).json({ error: 'Error al crear sello' });\n  }\n});\n\n// DELETE /api/admin/sellos/:id - delete stamp\nrouter.delete('/sellos/:id', (req, res) => {\n  try {\n    let sellos = loadJSON(SELLOS_FILE);\n    const antes = sellos.length;\n    sellos = sellos.filter(s => s.id !== req.params.id);\n    if (sellos.length === antes) return res.status(404).json({ error: 'Sello no encontrado' });\n    saveJSON(SELLOS_FILE, sellos);\n    res.json({ ok: true });\n  } catch (err) {\n    res.status(500).json({ error: 'Error al eliminar sello' });\n  }\n});\n\n// ─── REUNIONES ────────────────────────────────────────\n\n// DELETE /api/admin/reuniones/:id - delete form entry\nrouter.delete('/reuniones/:id', (req, res) => {\n  try {\n    let data = loadJSON(REUNIONES_FILE);\n    const antes = data.length;\n    data = data.filter(r => r.id !== req.params.id);\n    if (data.length === antes) return res.status(404).json({ error: 'No encontrado' });\n    saveJSON(REUNIONES_FILE, data);\n    res.json({ ok: true });\n  } catch (err) {\n    res.status(500).json({ error: 'Error al eliminar' });\n  }\n});\n\n// ─── STATS ────────────────────────────────────────────\nrouter.get('/stats', (req, res) => {\n  const posts = loadJSON(POSTS_FILE);\n  const fotos = loadJSON(EVENTO_FILE);\n  const sellos = loadJSON(SELLOS_FILE);\n  const reuniones = loadJSON(REUNIONES_FILE);\n  const users = loadJSON(USERS_FILE);\n  res.json({\n    posts: posts.length,\n    fotos: fotos.length,\n    sellos: sellos.length,\n    reuniones: reuniones.length,\n    users: users.length\n  });\n});\n\nmodule.exports = router;\n"
