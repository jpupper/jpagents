          "name": "index.html",
          "content": "<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0,user-scalable=no\">\n<title>Memotest Caminos y Sabores</title>\n<style>\n/* ===== RESET & ROOT ===== */\n*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}\n:root{\n  --primary:#e3653b;\n  --primary-dark:#c24d28;\n  --secondary:#c2d3eb;\n  --accent:#ea8b34;\n  --olive:#b9bf6e;\n  --dark:#2d1f14;\n  --cream:#fff6e8;\n  --green-deep:#025a35;\n  --coral:#ee8a77;\n  --card-size:clamp(70px,18vw,140px);\n  --gap:clamp(6px,1.5vw,14px);\n  --cols:3;\n}\nbody{\n  font-family:'Segoe UI',system-ui,-apple-system,sans-serif;\n  background:#582927;\n  color:var(--cream);\n  overflow-x:hidden;\n}\n/* ===== BACKGROUND SHADER CANVAS ===== */\n#bg-canvas{\n  position:fixed;\n  inset:0;\n  width:100%;\n  height:100%;\n  z-index:0;\n  pointer-events:none;\n  display:block;\n}\n#app{\n  position:relative;\n  z-index:1;\n  display:flex;\n  flex-direction:column;\n  align-items:center;\n  width:100%;\n  min-height:100vh;\n  padding:10px;\n}\n/* ===== HEADER ===== */\n.header{\n  display:grid;\n  grid-template-columns:repeat(3,var(--card-size));\n  gap:var(--gap);\n  align-items:center;\n  margin:0 auto;\n  padding:8px 0 2px;\n}\n.header .logo{\n  width:100%;\n  height:auto;\n  filter:drop-shadow(0 2px 8px rgba(0,0,0,0.3));\n}\n.header .logo-wrap{\n  display:flex;\n  align-items:center;\n}\n.header .timer-wrap{\n  display:flex;\n  justify-content:flex-end;\n}\n/* ===== TIMER BAR ===== */\n.timer-bar{\n  display:flex;\n  align-items:center;\n  gap:5px;\n  padding:4px 12px;\n  background:rgba(255,255,255,0.06);\n  border-radius:50px;\n  border:1px solid rgba(255,255,255,0.08);\n  backdrop-filter:blur(4px);\n}\n.timer-label{\n  font-size:0.65rem;\n  text-transform:uppercase;\n  letter-spacing:2px;\n  opacity:0.6;\n}\n.timer-value{\n  font-family:monospace;\n  font-size:1.2rem;\n  font-weight:700;\n  color:var(--olive);\n  min-width:50px;\n  text-align:center;\n}\n/* ===== GRID ===== */\n.board{\n  display:grid;\n  grid-template-columns:repeat(var(--cols,3),var(--card-size));\n  gap:var(--gap);\n  justify-content:center;\n  margin:8px auto;\n  max-width:700px;\n  perspective:1200px;\n}\n.board-entering{\n  animation:boardEnter 0.5s ease forwards;\n}\n@keyframes boardEnter{\n  from{opacity:0;transform:translateY(25px) scale(0.93)}\n  to{opacity:1;transform:translateY(0) scale(1)}\n}\n/* ===== CARD ===== */\n.card{\n  width:var(--card-size);\n  height:var(--card-size);\n  cursor:pointer;\n  position:relative;\n  transform-style:preserve-3d;\n  transition:transform 0.5s cubic-bezier(0.4,0,0.2,1);\n  border-radius:12px;\n  outline:2px solid rgba(255,255,255,0.15);\n  outline-offset:2px;\n}\n.card.flipped{transform:rotateY(180deg)}\n.card.matched{\n  transform:rotateY(180deg);\n  box-shadow:0 0 18px rgba(185,191,110,0.5),0 0 40px rgba(185,191,110,0.2),inset 0 0 12px rgba(185,191,110,0.15);\n  animation:match-pop 0.5s cubic-bezier(0.34,1.56,0.64,1) forwards, match-glow 1.2s ease-in-out 0.5s infinite;\n}\n@keyframes match-pop{\n  0%{transform:rotateY(180deg) scale(1)}\n  30%{transform:rotateY(180deg) scale(1.15)}\n  60%{transform:rotateY(180deg) scale(0.97)}\n  100%{transform:rotateY(180deg) scale(1)}\n}\n@keyframes match-glow{\n  0%,100%{box-shadow:0 0 18px rgba(185,191,110,0.5),0 0 40px rgba(185,191,110,0.2),inset 0 0 12px rgba(185,191,110,0.15)}\n  50%{box-shadow:0 0 25px rgba(185,191,110,0.7),0 0 55px rgba(185,191,110,0.3),inset 0 0 18px rgba(185,191,110,0.25)}\n}\n/* Match checkmark overlay */\n.card .match-badge{\n  position:absolute;\n  top:-6px;\n  right:-6px;\n  width:28px;\n  height:28px;\n  border-radius:50%;\n  background:linear-gradient(135deg,var(--olive),#8f9a3a);\n  z-index:10;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  font-size:16px;\n  color:#fff;\n  box-shadow:0 2px 8px rgba(0,0,0,0.4);\n  animation:badgePop 0.4s cubic-bezier(0.34,1.56,0.64,1);\n  pointer-events:none;\n}\n@keyframes badgePop{\n  0%{transform:scale(0) rotate(-45deg);opacity:0}\n  100%{transform:scale(1) rotate(0);opacity:1}\n}\n.card-face{\n  position:absolute;\n  inset:0;\n  border-radius:10px;\n  backface-visibility:hidden;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  overflow:hidden;\n  border:2px solid rgba(255,255,255,0.12);\n  transition:border-color 0.3s;\n}\n.card:hover:not(.flipped):not(.matched) .card-face-back{\n  border-color:var(--accent);\n  box-shadow:0 0 15px rgba(234,139,52,0.3);\n}\n/* Card Back */\n.card-face-back{\n  z-index:2;\n  flex-direction:column;\n  gap:2px;\n}\n/* Card Front */\n.card-face-front{\n  background:var(--dark);\n  transform:rotateY(180deg);\n  z-index:1;\n}\n.card-face-front img{\n  width:100%;\n  height:100%;\n  object-fit:cover;\n  border-radius:8px;\n}\n.card-face-front .card-label{\n  position:absolute;\n  bottom:0;left:0;right:0;\n  background:linear-gradient(transparent,rgba(0,0,0,0.8));\n  padding:4px 6px;\n  font-size:clamp(0.45rem,1.2vw,0.65rem);\n  text-align:center;\n  color:var(--cream);\n  letter-spacing:0.5px;\n}\n/* ===== CELEBRATION ===== */\n.celebration{\n  display:none;\n  position:fixed;\n  inset:0;\n  background:rgba(0,0,0,0.7);\n  backdrop-filter:blur(6px);\n  z-index:100;\n  align-items:center;\n  justify-content:center;\n  animation:fadeIn 0.5s ease;\n}\n.celebration.show{display:flex}\n@keyframes fadeIn{from{opacity:0}to{opacity:1}}\n.celebration-content{\n  background:linear-gradient(145deg,rgba(45,31,20,0.95),rgba(26,15,10,0.95));\n  border:1px solid rgba(227,101,59,0.3);\n  border-radius:20px;\n  padding:clamp(20px,5vw,50px);\n  text-align:center;\n  max-width:420px;\n  width:90%;\n  animation:scaleIn 0.4s cubic-bezier(0.34,1.56,0.64,1);\n}\n@keyframes scaleIn{from{transform:scale(0.5);opacity:0}to{transform:scale(1);opacity:1}}\n.celebration-content .trophy{\n  width:clamp(60px,15vw,110px);\n  height:auto;\n  margin:0 auto 10px;\n  display:block;\n  filter:drop-shadow(0 4px 12px rgba(0,0,0,0.3));\n}\n.celebration-content h2{\n  font-size:clamp(1.3rem,4vw,1.8rem);\n  background:linear-gradient(135deg,var(--accent),var(--primary));\n  -webkit-background-clip:text;\n  -webkit-text-fill-color:transparent;\n  background-clip:text;\n}\n.celebration-content .final-stats{\n  margin:15px 0;\n  font-size:clamp(0.85rem,2.5vw,1rem);\n  opacity:0.9;\n  line-height:1.8;\n}\n.celebration-content .final-stats span{color:var(--accent);font-weight:700}\n.celebration-content .best-badge{\n  display:inline-block;\n  background:linear-gradient(135deg,var(--accent),var(--olive));\n  color:var(--dark);\n  padding:3px 12px;\n  border-radius:20px;\n  font-size:0.8em;\n  font-weight:700;\n}\n.btn{\n  display:inline-block;\n  padding:10px 32px;\n  border-radius:50px;\n  border:none;\n  font-size:clamp(0.85rem,2.5vw,1rem);\n  font-weight:700;\n  cursor:pointer;\n  transition:all 0.3s;\n  text-transform:uppercase;\n  letter-spacing:1px;\n  margin-top:12px;\n}\n.btn-primary{\n  background:linear-gradient(135deg,var(--primary),var(--accent));\n  color:var(--cream);\n}\n.btn-primary:hover{transform:translateY(-2px);box-shadow:0 5px 20px rgba(227,101,59,0.4)}\n.btn-secondary{\n  background:rgba(255,255,255,0.08);\n  color:var(--cream);\n  border:1px solid rgba(255,255,255,0.15);\n  margin-left:8px;\n  font-size:0.75em;\n  padding:8px 18px;\n}\n.btn-secondary:hover{background:rgba(255,255,255,0.15)}\n/* ===== START SCREEN ===== */\n.start-screen{\n  position:fixed;\n  inset:0;\n  z-index:90;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  background:rgba(0,0,0,0.65);\n  backdrop-filter:blur(8px);\n  opacity:1;\n  visibility:visible;\n  transition:opacity 0.4s ease, visibility 0s 0s;\n}\n.start-screen.hidden{\n  opacity:0;\n  visibility:hidden;\n  pointer-events:none;\n  transition:opacity 0.4s ease, visibility 0s 0.4s;\n}\n.start-screen.hidden .start-content{\n  transform:scale(0.9);\n  opacity:0;\n}\n.start-content{\n  text-align:center;\n  animation:scaleIn 0.5s cubic-bezier(0.34,1.56,0.64,1);\n  transition:transform 0.4s ease, opacity 0.4s ease;\n}\n.start-logo{\n  width:clamp(100px,25vw,200px);\n  height:auto;\n  margin-bottom:10px;\n  filter:drop-shadow(0 4px 16px rgba(0,0,0,0.4));\n}\n.start-title{\n  font-size:clamp(1.5rem,5vw,2.2rem);\n  font-weight:800;\n  letter-spacing:3px;\n  text-transform:uppercase;\n  background:linear-gradient(135deg,var(--accent),var(--primary));\n  -webkit-background-clip:text;\n  -webkit-text-fill-color:transparent;\n  background-clip:text;\n  margin-bottom:8px;\n}\n.start-desc{\n  font-size:clamp(0.8rem,2.5vw,1rem);\n  opacity:0.7;\n  margin-bottom:24px;\n  line-height:1.4;\n}\n.btn-start{\n  font-size:clamp(1rem,3vw,1.2rem);\n  padding:14px 48px;\n}\n/* ===== SETTINGS PANEL ===== */\n.settings-overlay{\n  display:none;\n  position:fixed;\n  inset:0;\n  background:rgba(0,0,0,0.6);\n  backdrop-filter:blur(8px);\n  z-index:200;\n  align-items:center;\n  justify-content:center;\n  animation:fadeIn 0.3s ease;\n}\n.settings-overlay.show{display:flex}\n.settings-panel{\n  background:linear-gradient(160deg,rgba(45,31,20,0.97),rgba(26,15,10,0.97));\n  border:1px solid rgba(227,101,59,0.3);\n  border-radius:20px;\n  padding:clamp(16px,4vw,35px);\n  max-width:480px;\n  width:90%;\n  max-height:85vh;\n  overflow-y:auto;\n  animation:scaleIn 0.3s cubic-bezier(0.34,1.56,0.64,1);\n}\n.settings-panel h2{\n  text-align:center;\n  font-size:clamp(1.1rem,3vw,1.4rem);\n  margin-bottom:18px;\n  letter-spacing:2px;\n  text-transform:uppercase;\n  color:var(--accent);\n}\n.settings-group{\n  margin-bottom:18px;\n}\n.settings-group label{\n  display:block;\n  font-size:0.75rem;\n  text-transform:uppercase;\n  letter-spacing:1.5px;\n  opacity:0.6;\n  margin-bottom:6px;\n}\n.settings-group .input-row{\n  display:flex;\n  align-items:center;\n  gap:10px;\n}\n.settings-group input[type=\"range\"]{\n  flex:1;\n  -webkit-appearance:none;\n  appearance:none;\n  height:4px;\n  border-radius:2px;\n  background:rgba(255,255,255,0.15);\n  outline:none;\n}\n.settings-group input[type=\"range\"]::-webkit-slider-thumb{\n  -webkit-appearance:none;\n  appearance:none;\n  width:18px;\n  height:18px;\n  border-radius:50%;\n  background:linear-gradient(135deg,var(--primary),var(--accent));\n  cursor:pointer;\n  border:2px solid rgba(255,255,255,0.3);\n}\n.settings-group .range-val{\n  min-width:32px;\n  text-align:center;\n  font-weight:700;\n  font-size:1.1rem;\n  color:var(--accent);\n}\n.settings-color-row{\n  display:flex;\n  align-items:center;\n  gap:10px;\n}\n.settings-color-row input[type=\"text\"]{\n  flex:1;\n  background:rgba(255,255,255,0.06);\n  border:1px solid rgba(255,255,255,0.12);\n  border-radius:8px;\n  padding:8px 10px;\n  color:var(--cream);\n  font-family:monospace;\n  font-size:0.9rem;\n  letter-spacing:0.5px;\n  outline:none;\n  transition:border-color 0.2s;\n}\n.settings-color-row input[type=\"text\"]:focus{\n  border-color:var(--accent);\n}\n.settings-color-row input[type=\"color\"]{\n  width:40px;\n  height:40px;\n  border:none;\n  border-radius:8px;\n  cursor:pointer;\n  background:none;\n  padding:0;\n  border:1px solid rgba(255,255,255,0.15);\n}\n.settings-color-row input[type=\"color\"]::-webkit-color-swatch-wrapper{padding:0}\n.settings-color-row input[type=\"color\"]::-webkit-color-swatch{border:none;border-radius:6px}\n.settings-actions{\n  display:flex;\n  gap:10px;\n  margin-top:20px;\n}\n.settings-actions button{\n  flex:1;\n  padding:10px;\n  border-radius:12px;\n  border:none;\n  font-weight:700;\n  font-size:0.85rem;\n  cursor:pointer;\n  text-transform:uppercase;\n  letter-spacing:1px;\n  transition:all 0.2s;\n}\n.settings-actions .btn-save{\n  background:linear-gradient(135deg,var(--primary),var(--accent));\n  color:var(--cream);\n}\n.settings-actions .btn-save:hover{transform:translateY(-1px);box-shadow:0 4px 15px rgba(227,101,59,0.4)}\n.settings-actions .btn-close{\n  background:rgba(255,255,255,0.06);\n  color:var(--cream);\n  border:1px solid rgba(255,255,255,0.1);\n}\n.settings-actions .btn-close:hover{background:rgba(255,255,255,0.12)}\n.settings-section-title{\n  font-size:0.8rem;\n  text-transform:uppercase;\n  letter-spacing:2px;\n  color:var(--accent);\n  opacity:0.8;\n  margin-bottom:12px;\n  margin-top:4px;\n  font-weight:600;\n}\n.settings-group input[type=\"number\"]{\n  background:rgba(255,255,255,0.06);\n  border:1px solid rgba(255,255,255,0.12);\n  border-radius:8px;\n  padding:8px 10px;\n  color:var(--cream);\n  font-family:monospace;\n  font-size:0.9rem;\n  width:70px;\n  text-align:center;\n  outline:none;\n}\n.settings-group input[type=\"number\"]:focus{\n  border-color:var(--accent);\n}\n/* ===== CONFETTI ===== */\n.confetti-container{\n  position:fixed;\n  inset:0;\n  pointer-events:none;\n  z-index:101;\n  overflow:hidden;\n}\n.confetti-piece{\n  position:absolute;\n  width:10px;\n  height:10px;\n  top:-20px;\n  animation:confettiFall linear forwards;\n}\n@keyframes confettiFall{\n  0%{transform:translateY(0) rotateX(0deg) rotateY(0deg) rotateZ(0deg);opacity:1}\n  50%{transform:translateY(50vh) rotateX(var(--rx,180deg)) rotateY(var(--ry,360deg)) rotateZ(var(--rz,540deg)) translateX(var(--drift,0px));opacity:0.8}\n  100%{transform:translateY(100vh) rotateX(calc(var(--rx,180deg)*2)) rotateY(calc(var(--ry,360deg)*2)) rotateZ(calc(var(--rz,540deg)*2)) translateX(var(--drift,0px));opacity:0}\n}\n/* ===== RESPONSIVE ===== */\n@media(max-width:480px){\n  :root{--gap:5px}\n  .card{border-radius:7px}\n  .card-face{border-radius:7px}\n  .card-face-front img{border-radius:5px}\n  .stats{padding:6px 10px;gap:10px}\n  .settings-panel{padding:14px}\n}\n@media(min-width:768px){\n  :root{--card-size:150px;--gap:16px}\n}\n/* ===== LOADING ===== */\n.loading{\n  display:flex;\n  flex-direction:column;\n  align-items:center;\n  justify-content:center;\n  height:300px;\n  gap:15px;\n}\n.spinner{\n  width:40px;height:40px;\n  border:3px solid rgba(255,255,255,0.1);\n  border-top-color:var(--primary);\n  border-radius:50%;\n  animation:spin 0.8s linear infinite;\n}\n@keyframes spin{to{transform:rotate(360deg)}}\n/* Hide number spinner arrows */\ninput[type=number]::-webkit-inner-spin-button,\ninput[type=number]::-webkit-outer-spin-button{-webkit-appearance:none;margin:0}\ninput[type=number]{-moz-appearance:textfield}\n</style>\n</head>\n<body>\n<canvas id=\"bg-canvas\"></canvas>\n<div id=\"app\">\n\n<div class=\"header\">\n  <div class=\"timer-wrap\">\n    <div class=\"timer-bar\">\n      <span class=\"timer-label\">Tiempo</span>\n      <span class=\"timer-value\" id=\"timerDisplay\">02:00</span>\n    </div>\n  </div>\n  <div></div>\n  <div class=\"logo-wrap\">\n    <img src=\"imgs/origensanjuan.png\" alt=\"Origen San Juan\" class=\"logo\">\n  </div>\n</div>\n\n<div id=\"board\" class=\"board\" style=\"display:none\"></div>\n\n<!-- START SCREEN -->\n<div class=\"start-screen\" id=\"startScreen\">\n  <div class=\"start-content\">\n    <img src=\"imgs/origensanjuan.png\" alt=\"Origen San Juan\" class=\"start-logo\">\n    <h2 class=\"start-title\">Memotest</h2>\n    <p class=\"start-desc\">Encontrá los 6 pares antes de que se acabe el tiempo</p>\n    <button class=\"btn btn-primary btn-start\" id=\"startBtn\">Comenzar</button>\n  </div>\n</div>\n\n<!-- CELEBRATION OVERLAY -->\n<div class=\"celebration\" id=\"celebration\">\n  <div class=\"celebration-content\">\n    <img src=\"imgs/trofeo.png\" alt=\"Trofeo\" class=\"trophy\">\n    <h2>Completaste el Memotest!</h2>\n    <div class=\"final-stats\">\n      <p>Pares encontrados: <span>6/6</span></p>\n      <p>Movimientos: <span id=\"finalMoves\">0</span></p>\n      <p id=\"bestMsg\"></p>\n    </div>\n    <button class=\"btn btn-primary\" onclick=\"restartGame()\">Jugar de nuevo</button>\n  </div>\n</div>\n\n<div class=\"confetti-container\" id=\"confettiContainer\"></div>\n\n<!-- GAME OVER OVERLAY -->\n<div class=\"celebration\" id=\"gameOverOverlay\">\n  <div class=\"celebration-content\">\n    <div class=\"trophy\">⏰</div>\n    <h2 style=\"background:linear-gradient(135deg,var(--coral),var(--primary));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;\">Se acabó el tiempo!</h2>\n    <div class=\"final-stats\">\n      <p>Pares encontrados: <span id=\"goPairs\">0/6</span></p>\n      <p id=\"goMovesMsg\">Movimientos: <span id=\"goMoves\">0</span></p>\n    </div>\n    <button class=\"btn btn-primary\" onclick=\"restartGame()\">Intentar de nuevo</button>\n  </div>\n</div>\n\n<!-- SETTINGS PANEL -->\n<div class=\"settings-overlay\" id=\"settingsOverlay\">\n  <div class=\"settings-panel\">\n    <h2>Configuración</h2>\n\n    <div class=\"settings-section-title\">Fondo (Shader)</div>\n\n    <div class=\"settings-group\">\n      <label>Displace (noise)</label>\n      <div class=\"input-row\">\n        <input type=\"range\" id=\"setDisplace\" min=\"0\" max=\"500\" step=\"1\" value=\"30\">\n        <span class=\"range-val\" id=\"setDisplaceVal\">30</span>\n      </div>\n    </div>\n\n    <div class=\"settings-group\">\n      <label>Amplitud de onda</label>\n      <div class=\"input-row\">\n        <input type=\"range\" id=\"setAmplitude\" min=\"0\" max=\"100\" step=\"0.5\" value=\"6\">\n        <span class=\"range-val\" id=\"setAmplitudeVal\">6</span>\n      </div>\n    </div>\n\n    <div class=\"settings-group\">\n      <label>Frecuencia de onda</label>\n      <div class=\"input-row\">\n        <input type=\"range\" id=\"setFrequency\" min=\"0\" max=\"50\" step=\"0.5\" value=\"8\">\n        <span class=\"range-val\" id=\"setFrequencyVal\">8</span>\n      </div>\n    </div>\n\n    <div class=\"settings-group\">\n      <label>Separación de líneas</label>\n      <div class=\"input-row\">\n        <input type=\"range\" id=\"setSpacing\" min=\"8\" max=\"80\" step=\"1\" value=\"28\">\n        <span class=\"range-val\" id=\"setSpacingVal\">28</span>\n      </div>\n    </div>\n\n    <div class=\"settings-group\">\n      <label>Grosor de líneas</label>\n      <div class=\"input-row\">\n        <input type=\"range\" id=\"setLineWidth\" min=\"0.5\" max=\"10\" step=\"0.5\" value=\"3\">\n        <span class=\"range-val\" id=\"setLineWidthVal\">3</span>\n      </div>\n    </div>\n\n    <div class=\"settings-group\">\n      <label>Opacidad de líneas</label>\n      <div class=\"input-row\">\n        <input type=\"range\" id=\"setLineOpacity\" min=\"0.05\" max=\"1\" step=\"0.05\" value=\"0.6\">\n        <span class=\"range-val\" id=\"setLineOpacityVal\">0.6</span>\n      </div>\n    </div>\n\n    <div class=\"settings-group\">\n      <label>Ángulo fondo (shader)</label>\n      <div class=\"input-row\">\n        <input type=\"range\" id=\"setBgAngle\" min=\"-90\" max=\"90\" step=\"1\" value=\"45\">\n        <span class=\"range-val\" id=\"setBgAngleVal\">45</span>\n      </div>\n    </div>\n\n    <div class=\"settings-group\">\n      <label>Color de fondo</label>\n      <div class=\"settings-color-row\">\n        <input type=\"text\" id=\"setBgColor\" value=\"#582927\" maxlength=\"7\" placeholder=\"#582927\">\n        <input type=\"color\" id=\"setBgColorPicker\" value=\"#582927\">\n      </div>\n    </div>\n\n    <div class=\"settings-group\">\n      <label>Color de líneas</label>\n      <div class=\"settings-color-row\">\n        <input type=\"text\" id=\"setLineColor\" value=\"#F0EBD8\" maxlength=\"7\" placeholder=\"#F0EBD8\">\n        <input type=\"color\" id=\"setLineColorPicker\" value=\"#F0EBD8\">\n      </div>\n    </div>\n\n    <hr style=\"border:none;border-top:1px solid rgba(255,255,255,0.08);margin:18px 0;\">\n\n    <div class=\"settings-section-title\">Reverso de Cartas</div>\n\n    <div class=\"settings-group\">\n      <label>Displace (noise)</label>\n      <div class=\"input-row\">\n        <input type=\"range\" id=\"setCardDisplace\" min=\"0\" max=\"500\" step=\"1\" value=\"30\">\n        <span class=\"range-val\" id=\"setCardDisplaceVal\">30</span>\n      </div>\n    </div>\n\n    <div class=\"settings-group\">\n      <label>Amplitud de onda</label>\n      <div class=\"input-row\">\n        <input type=\"range\" id=\"setCardAmplitude\" min=\"0\" max=\"100\" step=\"0.5\" value=\"4\">\n        <span class=\"range-val\" id=\"setCardAmplitudeVal\">4</span>\n      </div>\n    </div>\n\n    <div class=\"settings-group\">\n      <label>Frecuencia de onda</label>\n      <div class=\"input-row\">\n        <input type=\"range\" id=\"setCardFrequency\" min=\"0\" max=\"50\" step=\"0.5\" value=\"8\">\n        <span class=\"range-val\" id=\"setCardFrequencyVal\">8</span>\n      </div>\n    </div>\n\n    <div class=\"settings-group\">\n      <label>Separación de líneas</label>\n      <div class=\"input-row\">\n        <input type=\"range\" id=\"setCardSpacing\" min=\"8\" max=\"80\" step=\"1\" value=\"22\">\n        <span class=\"range-val\" id=\"setCardSpacingVal\">22</span>\n      </div>\n    </div>\n\n    <div class=\"settings-group\">\n      <label>Grosor de líneas</label>\n      <div class=\"input-row\">\n        <input type=\"range\" id=\"setCardLineWidth\" min=\"0.5\" max=\"10\" step=\"0.5\" value=\"4\">\n        <span class=\"range-val\" id=\"setCardLineWidthVal\">4</span>\n      </div>\n    </div>\n\n    <div class=\"settings-group\">\n      <label>Opacidad de líneas</label>\n      <div class=\"input-row\">\n        <input type=\"range\" id=\"setCardLineOpacity\" min=\"0.1\" max=\"1\" step=\"0.05\" value=\"1\">\n        <span class=\"range-val\" id=\"setCardLineOpacityVal\">1</span>\n      </div>\n    </div>\n\n    <div class=\"settings-group\">\n      <label>Ángulo</label>\n      <div class=\"input-row\">\n        <input type=\"range\" id=\"setCardAngle\" min=\"-90\" max=\"90\" step=\"1\" value=\"-35\">\n        <span class=\"range-val\" id=\"setCardAngleVal\">-35</span>\n      </div>\n    </div>\n\n    <div class=\"settings-group\">\n      <label>Color de fondo</label>\n      <div class=\"settings-color-row\">\n        <input type=\"text\" id=\"setCardBgColor\" value=\"#F0EBD8\" maxlength=\"7\" placeholder=\"#F0EBD8\">\n        <input type=\"color\" id=\"setCardBgColorPicker\" value=\"#F0EBD8\">\n      </div>\n    </div>\n\n    <div class=\"settings-group\">\n      <label>Color de líneas</label>\n      <div class=\"settings-color-row\">\n        <input type=\"text\" id=\"setCardLineColor\" value=\"#E2643A\" maxlength=\"7\" placeholder=\"#E2643A\">\n        <input type=\"color\" id=\"setCardLineColorPicker\" value=\"#E2643A\">\n      </div>\n    </div>\n\n    <hr style=\"border:none;border-top:1px solid rgba(255,255,255,0.08);margin:18px 0;\">\n\n    <div class=\"settings-section-title\">Tiempo</div>\n\n    <div class=\"settings-group\">\n      <label>Tiempo límite (segundos)</label>\n      <div class=\"input-row\">\n        <input type=\"range\" id=\"setTimerDuration\" min=\"30\" max=\"300\" step=\"10\" value=\"120\">\n        <span class=\"range-val\" id=\"setTimerDurationVal\">120</span>\n      </div>\n    </div>\n\n    <div class=\"settings-actions\">\n      <button class=\"btn-save\" id=\"settingsSaveBtn\">Guardar</button>\n      <button class=\"btn-close\" id=\"settingsCloseBtn\">Cerrar</button>\n    </div>\n  </div>\n</div>\n\n<script>\n// ===== CONFIGURATION SYSTEM =====\n// API base URL detection\nconst csAPIHost = window.location.hostname;\nconst csIsFTP = csAPIHost === 'fullscreencode.com';\nconst csIsLocal = csAPIHost === 'localhost' || csAPIHost === '127.0.0.1';\nconst CS_API_BASE = csIsFTP\n  ? 'https://vps-4455523-x.dattaweb.com/fullscreencode'\n  : csIsLocal\n    ? window.location.origin\n    : window.location.origin + '/fullscreencode';\n\nconst defaultConfig = {\n  rows: 4,\n  displace: 30,\n  amplitude: 6,\n  frequency: 8,\n  spacing: 28,\n  bgAngle: 45,\n  cardAngle: -35,\n  bgColor: '#582927',\n  lineColor: '#F0EBD8',\n  cardBgColor: '#F0EBD8',\n  cardLineColor: '#E2643A',\n  cardDisplace: 30,\n  cardAmplitude: 4,\n  cardFrequency: 8,\n  cardSpacing: 22,\n  timerDuration: 120,\n  lineWidth: 3,\n  lineOpacity: 0.6,\n  cardLineWidth: 4,\n  cardLineOpacity: 1\n};\n\nlet config = {...defaultConfig};\n\nfunction loadConfig(){\n  fetch(CS_API_BASE + '/api/memotest/config')\n    .then(r => { if(!r.ok) throw new Error('No config'); return r.json(); })\n    .then(data => {\n      if(data && Object.keys(data).length > 0){\n        config = {...defaultConfig, ...data};\n      }else{\n        config = {...defaultConfig};\n      }\n      applyConfigToCards();\n    })\n    .catch(() => {\n      config = {...defaultConfig};\n    });\n}\n\nfunction saveConfig(){\n  fetch(CS_API_BASE + '/api/memotest/config', {\n    method: 'POST',\n    headers: { 'Content-Type': 'application/json' },\n    body: JSON.stringify(config),\n  }).catch(() => {});\n}\n\nfunction applyConfigToCards(){\n  // Use tramaobjetos.png as card back pattern image\n  const style = document.createElement('style');\n  style.id = 'card-back-style';\n  const old = document.getElementById('card-back-style');\n  if(old) old.remove();\n  style.textContent = `.card-face-back{background:${config.cardBgColor || config.lineColor} url('imgs/tramaobjetos.png') no-repeat center;background-size:100% 100%;}`;\n  document.head.appendChild(style);\n}\n\nfunction generateCardBackTexture(size){\n  const canvas = document.createElement('canvas');\n  canvas.width = size;\n  canvas.height = size;\n  const ctx = canvas.getContext('2d');\n\n  const bg = config.cardBgColor || config.lineColor;\n  const ln = config.cardLineColor || config.bgColor;\n  const sp = config.cardSpacing || config.spacing;\n  const angle = ((config.cardAngle ?? -45) * Math.PI) / 180;\n  const disp = config.cardDisplace ?? config.displace;\n  const amp = config.cardAmplitude ?? 5;\n  const freq = config.cardFrequency ?? 10;\n\n  ctx.fillStyle = bg;\n  ctx.fillRect(0, 0, size, size);\n\n  ctx.strokeStyle = ln;\n  ctx.lineWidth = config.cardLineWidth || 2;\n  ctx.lineCap = 'round';\n  ctx.globalAlpha = config.cardLineOpacity ?? 1;\n\n  function n2(p){\n    const n = Math.sin(p.x*127.1 + p.y*311.7)*43758.5453;\n    return n - Math.floor(n);\n  }\n  function sn(x,y){\n    const ix = Math.floor(x), iy = Math.floor(y);\n    const fx = x-ix, fy = y-iy;\n    const sx = fx*fx*(3-2*fx), sy = fy*fy*(3-2*fy);\n    const a = n2({x:ix,y:iy}), b = n2({x:ix+1,y:iy});\n    const c = n2({x:ix,y:iy+1}), d = n2({x:ix+1,y:iy+1});\n    return a + (b-a)*sx + (c-a)*sy + (a-b-c+d)*sx*sy;\n  }\n\n  // Rotate context so X axis = line direction, Y axis = perpendicular\n  ctx.save();\n  ctx.translate(size/2, size/2);\n  ctx.rotate(angle);\n  const extent = Math.ceil(size * 0.75);\n  for(let perp=-extent; perp<=extent; perp+=sp){\n    ctx.beginPath();\n    let first = true;\n    for(let along=-extent; along<=extent; along+=1){\n      const noise = sn(along*0.05, perp*0.05);\n      const wave = Math.sin(along*freq*0.05)*amp;\n      const dx = (noise-0.5)*disp + wave;\n      const px = along; // X = along the line\n      const py = perp + dx; // Y = perpendicular + displacement\n      if(first){ ctx.moveTo(px, py); first=false; }\n      else ctx.lineTo(px, py);\n    }\n    ctx.stroke();\n  }\n  ctx.restore();\n\n  return canvas.toDataURL();\n}\n\nfunction applyConfigToGrid(){\n  // Always 3 columns x 4 rows (fixed)\n  document.documentElement.style.setProperty('--cols', '3');\n}\n\nfunction applyConfigToShader(){\n  if(!window._shaderUniforms) return;\n  const u = window._shaderUniforms;\n  // bgColor → vec3\n  const bg = hexToRGB(config.bgColor);\n  const ln = hexToRGB(config.lineColor);\n  gl.uniform3f(u.bgColor, bg.r, bg.g, bg.b);\n  gl.uniform3f(u.lineColor, ln.r, ln.g, ln.b);\n  gl.uniform1f(u.displace, config.displace);\n  gl.uniform1f(u.amp, config.amplitude);\n  gl.uniform1f(u.freq, config.frequency);\n  gl.uniform1f(u.spacing, config.spacing);\n  gl.uniform1f(u.angle, config.bgAngle * 0.0174533);\n  gl.uniform1f(u.lineWidth, config.lineWidth);\n  gl.uniform1f(u.opacity, config.lineOpacity);\n}\n\nfunction applyAllConfig(){\n  applyConfigToCards();\n  applyConfigToGrid();\n  applyConfigToShader();\n  // Rebuild the board with new grid dimensions\n  initGame();\n}\n\nfunction hexToRGB(hex){\n  if(!hex) return {r:0.5,g:0.16,b:0.15};\n  const h = hex.replace('#','');\n  return {\n    r: parseInt(h.substr(0,2),16)/255,\n    g: parseInt(h.substr(2,2),16)/255,\n    b: parseInt(h.substr(4,2),16)/255\n  };\n}\n\n// ===== GAME DATA =====\nconst CARDS_DATA = [\n  {id:'observatorio',   name:'Observatorio',      img:'imgs/1.png'},\n  {id:'ischigualasto',  name:'Ischigualasto',     img:'imgs/2.png'},\n  {id:'circuito',       name:'Circuito Villicum', img:'imgs/3.png'},\n  {id:'ruta_vino',      name:'Ruta del Vino',     img:'imgs/4.png'},\n  {id:'dique',          name:'Dique Punta Negra', img:'imgs/5.png'},\n  {id:'ruta_olivo',     name:'Ruta del Olivo',    img:'imgs/6.png'},\n];\n\n// ===== STATE =====\nlet cards = [];\nlet flippedCards = [];\nlet matchedPairs = 0;\nlet moves = 0;\nlet isLocked = false;\nlet gameStarted = false;\n// Timer state\nlet timeRemaining = 0;\nlet timerInterval = null;\n\n// ===== DOM REFS =====\nconst boardEl = document.getElementById('board');\nconst finalMovesEl = document.getElementById('finalMoves');\nconst bestMsgEl = document.getElementById('bestMsg');\nconst celebrationEl = document.getElementById('celebration');\nconst confettiEl = document.getElementById('confettiContainer');\nconst timerDisplayEl = document.getElementById('timerDisplay');\nconst gameOverEl = document.getElementById('gameOverOverlay');\nconst goPairsEl = document.getElementById('goPairs');\nconst goMovesEl = document.getElementById('goMoves');\nconst startScreenEl = document.getElementById('startScreen');\nconst startBtnEl = document.getElementById('startBtn');\n\n// ===== INIT =====\nfunction initGame(){\n  // Always 3 columns x 4 rows = 12 cards = 6 pairs\n  const totalSlots = 12;\n  const pairsNeeded = 6;\n  const actualCards = 12;\n\n  // Pick that many unique card types\n  const shuffledData = [...CARDS_DATA];\n  shuffle(shuffledData);\n  const usedData = shuffledData.slice(0, pairsNeeded);\n\n  // Build card pairs\n  cards = [];\n  usedData.forEach((data,idx)=>{\n    cards.push({...data,cardId:idx*2,matched:false,flipped:false});\n    cards.push({...data,cardId:idx*2+1,matched:false,flipped:false});\n  });\n  shuffle(cards);\n  flippedCards = [];\n  matchedPairs = 0;\n  moves = 0;\n  isLocked = false;\n  gameStarted = false;\n  celebrationEl.classList.remove('show');\n  gameOverEl.classList.remove('show');\n  confettiEl.innerHTML = '';\n  // Reset timer\n  stopTimer();\n  timeRemaining = config.timerDuration || 120;\n  timerDisplayEl.textContent = formatTime(timeRemaining);\n  timerDisplayEl.style.color = '';\n  // Show start screen, hide board\n  boardEl.style.display = 'none';\n  startScreenEl.classList.remove('hidden');\n  renderBoard();\n}\n\nfunction shuffle(arr){\n  for(let i=arr.length-1;i>0;i--){\n    const j = Math.floor(Math.random()*(i+1));\n    [arr[i],arr[j]] = [arr[j],arr[i]];\n  }\n}\n\nfunction renderBoard(){\n  boardEl.innerHTML = '';\n  cards.forEach((card,i)=>{\n    const div = document.createElement('div');\n    div.className = 'card';\n    div.dataset.index = i;\n    div.innerHTML = `\n      <div class=\"card-face card-face-back\">\n      </div>\n      <div class=\"card-face card-face-front\">\n        <img src=\"${card.img}\" alt=\"${card.name}\" loading=\"lazy\">\n        <div class=\"card-label\">${card.name}</div>\n      </div>\n    `;\n    div.addEventListener('click',()=>flipCard(i));\n    boardEl.appendChild(div);\n  });\n}\n\n// ===== FLIP LOGIC =====\nfunction flipCard(index){\n  if(isLocked) return;\n  const card = cards[index];\n  if(card.matched || card.flipped) return;\n  if(flippedCards.length >= 2) return;\n\n  if(!gameStarted) gameStarted = true;\n\n  card.flipped = true;\n  flippedCards.push(index);\n  updateCardDOM(index);\n\n  if(flippedCards.length === 2){\n    moves++;\n    checkMatch();\n  }\n}\n\nfunction updateCardDOM(index){\n  const cardEls = boardEl.children;\n  const el = cardEls[index];\n  if(cards[index].flipped || cards[index].matched){\n    el.classList.add('flipped');\n  }else{\n    el.classList.remove('flipped');\n  }\n}\n\nfunction checkMatch(){\n  const [i1,i2] = flippedCards;\n  const c1 = cards[i1];\n  const c2 = cards[i2];\n\n  if(c1.id === c2.id && i1 !== i2){\n    // Match!\n    playCollect();\n    triggerShaderEvent(1);\n    c1.matched = true;\n    c2.matched = true;\n    matchedPairs++;\n    flippedCards = [];\n\n    // Add matched class + checkmark badge\n    const els = boardEl.children;\n    els[i1].classList.add('matched');\n    els[i2].classList.add('matched');\n    addMatchBadge(els[i1]);\n    addMatchBadge(els[i2]);\n\n    // Check win\n    if(matchedPairs === 6){\n      setTimeout(winGame,600);\n    }\n  }else{\n    // No match\n    playBad();\n    triggerShaderEvent(2);\n    isLocked = true;\n    setTimeout(()=>{\n      c1.flipped = false;\n      c2.flipped = false;\n      const els = boardEl.children;\n      els[i1].classList.remove('flipped');\n      els[i2].classList.remove('flipped');\n      flippedCards = [];\n      isLocked = false;\n    },900);\n  }\n}\n\n// ===== WIN =====\nfunction winGame(){\n  stopTimer();\n  playVictory();\n  finalMovesEl.textContent = moves;\n  const best = getBestScore();\n  let isNewBest = false;\n  if(best === null || moves < best){\n    saveBestScore(moves);\n    isNewBest = true;\n  }\n  if(isNewBest){\n    bestMsgEl.innerHTML = '&#127942; Nuevo récord! &#127942;';\n  }else{\n    bestMsgEl.textContent = `Mejor: ${getBestScore()} movimientos`;\n  }\n  celebrationEl.classList.add('show');\n  spawnConfetti();\n}\n\n// ===== SCORE =====\nfunction getBestScore(){\n  const val = localStorage.getItem('memotest_cs_best');\n  return val ? parseInt(val,10) : null;\n}\nfunction saveBestScore(n){\n  const best = getBestScore();\n  if(best === null || n < best){\n    localStorage.setItem('memotest_cs_best',n.toString());\n  }\n}\nfunction updateBestScore(){\n  const best = getBestScore();\n  bestEl.textContent = best !== null ? best : '--';\n}\n\n// ===== TIMER =====\nfunction formatTime(secs){\n  const m = Math.floor(secs/60);\n  const s = secs % 60;\n  return `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;\n}\nfunction updateTimerDisplay(){\n  timerDisplayEl.textContent = formatTime(timeRemaining);\n  if(timeRemaining <= 10) timerDisplayEl.style.color = '#ff6b6b';\n  else timerDisplayEl.style.color = '';\n}\nfunction startTimer(){\n  stopTimer();\n  timeRemaining = config.timerDuration || 120;\n  updateTimerDisplay();\n  timerInterval = setInterval(()=>{\n    timeRemaining--;\n    updateTimerDisplay();\n    if(timeRemaining <= 0){\n      stopTimer();\n      gameOver();\n    }\n  },1000);\n}\nfunction stopTimer(){\n  if(timerInterval){\n    clearInterval(timerInterval);\n    timerInterval = null;\n  }\n}\n\n// ===== GAME OVER =====\nfunction gameOver(){\n  goPairsEl.textContent = `${matchedPairs}/6`;\n  goMovesEl.textContent = moves;\n  // Reveal all cards face-up\n  cards.forEach(c=>{ c.flipped = true; });\n  const els = boardEl.children;\n  for(let i=0;i<els.length;i++){\n    els[i].classList.add('flipped');\n  }\n  gameOverEl.classList.add('show');\n}\n\n// ===== MATCH BADGE =====\nfunction addMatchBadge(el){\n  const badge = document.createElement('div');\n  badge.className = 'match-badge';\n  badge.textContent = '✓';\n  const front = el.querySelector('.card-face-front');\n  if(front) front.appendChild(badge);\n  else el.appendChild(badge);\n}\n\n// ===== CONFETTI =====\nfunction spawnConfetti(){\n  const colors = ['#e3653b','#ea8b34','#b9bf6e','#c2d3eb','#ee8a77','#f89bdc','#025a35','#ffd700','#ff6b6b','#5ee0a8','#fff','#f0a0d0','#80d0ff'];\n  confettiEl.innerHTML = '';\n  for(let i=0;i<250;i++){\n    const piece = document.createElement('div');\n    piece.className = 'confetti-piece';\n    const color = colors[Math.floor(Math.random()*colors.length)];\n    const size = 6 + Math.random()*10;\n    const left = Math.random()*100;\n    const dur = 2 + Math.random()*4;\n    const delay = Math.random()*3;\n    const drift = (Math.random()-0.5)*60;\n    // Rotation proportional to speed: faster fall = more spin\n    const speedFactor = 1 / dur;\n    const rx = (180 + Math.random()*540) * speedFactor;\n    const ry = (360 + Math.random()*720) * speedFactor;\n    const rz = (540 + Math.random()*1080) * speedFactor;\n    piece.style.cssText = `\n      left:${left}%;\n      width:${size}px;height:${size}px;\n      background:${color};\n      border-radius:0;\n      animation-duration:${dur}s;\n      animation-delay:${delay}s;\n      transform:rotateX(${Math.random()*360}deg) rotateY(${Math.random()*360}deg) rotateZ(${Math.random()*360}deg);\n      --drift:${drift}px;\n      --rx:${rx}deg;\n      --ry:${ry}deg;\n      --rz:${rz}deg;\n    `;\n    confettiEl.appendChild(piece);\n  }\n  setTimeout(()=>{confettiEl.innerHTML=''},8000);\n}\n\n// ===== SONIDOS (Web Audio) =====\nlet audioCtx = null;\nfunction initAudio() {\n  try {\n    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n    if (audioCtx.state === 'suspended') audioCtx.resume();\n  } catch(e) { console.log('Audio not available:', e.message); }\n}\nfunction playTone(freq, duration, type='sine', vol=0.15) {\n  try {\n    initAudio();\n    const osc = audioCtx.createOscillator();\n    const gain = audioCtx.createGain();\n    osc.type = type;\n    osc.frequency.value = freq;\n    gain.gain.setValueAtTime(vol, audioCtx.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);\n    osc.connect(gain);\n    gain.connect(audioCtx.destination);\n    osc.start();\n    osc.stop(audioCtx.currentTime + duration);\n  } catch(e) {}\n}\nfunction playCollect() {\n  playTone(523, 0.12, 'sine', 0.12);\n  setTimeout(() => playTone(659, 0.1, 'sine', 0.1), 60);\n}\nfunction playBad() {\n  playTone(200, 0.2, 'sawtooth', 0.08);\n  playTone(150, 0.3, 'sawtooth', 0.06);\n}\nfunction playVictory() {\n  playTone(523, 0.15, 'sine', 0.12);  // C5\n  setTimeout(() => playTone(659, 0.15, 'sine', 0.12), 100);  // E5\n  setTimeout(() => playTone(784, 0.15, 'sine', 0.14), 200);  // G5\n  setTimeout(() => playTone(1047, 0.3, 'sine', 0.15), 300);  // C6\n  setTimeout(() => playTone(784, 0.4, 'triangle', 0.1), 450); // G5 tail\n}\n\n// ===== RESTART =====\nfunction restartGame(){\n  initGame();\n}\n\n// ===== START GAME =====\nfunction startGame(){\n  initAudio();\n  startScreenEl.classList.add('hidden');\n  setTimeout(() => {\n    boardEl.style.display = '';\n    boardEl.classList.add('board-entering');\n    gameStarted = true;\n    startTimer();\n    setTimeout(() => boardEl.classList.remove('board-entering'), 600);\n  }, 400);\n}\n\n// ===== SETTINGS PANEL =====\nfunction openSettings(){\n  document.getElementById('settingsOverlay').classList.add('show');\n  // Populate with current config\n  document.getElementById('setDisplace').value = config.displace;\n  document.getElementById('setDisplaceVal').textContent = config.displace;\n  document.getElementById('setAmplitude').value = config.amplitude;\n  document.getElementById('setAmplitudeVal').textContent = config.amplitude;\n  document.getElementById('setFrequency').value = config.frequency;\n  document.getElementById('setFrequencyVal').textContent = config.frequency;\n  document.getElementById('setSpacing').value = config.spacing;\n  document.getElementById('setSpacingVal').textContent = config.spacing;\n  document.getElementById('setBgAngle').value = config.bgAngle;\n  document.getElementById('setBgAngleVal').textContent = config.bgAngle;\n  document.getElementById('setCardAngle').value = config.cardAngle;\n  document.getElementById('setCardAngleVal').textContent = config.cardAngle;\n  document.getElementById('setBgColor').value = config.bgColor.toUpperCase();\n  document.getElementById('setBgColorPicker').value = config.bgColor;\n  document.getElementById('setLineColor').value = config.lineColor.toUpperCase();\n  document.getElementById('setLineColorPicker').value = config.lineColor;\n  document.getElementById('setCardDisplace').value = config.cardDisplace;\n  document.getElementById('setCardDisplaceVal').textContent = config.cardDisplace;\n  document.getElementById('setCardAmplitude').value = config.cardAmplitude;\n  document.getElementById('setCardAmplitudeVal').textContent = config.cardAmplitude;\n  document.getElementById('setCardFrequency').value = config.cardFrequency;\n  document.getElementById('setCardFrequencyVal').textContent = config.cardFrequency;\n  document.getElementById('setCardSpacing').value = config.cardSpacing;\n  document.getElementById('setCardSpacingVal').textContent = config.cardSpacing;\n  document.getElementById('setCardBgColor').value = config.cardBgColor.toUpperCase();\n  document.getElementById('setCardBgColorPicker').value = config.cardBgColor;\n  document.getElementById('setCardLineColor').value = config.cardLineColor.toUpperCase();\n  document.getElementById('setCardLineColorPicker').value = config.cardLineColor;\n  document.getElementById('setTimerDuration').value = config.timerDuration;\n  document.getElementById('setTimerDurationVal').textContent = config.timerDuration;\n  document.getElementById('setLineWidth').value = config.lineWidth;\n  document.getElementById('setLineWidthVal').textContent = config.lineWidth;\n  document.getElementById('setLineOpacity').value = config.lineOpacity;\n  document.getElementById('setLineOpacityVal').textContent = config.lineOpacity;\n  document.getElementById('setCardLineWidth').value = config.cardLineWidth;\n  document.getElementById('setCardLineWidthVal').textContent = config.cardLineWidth;\n  document.getElementById('setCardLineOpacity').value = config.cardLineOpacity;\n  document.getElementById('setCardLineOpacityVal').textContent = config.cardLineOpacity;\n}\n\nfunction closeSettings(){\n  document.getElementById('settingsOverlay').classList.remove('show');\n}\n\n// Apply panel values to visuals in real time (no save, no close)\nfunction liveApply(){\n  config.displace = parseFloat(document.getElementById('setDisplace').value);\n  config.amplitude = parseFloat(document.getElementById('setAmplitude').value);\n  config.frequency = parseFloat(document.getElementById('setFrequency').value);\n  config.spacing = parseFloat(document.getElementById('setSpacing').value);\n  config.bgAngle = parseFloat(document.getElementById('setBgAngle').value);\n  config.cardAngle = parseFloat(document.getElementById('setCardAngle').value);\n  config.bgColor = document.getElementById('setBgColor').value.trim();\n  config.lineColor = document.getElementById('setLineColor').value.trim();\n  config.cardDisplace = parseFloat(document.getElementById('setCardDisplace').value);\n  config.cardAmplitude = parseFloat(document.getElementById('setCardAmplitude').value);\n  config.cardFrequency = parseFloat(document.getElementById('setCardFrequency').value);\n  config.cardSpacing = parseFloat(document.getElementById('setCardSpacing').value);\n  config.lineWidth = parseFloat(document.getElementById('setLineWidth').value);\n  config.lineOpacity = parseFloat(document.getElementById('setLineOpacity').value);\n  config.cardLineWidth = parseFloat(document.getElementById('setCardLineWidth').value);\n  config.cardLineOpacity = parseFloat(document.getElementById('setCardLineOpacity').value);\n  config.cardBgColor = document.getElementById('setCardBgColor').value.trim();\n  config.cardLineColor = document.getElementById('setCardLineColor').value.trim();\n  config.timerDuration = parseInt(document.getElementById('setTimerDuration').value, 10);\n  applyConfigToShader();\n  applyConfigToCards();\n  applyConfigToGrid();\n}\n\nfunction applySettings(){\n  // Read values from panel\n  const displace = parseFloat(document.getElementById('setDisplace').value);\n  const amplitude = parseFloat(document.getElementById('setAmplitude').value);\n  const frequency = parseFloat(document.getElementById('setFrequency').value);\n  const spacing = parseFloat(document.getElementById('setSpacing').value);\n  const bgAngle = parseFloat(document.getElementById('setBgAngle').value);\n  const cardAngle = parseFloat(document.getElementById('setCardAngle').value);\n  let bgColor = document.getElementById('setBgColor').value.trim();\n  let lineColor = document.getElementById('setLineColor').value.trim();\n  const cardDisplace = parseFloat(document.getElementById('setCardDisplace').value);\n  const cardAmplitude = parseFloat(document.getElementById('setCardAmplitude').value);\n  const cardFrequency = parseFloat(document.getElementById('setCardFrequency').value);\n  const cardSpacing = parseFloat(document.getElementById('setCardSpacing').value);\n  const lineWidth = parseFloat(document.getElementById('setLineWidth').value);\n  const lineOpacity = parseFloat(document.getElementById('setLineOpacity').value);\n  const cardLineWidth = parseFloat(document.getElementById('setCardLineWidth').value);\n  const cardLineOpacity = parseFloat(document.getElementById('setCardLineOpacity').value);\n  let cardBgColor = document.getElementById('setCardBgColor').value.trim();\n  let cardLineColor = document.getElementById('setCardLineColor').value.trim();\n  const timerDuration = parseInt(document.getElementById('setTimerDuration').value, 10);\n\n  // Validate hex colors\n  if(!/^#[0-9A-Fa-f]{6}$/.test(bgColor)){\n    bgColor = defaultConfig.bgColor;\n    document.getElementById('setBgColor').value = bgColor;\n  }\n  if(!/^#[0-9A-Fa-f]{6}$/.test(lineColor)){\n    lineColor = defaultConfig.lineColor;\n    document.getElementById('setLineColor').value = lineColor;\n  }\n  if(!/^#[0-9A-Fa-f]{6}$/.test(cardBgColor)){\n    cardBgColor = defaultConfig.cardBgColor;\n    document.getElementById('setCardBgColor').value = cardBgColor;\n  }\n  if(!/^#[0-9A-Fa-f]{6}$/.test(cardLineColor)){\n    cardLineColor = defaultConfig.cardLineColor;\n    document.getElementById('setCardLineColor').value = cardLineColor;\n  }\n\n  config.displace = displace;\n  config.amplitude = amplitude;\n  config.frequency = frequency;\n  config.spacing = spacing;\n  config.bgAngle = bgAngle;\n  config.cardAngle = cardAngle;\n  config.bgColor = bgColor;\n  config.lineColor = lineColor;\n  config.cardDisplace = cardDisplace;\n  config.cardAmplitude = cardAmplitude;\n  config.cardFrequency = cardFrequency;\n  config.cardSpacing = cardSpacing;\n  config.cardBgColor = cardBgColor;\n  config.cardLineColor = cardLineColor;\n  config.timerDuration = timerDuration;\n  config.lineWidth = lineWidth;\n  config.lineOpacity = lineOpacity;\n  config.cardLineWidth = cardLineWidth;\n  config.cardLineOpacity = cardLineOpacity;\n\n  saveConfig();\n  applyAllConfig();\n  closeSettings();\n}\n\n// ===== EVENTS =====\ndocument.getElementById('startBtn').addEventListener('click', startGame);\n\ndocument.getElementById('settingsSaveBtn').addEventListener('click', applySettings);\ndocument.getElementById('settingsCloseBtn').addEventListener('click', closeSettings);\n\n// Close overlay on backdrop click\ndocument.getElementById('settingsOverlay').addEventListener('click', (e)=>{\n  if(e.target === e.currentTarget) closeSettings();\n});\n\n// Sync hex <-> color picker bidirectional + live preview\ndocument.getElementById('setBgColor').addEventListener('input', (e)=>{\n  const v = e.target.value;\n  if(/^#[0-9A-Fa-f]{6}$/.test(v)){ document.getElementById('setBgColorPicker').value = v; liveApply(); }\n});\ndocument.getElementById('setBgColorPicker').addEventListener('input', (e)=>{\n  document.getElementById('setBgColor').value = e.target.value.toUpperCase(); liveApply();\n});\ndocument.getElementById('setLineColor').addEventListener('input', (e)=>{\n  const v = e.target.value;\n  if(/^#[0-9A-Fa-f]{6}$/.test(v)){ document.getElementById('setLineColorPicker').value = v; liveApply(); }\n});\ndocument.getElementById('setLineColorPicker').addEventListener('input', (e)=>{\n  document.getElementById('setLineColor').value = e.target.value.toUpperCase(); liveApply();\n});\ndocument.getElementById('setCardBgColor').addEventListener('input', (e)=>{\n  const v = e.target.value;\n  if(/^#[0-9A-Fa-f]{6}$/.test(v)){ document.getElementById('setCardBgColorPicker').value = v; liveApply(); }\n});\ndocument.getElementById('setCardBgColorPicker').addEventListener('input', (e)=>{\n  document.getElementById('setCardBgColor').value = e.target.value.toUpperCase(); liveApply();\n});\ndocument.getElementById('setCardLineColor').addEventListener('input', (e)=>{\n  const v = e.target.value;\n  if(/^#[0-9A-Fa-f]{6}$/.test(v)){ document.getElementById('setCardLineColorPicker').value = v; liveApply(); }\n});\ndocument.getElementById('setCardLineColorPicker').addEventListener('input', (e)=>{\n  document.getElementById('setCardLineColor').value = e.target.value.toUpperCase(); liveApply();\n});\n\n// Range sliders live update + live preview\ndocument.getElementById('setDisplace').addEventListener('input', (e)=>{\n  document.getElementById('setDisplaceVal').textContent = e.target.value; liveApply();\n});\ndocument.getElementById('setAmplitude').addEventListener('input', (e)=>{\n  document.getElementById('setAmplitudeVal').textContent = e.target.value; liveApply();\n});\ndocument.getElementById('setFrequency').addEventListener('input', (e)=>{\n  document.getElementById('setFrequencyVal').textContent = e.target.value; liveApply();\n});\ndocument.getElementById('setSpacing').addEventListener('input', (e)=>{\n  document.getElementById('setSpacingVal').textContent = e.target.value; liveApply();\n});\ndocument.getElementById('setBgAngle').addEventListener('input', (e)=>{\n  document.getElementById('setBgAngleVal').textContent = e.target.value; liveApply();\n});\ndocument.getElementById('setCardAngle').addEventListener('input', (e)=>{\n  document.getElementById('setCardAngleVal').textContent = e.target.value; liveApply();\n});\ndocument.getElementById('setCardDisplace').addEventListener('input', (e)=>{\n  document.getElementById('setCardDisplaceVal').textContent = e.target.value; liveApply();\n});\ndocument.getElementById('setCardAmplitude').addEventListener('input', (e)=>{\n  document.getElementById('setCardAmplitudeVal').textContent = e.target.value; liveApply();\n});\ndocument.getElementById('setCardFrequency').addEventListener('input', (e)=>{\n  document.getElementById('setCardFrequencyVal').textContent = e.target.value; liveApply();\n});\ndocument.getElementById('setCardSpacing').addEventListener('input', (e)=>{\n  document.getElementById('setCardSpacingVal').textContent = e.target.value; liveApply();\n});\ndocument.getElementById('setTimerDuration').addEventListener('input', (e)=>{\n  document.getElementById('setTimerDurationVal').textContent = e.target.value; liveApply();\n});\ndocument.getElementById('setLineWidth').addEventListener('input', (e)=>{\n  document.getElementById('setLineWidthVal').textContent = e.target.value; liveApply();\n});\ndocument.getElementById('setLineOpacity').addEventListener('input', (e)=>{\n  document.getElementById('setLineOpacityVal').textContent = e.target.value; liveApply();\n});\ndocument.getElementById('setCardLineWidth').addEventListener('input', (e)=>{\n  document.getElementById('setCardLineWidthVal').textContent = e.target.value; liveApply();\n});\ndocument.getElementById('setCardLineOpacity').addEventListener('input', (e)=>{\n  document.getElementById('setCardLineOpacityVal').textContent = e.target.value; liveApply();\n});\n\n// Global key listener\ndocument.addEventListener('keydown',(e)=>{\n  if(e.key==='e'||e.key==='E'){\n    // Stop timer and simulate win\n    stopTimer();\n    // Simulate win: match all remaining cards\n    cards.forEach(c=>{\n      c.matched = true;\n      c.flipped = true;\n    });\n    matchedPairs = cards.length / 2;\n    // Update DOM for all cards\n    const els = boardEl.children;\n    for(let i=0;i<els.length;i++){\n      els[i].classList.add('flipped','matched');\n      if(!els[i].querySelector('.match-badge')) addMatchBadge(els[i]);\n    }\n    setTimeout(winGame,600);\n  }\n  if(e.key==='p'||e.key==='P'){\n    e.preventDefault();\n    if(document.getElementById('settingsOverlay').classList.contains('show')){\n      closeSettings();\n    }else{\n      openSettings();\n    }\n  }\n});\n\n// ===== BACKGROUND SHADER =====\nlet gl = null;\nconst c = document.getElementById('bg-canvas');\ngl = c.getContext('webgl') || c.getContext('experimental-webgl');\n\nlet shaderEventType = 0;\nlet shaderEventStart = 0;\n\nfunction triggerShaderEvent(type){\n  if(type === 0) return;\n  shaderEventType = type;\n  shaderEventStart = performance.now() / 1000;\n}\n\nif(gl){\n  window._shaderUniforms = {};\n\n  function resize(){\n    c.width = window.innerWidth;\n    c.height = window.innerHeight;\n    gl.viewport(0,0,c.width,c.height);\n  }\n  window.addEventListener('resize',resize);\n  resize();\n\n  const vsSrc = 'attribute vec2 p;void main(){gl_Position=vec4(p,0,1);}';\n  const fsSrc = [\n    'precision highp float;',\n    'uniform vec2 r;uniform float t;',\n    'uniform vec3 uBg;',\n    'uniform vec3 uLine;',\n    'uniform float uDisplace;',\n    'uniform float uAmp;',\n    'uniform float uFreq;',\n    'uniform float uSpacing;',\n    'uniform float uAngle;',\n    'uniform float uLineWidth;',\n    'uniform float uOpacity;',\n    'uniform float uEventType;',\n    'uniform float uEventTime;',\n    'float h(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}',\n    'float n(vec2 p){',\n    '  vec2 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);',\n    '  return mix(mix(h(i),h(i+vec2(1,0)),f.x),mix(h(i+vec2(0,1)),h(i+vec2(1,1)),f.x),f.y);',\n    '}',\n    'void main(){',\n    '  vec2 uv=gl_FragCoord.xy/r;',\n    '  float wave=sin(uv.y*uFreq+t*0.6)*uAmp+cos(uv.y*uFreq*0.7+t*0.4)*uAmp*0.75;',\n    '  float d=(n(vec2(uv.x*2.+t*0.006,uv.y*2.))-.5)*uDisplace+wave;',\n    '  float ca=cos(uAngle),sa=sin(uAngle);',\n    '  float rotX=gl_FragCoord.x*ca-gl_FragCoord.y*sa;',\n    '  float pos=mod(rotX+d,uSpacing);',\n    '  float dist=min(pos,uSpacing-pos);',\n    '  float line=1.-smoothstep(0.,uLineWidth,dist);',\n    '  vec3 finalBg=uBg;',\n    '  vec3 finalLine=uLine;',\n    '  float finalOp=uOpacity;',\n    '  if(uEventTime>0.){',\n    '    float ei=min(1.,uEventTime/1.5);',\n    '    float ease=ei*ei*(3.-2.*ei);',\n    '    if(uEventType>1.5){',\n    '      finalBg=mix(uBg,vec3(0.5,0.08,0.06),ease*0.35);',\n    '      finalLine=mix(uLine,vec3(1.,0.25,0.15),ease*0.7);',\n    '      finalOp=min(1.,finalOp+ease*0.4);',\n    '    }else{',\n    '      finalBg=mix(uBg,vec3(0.12,0.18,0.06),ease*0.3);',\n    '      finalLine=mix(uLine,vec3(0.95,0.82,0.4),ease*0.65);',\n    '      finalOp=min(1.,finalOp+ease*0.25);',\n    '    }',\n    '  }',\n    '  gl_FragColor=vec4(mix(finalBg,finalLine,line*finalOp),1);',\n    '}'\n  ].join('');\n\n  function shader(type,src){\n    const s=gl.createShader(type);\n    gl.shaderSource(s,src);\n    gl.compileShader(s);\n    return s;\n  }\n  const vs=shader(gl.VERTEX_SHADER,vsSrc);\n  const fs=shader(gl.FRAGMENT_SHADER,fsSrc);\n  const prog=gl.createProgram();\n  gl.attachShader(prog,vs);\n  gl.attachShader(prog,fs);\n  gl.linkProgram(prog);\n  gl.useProgram(prog);\n\n  const buf=gl.createBuffer();\n  gl.bindBuffer(gl.ARRAY_BUFFER,buf);\n  gl.bufferData(gl.ARRAY_BUFFER,new Float32Array([-1,-1, 3,-1, -1,3]),gl.STATIC_DRAW);\n  const loc=gl.getAttribLocation(prog,'p');\n  gl.enableVertexAttribArray(loc);\n  gl.vertexAttribPointer(loc,2,gl.FLOAT,false,0,0);\n\n  const uR=gl.getUniformLocation(prog,'r');\n  const uT=gl.getUniformLocation(prog,'t');\n  const uBg=gl.getUniformLocation(prog,'uBg');\n  const uLine=gl.getUniformLocation(prog,'uLine');\n  const uDisplace=gl.getUniformLocation(prog,'uDisplace');\n  const uAmp=gl.getUniformLocation(prog,'uAmp');\n  const uFreq=gl.getUniformLocation(prog,'uFreq');\n  const uSpacing=gl.getUniformLocation(prog,'uSpacing');\n  const uAngle=gl.getUniformLocation(prog,'uAngle');\n  const uLineWidth=gl.getUniformLocation(prog,'uLineWidth');\n  const uOpacity=gl.getUniformLocation(prog,'uOpacity');\n  const uEventType=gl.getUniformLocation(prog,'uEventType');\n  const uEventTime=gl.getUniformLocation(prog,'uEventTime');\n\n  window._shaderUniforms = {bgColor:uBg, lineColor:uLine, displace:uDisplace, amp:uAmp, freq:uFreq, spacing:uSpacing, angle:uAngle, lineWidth:uLineWidth, opacity:uOpacity};\n\n  // Set initial values from config\n  function loop(time){\n    gl.uniform2f(uR,c.width,c.height);\n    gl.uniform1f(uT,time/1000);\n    const bg = hexToRGB(config.bgColor);\n    const ln = hexToRGB(config.lineColor);\n    gl.uniform3f(uBg, bg.r, bg.g, bg.b);\n    gl.uniform3f(uLine, ln.r, ln.g, ln.b);\n    gl.uniform1f(uDisplace, config.displace);\n    gl.uniform1f(uAmp, config.amplitude);\n    gl.uniform1f(uFreq, config.frequency);\n    gl.uniform1f(uSpacing, config.spacing);\n    gl.uniform1f(uAngle, config.bgAngle * 0.0174533);\n    gl.uniform1f(uLineWidth, config.lineWidth);\n    gl.uniform1f(uOpacity, config.lineOpacity);\n    // Event animation\n    const now = time / 1000;\n    let eventTime = 0;\n    if(shaderEventType > 0){\n      eventTime = Math.max(0, 1.5 - (now - shaderEventStart));\n      if(eventTime <= 0) shaderEventType = 0;\n    }\n    gl.uniform1f(uEventType, shaderEventType);\n    gl.uniform1f(uEventTime, eventTime);\n    gl.drawArrays(gl.TRIANGLES,0,3);\n    requestAnimationFrame(loop);\n  }\n  requestAnimationFrame(loop);\n}\n\n// ===== START =====\nloadConfig();\napplyConfigToCards();\napplyConfigToGrid();\ninitGame();\n</script>\n</body>\n</html>\n"
