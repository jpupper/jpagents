          "name": "upload_sitio_files.js",
          "content": "require('dotenv').config({ path: require('path').join(__dirname, '..', 'server', '.env') });\nconst ftp = require('basic-ftp');\nconst path = require('path');\nconst fs = require('fs');\n\nconst ROOT = path.join(__dirname, '..', 'public');\n\nasync function uploadFile(client, localPath, remotePath) {\n  try {\n    await client.uploadFrom(localPath, remotePath);\n    return true;\n  } catch (e) {\n    console.log('FAIL: ' + remotePath + ' - ' + e.message);\n    return false;\n  }\n}\n\nasync function uploadDir(client, localDir, remoteDir) {\n  if (!fs.existsSync(localDir)) return;\n  const items = fs.readdirSync(localDir);\n  for (const item of items) {\n    const localPath = path.join(localDir, item);\n    const remotePath = remoteDir + '/' + item;\n    const stat = fs.statSync(localPath);\n    if (stat.isFile()) {\n      await uploadFile(client, localPath, remotePath);\n    } else if (stat.isDirectory()) {\n      await uploadDir(client, localPath, remotePath);\n    }\n  }\n}\n\nasync function upload() {\n  const client = new ftp.Client();\n  client.ftp.verbose = false;\n  \n  try {\n    await client.access({\n      host: process.env.FTP_HOST,\n      user: process.env.FTP_USER,\n      password: process.env.FTP_PASS,\n      secure: true,\n      secureOptions: { rejectUnauthorized: false }\n    });\n\n    const remoteDir = '/trabajos/caminosysabores';\n    console.log('Connected to FTP. Uploading site files...');\n\n    // Core HTML pages\n    const htmlFiles = [\n      'index.html', 'home.html', 'show.html', 'taller.html', 'sorteo.html',\n      'sabores.html', 'productores.html', 'turismo.html', 'actividades.html',\n      'produccion.html', 'reuniones.html', 'comex.html', 'prensa.html', \n      'adminsitio.html', 'paginaacceso.html', 'recorrido.html'\n    ];\n    for (const file of htmlFiles) {\n      const localPath = path.join(ROOT, file);\n      if (fs.existsSync(localPath)) {\n        await uploadFile(client, localPath, remoteDir + '/' + file);\n      }\n    }\n\n    // CSS\n    await uploadDir(client, path.join(ROOT, 'css'), remoteDir + '/css');\n    \n    // JS\n    await uploadDir(client, path.join(ROOT, 'js'), remoteDir + '/js');\n\n    // Assets root files\n    const rootAssets = ['1.png', '2.png', '3.png', 'Taller de cultivos sanjuaninos.png'];\n    for (const f of rootAssets) {\n      const lp = path.join(ROOT, 'assets', f);\n      if (fs.existsSync(lp)) await uploadFile(client, lp, remoteDir + '/assets/' + f);\n    }\n\n    // Assets subdirs\n    const assetSubdirs = ['landing', 'home', 'show', 'sabores', 'productores', 'turismo', 'sorteo', 'taller'];\n\n    // COMEX assets (renamed from CONEX)\n    const comexAssetsDir = path.join(ROOT, 'assets_comex');\n    if (fs.existsSync(comexAssetsDir)) {\n      await uploadDir(client, comexAssetsDir, remoteDir + '/assets_comex');\n    }\n    for (const sub of assetSubdirs) {\n      await uploadDir(client, path.join(ROOT, 'assets', sub), remoteDir + '/assets/' + sub);\n    }\n\n    // MAQUETA 3D - Modelos, config, POIs, imagenes\n    await uploadDir(client, path.join(ROOT, 'maqueta'), remoteDir + '/maqueta');\n\n    console.log('Upload complete! All site files uploaded successfully.');\n  } catch (err) {\n    console.error('Error:', err.message);\n  } finally {\n    client.close();\n  }\n}\n\nupload();\n"
        },
