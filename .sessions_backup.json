        {
          "path": "D:/Programacion/caminosysabores/public/css/backbutton.css",
          "name": "backbutton.css",
          "content": "/* backbutton.css - Botón flotante para volver al inicio */\n.backbutton-root {\n  position: fixed;\n  bottom: 24px;\n  left: 24px;\n  width: 48px;\n  height: 48px;\n  border-radius: 50%;\n  border: 2px solid rgba(230, 100, 60, 0.35);\n  background: rgba(255, 255, 255, 0.92);\n  color: #e6643c;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  z-index: 9999;\n  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.15);\n  transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;\n  backdrop-filter: blur(6px);\n  -webkit-backdrop-filter: blur(6px);\n}\n\n.backbutton-root:hover {\n  transform: scale(1.08);\n  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);\n  background: #fff;\n}\n\n.backbutton-root:active {\n  transform: scale(0.95);\n}\n\n.backbutton-root svg {\n  width: 20px;\n  height: 20px;\n  display: block;\n}\n\n@media (max-width: 768px) {\n  .backbutton-root {\n    bottom: 16px;\n    left: 16px;\n    width: 42px;\n    height: 42px;\n  }\n  .backbutton-root svg {\n    width: 18px;\n    height: 18px;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .backbutton-root {\n    transition: none;\n  }\n}\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/public/js/backbutton.js",
          "name": "backbutton.js",
          "content": "// backbutton.js - Botón flotante para volver al inicio del sitio\n(function () {\n  \"use strict\";\n\n  function createBackButton() {\n    // No duplicar si ya existe\n    if (document.querySelector(\".backbutton-root\")) return;\n\n    var btn = document.createElement(\"button\");\n    btn.className = \"backbutton-root\";\n    btn.type = \"button\";\n    btn.setAttribute(\"aria-label\", \"Volver al inicio\");\n\n    // Icono flecha izquierda SVG inline\n    btn.innerHTML =\n      '<svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">' +\n      '<path d=\"M15.5 5.5L9 12l6.5 6.5\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>' +\n      \"</svg>\";\n\n    // Click → siempre al root del sitio\n    btn.addEventListener(\"click\", function () {\n      window.location.href = window.location.origin + \"/\";\n    });\n\n    // Append al final del body\n    document.body.appendChild(btn);\n  }\n\n  // Esperar a que el DOM esté listo\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", createBackButton);\n  } else {\n    createBackButton();\n  }\n})();\n"
        },
