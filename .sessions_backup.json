r\n}\r\nfunction applyAllSpeeds() { state.layers.forEach(applySpeed); }\r\n/* ¿por qué no se ve esta capa? — para avisar en vez de dejar el misterio */\r\nfunction layerMutedReason(l) {\r\n  const L = state.layers[l];\r\n  if (L.byp) return 'bypass (botón B)';\r\n  if (state.layers.some(x => x.solo) && !L.solo) return 'otra capa está en SOLO';\r\n  if (L.opacity < .02) return 'opacidad en 0';\r\n  const xa = Math.min(1, 2 - 2 * state.xfade), xb = Math.min(1, 2 * state.xfade);\r\n  if (l < 2 && xa < .04) return 'el crossfader está todo en B — movelo al centro';\r\n  if (l >= 2 && xb < .04) return 'el crossfader está todo en A — movelo al centro';\r\n  if (state.blackout) return 'BLACKOUT activo';\r\n  if (state.master < .02) return 'master en 0';\r\n  return null;\r\n}\r\nfunction layerAdvance(l) {\r\n  const L = state.layers[l];\r\n  const cells = state.grid[l].filter(c => c.kind !== 'empty' &&\r\n    !(c.kind === 'video' && !c.video) && !(c.kind === 'gif' && !c.gframes));\r\n  if (!cells.length) return;\r\n  const cur = L.slots[L.target].cell;\r\n  let next;\r\n  if (L.auto.rand && cells.length > 1) {\r\n    do { next = cells[Math.floor(Math.random() * cells.length)]; } while (next === cur);\r\n  } else {\r\n    next = cells[(cells.indexOf(cur) + 1) % cells.length];\r\n  }\r\n  if (!next || next === cur) return;\r\n  if (L.auto.dip && cur) { L._dipCell = next; clearLayer(l); }\r\n  else triggerCell(l, next.c);\r\n}\r\n\r\n/* ---------------- render loop ---------------- */\r\n/* procesado por slot: (fit + transform del clip →) efecto de capa → FBO propio */\r\nfunction layerFxPass(s, tex, fit, L, tr) {\r\n  const gl = main.gl;\r\n  const def = FXDEFS.find(d => d.id === L.fx.id);\r\n  const hasTr = tr && (tr.sc !== 1 || tr.x || tr.y || tr.rot);\r\n  let src = tex;\r\n  if (fit[0] !== 1 || fit[1] !== 1 || hasTr) {\r\n    if (!s.nT) s.nT = makeTarget(gl, state.res[0], state.res[1]);\r\n    const bp = program(main, 'fitblit', FITBLIT_FS);\r\n    gl.bindFramebuffer(gl.F