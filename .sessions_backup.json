px;\r\n    }\r\n\r\n    .card p {\r\n      font-size: 13px;\r\n      color: rgba(240, 230, 208, 0.5);\r\n      line-height: 1.4;\r\n    }\r\n\r\n    .card .tag {\r\n      display: inline-block;\r\n      margin-top: 12px;\r\n      padding: 4px 14px;\r\n      border-radius: 20px;\r\n      font-size: 11px;\r\n      font-weight: 600;\r\n      letter-spacing: 0.5px;\r\n      text-transform: uppercase;\r\n    }\r\n\r\n    .tag-botonera { background: rgba(204, 34, 34, 0.2); color: #cc4444; border: 1px solid rgba(204, 34, 34, 0.3); }\r\n    .tag-maqueta  { background: rgba(112, 140, 106, 0.2); color: #8caa80; border: 1px solid rgba(112, 140, 106, 0.3); }\r\n    .tag-sitio    { background: rgba(91, 125, 255, 0.2); color: #7b9dff; border: 1px solid rgba(91, 125, 255, 0.3); }\r\n    .tag-redsocial { background: rgba(201, 107, 75, 0.2); color: #C96B4B; border: 1px solid rgba(201, 107, 75, 0.3); }\r\n\r\n    footer {\r\n      margin-top: 48px;\r\n      font-size: 12px;\r\n      color: rgba(240, 230, 208, 0.2);\r\n      letter-spacing: 0.5px;\r\n    }\r\n\r\n    @media (max-width: 600px) {\r\n      .grid { grid-template-columns: 1fr; }\r\n      h1 { font-size: 22px; }\r\n    }\r\n  </style>\r\n</head>\r\n<body>\r\n  <h1>Expo Rural San Juan</h1>\r\n  <div class=\"sub\">San Juan · Territorio Turístico</div>\r\n\r\n  <div class=\"grid\">\r\n    <a class=\"card\" href=\"botonera/\">\r\n      <span class=\"icon\">🎛️</span>\r\n      <h2>Botonera</h2>\r\n      <p>Prototipo 3D interactivo de la botonera física</p>\r\n      <span class=\"tag tag-botonera\">3D Interactivo</span>\r\n    </a>\r\n\r\n    <a class=\"card\" href=\"maqueta/\">\r\n      <span class=\"icon\">🗺️</span>\r\n      <h2>Maqueta</h2>\r\n      <p>Mapa 3D del territorio sanjuanino con puntos turísticos</p>\r\n      <span class=\"tag tag-maqueta\">3D Territorio</span>\r\n    </a>\r\n\r\n    <a class=\"card\" href=\"sitio/\">\r\n      <span class=\"icon\">🌐</span>\r\n      <h2>Sitio Web</h2>\r\n      <p>Página web informativa del proyecto</p>\r\n      <span class=\"tag tag-sitio\">Online</span>\r\n    </a>\r\n\r\n    <a class=\"card\" href=\"https://fullscreencode.com/3dlayerterraingenerator/\" target=\"_blank\">\r\n      <span class=\"icon\">🏔️</span>\r\n      <h2>Terrain Maker</h2>\r\n      <p>Generador de maquetas topográficas 3D desde imágenes</p>\r\n      <span class=\"tag tag-botonera\">3D Generator</span>\r\n    </a>\r\n\r\n    <a class=\"card\" href=\"canasta/\">\r\n      <span class=\"icon\">🧺</span>\r\n      <h2>Canasta</h2>\r\n      <p>Atrapá los productos de San Juan que caen del cielo</p>\r\n      <span class=\"tag tag-sitio\">Juego</span>\r\n    </a>\r\n\r\n    <a class=\"card\" href=\"memotest/\">\r\n      <span class=\"icon\">🃏</span>\r\n      <h2>Memotest</h2>\r\n      <p>Encontrá los pares de los destinos sanjuaninos</p>\r\n      <span class=\"tag tag-sitio\">Juego</span>\r\n    </a>\r\n\r\n    <a class=\"card\" href=\"redsocial/\">\r\n      <span class=\"icon\">🌍</span>\r\n      <h2>Red Social</h2>\r\n      <p>Compartí tus lugares favoritos de San Juan con la comunidad</p>\r\n      <span class=\"tag tag-redsocial\">Comunidad</span>\r\n    </a>\r\n  </div>\r\n\r\n  <footer>San Juan · Argentina</footer>\r\n</body>\r\n</html>\r\n"
