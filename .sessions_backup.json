        {
          "path": "D:/Programacion/caminosysabores/deploy_scripts/test_mimic.js",
          "name": "test_mimic.js",
          "content": "require('dotenv').config({ path: require('path').join(__dirname, '..', 'server', '.env') });\nconst ftp = require('basic-ftp');\nconst path = require('path');\nconst fs = require('fs');\n\nasync function test() {\n  const client = new ftp.Client();\n  client.ftp.verbose = true;\n\n  try {\n    await client.access({\n      host: process.env.FTP_HOST,\n      user: process.env.FTP_USER,\n      password: process.env.FTP_PASS,\n      secure: true,\n      secureOptions: { rejectUnauthorized: false }\n    });\n\n    const base = '/trabajos/caminosysabores/test_mimic';\n\n    // Simular la estructura real: upload a subdirectorios con ensureDir cada vez\n    const dirs = [\n      'root1',\n      'sub1/sub2',\n      'sub1/sub2/sub3',\n      'deep/a/b/c/d/e',\n      'assets/home',\n      'assets/produccion',\n      'assets/landing',\n      'assets/Actividades/a_la_mesa',\n      'productores/vinos',\n      'productores/aceitedeoliva',\n      'turismo/ischigualasto',\n      'turismo/rutadelolivo',\n      'canasta/assets/correctos',\n      'canasta/assets/incorrectos',\n      'exporural/assets/mineria',\n    ];\n\n    let count = 0;\n    for (const subdir of dirs) {\n      const remoteDir = base + '/' + subdir;\n      for (let i = 0; i < 5; i++) {\n        count++;\n        await client.ensureDir(remoteDir);\n        const tmp = path.join(__dirname, `mm_${count}.txt`);\n        fs.writeFileSync(tmp, `mimic ${count}`);\n        await client.uploadFrom(tmp, `mm_${count}.txt`);\n        fs.unlinkSync(tmp);\n        console.log(`OK ${count} -> ${remoteDir}`);\n      }\n    }\n\n    // Limpiar\n    for (const subdir of [...dirs].reverse()) {\n      try {\n        const items = await client.list();\n        for (const item of items) {\n          if (item.name.startsWith('mm_')) {\n            await client.remove(item.name);\n          }\n        }\n        await client.cd(base);\n        await client.removeDir(subdir);\n      } catch (e) {\n        // ignore\n      }\n    }\n\n    console.log(`COMPLETADO: ${count} uploads`);\n  } catch (e) {\n    console.log('FALLO en upload', count, ':', e.code, e.message);\n  }\n  client.close();\n}\n\ntest();\n"
        },
