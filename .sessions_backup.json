          "name": "index.html",
          "content": "<!DOCTYPE html>\r\n<html lang=\"es\">\r\n<head>\r\n<meta charset=\"UTF-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, user-scalable=no\">\r\n<title>Canasta - Caminos y Sabores</title>\r\n<style>\r\n*{margin:0;padding:0;box-sizing:border-box}\r\nbody{overflow:hidden;background:#0a0a0a;font-family:'Segoe UI',Arial,sans-serif;user-select:none;-webkit-user-select:none;touch-action:none}\r\n#shaderCanvas{display:block;position:fixed;top:0;left:0;width:100%;height:100%;z-index:-1}\r\n#gameCanvas{display:block;position:fixed;top:0;left:0;width:100%;height:100%;z-index:0;background:transparent}\r\n#panelHint{position:fixed;top:12px;right:16px;color:rgba(255,255,255,0.3);font-size:11px;z-index:999;transition:opacity .3s;pointer-events:none;font-family:monospace}\r\n#panelHint.hidden{opacity:0}\r\n#controlPanel{position:fixed;top:0;right:-420px;width:380px;max-width:92vw;height:100vh;background:rgba(10,10,15,0.95);border-left:2px solid rgba(226,100,58,0.4);padding:20px;z-index:1000;transition:right .35s cubic-bezier(.4,0,.2,1);overflow-y:auto;backdrop-filter:blur(12px)}\r\n#controlPanel.open{right:0}\r\n#controlPanel h3{color:#E2643A;margin:0 0 16px;font-size:17px;text-align:center;letter-spacing:2px;text-transform:uppercase}\r\n.tab-nav{display:flex;gap:2px;margin-bottom:16px;border-bottom:1px solid rgba(255,255,255,0.1)}\r\n.tab-btn{flex:1;padding:10px;background:transparent;border:none;color:rgba(255,255,255,0.5);cursor:pointer;font-size:12px;font-weight:600;border-radius:6px 6px 0 0;transition:all .25s;letter-spacing:1px}\r\n.tab-btn.active{color:#E2643A;background:rgba(226,100,58,0.12);box-shadow:inset 0 -2px 0 #E2643A}\r\n.tab-pane{display:none;animation:fadeIn .3s}\r\n.tab-pane.active{display:block}\r\n@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}\r\n.cg{margin-bottom:16px}\r\n.cg label{display:flex;justify-content:space-between;color:rgba(255,255,255,0.8);font-size:12px;margin-bottom:6px}\r\n.cg label span{color:#6C8599;font-weight:700}\r\n.cg input[type=range]{width:100%;height:4px;-webkit-appearance:none;appearance:none;background:rgba(255,255,255,0.15);border-radius:2px;outline:none}\r\n.cg input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:16px;height:16px;border-radius:50%;background:linear-gradient(135deg,#E2643A,#9CA05E);cursor:pointer;border:2px solid rgba(255,255,255,0.3)}\r\n.panel-btn{display:block;width:100%;padding:12px;background:linear-gradient(135deg,#E2643A,#c2552e);color:#fff;border:none;border-radius:8px;font-size:14px;font-weight:600;cursor:pointer;transition:all .25s;margin-top:12px;letter-spacing:1px}\r\n.panel-btn:hover{transform:translateY(-1px);box-shadow:0 4px 20px rgba(226,100,58,0.4)}\r\n.panel-btn:active{transform:translateY(0)}\r\n.metric{display:flex;justify-content:space-between;padding:8px 12px;background:rgba(255,255,255,0.04);border-radius:6px;margin-bottom:8px;border:1px solid rgba(255,255,255,0.06)}\r\n.metric label{color:rgba(255,255,255,0.6);font-size:12px}\r\n.metric span{color:#6C8599;font-weight:700;font-size:13px;font-family:monospace}\r\n/* Scrollbar */\r\n#controlPanel::-webkit-scrollbar{width:4px}\r\n#controlPanel::-webkit-scrollbar-track{background:transparent}\r\n#controlPanel::-webkit-scrollbar-thumb{background:rgba(226,100,58,0.4);border-radius:2px}\r\n\r\n/* ===== SELLO OVERLAY ===== */\r\n.sello-overlay{\r\n  display:none;\r\n  position:fixed;\r\n  inset:0;\r\n  background:rgba(0,0,0,0.65);\r\n  z-index:50;\r\n  align-items:center;\r\n  justify-content:center;\r\n}\r\n.sello-overlay.show{display:flex;}\r\n.sello-card{\r\n  background:linear-gradient(145deg,#2d1f14,#1a0f0a);\r\n  border:1px solid rgba(227,101,59,0.25);\r\n  border-radius:18px;\r\n  padding:22px 24px 20px;\r\n  max-width:380px;\r\n  width:90%;\r\n  text-align:center;\r\n}\r\n.sello-card h2{\r\n  font-size:clamp(1.05rem,3.5vw,1.3rem);\r\n  color:#ea8b34;\r\n  margin:0 0 3px;\r\n}\r\n.sello-card .sello-sub{\r\n  font-size:clamp(0.75rem,2.5vw,0.85rem);\r\n  color:rgba(240,235,216,0.55);\r\n  margin:0 0 14px;\r\n}\r\n.sello-card .sello-inputs{\r\n  display:flex;\r\n  flex-direction:column;\r\n  gap:7px;\r\n  margin-bottom:10px;\r\n}\r\n.sello-card .sello-inputs input{\r\n  padding:9px 12px;\r\n  border:1px solid rgba(255,255,255,0.12);\r\n  border-radius:10px;\r\n  background:rgba(255,255,255,0.07);\r\n  color:#F0EBD8;\r\n  font-size:clamp(0.8rem,2.5vw,0.9rem);\r\n  font-family:'Segoe UI',Arial,sans-serif;\r\n  outline:none;\r\n  transition:border-color 0.2s;\r\n}\r\n.sello-card .sello-inputs input::placeholder{color:rgba(255,255,255,0.25);}\r\n.sello-card .sello-inputs input:focus{border-color:#e3653b;}\r\n.sello-card .sello-btn-row{\r\n  display:flex;\r\n  gap:8px;\r\n  justify-content:center;\r\n}\r\n.sello-card .sello-btn{\r\n  padding:9px 26px;\r\n  border:none;\r\n  border-radius:25px;\r\n  background:#e3653b;\r\n  color:white;\r\n  font-size:clamp(0.8rem,2.5vw,0.9rem);\r\n  font-weight:700;\r\n  font-family:'Segoe UI',Arial,sans-serif;\r\n  cursor:pointer;\r\n  transition:background 0.2s;\r\n}\r\n.sello-card .sello-btn:hover{background:#c24d28;}\r\n.sello-card .sello-btn:disabled{opacity:0.5;cursor:default;}\r\n.sello-card .sello-msg{\r\n  font-size:clamp(0.8rem,2.5vw,0.88rem);\r\n  margin-top:10px;\r\n  display:none;\r\n}\r\n.sello-card .sello-msg.show{display:block;}\r\n.sello-card .sello-msg.success{color:#4ADE80;}\r\n.sello-card .sello-msg.error{color:#ff6b6b;}\r\n\r\n</style>\r\n</head>\r\n<body>\r\n<canvas id=\"shaderCanvas\"></canvas>\r\n<canvas id=\"gameCanvas\"></canvas>\r\n<div id=\"panelHint\">P | Panel</div>\r\n<!-- SELLO OVERLAY -->\r\n<div class=\"sello-overlay\" id=\"selloOverlay\">\r\n  <div class=\"sello-card\">\r\n    <h2>Reclamá tu sello para el Pasaporte</h2>\r\n    <p class=\"sello-sub\">Completá tus datos para recibir el sello por mail</p>\r\n    <div class=\"sello-inputs\">\r\n      <input type=\"text\" id=\"selloNombre\" placeholder=\"Nombre\">\r\n      <input type=\"text\" id=\"selloApellido\" placeholder=\"Apellido\">\r\n      <input type=\"email\" id=\"selloCorreo\" placeholder=\"Correo electrónico\">\r\n    </div>\r\n    <div class=\"sello-btn-row\">\r\n      <button class=\"sello-btn\" id=\"selloBtn\" onclick=\"reclamarSello()\">Reclamar sello</button>\r\n      <button class=\"sello-btn\" style=\"background:transparent;border:1px solid rgba(255,255,255,0.15);color:rgba(255,255,255,0.5);\" onclick=\"cerrarSello()\">Ahora no</button>\r\n    </div>\r\n    <div class=\"sello-msg success\" id=\"selloSuccess\">Sello reclamado con éxito! Revisá tu correo.</div>\r\n    <div class=\"sello-msg error\" id=\"selloError\"></div>\r\n  </div>\r\n</div>\r\n<div id=\"controlPanel\">\r\n  <h3>Canasta · Panel</h3>\r\n  <div class=\"tab-nav\">\r\n    <button class=\"tab-btn active\" data-tab=\"controles\">JUEGO</button>\r\n    <button class=\"tab-btn\" data-tab=\"shader\">SHADER</button>\r\n    <button class=\"tab-btn\" data-tab=\"assets\">ASSETS</button>\r\n    <button class=\"tab-btn\" data-tab=\"stats\">STATS</button>\r\n  </div>\r\n  <div class=\"tab-pane active\" id=\"tab-controles\">\r\n    <div class=\"cg\">\r\n      <label>Velocidad de Caida <span id=\"vSpeed\">15</span></label>\r\n      <input type=\"range\" id=\"sSpeed\" min=\"5\" max=\"40\" step=\"1\" value=\"15\">\r\n    </div>\r\n    <div class=\"cg\">\r\n      <label>Vidas <span id=\"vLives\">3</span></label>\r\n      <input type=\"range\" id=\"sLives\" min=\"1\" max=\"10\" step=\"1\" value=\"3\">\r\n    </div>\r\n    <div class=\"cg\">\r\n      <label>Tamano Objetos <span id=\"vSize\">160px</span></label>\r\n      <input type=\"range\" id=\"sSize\" min=\"10\" max=\"400\" step=\"5\" value=\"160\">\r\n    </div>\r\n    <div class=\"cg\">\r\n      <label>Tamano Canasta <span id=\"vBasket\">140px</span></label>\r\n      <input type=\"range\" id=\"sBasket\" min=\"10\" max=\"400\" step=\"5\" value=\"140\">\r\n    </div>\r\n    <div class=\"cg\">\r\n      <label>Frecuencia <span id=\"vSpawn\">1.5s</span></label>\r\n      <input type=\"range\" id=\"sSpawn\" min=\"500\" max=\"4000\" step=\"100\" value=\"1500\">\r\n    </div>\r\n    <div class=\"cg\">\r\n      <label>Duracion Partida (s) <span id=\"vDur\">60</span></label>\r\n      <input type=\"text\" id=\"sDur\" value=\"60\" style=\"width:100%;padding:8px;background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);border-radius:6px;color:#fff;font-size:14px;outline:none\">\r\n    </div>\r\n    <div class=\"cg\">\r\n      <label>Combo para Bonus <span id=\"vCombo\">5</span></label>\r\n      <input type=\"range\" id=\"sCombo\" min=\"2\" max=\"20\" step=\"1\" value=\"5\">\r\n    </div>\r\n    <div class=\"cg\">\r\n      <label>Meta para Ganar <span id=\"vWin\">10</span></label>\r\n      <input type=\"range\" id=\"sWin\" min=\"1\" max=\"50\" step=\"1\" value=\"10\">\r\n    </div>\r\n    <button class=\"panel-btn\" id=\"btnGuardar\">Guardar Cambios</button>\r\n  </div>\r\n  <div class=\"tab-pane\" id=\"tab-shader\">\r\n    <p style=\"color:rgba(255,255,255,0.5);font-size:12px;margin-bottom:8px\">Noise gradient Terrain San Juan — 5 colores de marca.</p>\r\n    <div style=\"display:flex;flex-wrap:wrap;gap:4px;margin-bottom:12px\">\r\n      <span style=\"display:inline-block;width:20px;height:20px;border-radius:4px;background:#6C8599\" title=\"#6C8599\"></span>\r\n      <span style=\"display:inline-block;width:20px;height:20px;border-radius:4px;background:#F0EBD8\" title=\"#F0EBD8\"></span>\r\n      <span style=\"display:inline-block;width:20px;height:20px;border-radius:4px;background:#C0DCD0\" title=\"#C0DCD0\"></span>\r\n      <span style=\"display:inline-block;width:20px;height:20px;border-radius:4px;background:#E2643A\" title=\"#E2643A\"></span>\r\n      <span style=\"display:inline-block;width:20px;height:20px;border-radius:4px;background:#582927\" title=\"#582927\"></span>\r\n    </div>\r\n    <div class=\"cg\">\r\n      <label>Estilo <span id=\"vStyle\">Noise</span></label>\r\n      <input type=\"range\" id=\"sStyle\" min=\"0\" max=\"1\" step=\"0.01\" value=\"0.9\">\r\n    </div>\r\n    <div class=\"cg\">\r\n      <label>Escala <span id=\"vScale\">0.20</span></label>\r\n      <input type=\"range\" id=\"sScale\" min=\"0\" max=\"1\" step=\"0.01\" value=\"0.2\">\r\n    </div>\r\n    <div class=\"cg\">\r\n      <label>Velocidad <span id=\"vSpeedS\">0.30</span></label>\r\n      <input type=\"range\" id=\"sSpeedS\" min=\"0\" max=\"4\" step=\"0.01\" value=\"0.3\">\r\n    </div>\r\n    <div class=\"cg\">\r\n      <label>Viñeta <span id=\"vVig\">0.70</span></label>\r\n      <input type=\"range\" id=\"sVignette\" min=\"0\" max=\"1\" step=\"0.01\" value=\"0.7\">\r\n    </div>\r\n    <p style=\"color:rgba(255,255,255,0.35);font-size:11px;margin-top:4px\">7 estilos: 0-0.14 H · 0.14-0.29 V · 0.29-0.43 D · 0.43-0.57 R · 0.57-0.71 A · 0.71-0.86 C · 0.86-1 Noise</p>\r\n  </div>\r\n  <div class=\"tab-pane\" id=\"tab-assets\">\r\n    <p style=\"color:rgba(255,255,255,0.5);font-size:12px;margin-bottom:12px\">Los productos se cargan desde assets gráficos (correctos: de San Juan; incorrectos: frutas tropicales).</p>\r\n    <p style=\"color:rgba(255,255,255,0.4);font-size:11px\">Productos correctos: Conservas, Frutos Secos, Gin, Licor, Miel, Oliva, Tomate Triturado, Vinos.</p>\r\n    <p style=\"color:rgba(255,255,255,0.4);font-size:11px\">Productos incorrectos (restan vida): Ananá, Banana, Cacao, Café, Coco, Palta, Yerba.</p>\r\n  </div>\r\n  <div class=\"tab-pane\" id=\"tab-stats\">\r\n    <div class=\"metric\"><label>FPS</label><span id=\"stFps\">0</span></div>\r\n    <div class=\"metric\"><label>Objetos en pantalla</label><span id=\"stObj\">0</span></div>\r\n    <div class=\"metric\"><label>Puntos</label><span id=\"stPts\">0</span></div>\r\n    <div class=\"metric\"><label>Combo maximo</label><span id=\"stCmb\">0</span></div>\r\n  </div>\r\n</div>\r\n<script>\r\n// ============================================================\r\n// CANASTA - Caminos y Sabores\r\n// Juego de productos de San Juan que caen, atrapalos en tu canasta\r\n// ============================================================\r\n\r\n// ----- WEBGL SHADER BACKGROUND -----\r\nlet shaderCanvas, gl, shaderProgram, shaderTime = 0;\r\nlet shaderStyle = 0.9, shaderScale = 0.2, shaderSpeed = 0.3, shaderVignette = 0.7;\r\n// Vertex shader (passthrough)\r\nconst vsSource = `attribute vec2 aPosition;\r\nvarying vec2 vUV;\r\nvoid main() {\r\n  vUV = aPosition * 0.5 + 0.5;\r\n  vUV.y = 1.0 - vUV.y;\r\n  gl_Position = vec4(aPosition, 0.0, 1.0);\r\n}`;\r\n\r\n// Fragment shader - same as gradiente_paleta_sanjuan\r\nconst fsSource = `precision highp float;\r\nvarying vec2 vUV;\r\nuniform float uTime;\r\nuniform vec2 uResolution;\r\nuniform float u_style;\r\nuniform float u_scale;\r\nuniform float u_speed;\r\nuniform float u_vignette;\r\n\r\n// Paleta Caminos y Sabores - 5 colores (sin verdes oliva/musgo)\r\nconst vec3 c1 = vec3(0.345, 0.161, 0.153); // #582927 marron\r\nconst vec3 c2 = vec3(0.886, 0.392, 0.227); // #E2643A naranja\r\nconst vec3 c3 = vec3(0.424, 0.522, 0.600); // #6C8599 gris azulado\r\nconst vec3 c4 = vec3(0.753, 0.863, 0.816); // #C0DCD0 verde claro\r\nconst vec3 c5 = vec3(0.941, 0.922, 0.847); // #F0EBD8 crema\r\n\r\nfloat hash(vec2 p) {\r\n    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);\r\n}\r\n\r\nfloat smoothNoise(vec2 p) {\r\n    vec2 i = floor(p);\r\n    vec2 f = fract(p);\r\n    f = f * f * (3.0 - 2.0 * f);\r\n    float a = hash(i);\r\n    float b = hash(i + vec2(1.0, 0.0));\r\n    float c = hash(i + vec2(0.0, 1.0));\r\n    float d = hash(i + vec2(1.0, 1.0));\r\n    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);\r\n}\r\n\r\nfloat fbm(vec2 p) {\r\n    float v = 0.0;\r\n    float a = 0.5;\r\n    vec2 shift = vec2(100.0);\r\n    for (int i = 0; i < 4; i++) {\r\n        v += a * smoothNoise(p);\r\n        p = p * 2.0 + shift;\r\n        a *= 0.5;\r\n    }\r\n    return v;\r\n}\r\n\r\nvec3 getColor(float t) {\r\n    float idx = t * 4.0;\r\n    float i = floor(idx);\r\n    float f = fract(idx);\r\n    vec3 col;\r\n    if (i < 0.5) col = mix(c3, c5, f);\r\n    else if (i < 1.5) col = mix(c5, c4, f);\r\n    else if (i < 2.5) col = mix(c4, c2, f);\r\n    else col = mix(c2, c1, f);\r\n    return col;\r\n}\r\n\r\nvec3 getNoiseColor(float t) {\r\n    float idx = t * 4.0;\r\n    float i = floor(idx);\r\n    float f = fract(idx);\r\n    // Terreno San Juan: prioriza naranja/marron/crema\r\n    vec3 col;\r\n    if (i < 0.5) col = mix(c4, c5, f);\r\n    else if (i < 1.5) col = mix(c5, c2, f);\r\n    else if (i < 2.5) col = mix(c2, c1, f);\r\n    else col = mix(c1, c3, f);\r\n    return col;\r\n}\r\n\r\nvoid main() {\r\n    vec2 uv = vUV;\r\n    vec2 centered = (uv - 0.5) * uResolution / min(uResolution.x, uResolution.y);\r\n\r\n    float t = uTime * 0.04;\r\n    float style = u_style;\r\n    float scale = mix(0.25, 4.0, u_scale);\r\n    float speed = u_speed * 0.5;\r\n    float pos;\r\n    bool isNoise = false;\r\n\r\n    if (style < 0.142) {\r\n        pos = uv.y * scale;\r\n    } else if (style < 0.285) {\r\n        pos = uv.x * scale;\r\n    } else if (style < 0.428) {\r\n        pos = (uv.x + uv.y) * 0.5 * scale;\r\n    } else if (style < 0.571) {\r\n        pos = length(centered) * 0.7 * scale;\r\n    } else if (style < 0.714) {\r\n        pos = (atan(centered.y, centered.x) / 6.2832 + 0.5) * scale;\r\n    } else if (style < 0.857) {\r\n        pos = min(uv.x, uv.y) * scale;\r\n    } else {\r\n        vec2 np = uv * scale * 2.0 + vec2(0.0, speed * t * 2.0);\r\n        pos = fbm(np);\r\n        isNoise = true;\r\n    }\r\n\r\n    if (!isNoise) {\r\n        pos += sin(pos * 4.0 + t) * 0.02;\r\n        pos = fract(pos + t * 0.01);\r\n    }\r\n\r\n    vec3 col = isNoise ? getNoiseColor(pos) : getColor(pos);\r\n\r\n    // Darken for background\r\n    col *= 0.7;\r\n\r\n    float dist = length(centered);\r\n    float vig = 1.0 - smoothstep(0.2, 1.1, dist);\r\n    vig = mix(1.0, vig, u_vignette);\r\n    col *= vig;\r\n\r\n    float g = (hash(uv * uResolution + fract(uTime)) - 0.5) * 0.02;\r\n    col += g;\r\n\r\n    gl_FragColor = vec4(clamp(col, 0.0, 1.0), 1.0);\r\n}`;\r\n\r\nfunction initShader() {\r\n  shaderCanvas = document.getElementById('shaderCanvas');\r\n  gl = shaderCanvas.getContext('webgl') || shaderCanvas.getContext('experimental-webgl');\r\n  if (!gl) { console.warn('WebGL no disponible'); return; }\r\n\r\n  // Compile shaders\r\n  function compileShader(src, type) {\r\n    const s = gl.createShader(type);\r\n    gl.shaderSource(s, src);\r\n    gl.compileShader(s);\r\n    if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) {\r\n      console.error('Shader error:', gl.getShaderInfoLog(s));\r\n      return null;\r\n    }\r\n    return s;\r\n  }\r\n\r\n  const vs = compileShader(vsSource, gl.VERTEX_SHADER);\r\n  const fs = compileShader(fsSource, gl.FRAGMENT_SHADER);\r\n  if (!vs || !fs) return;\r\n\r\n  shaderProgram = gl.createProgram();\r\n  gl.attachShader(shaderProgram, vs);\r\n  gl.attachShader(shaderProgram, fs);\r\n  gl.linkProgram(shaderProgram);\r\n  if (!gl.getProgramParameter(shaderProgram, gl.LINK_STATUS)) {\r\n    console.error('Link error:', gl.getProgramInfoLog(shaderProgram));\r\n    return;\r\n  }\r\n\r\n  gl.useProgram(shaderProgram);\r\n\r\n  // Full-screen quad\r\n  const vertices = new Float32Array([-1,-1, 1,-1, -1,1, 1,1]);\r\n  const buf = gl.createBuffer();\r\n  gl.bindBuffer(gl.ARRAY_BUFFER, buf);\r\n  gl.bufferData(gl.ARRAY_BUFFER, vertices, gl.STATIC_DRAW);\r\n\r\n  const posLoc = gl.getAttribLocation(shaderProgram, 'aPosition');\r\n  gl.enableVertexAttribArray(posLoc);\r\n  gl.vertexAttribPointer(posLoc, 2, gl.FLOAT, false, 0, 0);\r\n\r\n  // Store uniform locations\r\n  shaderProgram.uTime = gl.getUniformLocation(shaderProgram, 'uTime');\r\n  shaderProgram.uResolution = gl.getUniformLocation(shaderProgram, 'uResolution');\r\n  shaderProgram.u_style = gl.getUniformLocation(shaderProgram, 'u_style');\r\n  shaderProgram.u_scale = gl.getUniformLocation(shaderProgram, 'u_scale');\r\n  shaderProgram.u_speed = gl.getUniformLocation(shaderProgram, 'u_speed');\r\n  shaderProgram.u_vignette = gl.getUniformLocation(shaderProgram, 'u_vignette');\r\n\r\n  shaderResize();\r\n  console.log('Shader background initialized');\r\n}\r\n\r\nfunction shaderResize() {\r\n  if (!gl) return;\r\n  shaderCanvas.width = window.innerWidth * devicePixelRatio;\r\n  shaderCanvas.height = window.innerHeight * devicePixelRatio;\r\n  gl.viewport(0, 0, shaderCanvas.width, shaderCanvas.height);\r\n}\r\n\r\nfunction renderShader(dt) {\r\n  if (!gl || !shaderProgram) return;\r\n  shaderTime += dt * 0.001; // seconds\r\n\r\n  gl.uniform1f(shaderProgram.uTime, shaderTime);\r\n  gl.uniform2f(shaderProgram.uResolution, shaderCanvas.width, shaderCanvas.height);\r\n  gl.uniform1f(shaderProgram.u_style, shaderStyle);\r\n  gl.uniform1f(shaderProgram.u_scale, shaderScale);\r\n  gl.uniform1f(shaderProgram.u_speed, shaderSpeed);\r\n  gl.uniform1f(shaderProgram.u_vignette, shaderVignette);\r\n\r\n  gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);\r\n}\r\n\r\n// ----- 2D GAME CANVAS -----\r\nconst canvas = document.getElementById('gameCanvas');\r\nconst ctx = canvas.getContext('2d');\r\n\r\n// ----- CONFIGURACION -----\r\nconst CFG = {\r\n  speed: 15,\r\n  lives: 3,\r\n  itemSize: 160,\r\n  spawnInterval: 1500,\r\n  duration: 60,\r\n  comboThreshold: 5,\r\n  gravity: 40,\r\n  basketSize: 140,\r\n  winTarget: 10\r\n};\r\n\r\nlet W, H;\r\nlet state = 'start'; // start | playing | gameover\r\nlet score = 0;\r\nlet lives = CFG.lives;\r\nlet combo = 0;\r\nlet maxCombo = 0;\r\nlet catchCount = 0;\r\nlet timeLeft = CFG.duration;\r\nlet timerAcc = 0;\r\nlet items = [];\r\nlet particles = [];\r\nlet floatingTexts = [];\r\nlet basketX = 0;\r\nlet mouseX = 0, mouseY = 0;\r\nlet mouseDown = false;\r\nlet touches = {};\r\nlet spawnAcc = 0;\r\nlet lastTime = 0;\r\nlet wavePhase = 0;\r\nlet canvasScale = 1;\r\n\r\n// ----- PRODUCTOS DE SAN JUAN -----\r\nconst PRODUCTS = [\r\n  { id: 'conservas', name: 'Conservas', path: 'assets/correctos/conservas.png', color1: '#FF6B6B', color2: '#CC3333', letter: 'C', points: 80 },\r\n  { id: 'frutos_secos', name: 'Frutos Secos', path: 'assets/correctos/frutos_secos.png', color1: '#DEB887', color2: '#B8860B', letter: 'F', points: 85 },\r\n  { id: 'gin', name: 'Gin', path: 'assets/correctos/gin.png', color1: '#6C8599', color2: '#582927', letter: 'G', points: 100 },\r\n  { id: 'licor', name: 'Licor', path: 'assets/correctos/licor.png', color1: '#9CA05E', color2: '#6B7033', letter: 'L', points: 95 },\r\n  { id: 'miel', name: 'Miel', path: 'assets/correctos/miel.png', color1: '#FFC125', color2: '#DAA520', letter: 'M', points: 75 },\r\n  { id: 'oliva', name: 'Aceite de Oliva', path: 'assets/correctos/oliva.png', color1: '#D4A843', color2: '#B88A2E', letter: 'O', points: 90 },\r\n  { id: 'tomate_triturado', name: 'Tomate Triturado', path: 'assets/correctos/tomate_triturado.png', color1: '#FF6347', color2: '#DC4030', letter: 'T', points: 70 },\r\n  { id: 'vinos', name: 'Vino', path: 'assets/correctos/vinos.png', color1: '#E2643A', color2: '#A84520', letter: 'V', points: 100 }\r\n];\r\n\r\nconst BAD_ITEMS = [\r\n  { id: 'anana', name: 'Ananá', path: 'assets/incorrectos/anana.png', color1: '#FFD700', color2: '#FFA500', emoji: '🍍', penalty: 50 },\r\n  { id: 'banana', name: 'Banana', path: 'assets/incorrectos/banana.png', color1: '#FFF700', color2: '#FFD700', emoji: '🍌', penalty: 40 },\r\n  { id: 'cacao', name: 'Cacao', path: 'assets/incorrectos/cacao.png', color1: '#8B4513', color2: '#5C2E0B', emoji: '🍫', penalty: 45 },\r\n  { id: 'cafe', name: 'Café', path: 'assets/incorrectos/cafe.png', color1: '#4A2C11', color2: '#2D1B0A', emoji: '☕', penalty: 50 },\r\n  { id: 'coco', name: 'Coco', path: 'assets/incorrectos/coco.png', color1: '#D2B48C', color2: '#8B5A2B', emoji: '🥥', penalty: 35 },\r\n  { id: 'palta', name: 'Palta', path: 'assets/incorrectos/palta.png', color1: '#556B2F', color2: '#2E8B57', emoji: '🥑', penalty: 40 },\r\n  { id: 'yerba', name: 'Yerba Mate', path: 'assets/incorrectos/yerba.png', color1: '#32CD32', color2: '#228B22', emoji: '🧉', penalty: 30 }\r\n];\r\n\r\n// Preload game images with loading tracking\r\nconst IMAGES = {};\r\nconst IMAGES_LOADED = {};\r\nlet allImagesLoaded = false;\r\n// Intro background and logo\r\nlet introBg = new Image();\r\nlet logoImg = new Image();\r\nlet basketImg = new Image();\r\nintroBg.src = 'fondointro.png';\r\nlogoImg.src = 'logo.svg';\r\nbasketImg.src = 'img/tapa_abierta.png';\r\nconst PATTERN_SCALE = 0.35;\r\nfunction preloadImages() {\r\n  let loaded = 0;\r\n  const total = PRODUCTS.length + BAD_ITEMS.length;\r\n  function onLoad(itemId) {\r\n    loaded++;\r\n    IMAGES_LOADED[itemId] = true;\r\n    if (loaded >= total) allImagesLoaded = true;\r\n  }\r\n  [...PRODUCTS, ...BAD_ITEMS].forEach(item => {\r\n    const img = new Image();\r\n    img.onload = () => onLoad(item.id);\r\n    img.onerror = () => {\r\n      console.warn('Error cargando imagen:', item.path);\r\n      onLoad(item.id);\r\n    };\r\n    img.src = item.path;\r\n    IMAGES[item.id] = img;\r\n  });\r\n}\r\npreloadImages();\r\n\r\n// ----- COLOR PALETTE -----\r\nconst PALETTE = {\r\n  primary: '#E2643A',\r\n  sky: '#6C8599',\r\n  gold: '#9CA05E',\r\n  green: '#582927',\r\n  olive: '#6B7033',\r\n  white: '#C0DCD0',\r\n  dark: '#0a0a0f'\r\n};\r\n\r\n// ----- SONIDOS (Web Audio) -----\r\nlet audioCtx = null;\r\nfunction initAudio() {\r\n  try {\r\n    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();\r\n    if (audioCtx.state === 'suspended') audioCtx.resume();\r\n  } catch(e) { console.log('Audio not available:', e.message); }\r\n}\r\nfunction playTone(freq, duration, type='sine', vol=0.15) {\r\n  try {\r\n    initAudio();\r\n    const osc = audioCtx.createOscillator();\r\n    const gain = audioCtx.createGain();\r\n    osc.type = type;\r\n    osc.frequency.value = freq;\r\n    gain.gain.setValueAtTime(vol, audioCtx.currentTime);\r\n    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);\r\n    osc.connect(gain);\r\n    gain.connect(audioCtx.destination);\r\n    osc.start();\r\n    osc.stop(audioCtx.currentTime + duration);\r\n  } catch(e) {}\r\n}\r\nfunction playCollect() {\r\n  playTone(523, 0.12, 'sine', 0.12);\r\n  setTimeout(() => playTone(659, 0.1, 'sine', 0.1), 60);\r\n}\r\nfunction playBad() {\r\n  playTone(200, 0.2, 'sawtooth', 0.08);\r\n  playTone(150, 0.3, 'sawtooth', 0.06);\r\n}\r\nfunction playCombo() {\r\n  playTone(784, 0.08, 'sine', 0.1);\r\n  setTimeout(() => playTone(988, 0.08, 'sine', 0.1), 50);\r\n  setTimeout(() => playTone(1175, 0.12, 'sine', 0.1), 100);\r\n}\r\nfunction playStart() {\r\n  [262, 330, 392, 523].forEach((f, i) => {\r\n    setTimeout(() => playTone(f, 0.15, 'sine', 0.08), i * 80);\r\n  });\r\n}\r\nfunction playGameOver() {\r\n  [392, 349, 330, 262].forEach((f, i) => {\r\n    setTimeout(() => playTone(f, 0.25, 'sine', 0.08), i * 120);\r\n  });\r\n}\r\nfunction playMiss() {\r\n  playTone(180, 0.15, 'sawtooth', 0.06);\r\n  setTimeout(() => playTone(140, 0.2, 'sawtooth', 0.05), 80);\r\n}\r\nfunction playWin() {\r\n  [523, 659, 784, 1047].forEach((f, i) => {\r\n    setTimeout(() => playTone(f, 0.2, 'sine', 0.12), i * 120);\r\n  });\r\n}\r\n\r\n// ----- CLASES -----\r\nclass FallingItem {\r\n  constructor(isBad = false) {\r\n    this.isBad = isBad;\r\n    if (isBad) {\r\n      const b = BAD_ITEMS[Math.floor(Math.random() * BAD_ITEMS.length)];\r\n      this.data = b;\r\n      this.points = -b.penalty;\r\n    } else {\r\n      const p = PRODUCTS[Math.floor(Math.random() * PRODUCTS.length)];\r\n      this.data = p;\r\n      this.points = p.points;\r\n    }\r\n    this.size = CFG.itemSize * (0.8 + Math.random() * 0.4);\r\n    this.x = Math.random() * (W - 60) + 30;\r\n    this.y = -this.size;\r\n    this.speedFactor = (1 + Math.random() * 0.5);\r\n    this.vy = this.speedFactor * CFG.speed * 25;\r\n    this.vx = 0;\r\n    this.rot = 0;\r\n    this.rotSpeed = 0;\r\n    this.caught = false;\r\n    this.missed = false;\r\n    this.opacity = 1;\r\n    this.wobble = 0;\r\n    this.wobbleSpeed = 0;\r\n  }\r\n  hitTest(px, py) {\r\n    if (this.caught || this.missed) return false;\r\n    const half = this.size * 0.5;\r\n    return px > this.x - half && px < this.x + half && py > this.y - half && py < this.y + half;\r\n  }\r\n  update(dt) {\r\n    if (this.caught || this.missed) return;\r\n    this.vy += CFG.gravity * dt;\r\n    this.y += this.vy * dt;\r\n    this.x += this.vx * dt;\r\n\r\n  }\r\n  draw(ctx) {\r\n    if (this.caught || this.missed) return;\r\n    ctx.save();\r\n    ctx.globalAlpha = this.opacity;\r\n    ctx.translate(this.x, this.y);\r\n    ctx.rotate(this.rot);\r\n    const s = this.size;\r\n\r\n    const img = IMAGES[this.data.id];\r\n    if (img && img.complete && img.naturalWidth !== 0) {\r\n      // Glow instead of background square\r\n      ctx.shadowColor = this.isBad ? 'rgba(255,60,60,0.7)' : 'rgba(74,222,128,0.7)';\r\n      ctx.shadowBlur = 20;\r\n\r\n      // Dibujar imagen manteniendo aspect ratio\r\n      let dw = s;\r\n      let dh = s;\r\n      const aspect = img.naturalWidth / img.naturalHeight;\r\n      if (aspect > 1) {\r\n        dh = s / aspect;\r\n      } else {\r\n        dw = s * aspect;\r\n      }\r\n      ctx.drawImage(img, -dw/2, -dh/2, dw, dh);\r\n\r\n      ctx.shadowBlur = 0;\r\n    } else {\r\n      ctx.shadowColor = 'rgba(0,0,0,0.3)';\r\n      ctx.shadowBlur = 8;\r\n      ctx.shadowOffsetY = 3;\r\n\r\n      if (this.isBad) {\r\n        ctx.shadowColor = 'rgba(200,0,0,0.3)';\r\n        ctx.shadowBlur = 10;\r\n        ctx.fillStyle = this.data.color1 || '#ff4444';\r\n        ctx.beginPath();\r\n        ctx.arc(0, 0, s/2, 0, Math.PI * 2);\r\n        ctx.fill();\r\n        ctx.fillStyle = this.data.color2 || '#cc2222';\r\n        ctx.beginPath();\r\n        ctx.arc(0, 0, s*0.35, 0, Math.PI * 2);\r\n        ctx.fill();\r\n        ctx.strokeStyle = '#ff6666';\r\n        ctx.lineWidth = 3;\r\n        ctx.beginPath();\r\n        ctx.moveTo(-s*0.2, -s*0.25);\r\n        ctx.lineTo(s*0.2, s*0.25);\r\n        ctx.moveTo(s*0.2, -s*0.25);\r\n        ctx.lineTo(-s*0.2, s*0.25);\r\n        ctx.stroke();\r\n        ctx.fillStyle = '#F0EBD8';\r\n        ctx.font = `bold ${Math.max(16, s * 0.3)}px \"Segoe UI\", Arial, sans-serif`;\r\n        ctx.textAlign = 'center';\r\n        ctx.textBaseline = 'middle';\r\n        ctx.shadowColor = 'rgba(0,0,0,0.5)';\r\n        ctx.shadowBlur = 4;\r\n        ctx.fillText(this.data.emoji || 'X', 0, 1);\r\n      } else {\r\n        ctx.fillStyle = this.data.color1 || '#6C8599';\r\n        ctx.beginPath();\r\n        ctx.arc(0, 0, s/2, 0, Math.PI * 2);\r\n        ctx.fill();\r\n        ctx.fillStyle = this.data.color2 || '#4A6B1A';\r\n        ctx.beginPath();\r\n        ctx.arc(-s*0.08, -s*0.08, s*0.25, 0, Math.PI * 2);\r\n        ctx.fill();\r\n        ctx.fillStyle = '#F0EBD8';\r\n        ctx.font = `bold ${Math.max(16, s * 0.3)}px \"Segoe UI\", Arial, sans-serif`;\r\n        ctx.textAlign = 'center';\r\n        ctx.textBaseline = 'middle';\r\n        ctx.shadowColor = 'rgba(0,0,0,0.5)';\r\n        ctx.shadowBlur = 4;\r\n        const letter = this.data.letter || this.data.name.charAt(0).toUpperCase();\r\n        ctx.fillText(letter, 0, 1);\r\n        ctx.font = `bold ${Math.max(9, s * 0.16)}px \"Segoe UI\", Arial, sans-serif`;\r\n        ctx.fillText(this.data.name, 0, s * 0.48);\r\n      }\r\n    }\r\n    ctx.restore();\r\n  }\r\n  isOffScreen() {\r\n    return this.y > H + 100;\r\n  }\r\n  checkBasketCollision(bx, by, bw, bh) {\r\n    if (this.caught || this.missed) return false;\r\n    const halfW = bw / 2;\r\n    const halfH = bh / 2;\r\n    const dx = Math.abs(this.x - bx);\r\n    const dy = Math.abs(this.y - by);\r\n    if (dx < halfW + this.size * 0.4 && dy < halfH + this.size * 0.4) {\r\n      return true;\r\n    }\r\n    return false;\r\n  }\r\n}\r\n\r\nclass Particle {\r\n  constructor(x, y, color, count = 15) {\r\n    this.parts = [];\r\n    for (let i = 0; i < count; i++) {\r\n      const angle = Math.random() * Math.PI * 2;\r\n      const speed = 1 + Math.random() * 4;\r\n      this.parts.push({\r\n        x, y,\r\n        vx: Math.cos(angle) * speed,\r\n        vy: Math.sin(angle) * speed - 2,\r\n        size: 2 + Math.random() * 6,\r\n        color,\r\n        life: 1,\r\n        decay: 0.01 + Math.random() * 0.02\r\n      });\r\n    }\r\n  }\r\n  update() {\r\n    for (const p of this.parts) {\r\n      p.x += p.vx;\r\n      p.y += p.vy;\r\n      p.vy += 0.1;\r\n      p.life -= p.decay;\r\n    }\r\n    this.parts = this.parts.filter(p => p.life > 0);\r\n  }\r\n  draw(ctx) {\r\n    for (const p of this.parts) {\r\n      ctx.globalAlpha = p.life;\r\n      ctx.fillStyle = p.color;\r\n      ctx.shadowColor = p.color;\r\n      ctx.shadowBlur = 6;\r\n      ctx.beginPath();\r\n      ctx.arc(p.x, p.y, p.size * p.life, 0, Math.PI * 2);\r\n      ctx.fill();\r\n    }\r\n    ctx.globalAlpha = 1;\r\n    ctx.shadowBlur = 0;\r\n  }\r\n  get alive() { return this.parts.length > 0; }\r\n}\r\n\r\nclass FloatingText {\r\n  constructor(x, y, text, color, size = 28) {\r\n    this.x = x;\r\n    this.y = y;\r\n    this.text = text;\r\n    this.color = color;\r\n    this.size = size;\r\n    this.life = 1;\r\n    this.vy = -2;\r\n  }\r\n  update() {\r\n    this.y += this.vy;\r\n    this.vy *= 0.97;\r\n    this.life -= 0.015;\r\n  }\r\n  draw(ctx) {\r\n    ctx.globalAlpha = this.life;\r\n    ctx.fillStyle = this.color;\r\n    ctx.font = `bold ${this.size}px \"Segoe UI\", Arial, sans-serif`;\r\n    ctx.textAlign = 'center';\r\n    ctx.textBaseline = 'middle';\r\n    ctx.shadowColor = 'rgba(0,0,0,0.6)';\r\n    ctx.shadowBlur = 8;\r\n    ctx.fillText(this.text, this.x, this.y);\r\n    ctx.globalAlpha = 1;\r\n    ctx.shadowBlur = 0;\r\n  }\r\n  get alive() { return this.life > 0; }\r\n}\r\n\r\n// ----- BASKET DRAWING -----\r\nfunction drawBasket(ctx, x, y, w, h) {\r\n  ctx.save();\r\n  ctx.translate(x, y);\r\n  ctx.scale(basketScale, basketScale);\r\n  // Draw basket image if loaded\r\n  if (basketImg.complete && basketImg.naturalWidth !== 0) {\r\n    ctx.shadowColor = 'rgba(0,0,0,0.4)';\r\n    ctx.shadowBlur = 25;\r\n    ctx.drawImage(basketImg, -w/2, -h/2, w, h);\r\n    ctx.shadowBlur = 0;\r\n  }\r\n  ctx.restore();\r\n}\r\n\r\n// ----- RESIZE -----\r\nfunction resize() {\r\n  W = window.innerWidth;\r\n  H = window.innerHeight;\r\n  canvas.width = W;\r\n  canvas.height = H;\r\n  shaderResize();\r\n  if (state === 'playing') {\r\n    basketX = W / 2;\r\n  }\r\n}\r\n\r\n// ----- RESET GAME -----\r\nfunction resetGame() {\r\n  score = 0;\r\n  lives = CFG.lives;\r\n  combo = 0;\r\n  maxCombo = 0;\r\n  catchCount = 0;\r\n  timeLeft = CFG.duration;\r\n  timerAcc = 0;\r\n  items = [];\r\n  particles = [];\r\n  floatingTexts = [];\r\n  spawnAcc = 0;\r\n  basketX = W / 2;\r\n}\r\n\r\n// ----- SPAWN -----\r\nfunction spawnItem() {\r\n  const item = new FallingItem(Math.random() < 0.2);\r\n  items.push(item);\r\n}\r\n\r\nfunction catchItem(item) {\r\n  if (item.caught) return;\r\n  item.caught = true;\r\n  basketScale = 1.15;\r\n  // Catch animation at basket\r\n  const bx = basketX;\r\n  const by = H - 100;\r\n  if (item.isBad) {\r\n    if (state === 'playing') {\r\n      lives--;\r\n      score += item.points;\r\n      combo = 0;\r\n    }\r\n    particles.push(new Particle(item.x, item.y, '#ff4444', 25));\r\n    particles.push(new Particle(bx, by, '#ff4444', 12));\r\n    floatingTexts.push(new FloatingText(item.x, item.y - 20, state === 'start' ? '-1' : `${item.points}`, '#ff4444', 32));\r\n    playBad();\r\n  } else {\r\n    if (state === 'playing') {\r\n      catchCount++;\r\n      combo++;\r\n      if (combo > maxCombo) maxCombo = combo;\r\n      const comboMult = 1 + Math.floor(combo / CFG.comboThreshold) * 0.5;\r\n      const pts = Math.round(item.points * comboMult);\r\n      score += pts;\r\n      const color = combo >= CFG.comboThreshold ? '#FFD700' : '#4ADE80';\r\n      particles.push(new Particle(item.x, item.y, color, 20));\r\n      particles.push(new Particle(bx, by, '#F0EBD8', 15));\r\n      let text = `+${pts}`;\r\n      if (combo >= CFG.comboThreshold) {\r\n        text += ` x${comboMult.toFixed(1)}`;\r\n        particles.push(new Particle(bx, by, '#FFD700', 20));\r\n        playCombo();\r\n      } else {\r\n        playCollect();\r\n      }\r\n      floatingTexts.push(new FloatingText(item.x, item.y - 20, text, color, combo >= CFG.comboThreshold ? 36 : 28));\r\n    } else {\r\n      const color = '#4ADE80';\r\n      particles.push(new Particle(item.x, item.y, color, 15));\r\n      particles.push(new Particle(bx, by, '#F0EBD8', 10));\r\n      floatingTexts.push(new FloatingText(item.x, item.y - 20, '+1', color, 24));\r\n      playCollect();\r\n    }\r\n  }\r\n}\r\n\r\n// ----- UPDATE -----\r\nfunction update(dt) {\r\n  // Basket scale decay\r\n  basketScale += (1 - basketScale) * 5 * dt;\r\n  btnScale += (1 - btnScale) * 6 * dt;\r\n  if (state === 'playing' || state === 'start') {\r\n    // Timer only during playing\r\n    if (state === 'playing') {\r\n      timerAcc += dt;\r\n      if (timerAcc >= 1) {\r\n        timerAcc -= 1;\r\n        timeLeft--;\r\n        if (timeLeft <= 0) {\r\n          endGame();\r\n          return;\r\n        }\r\n      }\r\n    }\r\n\r\n    // Spawn (faster in tutorial)\r\n    spawnAcc += dt;\r\n    const spawnRate = state === 'start' ? 0.8 : CFG.spawnInterval / 1000;\r\n    if (spawnAcc >= spawnRate) {\r\n      spawnAcc = 0;\r\n      spawnItem();\r\n    }\r\n\r\n    // Update items\r\n    for (const item of items) {\r\n      item.update(dt);\r\n      // Basket collision\r\n      if (item.checkBasketCollision(basketX, H - 100, CFG.basketSize, CFG.basketSize * 0.64)) {\r\n        catchItem(item);\r\n        if (state === 'playing' && lives <= 0) {\r\n          endGame();\r\n          return;\r\n        }\r\n        if (state === 'playing' && catchCount >= CFG.winTarget) {\r\n          state = 'win';\r\n          playWin();\r\n          setTimeout(mostrarSello, 800);\r\n          return;\r\n        }\r\n      }\r\n\r\n      // Off-screen penalty (only in playing mode)\r\n      if (!item.caught && !item.missed && item.isOffScreen()) {\r\n        item.missed = true;\r\n        if (state === 'playing' && !item.isBad) {\r\n          lives--;\r\n          combo = 0;\r\n          particles.push(new Particle(item.x, H - 50, '#ff6666', 15));\r\n          floatingTexts.push(new FloatingText(item.x, H - 80, '-1 vida', '#ff6666', 24));\r\n          playMiss();\r\n          if (lives <= 0) {\r\n            endGame();\r\n            return;\r\n          }\r\n        }\r\n      }\r\n    }\r\n    items = items.filter(i => !i.caught && !i.missed);\r\n\r\n    // Update particles\r\n    for (const p of particles) p.update();\r\n    particles = particles.filter(p => p.alive);\r\n\r\n    // Update floating texts\r\n    for (const f of floatingTexts) f.update();\r\n    floatingTexts = floatingTexts.filter(f => f.alive);\r\n  }\r\n\r\n  // Wave phase (for start screen slideshow too)\r\n  wavePhase += 0.015 * dt;\r\n\r\n  // Fade transition from tutorial to game\r\n  if (fadeToBlack) {\r\n    fadeOut += dt * 3; // fade to black over ~0.33s\r\n    if (fadeOut >= 1) {\r\n      fadeOut = 1;\r\n      fadeToBlack = false;\r\n      if (state === 'start') startGame();\r\n    }\r\n  } else if (fadeOut > 0) {\r\n    fadeOut -= dt * 3; // fade from black to game over ~0.33s\r\n    if (fadeOut < 0) fadeOut = 0;\r\n  }\r\n}\r\n\r\n// ----- DRAW -----\r\nfunction draw() {\r\n  ctx.clearRect(0, 0, W, H);\r\n\r\n  if (state === 'start') {\r\n    drawGame(true); // skip HUD during tutorial\r\n    drawTutorialOverlay();\r\n    // Draw particles and floating texts on top\r\n    ctx.shadowBlur = 0;\r\n    for (const p of particles) p.draw(ctx);\r\n    for (const f of floatingTexts) f.draw(ctx);\r\n  } else if (state === 'playing') {\r\n    drawGame();\r\n  } else if (state === 'gameover') {\r\n    drawGame();\r\n    drawGameOver();\r\n  } else if (state === 'win') {\r\n    drawGame();\r\n    drawWinScreen();\r\n  }\r\n\r\n  // Fade transition overlay\r\n  if (fadeOut > 0) {\r\n    ctx.fillStyle = `rgba(0,0,0,${fadeOut})`;\r\n    ctx.fillRect(0, 0, W, H);\r\n  }\r\n}\r\n\r\nfunction drawTutorialOverlay() {\r\n  const cx = W / 2;\r\n  const topY = H * 0.05;\r\n\r\n  ctx.save();\r\n  ctx.textAlign = 'center';\r\n  ctx.textBaseline = 'middle';\r\n\r\n  // Dark overlay specifically for tutorial UI readability\r\n  ctx.fillStyle = 'rgba(0,0,0,0.55)';\r\n  ctx.fillRect(0, 0, W, H);\r\n\r\n  // Logo SVG\r\n  if (logoImg.complete && logoImg.naturalWidth !== 0) {\r\n    const logoW = Math.min(220, W * 0.45);\r\n    const logoH = logoW * (logoImg.naturalHeight / logoImg.naturalWidth);\r\n    ctx.drawImage(logoImg, cx - logoW/2, topY, logoW, logoH || logoW * 0.3);\r\n  } else {\r\n    ctx.shadowColor = '#E2643A';\r\n    ctx.shadowBlur = 40;\r\n    ctx.fillStyle = '#E2643A';\r\n    ctx.font = `bold ${Math.min(60, W * 0.1)}px \"Segoe UI\", Arial, sans-serif`;\r\n    ctx.fillText('CANASTA', cx, topY + 30);\r\n    ctx.shadowBlur = 0;\r\n  }\r\n\r\n  // ----- TUTORIAL SECTION (middle) -----\r\n  const tutorialY = H * 0.40;\r\n\r\n  // Title\r\n  ctx.shadowColor = 'rgba(0,0,0,0.8)';\r\n  ctx.shadowBlur = 10;\r\n  ctx.fillStyle = '#F0EBD8';\r\n  ctx.font = `bold ${Math.min(24, W * 0.038)}px \"Segoe UI\", Arial, sans-serif`;\r\n  ctx.fillText('Atrapa los productos de San Juan en tu canasta', cx, tutorialY);\r\n  ctx.shadowBlur = 0;\r\n\r\n  // Slideshow: each slide lasts ~3s, fades in 0.5s\r\n  const exampleY = tutorialY + 70;\r\n  const iconSize = Math.min(100, W * 0.14);\r\n  // wavePhase grows ~0.0144/s. Multiplier 23 makes 1 unit = ~3s\r\n  const slideProgress = wavePhase * 23;\r\n  const slideFloat = slideProgress - Math.floor(slideProgress); // 0..1 within each slide\r\n  // First 80% = still image (2.4s), last 20% = smooth fade (0.6s)\r\n  const doFade = slideFloat > 0.8;\r\n  const alpha = doFade ? (1 - slideFloat) / 0.2 : 1;\r\n\r\n  const rawIdx = Math.floor(slideProgress);\r\n  const goodIdx = rawIdx % PRODUCTS.length;\r\n  const badIdx = (rawIdx + 2) % BAD_ITEMS.length;\r\n  const nextGoodIdx = (goodIdx + 1) % PRODUCTS.length;\r\n  const nextBadIdx = (badIdx + 1) % BAD_ITEMS.length;\r\n\r\n  const goodItem = PRODUCTS[goodIdx];\r\n  const nextGoodItem = PRODUCTS[nextGoodIdx];\r\n  const badItem = BAD_ITEMS[badIdx];\r\n  const nextBadItem = BAD_ITEMS[nextBadIdx];\r\n\r\n  const goodImg = IMAGES[goodItem.id];\r\n  const nextGoodImg = IMAGES[nextGoodItem.id];\r\n  const badImg = IMAGES[badItem.id];\r\n  const nextBadImg = IMAGES[nextBadItem.id];\r\n\r\n  // Good item (left)\r\n  const goodX = cx - iconSize - 50;\r\n\r\n  // Green glow for good item\r\n  ctx.shadowColor = 'rgba(74,222,128,0.8)';\r\n  ctx.shadowBlur = 25;\r\n  if (goodImg && goodImg.complete && goodImg.naturalWidth !== 0) {\r\n    const aspect = goodImg.naturalWidth / goodImg.naturalHeight;\r\n    let dw = iconSize, dh = iconSize;\r\n    if (aspect > 1) dh = iconSize / aspect; else dw = iconSize * aspect;\r\n    ctx.globalAlpha = alpha;\r\n    ctx.drawImage(goodImg, goodX - dw/2, exampleY - dh/2, dw, dh);\r\n    ctx.globalAlpha = 1 - alpha;\r\n    if (nextGoodImg && nextGoodImg.complete && nextGoodImg.naturalWidth !== 0) {\r\n      const aspect2 = nextGoodImg.naturalWidth / nextGoodImg.naturalHeight;\r\n      let dw2 = iconSize, dh2 = iconSize;\r\n      if (aspect2 > 1) dh2 = iconSize / aspect2; else dw2 = iconSize * aspect2;\r\n      ctx.drawImage(nextGoodImg, goodX - dw2/2, exampleY - dh2/2, dw2, dh2);\r\n    }\r\n  }\r\n  ctx.globalAlpha = 1;\r\n  ctx.shadowBlur = 0;\r\n  ctx.fillStyle = '#4ADE80';\r\n  ctx.font = `bold ${Math.min(14, W * 0.02)}px \"Segoe UI\", Arial, sans-serif`;\r\n  ctx.fillText('San Juan SI produce', goodX, exampleY + iconSize/2 + 20);\r\n\r\n  // Divider\r\n  ctx.fillStyle = 'rgba(240,235,216,0.3)';\r\n  ctx.font = `${Math.min(22, W * 0.03)}px \"Segoe UI\", Arial, sans-serif`;\r\n  ctx.fillText('vs', cx, exampleY + 4);\r\n\r\n  // Bad item (right)\r\n  const badX = cx + iconSize + 50;\r\n\r\n  // Red glow for bad item\r\n  ctx.shadowColor = 'rgba(255,60,60,0.8)';\r\n  ctx.shadowBlur = 25;\r\n  if (badImg && badImg.complete && badImg.naturalWidth !== 0) {\r\n    const aspect = badImg.naturalWidth / badImg.naturalHeight;\r\n    let dw = iconSize, dh = iconSize;\r\n    if (aspect > 1) dh = iconSize / aspect; else dw = iconSize * aspect;\r\n    ctx.globalAlpha = alpha;\r\n    ctx.drawImage(badImg, badX - dw/2, exampleY - dh/2, dw, dh);\r\n    ctx.globalAlpha = 1 - alpha;\r\n    if (nextBadImg && nextBadImg.complete && nextBadImg.naturalWidth !== 0) {\r\n      const aspect2 = nextBadImg.naturalWidth / nextBadImg.naturalHeight;\r\n      let dw2 = iconSize, dh2 = iconSize;\r\n      if (aspect2 > 1) dh2 = iconSize / aspect2; else dw2 = iconSize * aspect2;\r\n      ctx.drawImage(nextBadImg, badX - dw2/2, exampleY - dh2/2, dw2, dh2);\r\n    }\r\n  }\r\n  ctx.globalAlpha = 1;\r\n  ctx.shadowBlur = 0;\r\n  ctx.fillStyle = '#ff4444';\r\n  ctx.font = `bold ${Math.min(14, W * 0.02)}px \"Segoe UI\", Arial, sans-serif`;\r\n  ctx.fillText('San Juan NO produce', badX, exampleY + iconSize/2 + 20);\r\n\r\n  // Extra instruction\r\n  ctx.shadowColor = 'rgba(0,0,0,0.8)';\r\n  ctx.shadowBlur = 8;\r\n  ctx.fillStyle = 'rgba(240,235,216,0.7)';\r\n  ctx.font = `bold ${Math.min(16, W * 0.024)}px \"Segoe UI\", Arial, sans-serif`;\r\n  ctx.fillText('Atrapá los buenos y esquivá los que no son de San Juan', cx, exampleY + iconSize/2 + 55);\r\n  ctx.shadowBlur = 0;\r\n\r\n  // ----- PLAY BUTTON -----\r\n  const btnW = Math.min(220, W * 0.45);\r\n  const btnH = 54;\r\n  const btnY = H * 0.8;\r\n  ctx.save();\r\n  ctx.translate(cx, btnY);\r\n  ctx.scale(btnScale, btnScale);\r\n  ctx.shadowColor = 'rgba(226,100,58,0.5)';\r\n  ctx.shadowBlur = 30;\r\n  ctx.fillStyle = '#E2643A';\r\n  ctx.beginPath();\r\n  ctx.roundRect(-btnW/2, -btnH/2, btnW, btnH, 27);\r\n  ctx.fill();\r\n\r\n  ctx.shadowBlur = 0;\r\n  ctx.fillStyle = '#F0EBD8';\r\n  ctx.font = `bold ${Math.min(20, W * 0.03)}px \"Segoe UI\", Arial, sans-serif`;\r\n  ctx.letterSpacing = '3px';\r\n  ctx.fillText('JUGAR', 0, 2);\r\n  ctx.letterSpacing = 'normal';\r\n  ctx.restore();\r\n\r\n  window._btnPlay = { x: cx - btnW/2, y: btnY - btnH/2, w: btnW, h: btnH };\r\n\r\n  ctx.restore();\r\n}\r\n\r\nfunction drawGame(skipHUD) {\r\n  // Repeating fondo background\r\n  if (introBg.complete && introBg.naturalWidth !== 0) {\r\n    const pat = ctx.createPattern(introBg, 'repeat');\r\n    ctx.save();\r\n    ctx.scale(PATTERN_SCALE, PATTERN_SCALE);\r\n    ctx.fillStyle = pat;\r\n    ctx.fillRect(0, 0, W / PATTERN_SCALE, H / PATTERN_SCALE);\r\n    ctx.restore();\r\n  }\r\n  // Dark overlay for gameplay (only during playing, tutorial has its own)\r\n  if (state === 'playing') {\r\n    ctx.fillStyle = 'rgba(0,0,0,0.5)';\r\n    ctx.fillRect(0, 0, W, H);\r\n  }\r\n\r\n  const bx = basketX;\r\n  const by = H - 100;\r\n  const bw = CFG.basketSize * (0.7 + 0.3 * Math.min(W / 500, 1.5));\r\n  const bh = bw * 0.64;\r\n\r\n  // Draw items behind basket\r\n  for (const item of items) {\r\n    if (!item.caught && !item.missed) item.draw(ctx);\r\n  }\r\n\r\n  // Draw basket\r\n  drawBasket(ctx, bx, by, bw, bh);\r\n\r\n  // Draw particles\r\n  ctx.shadowBlur = 0;\r\n  for (const p of particles) p.draw(ctx);\r\n\r\n  // Draw floating texts\r\n  for (const f of floatingTexts) f.draw(ctx);\r\n\r\n  // HUD (skip during tutorial)\r\n  if (!skipHUD) drawHUD();\r\n}\r\n\r\nfunction drawHUD() {\r\n  ctx.save();\r\n  ctx.shadowBlur = 0;\r\n\r\n  const pad = 16;\r\n  const topY = 16;\r\n\r\n  // Score\r\n  ctx.textAlign = 'left';\r\n  ctx.textBaseline = 'top';\r\n  ctx.fillStyle = '#F0EBD8';\r\n  ctx.font = `bold ${Math.min(32, W * 0.045)}px \"Segoe UI\", Arial, sans-serif`;\r\n  ctx.shadowColor = 'rgba(0,0,0,0.8)';\r\n  ctx.shadowBlur = 6;\r\n  ctx.fillText(score, pad, topY);\r\n\r\n  ctx.fillStyle = 'rgba(240,235,216,0.5)';\r\n  ctx.font = `${Math.min(11, W * 0.016)}px \"Segoe UI\", Arial, sans-serif`;\r\n  ctx.fillText('PUNTOS', pad, topY + 30);\r\n\r\n  // Timer - center top\r\n  ctx.textAlign = 'center';\r\n  ctx.fillStyle = timeLeft <= 10 ? '#E2643A' : '#F0EBD8';\r\n  ctx.font = `bold ${Math.min(36, W * 0.05)}px \"Segoe UI\", Arial, sans-serif`;\r\n  const timeStr = `${Math.floor(timeLeft / 60)}:${String(timeLeft % 60).padStart(2, '0')}`;\r\n  ctx.fillText(timeStr, W / 2, topY);\r\n\r\n  ctx.fillStyle = 'rgba(240,235,216,0.5)';\r\n  ctx.font = `${Math.min(11, W * 0.016)}px \"Segoe UI\", Arial, sans-serif`;\r\n  ctx.fillText('TIEMPO', W / 2, topY + 34);\r\n\r\n  // Lives - right\r\n  ctx.textAlign = 'right';\r\n  for (let i = 0; i < CFG.lives; i++) {\r\n    ctx.fillStyle = i < lives ? '#ff4444' : 'rgba(255,255,255,0.15)';\r\n    ctx.font = `${Math.min(32, W * 0.04)}px \"Segoe UI\", Arial, sans-serif`;\r\n    ctx.fillText('♥', W - pad - i * 32, topY - 2);\r\n  }\r\n\r\n  // Combo bar\r\n  const comboBarW = Math.min(200, W * 0.25);\r\n  const comboBarH = 6;\r\n  const comboX = W / 2 - comboBarW / 2;\r\n  const comboY = topY + 52;\r\n  const comboProgress = Math.min(1, combo / CFG.comboThreshold);\r\n\r\n  ctx.fillStyle = 'rgba(0,0,0,0.3)';\r\n  ctx.beginPath();\r\n  ctx.roundRect(comboX, comboY, comboBarW, comboBarH, 3);\r\n  ctx.fill();\r\n\r\n  const comboGrad = ctx.createLinearGradient(comboX, comboY, comboX + comboBarW, comboY);\r\n  comboGrad.addColorStop(0, '#E2643A');\r\n  comboGrad.addColorStop(0.5, '#9CA05E');\r\n  comboGrad.addColorStop(1, '#FFD700');\r\n  ctx.fillStyle = comboGrad;\r\n  ctx.beginPath();\r\n  ctx.roundRect(comboX, comboY, comboBarW * comboProgress, comboBarH, 3);\r\n  ctx.fill();\r\n\r\n  if (combo > 0) {\r\n    ctx.textAlign = 'center';\r\n    ctx.fillStyle = combo >= CFG.comboThreshold ? '#FFD700' : '#F0EBD8';\r\n    ctx.font = `bold ${Math.min(13, W * 0.018)}px \"Segoe UI\", Arial, sans-serif`;\r\n    ctx.fillText(`COMBO x${(1 + Math.floor(combo / CFG.comboThreshold) * 0.5).toFixed(1)} (${combo})`, W / 2, comboY + 20);\r\n  }\r\n\r\n  ctx.restore();\r\n}\r\n\r\nfunction drawGameOver() {\r\n  ctx.save();\r\n  ctx.fillStyle = 'rgba(0,0,0,0.6)';\r\n  ctx.fillRect(0, 0, W, H);\r\n\r\n  const cx = W / 2;\r\n  const cy = H / 2;\r\n\r\n  ctx.textAlign = 'center';\r\n  ctx.textBaseline = 'middle';\r\n\r\n  ctx.shadowColor = '#E2643A';\r\n  ctx.shadowBlur = 40;\r\n  ctx.fillStyle = '#E2643A';\r\n  ctx.font = `bold ${Math.min(56, W * 0.08)}px \"Segoe UI\", Arial, sans-serif`;\r\n  ctx.fillText('Partida terminada!', cx, cy - 100);\r\n  ctx.shadowBlur = 0;\r\n\r\n  ctx.fillStyle = '#F0EBD8';\r\n  ctx.font = `bold ${Math.min(48, W * 0.07)}px \"Segoe UI\", Arial, sans-serif`;\r\n  ctx.fillText(`${score} puntos`, cx, cy - 30);\r\n\r\n  ctx.fillStyle = 'rgba(240,235,216,0.6)';\r\n  ctx.font = `${Math.min(18, W * 0.025)}px \"Segoe UI\", Arial, sans-serif`;\r\n  ctx.fillText(`Combo maximo: ${maxCombo}`, cx, cy + 20);\r\n\r\n  const btnW = Math.min(240, W * 0.5);\r\n  const btnH = 54;\r\n  const btnY = cy + 70;\r\n  const btnGrad = ctx.createLinearGradient(cx - btnW/2, btnY, cx + btnW/2, btnY);\r\n  btnGrad.addColorStop(0, '#E2643A');\r\n  btnGrad.addColorStop(0.5, '#9CA05E');\r\n  btnGrad.addColorStop(1, '#E2643A');\r\n  ctx.fillStyle = btnGrad;\r\n  ctx.shadowColor = 'rgba(226,100,58,0.5)';\r\n  ctx.shadowBlur = 25;\r\n  ctx.beginPath();\r\n  ctx.roundRect(cx - btnW/2, btnY - btnH/2, btnW, btnH, 27);\r\n  ctx.fill();\r\n\r\n  ctx.shadowBlur = 0;\r\n  ctx.fillStyle = '#F0EBD8';\r\n  ctx.font = `bold ${Math.min(20, W * 0.028)}px \"Segoe UI\", Arial, sans-serif`;\r\n  ctx.fillText('JUGAR DE NUEVO', cx, btnY + 2);\r\n\r\n  window._btnReplay = { x: cx - btnW/2, y: btnY - btnH/2, w: btnW, h: btnH };\r\n\r\n  ctx.restore();\r\n}\r\n\r\nfunction drawWinScreen() {\r\n  ctx.save();\r\n  ctx.fillStyle = 'rgba(0,0,0,0.6)';\r\n  ctx.fillRect(0, 0, W, H);\r\n\r\n  const cx = W / 2;\r\n  const cy = H / 2;\r\n\r\n  ctx.textAlign = 'center';\r\n  ctx.textBaseline = 'middle';\r\n\r\n  ctx.shadowColor = '#FFD700';\r\n  ctx.shadowBlur = 50;\r\n  ctx.fillStyle = '#FFD700';\r\n  ctx.font = `bold ${Math.min(56, W * 0.08)}px \"Segoe UI\", Arial, sans-serif`;\r\n  ctx.fillText('Ganaste!', cx, cy - 100);\r\n  ctx.shadowBlur = 0;\r\n\r\n  ctx.fillStyle = '#F0EBD8';\r\n  ctx.font = `bold ${Math.min(28, W * 0.04)}px \"Segoe UI\", Arial, sans-serif`;\r\n  ctx.fillText(`Atrapaste ${catchCount} productos de San Juan!`, cx, cy - 40);\r\n\r\n  ctx.fillStyle = 'rgba(240,235,216,0.6)';\r\n  ctx.font = `${Math.min(20, W * 0.028)}px \"Segoe UI\", Arial, sans-serif`;\r\n  ctx.fillText(`Puntaje final: ${score}`, cx, cy + 5);\r\n\r\n  const btnW = Math.min(240, W * 0.5);\r\n  const btnH = 54;\r\n  const btnY = cy + 70;\r\n  ctx.fillStyle = '#4ADE80';\r\n  ctx.shadowColor = 'rgba(74,222,128,0.5)';\r\n  ctx.shadowBlur = 25;\r\n  ctx.beginPath();\r\n  ctx.roundRect(cx - btnW/2, btnY - btnH/2, btnW, btnH, 27);\r\n  ctx.fill();\r\n\r\n  ctx.shadowBlur = 0;\r\n  ctx.fillStyle = '#F0EBD8';\r\n  ctx.font = `bold ${Math.min(20, W * 0.028)}px \"Segoe UI\", Arial, sans-serif`;\r\n  ctx.fillText('JUGAR DE NUEVO', cx, btnY + 2);\r\n\r\n  window._btnReplay = { x: cx - btnW/2, y: btnY - btnH/2, w: btnW, h: btnH };\r\n\r\n  ctx.restore();\r\n}\r\n\r\n// ----- GAME STATE -----\r\nfunction startGame() {\r\n  initAudio();\r\n  resetGame();\r\n  state = 'playing';\r\n  playStart();\r\n  // Hide sello overlay if open\r\n  document.getElementById('selloOverlay').classList.remove('show');\r\n}\r\n\r\n// ===== SELLO CLAIM =====\r\nfunction mostrarSello(){\r\n  document.getElementById('selloNombre').value = '';\r\n  document.getElementById('selloApellido').value = '';\r\n  document.getElementById('selloCorreo').value = '';\r\n  document.getElementById('selloSuccess').classList.remove('show');\r\n  document.getElementById('selloError').classList.remove('show');\r\n  document.getElementById('selloBtn').disabled = false;\r\n  document.getElementById('selloBtn').textContent = 'Reclamar sello';\r\n  document.getElementById('selloOverlay').classList.add('show');\r\n}\r\nfunction cerrarSello(){\r\n  document.getElementById('selloOverlay').classList.remove('show');\r\n}\r\nfunction reclamarSello(){\r\n  const nombre = document.getElementById('selloNombre').value.trim();\r\n  const apellido = document.getElementById('selloApellido').value.trim();\r\n  const correo = document.getElementById('selloCorreo').value.trim();\r\n  const btn = document.getElementById('selloBtn');\r\n  const success = document.getElementById('selloSuccess');\r\n  const error = document.getElementById('selloError');\r\n\r\n  if(!nombre || !apellido || !correo){\r\n    error.textContent = 'Completá todos los campos';\r\n    error.classList.add('show');\r\n    return;\r\n  }\r\n  if(!correo.includes('@')){\r\n    error.textContent = 'Correo inválido';\r\n    error.classList.add('show');\r\n    return;\r\n  }\r\n\r\n  error.classList.remove('show');\r\n  btn.disabled = true;\r\n  btn.textContent = 'Enviando...';\r\n\r\n  fetch('/api/sellos', {\r\n    method: 'POST',\r\n    headers: {'Content-Type': 'application/json'},\r\n    body: JSON.stringify({ juego: 'canasta', nombre, apellido, correo })\r\n  })\r\n  .then(r => r.json())\r\n  .then(data => {\r\n    if(data.ok){\r\n      success.classList.add('show');\r\n      btn.textContent = 'Reclamado!';\r\n    }else{\r\n      throw new Error(data.error || 'Error');\r\n    }\r\n  })\r\n  .catch(err => {\r\n    error.textContent = 'Error al reclamar. Intentalo de nuevo.';\r\n    error.classList.add('show');\r\n    btn.disabled = false;\r\n    btn.textContent = 'Reclamar sello';\r\n  });\r\n}\r\n\r\nfunction endGame() {\r\n  state = 'gameover';\r\n  playGameOver();\r\n}\r\n\r\n// ----- INPUT -----\r\ncanvas.addEventListener('mousemove', e => {\r\n  mouseX = e.clientX;\r\n  mouseY = e.clientY;\r\n  if (state === 'playing' || state === 'start') {\r\n    basketX = Math.max(CFG.basketSize/2, Math.min(W - CFG.basketSize/2, e.clientX));\r\n  }\r\n});\r\n\r\ncanvas.addEventListener('mousedown', e => {\r\n  mouseDown = true;\r\n  if (state === 'start') {\r\n    const b = window._btnPlay;\r\n    if (b && e.clientX >= b.x && e.clientX <= b.x + b.w && e.clientY >= b.y && e.clientY <= b.y + b.h) {\r\n      btnScale = 0.85;\r\n      fadeToBlack = true;\r\n      fadeOut = 0;\r\n      return;\r\n    }\r\n    // Click items during tutorial\r\n    for (const item of items) {\r\n      if (item.hitTest(e.clientX, e.clientY)) {\r\n        catchItem(item);\r\n        break;\r\n      }\r\n    }\r\n  } else if (state === 'gameover' || state === 'win') {\r\n    const b = window._btnReplay;\r\n    if (b && e.clientX >= b.x && e.clientX <= b.x + b.w && e.clientY >= b.y && e.clientY <= b.y + b.h) {\r\n      startGame();\r\n    }\r\n  } else if (state === 'playing') {\r\n    // Click to catch items\r\n    for (const item of items) {\r\n      if (item.hitTest(e.clientX, e.clientY)) {\r\n        catchItem(item);\r\n        break;\r\n      }\r\n    }\r\n  }\r\n});\r\n\r\ncanvas.addEventListener('mouseup', () => mouseDown = false);\r\n\r\ncanvas.addEventListener('touchstart', e => {\r\n  e.preventDefault();\r\n  initAudio();\r\n  for (const t of e.changedTouches) {\r\n    touches[t.identifier] = { x: t.clientX, y: t.clientY };\r\n  }\r\n  if (state === 'start' || state === 'gameover' || state === 'win') {\r\n    const t = e.changedTouches[0];\r\n    const b = state === 'start' ? window._btnPlay : window._btnReplay;\r\n    if (b && t.clientX >= b.x && t.clientX <= b.x + b.w && t.clientY >= b.y && t.clientY <= b.y + b.h) {\r\n      if (state === 'start') { fadeToBlack = true; fadeOut = 0; return; }\r\n      startGame();\r\n      return;\r\n    }\r\n    if (state === 'start') {\r\n      // Tap items during tutorial\r\n      for (const item of items) {\r\n        if (item.hitTest(t.clientX, t.clientY)) {\r\n          catchItem(item);\r\n          break;\r\n        }\r\n      }\r\n    }\r\n  }\r\n  if (state === 'playing') {\r\n    const t = e.changedTouches[0];\r\n    basketX = Math.max(CFG.basketSize/2, Math.min(W - CFG.basketSize/2, t.clientX));\r\n    // Tap to catch items\r\n    for (const item of items) {\r\n      if (item.hitTest(t.clientX, t.clientY)) {\r\n        catchItem(item);\r\n        break;\r\n      }\r\n    }\r\n  }\r\n}, { passive: false });\r\n\r\ncanvas.addEventListener('touchmove', e => {\r\n  e.preventDefault();\r\n  for (const t of e.changedTouches) {\r\n    touches[t.identifier] = { x: t.clientX, y: t.clientY };\r\n  }\r\n  if (state === 'playing') {\r\n    const t = e.changedTouches[0];\r\n    basketX = Math.max(CFG.basketSize/2, Math.min(W - CFG.basketSize/2, t.clientX));\r\n  }\r\n}, { passive: false });\r\n\r\ncanvas.addEventListener('touchend', e => {\r\n  for (const t of e.changedTouches) {\r\n    delete touches[t.identifier];\r\n  }\r\n});\r\n\r\n// Keyboard\r\ndocument.addEventListener('keydown', e => {\r\n  if (e.key === 'p' || e.key === 'P') {\r\n    togglePanel();\r\n  }\r\n  if (state === 'start' && (e.key === 'Enter' || e.key === ' ')) {\r\n    startGame();\r\n  }\r\n  if (state === 'gameover' && (e.key === 'Enter' || e.key === ' ')) {\r\n    startGame();\r\n  }\r\n  if (state === 'win' && (e.key === 'Enter' || e.key === ' ')) {\r\n    startGame();\r\n  }\r\n});\r\n\r\n// ----- CONTROL PANEL -----\r\nlet panelOpen = false;\r\nconst panel = document.getElementById('controlPanel');\r\nconst hint = document.getElementById('panelHint');\r\nlet basketScale = 1;\r\nlet btnScale = 1;\r\nlet fadeOut = 0;\r\nlet fadeToBlack = false;\r\n\r\nfunction togglePanel() {\r\n  panelOpen = !panelOpen;\r\n  panel.classList.toggle('open', panelOpen);\r\n}\r\n\r\n// Tab switching\r\ndocument.querySelectorAll('.tab-btn').forEach(btn => {\r\n  btn.addEventListener('click', () => {\r\n    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));\r\n    document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));\r\n    btn.classList.add('active');\r\n    document.getElementById('tab-' + btn.dataset.tab).classList.add('active');\r\n  });\r\n});\r\n\r\n// Slider bindings\r\nconst sliderMap = {\r\n  sSpeed: { display: 'vSpeed', fmt: v => v },\r\n  sLives: { display: 'vLives', fmt: v => v },\r\n  sSize: { display: 'vSize', fmt: v => v + 'px' },\r\n  sBasket: { display: 'vBasket', fmt: v => v + 'px' },\r\n  sSpawn: { display: 'vSpawn', fmt: v => (v/1000).toFixed(1) + 's' },\r\n  sCombo: { display: 'vCombo', fmt: v => v },\r\n  sWin: { display: 'vWin', fmt: v => v }\r\n};\r\n\r\nconst STYLE_NAMES = ['Horizontal', 'Vertical', 'Diagonal', 'Radial', 'Angular', 'Checker', 'Noise'];\r\n\r\nfunction applySpeed() {\r\n  CFG.speed = parseFloat(document.getElementById('sSpeed').value);\r\n  for (const item of items) {\r\n    item.vy = item.speedFactor * CFG.speed * 25;\r\n  }\r\n}\r\n\r\nfor (const [id, cfg] of Object.entries(sliderMap)) {\r\n  const slider = document.getElementById(id);\r\n  slider.addEventListener('input', () => {\r\n    document.getElementById(cfg.display).textContent = cfg.fmt(parseFloat(slider.value));\r\n    if (id === 'sSpeed') {\r\n      applySpeed();\r\n    }\r\n    if (id === 'sBasket') {\r\n      CFG.basketSize = parseFloat(slider.value);\r\n    }\r\n    if (id === 'sWin') {\r\n      CFG.winTarget = parseFloat(slider.value);\r\n    }\r\n  });\r\n}\r\n\r\n// Shader sliders\r\ndocument.getElementById('sStyle').addEventListener('input', function() {\r\n  shaderStyle = parseFloat(this.value);\r\n  const idx = Math.min(6, Math.floor(shaderStyle / 0.143));\r\n  document.getElementById('vStyle').textContent = STYLE_NAMES[idx];\r\n});\r\ndocument.getElementById('sScale').addEventListener('input', function() {\r\n  shaderScale = parseFloat(this.value);\r\n  document.getElementById('vScale').textContent = shaderScale.toFixed(2);\r\n});\r\ndocument.getElementById('sSpeedS').addEventListener('input', function() {\r\n  shaderSpeed = parseFloat(this.value);\r\n  document.getElementById('vSpeedS').textContent = shaderSpeed.toFixed(2);\r\n});\r\ndocument.getElementById('sVignette').addEventListener('input', function() {\r\n  shaderVignette = parseFloat(this.value);\r\n  document.getElementById('vVig').textContent = shaderVignette.toFixed(2);\r\n});\r\n\r\n// Duration text field\r\ndocument.getElementById('sDur').addEventListener('input', function() {\r\n  document.getElementById('vDur').textContent = this.value;\r\n});\r\n\r\n// Save/load all params to JSON via server API\r\nconst csAPIHost = window.location.hostname;\r\nconst csIsFTP = csAPIHost === 'fullscreencode.com';\r\nconst csIsLocal = csAPIHost === 'localhost' || csAPIHost === '127.0.0.1';\r\nconst CS_API_BASE = csIsFTP\r\n  ? 'https://vps-4455523-x.dattaweb.com/fullscreencode'\r\n  : csIsLocal\r\n    ? window.location.origin\r\n    : window.location.origin + '/fullscreencode';\r\n\r\nasync function saveConfigToServer() {\r\n  const params = {\r\n    speed: document.getElementById('sSpeed').value,\r\n    lives: document.getElementById('sLives').value,\r\n    itemSize: document.getElementById('sSize').value,\r\n    basketSize: document.getElementById('sBasket').value,\r\n    spawn: document.getElementById('sSpawn').value,\r\n    duration: document.getElementById('sDur').value,\r\n    comboThreshold: document.getElementById('sCombo').value,\r\n    winTarget: document.getElementById('sWin').value,\r\n    shaderStyle: shaderStyle,\r\n    shaderScale: shaderScale,\r\n    shaderSpeed: shaderSpeed,\r\n    shaderVignette: shaderVignette\r\n  };\r\n  try {\r\n    await fetch(CS_API_BASE + '/api/canasta/config', {\r\n      method: 'POST',\r\n      headers: { 'Content-Type': 'application/json' },\r\n      body: JSON.stringify(params)\r\n    });\r\n  } catch(e) { console.warn('Error saving config:', e); }\r\n}\r\n\r\nfunction applyConfigToUI(p) {\r\n  document.getElementById('sSpeed').value = p.speed;\r\n  document.getElementById('sLives').value = p.lives;\r\n  document.getElementById('sSize').value = p.itemSize;\r\n  document.getElementById('sBasket').value = p.basketSize || 140;\r\n  document.getElementById('sSpawn').value = p.spawn;\r\n  document.getElementById('sDur').value = p.duration;\r\n  document.getElementById('sCombo').value = p.comboThreshold;\r\n  document.getElementById('sWin').value = p.winTarget || 10;\r\n  shaderStyle = parseFloat(p.shaderStyle) || 0.9;\r\n  shaderScale = parseFloat(p.shaderScale) || 0.2;\r\n  shaderSpeed = parseFloat(p.shaderSpeed) || 0.3;\r\n  shaderVignette = parseFloat(p.shaderVignette) || 0.7;\r\n  document.getElementById('sStyle').value = shaderStyle;\r\n  document.getElementById('sScale').value = shaderScale;\r\n  document.getElementById('sSpeedS').value = shaderSpeed;\r\n  document.getElementById('sVignette').value = shaderVignette;\r\n  // Update displays\r\n  document.getElementById('vSpeed').textContent = p.speed;\r\n  document.getElementById('vLives').textContent = p.lives;\r\n  document.getElementById('vSize').textContent = (p.itemSize || 160) + 'px';\r\n  document.getElementById('vBasket').textContent = (p.basketSize || 140) + 'px';\r\n  document.getElementById('vSpawn').textContent = (parseInt(p.spawn)/1000).toFixed(1) + 's';\r\n  document.getElementById('vDur').textContent = p.duration;\r\n  document.getElementById('vCombo').textContent = p.comboThreshold;\r\n  document.getElementById('vWin').textContent = p.winTarget || 10;\r\n  document.getElementById('vScale').textContent = shaderScale.toFixed(2);\r\n  document.getElementById('vSpeedS').textContent = shaderSpeed.toFixed(2);\r\n  document.getElementById('vVig').textContent = shaderVignette.toFixed(2);\r\n  const idx = Math.min(6, Math.floor(shaderStyle / 0.143));\r\n  document.getElementById('vStyle').textContent = STYLE_NAMES[idx];\r\n  // Apply to CFG\r\n  CFG.speed = parseInt(p.speed);\r\n  CFG.lives = parseInt(p.lives);\r\n  CFG.itemSize = parseInt(p.itemSize);\r\n  CFG.basketSize = parseInt(p.basketSize) || 140;\r\n  CFG.spawnInterval = parseInt(p.spawn);\r\n  CFG.duration = parseInt(p.duration);\r\n  CFG.comboThreshold = parseInt(p.comboThreshold);\r\n  CFG.winTarget = parseInt(p.winTarget) || 10;\r\n}\r\n\r\nasync function loadConfigFromServer() {\r\n  try {\r\n    const res = await fetch(CS_API_BASE + '/api/canasta/config');\r\n    const p = await res.json();\r\n    applyConfigToUI(p);\r\n  } catch(e) { console.warn('Error loading config:', e); }\r\n}\r\n\r\ndocument.getElementById('btnGuardar').addEventListener('click', async () => {\r\n  applySpeed();\r\n  CFG.lives = parseInt(document.getElementById('sLives').value);\r\n  CFG.itemSize = parseInt(document.getElementById('sSize').value);\r\n  CFG.basketSize = parseInt(document.getElementById('sBasket').value);\r\n  CFG.spawnInterval = parseInt(document.getElementById('sSpawn').value);\r\n  CFG.duration = parseInt(document.getElementById('sDur').value);\r\n  CFG.comboThreshold = parseInt(document.getElementById('sCombo').value);\r\n  CFG.winTarget = parseInt(document.getElementById('sWin').value);\r\n  if (state === 'playing') {\r\n    lives = CFG.lives;\r\n  }\r\n  await saveConfigToServer();\r\n  document.getElementById('btnGuardar').textContent = 'Guardado';\r\n  setTimeout(() => {\r\n    document.getElementById('btnGuardar').textContent = 'Guardar Cambios';\r\n  }, 1500);\r\n});\r\n\r\n// Stats update\r\nfunction updateStats(fps) {\r\n  document.getElementById('stFps').textContent = Math.round(fps);\r\n  document.getElementById('stObj').textContent = items.filter(i => !i.caught && !i.missed).length;\r\n  document.getElementById('stPts').textContent = score;\r\n  document.getElementById('stCmb').textContent = maxCombo;\r\n}\r\n\r\n// ----- GAME LOOP -----\r\nlet fpsCounter = 0;\r\nlet fpsTime = 0;\r\nlet currentFps = 0;\r\n\r\nfunction gameLoop(timestamp) {\r\n  const dt = lastTime ? Math.min((timestamp - lastTime) / 1000, 0.05) : 0.016;\r\n  lastTime = timestamp;\r\n\r\n  // FPS\r\n  fpsCounter++;\r\n  if (timestamp - fpsTime >= 1000) {\r\n    currentFps = fpsCounter;\r\n    fpsCounter = 0;\r\n    fpsTime = timestamp;\r\n  }\r\n\r\n  // Render shader background first\r\n  renderShader(dt * 1000);\r\n\r\n  // Then game\r\n  update(dt);\r\n  draw();\r\n  updateStats(currentFps);\r\n\r\n  requestAnimationFrame(gameLoop);\r\n}\r\n\r\n// ----- INIT -----\r\nwindow.addEventListener('resize', resize);\r\ninitShader();\r\nloadConfigFromServer();\r\nresize();\r\nrequestAnimationFrame(gameLoop);\r\n\r\n// Touch roundRect polyfill\r\nif (!CanvasRenderingContext2D.prototype.roundRect) {\r\n  CanvasRenderingContext2D.prototype.roundRect = function(x, y, w, h, radii) {\r\n    if (!Array.isArray(radii)) radii = [radii, radii, radii, radii];\r\n    const [tl, tr, br, bl] = radii.map(r => Math.min(r || 0, Math.min(w, h) / 2));\r\n    this.moveTo(x + tl, y);\r\n    this.lineTo(x + w - tr, y);\r\n    this.quadraticCurveTo(x + w, y, x + w, y + tr);\r\n    this.lineTo(x + w, y + h - br);\r\n    this.quadraticCurveTo(x + w, y + h, x + w - br, y + h);\r\n    this.lineTo(x + bl, y + h);\r\n    this.quadraticCurveTo(x, y + h, x, y + h - bl);\r\n    this.lineTo(x, y + tl);\r\n    this.quadraticCurveTo(x, y, x + tl, y);\r\n    this.closePath();\r\n  };\r\n}\r\n\r\nconsole.log('Canasta - Caminos y Sabores cargado!');\r\nconsole.log('Presiona P para abrir el panel de control');\r\n</script>\r\n</body>\r\n</html>\r\n"
