          "path": "D:/Programacion/caminosysabores/public/redsocial/css/style.css",
          "name": "style.css",
          "content": "/* ============================================\n   San Juan Social - Main Stylesheet\n   Based on Pasaporte San Juan design\n   ============================================ */\n\n/* --- CSS Variables --- */\n:root {\n  /* Primary Palette */\n  --terracota: #C96B4B;\n  --terracota-dark: #B55A3A;\n  --terracota-light: #E8977A;\n  --orange-burnt: #CC5500;\n  --gold-ocre: #D4A05A;\n  --gold-light: #E8C88A;\n  --mustard: #FFC72C;\n  --burgundy: #8B3A2A;\n  --brick-red: #A33A3A;\n  --olive-green: #6B8E23;\n  \n  /* Neutrals */\n  --cream: #F5F0E1;\n  --cream-dark: #E8E0CC;\n  --beige: #F9F7F3;\n  --brown-dark: #332211;\n  --gray-dark: #333333;\n  --gray-medium: #666666;\n  --gray-light: #CCCCCC;\n  --white: #FFFFFF;\n  \n  /* Functional */\n  --success: #4CAF50;\n  --error: #D94E3E;\n  --warning: #FF9966;\n  \n  /* Typography */\n  --font-heading: 'Montserrat', sans-serif;\n  --font-body: 'Open Sans', sans-serif;\n  \n  /* Spacing */\n  --space-xs: 4px;\n  --space-sm: 8px;\n  --space-md: 16px;\n  --space-lg: 24px;\n  --space-xl: 32px;\n  --space-2xl: 48px;\n  --space-3xl: 64px;\n  \n  /* Border Radius */\n  --radius-sm: 4px;\n  --radius-md: 8px;\n  --radius-lg: 12px;\n  --radius-xl: 20px;\n  --radius-full: 50%;\n  \n  /* Shadows */\n  --shadow-sm: 0 1px 3px rgba(51, 34, 17, 0.08);\n  --shadow-md: 0 2px 12px rgba(51, 34, 17, 0.08);\n  --shadow-lg: 0 4px 20px rgba(51, 34, 17, 0.12);\n  --shadow-xl: 0 8px 32px rgba(51, 34, 17, 0.15);\n  \n  /* Transitions */\n  --transition-fast: 0.2s ease;\n  --transition-base: 0.3s ease;\n  --transition-slow: 0.5s ease;\n}\n\n/* --- Reset --- */\n*, *::before, *::after {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nhtml {\n  scroll-behavior: smooth;\n  font-size: 16px;\n}\n\nbody {\n  font-family: var(--font-body);\n  color: var(--gray-dark);\n  background: var(--cream);\n  line-height: 1.6;\n  min-height: 100vh;\n}\n\na {\n  color: var(--terracota);\n  text-decoration: none;\n  transition: color var(--transition-base);\n}\n\na:hover {\n  color: var(--orange-burnt);\n}\n\nimg {\n  max-width: 100%;\n  height: auto;\n  display: block;\n}\n\n/* --- Container --- */\n.container {\n  max-width: 1200px;\n  margin: 0 auto;\n  padding: 0 var(--space-lg);\n}\n\n/* --- Header --- */\n.header {\n  background: linear-gradient(135deg, var(--terracota), var(--burgundy));\n  padding: 0 var(--space-lg);\n  position: sticky;\n  top: 0;\n  z-index: 100;\n  box-shadow: var(--shadow-lg);\n}\n\n.header-inner {\n  max-width: 1200px;\n  margin: 0 auto;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  height: 64px;\n}\n\n.logo {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n  color: var(--cream);\n  text-decoration: none;\n}\n\n.logo-img {\n  width: 36px;\n  height: 36px;\n  border-radius: var(--radius-full);\n  object-fit: cover;\n}\n\n.logo-icon {\n  font-size: 1.5rem;\n  color: var(--mustard);\n}\n\n.logo-text {\n  font-family: var(--font-heading);\n  font-weight: 800;\n  font-size: 1.2rem;\n  letter-spacing: 0.1em;\n  white-space: nowrap;\n}\n\n.logo-highlight {\n  color: var(--mustard);\n}\n\n.nav {\n  display: flex;\n  gap: var(--space-lg);\n}\n\n.nav-link {\n  color: var(--cream);\n  font-family: var(--font-heading);\n  font-weight: 600;\n  font-size: 0.85rem;\n  letter-spacing: 0.05em;\n  text-transform: uppercase;\n  padding: var(--space-sm) 0;\n  position: relative;\n  transition: color var(--transition-base);\n}\n\n.nav-link:hover,\n.nav-link.active {\n  color: var(--mustard);\n}\n\n.nav-link::after {\n  content: '';\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  width: 0;\n  height: 2px;\n  background: var(--mustard);\n  transition: width var(--transition-base);\n}\n\n.nav-link:hover::after,\n.nav-link.active::after {\n  width: 100%;\n}\n\n.header-actions {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n}\n\n.hamburger {\n  display: none;\n  background: none;\n  border: none;\n  color: var(--cream);\n  font-size: 1.5rem;\n  cursor: pointer;\n}\n\n/* Remove hero-stamp - no longer used */\n.hero-stamp {\n  display: none !important;\n}\n\n/* --- Buttons --- */\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--space-sm);\n  font-family: var(--font-heading);\n  font-weight: 600;\n  font-size: 0.85rem;\n  letter-spacing: 0.05em;\n  text-transform: uppercase;\n  padding: 10px 24px;\n  border-radius: var(--radius-md);\n  border: 2px solid transparent;\n  cursor: pointer;\n  transition: all var(--transition-base);\n  text-decoration: none;\n}\n\n.btn:active {\n  transform: scale(0.97);\n}\n\n.btn-primary {\n  background: linear-gradient(135deg, var(--terracota), var(--orange-burnt));\n  color: var(--white);\n  border-color: transparent;\n}\n\n.btn-primary:hover {\n  background: linear-gradient(135deg, var(--orange-burnt), var(--terracota-dark));\n  color: var(--white);\n  box-shadow: var(--shadow-md);\n  transform: translateY(-1px);\n}\n\n.btn-secondary {\n  background: transparent;\n  color: var(--cream);\n  border-color: var(--cream);\n}\n\n.btn-secondary:hover {\n  background: var(--cream);\n  color: var(--terracota);\n}\n\n.btn-outline {\n  background: transparent;\n  color: var(--cream);\n  border-color: rgba(245, 240, 225, 0.5);\n}\n\n.btn-outline:hover {\n  border-color: var(--cream);\n  color: var(--cream);\n  background: rgba(255, 255, 255, 0.1);\n}\n\n.btn-outline-light {\n  background: transparent;\n  color: var(--cream);\n  border-color: var(--cream);\n}\n\n.btn-outline-light:hover {\n  background: var(--cream);\n  color: var(--brown-dark);\n}\n\n.btn-lg {\n  padding: 14px 32px;\n  font-size: 0.95rem;\n}\n\n.btn-full {\n  width: 100%;\n}\n\n.btn-danger {\n  background: var(--error);\n  color: var(--white);\n  border-color: transparent;\n}\n\n.btn-danger:hover {\n  background: #c0392b;\n  color: var(--white);\n}\n\n/* --- Hero Section --- */\n.hero {\n  position: relative;\n  background: linear-gradient(135deg, var(--terracota), var(--burgundy));\n  min-height: 360px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  overflow: hidden;\n}\n\n#heroCanvas {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  z-index: 1;\n  pointer-events: none;\n}\n\n.hero::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: \n    radial-gradient(circle at 20% 80%, rgba(212, 160, 90, 0.15) 0%, transparent 50%),\n    radial-gradient(circle at 80% 20%, rgba(255, 199, 44, 0.1) 0%, transparent 50%);\n  z-index: 1;\n}\n\n.hero-overlay {\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background-image: url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\");\n  z-index: 1;\n}\n\n.hero-content {\n  position: relative;\n  z-index: 2;\n  text-align: center;\n  padding: var(--space-3xl) var(--space-lg);\n  max-width: 850px;\n}\n\n.hero-brand {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--space-lg);\n  margin-bottom: var(--space-lg);\n  flex-wrap: wrap;\n}\n\n.hero-logo {\n  width: 120px;\n  height: 120px;\n  border-radius: var(--radius-full);\n  object-fit: cover;\n  flex-shrink: 0;\n}\n\n.hero-badge {\n  display: inline-block;\n  background: var(--burgundy);\n  color: var(--cream);\n  font-family: var(--font-heading);\n  font-weight: 700;\n  font-size: 0.8rem;\n  letter-spacing: 0.12em;\n  padding: 6px 16px;\n  border-radius: var(--radius-sm);\n  margin-bottom: var(--space-lg);\n  text-transform: uppercase;\n}\n\n.hero-title {\n  font-family: var(--font-heading);\n  font-weight: 800;\n  font-size: 2.8rem;\n  color: var(--cream);\n  letter-spacing: 0.03em;\n  text-transform: uppercase;\n  margin-bottom: 0;\n  text-shadow: 0 2px 10px rgba(0,0,0,0.2);\n  white-space: nowrap;\n}\n\n.hero-subtitle {\n  font-family: var(--font-body);\n  font-size: 1.2rem;\n  color: rgba(245, 240, 225, 0.85);\n  margin-bottom: var(--space-xl);\n  line-height: 1.7;\n}\n\n.hero-actions {\n  display: flex;\n  gap: var(--space-md);\n  justify-content: center;\n  flex-wrap: wrap;\n}\n\n.hero-stamp {\n  position: absolute;\n  top: var(--space-lg);\n  right: var(--space-xl);\n  background: var(--burgundy);\n  color: var(--cream);\n  padding: 8px 14px;\n  font-family: var(--font-heading);\n  font-weight: 700;\n  font-size: 0.7rem;\n  letter-spacing: 0.1em;\n  text-align: center;\n  line-height: 1.4;\n  border-radius: var(--radius-sm);\n  transform: rotate(5deg);\n  z-index: 2;\n  border: 1px solid var(--mustard);\n}\n\n/* --- Search + Hashtags Filter --- */\n.search-section {\n  background: var(--white);\n  border-bottom: 1px solid var(--cream-dark);\n  padding: var(--space-md) 0;\n  position: sticky;\n  top: 64px;\n  z-index: 50;\n}\n\n.search-bar-wrapper {\n  display: flex;\n  align-items: center;\n  gap: var(--space-md);\n  flex-wrap: wrap;\n}\n\n.search-input-group {\n  display: flex;\n  align-items: center;\n  background: var(--beige);\n  border: 2px solid var(--cream-dark);\n  border-radius: 24px;\n  padding: 0 var(--space-md);\n  transition: border-color var(--transition-base);\n  flex: 1;\n  min-width: 200px;\n}\n\n.search-input-group:focus-within {\n  border-color: var(--terracota);\n}\n\n.search-icon {\n  font-size: 1.1rem;\n  color: var(--gray-medium);\n  margin-right: var(--space-sm);\n}\n\n.search-input {\n  flex: 1;\n  border: none;\n  background: transparent;\n  padding: 10px 0;\n  font-family: var(--font-body);\n  font-size: 0.95rem;\n  color: var(--brown-dark);\n  outline: none;\n}\n\n.search-input::placeholder {\n  color: var(--gray-light);\n}\n\n.search-hashtags {\n  display: flex;\n  gap: var(--space-xs);\n  flex-wrap: wrap;\n  padding: var(--space-xs) 0;\n  flex-shrink: 0;\n}\n\n.search-event-badge {\n  display: inline-block;\n  background: var(--burgundy);\n  color: var(--cream);\n  font-family: var(--font-heading);\n  font-weight: 700;\n  font-size: 0.75rem;\n  letter-spacing: 0.05em;\n  padding: 6px 16px;\n  border-radius: var(--radius-md);\n  text-transform: uppercase;\n  white-space: nowrap;\n  border: 1px solid var(--mustard);\n  box-shadow: 0 2px 8px rgba(0,0,0,0.1);\n}\n\n.hashtag-pill {\n  flex-shrink: 0;\n  background: var(--beige);\n  border: 1px solid var(--cream-dark);\n  color: var(--gray-medium);\n  font-family: var(--font-heading);\n  font-weight: 600;\n  font-size: 0.75rem;\n  padding: 5px 14px;\n  border-radius: 16px;\n  cursor: pointer;\n  transition: all var(--transition-base);\n}\n\n.hashtag-pill:hover {\n  border-color: var(--terracota-light);\n  color: var(--terracota);\n  background: rgba(201, 107, 75, 0.05);\n}\n\n.hashtag-pill.active {\n  background: var(--terracota);\n  color: var(--white);\n  border-color: var(--terracota);\n}\n\n/* Old pills class - keep for compatibility */\n.hashtag-pills {\n  display: flex;\n  gap: var(--space-xs);\n  flex-wrap: wrap;\n  padding: var(--space-xs) 0;\n}\n\n/* --- Auth Modal --- */\n.modal-overlay {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: rgba(0,0,0,0.6);\n  z-index: 200;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  animation: fadeIn 0.3s ease;\n}\n\n.modal-content {\n  background: var(--beige);\n  border-radius: var(--radius-lg);\n  padding: var(--space-2xl);\n  max-width: 400px;\n  width: 90%;\n  text-align: center;\n  position: relative;\n  box-shadow: var(--shadow-xl);\n  animation: slideUp 0.3s ease;\n}\n\n.modal-close {\n  position: absolute;\n  top: var(--space-md);\n  right: var(--space-md);\n  background: none;\n  border: none;\n  font-size: 1.5rem;\n  color: var(--gray-medium);\n  cursor: pointer;\n  transition: color var(--transition-base);\n}\n\n.modal-close:hover {\n  color: var(--brown-dark);\n}\n\n.modal-icon {\n  font-size: 2.5rem;\n  color: var(--terracota);\n  margin-bottom: var(--space-sm);\n}\n\n.modal-header h2 {\n  font-family: var(--font-heading);\n  font-weight: 800;\n  color: var(--brown-dark);\n  margin-bottom: var(--space-xs);\n}\n\n.modal-header p {\n  color: var(--gray-medium);\n  margin-bottom: var(--space-lg);\n}\n\n.modal-actions {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-sm);\n}\n\n.modal-actions .btn-outline {\n  color: var(--terracota);\n  border-color: var(--terracota);\n}\n\n.modal-actions .btn-outline:hover {\n  background: var(--terracota);\n  color: var(--white);\n}\n\n@keyframes fadeIn {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes slideUp {\n  from { transform: translateY(20px); opacity: 0; }\n  to { transform: translateY(0); opacity: 1; }\n}\n\n/* Hashtag tags inside post cards */\n.post-hashtags {\n  display: flex;\n  gap: 4px;\n  flex-wrap: wrap;\n  margin-top: var(--space-sm);\n}\n\n.hashtag-tag {\n  display: inline-block;\n  background: rgba(201, 107, 75, 0.08);\n  color: var(--terracota);\n  font-family: var(--font-heading);\n  font-weight: 600;\n  font-size: 0.7rem;\n  padding: 2px 10px;\n  border-radius: 10px;\n}\n\n/* --- Feed Section --- */\n.feed-section {\n  padding: var(--space-3xl) 0;\n  background: var(--beige);\n}\n\n.feed-header {\n  text-align: center;\n  margin-bottom: var(--space-2xl);\n}\n\n.feed-header h2 {\n  font-family: var(--font-heading);\n  font-weight: 800;\n  font-size: 2rem;\n  color: var(--brown-dark);\n  letter-spacing: 0.03em;\n  text-transform: uppercase;\n  margin-bottom: var(--space-sm);\n}\n\n.feed-subtitle {\n  color: var(--gray-medium);\n  font-size: 1.05rem;\n  max-width: 500px;\n  margin: 0 auto;\n}\n\n.feed-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));\n  gap: var(--space-lg);\n}\n\n/* --- Post Card --- */\n.post-card {\n  background: var(--white);\n  border-radius: var(--radius-lg);\n  overflow: hidden;\n  box-shadow: var(--shadow-md);\n  transition: all var(--transition-base);\n  animation: fadeInUp 0.5s ease forwards;\n}\n\n.post-card:hover {\n  box-shadow: var(--shadow-lg);\n  transform: translateY(-2px);\n}\n\n.post-card-image {\n  width: 100%;\n  height: 220px;\n  object-fit: cover;\n  background: var(--cream-dark);\n}\n\n.post-card-image-placeholder {\n  width: 100%;\n  height: 220px;\n  background: linear-gradient(135deg, var(--cream-dark), var(--cream));\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 3rem;\n  color: var(--terracota-light);\n}\n\n.post-card-body {\n  padding: var(--space-lg);\n}\n\n.post-card-meta {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n  margin-bottom: var(--space-sm);\n  flex-wrap: wrap;\n}\n\n.post-category {\n  display: inline-block;\n  background: var(--beige);\n  color: var(--terracota);\n  font-family: var(--font-heading);\n  font-weight: 600;\n  font-size: 0.7rem;\n  letter-spacing: 0.08em;\n  padding: 3px 10px;\n  border-radius: var(--radius-sm);\n  text-transform: uppercase;\n}\n\n.post-date {\n  font-size: 0.8rem;\n  color: var(--gray-light);\n}\n\n.post-card-title {\n  font-family: var(--font-heading);\n  font-weight: 700;\n  font-size: 1.15rem;\n  color: var(--brown-dark);\n  margin-bottom: var(--space-sm);\n  line-height: 1.4;\n}\n\n.post-card-content {\n  color: var(--gray-medium);\n  font-size: 0.92rem;\n  line-height: 1.7;\n  display: -webkit-box;\n  -webkit-line-clamp: 3;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n  margin-bottom: var(--space-md);\n}\n\n.post-card-footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding-top: var(--space-md);\n  border-top: 1px solid var(--beige);\n}\n\n.post-author {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n}\n\n.post-author-avatar {\n  width: 32px;\n  height: 32px;\n  border-radius: var(--radius-full);\n  background: var(--terracota);\n  color: var(--white);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-family: var(--font-heading);\n  font-weight: 700;\n  font-size: 0.8rem;\n  overflow: hidden;\n}\n\n.post-author-avatar img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.post-author-name {\n  font-weight: 600;\n  font-size: 0.85rem;\n  color: var(--gray-dark);\n}\n\n.post-location {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  font-size: 0.8rem;\n  color: var(--terracota);\n  font-weight: 600;\n}\n\n.post-actions {\n  display: flex;\n  gap: var(--space-sm);\n}\n\n.post-action-btn {\n  background: none;\n  border: none;\n  color: var(--gray-medium);\n  cursor: pointer;\n  font-size: 0.85rem;\n  padding: 4px 8px;\n  border-radius: var(--radius-sm);\n  transition: all var(--transition-fast);\n}\n\n.post-action-btn:hover {\n  background: var(--beige);\n  color: var(--error);\n}\n\n/* --- Loading Spinner --- */\n.loading-spinner {\n  grid-column: 1 / -1;\n  text-align: center;\n  padding: var(--space-3xl);\n}\n\n.spinner {\n  width: 40px;\n  height: 40px;\n  border: 3px solid var(--cream-dark);\n  border-top-color: var(--terracota);\n  border-radius: var(--radius-full);\n  animation: spin 0.8s linear infinite;\n  margin: 0 auto var(--space-md);\n}\n\n.spinner-sm {\n  display: inline-block;\n  width: 18px;\n  height: 18px;\n  border: 2px solid rgba(255,255,255,0.3);\n  border-top-color: var(--white);\n  border-radius: var(--radius-full);\n  animation: spin 0.8s linear infinite;\n}\n\n/* --- Empty State --- */\n.feed-empty {\n  grid-column: 1 / -1;\n  text-align: center;\n  padding: var(--space-3xl);\n  color: var(--gray-medium);\n}\n\n.empty-icon {\n  font-size: 3rem;\n  color: var(--terracota-light);\n  margin-bottom: var(--space-md);\n}\n\n.feed-empty h3 {\n  font-family: var(--font-heading);\n  color: var(--brown-dark);\n  margin-bottom: var(--space-sm);\n}\n\n/* --- Footer --- */\n.footer {\n  background: var(--brown-dark);\n  color: var(--cream);\n  padding: var(--space-2xl) 0 var(--space-lg);\n}\n\n.footer-grid {\n  display: grid;\n  grid-template-columns: 2fr 1fr 1fr;\n  gap: var(--space-xl);\n  margin-bottom: var(--space-xl);\n}\n\n.footer-logo {\n  font-family: var(--font-heading);\n  font-weight: 800;\n  font-size: 1.1rem;\n  letter-spacing: 0.12em;\n  display: block;\n  margin-bottom: var(--space-md);\n}\n\n.footer-brand p {\n  color: rgba(245, 240, 225, 0.7);\n  font-size: 0.9rem;\n  line-height: 1.7;\n}\n\n.footer-links h4 {\n  font-family: var(--font-heading);\n  font-weight: 700;\n  font-size: 0.85rem;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--gold-ocre);\n  margin-bottom: var(--space-md);\n}\n\n.footer-links a {\n  display: block;\n  color: rgba(245, 240, 225, 0.7);\n  font-size: 0.9rem;\n  margin-bottom: var(--space-sm);\n  transition: color var(--transition-base);\n}\n\n.footer-links a:hover {\n  color: var(--mustard);\n}\n\n.footer-bottom {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding-top: var(--space-lg);\n  border-top: 1px solid rgba(245, 240, 225, 0.1);\n  font-size: 0.85rem;\n  color: rgba(245, 240, 225, 0.5);\n}\n\n.footer-stamp {\n  font-family: var(--font-heading);\n  font-weight: 700;\n  font-size: 0.7rem;\n  letter-spacing: 0.12em;\n  color: var(--gold-ocre);\n  padding: 4px 12px;\n  border: 1px solid var(--gold-ocre);\n  border-radius: var(--radius-sm);\n}\n\n/* --- Form Elements --- */\n.form-group {\n  margin-bottom: var(--space-lg);\n}\n\n.form-group label {\n  display: block;\n  font-family: var(--font-heading);\n  font-weight: 600;\n  font-size: 0.85rem;\n  color: var(--gray-dark);\n  margin-bottom: 6px;\n  letter-spacing: 0.02em;\n}\n\n.form-group input,\n.form-group textarea,\n.form-group select {\n  width: 100%;\n  padding: 12px 16px;\n  font-family: var(--font-body);\n  font-size: 1rem;\n  color: var(--gray-dark);\n  background: var(--white);\n  border: 2px solid var(--gray-light);\n  border-radius: var(--radius-md);\n  outline: none;\n  transition: all var(--transition-fast);\n}\n\n.form-group input:focus,\n.form-group textarea:focus,\n.form-group select:focus {\n  border-color: var(--terracota);\n  box-shadow: 0 0 0 3px rgba(201, 107, 75, 0.15);\n}\n\n.form-group input::placeholder,\n.form-group textarea::placeholder {\n  color: #999999;\n}\n\n.form-group textarea {\n  resize: vertical;\n  min-height: 100px;\n}\n\n.form-error {\n  background: rgba(217, 78, 62, 0.1);\n  border: 1px solid var(--error);\n  color: var(--error);\n  padding: 10px 16px;\n  border-radius: var(--radius-md);\n  font-size: 0.9rem;\n  margin-bottom: var(--space-md);\n}\n\n/* --- Modal --- */\n.modal {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  z-index: 200;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.modal-backdrop {\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: rgba(0, 0, 0, 0.5);\n  backdrop-filter: blur(4px);\n}\n\n.modal-content {\n  position: relative;\n  background: var(--white);\n  border-radius: var(--radius-lg);\n  padding: var(--space-xl);\n  max-width: 500px;\n  width: 90%;\n  box-shadow: var(--shadow-xl);\n  animation: modalIn 0.3s ease;\n}\n\n.modal-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: var(--space-lg);\n}\n\n.modal-header h3 {\n  font-family: var(--font-heading);\n  font-weight: 700;\n  color: var(--brown-dark);\n}\n\n.modal-close {\n  background: none;\n  border: none;\n  font-size: 1.5rem;\n  color: var(--gray-medium);\n  cursor: pointer;\n  padding: 4px;\n  line-height: 1;\n}\n\n.modal-actions {\n  display: flex;\n  gap: var(--space-sm);\n  justify-content: flex-end;\n  margin-top: var(--space-lg);\n}\n\n/* --- Animations --- */\n@keyframes spin {\n  to { transform: rotate(360deg); }\n}\n\n@keyframes fadeInUp {\n  from {\n    opacity: 0;\n    transform: translateY(20px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n@keyframes modalIn {\n  from {\n    opacity: 0;\n    transform: scale(0.95) translateY(10px);\n  }\n  to {\n    opacity: 1;\n    transform: scale(1) translateY(0);\n  }\n}\n\n/* --- Toast Notification --- */\n.toast {\n  position: fixed;\n  bottom: var(--space-xl);\n  right: var(--space-xl);\n  background: var(--brown-dark);\n  color: var(--cream);\n  padding: 16px 24px;\n  border-radius: var(--radius-md);\n  box-shadow: var(--shadow-lg);\n  z-index: 300;\n  animation: slideIn 0.3s ease;\n  max-width: 400px;\n}\n\n.toast.success {\n  border-left: 4px solid var(--success);\n}\n\n.toast.error {\n  border-left: 4px solid var(--error);\n}\n\n@keyframes slideIn {\n  from {\n    opacity: 0;\n    transform: translateX(100px);\n  }\n  to {\n    opacity: 1;\n    transform: translateX(0);\n  }\n}\n\n/* --- Responsive --- */\n@media (max-width: 768px) {\n  .nav {\n    display: none;\n    position: absolute;\n    top: 64px;\n    left: 0;\n    right: 0;\n    background: var(--burgundy);\n    flex-direction: column;\n    padding: var(--space-md);\n    gap: var(--space-sm);\n  }\n  \n  .nav.open {\n    display: flex;\n  }\n  \n  .hamburger {\n    display: block;\n  }\n  \n  .hero-title {\n    font-size: 2rem;\n  }\n  \n  .hero-subtitle {\n    font-size: 1rem;\n  }\n  \n  .feed-grid {\n    grid-template-columns: 1fr;\n  }\n  \n  .footer-grid {\n    grid-template-columns: 1fr;\n    gap: var(--space-lg);\n  }\n  \n  .hero-actions {\n    flex-direction: column;\n    align-items: center;\n  }\n\n  .hero-brand {\n    gap: var(--space-md);\n    flex-direction: column;\n  }\n\n  .hero-logo {\n    width: 90px;\n    height: 90px;\n  }\n  \n  .header-actions .btn:not(.hamburger) {\n    display: none;\n  }\n  \n  .hero-stamp {\n    display: none;\n  }\n}\n\n@media (max-width: 480px) {\n  .hero-title {\n    font-size: 1.8rem;\n  }\n\n  .hero-logo {\n    width: 70px;\n    height: 70px;\n  }\n\n  .container {\n    padding: 0 var(--space-md);\n  }\n  \n  .post-card-body {\n    padding: var(--space-md);\n  }\n}\n\n/* --- Stats Section --- */\n.stats-section {\n  background: var(--white);\n  padding: var(--space-3xl) 0;\n  border-top: 1px solid var(--cream-dark);\n}\n\n.stats-grid {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: var(--space-xl);\n  text-align: center;\n}\n\n.stat-item {\n  padding: var(--space-lg);\n}\n\n.stat-number {\n  display: block;\n  font-family: var(--font-heading);\n  font-weight: 800;\n  font-size: 2.5rem;\n  color: var(--terracota);\n  margin-bottom: var(--space-xs);\n}\n\n.stat-desc {\n  font-size: 0.9rem;\n  color: var(--gray-medium);\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  font-weight: 600;\n}\n\n@media (max-width: 768px) {\n  .stats-grid {\n    grid-template-columns: repeat(2, 1fr);\n    gap: var(--space-md);\n  }\n  .stat-number {\n    font-size: 2rem;\n  }\n}\n\n/* --- Utilities --- */\n.text-center { text-align: center; }\n.mt-2 { margin-top: var(--space-lg); }\n.mb-2 { margin-bottom: var(--space-lg); }\n.hidden { display: none !important; }\n"
