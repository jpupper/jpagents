        {
          "path": "D:/Programacion/caminosysabores/public/maridaje_mauricio_savoca.html",
          "name": "maridaje_mauricio_savoca.html",
          "content": "<!DOCTYPE html>\r\n<html lang=\"es\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>San Juan a la mesa - Maridaje con Mauricio Barón</title>\r\n    <link rel=\"stylesheet\" href=\"css/style.css\">\r\n    <link rel=\"stylesheet\" href=\"css/actividad-detalle.css\">\r\n</head>\r\n<body>\r\n    <main class=\"activity-detail-page\" style=\"--accent: #e6643c; --accent-soft: rgba(230, 100, 60, 0.18);\">\r\n        <section class=\"hero-section activity-detail-hero\">\r\n            <img src=\"assets/Actividades/maridaje/fondo.png\" alt=\"Maridaje con Mauricio Savoca\" class=\"background-image\">\r\n            <div class=\"content-container\">\r\n                <h1 class=\"tagline\">Maridaje con el<br>Chef Mauricio Barón</h1>\r\n            </div>\r\n        </section>\r\n\r\n        <section class=\"text-section activity-copy\">\r\n            <p class=\"intro-text\">Una propuesta gastronómica para descubrir cómo los productos sanjuaninos pueden combinarse y potenciarse en la mesa.</p>\r\n            <p>Un encuentro para explorar los sabores de San Juan a través de combinaciones simples, cercanas y pensadas para destacar sus productos de origen.</p>\r\n            <p><strong>La actividad propone conocer nuevas formas de disfrutar ingredientes sanjuaninos, vinculando producción, cocina y experiencia.</strong></p>\r\n            <p>Una oportunidad para acercarse a los sabores de la provincia desde una mirada gastronómica e informativa.</p>\r\n        </section>\r\n\r\n        <section class=\"event-invite\" data-default-day=\"jueves\">\r\n            <h2>Te invitamos a participar del evento</h2>\r\n            <div class=\"days-line\">\r\n                <button type=\"button\" class=\"day-tab active\" data-day=\"jueves\">Jueves</button>\r\n                <span class=\"days-separator\">·</span>\r\n                <button type=\"button\" class=\"day-tab\" data-day=\"viernes\">Viernes</button>\r\n                <span class=\"days-separator\">·</span>\r\n                <button type=\"button\" class=\"day-tab\" data-day=\"sabado\">Sábado</button>\r\n                <span class=\"days-separator\">·</span>\r\n                <button type=\"button\" class=\"day-tab\" data-day=\"domingo\">Domingo</button>\r\n            </div>\r\n            <div class=\"schedule-grid\" data-schedule-jueves=\"13hs|18hs\" data-schedule-viernes=\"13hs|18hs\" data-schedule-sabado=\"13hs|18hs\" data-schedule-domingo=\"16hs|19hs\"></div>\r\n        </section>\r\n    </main>\r\n\r\n    <script src=\"js/env.js\"></script>\r\n    <script src=\"js/header.js\"></script>\r\n    <script src=\"js/footer.js\"></script>\r\n    <script src=\"js/actividad-detalle.js\"></script>\r\n    <script src=\"js/touch.js\"></script>\r\n</body>\r\n</html>\r\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/public/senti_san_juan.html",
          "name": "senti_san_juan.html",
          "content": "<!DOCTYPE html>\r\n<html lang=\"es\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>San Juan a la mesa - Sentí San Juan</title>\r\n    <link rel=\"stylesheet\" href=\"css/style.css\">\r\n    <link rel=\"stylesheet\" href=\"css/actividad-detalle.css\">\r\n</head>\r\n<body>\r\n    <main class=\"activity-detail-page\" style=\"--accent: #e6643c; --accent-soft: rgba(230, 100, 60, 0.18);\">\r\n        <section class=\"hero-section activity-detail-hero\">\r\n            <img src=\"assets/Actividades/senti_sanjuan/fondo.png\" alt=\"Sentí San Juan\" class=\"background-image\">\r\n            <div class=\"content-container\">\r\n                <h1 class=\"tagline\">Sentí San Juan</h1>\r\n            </div>\r\n        </section>\r\n\r\n        <section class=\"text-section activity-copy\">\r\n            <p class=\"intro-text\">Un juego sensorial para descubrir productos, aromas e imágenes que forman parte de la identidad sanjuanina.</p>\r\n            <p>Sentí San Juan es <strong>una experiencia lúdica y participativa de distintias rondas que ponen a prueba cuánto conocés sobre la provincia</strong>. </p>\r\n            <p>Una actividad breve, dinámica y pensada para vivir San Juan a través de los sentidos.</p>\r\n        </section>\r\n\r\n        <section class=\"event-invite\" data-default-day=\"jueves\">\r\n            <h2>Te invitamos a participar del evento</h2>\r\n            <div class=\"days-line\">\r\n                <button type=\"button\" class=\"day-tab active\" data-day=\"jueves\">Jueves</button>\r\n                <span class=\"days-separator\">·</span>\r\n                <button type=\"button\" class=\"day-tab\" data-day=\"viernes\">Viernes</button>\r\n                <span class=\"days-separator\">·</span>\r\n                <button type=\"button\" class=\"day-tab\" data-day=\"sabado\">Sábado</button>\r\n                <span class=\"days-separator\">·</span>\r\n                <button type=\"button\" class=\"day-tab\" data-day=\"domingo\">Domingo</button>\r\n            </div>\r\n            <div class=\"schedule-grid\" data-schedule-jueves=\"12hs|19hs\" data-schedule-viernes=\"12hs|19hs\" data-schedule-sabado=\"12hs|19hs\" data-schedule-domingo=\"12hs|15hs\"></div>\r\n        </section>\r\n    </main>\r\n\r\n    <script src=\"js/env.js\"></script>\r\n    <script src=\"js/header.js\"></script>\r\n    <script src=\"js/footer.js\"></script>\r\n    <script src=\"js/actividad-detalle.js\"></script>\r\n    <script src=\"js/touch.js\"></script>\r\n</body>\r\n</html>\r\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/public/js/sabores.js",
          "name": "sabores.js",
          "content": "document.addEventListener(\"DOMContentLoaded\", () => {\r\n  // Elementos del DOM\r\n  const recetaOverlay = document.getElementById(\"receta-overlay\")\r\n  const videoOverlay = document.getElementById(\"video-overlay\")\r\n  const recetaImagen = document.getElementById(\"receta-imagen\")\r\n  const youtubePlayer = document.getElementById(\"youtube-player\")\r\n  const videoFallback = document.getElementById(\"video-fallback\")\r\n  const openYoutubeBtn = document.getElementById(\"open-youtube\")\r\n  const closeOverlayBtn = document.getElementById(\"close-overlay\")\r\n\r\n  let currentVideoId = \"\"\r\n  let currentVideoUrl = \"\"\r\n\r\n  // Elementos para el video del tomaticán\r\n  const tomaticanContainer = document.querySelector(\".video-tomatican-container\")\r\n  const playButton = document.querySelector(\".play-button\")\r\n  const tomaticanPlayer = document.getElementById(\"tomatican-player\")\r\n  const videoPreview = document.querySelector(\".video-preview\")\r\n\r\n  // Función para mostrar/ocultar el botón de cierre\r\n  function toggleCloseButton(show) {\r\n    if (closeOverlayBtn) {\r\n      if (show) {\r\n        closeOverlayBtn.classList.add(\"show\")\r\n      } else {\r\n        closeOverlayBtn.classList.remove(\"show\")\r\n      }\r\n    }\r\n  }\r\n\r\n  // Función para determinar si es móvil\r\n  function isMobile() {\r\n    return window.innerWidth <= 768\r\n  }\r\n\r\n  // Función para obtener el ID de video correcto según el dispositivo\r\n  function getVideoId(element) {\r\n    if (isMobile()) {\r\n      return element.dataset.mobileVideo || element.dataset.video\r\n    }\r\n    return element.dataset.video\r\n  }\r\n\r\n  // Función para obtener thumbnail de YouTube\r\n  function getYouTubeThumbnail(videoId) {\r\n    return `https://img.youtube.com/vi/${videoId}/maxresdefault.jpg`\r\n  }\r\n\r\n  // Función simple para construir URL de embed\r\n  function buildYouTubeEmbedURL(videoId) {\r\n    const params = new URLSearchParams({\r\n      autoplay: \"1\",\r\n      rel: \"0\", // Minimiza videos relacionados\r\n      modestbranding: \"1\", // Oculta logo de YouTube\r\n      showinfo: \"0\", // Oculta información del video\r\n      controls: \"1\", // Mantiene controles básicos\r\n      fs: \"1\", // Permite pantalla completa\r\n      cc_load_policy: \"0\", // No carga subtítulos automáticamente\r\n      iv_load_policy: \"3\", // Oculta anotaciones\r\n      playsinline: \"1\", // Para reproducción inline en móviles\r\n      enablejsapi: \"1\", // Habilita API de JavaScript\r\n      origin: window.location.origin, // Para seguridad\r\n      widget_referrer: window.location.href,\r\n    })\r\n\r\n    return `https://www.youtube.com/embed/${videoId}?${params.toString()}`\r\n  }\r\n\r\n  // Función para construir URL de YouTube Short (fallback)\r\n  function buildYouTubeShortURL(videoId) {\r\n    return `https://www.youtube.com/shorts/${videoId}`\r\n  }\r\n\r\n  // Función simplificada para detectar si el iframe se carga correctamente\r\n  function checkIframeLoad(iframe, fallbackElement, videoId) {\r\n    let hasLoaded = false\r\n    let loadTimeout\r\n\r\n    // Timeout para mostrar fallback si el iframe no carga\r\n    loadTimeout = setTimeout(() => {\r\n      if (!hasLoaded) {\r\n        console.log(\"YouTube embed failed to load, showing fallback\")\r\n        showVideoFallback(videoId, fallbackElement)\r\n      }\r\n    }, 5000)\r\n\r\n    // Detectar cuando el iframe se carga\r\n    iframe.onload = () => {\r\n      hasLoaded = true\r\n      clearTimeout(loadTimeout)\r\n      console.log(\"YouTube embed loaded successfully\")\r\n      iframe.style.display = \"block\"\r\n      fallbackElement.style.display = \"none\"\r\n    }\r\n\r\n    // Detectar errores de carga\r\n    iframe.onerror = () => {\r\n      console.log(\"YouTube embed error detected\")\r\n      clearTimeout(loadTimeout)\r\n      showVideoFallback(videoId, fallbackElement)\r\n    }\r\n  }\r\n\r\n  // Función para mostrar el fallback con preview\r\n  function showVideoFallback(videoId, fallbackElement) {\r\n    const thumbnailUrl = getYouTubeThumbnail(videoId)\r\n    const shortUrl = buildYouTubeShortURL(videoId)\r\n\r\n    fallbackElement.innerHTML = `\r\n      <div class=\"fallback-content\">\r\n        <div class=\"short-preview\">\r\n          <div class=\"thumbnail-container\">\r\n            <img src=\"${thumbnailUrl}\" alt=\"Video preview\" class=\"video-thumbnail\" />\r\n            <div class=\"play-overlay\">\r\n              <div class=\"play-button\">\r\n                <svg width=\"68\" height=\"48\" viewBox=\"0 0 68 48\">\r\n                  <path d=\"M66.52,7.74c-0.78-2.93-2.49-5.41-5.42-6.19C55.79,.13,34,0,34,0S12.21,.13,6.9,1.55 C3.97,2.33,2.27,4.81,1.48,7.74C0.06,13.05,0,24,0,24s0.06,10.95,1.48,16.26c0.78,2.93,2.49,5.41,5.42,6.19 C12.21,47.87,34,48,34,48s21.79-0.13,27.1-1.55c2.93-0.78,4.64-3.26,5.42-6.19C67.94,34.95,68,24,68,24S67.94,13.05,66.52,7.74z\" fill=\"#f00\"></path>\r\n                  <path d=\"M 45,24 27,14 27,34\" fill=\"#fff\"></path>\r\n                </svg>\r\n              </div>\r\n              <div class=\"shorts-badge\">Shorts</div>\r\n            </div>\r\n          </div>\r\n          <div class=\"preview-info\">\r\n            <h3>Video no disponible para reproducir aquí</h3>\r\n            <p>Este video tiene restricciones de reproducción. Haz clic para verlo en YouTube.</p>\r\n          </div>\r\n        </div>\r\n        <button class=\"youtube-button\" onclick=\"window.open('${shortUrl}', '_blank')\">\r\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\r\n            <path d=\"M23.498 6.186C23.281 5.301 22.603 4.604 21.738 4.382C19.875 3.9 19.875 3.9 12 3.9C4.125 3.9 4.125 3.9 2.262 4.382C1.397 4.604 0.719 5.301 0.502 6.186C0.084 8.075 0.084 8.075 0.084 12C0.084 15.925 0.084 15.925 0.502 17.814C0.719 18.699 1.397 19.396 2.262 19.618C4.125 20.1 4.125 20.1 12 20.1C19.875 20.1 19.875 20.1 21.738 19.618C22.603 19.396 23.281 18.699 23.498 17.814C23.916 15.925 23.916 15.925 23.916 12C23.916 8.075 23.916 8.075 23.498 6.186Z\" fill=\"#FF0000\"/>\r\n            <path d=\"M9.545 15.568L15.818 12L9.545 8.432V15.568Z\" fill=\"white\"/>\r\n          </svg>\r\n          Ver en YouTube\r\n        </button>\r\n      </div>\r\n    `\r\n\r\n    youtubePlayer.style.display = \"none\"\r\n    fallbackElement.style.display = \"flex\"\r\n  }\r\n\r\n  // Manejar clic en el botón de play del tomaticán\r\n  if (playButton && tomaticanPlayer) {\r\n    playButton.addEventListener(\"click\", () => {\r\n      const videoId = getVideoId(tomaticanPlayer)\r\n      // Sin autoplay para que el usuario presione play manualmente\r\n      const params = new URLSearchParams({\r\n        autoplay: \"0\",\r\n        rel: \"0\",\r\n        modestbranding: \"1\",\r\n        showinfo: \"0\",\r\n        controls: \"1\",\r\n        fs: \"1\",\r\n        cc_load_policy: \"0\",\r\n        iv_load_policy: \"3\",\r\n        playsinline: \"1\",\r\n        enablejsapi: \"1\",\r\n        origin: window.location.origin,\r\n        widget_referrer: window.location.href,\r\n      })\r\n      tomaticanPlayer.src = `https://www.youtube.com/embed/${videoId}?${params.toString()}`\r\n      tomaticanPlayer.style.display = \"block\"\r\n      videoPreview.style.display = \"none\"\r\n    })\r\n  }\r\n\r\n  // Botones de video\r\n  const videoButtons = document.querySelectorAll(\".ver-video\")\r\n  videoButtons.forEach((button) => {\r\n    button.addEventListener(\"click\", function () {\r\n      const card = this.closest(\".receta-card\")\r\n      const videoId = getVideoId(card)\r\n      currentVideoId = videoId\r\n      currentVideoUrl = buildYouTubeShortURL(videoId)\r\n\r\n      // Resetear estado\r\n      youtubePlayer.style.display = \"block\"\r\n      videoFallback.style.display = \"none\"\r\n\r\n      // Usar la URL simple que funciona\r\n      const embedUrl = buildYouTubeEmbedURL(videoId)\r\n      youtubePlayer.src = embedUrl\r\n\r\n      // Verificar si el embed funciona\r\n      checkIframeLoad(youtubePlayer, videoFallback, videoId)\r\n\r\n      // Mostrar overlay y botón de cierre\r\n      videoOverlay.classList.add(\"active\")\r\n      toggleCloseButton(true)\r\n    })\r\n  })\r\n\r\n  // Botón original para abrir en YouTube (fallback)\r\n  if (openYoutubeBtn) {\r\n    openYoutubeBtn.addEventListener(\"click\", () => {\r\n      if (currentVideoUrl) {\r\n        window.open(currentVideoUrl, \"_blank\")\r\n      }\r\n    })\r\n  }\r\n\r\n  // Botones de receta\r\n  const recetaButtons = document.querySelectorAll(\".ver-receta\")\r\n  recetaButtons.forEach((button) => {\r\n    button.addEventListener(\"click\", function () {\r\n      const card = this.closest(\".receta-card\")\r\n      const recetaId = card.dataset.recipe\r\n      const imagePath = `assets/sabores/${recetaId}.png`\r\n      recetaImagen.src = imagePath\r\n      recetaOverlay.classList.add(\"active\")\r\n      toggleCloseButton(true)\r\n    })\r\n  })\r\n\r\n  // Manejar el botón de cierre de escritorio\r\n  if (closeOverlayBtn) {\r\n    closeOverlayBtn.addEventListener(\"click\", () => {\r\n      if (videoOverlay.classList.contains(\"active\")) {\r\n        closeOverlay(videoOverlay)\r\n      }\r\n      if (recetaOverlay.classList.contains(\"active\")) {\r\n        closeOverlay(recetaOverlay)\r\n      }\r\n    })\r\n  }\r\n\r\n  // Cerrar overlays\r\n  const closeButtons = document.querySelectorAll(\".close-button\")\r\n  closeButtons.forEach((button) => {\r\n    button.addEventListener(\"click\", function () {\r\n      const overlay = this.closest(\".overlay\")\r\n      if (overlay) {\r\n        closeOverlay(overlay)\r\n      }\r\n    })\r\n  })\r\n\r\n  // Función para cerrar overlay - MEJORADA\r\n  function closeOverlay(overlay) {\r\n    overlay.classList.remove(\"active\")\r\n    toggleCloseButton(false) // Ocultar botón de cierre\r\n\r\n    if (overlay.id === \"video-overlay\") {\r\n      // Detener el video\r\n      youtubePlayer.src = \"\"\r\n      youtubePlayer.style.display = \"block\"\r\n      videoFallback.style.display = \"none\"\r\n      currentVideoId = \"\"\r\n      currentVideoUrl = \"\"\r\n    }\r\n  }\r\n  // Cerrar al hacer clic fuera del contenido\r\n  ;[recetaOverlay, videoOverlay].forEach((overlay) => {\r\n    overlay.addEventListener(\"click\", function (e) {\r\n      if (e.target === this) {\r\n        closeOverlay(this)\r\n      }\r\n    })\r\n  })\r\n\r\n  // Cerrar con tecla Escape\r\n  document.addEventListener(\"keydown\", (e) => {\r\n    if (e.key === \"Escape\") {\r\n      if (videoOverlay.classList.contains(\"active\")) {\r\n        closeOverlay(videoOverlay)\r\n      }\r\n      if (recetaOverlay.classList.contains(\"active\")) {\r\n        closeOverlay(recetaOverlay)\r\n      }\r\n    }\r\n  })\r\n\r\n  // Verificar estado inicial al cargar la página\r\n  function checkInitialState() {\r\n    const hasActiveOverlay = document.querySelector(\".overlay.active\")\r\n    toggleCloseButton(!!hasActiveOverlay)\r\n  }\r\n\r\n  // Ejecutar verificación inicial\r\n  checkInitialState()\r\n})\r\n"
        },
        {
          "path": "D:/Programacion/caminosysabores/public/js/turismo-detalle.js",
          "name": "turismo-detalle.js",
          "content": "document.addEventListener(\"DOMContentLoaded\", () => {\r\n  const detailData = {\r\n    \"ischigualasto\": {\r\n      title: \"Ischigualasto | Valle de la Luna\",\r\n      externalUrl: \"https://sanjuan.tur.ar/experiencias/vivi-san-juan/ischigualasto\",\r\n      paragraphs: [\r\n        \"El Parque Natural Provincial Ischigualasto se encuentra emplazado en el nordeste de la provincia de San Juan, a 330 km de la ciudad capital y a 75 km de la localidad de San Agustin del Valle Fertil. Este peque\\u00f1o pueblo es la base de partida de las excursiones que permiten conocer -a trav\\u00e9s de un circuito estrictamente delimitado- la peque\\u00f1a porci\\u00f3n del Parque accesible para el turismo.\",\r\n        \"Popularmente conocido como \\\"Valle de la Luna\\\", este fascinantemente extra\\u00f1o lugar del mundo ocupa unas 62 mil hectareas y es, junto a su vecino Parque Nacional Talampaya, en la provincia de La Rioja, Patrimonio de la Humanidad.\"\r\n      ],\r\n      images: [\r\n        \"assets/turismo/ischigualasto/luna1.png\",\r\n        \"assets/turismo/ischigualasto/luna2.png\",\r\n        \"assets/turismo/ischigualasto/luna3.png\",\r\n        \"assets/turismo/ischigualasto/luna4.png\"\r\n      ]\r\n    },\r\n    \"interlagos\": {\r\n      title: \"Ruta Interlagos\",\r\n      externalUrl: \"https://sanjuan.tur.ar/experiencias/vivi-san-juan/ruta-interlagos\",\r\n      paragraphs: [\r\n        \"Presenta un recorrido de mas de 100 km entre monta\\u00f1as que envuelven los espejos de agua para disfrutar con amigos y en familia.\",\r\n        \"En el recorrido se encuentran atractivos de inter\\u00e9s cultural, balnearios, camping, alojamientos y servicios gastron\\u00f3micos que invitan a vivir una experiencia a pleno en contacto con la naturaleza.\",\r\n        \"Pod\\u00e9s realizar actividades de esparcimiento en el Dique de Ullum y en Paradores del Dique Punta Negra.\"\r\n      ],\r\n      images: [\r\n        \"assets/turismo/interlagos/luna1.png\",\r\n        \"assets/turismo/interlagos/luna2.png\",\r\n        \"assets/turismo/interlagos/luna3.png\",\r\n        \"assets/turismo/interlagos/luna4.png\"\r\n      ]\r\n    },\r\n    \"difunta-correa\": {\r\n      title: \"Difunta Correa\",\r\n      externalUrl: \"https://sanjuan.tur.ar/experiencias/que-hago/recorridos-de-fe\",\r\n      paragraphs: [\r\n        \"Actualmente es el principal destino de fe de San Juan.\",\r\n        \"El paraje cuenta con locales comerciales y gastron\\u00f3micos, una estaci\\u00f3n de servicio y un hotel, adem\\u00e1s de un museo donde se exhiben las principales donaciones recibidas.\",\r\n        \"La leyenda cuenta que Deolinda Correa, con su beb\\u00e9 en brazos, emprendi\\u00f3 el viaje en busca de su esposo, reclutado por las milicias de Facundo Quiroga.\",\r\n        \"Tom\\u00f3 hacia el Este por el llamado \\\"Camino de las traves\\u00edas\\\", que bordeaba el Pie de Palo, un paso utilizado por arrieros.\",\r\n        \"El \\\"milagro\\\" de amamantar ya muerta fue el puntapi\\u00e9 inicial para que la leyenda comenzara a difundirse, al punto que hoy su santuario es visitado por m\\u00e1s de un mill\\u00f3n de personas al a\\u00f1o.\"\r\n      ],\r\n      images: [\r\n        \"assets/turismo/difunta/luna1.png\",\r\n        \"assets/turismo/difunta/luna2.png\",\r\n        \"assets/turismo/difunta/luna3.png\",\r\n        \"assets/turismo/difunta/luna4.png\"\r\n      ]\r\n    },\r\n    \"ruta-del-cielo\": {\r\n      title: \"Ruta del Cielo | Pampa del Leoncito\",\r\n      externalUrl: \"https://sanjuan.tur.ar/experiencias/que-hago/ruta-del-cielo\",\r\n      paragraphs: [\r\n        \"La Ruta del Cielo ofrece la posibilidad de que turistas y visitantes utilicen Miradores Astron\\u00f3micos que poseen un mapa estelar donde se puede apreciar el cielo con las principales constelaciones, planetas y astros.\",\r\n        \"Los seis miradores est\\u00e1n ubicados en diferentes puntos de la provincia: en el camino nuevo a la localidad de Mogna, en Cuesta de Huaco, en RN 150 camino al Parque Provincial Ischigualasto, camino al Cerro Siete Colores, al pie del Cerro Colorado y en el Cerro Alkazar.\",\r\n        \"La Pampa del Leoncito o Barreal Blanco se encuentra en la localidad Barreal en Calingasta. Es una planicie de 12 kil\\u00f3metros de largo por 5 kil\\u00f3metros de ancho que cautiva junto a la inmensidad de la Cordillera de los Andes.\"\r\n      ],\r\n      images: [\r\n        \"assets/turismo/ruta_del_cielo/luna1.png\",\r\n        \"assets/turismo/ruta_del_cielo/luna2.png\",\r\n        \"assets/turismo/ruta_del_cielo/luna3.png\",\r\n        \"assets/turismo/ruta_del_cielo/luna4.png\"\r\n      ]\r\n    },\r\n    \"dique-cuesta-del-viento\": {\r\n      title: \"Dique Cuesta del Viento\",\r\n      externalUrl: \"https://sanjuan.tur.ar/experiencias/que-hago/aventura/recomendados/dique-cuesta-del-viento\",\r\n      paragraphs: [\r\n        \"Cuesta del Viento se ha convertido, en los \\u00faltimos a\\u00f1os, en uno de los principales atractivos tur\\u00edsticos de San Juan. La belleza del sitio y la presencia de fuertes vientos han creado el entorno ideal para los amantes de la aventura y los deportes n\\u00e1uticos. Sus cualidades naturales permiten catalogarlo como uno de los mejores sitios que existen en el mundo para la pr\\u00e1ctica del windsurf.\"\r\n      ],\r\n      images: [\r\n        \"assets/turismo/dique/luna1.png\",\r\n        \"assets/turismo/dique/luna2.png\",\r\n        \"assets/turismo/dique/luna3.png\",\r\n        \"assets/turismo/dique/luna4.png\"\r\n      ]\r\n    },\r\n    \"circuito-cultural\": {\r\n      title: \"Circuito Cultural\",\r\n      externalUrl: \"https://sanjuan.tur.ar/experiencias/que-hago/recorridos-de-fe\",\r\n      paragraphs: [\r\n        \"En la ciudad de San Juan pod\\u00e9s encontrar muchos espacios culturales donde realizar diferentes actividades y conocer la historia de nuestro pa\\u00eds. Como en el Museo Provincial de Bellas Artes Franklin Rawson, el Teatro del Bicentenario, el Mercado Artesanal Tradicional Luisa Escudero, el Centro Cultural Conte Grandy y la Bandera del Ej\\u00e9rcito de los Andes (Cabot).\"\r\n      ],\r\n      images: [\r\n        \"assets/turismo/circuito/luna1.png\",\r\n        \"assets/turismo/circuito/luna2.png\",\r\n        \"assets/turismo/circuito/luna3.png\",\r\n        \"assets/turismo/circuito/luna4.png\"\r\n      ]\r\n    }\r\n  };\r\n\r\n  const params = new URLSearchParams(window.location.search);\r\n  const slug = params.get(\"destino\") || \"ischigualasto\";\r\n  const current = detailData[slug] || detailData[\"ischigualasto\"];\r\n\r\n  const copyContainer = document.getElementById(\"tourism-detail-copy\");\r\n  const titleElement = document.getElementById(\"tourism-destination-title\");\r\n  const carouselElement = document.getElementById(\"tourism-carousel\");\r\n\r\n  document.title = `${current.title} - San Juan a la mesa`;\r\n  titleElement.innerHTML = current.externalUrl\r\n    ? `<a href=\"${current.externalUrl}\" target=\"_blank\" rel=\"noopener noreferrer\">${current.title}</a>`\r\n    : current.title;\r\n\r\n  copyContainer.innerHTML = current.paragraphs\r\n    .map((paragraph) => `<p>${paragraph}</p>`)\r\n    .join(\"\");\r\n\r\n  // --- Smooth Carousel ---\r\n  carouselElement.innerHTML = current.images\r\n    .map(\r\n      (imagePath, index) => `\r\n        <div class=\"carousel-item tourism-carousel-item\">\r\n          <img src=\"${imagePath}\" alt=\"${current.title} ${index + 1}\">\r\n        </div>\r\n      `\r\n    )\r\n    .join(\"\");\r\n\r\n  initSmoothCarousel(carouselElement);\r\n});\r\n\r\nfunction initSmoothCarousel(container) {\r\n  const items = container.querySelectorAll(\".tourism-carousel-item\");\r\n  if (items.length < 2) return;\r\n\r\n  let isDragging = false;\r\n  let startX = 0;\r\n  let scrollLeft = 0;\r\n  let velocity = 0;\r\n  let rafId = null;\r\n  let lastX = 0;\r\n  let lastTime = 0;\r\n  let snapTimeout = null;\r\n\r\n  // Wrap items in a track div for transform-based scrolling\r\n  const track = document.createElement(\"div\");\r\n  track.className = \"carousel-track\";\r\n  while (container.firstChild) track.appendChild(container.firstChild);\r\n  container.appendChild(track);\r\n\r\n  // Style the container for the new layout\r\n  container.style.overflow = \"hidden\";\r\n  container.style.cursor = \"grab\";\r\n  container.style.position = \"relative\";\r\n\r\n  // Style the track\r\n  track.style.display = \"flex\";\r\n  track.style.gap = \"14px\";\r\n  track.style.willChange = \"transform\";\r\n  track.style.transition = \"none\";\r\n  track.style.transform = \"translateX(0)\";\r\n\r\n  function getItemWidth() {\r\n    if (items.length === 0) return container.offsetWidth * 0.78;\r\n    return items[0].offsetWidth + 14; // item width + gap\r\n  }\r\n\r\n  function getMaxScroll() {\r\n    const totalWidth = Array.from(items).reduce((sum, item) => sum + item.offsetWidth + 14, 0) - 14;\r\n    const visible = container.offsetWidth;\r\n    return Math.max(0, totalWidth - visible);\r\n  }\r\n\r\n  function applyTransform(x) {\r\n    const maxScroll = getMaxScroll();\r\n    // Clamp with rubber-band-like overscroll that resists\r\n    if (x > 0) x = x * 0.3;\r\n    if (x < -maxScroll) x = -maxScroll + (x + maxScroll) * 0.3;\r\n    track.style.transform = `translateX(${x}px)`;\r\n  }\r\n\r\n  function getCurrentX() {\r\n    const transform = track.style.transform;\r\n    const match = transform.match(/translateX\\(([-\\d.]+)px\\)/);\r\n    return match ? parseFloat(match[1]) : 0;\r\n  }\r\n\r\n  function snapToNearest(animate) {\r\n    const currentX = getCurrentX();\r\n    const maxScroll = getMaxScroll();\r\n    const itemWidth = getItemWidth();\r\n\r\n    // Calculate which item we're closest to\r\n    let targetIndex = Math.round(Math.abs(currentX) / itemWidth);\r\n    targetIndex = Math.max(0, Math.min(targetIndex, items.length - 1));\r\n\r\n    let targetX = -targetIndex * itemWidth;\r\n    targetX = Math.max(-maxScroll, Math.min(0, targetX));\r\n\r\n    if (animate) {\r\n      const startX = getCurrentX();\r\n      const delta = targetX - startX;\r\n      const duration = Math.min(500, Math.max(200, Math.abs(delta) * 0.8));\r\n      const startTime = performance.now();\r\n\r\n      function easeOutCubic(t) {\r\n        return 1 - Math.pow(1 - t, 3);\r\n      }\r\n\r\n      function animateSnap(time) {\r\n        const elapsed = time - startTime;\r\n        const progress = Math.min(1, elapsed / duration);\r\n        const eased = easeOutCubic(progress);\r\n        const current = startX + delta * eased;\r\n        applyTransform(current);\r\n\r\n        if (progress < 1) {\r\n          rafId = requestAnimationFrame(animateSnap);\r\n        } else {\r\n          applyTransform(targetX);\r\n          rafId = null;\r\n        }\r\n      }\r\n\r\n      if (rafId) cancelAnimationFrame(rafId);\r\n      rafId = requestAnimationFrame(animateSnap);\r\n    } else {\r\n      applyTransform(targetX);\r\n    }\r\n  }\r\n\r\n  // Mouse events\r\n  container.addEventListener(\"mousedown\", (e) => {\r\n    isDragging = true;\r\n    startX = e.pageX - container.offsetLeft;\r\n    scrollLeft = getCurrentX();\r\n    lastX = e.pageX;\r\n    lastTime = performance.now();\r\n    velocity = 0;\r\n    container.style.cursor = \"grabbing\";\r\n    if (rafId) cancelAnimationFrame(rafId);\r\n    if (snapTimeout) clearTimeout(snapTimeout);\r\n    track.style.transition = \"none\";\r\n  });\r\n\r\n  container.addEventListener(\"mousemove\", (e) => {\r\n    if (!isDragging) return;\r\n    e.preventDefault();\r\n    const x = e.pageX - container.offsetLeft;\r\n    const walk = (x - startX) * 1.2; // Multiplier for responsive feel\r\n    const now = performance.now();\r\n    const dt = now - lastTime;\r\n    if (dt > 0) {\r\n      velocity = (e.pageX - lastX) / dt * 16; // Normalize to ~60fps\r\n    }\r\n    lastX = e.pageX;\r\n    lastTime = now;\r\n    applyTransform(scrollLeft + walk);\r\n  });\r\n\r\n  container.addEventListener(\"mouseup\", () => {\r\n    if (!isDragging) return;\r\n    isDragging = false;\r\n    container.style.cursor = \"grab\";\r\n\r\n    // Apply momentum if velocity is significant\r\n    if (Math.abs(velocity) > 0.3) {\r\n      applyMomentum(velocity);\r\n    } else {\r\n      snapToNearest(true);\r\n    }\r\n  });\r\n\r\n  container.addEventListener(\"mouseleave\", () => {\r\n    if (!isDragging) return;\r\n    isDragging = false;\r\n    container.style.cursor = \"grab\";\r\n    if (Math.abs(velocity) > 0.3) {\r\n      applyMomentum(velocity);\r\n    } else {\r\n      snapToNearest(true);\r\n    }\r\n  });\r\n\r\n  // Touch events\r\n  container.addEventListener(\"touchstart\", (e) => {\r\n    isDragging = true;\r\n    const touch = e.touches[0];\r\n    startX = touch.pageX - container.offsetLeft;\r\n    scrollLeft = getCurrentX();\r\n    lastX = touch.pageX;\r\n    lastTime = performance.now();\r\n    velocity = 0;\r\n    if (rafId) cancelAnimationFrame(rafId);\r\n    if (snapTimeout) clearTimeout(snapTimeout);\r\n    track.style.transition = \"none\";\r\n  }, { passive: true });\r\n\r\n  container.addEventListener(\"touchmove\", (e) => {\r\n    if (!isDragging) return;\r\n    const touch = e.touches[0];\r\n    const x = touch.pageX - container.offsetLeft;\r\n    const walk = (x - startX) * 1.2;\r\n    const now = performance.now();\r\n    const dt = now - lastTime;\r\n    if (dt > 0) {\r\n      velocity = (touch.pageX - lastX) / dt * 16;\r\n    }\r\n    lastX = touch.pageX;\r\n    lastTime = now;\r\n    applyTransform(scrollLeft + walk);\r\n  }, { passive: true });\r\n\r\n  container.addEventListener(\"touchend\", () => {\r\n    if (!isDragging) return;\r\n    isDragging = false;\r\n    if (Math.abs(velocity) > 0.3) {\r\n      applyMomentum(velocity);\r\n    } else {\r\n      snapToNearest(true);\r\n    }\r\n  }, { passive: true });\r\n\r\n  function applyMomentum(vel) {\r\n    const friction = 0.95;\r\n    let currentVel = vel;\r\n    let currentX = getCurrentX();\r\n    const maxScroll = getMaxScroll();\r\n    let startTime = performance.now();\r\n\r\n    if (rafId) cancelAnimationFrame(rafId);\r\n\r\n    function momentumLoop(time) {\r\n      // Decelerate with easing\r\n      currentVel *= friction;\r\n      if (Math.abs(currentVel) < 0.1) {\r\n        snapToNearest(true);\r\n        return;\r\n      }\r\n\r\n      currentX += currentVel * 1.5;\r\n      applyTransform(currentX);\r\n\r\n      // Check if we hit the boundaries\r\n      const clamped = currentX;\r\n      if (clamped !== currentX) {\r\n        snapToNearest(true);\r\n        return;\r\n      }\r\n\r\n      rafId = requestAnimationFrame(momentumLoop);\r\n    }\r\n\r\n    rafId = requestAnimationFrame(momentumLoop);\r\n  }\r\n\r\n  // Handle resize\r\n  let resizeTimer;\r\n  window.addEventListener(\"resize\", () => {\r\n    clearTimeout(resizeTimer);\r\n    resizeTimer = setTimeout(() => {\r\n      const currentX = getCurrentX();\r\n      const maxScroll = getMaxScroll();\r\n      if (currentX < -maxScroll) {\r\n        applyTransform(-maxScroll);\r\n      }\r\n    }, 200);\r\n  });\r\n\r\n  // Initial snap\r\n  snapToNearest(false);\r\n}\r\n"
        },
