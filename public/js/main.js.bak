/**
 * main.js — NUEVO entry point modularizado.
 * Importa todos los módulos y arranca la app.
 * Antes: monolito de 9000+ líneas. Ahora: ~120 líneas.
 */
import { initDOM } from './modules/dom-refs.js';
import { state } from './modules/state.js';
import { loadData, performPeriodicSync, checkSystemHealth } from './modules/session.js';
import { loadSkills } from './modules/skills-ui.js';
import { fetchModels } from './modules/models-ui.js';
import { setupEventListeners } from './modules/events.js';
import { syncModeUI } from './modules/utils.js';
import { initPanelResize, applyPanelState, renderProjectList, renderTabs, updateViewVisibility } from './modules/project-ui.js';
import { startBadgePolling } from './modules/agent-table.js';
import { refreshConsoleUI } from './modules/console-view.js';
import { initMatrix } from './matrix.js';

// ─── Init ───
async function init() {
    initDOM();
    applyPanelState();
    initPanelResize();
    syncModeUI(state.mode);

    // Load data
    await loadData();

    // Load skills and models in parallel
    await Promise.all([
        loadSkills(),
        fetchModels()
    ]);

    // Bind event listeners
    setupEventListeners();

    // Render initial UI
    renderProjectList();
    renderTabs();
    updateViewVisibility();

    // Start periodic badge polling
    startBadgePolling();

    console.log('✅ JP Agents frontend initialized');
}

// ─── Start ───
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
} else {
    init();
}

// ─── Keep window.* compatibility for onclick handlers in HTML ───
// Import and re-export window assignments from modules
import './modules/session.js';     // saveData, getActiveProject, etc.
import './modules/chat-ui.js';    // showToast, play sounds
import './modules/project-ui.js'; // switchTab, addChat, deleteChat, etc.
import './modules/admin-engine.js'; // stopGodAgent, clearAdminChat, etc.
import './modules/agent-engine.js'; // toggleDiff, clearSessionSummary
import './modules/skills-ui.js';   // selectSkill, removeAgentSkill, etc.
import './modules/drag-drop.js';   // onProjectDragStart/End/Over/Leave/Drop, onTabDrag*
import './modules/search-filter.js'; // gotoSearchResult
import './modules/console-view.js'; // clearConsoleUI
import './modules/file-editor.js'; // goUp, saveActiveFile, openFile, etc.
import './modules/events.js';      // refreshMCPDebugger, clearMCPHistory, addModelToSelect, etc.
import './modules/agent-table.js'; // (no window exports needed)
