    </div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Chat View -->\n          <div id=\"chat-tab-content\" class=\"tab-content hidden\">\n            <div id=\"chat-messages\" class=\"chat-messages\">\n              <!-- Messages appear here -->\n            </div>\n            \n            <div id=\"agent-status\" class=\"agent-thinking-bar hidden\">\n              <div class=\"spinner-container\">\n                <span class=\"spinner\"></span>\n              </div>\n              <div class=\"thinking-text-wrapper\">\n                <span id=\"thinking-status\">El agente está pensando...</span>\n                <span class=\"thinking-subtext\">Procesando solicitud</span>\n              </div>\n            </div>\n            \n            <div class=\"input-area\">\n              <div id=\"image-preview-container\" class=\"image-preview-container hidden\"></div>\n              <div class=\"input-wrapper\">\n                <div class=\"input-actions-left\">\n                  <button id=\"attach-img\" class=\"btn-icon-subtle hidden\" title=\"Adjuntar imagen (Modelos Vision)\">📷</button>\n                  <input type=\"file\" id=\"image-input\" accept=\"image/*\" class=\"hidden\" />\n                </div>\n                <textarea id=\"chat-input\" placeholder=\"Escribe una instrucción para el agente...\" rows=\"2\"></textarea>\n                <div class=\"input-actions-right\">\n                  <div class=\"config-group mode-selector-mini\">\n                    <div class=\"toggle-group\">\n                      <button id=\"mode-auto\" class=\"btn-toggle active\">Auto</button>\n                      <button id=\"mode-supervised\" class=\"btn-toggle\">Supervised</button>\n                    </div>\n                  </div>\n                  <button id=\"send-btn\" class=\"send-btn\">\n                    <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"22\" y1=\"2\" x2=\"11\" y2=\"13\"></line><polygon points=\"22 2 15 22 11 13 2 9 22 2\"></polygon></svg>\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Editor View -->\n          <div id=\"editor-tab-content\" class=\"tab-content hidden\">\n            <div class=\"editor-header\">\n              <h3 id=\"current-filename\">Archivo.js</h3>\n              <div id=\"pending-actions\" class=\"pending-actions hidden\">\n                <span class=\"pending-label\">Cambios Propuestos</span>\n                <button id=\"accept-change\" class=\"btn-success\">Aceptar ✓</button>\n                <button id=\"reject-change\" class=\"btn-danger\">Rechazar ✕</button>\n              </div>\n            </div>\n            <div class=\"editor-container\">\n              <pre><code id=\"editor-code\"></code></pre>\n            </div>\n            <div id=\"editor-footer\" class=\"editor-footer\">\n              <div id=\"diff-stats\" class=\"diff-stats hidden\">\n                <span class=\"diff-added\">+ 0 agregadas</span>\n                <span class=\"diff-removed\">- 0 eliminadas</span>\n              </div>\n              <div class=\"editor-info\">\n                <span id=\"editor-lang\">plaintext</span>\n              </div>\n            </div>\n          </div>\n        </section>\n\n\n      </main>\n\n      <aside class=\"file-explorer\">\n        <h3>Archivos del Proyecto</h3>\n        <div id=\"file-list\" class=\"file-list\">\n          <p class=\"empty-state\">No hay carpeta seleccionada</p>\n        </div>\n      </aside>\n    </div>\n    <script type=\"module\" src=\"/main.js\"></script>\n  </body>\n</html>\n",
